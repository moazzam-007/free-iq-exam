---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryTestRunner from '../components/CategoryTestRunner.astro';

const title = "Fluid Reasoning Test Free - 16 Matrix & Pattern IQ Questions | FreeIQExam";
const description = "Take the free Fluid Reasoning (Gf) test online. 16 progressive matrix & pattern induction questions calibrated with 2PL Item Response Theory. Instant scoring.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Fluid Reasoning Cognitive Ability Test (Gf)",
    "description": "Specialized 16-item non-verbal fluid intelligence assessment measuring abstract rule induction, matrix completion, and topological transformation logic.",
    "url": "https://freeiqexam.com/fluid-reasoning-test/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Fluid Reasoning Test",
        "item": "https://freeiqexam.com/fluid-reasoning-test/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/fluid-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Fluid Reasoning Test</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>CHC COGNITIVE FACTOR: Gf <span aria-hidden="true">&bull;</span> CULTURE-REDUCED</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Fluid Reasoning Assessment (Gf)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluate your novel problem-solving capacity, abstract matrix rule induction, and topological logic. Choose between a 15-minute standardized test or an untimed practice drill with instant step-by-step explanations.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Progressive Matrix Items</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">15-Minute Timer (or Untimed)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Culture-Reduced Stimuli</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">2PL IRT Calibration</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="fluid"
      domainCode="Gf"
      domainTitle="Fluid Reasoning"
      domainSubtitle="Abstract Matrix Rule Induction & Topological Logic"
      domainDescription="Fluid Reasoning (Gf) reflects the capacity to deliberate and solve novel problems independently of acquired formal schooling. In psychometric research, Gf shows the highest correlation with Spearman's general factor (g), making it central to assessing underlying cognitive processing capacity."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Understanding Fluid Reasoning in the CHC Cognitive Framework
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Fluid intelligence, first formalized by Raymond Cattell and later refined by John Horn and John Carroll, represents the fundamental mental horsepower used to recognize patterns, extrapolate rules, and solve unfamiliar challenges. Unlike crystallized intelligence (Gc), fluid reasoning does not depend on prior vocabulary or academic instruction.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Matrix Induction
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Deconstructing 2x2 and 3x3 grids by scanning horizontal rows and vertical columns to isolate independent visual transformation rules.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Topological Series
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Following progression algorithms such as positional shifts, clockwise/counter-clockwise orbit rates, and alternating shading logic.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Boolean Feature Combinations
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Advanced matrices employ logical XOR (exclusive OR) operations where overlapping lines cancel each other out across consecutive matrix cells.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Tactical Strategies for High Matrix Scores
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Decompose features separately:</strong> Look at shape, size, rotation, number of elements, and color as separate independent variables rather than trying to grasp the whole image at once.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Verify both row-wise and column-wise:</strong> In authentic progressive matrices, a valid rule consistently holds true across horizontal rows and verifies downward through vertical columns.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Watch out for distractor traps:</strong> High-difficulty items feature distractors with incomplete rules or feature attraction (options that look intuitively appealing but fail one secondary constraint).</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Explore Other Specialized Cognitive Batteries
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/spatial-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Visual-Spatial (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">3D Mental Rotation &rarr;</div>
          </a>
          <a
            href="/quantitative-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Quantitative (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Arithmetic Logic Puzzles &rarr;</div>
          </a>
          <a
            href="/verbal-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Verbal Comprehension (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Deductive Syllogisms &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
