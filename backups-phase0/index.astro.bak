  }
  .eco-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-left: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
    padding-right: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 96px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 64px, black calc(100% - 96px), transparent 100%);
  }
  .eco-track::-webkit-scrollbar {
    display: none;
  }
  .eco-track.dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .eco-card {
    flex: 0 0 min(320px, 82vw);
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .eco-track {
      gap: 1.25rem;
    }
    .eco-card {
      flex-basis: 350px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eco-track {
      scroll-snap-type: none;
    }
  }
