---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free IQ Test Online 2026 - Instant Results, No Email Required | FreeIQExam";
const description = "Take a free, scientifically grounded online IQ test. 24 standardized questions evaluated via 2PL Item Response Theory. Instant score, percentile & cognitive breakdown with zero paywall.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/",
    "description": "Free scientifically grounded cognitive assessment platform utilizing modern psychometrics with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "An open, privacy-first psychometric platform providing free, research-backed cognitive assessments and brain training drills with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Cognitive Assessment",
    "url": "https://freeiqexam.com/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Standardized 24-item non-verbal cognitive assessment using 2PL Item Response Theory. Instant IQ-scale score estimate with percentile ranking.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": "24-question non-verbal IQ test, 2PL IRT scoring, instant results, no email required"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this IQ test really 100% free with immediate results?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Many competitor sites require 30 minutes on an exam only to hit you with a subscription paywall. FreeIQExam.com gives you your score, percentile, and performance breakdown immediately without a credit card or payment of any kind."
        }
      },
      {
        "@type": "Question",
        "name": "Why do you not require an email address or user account?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We prioritize privacy. We do not harvest email addresses, sell user data, or send spam. Calculations run directly in your browser, so you never need to create accounts or disclose personal information."
        }
      },
      {
        "@type": "Question",
        "name": "How does this test compare to a comprehensive clinical exam?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our test evaluates non-verbal fluid reasoning using 3-Parameter Logistic Item Response Theory on progressive items. It provides an educational screening estimate of reasoning ability, but is not a clinical diagnostic instrument like a full WAIS-IV or SB-V examination administered by a licensed psychologist."
        }
      },
      {
        "@type": "Question",
        "name": "How are the 24 questions structured?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The assessment consists of 24 psychometrically calibrated items evenly distributed across the 4 core CHC cognitive domains: 6 Fluid Reasoning (Gf), 6 Visual-Spatial Processing (Gv), 6 Quantitative Reasoning (Gq), and 6 Verbal Comprehension (Gc) items, scaling progressively in difficulty."
        }
      },
      {
        "@type": "Question",
        "name": "How can I actually check my IQ level online?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can take our standardized 20-minute cognitive assessment or 10-minute quick screening directly in your browser. Both tests assess non-verbal fluid reasoning and pattern induction, computing an estimated deviation IQ score and population percentile with instant results and no paywalls."
        }
      },
      {
        "@type": "Question",
        "name": "Can you increase your IQ score?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "While fundamental biological fluid intelligence is largely genetically stable, your operational performance on IQ tests can improve significantly. Familiarity with matrix transformation rules, cognitive drills (like N-back and mental rotation), high sleep quality, stress management, and test pacing help eliminate unforced errors and unlock your highest natural score."
        }
      },
      {
        "@type": "Question",
        "name": "What are IQ tests primarily used for today?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In clinical and educational settings, standardized IQ batteries (such as the WAIS-IV and WISC-V) are used to diagnose learning differences, assess cognitive recovery following neurological injury, identify gifted learners, and analyze specific cognitive strengths and weaknesses across working memory, perceptual reasoning, and processing speed."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "FreeIQExam Cognitive, Clinical and Wellness Tools",
    "description": "Complete directory of 31 free cognitive games, clinical screeners, reflex benchmarks, circadian utilities and psychometric guides.",
    "numberOfItems": 31,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Dual N-Back Working Memory", "url": "https://freeiqexam.com/games/n-back" },
      { "@type": "ListItem", "position": 2, "name": "Memory Matrix Spatial Span", "url": "https://freeiqexam.com/games/memory-matrix" },
      { "@type": "ListItem", "position": 3, "name": "Stroop Color Conflict Clash", "url": "https://freeiqexam.com/games/stroop-clash" },
      { "@type": "ListItem", "position": 4, "name": "Flanker Directional Response", "url": "https://freeiqexam.com/games/flanker-test" },
      { "@type": "ListItem", "position": 5, "name": "Speed Math Sprint", "url": "https://freeiqexam.com/games/math-sprint" },
      { "@type": "ListItem", "position": 6, "name": "3D Mental Spatial Rotation", "url": "https://freeiqexam.com/games/rotation" },
      { "@type": "ListItem", "position": 7, "name": "Sequence Rush Inductive Series", "url": "https://freeiqexam.com/games/sequence-rush" },
      { "@type": "ListItem", "position": 8, "name": "Symbol Match Perceptual Coding", "url": "https://freeiqexam.com/games/symbol-match" },
      { "@type": "ListItem", "position": 9, "name": "Propositional Syllogism Blitz", "url": "https://freeiqexam.com/games/syllogism" },
      { "@type": "ListItem", "position": 10, "name": "Digit Span Working Memory Loop", "url": "https://freeiqexam.com/games/digit-span" },
      { "@type": "ListItem", "position": 11, "name": "Adult ADHD Clinical Screener", "url": "https://freeiqexam.com/adhd-test" },
      { "@type": "ListItem", "position": 12, "name": "Depression Screener PHQ-9", "url": "https://freeiqexam.com/depression-test" },
      { "@type": "ListItem", "position": 13, "name": "Generalized Anxiety Screener GAD-7", "url": "https://freeiqexam.com/anxiety-test" },
      { "@type": "ListItem", "position": 14, "name": "Autism Spectrum Screener AQ-10", "url": "https://freeiqexam.com/autism-test" },
      { "@type": "ListItem", "position": 15, "name": "Ishihara Color Blindness Test", "url": "https://freeiqexam.com/color-blind-test" },
      { "@type": "ListItem", "position": 16, "name": "Hearing Frequency Perception Test", "url": "https://freeiqexam.com/hearing-test" },
      { "@type": "ListItem", "position": 17, "name": "Visual Acuity Snellen Eye Test", "url": "https://freeiqexam.com/eye-test" },
      { "@type": "ListItem", "position": 18, "name": "Microphone Audio Hardware Benchmark", "url": "https://freeiqexam.com/mic-test" },
      { "@type": "ListItem", "position": 19, "name": "Visual Reaction Time Test", "url": "https://freeiqexam.com/reaction-time-test" },
      { "@type": "ListItem", "position": 20, "name": "Typing Speed and Accuracy Test", "url": "https://freeiqexam.com/typing-test" },
      { "@type": "ListItem", "position": 21, "name": "Precision Aim Trainer", "url": "https://freeiqexam.com/aim-trainer" },
      { "@type": "ListItem", "position": 22, "name": "Click Speed Test CPS", "url": "https://freeiqexam.com/games/click-speed-test" },
      { "@type": "ListItem", "position": 23, "name": "90-Minute Sleep Cycle Calculator", "url": "https://freeiqexam.com/sleep-calculator" },
      { "@type": "ListItem", "position": 24, "name": "Ambient Brown Noise Generator", "url": "https://freeiqexam.com/brown-noise" },
      { "@type": "ListItem", "position": 25, "name": "TDEE Neuro-Metabolic Energy Engine", "url": "https://freeiqexam.com/calorie-calculator" },
      { "@type": "ListItem", "position": 26, "name": "Stoic Circle of Control Matrix", "url": "https://freeiqexam.com/circle-of-control" },
      { "@type": "ListItem", "position": 27, "name": "Memento Mori Life Grid Visualization", "url": "https://freeiqexam.com/memento-mori" },
      { "@type": "ListItem", "position": 28, "name": "Matrix Reasoning Guide", "url": "https://freeiqexam.com/matrix-reasoning-test" },
      { "@type": "ListItem", "position": 29, "name": "IQ Score Distribution Chart", "url": "https://freeiqexam.com/iq-score-chart" },
      { "@type": "ListItem", "position": 30, "name": "IQ Percentile Rank Calculator", "url": "https://freeiqexam.com/iq-percentile-calculator" },
      { "@type": "ListItem", "position": 31, "name": "Psychometric Methodology Whitepaper", "url": "https://freeiqexam.com/methodology" }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- Shared Global Navigation Header -->
  <Header currentPath="/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">
    <!-- HERO SECTION (Pure White Background + Monumental Apple Scale) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center reveal-on-scroll">
        <!-- Vercel-Style Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 shadow-2xs mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span class="hidden sm:inline">4-DOMAIN CHC ASSESSMENT - FLUID, SPATIAL, QUANTITATIVE, VERBAL</span>
          <span class="sm:hidden">4-DOMAIN CHC ASSESSMENT</span>
        </div>

        <!-- Monumental Display H1 (Apple Monochrome Typography) -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Free Online IQ Test.<br />
          <span class="text-blue-600 dark:text-blue-500">
            Get Your Estimated Score Instantly.
          </span>
        </h1>

        <!-- High-Legibility Subtitle -->
        <p class="text-lg sm:text-2xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-normal">
          Evaluate your cognitive abilities across Fluid Reasoning, Visual-Spatial, Quantitative, and Verbal domains. Get your estimated IQ-scale score (SD 15) and percentile rank instantly, with <strong class="text-zinc-950 dark:text-white font-semibold">no email, no sign-up, and no credit card required.</strong>
        </p>

        <!-- Large Tactile Action Buttons - Dual Track -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
          <a 
            href="/test" 
            class="w-full sm:w-auto px-9 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3"
          >
            <span>Full Test (20 Min)</span>
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a 
            href="/quick-test" 
            class="w-full sm:w-auto px-8 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Quick Screening (10 Min)</span>
          </a>
        </div>

        <!-- Clean 4-Bullet Trust Strip -->
        <div class="flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-sm sm:text-base font-medium text-zinc-600 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Instant Results</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>No Email Needed</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Standardized SD 15</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Zero Paywalls</span>
          </div>
        </div>

        <!-- Transparent Scope Disclosure -->
        <div class="mt-8 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-xs font-medium text-zinc-700 dark:text-zinc-300">
          <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400"></span>
          <span>Evaluates Non-Verbal Fluid Reasoning (Gf) &amp; Visual Processing (Gv)</span>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE 5-ITEM COGNITIVE SAMPLE -->
    <section id="demo-puzzle" class="py-14 sm:py-18 bg-zinc-50 dark:bg-zinc-950/60 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 reveal-on-scroll">
        <!-- Section Header -->
        <div class="text-center mb-8 sm:mb-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            Interactive Sample Items
          </div>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-zinc-950 dark:text-white mt-1 tracking-tight">
            Test Your Cognitive Reasoning
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl mx-auto">
            Experience 5 calibrated sample questions across Fluid, Spatial, Quantitative, and Verbal intelligence domains.
          </p>

          <!-- Stepper Navigation Pills -->
          <div class="flex items-center justify-center gap-2 sm:gap-3 mt-6" aria-label="Sample questions stepper">
            <button
              type="button"
              id="step-dot-0"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 1"
            >
              1. Matrix
            </button>
            <button
              type="button"
              id="step-dot-1"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 2"
            >
              2. 3D Cube
            </button>
            <button
              type="button"
              id="step-dot-2"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 3"
            >
              3. Series
            </button>
            <button
              type="button"
              id="step-dot-3"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 4"
            >
              4. Logic
            </button>
            <button
              type="button"
              id="step-dot-4"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 5"
            >
              5. XOR Rule
            </button>
          </div>
        </div>

        <!-- Elevated Question Card Container -->
        <div class="bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.08)] overflow-hidden">
          <!-- Card Header Bar -->
          <div class="px-6 sm:px-8 py-4 sm:py-5 border-b border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 bg-zinc-50/60 dark:bg-zinc-900/80">
            <div class="flex items-center gap-3">
              <span id="sample-domain-badge" class="font-mono font-bold text-xs px-3 py-1 rounded-md bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                Fluid Reasoning (Gf)
              </span>
              <span id="sample-subtype-text" class="text-xs sm:text-sm font-medium text-zinc-600 dark:text-zinc-400">
                Shape &amp; Count Progression
              </span>
            </div>

            <!-- Stepper Controls -->
            <div class="flex items-center gap-2">
              <span id="sample-counter-text" class="text-xs font-mono font-semibold text-zinc-500 mr-2">
                Item 1 of 5
              </span>
              <button
                type="button"
                id="btn-sample-prev"
                class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-label="Previous sample question"
                disabled
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                type="button"
                id="btn-sample-next"
                class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-label="Next sample question"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Question Viewport + Interactive Choices Area -->
          <div id="sample-card-body" class="p-5 sm:p-8 md:p-10 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12 min-h-[380px]">
            <!-- Dynamic Stimulus Container -->
            <div id="sample-stimulus-box" class="flex flex-col items-center justify-center w-full lg:w-auto shrink-0">
              <!-- Dynamically populated via script -->
            </div>

            <!-- Answer Options & Feedback Container -->
            <div class="w-full lg:w-1/2 flex flex-col justify-center">
              <div id="sample-prompt-text" class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-white mb-4 text-center lg:text-left leading-snug">
                Which tile logically completes the matrix pattern?
              </div>

              <!-- Options Grid Container -->
              <div id="sample-options-container" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
                <!-- Dynamically populated via script -->
              </div>

              <!-- Real-Time Feedback Container -->
              <div id="demo-feedback" class="mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all">
                Select an option above to verify your solution.
              </div>

              <!-- Dynamic Action Row (Next Question or Bridge to Test) -->
              <div id="sample-action-row" class="mt-4 flex flex-col sm:flex-row items-center gap-3">
                <button
                  type="button"
                  id="btn-sample-advance"
                  class="hidden w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm sm:text-base shadow-sm transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer items-center justify-center gap-2"
                >
                  <span id="btn-sample-advance-text">Next Sample Question</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- All 5 Completed Banner (Appears after solving all items) -->
          <div id="sample-completion-banner" class="hidden p-6 sm:p-8 bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800 text-center flex-col items-center">
