                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                type="button"
                id="btn-sample-next"
                class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-label="Next sample question"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Question Viewport + Interactive Choices Area -->
          <div id="sample-card-body" class="p-5 sm:p-8 md:p-10 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12 min-h-[380px]">
            <!-- Dynamic Stimulus Container -->
            <div id="sample-stimulus-box" class="flex flex-col items-center justify-center w-full lg:w-auto shrink-0">
              <!-- Dynamically populated via script -->
            </div>

            <!-- Answer Options & Feedback Container -->
            <div class="w-full lg:w-1/2 flex flex-col justify-center">
              <div id="sample-prompt-text" class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-white mb-4 text-center lg:text-left leading-snug">
                Which tile logically completes the matrix pattern?
              </div>

              <!-- Options Grid Container -->
              <div id="sample-options-container" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
                <!-- Dynamically populated via script -->
              </div>

              <!-- Real-Time Feedback Container -->
              <div id="demo-feedback" class="mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all">
                Select an option above to verify your solution.
              </div>

              <!-- Dynamic Action Row (Next Question or Bridge to Test) -->
              <div id="sample-action-row" class="mt-4 flex flex-col sm:flex-row items-center gap-3">
                <button
                  type="button"
                  id="btn-sample-advance"
                  class="hidden w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm sm:text-base shadow-sm transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer items-center justify-center gap-2"
                >
                  <span id="btn-sample-advance-text">Next Sample Question</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- All 5 Completed Banner (Appears after solving all items) -->
          <div id="sample-completion-banner" class="hidden p-6 sm:p-8 bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800 text-center flex-col items-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs font-mono font-semibold text-emerald-700 dark:text-emerald-300 mb-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              5 of 5 Samples Explored
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Ready for Your Comprehensive Assessment?
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mb-6 leading-relaxed">
              These sample items represent the 4 broad CHC cognitive domains. Start the standardized 24-question assessment to receive your psychometric IQ score estimate and percentile ranking.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full max-w-md">
              <a
                href="/test"
                class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] text-center"
              >
                Full Assessment (20 Min) &rarr;
              </a>
              <a
                href="/quick-test"
                class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-semibold text-sm border border-zinc-200 dark:border-zinc-700 transition-all text-center"
              >
                Quick Screening (10 Min)
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- THE COGNITIVE ECOSYSTEM GATEWAY (Agent 2: Ultra-Compact Mobile Scannability & Expandable Tool Drawers) -->
    <section id="ecosystem" class="py-16 sm:py-24 bg-zinc-50 dark:bg-zinc-950/60 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors reveal-on-scroll">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800 text-xs font-mono font-bold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-4 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
            Complete Cognitive Ecosystem &bull; 29 Tools
          </div>
          <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight">
            Beyond the IQ Test: Comprehensive Cognitive &amp; Health Tools
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-4 leading-relaxed">
            Explore our full suite of research-backed instruments. From clinical mood screeners and sensory diagnostics to reflex benchmarks and circadian lifestyle optimizers — all 100% free and private in your browser.
          </p>
        </div>

        <!-- 4-Pillar Cluster Grid (2x2 on Desktop, Clean Scannable Stack on Mobile) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          {pillarGroups.map((pillar) => {
            const featuredTools = pillar.tools.filter(t => t.featured);
            const drawerTools = pillar.tools.filter(t => !t.featured);

            return (
              <div class="rounded-3xl bg-white dark:bg-zinc-900/90 border border-zinc-200/80 dark:border-zinc-800 shadow-sm p-6 sm:p-7 flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                  <!-- Pillar Header -->
                  <div class="flex items-start justify-between gap-3 mb-4">
                    <div class="flex items-center gap-3">
                      <div class="w-11 h-11 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-xl flex items-center justify-center shrink-0 border border-zinc-200/60 dark:border-zinc-700/60 shadow-2xs">
                        {pillar.icon}
                      </div>
                      <div>
                        <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white leading-tight">
                          {pillar.title}
                        </h3>
                        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                          {pillar.subtitle}
                        </p>
                      </div>
                    </div>
                    <span class={`shrink-0 px-2.5 py-1 rounded-full text-xs font-mono font-bold border ${pillar.colorScheme.badge}`}>
                      {pillar.tools.length} Tools
                    </span>
                  </div>

                  <!-- Primary Featured Cards (Top Tier) -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 my-4">
                    {featuredTools.map((tool) => (
                      <a
                        href={tool.slug}
                        class="group/tool p-4 rounded-2xl bg-zinc-50/80 dark:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-700/60 hover:border-blue-500/50 dark:hover:border-blue-400/50 hover:bg-white dark:hover:bg-zinc-800 transition-all flex flex-col justify-between active:scale-[0.98]"
                      >
                        <div>
                          <div class="flex items-center justify-between gap-1 mb-2">
                            <span class={`px-2 py-0.5 rounded-md text-[10px] font-mono font-bold border ${tool.badgeClass}`}>
                              {tool.badge}
                            </span>
                            {tool.timeEstimate && (
                              <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                                {tool.timeEstimate}
                              </span>
                            )}
                          </div>
                          <h4 class="font-heading font-bold text-base text-zinc-900 dark:text-zinc-100 group-hover/tool:text-blue-600 dark:group-hover/tool:text-blue-400 transition-colors leading-snug">
                            {tool.title}
                          </h4>
                          <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mt-1.5 leading-relaxed">
                            {tool.description}
                          </p>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-zinc-200/60 dark:border-zinc-700/60 flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400">
                          <span>{tool.ctaText}</span>
                          <span class="group-hover/tool:translate-x-1 transition-transform">&rarr;</span>
                        </div>
                      </a>
                    ))}
                  </div>

                  <!-- Expandable Tool Drawer for Secondary Instruments -->
                  {drawerTools.length > 0 && (
                    <details class="group/drawer mt-4 rounded-2xl bg-zinc-50/60 dark:bg-zinc-950/40 border border-zinc-200/60 dark:border-zinc-800/70 overflow-hidden">
                      <summary class="min-h-[48px] px-4 py-3 cursor-pointer flex items-center justify-between text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 select-none transition-colors">
                        <span class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
