    </section>

    <!-- INTERACTIVE 5-ITEM SAMPLE STEPPER -->
    <section id="demo-puzzle" class="py-14 sm:py-20 bg-zinc-50 dark:bg-zinc-900/50 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors reveal-on-scroll">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <!-- Stepper Header -->
        <div class="text-center mb-8 sm:mb-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-3">
            TRY BEFORE YOU START &bull; INTERACTIVE SAMPLE QUESTIONS
          </span>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-zinc-950 dark:text-white mt-1 tracking-tight">
            Test Your Cognitive Reasoning
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl mx-auto">
            Experience 5 calibrated sample questions across Fluid, Spatial, Quantitative, and Verbal intelligence domains.
          </p>

          <!-- Stepper Navigation Pills -->
          <div class="flex items-center justify-center gap-2 sm:gap-3 mt-6" aria-label="Sample questions stepper">
            <button
              type="button"
              id="step-dot-0"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 1"
            >
              1. Matrix
            </button>
            <button
              type="button"
              id="step-dot-1"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
