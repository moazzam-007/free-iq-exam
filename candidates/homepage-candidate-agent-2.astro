    var btnNext = document.getElementById('btn-sample-next');
    var btnAdvance = document.getElementById('btn-sample-advance');
    var btnAdvanceText = document.getElementById('btn-sample-advance-text');
    var completionBanner = document.getElementById('sample-completion-banner');

    function renderActiveQuestion() {
      var q = sampleQuestions[currentIndex];
      if (!q) return;

      if (domainBadge) domainBadge.textContent = q.domain;
      if (subtypeText) subtypeText.textContent = q.subType;
      if (counterText) counterText.textContent = 'Item ' + (currentIndex + 1) + ' of ' + sampleQuestions.length;
      if (promptText) promptText.textContent = q.prompt;

      // Update Stepper Dot States
      for (var i = 0; i < sampleQuestions.length; i++) {
        var dot = document.getElementById('step-dot-' + i);
        if (dot) {
          if (i === currentIndex) {
            dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
          } else if (userAnswers[i] !== undefined) {
            dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
          } else {
            dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
          }
        }
      }

      // Prev / Next button disable states
      if (btnPrev) btnPrev.disabled = (currentIndex === 0);
      if (btnNext) btnNext.disabled = (currentIndex === sampleQuestions.length - 1);

      // Render Stimulus Graphic
      if (stimulusBox) {
        stimulusBox.innerHTML = '';
        if (q.id === 0) {
          // 3x3 Matrix Grid HTML
          var gridHtml = '<div class="p-4 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-inner inline-block"><div class="grid grid-cols-3 gap-2.5 sm:gap-3 w-60 sm:w-72">';
          q.gridCells.forEach(function(cell) {
            if (cell.shape === 'missing') {
              gridHtml += '<div class="aspect-square bg-blue-50 dark:bg-blue-950/60 border-2 border-dashed border-blue-400 dark:border-blue-600 rounded-xl flex items-center justify-center font-bold text-2xl text-blue-600 dark:text-blue-400 animate-pulse">?</div>';
            } else {
              var sym = cell.shape === 'circle' ? '●' : cell.shape === 'square' ? '■' : '▲';
              var repeatSym = Array(cell.count + 1).join(sym + ' ').trim();
              var fillStyle = cell.fill === 'outline' ? 'text-zinc-500 font-normal' : 'text-zinc-900 dark:text-white font-bold';
              gridHtml += '<div class="aspect-square bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl flex items-center justify-center text-sm sm:text-base ' + fillStyle + ' shadow-2xs">' + repeatSym + '</div>';
            }
          });
          gridHtml += '</div></div>';
          stimulusBox.innerHTML = gridHtml;
        } else if (q.id === 1) {
          // 3D Net Diagram Stimulus
          stimulusBox.innerHTML = '<div class="p-5 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200 dark:border-zinc-700 text-center"><div class="font-mono text-xs text-zinc-500 mb-2">Unfolded 2D Cube Net</div><div class="inline-grid grid-cols-4 gap-1 p-2 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-bold"><div class="w-8 h-8"></div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">●</div><div class="w-8 h-8"></div><div class="w-8 h-8"></div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">■</div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">+</div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">▲</div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">★</div><div class="w-8 h-8"></div><div class="w-8 h-8 bg-zinc-100 dark:bg-zinc-800 border flex items-center justify-center">◆</div><div class="w-8 h-8"></div><div class="w-8 h-8"></div></div></div>';
        } else if (q.id === 2) {
          // Sequence Display
          stimulusBox.innerHTML = '<div class="p-6 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200 dark:border-zinc-700 text-center"><div class="font-mono text-xs text-zinc-500 mb-3">Numerical Series Sequence</div><div class="flex items-center gap-2 sm:gap-3 flex-wrap justify-center font-mono font-bold text-base sm:text-xl"><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">3</span><span>&rarr;</span><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">7</span><span>&rarr;</span><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">15</span><span>&rarr;</span><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">31</span><span>&rarr;</span><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">63</span><span>&rarr;</span><span class="px-3.5 py-2 rounded-xl bg-blue-50 dark:bg-blue-950/60 border-2 border-dashed border-blue-500 text-blue-600 dark:text-blue-400">?</span></div></div>';
        } else if (q.id === 3) {
          // Syllogism Premise Card
          stimulusBox.innerHTML = '<div class="p-6 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200 dark:border-zinc-700 max-w-sm"><div class="font-mono text-xs text-zinc-500 uppercase tracking-wider mb-2">Formal Premises</div><div class="space-y-2 text-sm font-semibold text-zinc-800 dark:text-zinc-200"><div class="p-2.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">1. All Corvids are Passerines.</div><div class="p-2.5 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700">2. Some Corvids are Tool-Users.</div></div></div>';
        } else if (q.id === 4) {
          // XOR Cancellation Formula
          stimulusBox.innerHTML = '<div class="p-6 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl border border-zinc-200 dark:border-zinc-700 text-center"><div class="font-mono text-xs text-zinc-500 uppercase tracking-wider mb-3">XOR Cancellation Rule</div><div class="font-mono font-bold text-lg sm:text-xl flex items-center justify-center gap-3"><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border">[ ▲ ◆ ]</span><span>⊕</span><span class="px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border">[ ◆ ★ ]</span><span>=</span><span class="px-4 py-2 rounded-xl bg-blue-50 dark:bg-blue-950/60 border-2 border-dashed border-blue-500 text-blue-600">[ ? ]</span></div></div>';
        }
      }

      // Render Options
      if (optionsContainer) {
        optionsContainer.innerHTML = '';
        var chosenOptionId = userAnswers[currentIndex];

        q.options.forEach(function(opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-option-id', opt.id);
          var isChosen = (chosenOptionId === opt.id);

          var baseClasses = 'p-3 rounded-2xl border text-sm font-semibold transition-all flex items-center justify-center gap-2 cursor-pointer ';
          if (chosenOptionId !== undefined) {
            if (opt.isCorrect) {
              baseClasses += 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-400 text-emerald-800 dark:text-emerald-200 font-bold';
            } else if (isChosen) {
              baseClasses += 'bg-rose-50 dark:bg-rose-950/60 border-rose-400 text-rose-800 dark:text-rose-200 font-bold';
            } else {
              baseClasses += 'bg-zinc-50 dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-400 opacity-60';
            }
          } else {
            baseClasses += 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 hover:bg-blue-50/40 dark:hover:bg-blue-950/30 text-zinc-800 dark:text-zinc-200';
          }

          btn.className = baseClasses;
          var btnText = opt.label;
          if (opt.shape === 'triangle' && opt.count) {
            btnText = Array(opt.count + 1).join('▲ ');
          } else if (opt.symbols) {
            btnText = opt.symbols.join(' ');
          }
          btn.innerHTML = '<span class="font-mono text-xs opacity-60 mr-1">' + opt.id + ')</span> ' + btnText;

          btn.addEventListener('click', function() {
            handleOptionSelect(opt);
          });

          optionsContainer.appendChild(btn);
        });
      }

      // Render Feedback Box
      if (feedbackBox) {
        if (userAnswers[currentIndex] !== undefined) {
          var selectedOpt = q.options.find(function(o) { return o.id === userAnswers[currentIndex]; });
          if (selectedOpt) {
            if (selectedOpt.isCorrect) {
              feedbackBox.className = 'mt-5 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-xs sm:text-sm font-medium text-emerald-800 dark:text-emerald-200 text-left transition-all';
              feedbackBox.innerHTML = '<div class="flex items-center gap-1.5 font-bold mb-1 text-emerald-700 dark:text-emerald-300"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg> Correct! ' + q.domain + '</div>' + selectedOpt.explanation;
            } else {
              feedbackBox.className = 'mt-5 p-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800 text-xs sm:text-sm font-medium text-rose-800 dark:text-rose-200 text-left transition-all';
              feedbackBox.innerHTML = '<div class="flex items-center gap-1.5 font-bold mb-1 text-rose-700 dark:text-rose-300"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> Incorrect</div>' + selectedOpt.explanation;
            }
          }
        } else {
          feedbackBox.className = 'mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all';
          feedbackBox.textContent = 'Select an option above to verify your solution.';
        }
      }

      // Check if all answered to show completion banner
      checkAllAnswered();
    }

    function handleOptionSelect(opt) {
      userAnswers[currentIndex] = opt.id;
      renderActiveQuestion();

      if (btnAdvance) {
        btnAdvance.classList.remove('hidden');
        btnAdvance.classList.add('flex');
        if (currentIndex < sampleQuestions.length - 1) {
          if (btnAdvanceText) btnAdvanceText.textContent = 'Next Sample Question (' + (currentIndex + 2) + '/5)';
        } else {
          if (btnAdvanceText) btnAdvanceText.textContent = 'Start Full Standard Test (24 Items)';
        }
      }
    }

    function checkAllAnswered() {
      var answeredCount = Object.keys(userAnswers).length;
      if (answeredCount >= sampleQuestions.length) {
        if (completionBanner) {
          completionBanner.classList.remove('hidden');
          completionBanner.classList.add('flex');
        }
      }
    }

    // Attach Click Events to Nav Buttons
    for (var i = 0; i < sampleQuestions.length; i++) {
      (function(idx) {
        var dot = document.getElementById('step-dot-' + idx);
        if (dot) {
          dot.addEventListener('click', function() {
            currentIndex = idx;
            renderActiveQuestion();
          });
        }
      })(i);
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        if (currentIndex > 0) {
          currentIndex--;
          renderActiveQuestion();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        if (currentIndex < sampleQuestions.length - 1) {
          currentIndex++;
          renderActiveQuestion();
        }
      });
    }

    if (btnAdvance) {
      btnAdvance.addEventListener('click', function() {
        if (currentIndex < sampleQuestions.length - 1) {
          currentIndex++;
          renderActiveQuestion();
        } else {
          window.location.href = '/test';
        }
      });
    }

    // Initial render
    renderActiveQuestion();
  })();

  // Scroll Reveal Observer for Homepage Sections
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var revealEls = document.querySelectorAll('.reveal-on-scroll');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    revealEls.forEach(function(el) { observer.observe(el); });
  } else {
    var allEls = document.querySelectorAll('.reveal-on-scroll');
    for (var e = 0; e < allEls.length; e++) {
      allEls[e].classList.add('revealed');
    }
  }
</script>
