      display: grid;
      grid-template-columns: repeat(3, 74px);
      gap: 8px;
    }

    .xor-tile {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 74px;
      height: 74px;
      border: 1px solid #e4e4e7;
      border-radius: 14px;
      background: white;
    }

    .xor-tile i,
    .xor-tile b {
      position: absolute;
      width: 52px;
      height: 3px;
      border-radius: 999px;
      background: #18181b;
      display: block;
    }

    .xor-tile i { transform: rotate(90deg); }
    .xor-tile b { transform: rotate(-45deg); }

    .game-card {
      content-visibility: auto;
      contain-intrinsic-size: 1px 420px;
    }

    @media (min-width: 640px) {
      .cube-net {
        grid-template-columns: repeat(4, 58px);
        grid-template-rows: repeat(3, 58px);
      }
      .net-cell {
        border-radius: 14px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
      }
    }

    @media (prefers-color-scheme: dark) {
      .matrix-cell,
      .net-cell,
      .logic-stage > div,
      .xor-tile {
        background: #0f1016;
        border-color: rgba(255,255,255,0.08);
        color: #fff;
      }
      .sample-question,
      .logic-conclusion {
        background: rgba(41,151,255,0.08) !important;
        border-color: rgba(41,151,255,0.45) !important;
        color: #2997ff !important;
      }
      .sequence-stage { color: #fff; }
      .sequence-question { color: #2997ff; }
      .xor-tile i,
      .xor-tile b { background: #fff; }
    }
  </style>

  <script define:vars={{ sampleItems }}>
    const items = sampleItems;
    let current = 0;
    const answered = new Map();

    const domainEl = document.getElementById('sample-domain');
    const subtypeEl = document.getElementById('sample-subtype');
    const counterEl = document.getElementById('sample-counter');
    const promptEl = document.getElementById('sample-prompt');
    const stimulusEl = document.getElementById('sample-stimulus');
    const optionsEl = document.getElementById('sample-options');
    const feedbackEl = document.getElementById('sample-feedback');
    const previousBtn = document.getElementById('sample-prev');
    const nextBtn = document.getElementById('sample-next');
    const sampleCta = document.getElementById('sample-cta');

    function render() {
      const item = items[current];
      if (!item) return;

      domainEl.textContent = item.domain;
      subtypeEl.textContent = item.subtype;
      counterEl.textContent = `Item ${current + 1} of ${items.length}`;
      promptEl.textContent = item.prompt;
      stimulusEl.innerHTML = item.stimulus;

      optionsEl.innerHTML = '';
      item.options.forEach((option, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'min-h-[52px] rounded-2xl border border-zinc-200 bg-white px-4 py-3 text-left transition hover:border-blue-500 hover:text-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:border-white/10 dark:bg-[#0b0c11] dark:text-white dark:hover:border-[#2997ff] dark:hover:text-[#2997ff]';
        button.innerHTML = `<span class="mr-3 inline-flex min-h-[30px] min-w-[30px] items-center justify-center rounded-full bg-zinc-100 font-mono text-[13px] font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">${String.fromCharCode(65 + index)}</span><span class="text-[15px] font-semibold">${option}</span>`;
        button.addEventListener('click', () => answer(index));
        optionsEl.appendChild(button);
      });

      const existing = answered.get(current);
      if (existing) {
        showResult(existing.index, existing.correct, false);
      } else {
        feedbackEl.className = 'mt-5 rounded-2xl border border-zinc-200 bg-zinc-50 p-5 text-[14px] leading-relaxed text-zinc-700 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300';
        feedbackEl.textContent = 'Select an option to check your reasoning.';
        sampleCta.classList.add('hidden');
        sampleCta.classList.remove('inline-flex');
      }

      previousBtn.disabled = current === 0;
      nextBtn.disabled = current === items.length - 1;

      document.querySelectorAll('.sample-step').forEach((step, index) => {
        step.classList.toggle('bg-[#0066cc]', index === current);
        step.classList.toggle('text-white', index === current);
        step.classList.toggle('border-[#0066cc]', index === current);
        if (index === current) {
          step.setAttribute('aria-current', 'step');
        } else {
          step.removeAttribute('aria-current');
        }
      });
    }

    function answer(index) {
      const item = items[current];
      const correct = index === item.correct;
      answered.set(current, { index, correct });
      showResult(index, correct, true);
      if (answered.size === items.length) {
        sampleCta.classList.remove('hidden');
        sampleCta.classList.add('inline-flex');
      }
      document.querySelectorAll('.sample-step').forEach((step, stepIndex) => {
        if (answered.has(stepIndex) && stepIndex !== current) {
          step.classList.add('ring-1', 'ring-blue-500');
        }
      });
    }

    function showResult(index, correct, focusFeedback) {
      const item = items[current];
      const optionText = item.options[index];

      feedbackEl.className = correct
        ? 'mt-5 rounded-2xl border border-blue-300 bg-blue-50 p-5 text-[14px] leading-relaxed text-zinc-800 dark:border-blue-500/40 dark:bg-blue-500/10 dark:text-zinc-200'
        : 'mt-5 rounded-2xl border border-zinc-300 bg-zinc-50 p-5 text-[14px] leading-relaxed text-zinc-700 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300';

      feedbackEl.innerHTML = `<strong class="block text-[15px] font-semibold ${correct ? 'text-blue-700 dark:text-[#2997ff]' : 'text-zinc-900 dark:text-white'}">${correct ? 'Correct.' : 'Not quite.'} You chose ${optionText}.</strong><span class="mt-1 block">${item.explanation}</span>`;

      optionsEl.querySelectorAll('button').forEach((button, optionIndex) => {
        button.classList.remove('border-blue-500', 'bg-blue-50', 'border-zinc-300', 'opacity-60');
        if (optionIndex === item.correct) {
          button.classList.add('border-blue-500', 'bg-blue-50');
        }
        if (optionIndex === index && index !== item.correct) {
          button.classList.add('border-zinc-300', 'opacity-60');
        }
      });

      if (focusFeedback) feedbackEl.focus?.();
      if (current === items.length - 1) {
        sampleCta.classList.remove('hidden');
        sampleCta.classList.add('inline-flex');
      } else if (answered.size > 0) {
        sampleCta.classList.remove('hidden');
        sampleCta.classList.add('inline-flex');
      }
    }

    document.querySelectorAll('.sample-step').forEach((step) => {
      step.addEventListener('click', () => {
        current = Number(step.getAttribute('data-step'));
        render();
      });
    });

    previousBtn?.addEventListener('click', () => {
      if (current > 0) {
        current -= 1;
        render();
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (current < items.length - 1) {
        current += 1;
        render();
      }
    });

    render();

    // Touch/drag physics for the full-bleed games reel.
    const track = document.querySelector('.games-track');
    if (track) {
      let pointerDown = false;
      let startX = 0;
      let startScroll = 0;

      track.addEventListener('pointerdown', (event) => {
        pointerDown = true;
        track.setPointerCapture(event.pointerId);
        startX = event.clientX;
        startScroll = track.scrollLeft;
        track.style.cursor = 'grabbing';
      });

      track.addEventListener('pointermove', (event) => {
        if (!pointerDown) return;
        track.scrollLeft = startScroll - (event.clientX - startX);
      });

      const stopDragging = () => {
        pointerDown = false;
        track.style.cursor = 'grab';
      };

      track.addEventListener('pointerup', stopDragging);
      track.addEventListener('pointercancel', stopDragging);
      track.addEventListener('pointerleave', () => { if (pointerDown) stopDragging(); });
      track.style.cursor = 'grab';
    }
  </script>
</Layout>
