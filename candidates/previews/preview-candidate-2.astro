---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free IQ Test Online 2026 - Instant Results, No Email Required | FreeIQExam";
const description =
  "Take a free, scientifically grounded online IQ assessment. 24 standardized items, 2PL Item Response Theory scoring, instant results, and no email or paywall.";

type Tool = {
  slug: string;
  title: string;
  category: 'clinical' | 'reflex' | 'mind' | 'games' | 'science';
  categoryLabel: string;
  badge: string;
  description: string;
};

const tools: Tool[] = [
  { slug: '/adhd-test', title: 'Adult ADHD Screener', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'WHO ASRS v1.1', description: 'A structured adult attention screening experience with an immediate browser-based summary.' },
  { slug: '/depression-test', title: 'Depression Screener (PHQ-9)', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'PHQ-9', description: 'A standardized mood screening workflow with a clear score interpretation and scope note.' },
  { slug: '/anxiety-test', title: 'Generalized Anxiety Screener (GAD-7)', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'GAD-7', description: 'A focused anxiety screening flow covering the seven-item GAD-7 scale.' },
  { slug: '/autism-test', title: 'Autism Spectrum Screener (AQ-10)', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'AQ-10', description: 'A concise screening-oriented questionnaire with transparent limitations and context.' },
  { slug: '/color-blind-test', title: 'Ishihara Color Blindness Test', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'Ishihara', description: 'Plate-based color perception screening designed for quick browser use.' },
  { slug: '/hearing-test', title: 'Hearing Frequency Perception Test', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: '20 Hz–20 kHz', description: 'Browser-based tone perception testing across a broad audible-frequency range.' },
  { slug: '/eye-test', title: 'Visual Acuity & Snellen Eye Test', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'Snellen', description: 'A browser visual-acuity check with clear instructions for responsible use.' },
  { slug: '/mic-test', title: 'Microphone & Audio Hardware Benchmark', category: 'clinical', categoryLabel: 'Clinical & Sensory', badge: 'Hardware', description: 'A quick local microphone and audio-input diagnostic without account creation.' },

  { slug: '/reaction-time-test', title: 'Visual Reaction Time Test', category: 'reflex', categoryLabel: 'Reflex & Speed', badge: 'Latency', description: 'Measure visual response latency with repeated trials and a transparent summary.' },
  { slug: '/typing-test', title: 'Typing Speed & Accuracy Benchmark', category: 'reflex', categoryLabel: 'Reflex & Speed', badge: 'WPM', description: 'Track words per minute, accuracy, consistency, and errors in a focused typing run.' },
  { slug: '/aim-trainer', title: 'Precision Aim Trainer', category: 'reflex', categoryLabel: 'Reflex & Speed', badge: 'Precision', description: 'Train pointing speed and target acquisition with lightweight browser telemetry.' },
  { slug: '/games/click-speed-test', title: 'Click Speed Test (CPS)', category: 'reflex', categoryLabel: 'Reflex & Speed', badge: 'CPS', description: 'A simple click-rate benchmark measuring clicks per second over short intervals.' },

  { slug: '/sleep-calculator', title: '90-Minute Sleep Cycle Calculator', category: 'mind', categoryLabel: 'Health & Resilience', badge: 'Circadian', description: 'Plan wake or sleep times around configurable sleep-cycle assumptions.' },
  { slug: '/brown-noise', title: 'Ambient Brown Noise Generator', category: 'mind', categoryLabel: 'Health & Resilience', badge: 'Audio', description: 'A local browser sound utility for focus, masking, and background ambience.' },
  { slug: '/calorie-calculator', title: 'TDEE & Energy Calculator', category: 'mind', categoryLabel: 'Health & Resilience', badge: 'TDEE', description: 'Estimate daily energy requirements from standard activity and body-metric inputs.' },
  { slug: '/circle-of-control', title: 'Circle of Control Matrix', category: 'mind', categoryLabel: 'Health & Resilience', badge: 'Reflection', description: 'Sort situations by direct control, influence, or outside control.' },
  { slug: '/memento-mori', title: 'Memento Mori 80-Year Life Grid', category: 'mind', categoryLabel: 'Health & Resilience', badge: 'Visualization', description: 'A perspective-oriented life-grid visualization using an 80-year reference frame.' },

  { slug: '/games/n-back', title: 'Dual N-Back Working Memory', category: 'games', categoryLabel: 'Brain Training', badge: 'Working Memory', description: 'A compact dual-stream working-memory drill with adaptive-looking game pacing.' },
  { slug: '/games/memory-matrix', title: 'Memory Matrix Spatial Span', category: 'games', categoryLabel: 'Brain Training', badge: 'Spatial', description: 'Memorize highlighted cells and reproduce the spatial pattern under time pressure.' },
  { slug: '/games/stroop-clash', title: 'Stroop Color Conflict Clash', category: 'games', categoryLabel: 'Brain Training', badge: 'Inhibition', description: 'Resolve response conflict between written color words and displayed ink colors.' },
  { slug: '/games/flanker-test', title: 'Flanker Directional Response', category: 'games', categoryLabel: 'Brain Training', badge: 'Attention', description: 'Respond to a central target while ignoring congruent or incongruent flankers.' },
  { slug: '/games/math-sprint', title: 'Speed Math Sprint', category: 'games', categoryLabel: 'Brain Training', badge: 'Quantitative', description: 'Solve short arithmetic items rapidly while tracking accuracy and pace.' },
  { slug: '/games/rotation', title: '3D Mental Spatial Rotation', category: 'games', categoryLabel: 'Brain Training', badge: 'Visual-Spatial', description: 'Compare rotated objects and train rapid mental transformation.' },
  { slug: '/games/sequence-rush', title: 'Sequence Rush Inductive Series', category: 'games', categoryLabel: 'Brain Training', badge: 'Inductive', description: 'Find the governing rule in changing sequences and select the next state quickly.' },
  { slug: '/games/symbol-match', title: 'Symbol Match Perceptual Coding', category: 'games', categoryLabel: 'Brain Training', badge: 'Coding', description: 'Match symbols under pressure to exercise visual scanning and response speed.' },
  { slug: '/games/syllogism', title: 'Propositional Syllogism Blitz', category: 'games', categoryLabel: 'Brain Training', badge: 'Deduction', description: 'Evaluate short logical arguments and classify their conclusions.' },
  { slug: '/games/digit-span', title: 'Digit Span Working Memory Loop', category: 'games', categoryLabel: 'Brain Training', badge: 'Recall', description: 'Repeat digit sequences in order and test short-term retention as difficulty rises.' },

  { slug: '/matrix-reasoning-test', title: 'Matrix Reasoning Guide', category: 'science', categoryLabel: 'Psychometric Science', badge: 'Guide', description: 'A practical explanation of matrix reasoning, item transformations, and common rule families.' },
  { slug: '/iq-score-chart', title: 'IQ Score Distribution & Gaussian Bell Curve', category: 'science', categoryLabel: 'Psychometric Science', badge: 'Distribution', description: 'Explore how standardized-score distributions are commonly visualized around a reference mean.' },
  { slug: '/iq-percentile-calculator', title: 'IQ Percentile Rank Calculator', category: 'science', categoryLabel: 'Psychometric Science', badge: 'Percentile', description: 'Translate a standardized score into a percentile under the selected distribution model.' },
  { slug: '/methodology', title: 'Psychometric Methodology & 2PL IRT', category: 'science', categoryLabel: 'Psychometric Science', badge: '2PL IRT', description: 'Read the assessment methodology, construct definitions, scoring model, and key limitations.' }
];

const games = tools.filter((tool) => tool.category === 'games');
const clinical = tools.filter((tool) => tool.category === 'clinical');
const reflex = tools.filter((tool) => tool.category === 'reflex');
const mind = tools.filter((tool) => tool.category === 'mind');
const science = tools.filter((tool) => tool.category === 'science');

const faqs = [
  {
    q: 'Is FreeIQExam free?',
    a: 'The homepage and listed tools are presented as free to use, with no subscription paywall. Results are designed to be shown directly in the browser where the tool supports local computation.'
  },
  {
    q: 'Do I need an email address or an account?',
    a: 'The core assessment flow is designed without requiring an email address or account. When a calculation can run client-side, the interface can compute it in the browser without sending answer data to a remote database.'
  },
  {
    q: 'How does the 24-item assessment use 2PL IRT?',
    a: 'The assessment describes item responses with a two-parameter logistic framework using item difficulty and discrimination parameters, then estimates ability from the response pattern rather than using a simple percentage-correct total.'
  },
  {
    q: 'Does an online score replace a clinical IQ assessment?',
    a: 'No. An online estimate is not a substitute for a professionally administered cognitive assessment. Results should be treated as an informational screening or practice measure, not a diagnosis or formal clinical determination.'
  },
  {
    q: 'What are the four CHC domains shown on the homepage?',
    a: 'The platform organizes its flagship assessment experience around Fluid Reasoning (Gf), Visual-Spatial Processing (Gv), Quantitative Reasoning (Gq), and Verbal Comprehension / reasoning (Gc) as presented in the site materials.'
  },
  {
    q: 'Are the clinical screeners diagnostic?',
    a: 'No. The clinical section is screening-oriented. A screening score can indicate that further evaluation may be worth discussing with a qualified professional, but it does not by itself establish a diagnosis.'
  },
  {
    q: 'What happens to my answers?',
    a: 'The product is designed around a privacy-first, client-side experience where feasible. The precise data behavior still depends on each individual tool, so users should check that tool’s own privacy or methodology information.'
  }
];

const itemList = tools.map((tool, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: tool.title,
  url: `https://freeiqexam.com${tool.slug}`
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'FreeIQExam',
    url: 'https://freeiqexam.com/',
    description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'FreeIQExam',
    url: 'https://freeiqexam.com/',
    logo: 'https://freeiqexam.com/logo-horizontal.svg',
    sameAs: ['https://github.com/freeiqexam'],
    description: 'An open, privacy-first platform for free cognitive assessments, screeners, browser utilities, and psychometric education.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'FreeIQExam Cognitive Assessment',
    url: 'https://freeiqexam.com/',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    description: 'A browser-based cognitive assessment experience using a 24-item item bank and 2PL Item Response Theory scoring.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: '24-item cognitive assessment, 2PL IRT scoring, instant browser results, no email required'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'FreeIQExam Cognitive, Clinical, Wellness & Psychometric Tools',
    description: 'Directory of 31 free tools and assessment resources across cognitive training, screening, reflex benchmarks, resilience utilities, and psychometric education.',
    numberOfItems: tools.length,
    itemListElement: itemList
  }
];

const sampleItems = [
  {
    id: 1,
    domain: 'Fluid Reasoning (Gf)',
    subtype: 'Matrix transformation',
    prompt: 'Which option completes the transformation sequence?',
    stimulus: `
      <div class="sample-matrix" aria-hidden="true">
        <div class="matrix-cell">●</div><div class="matrix-cell">●●</div><div class="matrix-cell">●●●</div>
        <div class="matrix-cell">▲</div><div class="matrix-cell">▲▲</div><div class="matrix-cell">▲▲▲</div>
        <div class="matrix-cell">■</div><div class="matrix-cell">■■</div><div class="matrix-cell sample-question">?</div>
      </div>`,
    options: ['■', '■■', '■■■', '■▲'],
    correct: 2,
    explanation: 'Each row increases the repeated symbol count from one to three. The missing cell therefore contains three squares.'
  },
  {
    id: 2,
    domain: 'Visual-Spatial (Gv)',
    subtype: 'Cube net folding',
    prompt: 'Which face becomes opposite the marked center face after folding?',
    stimulus: `
      <div class="cube-net" aria-hidden="true">
        <span class="net-cell net-a">1</span><span class="net-cell net-b">2</span><span class="net-cell net-c">3</span>
        <span class="net-cell net-d">4</span><span class="net-cell net-e">5</span><span class="net-cell net-f">6</span>
      </div>`,
    options: ['Face 1', 'Face 3', 'Face 5', 'Face 6'],
    correct: 3,
    explanation: 'With the displayed cross-like net, the face paired opposite the center through the fold is the far terminal face represented by 6.'
  },
  {
    id: 3,
    domain: 'Quantitative (Gq)',
    subtype: 'Exponential sequence',
    prompt: 'What number replaces the question mark?',
    stimulus: `
      <div class="sequence-stage" aria-hidden="true">
        <span>3</span><span>5</span><span>9</span><span>17</span><span>33</span><span class="sequence-question">?</span>
      </div>`,
    options: ['49', '57', '65', '67'],
    correct: 2,
    explanation: 'The differences are +2, +4, +8, +16, so the next difference is +32. Therefore 33 + 32 = 65.'
  },
  {
    id: 4,
    domain: 'Verbal Reasoning (Gc)',
    subtype: 'Categorical syllogism',
    prompt: 'Does the conclusion necessarily follow from the two premises?',
    stimulus: `
      <div class="logic-stage">
        <div><strong>P1</strong> All matrix puzzles require spatial reasoning.</div>
        <div><strong>P2</strong> Some screening tasks are matrix puzzles.</div>
        <div class="logic-conclusion"><strong>C</strong> Some screening tasks require spatial reasoning.</div>
      </div>`,
    options: ['Valid', 'Invalid', 'Indeterminate', 'Contradictory'],
    correct: 0,
    explanation: 'If all matrix puzzles have the stated property and some screening tasks are matrix puzzles, those screening tasks inherit the property.'
  },
  {
    id: 5,
    domain: 'Fluid Reasoning (Gf)',
    subtype: 'Boolean XOR superposition',
    prompt: 'Column 3 is formed by XOR: identical segments cancel. What is the missing tile?',
    stimulus: `
      <div class="xor-grid" aria-hidden="true">
        <div class="xor-tile"><i></i></div><div class="xor-tile"><i></i><b></b></div><div class="xor-tile"><b></b></div>
        <div class="xor-tile"><i></i></div><div class="xor-tile"><i></i><b></b></div><div class="xor-tile"><b></b></div>
        <div class="xor-tile"><b></b></div><div class="xor-tile"><i></i><b></b></div><div class="xor-tile sample-question">?</div>
      </div>`,
    options: ['/', '\\', 'X', '+'],
    correct: 1,
    explanation: 'XOR removes segments present in both operands and preserves only segments that occur once, leaving the backslash.'
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/" />

  <main class="min-h-screen bg-white text-zinc-950 transition-colors dark:bg-black dark:text-white">
    <!-- 1. HERO -->
    <section class="relative overflow-hidden border-b border-zinc-200 bg-white dark:border-white/10 dark:bg-black">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_50%_0%,rgba(0,102,204,0.12),transparent_62%)] dark:bg-[radial-gradient(circle_at_50%_0%,rgba(41,151,255,0.12),transparent_62%)]"></div>

      <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-14 sm:px-6 sm:pt-20 md:pb-28 md:pt-28">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-7 inline-flex min-h-[44px] items-center gap-2 rounded-full border border-zinc-200 bg-zinc-100 px-4 py-2 font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-700 dark:border-white/10 dark:bg-zinc-900 dark:text-zinc-300">
            <span class="h-2 w-2 rounded-full bg-blue-600 dark:bg-[#2997ff]" aria-hidden="true"></span>
            4-domain CHC cognitive assessment
          </div>

          <h1 class="text-5xl font-extrabold leading-[1.08] tracking-[-0.025em] text-zinc-950 sm:text-6xl dark:text-white">
            Measure how you think.<br />
            <span class="text-blue-700 dark:text-[#2997ff]">Keep the result yours.</span>
          </h1>

          <p class="mx-auto mt-7 max-w-3xl text-base leading-relaxed text-zinc-600 sm:text-lg dark:text-zinc-300">
            A browser-first cognitive assessment hub built around structured items, 2PL Item Response Theory,
            instant scoring, and a no-email, no-subscription starting point.
          </p>

          <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/test" class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-[#0066cc] px-7 text-base font-semibold text-white shadow-sm transition duration-200 hover:scale-[1.01] hover:bg-[#0071e3] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:bg-[#2997ff] dark:text-black dark:hover:bg-[#3b82f6] dark:focus-visible:ring-offset-black">
              Take Full Test <span class="ml-2" aria-hidden="true">→</span>
            </a>
            <a href="/quick-test" class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-zinc-300 bg-white px-7 text-base font-semibold text-zinc-900 transition duration-200 hover:scale-[1.01] hover:border-zinc-400 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-white/25 dark:focus-visible:ring-offset-black">
              Quick Screening <span class="ml-2 text-blue-700 dark:text-[#2997ff]">10m</span>
            </a>
          </div>

          <div class="mx-auto mt-9 grid max-w-4xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-200 dark:border-white/10 dark:bg-white/10 sm:grid-cols-4">
            <div class="bg-white px-4 py-4 dark:bg-zinc-950">
              <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Structure</div>
              <div class="mt-1 text-[15px] font-semibold text-zinc-900 dark:text-white">4 CHC domains</div>
            </div>
            <div class="bg-white px-4 py-4 dark:bg-zinc-950">
              <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Model</div>
              <div class="mt-1 text-[15px] font-semibold text-zinc-900 dark:text-white">2PL IRT</div>
            </div>
            <div class="bg-white px-4 py-4 dark:bg-zinc-950">
              <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Access</div>
              <div class="mt-1 text-[15px] font-semibold text-zinc-900 dark:text-white">No email start</div>
            </div>
            <div class="bg-white px-4 py-4 dark:bg-zinc-950">
              <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Output</div>
              <div class="mt-1 text-[15px] font-semibold text-zinc-900 dark:text-white">Instant browser result</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. INTERACTIVE SAMPLE STEPPER -->
    <section id="sample" class="border-b border-zinc-200 bg-[#f5f5f7] py-20 dark:border-white/10 dark:bg-[#090a0f] sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Interactive sample stage</div>
          <h2 class="mt-3 text-4xl font-bold leading-[1.15] tracking-[-0.02em] text-zinc-950 dark:text-white sm:text-5xl">
            Try five reasoning items.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
            Select an answer, reveal the rule, and move through Fluid, Spatial, Quantitative, and Verbal reasoning examples.
          </p>
        </div>

        <div class="mx-auto mt-9 flex flex-wrap justify-center gap-2" aria-label="Sample question navigation">
          {sampleItems.map((item, i) => (
            <button
              type="button"
              id={`step-dot-${i}`}
              class="sample-step min-h-[44px] rounded-full border border-zinc-300 bg-white px-4 font-mono text-[13px] font-semibold text-zinc-700 transition hover:border-blue-500 hover:text-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300 dark:hover:border-[#2997ff] dark:hover:text-[#2997ff]"
              data-step={i}
              aria-label={`Open sample question ${i + 1}`}
            >
              {i + 1}. {item.domain.split(' ')[0]}
            </button>
          ))}
        </div>

        <div class="mt-7 overflow-hidden rounded-3xl border border-zinc-200 bg-white dark:border-white/10 dark:bg-[#0f1016]">
          <div class="flex flex-col gap-4 border-b border-zinc-200 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7 dark:border-white/10">
            <div>
              <div id="sample-domain" class="font-mono text-[13px] font-semibold uppercase tracking-wider text-blue-700 dark:text-[#2997ff]"></div>
              <div id="sample-subtype" class="mt-1 text-[15px] text-zinc-500 dark:text-zinc-400"></div>
            </div>
            <div id="sample-counter" class="font-mono text-[13px] font-semibold text-zinc-500">Item 1 of 5</div>
          </div>

          <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr]">
            <div class="border-b border-zinc-200 p-6 sm:p-8 lg:border-b-0 lg:border-r dark:border-white/10">
              <div id="sample-stimulus" class="flex min-h-[300px] items-center justify-center rounded-2xl bg-[#f5f5f7] p-5 dark:bg-black"></div>
            </div>
            <div class="p-6 sm:p-8">
              <p id="sample-prompt" class="text-base font-semibold leading-relaxed text-zinc-900 dark:text-white sm:text-lg"></p>
              <div id="sample-options" class="mt-6 grid gap-3 sm:grid-cols-2"></div>

              <div id="sample-feedback" class="mt-5 rounded-2xl border border-zinc-200 bg-zinc-50 p-5 text-[14px] leading-relaxed text-zinc-700 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300" aria-live="polite">
                Select an option to check your reasoning.
              </div>

              <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex gap-2">
                  <button id="sample-prev" type="button" class="min-h-[44px] rounded-full border border-zinc-300 bg-white px-5 text-[13px] font-semibold text-zinc-700 transition hover:border-zinc-400 disabled:cursor-not-allowed disabled:opacity-40 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300" disabled>
                    Previous
                  </button>
                  <button id="sample-next" type="button" class="min-h-[44px] rounded-full border border-zinc-300 bg-white px-5 text-[13px] font-semibold text-zinc-700 transition hover:border-zinc-400 disabled:cursor-not-allowed disabled:opacity-40 dark:border-white/10 dark:bg-white/5 dark:text-zinc-300">
                    Next
                  </button>
                </div>
                <a id="sample-cta" href="/test" class="hidden min-h-[44px] items-center justify-center rounded-full bg-[#0066cc] px-5 text-[14px] font-semibold text-white transition hover:scale-[1.01] hover:bg-[#0071e3] active:scale-[0.98] dark:bg-[#2997ff] dark:text-black dark:hover:bg-[#3b82f6]">
                  Take the full assessment →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. BRAIN TRAINING ARENA -->
    <section id="games" class="overflow-hidden border-b border-zinc-200 bg-white py-20 dark:border-white/10 dark:bg-black sm:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-3xl">
            <div class="font-mono text-[13px] font-semibold uppercase tracking-wider text-zinc-500">Neurocognitive brain training</div>
            <h2 class="mt-3 text-4xl font-bold tracking-[-0.02em] dark:text-white sm:text-5xl">The Brain Training Arena</h2>
            <p class="mt-5 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
              Ten focused browser drills spanning working memory, inhibition, spatial transformation, induction, attention, and response speed.
            </p>
          </div>
          <a href="/games" class="inline-flex min-h-[44px] items-center text-base font-semibold text-[#0066cc] hover:underline dark:text-[#2997ff]">
            Open all games →
          </a>
        </div>
      </div>

      <div class="relative mt-9">
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-white to-transparent dark:from-black"></div>
