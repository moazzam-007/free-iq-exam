          stimulus: function () {
            function g(lines) {
              var s = '<div class="fx-cell flex items-center justify-center p-2"><svg viewBox="0 0 40 40" class="h-8 w-8 fx-glyph" stroke-width="3" stroke-linecap="round" aria-hidden="true">';
              for (var i = 0; i < lines.length; i++) s += lines[i];
              return s + '</svg></div>';
            }
            var V = '<line x1="20" y1="6" x2="20" y2="34"/>';
            var H = '<line x1="6" y1="20" x2="34" y2="20"/>';
            var F = '<line x1="8" y1="32" x2="32" y2="8"/>';
            var B = '<line x1="8" y1="8" x2="32" y2="32"/>';
            return '<div class="' + STAGE + ' grid grid-cols-3 gap-2 p-4 sm:gap-3">' +
              g([V]) + g([V, H]) + g([H]) +
              g([H]) + g([V, H]) + g([V]) +
              g([F]) + g([F, B]) +
              '<div class="fx-slot flex items-center justify-center"><span class="font-heading text-3xl font-black">?</span></div>' +
              '</div>';
          },
          options: [
            { label: 'A', html: '<div class="flex h-8 items-center justify-center"><svg viewBox="0 0 40 40" class="h-7 w-7 fx-glyph" stroke-width="3" stroke-linecap="round"><line x1="8" y1="8" x2="32" y2="32"/></svg></div>', correct: true },
            { label: 'B', html: '<div class="flex h-8 items-center justify-center"><svg viewBox="0 0 40 40" class="h-7 w-7 fx-glyph" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/></svg></div>', correct: false },
            { label: 'C', html: '<div class="flex h-8 items-center justify-center"><svg viewBox="0 0 40 40" class="h-7 w-7 fx-glyph" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/><line x1="8" y1="8" x2="32" y2="32"/></svg></div>', correct: false },
            { label: 'D', html: '<div class="flex h-8 items-center justify-center"><svg viewBox="0 0 40 40" class="h-7 w-7 fx-glyph" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/><line x1="6" y1="20" x2="34" y2="20"/></svg></div>', correct: false }
          ],
          rule: 'Segments present in both columns cancel; segments unique to one column survive. In row three the forward slash appears in both tiles and cancels, leaving the backslash alone.',
          hint: 'Compare rows one and two first: the element shared by columns 1 and 2 is the one that disappears.'
        }
      ];

      function cubeSvg(faces) {
        var glyphs = {
          circle: '<circle cx="30" cy="22" r="6" fill="currentColor"/>',
          square: '<rect x="24" y="16" width="12" height="12" rx="1" fill="currentColor"/>',
          diamond: '<polygon points="40,36 46,42 40,48 34,42" fill="currentColor"/>',
          triangle: '<polygon points="20,36 26,48 14,48" fill="currentColor"/>',
          cross: '<path d="M20,38 L20,48 M15,43 L25,43" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>'
        };
        var inner = '';
        for (var i = 0; i < faces.length; i++) if (faces[i]) inner += glyphs[faces[i]];
        return '<div class="mx-auto flex h-14 w-14 items-center justify-center" style="color:var(--fx-action)">' +
          '<svg viewBox="0 0 60 60" class="h-14 w-14" fill="none" aria-hidden="true">' +
          '<path d="M30,10 L50,22 L30,34 L10,22 Z" stroke="currentColor" stroke-opacity=".55" stroke-width="1.5"/>' +
          '<path d="M10,22 L30,34 L30,55 L10,43 Z" stroke="currentColor" stroke-opacity=".55" stroke-width="1.5"/>' +
          '<path d="M50,22 L30,34 L30,55 L50,43 Z" stroke="currentColor" stroke-opacity=".55" stroke-width="1.5"/>' +
          inner + '</svg></div>';
      }

      var idx = 0;
      var answers = {};

      var $badge = document.getElementById('sample-domain-badge');
      var $subtype = document.getElementById('sample-subtype-text');
      var $counter = document.getElementById('sample-counter-text');
      var $prompt = document.getElementById('sample-prompt-text');
      var $stimulus = document.getElementById('sample-stimulus-box');
      var $options = document.getElementById('sample-options-container');
      var $feedback = document.getElementById('sample-feedback');
      var $advance = document.getElementById('btn-sample-advance');
      var $advanceText = document.getElementById('btn-sample-advance-text');
      var $banner = document.getElementById('sample-completion-banner');

      if (!$stimulus || !$options) return;

      function paintStepper() {
        for (var i = 0; i < ITEMS.length; i++) {
          var dot = document.getElementById('step-dot-' + i);
          if (!dot) continue;
          dot.classList.remove('is-active', 'is-done');
          dot.setAttribute('aria-selected', i === idx ? 'true' : 'false');
          if (i === idx) dot.classList.add('is-active');
          else if (answers[i]) dot.classList.add('is-done');
        }
      }

      function paintFeedback(rec, item) {
        $feedback.className = 'fx-feedback mt-5 p-4 sm:p-5 text-center text-[13px] sm:text-sm';
        if (rec.correct) {
          $feedback.classList.add('is-correct');
          $feedback.innerHTML =
            '<p class="font-semibold" style="color:#059669">Correct &mdash; option ' + rec.label + '.</p>' +
            '<p class="mt-1.5 leading-relaxed fx-ink-2">' + item.rule + '</p>';
        } else {
          $feedback.classList.add('is-wrong');
          $feedback.innerHTML =
            '<p class="font-semibold" style="color:#e11d48">Option ' + rec.label + ' is not the solution.</p>' +
            '<p class="mt-1.5 leading-relaxed fx-ink-2">' + item.hint + '</p>' +
            '<p class="mt-2 leading-relaxed fx-ink-3">' + item.rule + '</p>';
        }
        $advance.classList.remove('hidden');
        $advance.classList.add('flex');
        $advanceText.textContent = idx < ITEMS.length - 1
          ? 'Next sample item (' + (idx + 2) + ' of 5)'
          : 'Start the full assessment';
      }

      function render() {
        var item = ITEMS[idx];
        var rec = answers[idx];

        $badge.textContent = item.badge;
        $subtype.textContent = item.subtype;
        $counter.textContent = 'Item ' + (idx + 1) + ' of ' + ITEMS.length;
        $prompt.textContent = item.prompt;
        $stimulus.innerHTML = item.stimulus();

        $options.innerHTML = '';
        item.options.forEach(function (opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'fx-opt fx-focus flex min-h-[56px] flex-col items-center justify-center gap-1.5 p-3 sm:p-4';
          btn.setAttribute('aria-label', 'Option ' + opt.label);
          if (rec) {
            btn.disabled = true;
            if (rec.label === opt.label) btn.classList.add(opt.correct ? 'is-correct' : 'is-wrong');
            else if (opt.correct && !rec.correct) btn.classList.add('is-reveal');
          }
          btn.innerHTML = '<span class="font-mono text-[13px] font-bold fx-ink-3">' + opt.label + '</span>' + opt.html;
          btn.addEventListener('click', function () {
            if (answers[idx]) return;
            answers[idx] = { label: opt.label, correct: opt.correct };
            render();
            if (Object.keys(answers).length >= ITEMS.length && $banner) {
              $banner.classList.remove('hidden');
              $banner.classList.add('flex');
            }
          });
          $options.appendChild(btn);
        });

        if (rec) {
          paintFeedback(rec, item);
        } else {
          $feedback.className = 'fx-feedback mt-5 p-4 text-center text-[13px] font-medium fx-ink-2 sm:text-sm';
          $feedback.textContent = 'Select an option above to check your solution.';
          $advance.classList.add('hidden');
          $advance.classList.remove('flex');
        }

        paintStepper();
      }

      for (var s = 0; s < ITEMS.length; s++) {
        (function (i) {
          var dot = document.getElementById('step-dot-' + i);
          if (dot) dot.addEventListener('click', function () { idx = i; render(); });
        })(s);
      }

      $advance.addEventListener('click', function () {
        if (idx < ITEMS.length - 1) { idx++; render(); }
        else { window.location.href = '/test'; }
      });

      render();
    })();

    /* =====================================================================
       B. FULL-BLEED DRILL REEL - tabs, arrows, drag physics
       ===================================================================== */
    (function () {
      var reel = document.getElementById('arena-reel');
      var prev = document.getElementById('arena-prev');
      var next = document.getElementById('arena-next');
      var tabs = document.querySelectorAll('[data-arena-tab]');
      if (!reel || !prev || !next) return;

      function step() {
        var card = reel.querySelector('.fx-reel-card:not([hidden])');
        if (!card) return 320;
        var gap = parseFloat(getComputedStyle(reel).columnGap) || 20;
        return card.getBoundingClientRect().width + gap;
      }

      function syncArrows() {
        var max = reel.scrollWidth - reel.clientWidth - 8;
        prev.disabled = reel.scrollLeft <= 8;
        next.disabled = reel.scrollLeft >= max;
      }

      prev.addEventListener('click', function () { reel.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { reel.scrollBy({ left: step(), behavior: 'smooth' }); });
      reel.addEventListener('scroll', syncArrows, { passive: true });
      window.addEventListener('resize', syncArrows);

      var down = false, startX = 0, startScroll = 0, moved = false;

      reel.addEventListener('mousedown', function (e) {
        if (e.target.closest('a, button')) return;
        down = true; moved = false;
        reel.classList.add('is-dragging');
        startX = e.pageX;
        startScroll = reel.scrollLeft;
      });
      window.addEventListener('mousemove', function (e) {
        if (!down) return;
        var walk = (e.pageX - startX) * 1.25;
        if (Math.abs(walk) > 5) moved = true;
        reel.scrollLeft = startScroll - walk;
      });
      window.addEventListener('mouseup', function () {
        if (!down) return;
        down = false;
        reel.classList.remove('is-dragging');
        setTimeout(function () { moved = false; }, 0);
      });
      reel.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); } });
      });

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var cat = tab.getAttribute('data-arena-tab');
          tabs.forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
          reel.querySelectorAll('.fx-reel-card').forEach(function (card) {
            var show = cat === 'all' || card.getAttribute('data-cat') === cat;
            card.hidden = !show;
            card.style.display = show ? 'flex' : 'none';
          });
          reel.scrollTo({ left: 0, behavior: 'smooth' });
          setTimeout(syncArrows, 320);
        });
      });

      syncArrows();
    })();

    /* =====================================================================
       C. SCROLL REVEAL
       ===================================================================== */
    (function () {
      var els = document.querySelectorAll('.reveal-on-scroll');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (el) { el.classList.add('revealed'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { entry.target.classList.add('revealed'); io.unobserve(entry.target); }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</Layout>