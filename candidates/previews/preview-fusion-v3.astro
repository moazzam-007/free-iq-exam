---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free IQ Test Online 2026 - Instant Results, No Email Required | FreeIQExam";
const description = "Take a free, scientifically grounded online IQ test. 24 standardized items scored with 2PL Item Response Theory. Instant score, percentile and cognitive breakdown, plus 30+ free brain games, clinical screeners and wellness tools. Zero paywall.";

const SITE = "https://freeiqexam.com";

/* ---------------------------------------------------------------------------
   DATA MODEL
   One source of truth for every tool on the page. The visible sections, the
   footer sitemap and the ItemList schema are all generated from these arrays,
   so a slug can never drift between them.
--------------------------------------------------------------------------- */

interface Tool {
  slug: string;
  title: string;
  tag: string;          // neutral mono badge text
  blurb: string;
}

interface Game extends Tool {
  glyph: string;
  metric: string;
  metricLabel: string;
  chips: string[];
  source: string;
  cat: 'memory' | 'speed' | 'reasoning';
}

const games: Game[] = [
  {
    slug: "/games/n-back", title: "Dual N-Back", tag: "Gwm · Working Memory", cat: "memory",
    blurb: "Track simultaneous auditory letter streams and spatial coordinates to expand working-memory buffer capacity.",
    glyph: "N", metric: "2-Back", metricLabel: "Current level", chips: ["Audio", "Spatial", "Adaptive"], source: "Jaeggi (2008)",
  },
  {
    slug: "/games/memory-matrix", title: "Memory Matrix", tag: "Gv · Spatial Span", cat: "memory",
    blurb: "Observe briefly illuminated tiles across escalating 3×3, 4×4 and 5×5 grids, then reconstruct the exact pattern.",
    glyph: "▦", metric: "Level 7", metricLabel: "Best span", chips: ["750 ms", "5×5", "Recall"], source: "Corsi (1972)",
  },
  {
    slug: "/games/digit-span", title: "Digit Span Loop", tag: "Gwm · Serial Recall", cat: "memory",
    blurb: "Forward and reverse serial recall of numerical sequences, extending by one digit on every success.",
    glyph: "7", metric: "9 digits", metricLabel: "Longest span", chips: ["Forward", "Reverse", "Adaptive"], source: "Wechsler Subtest",
  },
  {
    slug: "/games/stroop-clash", title: "Stroop Color Clash", tag: "Gs · Inhibition", cat: "speed",
    blurb: "Name the font colour of conflicting words and override automatic semantic interference under time pressure.",
    glyph: "S", metric: "112 ms", metricLabel: "Interference cost", chips: ["Congruent", "Conflict", "60 s"], source: "Stroop (1935)",
  },
  {
    slug: "/games/flanker-test", title: "Flanker Response", tag: "Gs · Selective Attention", cat: "speed",
    blurb: "Report the direction of a central arrow while suppressing the flanking distractor array beside it.",
    glyph: "⇢", metric: "38 ms", metricLabel: "Flanker effect", chips: ["Congruent", "Incongruent", "Neutral"], source: "Eriksen (1974)",
  },
  {
    slug: "/games/math-sprint", title: "Speed Math Sprint", tag: "Gq · Arithmetic Fluency", cat: "speed",
    blurb: "Solve mental arithmetic against a 60-second clock while holding an unbroken accuracy streak.",
    glyph: "+", metric: "46 solved", metricLabel: "Personal best", chips: ["60 s", "Streak", "4 ops"], source: "Fluency Trial",
  },
  {
    slug: "/games/symbol-match", title: "Symbol Match", tag: "Gs · Perceptual Coding", cat: "speed",
    blurb: "Translate symbols to digits against a legend as fast as possible - the classic processing-speed paradigm.",
    glyph: "⌘", metric: "92 pairs", metricLabel: "Coding rate", chips: ["Legend", "120 s", "Accuracy"], source: "Coding Subtest",
  },
  {
    slug: "/games/rotation", title: "3D Mental Rotation", tag: "Gv · Spatial Transformation", cat: "reasoning",
    blurb: "Rotate isometric cube assemblies in your head and decide whether two viewpoints describe one object.",
    glyph: "◱", metric: "140°", metricLabel: "Mean angular disparity", chips: ["Pitch", "Yaw", "Mirror"], source: "Shepard–Metzler",
  },
  {
    slug: "/games/sequence-rush", title: "Sequence Rush", tag: "Gf · Inductive Series", cat: "reasoning",
    blurb: "Deduce the generating rule behind numeric and alphabetic series before the response window closes.",
    glyph: "∿", metric: "Δ² rules", metricLabel: "Top tier reached", chips: ["Numeric", "Alpha", "Interleaved"], source: "Induction Drill",
  },
  {
    slug: "/games/syllogism", title: "Syllogism Blitz", tag: "Gc · Deductive Logic", cat: "reasoning",
    blurb: "Judge the validity of categorical premises without leaning on real-world plausibility or belief bias.",
    glyph: "∴", metric: "Darii", metricLabel: "Hardest mood cleared", chips: ["Valid", "Invalid", "15 s"], source: "Aristotelian Moods",
  },
];

const clinical: (Tool & { instrument: string; items: string })[] = [
  { slug: "/adhd-test", title: "Adult ADHD Screener", tag: "WHO ASRS v1.1", instrument: "DSM-5 Aligned", items: "18 items · 5 min", blurb: "Standardised self-report checklist reviewing inattentive and hyperactive-impulsive patterns across six Part A criteria." },
  { slug: "/depression-test", title: "Depression Screener", tag: "PHQ-9", instrument: "Clinical Scale", items: "9 items · 3 min", blurb: "The nine-item Patient Health Questionnaire with severity banding and a printable clinician-ready summary." },
  { slug: "/anxiety-test", title: "Generalised Anxiety Screener", tag: "GAD-7", instrument: "Clinical Scale", items: "7 items · 3 min", blurb: "Seven-item generalised anxiety scale with dual-domain scoring separating cognitive worry from somatic tension." },
  { slug: "/autism-test", title: "Autism Spectrum Screener", tag: "AQ-10", instrument: "Screening Tool", items: "10 items · 3 min", blurb: "Abridged Autism Spectrum Quotient with a social, attention-switching and sensory trait profile." },
  { slug: "/color-blind-test", title: "Ishihara Colour Vision Test", tag: "38-Plate Ishihara", instrument: "Sensory", items: "38 plates · 6 min", blurb: "Full plate series for red-green deficiency, with a numeral-free children's mode using traceable paths." },
  { slug: "/hearing-test", title: "Frequency Hearing Test", tag: "20 Hz – 20 kHz", instrument: "Sensory", items: "Pure-tone sweep", blurb: "Browser-synthesised pure-tone sweep with independent left and right calibration and an ear-age estimate." },
  { slug: "/eye-test", title: "Visual Acuity & Snellen Chart", tag: "Snellen / Tumbling E", instrument: "Sensory", items: "Distance calibrated", blurb: "Screen-calibrated Tumbling E acuity chart paired with an astigmatism dial and contrast sensitivity ramp." },
  { slug: "/mic-test", title: "Microphone Benchmark", tag: "Audio Hardware", instrument: "Diagnostic", items: "Live spectrum", blurb: "Live waveform, decibel meter and instant loopback playback. Audio never leaves your device." },
];

const reflex: (Tool & { metric: string; metricLabel: string })[] = [
  { slug: "/reaction-time-test", title: "Visual Reaction Time", tag: "Millisecond Latency", metric: "182", metricLabel: "ms · median of 5", blurb: "Benchmark visuomotor reflex latency using high-resolution hardware timestamps and outlier rejection." },
  { slug: "/typing-test", title: "Typing Speed & Accuracy", tag: "WPM Benchmark", metric: "94", metricLabel: "wpm · 98% accuracy", blurb: "Monkeytype-grade word and quote modes with a live consistency graph and a per-key error heatmap." },
  { slug: "/aim-trainer", title: "Precision Aim Trainer", tag: "60 FPS Tracking", metric: "0.42", metricLabel: "s · mean time to target", blurb: "Gridshot and smooth-tracking modes with eDPI conversion and per-target flick accuracy telemetry." },
  { slug: "/games/click-speed-test", title: "Click Speed Test (CPS)", tag: "Clicks Per Second", metric: "8.6", metricLabel: "cps · 10 s trial", blurb: "Raw clicks-per-second across 5, 10 and 30-second trials with jitter and butterfly technique tracking." },
];

const circadian: Tool[] = [
  { slug: "/sleep-calculator", title: "90-Minute Sleep Cycle Calculator", tag: "Circadian", blurb: "Derive wake and bedtimes from full 90-minute cycles, adjusted for your sleep-onset latency and chronotype." },
  { slug: "/brown-noise", title: "10-Band Brown Noise Generator", tag: "Focus / Sleep", blurb: "Browser-synthesised brown, pink and white noise with a ten-band equaliser, binaural layer and sleep timer." },
  { slug: "/calorie-calculator", title: "TDEE & Neuro-Metabolic Engine", tag: "Metabolic", blurb: "Mifflin-St Jeor BMR, activity-adjusted TDEE, macro split and a per-organ resting energy breakdown." },
  { slug: "/circle-of-control", title: "Stoic Circle of Control Matrix", tag: "Mindset", blurb: "Sort what is weighing on you into Control, Influence and Concern, then export a one-page clarity plan." },
  { slug: "/memento-mori", title: "Memento Mori Life Grid", tag: "Perspective", blurb: "An interactive 80-year, 4,000-week grid rendered against your own date of birth and life expectancy." },
];

const pillars: (Tool & { cta: string })[] = [
  { slug: "/matrix-reasoning-test", title: "Matrix Reasoning Guide", tag: "Core Domain", cta: "Explore the guide", blurb: "The five Carpenter transformation rules: progression, distribution of three, XOR superposition, subtraction and topological series." },
  { slug: "/iq-score-chart", title: "IQ Score Distribution", tag: "Bell Curve", cta: "View the distribution", blurb: "Gaussian parameters (mean 100, SD 15), standard-deviation bands and the classification tiers that map onto them." },
  { slug: "/iq-percentile-calculator", title: "Percentile Rank Calculator", tag: "Statistical Tool", cta: "Calculate percentile", blurb: "Two-way conversion between deviation IQ and population percentile, with rarity expressed as 1-in-N people." },
  { slug: "/methodology", title: "2PL IRT Methodology", tag: "Psychometrics", cta: "Read the whitepaper", blurb: "Our 2-parameter logistic item model, Bayesian EAP ability estimation, standard error bands and CHC construct definitions." },
];

const batteries = [
  { slug: "/fluid-reasoning-test", code: "Gf", title: "Fluid Reasoning", blurb: "Abstract matrix induction, topological series and XOR cancellation. Culture-reduced, fully non-verbal stimuli." },
  { slug: "/spatial-reasoning-test", code: "Gv", title: "Visual-Spatial", blurb: "Isometric cube rotation, surface-net folding and orthographic perspective synthesis." },
  { slug: "/quantitative-reasoning-test", code: "Gq", title: "Quantitative Logic", blurb: "Higher-order difference sequences, interleaved progressions and multi-step relational rate deductions." },
  { slug: "/verbal-reasoning-test", code: "Gc", title: "Verbal Reasoning", blurb: "Relational analogies, categorical syllogisms and taxonomic language abstraction." },
];

const faqs = [
  {
    q: "Is this IQ test really 100% free with immediate results?",
    a: "Yes. Many competing sites make you sit a 30-minute exam and then hide the result behind a subscription. FreeIQExam shows your score, percentile and domain breakdown the moment you finish, with no card details and no payment of any kind."
  },
  {
    q: "Why do you not require an email address or user account?",
    a: "Privacy is the point. We do not collect email addresses, sell user data or send marketing. Scoring runs as JavaScript inside your own browser, so there is no account to create and no personal information to disclose."
  },
  {
    q: "How does this compare to a full clinical assessment?",
    a: "Our assessment estimates reasoning ability with a 2-parameter logistic item-response model across progressively difficult items. It is an educational screening estimate, not a diagnostic instrument, and it does not replace a WAIS-IV or SB-V battery administered by a licensed psychologist."
  },
  {
    q: "How are the 24 questions structured?",
    a: "Twenty-four calibrated items are split evenly across the four core CHC domains: six Fluid Reasoning (Gf), six Visual-Spatial (Gv), six Quantitative Reasoning (Gq) and six Verbal Comprehension (Gc) items, rising in difficulty as you progress."
  },
  {
    q: "How can I check my IQ level online right now?",
    a: "Take the standardised 20-minute assessment or the 10-minute quick screening directly in your browser. Both estimate a deviation IQ on an SD-15 scale with a population percentile and a 95% confidence interval, shown instantly."
  },
  {
    q: "Can you actually increase your IQ score?",
    a: "Biological fluid intelligence is largely stable, but measured performance is not. Familiarity with matrix transformation rules, regular working-memory and processing-speed drills, good sleep, lower test anxiety and better pacing all remove unforced errors and move your observed score toward your true ceiling."
  },
  {
    q: "Are the clinical screeners a diagnosis?",
    a: "No. Instruments such as the PHQ-9, GAD-7, ASRS v1.1 and AQ-10 are validated screening questionnaires that indicate whether a conversation with a qualified clinician is worthwhile. They cannot diagnose any condition on their own, and results should be discussed with a healthcare professional."
  },
  {
    q: "What are IQ tests primarily used for today?",
    a: "In clinical and educational settings, standardised batteries such as the WAIS-IV and WISC-V help identify learning differences, assess cognitive recovery after neurological injury, identify gifted learners and profile relative strengths across working memory, perceptual reasoning and processing speed."
  },
];

/* Every indexable tool URL, derived from the arrays above. */
const allTools = [...games, ...clinical, ...reflex, ...circadian, ...pillars];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeIQExam",
    "url": `${SITE}/`,
    "description": "Free, scientifically grounded cognitive assessment platform using modern psychometrics with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": `${SITE}/`,
    "logo": `${SITE}/logo-horizontal.svg`,
    "sameAs": ["https://github.com/freeiqexam"],
    "description": "An open, privacy-first psychometric platform providing free, research-backed cognitive assessments, clinical screeners and brain-training drills with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Cognitive Assessment",
    "url": `${SITE}/`,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "description": "Standardised 24-item cognitive assessment scored with 2PL Item Response Theory. Instant IQ-scale estimate with percentile ranking and a 95% confidence interval.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": "24-question CHC-calibrated IQ test, 2PL IRT scoring, instant results, no email required, fully client-side"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "FreeIQExam Cognitive, Clinical and Wellness Tools",
    "description": "Complete directory of free cognitive games, clinical screeners, reflex benchmarks, circadian utilities and psychometric guides.",
    "numberOfItems": allTools.length,
    "itemListElement": allTools.map((t, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": t.title,
      "url": `${SITE}${t.slug}`
    }))
  }
];

const gameTabs = [
  { id: "all", label: `All Drills (${games.length})` },
  { id: "memory", label: "Working Memory" },
  { id: "speed", label: "Attention & Speed" },
  { id: "reasoning", label: "Reasoning & Space" },
];

const steps = ["1. Matrix", "2. Cube Net", "3. Series", "4. Syllogism", "5. XOR"];

const cardBase =
  "fx-card group flex flex-col justify-between rounded-3xl p-6 sm:p-7 transition-all duration-200";
const badgeBase =
  "inline-flex items-center rounded-md border px-2.5 py-1 font-mono text-[13px] font-semibold tracking-wide fx-badge";
const linkRow =
  "mt-6 flex items-center gap-2 border-t pt-4 text-[15px] font-semibold fx-hairline fx-action-text";
---

<Layout title={title} description={description} schema={schema}>
  <style is:inline>
    /* =====================================================================
       FREEIQEXAM DESIGN TOKENS - Apple canvas + Vercel hairlines +
       Raycast dark glass. One action accent. No decorative rainbows.
       HYBRID FUSION v2: Candidate 3 base + Candidate 2 radial glow.
       Typography triad: Geist display / Inter body / Geist Mono badges.
       ===================================================================== */
    :root {
      --font-display: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      --ease-fusion: cubic-bezier(0.23, 1, 0.32, 1);
      --fx-hero-glow-light: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%);
      --fx-hero-glow-dark: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%);
      --fx-canvas: #ffffff;
      --fx-parchment: #f5f5f7;
      --fx-surface: #ffffff;
      --fx-surface-2: #fafafa;
      --fx-line: #e4e4e7;
      --fx-line-soft: #f0f0f0;
      --fx-ink: #09090b;
      --fx-ink-2: #52525b;
      --fx-ink-3: #71717a;
      --fx-action: #0066cc;
      --fx-action-hover: #0071e3;
      --fx-action-ink: #ffffff;
      --fx-badge-bg: #f4f4f5;
      --fx-badge-ink: #3f3f46;
      --fx-halo: rgba(0, 102, 204, 0.10);
      --fx-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 8px 24px -12px rgba(0, 0, 0, 0.08);
      --fx-shadow-lift: 0 1px 2px rgba(0, 0, 0, 0.04), 0 18px 36px -14px rgba(0, 0, 0, 0.14);
      --fx-bevel: none;
    }

    .dark {
      --fx-canvas: #000000;
      --fx-parchment: #090a0f;
      --fx-surface: #0f1016;
      --fx-surface-2: #0b0c11;
      --fx-line: rgba(255, 255, 255, 0.08);
      --fx-line-soft: rgba(255, 255, 255, 0.05);
      --fx-ink: #ffffff;
      --fx-ink-2: #a1a1aa;
      --fx-ink-3: #71717a;
      --fx-action: #2997ff;
      --fx-action-hover: #3b82f6;
      --fx-action-ink: #000814;
      --fx-badge-bg: #18181b;
      --fx-badge-ink: #d4d4d8;
      --fx-halo: rgba(41, 151, 255, 0.14);
      --fx-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.7);
      --fx-shadow-lift: 0 20px 44px -16px rgba(0, 0, 0, 0.8);
      --fx-bevel: inset 0 1px 0 rgba(255, 255, 255, 0.10);
    }

    /* ---------- Surfaces ---------- */
    .fx-canvas { background: var(--fx-canvas); }
    .fx-parchment { background: var(--fx-parchment); }
    .fx-ink { color: var(--fx-ink); }
    .fx-ink-2 { color: var(--fx-ink-2); }
    .fx-ink-3 { color: var(--fx-ink-3); }
    .fx-hairline { border-color: var(--fx-line); }
    .fx-rule { border-top: 1px solid var(--fx-line); }

    .fx-action-text { color: var(--fx-action); }
    .fx-action-dot { background: var(--fx-action); }

    /* ---------- Cards: single-level anatomy, 1px hairline, no nesting ---------- */
    .fx-card {
      background: var(--fx-surface);
      border: 1px solid var(--fx-line);
      box-shadow: var(--fx-shadow), var(--fx-bevel);
    }
    .fx-card:hover {
      border-color: color-mix(in srgb, var(--fx-action) 45%, var(--fx-line));
      box-shadow: var(--fx-shadow-lift), var(--fx-bevel);
      transform: translateY(-2px);
    }
    .fx-card-flat { background: var(--fx-surface); border: 1px solid var(--fx-line); box-shadow: var(--fx-bevel); }

    /* ---------- Unified neutral badge (identical in every category) ---------- */
    .fx-badge {
      background: var(--fx-badge-bg);
      color: var(--fx-badge-ink);
      border-color: var(--fx-line);
    }

    /* ---------- Button grammar - Emil tactile 160ms, scale 0.97 ---------- */
    .fx-cta {
      background: var(--fx-action);
      color: var(--fx-action-ink);
      border-radius: 100px;
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease, box-shadow 200ms ease, opacity 200ms ease;
      box-shadow: 0 10px 28px -12px var(--fx-halo);
    }
    .fx-cta:hover { background: var(--fx-action-hover); transform: scale(1.01); }
    .fx-cta:active { transform: scale(0.97); }

    .fx-ghost {
      background: var(--fx-surface-2);
      color: var(--fx-ink);
      border: 1px solid var(--fx-line);
      border-radius: 100px;
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), border-color 160ms ease, opacity 200ms ease;
    }
    .fx-ghost:hover { border-color: color-mix(in srgb, var(--fx-action) 55%, var(--fx-line)); transform: scale(1.01); }
    .fx-ghost:active { transform: scale(0.97); }

    /* ---------- Card hover: 1px brightening + ambient halo reveal ---------- */
    .fx-card-halo { opacity: 0; transition: opacity 200ms ease; }
    .fx-card:hover .fx-card-halo { opacity: 1; }

    /* ---------- Entering states: never from scale(0) ---------- */
    .fx-enter { transform: scale(0.95); opacity: 0; filter: blur(2px); }
    .fx-enter.is-in { transform: scale(1); opacity: 1; filter: blur(0); transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms ease, filter 200ms ease; }

    /* ---------- Hero fusion glow (Candidate 2 luxury depth) ----------
       Taller box + bottom fade mask so the wash dissolves before its edge.
       Without the mask the 18rem box ended mid-hero as a visible band. */
    .fx-hero-glow {
      position: absolute; inset-inline: 0; top: 0; height: 34rem;
      pointer-events: none;
      background: var(--fx-hero-glow-light);
      mask-image: linear-gradient(to bottom, black 55%, transparent 92%);
      -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%);
    }
    .dark .fx-hero-glow { background: var(--fx-hero-glow-dark); }

    /* ---------- Typography triad enforcement (scoped) ---------- */
    .fx-display { font-family: var(--font-display); }
    .fx-body { font-family: var(--font-body); font-size: 17px; line-height: 1.6; }
    .fx-mono { font-family: var(--font-mono); }

    .fx-focus:focus-visible { outline: 2px solid var(--fx-action); outline-offset: 2px; }

    /* ---------- Segmented tabs ---------- */
    .fx-tabs { background: var(--fx-surface-2); border: 1px solid var(--fx-line); border-radius: 100px; }
    .fx-tab { color: var(--fx-ink-2); border-radius: 100px; transition: color .2s ease, background-color .2s ease; }
    .fx-tab:hover { color: var(--fx-ink); }
    .fx-tab[aria-selected="true"] { background: var(--fx-action); color: var(--fx-action-ink); }

    /* ---------- Full-bleed reel ---------- */
    .fx-reel-bleed { width: 100%; overflow: hidden; }
    .fx-reel {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      padding: 10px max(1rem, calc((100vw - 80rem) / 2 + 1.5rem)) 36px;
      mask-image: linear-gradient(to right, transparent 0, #000 28px, #000 calc(100% - 64px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 28px, #000 calc(100% - 64px), transparent 100%);
    }
    @media (min-width: 768px) {
      .fx-reel {
        gap: 28px;
        mask-image: linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 180px), transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 72px, #000 calc(100% - 180px), transparent 100%);
      }
    }
    .fx-reel::-webkit-scrollbar { display: none; }
    .fx-reel.is-dragging { cursor: grabbing; scroll-behavior: auto; scroll-snap-type: none; user-select: none; }

    .fx-reel-card {
      flex: 0 0 286px;
      width: 286px;
      scroll-snap-align: start;
    }
    @media (min-width: 768px) { .fx-reel-card { flex-basis: 344px; width: 344px; } }

    .fx-nav-btn {
      width: 44px; height: 44px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 9999px;
      background: var(--fx-surface-2);
      border: 1px solid var(--fx-line);
      color: var(--fx-ink);
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), border-color 160ms ease, opacity 200ms ease;
      box-shadow: var(--fx-bevel);
    }
    .fx-nav-btn:hover:not(:disabled) { border-color: color-mix(in srgb, var(--fx-action) 55%, var(--fx-line)); }
    .fx-nav-btn:active:not(:disabled) { transform: scale(0.97); }
    .fx-nav-btn:disabled { opacity: .35; cursor: default; }

    /* ---------- Linear-style hardware-accelerated hero entrance (v3 fusion) ----------
       Rare/first-time load animation only. GPU properties: transform + opacity + filter.
       Marketing-tier duration (1050ms) is intentional for hero storytelling;
       all UI controls stay under 250ms per Emil 250ms rule. */
    @keyframes linearHeroEntrance {
      0% { opacity: 0; filter: blur(14px); transform: translateY(18px) scale(0.98); }
      100% { opacity: 1; filter: blur(0px); transform: translateY(0px) scale(1); }
    }
    .linear-fade-in {
      opacity: 0;
      animation: linearHeroEntrance 1050ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }
    .linear-delay-100 { animation-delay: 80ms; }
    .linear-delay-200 { animation-delay: 220ms; }
    .linear-delay-300 { animation-delay: 380ms; }
    .linear-delay-400 { animation-delay: 540ms; }
    .linear-delay-500 { animation-delay: 700ms; }
    .linear-delay-600 { animation-delay: 860ms; }

    /* ---------- HUD visual inside cards (no nested hard border) ---------- */
    .fx-hud {
      position: relative;
      border-radius: 18px;
      background: var(--fx-surface-2);
      overflow: hidden;
      isolation: isolate;
    }
    .fx-hud::before {
      content: "";
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(90% 90% at 50% 0%, var(--fx-halo), transparent 70%);
    }
    .fx-hud > * { position: relative; z-index: 1; }
    .fx-hud-glyph {
      font-variant-numeric: tabular-nums;
      color: var(--fx-action);
    }

    /* ---------- Sample puzzle stage ---------- */
    .fx-stage { background: var(--fx-surface-2); border: 1px solid var(--fx-line); border-radius: 22px; box-shadow: var(--fx-bevel); }
    .fx-cell { background: transparent; }
    .fx-slot { border: 1.5px dashed var(--fx-action); border-radius: 14px; color: var(--fx-action); }
    .fx-chip { background: var(--fx-badge-bg); color: var(--fx-ink); border-radius: 10px; }
    .fx-premise { background: var(--fx-surface-2); border: 1px solid var(--fx-line); border-radius: 14px; }
    .fx-glyph { stroke: var(--fx-action); }
    .fx-fill { fill: var(--fx-action); }

    .fx-opt {
      background: var(--fx-surface);
      border: 1px solid var(--fx-line);
      border-radius: 16px;
      transition: transform .18s cubic-bezier(.16,1,.3,1), border-color .18s ease, box-shadow .18s ease;
      box-shadow: var(--fx-bevel);
    }
    .fx-opt:hover { border-color: var(--fx-action); transform: translateY(-2px); }
    .fx-opt.is-correct { border-color: #10b981; box-shadow: 0 0 0 1px #10b981; transform: none; }
    .fx-opt.is-wrong { border-color: #f43f5e; box-shadow: 0 0 0 1px #f43f5e; transform: none; }
    .fx-opt.is-reveal { border-color: rgba(16, 185, 129, .65); border-style: dashed; }
    .fx-feedback { background: var(--fx-surface-2); border: 1px solid var(--fx-line); border-radius: 16px; }
    .fx-feedback.is-correct { border-color: rgba(16, 185, 129, .5); }
    .fx-feedback.is-wrong { border-color: rgba(244, 63, 94, .5); }

    /* ---------- Stepper pills ---------- */
    .fx-step { background: var(--fx-surface-2); color: var(--fx-ink-2); border: 1px solid var(--fx-line); border-radius: 14px; transition: all .2s ease; }
    .fx-step:hover { color: var(--fx-ink); }
    .fx-step.is-active { background: var(--fx-action); color: var(--fx-action-ink); border-color: transparent; }
    .fx-step.is-done { color: var(--fx-ink); border-color: color-mix(in srgb, var(--fx-action) 45%, var(--fx-line)); }

    /* ---------- FAQ ---------- */
    .fx-faq { background: var(--fx-surface); border: 1px solid var(--fx-line); border-radius: 20px; box-shadow: var(--fx-bevel); }
    .fx-faq[open] { background: var(--fx-surface-2); }
    .fx-faq summary::-webkit-details-marker { display: none; }

    /* ---------- Scroll reveal ---------- */
    .reveal-on-scroll { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
    .reveal-on-scroll.revealed { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      .reveal-on-scroll { opacity: 1 !important; transform: none !important; transition: none !important; }
      .fx-card:hover, .fx-opt:hover, .fx-cta:hover, .fx-ghost:hover, .fx-nav-btn:hover { transform: none !important; }
      .fx-reel { scroll-behavior: auto; }
      .fx-pulse { animation: none !important; }
      .fx-enter { transform: none !important; opacity: 1 !important; filter: none !important; transition-duration: 0.01ms !important; }
      .fx-hero-glow { display: none !important; }
      .linear-fade-in { opacity: 1 !important; animation: none !important; filter: none !important; transform: none !important; will-change: auto !important; }
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
    }

    .fx-pulse { animation: fxPulse 2.4s ease-in-out infinite; }
    @keyframes fxPulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  </style>

