---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free IQ Test Online 2026 - Instant Results, No Email Required | FreeIQExam";
const description = "Take a free, scientifically grounded online IQ test. 24 standardized questions evaluated via 2PL Item Response Theory. Instant score, percentile & cognitive breakdown with zero paywall.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/",
    "description": "Free scientifically grounded cognitive assessment platform utilizing modern psychometrics with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "An open, privacy-first psychometric platform providing free, research-backed cognitive assessments and brain training drills with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Cognitive Assessment",
    "url": "https://freeiqexam.com/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Standardized 24-item non-verbal cognitive assessment using 2PL Item Response Theory. Instant IQ-scale score estimate with percentile ranking.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": "24-question non-verbal IQ test, 2PL IRT scoring, instant results, no email required"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this IQ test really 100% free with immediate results?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Many competitor sites require 30 minutes on an exam only to hit you with a subscription paywall. FreeIQExam.com gives you your score, percentile, and performance breakdown immediately without a credit card or payment of any kind."
        }
      },
      {
        "@type": "Question",
        "name": "Why do you not require an email address or user account?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We prioritize privacy. We do not harvest email addresses, sell user data, or send spam. Calculations run directly in your browser, so you never need to create accounts or disclose personal information."
        }
      },
      {
        "@type": "Question",
        "name": "How does this test compare to a comprehensive clinical exam?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our test evaluates non-verbal fluid reasoning using 3-Parameter Logistic Item Response Theory on progressive items. It provides an educational screening estimate of reasoning ability, but is not a clinical diagnostic instrument like a full WAIS-IV or SB-V examination administered by a licensed psychologist."
        }
      },
      {
        "@type": "Question",
        "name": "How are the 24 questions structured?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The assessment consists of 24 psychometrically calibrated items evenly distributed across the 4 core CHC cognitive domains: 6 Fluid Reasoning (Gf), 6 Visual-Spatial Processing (Gv), 6 Quantitative Reasoning (Gq), and 6 Verbal Comprehension (Gc) items, scaling progressively in difficulty."
        }
      },
      {
        "@type": "Question",
        "name": "How can I actually check my IQ level online?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can take our standardized 20-minute cognitive assessment or 10-minute quick screening directly in your browser. Both tests assess non-verbal fluid reasoning and pattern induction, computing an estimated deviation IQ score and population percentile with instant results and no paywalls."
        }
      },
      {
        "@type": "Question",
        "name": "Can you increase your IQ score?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "While fundamental biological fluid intelligence is largely genetically stable, your operational performance on IQ tests can improve significantly. Familiarity with matrix transformation rules, cognitive drills (like N-back and mental rotation), high sleep quality, stress management, and test pacing help eliminate unforced errors and unlock your highest natural score."
        }
      },
      {
        "@type": "Question",
        "name": "What are IQ tests primarily used for today?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In clinical and educational settings, standardized IQ batteries (such as the WAIS-IV and WISC-V) are used to diagnose learning differences, assess cognitive recovery following neurological injury, identify gifted learners, and analyze specific cognitive strengths and weaknesses across working memory, perceptual reasoning, and processing speed."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- Linear-Style Hardware-Accelerated Hero Entrance Blur Animation & Raycast Card System -->
  <style is:inline>
    @keyframes linearHeroEntrance {
      0% {
        opacity: 0;
        filter: blur(14px);
        transform: translateY(18px) scale(0.98);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translateY(0px) scale(1.0);
      }
    }
    .linear-fade-in {
      opacity: 0;
      animation: linearHeroEntrance 1050ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: transform, opacity, filter;
    }
    .linear-delay-100 { animation-delay: 80ms; }
    .linear-delay-200 { animation-delay: 220ms; }
    .linear-delay-300 { animation-delay: 380ms; }
    .linear-delay-400 { animation-delay: 540ms; }
    .linear-delay-500 { animation-delay: 700ms; }

    /* ==========================================================================
       RAYCAST-INSPIRED ULTRA-PREMIUM CARD DESIGN SYSTEM & RADIAL GLOW
       ========================================================================== */
    .raycast-card {
      position: relative;
      border-radius: 1.5rem;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                  box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                  border-color 0.35s ease,
                  background 0.35s ease;
      overflow: hidden;
      background: #ffffff;
      border: 1px solid rgba(228, 228, 231, 0.9);
      box-shadow: 
        0 1px 2px 0 rgba(0, 0, 0, 0.03),
        0 8px 24px -4px rgba(0, 0, 0, 0.05),
        0 0 0 1px rgba(255, 255, 255, 0.8) inset;
    }

    .raycast-card:hover {
      transform: translateY(-4px) scale(1.008);
      border-color: rgba(161, 161, 170, 0.6);
      box-shadow: 
        0 1px 0px 0px rgba(255, 255, 255, 1) inset,
        0 18px 36px -6px rgba(0, 0, 0, 0.1),
        0 0 28px 2px rgba(59, 130, 246, 0.12);
    }

    /* Dark Mode: Signature Raycast Deep Radial Gradients + 1px Top Glass Bevel Highlight */
    .dark .raycast-card {
      background: radial-gradient(110% 120% at 50% 15%, rgba(26, 32, 54, 0.7) 0%, rgba(9, 11, 20, 0.9) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.12) inset,
        0px 10px 30px -4px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.04) inset;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .dark .raycast-card:hover {
      border-color: rgba(255, 255, 255, 0.22);
      transform: translateY(-4px) scale(1.008);
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.28) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 32px 3px rgba(59, 130, 246, 0.22),
        0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    }

    /* Raycast Domain-Specific Dark Gradients & Ambient Flares */
    .dark .raycast-glow-mint {
      background: radial-gradient(120% 110% at 50% 10%, rgba(16, 68, 54, 0.65) 0%, rgba(6, 20, 16, 0.9) 100%);
    }
    .dark .raycast-glow-mint:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(45, 212, 191, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    .dark .raycast-glow-cyan {
      background: radial-gradient(120% 110% at 50% 10%, rgba(14, 55, 88, 0.65) 0%, rgba(5, 16, 28, 0.9) 100%);
    }
    .dark .raycast-glow-cyan:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(56, 189, 248, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    .dark .raycast-glow-yellow {
      background: radial-gradient(120% 110% at 50% 10%, rgba(85, 65, 12, 0.6) 0%, rgba(24, 18, 4, 0.9) 100%);
    }
    .dark .raycast-glow-yellow:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(250, 204, 21, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    .dark .raycast-glow-coral {
      background: radial-gradient(120% 110% at 50% 10%, rgba(88, 25, 42, 0.6) 0%, rgba(26, 6, 12, 0.9) 100%);
    }
    .dark .raycast-glow-coral:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(244, 63, 94, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    .dark .raycast-glow-purple {
      background: radial-gradient(120% 110% at 50% 10%, rgba(58, 28, 92, 0.6) 0%, rgba(18, 8, 30, 0.9) 100%);
    }
    .dark .raycast-glow-purple:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(168, 85, 247, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    .dark .raycast-glow-blue {
      background: radial-gradient(120% 110% at 50% 10%, rgba(24, 45, 105, 0.65) 0%, rgba(7, 13, 34, 0.9) 100%);
    }
    .dark .raycast-glow-blue:hover {
      box-shadow: 
        0px 1px 0px 0px rgba(255, 255, 255, 0.3) inset,
        0px 22px 48px -6px rgba(0, 0, 0, 0.75),
        0px 0px 36px 4px rgba(59, 130, 246, 0.25),
        0 0 0 1px rgba(255, 255, 255, 0.12) inset;
    }

    /* ==========================================================================
       RAYCAST ULTRA-PREMIUM SLEEK MONOCHROME 3D SLIDING REEL - FULL BLEED
       Per prompt: track bleeds 100vw edge-to-edge, NOT trapped in max-w-7xl.
       First card aligns to header via padding-left: max(1rem, calc(...)).
       ========================================================================== */
    .raycast-section {
      background-color: #060709 !important;
      color: #ffffff !important;
    }

    .raycast-reel-bleed {
      width: 100%;
      overflow: hidden;
    }

    .raycast-reel-viewport {
      display: flex;
      gap: 24px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding: 24px;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      /* Negative vertical margin so hover glows are never clipped (real Raycast) */
      margin: -16px 0;
      padding-top: 32px;
      padding-bottom: 48px;
      padding-left: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
      padding-right: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
      /* Asymmetric edge fade: narrow left, wide right (real: black 64px → calc(100% - 224px)) */
      mask-image: linear-gradient(to right, transparent 0%, black 64px, black calc(100% - 224px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 64px, black calc(100% - 224px), transparent 100%);
    }

    @media (min-width: 720px) {
      .raycast-reel-viewport {
        gap: 56px;
        margin: -40px 0;
        padding-top: 56px;
        padding-bottom: 72px;
      }
    }

    /* Phones: gentler edge fade so the first card is never eaten by the mask */
    @media (max-width: 719px) {
      .raycast-reel-viewport {
        mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 88px), transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 88px), transparent 100%);
      }
    }

    .raycast-reel-viewport::-webkit-scrollbar {
      display: none;
    }

    .raycast-reel-viewport.is-dragging {
      cursor: grabbing !important;
      scroll-behavior: auto !important;
      scroll-snap-type: none !important;
      user-select: none !important;
    }

    /* Real Raycast card: 300px mobile → 360px desktop, radius 20px, snap END,
       grid rows (content / docked visual), NO border prop (inset ring instead),
       staggered slideIn entrance via --delay. */
    @keyframes raycastSlideIn {
      0% { opacity: 0; transform: translateY(50px) translate(10px) scale(0.98); }
      100% { opacity: 1; transform: translate(0) scale(1); }
    }

    .raycast-reel-card {
      flex: 0 0 300px;
      width: 300px;
      min-height: 490px;
      scroll-snap-align: end;
      border-radius: 20px;
      position: relative;
      background: #0f1016 !important;
      box-shadow: 0px 1px 0px 0px rgba(255, 255, 255, 0.10) inset, 0 18px 40px -10px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.06) inset !important;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
      overflow: hidden;
      opacity: 0;
      transform-origin: 100% 0;
      animation: raycastSlideIn 0.7s var(--delay, 100ms) cubic-bezier(0.215, 0.61, 0.355, 1) forwards;
    }

    @media (min-width: 720px) {
      .raycast-reel-card {
        flex-basis: 360px;
        width: 360px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .raycast-reel-card { opacity: 1; animation: none; }
    }

    /* Soft-light vignette that fades in on hover (real Raycast :after overlay) */
    .raycast-reel-card::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      border-radius: 20px;
      mix-blend-mode: soft-light;
      opacity: 0;
      background: radial-gradient(50% 50%, rgba(0,0,0,0) 0%, rgba(0,0,0,0.25) 80%);
      transition: opacity 0.3s ease;
    }
    .raycast-reel-card:hover::after { opacity: 1; }

    .raycast-reel-card:hover {
      transform: translateY(-6px);
      z-index: 10;
    }
    /* Chevron tile lights up on card hover (real: action ring highlight) */
    .raycast-reel-card:hover .raycast-chevron {
      box-shadow: inset 0 1px rgba(255,255,255,0.05), 0 0 0 1px rgba(255,255,255,0.5), inset 0 -1px rgba(0,0,0,0.2);
    }

    @media (max-width: 640px) {
      .raycast-reel-card {
        flex: 0 0 300px;
        width: 300px;
        min-height: 460px;
      }
    }

    /* Real Raycast pill: 3-sided border (no bottom), radius 31px, padding 8/20,
       Card-BG gradient + inset top highlight. Category 46px tall, 14px/500. */
    .raycast-tabs {
      position: relative;
      gap: 24px;
      padding: 8px 20px;
      /* Fixed compact height: the pill can never balloon into a giant oval,
         even if JS measures early or styles settle late. */
      height: 62px;
      max-width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      background: linear-gradient(137deg, #111214 4.87%, #0c0d0f 75.88%);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
      border-left: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 31px;
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.1);
    }
    .raycast-tabs::-webkit-scrollbar { display: none; }

    .raycast-tab-btn {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      flex-shrink: 0;
      height: 46px;
      padding: 0 4px;
      font-size: 14px;
      font-weight: 500;
      line-height: 160%;
      letter-spacing: 0.2px;
      color: #6a6b6c;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: color 0.3s ease;
      white-space: nowrap;
    }

    .raycast-tab-btn:hover { color: #ffffff; }
    .raycast-tab-btn.active { color: #ffffff !important; font-weight: 500; }

    /* Sliding active pill: radial metallic gradient, slides via --width/--offset.
       Hidden until first successful sync so a stale measurement can never flash. */
    .raycast-active-backdrop {
      position: absolute;
      top: 8px;
      left: 0;
      height: 46px;
      width: var(--width, 107px);
      max-width: calc(100% - 40px);
      transform: translate3d(var(--offset, 0px), 0, 0);
      background: radial-gradient(51.07% 92.4% at 51% 7.61%, #5a5a5a 0%, #1a1a1a 100%);
      border-radius: 36px;
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      transition: transform 0.3s ease, width 0.3s ease, opacity 0.25s ease;
      pointer-events: none;
      opacity: 0;
    }
    .raycast-tabs.is-synced .raycast-active-backdrop { opacity: 1; }
    .raycast-active-backdrop::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: 36px;
      padding: 1px;
      opacity: 0.2;
      background: linear-gradient(#fff, rgba(255,255,255,0));
      -webkit-mask-image: linear-gradient(#fff 0 0), linear-gradient(#fff 0 0);
      mask-image: linear-gradient(#fff 0 0), linear-gradient(#fff 0 0);
      -webkit-mask-clip: content-box, border-box;
      mask-clip: content-box, border-box;
      -webkit-mask-origin: content-box, border-box;
      mask-origin: content-box, border-box;
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* Seamless integrated inner visuals - ZERO harsh double-borders per prompt.
       Ambient halo lives behind graphics via ::before radial glow. */
    .raycast-visual {
      position: relative;
      background-color: #08090d !important;
      border: none !important;
      overflow: hidden;
      isolation: isolate;
    }
    .raycast-visual::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .raycast-visual > * {
      position: relative;
      z-index: 1;
    }
    .raycast-ambient-sapphire .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(14, 55, 88, 0.55), transparent 70%); }
    .raycast-ambient-amber .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(85, 65, 12, 0.5), transparent 70%); }
    .raycast-ambient-emerald .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(16, 68, 54, 0.55), transparent 70%); }
    .raycast-ambient-violet .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(58, 28, 92, 0.55), transparent 70%); }
    .raycast-ambient-rose .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(88, 25, 42, 0.55), transparent 70%); }
    .raycast-ambient-cyanslate .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(20, 50, 80, 0.55), transparent 70%); }
    .raycast-ambient-grape .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(45, 25, 75, 0.55), transparent 70%); }
    .raycast-ambient-steel .raycast-visual::before { background: radial-gradient(90% 90% at 50% 15%, rgba(24, 45, 105, 0.55), transparent 70%); }

    /* ============ SAMPLE PUZZLE - borderless seamless tiles ============
       Plain CSS (zero Tailwind dependency) so JS-injected markup always
       renders correctly. No outer boxes, no hard borders - tiles float
       on a soft glow, Raycast style. */
    .sample-stage {
      background:
        radial-gradient(120% 100% at 50% 0%, rgba(59, 130, 246, 0.10), rgba(59, 130, 246, 0) 60%),
        #ffffff;
      border: none !important;
      box-shadow: none !important;
    }
    .dark .sample-stage {
      background:
        radial-gradient(120% 100% at 50% 0%, rgba(59, 130, 246, 0.14), rgba(59, 130, 246, 0) 60%),
        #0c0e13;
    }
    /* Matrix cells are fully transparent layout boxes - shapes float directly
       on the card, no tile background/border/outline at all. */
    .sample-cell { background: transparent !important; border: none !important; box-shadow: none !important; }
    .dark .sample-cell { background: transparent !important; }
    .sample-premise { background: #f4f4f5; border: none !important; }
    .dark .sample-premise { background: rgba(255, 255, 255, 0.055); }
    .sample-opt {
      background: rgba(9, 9, 11, 0.035);
      border: none !important;
      box-shadow: inset 0 0 0 1px rgba(9, 9, 11, 0.07);
      transition: box-shadow 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }
    .dark .sample-opt {
      background: rgba(255, 255, 255, 0.045);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .sample-opt:hover {
      background: rgba(59, 130, 246, 0.09);
      box-shadow: inset 0 0 0 1.5px rgba(59, 130, 246, 0.65), 0 0 28px -6px rgba(59, 130, 246, 0.45);
      transform: translateY(-1px);
    }
    .sample-opt.is-correct {
      background: rgba(16, 185, 129, 0.13);
      box-shadow: inset 0 0 0 2px #10b981, 0 0 28px -8px rgba(16, 185, 129, 0.6);
      transform: none;
    }
    .sample-opt.is-wrong {
      background: rgba(244, 63, 94, 0.11);
      box-shadow: inset 0 0 0 2px #f43f5e, 0 0 28px -8px rgba(244, 63, 94, 0.5);
      transform: none;
    }
    .sample-opt.is-reveal {
      background: rgba(16, 185, 129, 0.07);
      box-shadow: inset 0 0 0 1.5px rgba(16, 185, 129, 0.55);
    }
    .sample-feedback { background: rgba(9, 9, 11, 0.035); border: none !important; }
    .dark .sample-feedback { background: rgba(255, 255, 255, 0.045); }

    /* Real Raycast chevron tile: 36px gradient tile with inset ring shadows */
    .raycast-chevron {
      background: linear-gradient(rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.1) 100%);
      box-shadow: inset 0 1px rgba(255,255,255,0.05), 0 0 0 1px rgba(255,255,255,0.25), inset 0 -1px rgba(0,0,0,0.2);
    }

    /* Real Raycast arrows: Card-BG gradient, 3-sided border, radius 86px,
       padding 20px, 16px icons, hover glow. */
    .raycast-nav-btn {
      gap: 12px;
      padding: 20px;
      border-radius: 86px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      background: linear-gradient(137deg, #111214 4.87%, #0c0d0f 75.88%);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
