          { label: 'B', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/></svg></div>', isCorrect: false },
          { label: 'C', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/><line x1="8" y1="8" x2="32" y2="32"/></svg></div>', isCorrect: false },
          { label: 'D', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/><line x1="6" y1="20" x2="34" y2="20"/></svg></div>', isCorrect: false }
        ],
        rule: 'Exclusive OR (XOR) Superposition: Identical segments appearing in BOTH columns cancel out, while unique segments remain. In Row 3, the forward slash / cancels out, leaving only the backslash \\.',
        hint: 'Notice that identical lines present in both Column 1 and Column 2 disappear in Column 3.'
      }
    ];

    var currentSampleIdx = 0;
    var userResponses = {}; // index -> { optionLabel, isCorrect }

    // Elements
    var domainBadge = document.getElementById('sample-domain-badge');
    var subtypeText = document.getElementById('sample-subtype-text');
    var counterText = document.getElementById('sample-counter-text');
    var promptText = document.getElementById('sample-prompt-text');
    var stimulusBox = document.getElementById('sample-stimulus-box');
    var optionsContainer = document.getElementById('sample-options-container');
    var feedbackBox = document.getElementById('demo-feedback');
    var btnAdvance = document.getElementById('btn-sample-advance');
    var btnAdvanceText = document.getElementById('btn-sample-advance-text');
    var btnPrev = document.getElementById('btn-sample-prev');
    var btnNext = document.getElementById('btn-sample-next');
    var completionBanner = document.getElementById('sample-completion-banner');

    function updateStepperUI() {
      for (var i = 0; i < SAMPLE_ITEMS.length; i++) {
        var dot = document.getElementById('step-dot-' + i);
        if (!dot) continue;
        if (i === currentSampleIdx) {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-sans font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        } else if (userResponses[i]) {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-sans font-semibold transition-all bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 hover:bg-emerald-100 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        } else {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-sans font-medium transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        }
      }

      if (btnPrev) btnPrev.disabled = currentSampleIdx === 0;
      if (btnNext) btnNext.disabled = currentSampleIdx === SAMPLE_ITEMS.length - 1;
    }

    function renderActiveQuestion() {
      var item = SAMPLE_ITEMS[currentSampleIdx];
      if (!item) return;

      if (domainBadge) domainBadge.textContent = item.domainBadge;
      if (subtypeText) subtypeText.textContent = item.subtypeText;
      if (counterText) counterText.textContent = 'Item ' + (currentSampleIdx + 1) + ' of ' + SAMPLE_ITEMS.length;
      if (promptText) promptText.textContent = item.promptText;

      if (stimulusBox) {
        stimulusBox.innerHTML = item.renderStimulus();
      }

      if (optionsContainer) {
        optionsContainer.innerHTML = '';
        var answered = userResponses[currentSampleIdx];

        item.options.forEach(function(opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-option', opt.label);
          btn.setAttribute('data-correct', String(opt.isCorrect));
          btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl sample-opt flex flex-col items-center justify-center gap-1.5 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer';

          // Apply state if already answered
          if (answered) {
            if (answered.optionLabel === opt.label) {
              if (opt.isCorrect) {
                btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl sample-opt is-correct flex flex-col items-center justify-center gap-1.5 transition-all';
              } else {
                btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl sample-opt is-wrong flex flex-col items-center justify-center gap-1.5 transition-all';
              }
            } else if (opt.isCorrect && !answered.isCorrect) {
              btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl sample-opt is-reveal flex flex-col items-center justify-center gap-1.5 transition-all';
            }
          }

          var labelSpan = '<span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">' + opt.label + '</span>';
          btn.innerHTML = labelSpan + opt.content;

          btn.addEventListener('click', function() {
            handleOptionSelect(opt.label, opt.isCorrect, item);
          });

          optionsContainer.appendChild(btn);
        });
      }

      // Restore feedback box state
      if (feedbackBox) {
        var answeredState = userResponses[currentSampleIdx];
        if (answeredState) {
          renderFeedback(answeredState.optionLabel, answeredState.isCorrect, item);
        } else {
          feedbackBox.textContent = 'Select an option above to verify your solution.';
          feedbackBox.className = 'mt-5 p-4 rounded-2xl sample-feedback text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all';
          if (btnAdvance) btnAdvance.classList.add('hidden');
        }
      }

      updateStepperUI();
    }

    function renderFeedback(label, isCorrect, item) {
      if (!feedbackBox) return;
      feedbackBox.classList.remove('animate-fade-in');
      void feedbackBox.offsetWidth;

      if (isCorrect) {
        feedbackBox.innerHTML = '<div class="text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400 mb-1">Correct! Option ' + label + ' is the exact solution.</div>' +
          '<div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">' + item.rule + '</div>';
        feedbackBox.className = 'mt-5 p-4 sm:p-5 rounded-2xl bg-emerald-50/60 dark:bg-emerald-950/30 border border-emerald-300 dark:border-emerald-800 text-center animate-fade-in transition-all';
      } else {
        feedbackBox.innerHTML = '<div class="text-sm sm:text-base font-bold text-rose-600 dark:text-rose-400 mb-1">Option ' + label + ' is not correct.</div>' +
          '<div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">' + item.hint + '</div>' +
          '<div class="mt-2 text-xs text-zinc-500 dark:text-zinc-400 font-mono">' + item.rule + '</div>';
        feedbackBox.className = 'mt-5 p-4 sm:p-5 rounded-2xl bg-rose-50/60 dark:bg-rose-950/30 border border-rose-300 dark:border-rose-800 text-center animate-fade-in transition-all';
      }

      // Show advance action button
      if (btnAdvance) {
        btnAdvance.classList.remove('hidden');
        btnAdvance.classList.add('flex');
        if (btnAdvanceText) {
          if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
            btnAdvanceText.textContent = 'Next Sample Question (' + (currentSampleIdx + 2) + '/5)';
          } else {
            btnAdvanceText.textContent = 'Explore Completed - Take Full Test';
          }
        }
      }
    }

    function handleOptionSelect(label, isCorrect, item) {
      userResponses[currentSampleIdx] = { optionLabel: label, isCorrect: isCorrect };
      renderActiveQuestion();

      // Check if all 5 answered
      var answeredCount = Object.keys(userResponses).length;
      if (answeredCount >= SAMPLE_ITEMS.length && completionBanner) {
        completionBanner.classList.remove('hidden');
        completionBanner.classList.add('flex');
      }
    }

    // Step button event listeners
    for (var s = 0; s < SAMPLE_ITEMS.length; s++) {
      (function(idx) {
        var dot = document.getElementById('step-dot-' + idx);
        if (dot) {
          dot.addEventListener('click', function() {
            currentSampleIdx = idx;
            renderActiveQuestion();
          });
        }
      })(s);
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        if (currentSampleIdx > 0) {
          currentSampleIdx--;
          renderActiveQuestion();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
          currentSampleIdx++;
          renderActiveQuestion();
        }
      });
    }

    if (btnAdvance) {
      btnAdvance.addEventListener('click', function() {
        if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
          currentSampleIdx++;
          renderActiveQuestion();
        } else {
          window.location.href = '/test';
        }
      });
    }

    // Initial render
    renderActiveQuestion();
  })();

  // ============================================================================
  // RAYCAST-STYLE HORIZONTAL SLIDING CARD REEL CONTROLLER
  // ============================================================================
  (function initRaycastReel() {
    var viewport = document.getElementById('raycast-reel-viewport');
    var prevBtn = document.getElementById('raycast-prev-btn');
    var nextBtn = document.getElementById('raycast-next-btn');
    var tabBtns = document.querySelectorAll('.raycast-tab-btn');
    var backdrop = document.getElementById('raycast-tab-backdrop');

    if (!viewport || !prevBtn || !nextBtn) return;

    var isDown = false;
    var startX = 0;
    var scrollLeft = 0;
    var hasMoved = false;

    function getCardShiftStep() {
      var card = viewport.querySelector('.raycast-reel-card');
      if (!card) return 416;
      var cardWidth = card.getBoundingClientRect().width;
      var gap = parseFloat(window.getComputedStyle(viewport).columnGap) || 24;
      return cardWidth + gap;
    }

    function updateNavButtons() {
      var maxScroll = viewport.scrollWidth - viewport.clientWidth - 10;
      if (viewport.scrollLeft <= 10) {
        prevBtn.setAttribute('disabled', 'true');
      } else {
        prevBtn.removeAttribute('disabled');
      }

      if (viewport.scrollLeft >= maxScroll) {
        nextBtn.setAttribute('disabled', 'true');
      } else {
        nextBtn.removeAttribute('disabled');
      }
    }

    // Programmatic Button Clicks
    prevBtn.addEventListener('click', function() {
      var step = getCardShiftStep();
      viewport.scrollBy({ left: -step, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', function() {
      var step = getCardShiftStep();
      viewport.scrollBy({ left: step, behavior: 'smooth' });
    });

    // Native scroll event listener to update buttons in real time
    viewport.addEventListener('scroll', updateNavButtons, { passive: true });

    // Mouse Drag-to-Scroll (Physics Grabbing)
    viewport.addEventListener('mousedown', function(e) {
      if (e.target.closest('button')) return;
      isDown = true;
      hasMoved = false;
      viewport.classList.add('is-dragging');
      startX = e.pageX - viewport.offsetLeft;
      scrollLeft = viewport.scrollLeft;
    });

    window.addEventListener('mouseup', function() {
      if (!isDown) return;
      isDown = false;
      viewport.classList.remove('is-dragging');
    });

    window.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      var x = e.pageX - viewport.offsetLeft;
      var walk = (x - startX) * 1.35;
      if (Math.abs(walk) > 4) {
        hasMoved = true;
      }
      viewport.scrollLeft = scrollLeft - walk;
    });

    // Prevent accidental navigation when dragging cards
    viewport.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function(e) {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });

    /* Sliding metallic pill - real Raycast: measures active tab, drives --width/--offset.
       Layout-based (offsetLeft/offsetWidth) so scroll, zoom and transforms can't corrupt it. */
    function positionBackdrop(btn) {
      if (!backdrop || !btn) return;
      var container = backdrop.parentElement;
      if (!container) return;
      var w = btn.offsetWidth;
      var o = btn.offsetLeft;
      if (!w || w <= 0) return;
      // Clamp: a stale/unstyled measurement must never paint a giant blob
      var maxW = container.scrollWidth - 40;
      if (w > maxW) return;
      backdrop.style.setProperty('--offset', o + 'px');
      backdrop.style.setProperty('--width', w + 'px');
      container.classList.add('is-synced');
    }

    // Category Tabs - prompt spec: filter by data-category, scroll to 0
    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        syncBackdropSoon();

        var category = btn.getAttribute('data-category') || 'all';
        var allCards = viewport.querySelectorAll('.raycast-reel-card');

        if (category === 'all') {
          allCards.forEach(function(card) {
            card.style.display = 'flex';
          });
          viewport.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          allCards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            if (cardCat === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
          viewport.scrollTo({ left: 0, behavior: 'smooth' });
        }

        setTimeout(updateNavButtons, 250);
      });
    });

    // Initialize sliding pill + keep it synced on every possible layout change
    function syncBackdrop() {
      var currentActive = document.querySelector('.raycast-tab-btn.active');
      if (currentActive) positionBackdrop(currentActive);
    }
    function syncBackdropSoon() {
      requestAnimationFrame(function() { requestAnimationFrame(syncBackdrop); });
    }
    syncBackdropSoon();
    document.addEventListener('DOMContentLoaded', syncBackdropSoon);
    window.addEventListener('load', syncBackdrop);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(syncBackdrop);
    }
    if ('ResizeObserver' in window) {
      var tabsContainer = backdrop ? backdrop.parentElement : null;
      if (tabsContainer) {
        new ResizeObserver(function() { syncBackdrop(); }).observe(tabsContainer);
      }
    }

    // Resize event
    window.addEventListener('resize', function() {
      syncBackdrop();
      updateNavButtons();
    });

    // Initial button state
    updateNavButtons();
  })();

  // Scroll Reveal Observer for Homepage Sections
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var revealEls = document.querySelectorAll('.reveal-on-scroll');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    revealEls.forEach(function(el) { observer.observe(el); });
  } else {
    var allEls = document.querySelectorAll('.reveal-on-scroll');
    for (var e = 0; e < allEls.length; e++) {
      allEls[e].classList.add('revealed');
    }
  }
</script>