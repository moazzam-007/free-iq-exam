# Cloudflare Pages Headers
# Prevent indexing of preview/staging pages.dev deployment to avoid duplicate content penalty
https://*.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Security and caching headers for production custom domain
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
