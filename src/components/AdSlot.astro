---
export interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'auto';
  class?: string;
}

const {
  slotId = '',
  format = 'auto',
  class: className = '',
} = Astro.props;

const adsensePubId = import.meta.env.PUBLIC_ADSENSE_PUB_ID;

// Reserve deterministic minimum height to prevent Cumulative Layout Shift (CLS)
const minHeightClass =
  format === 'horizontal'
    ? 'min-h-[90px]'
    : format === 'rectangle'
    ? 'min-h-[250px]'
    : 'min-h-[90px] sm:min-h-[250px]';

const adFormat = format === 'auto' ? 'auto' : format === 'horizontal' ? 'horizontal' : 'rectangle';
---

<div
  class:list={[
    'ad-slot-container w-full flex flex-col items-center justify-center my-6 overflow-hidden',
    minHeightClass,
    className,
  ]}
  aria-label="Advertisement"
>
  <span class="text-[10px] text-zinc-400 dark:text-zinc-500 uppercase tracking-widest text-center block mb-1 select-none">
    ADVERTISEMENT
  </span>

  {adsensePubId && slotId ? (
    <ins
      class="adsbygoogle block w-full text-center"
      style="display:block"
      data-ad-client={adsensePubId}
      data-ad-slot={slotId}
      data-ad-format={adFormat}
      data-full-width-responsive="true"
    ></ins>
  ) : (
    <div
      class:list={[
        'w-full flex items-center justify-center rounded-xl border border-dashed border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/30 text-zinc-400 text-xs font-mono select-none',
        format === 'horizontal' ? 'h-[90px]' : format === 'rectangle' ? 'h-[250px]' : 'h-[90px] sm:h-[250px]',
      ]}
    >
      <div class="flex flex-col items-center gap-1 opacity-70">
        <svg class="w-5 h-5 text-zinc-300 dark:text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Ad Placement Placeholder</span>
      </div>
    </div>
  )}
</div>

{adsensePubId && slotId && (
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}
