                  👓
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-zinc-900 dark:text-white text-xs group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
