            <!-- Divider: Practice Hub -->
            <div class="mt-2 pt-2 border-t border-zinc-100 dark:border-zinc-800/80">
              <a
                href="/practice"
                class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 text-xs font-semibold text-zinc-700 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                <span class="flex items-center gap-2">
                  <span>🧩</span>
                  <span>Untimed Cognitive Practice Hub</span>
                </span>
                <span class="text-zinc-400 font-mono text-xs">Explore drills →</span>
