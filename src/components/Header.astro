                <div
                  class="w-8 h-8 rounded-lg bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 border border-sky-200/60 dark:border-sky-900/40 flex items-center justify-center shrink-0 mt-0.5 text-sm"
                >
                  📋
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-zinc-900 dark:text-white text-xs group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Depression Screener
                    </span>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-sky-100 dark:bg-sky-950 text-sky-600 dark:text-sky-400">New</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    Standardized PHQ-9 inventory
                  </div>
                </div>
