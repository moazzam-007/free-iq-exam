      <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400"
        >Language</span
      >
      <div
        class="inline-flex items-center rounded-lg bg-zinc-200/70 dark:bg-zinc-800 p-0.5 text-xs font-semibold border border-zinc-300/60 dark:border-zinc-700/80"
      >
        <span
          class="px-2.5 py-1 rounded-md bg-white dark:bg-zinc-700 text-blue-600 dark:text-blue-400 shadow-xs font-bold"
          >EN</span
        >
        <a
          href={idHref}
          class="px-2.5 py-1 rounded-md text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors"
          >ID</a
        >
        <a
          href={ruHref}
          class="px-2.5 py-1 rounded-md text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors"
          >RU</a
        >
      </div>
    </div>
  </div>

  <!-- Drawer Grouped Links: Collapsible Accordion Sections -->
  <div class="p-4 flex flex-col gap-3 overflow-y-auto flex-1">
    <!-- Home Link -->
    <a
      href="/"
      class={`min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-medium flex items-center justify-between transition-colors ${
        currentNorm === "/"
          ? "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold"
          : "text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 hover:text-zinc-950 dark:hover:text-white"
      }`}
      aria-current={currentNorm === "/" ? "page" : undefined}
    >
      <span class="flex items-center gap-2.5 font-semibold">
        <span>🏠</span>
        <span>Home</span>
      </span>
      <span class="text-xs text-zinc-400 font-mono">/</span>
    </a>

    <!-- 3 Collapsible Accordion Sections -->
    {
      mobileAccordionSections.map((section) => {
        const hasActiveLink = section.links.some(
          (l) => currentNorm === normalizePath(l.href)
        );

        return (
          <details
            class="group rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/40 dark:bg-zinc-900/40 overflow-hidden transition-colors"
            open={hasActiveLink ? true : undefined}
          >
            <summary class="flex items-center justify-between p-3 cursor-pointer list-none select-none text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100/70 dark:hover:bg-zinc-800/60 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-2xl">
              <div class="flex items-center gap-2.5">
                <span class="text-base">{section.icon}</span>
                <div>
                  <span class="font-heading font-bold text-xs sm:text-sm text-zinc-950 dark:text-white block">
                    {section.title}
                  </span>
                  <span class="text-[11px] text-zinc-400 dark:text-zinc-500 font-normal">
                    {section.description}
                  </span>
                </div>
              </div>
              <svg
                class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                />
              </svg>
            </summary>

            <div class="p-2 pt-1 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-col gap-1 bg-white dark:bg-zinc-950/60">
              {section.links.map((link) => {
                const isActive = currentNorm === normalizePath(link.href);
                return (
                  <a
                    href={link.href}
                    class={`min-h-[42px] px-2.5 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center justify-between transition-colors ${
                      isActive
                        ? "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold"
                        : "text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 hover:text-zinc-950 dark:hover:text-white"
                    }`}
                    aria-current={isActive ? "page" : undefined}
                  >
                    <div class="flex items-center gap-2 truncate pr-2">
                      <span class="text-sm shrink-0">{link.icon}</span>
                      <span class="truncate">{link.label}</span>
                    </div>
                    {link.badge && (
                      <span
                        class={`text-[9.5px] font-bold px-1.5 py-0.5 rounded-md shrink-0 ${
                          link.badge === "New"
                            ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400"
                            : link.badge === "Official"
                            ? "bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-400"
                            : link.badge === "Fast"
                            ? "bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-400"
                            : "bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400"
                        }`}
                      >
                        {link.badge}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </details>
        );
      })
    }
  </div>
</aside>

<script>
  // 1. Theme toggle script
  const themeToggleBtn = document.getElementById("theme-toggle-btn");
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener("click", () => {
      try {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  }

  // 2. Mobile Drawer Toggle logic
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const mobileDrawerClose = document.getElementById("mobile-drawer-close");
  const mobileBackdrop = document.getElementById("mobile-menu-backdrop");

  function openDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove("hidden");
    requestAnimationFrame(() => {
      mobileBackdrop.classList.remove("opacity-0", "pointer-events-none");
      mobileBackdrop.classList.add("opacity-100", "pointer-events-auto");
      mobileDrawer.classList.remove("translate-x-full", "pointer-events-none");
      mobileDrawer.classList.add("translate-x-0", "pointer-events-auto");
      mobileDrawer.setAttribute("aria-hidden", "false");
      mobileMenuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      if (mobileDrawerClose) mobileDrawerClose.focus();
    });
  }

  function closeDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove("opacity-100", "pointer-events-auto");
    mobileBackdrop.classList.add("opacity-0", "pointer-events-none");
    mobileDrawer.classList.remove("translate-x-0", "pointer-events-auto");
    mobileDrawer.classList.add("translate-x-full", "pointer-events-none");
    mobileDrawer.setAttribute("aria-hidden", "true");
    mobileMenuBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    setTimeout(() => {
      mobileBackdrop.classList.add("hidden");
      mobileMenuBtn.focus();
    }, 300);
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener("click", () => {
      const isExpanded = mobileMenuBtn.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
  }

  if (mobileDrawerClose) {
    mobileDrawerClose.addEventListener("click", closeDrawer);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener("click", closeDrawer);
  }

  window.addEventListener("keydown", (e) => {
    const isDrawerOpen =
      mobileMenuBtn?.getAttribute("aria-expanded") === "true";
    if (!isDrawerOpen) return;

    if (e.key === "Escape") {
      closeDrawer();
      return;
    }

    if (e.key === "Tab" && mobileDrawer) {
      const focusableEls = mobileDrawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      );
      if (focusableEls.length === 0) return;
      const firstEl = focusableEls[0] as HTMLElement;
      const lastEl = focusableEls[focusableEls.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }
  });

  // 3. Desktop Dropdown hover/click toggle & aria-expanded synchronization
  const dropdownTests = document.getElementById("nav-dropdown-tests");
  const dropdownGames = document.getElementById("nav-dropdown-games");
  const dropdownTools = document.getElementById("nav-dropdown-tools");

  const allDropdowns = [dropdownTests, dropdownGames, dropdownTools];

  allDropdowns.forEach((dd) => {
    if (!dd) return;
    const btn = dd.querySelector("button");
    if (!btn) return;

    const setExpanded = (expanded: boolean) => {
      btn.setAttribute("aria-expanded", expanded ? "true" : "false");
    };

    dd.addEventListener("mouseenter", () => setExpanded(true));
    dd.addEventListener("mouseleave", () => {
      if (!dd.classList.contains("active-click")) setExpanded(false);
    });

    dd.addEventListener("focusin", () => setExpanded(true));
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains((e as FocusEvent).relatedTarget as Node)) {
        if (!dd.classList.contains("active-click")) setExpanded(false);
      }
    });

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = dd.classList.contains("active-click");
      allDropdowns.forEach((d) => {
        d?.classList.remove("active-click");
        d?.querySelector("button")?.setAttribute("aria-expanded", "false");
      });
      if (!isCurrentlyOpen) {
        dd.classList.add("active-click");
        setExpanded(true);
      }
    });
  });

  document.addEventListener("click", () => {
    allDropdowns.forEach((d) => {
      d?.classList.remove("active-click");
      d?.querySelector("button")?.setAttribute("aria-expanded", "false");
    });
  });
</script>
