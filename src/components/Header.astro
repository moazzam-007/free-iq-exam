                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-950 text-purple-600 dark:text-purple-400">New</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    Visual latency in milliseconds
                  </div>
                </div>
              </a>

              <!-- Adult ADHD Screener -->
              <a
                href="/adhd-test"
                class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
