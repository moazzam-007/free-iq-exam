                    <span class="font-semibold text-zinc-900 dark:text-white text-xs group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Full IQ Exam (20m)
                    </span>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400">Official</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    24 items across 4 CHC domains
                  </div>
                </div>
              </a>

              <!-- Quick Screener -->
              <a
                href="/quick-test"
                class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
              >
                <div
                  class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 border border-amber-200/60 dark:border-amber-900/40 flex items-center justify-center shrink-0 mt-0.5 text-sm"
                >
                  ⚡
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-zinc-900 dark:text-white text-xs group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Quick Screener (10m)
