---
interface Props {
  currentPath?: string;
  enPath?: string;
  idPath?: string;
  ruPath?: string;
  jaPath?: string;
  dePath?: string;
  ptBrPath?: string;
  nlPath?: string;
  fiPath?: string;
}

const {
  currentPath = Astro.url.pathname,
  enPath,
  idPath,
  ruPath,
  jaPath,
  dePath,
  ptBrPath,
  nlPath,
  fiPath,
} = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, "") || "/";
const currentNorm = normalizePath(currentPath);

// Build-time manifest of every route that actually exists under a locale.
const buildLocaleRouteSet = (modules: Record<string, unknown>, locale: string) => {
  const routes = new Set<string>([`/${locale}`, `/${locale}/`]);
  for (const filePath of Object.keys(modules)) {
    const slug = filePath
      .replace(/^.*\/pages\/[^/]+\//, "")
      .replace(/\.astro$/, "")
      .replace(/(^|\/)index$/, "");
    routes.add(normalizePath(`/${locale}/${slug}`));
  }
  return routes;
};

const idRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/id/**/*.astro"), "id");
const ruRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/ru/**/*.astro"), "ru");
const jaRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/ja/**/*.astro"), "ja");
const deRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/de/**/*.astro"), "de");
const ptBrRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/pt-br/**/*.astro"), "pt-br");
const nlRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/nl/**/*.astro"), "nl");
const fiRouteSet = buildLocaleRouteSet(import.meta.glob("/src/pages/fi/**/*.astro"), "fi");

// An explicit prop always wins; otherwise reuse the current slug only when the target locale actually publishes it
const resolveLocaleTarget = (routes: Set<string>, locale: string, explicit?: string) => {
  if (explicit) {
    if (explicit === "/" || explicit === `/${locale}` || explicit === `/${locale}/`) return `/${locale}/`;
    return explicit.startsWith(`/${locale}`) ? explicit : `/${locale}${explicit}`;
  }
  const baseSlug = currentNorm.replace(/^\/(id|ru|ja|de|nl|fi|pt-br)/, "") || "/";
  if (baseSlug === "/") return `/${locale}/`;
  const candidate = normalizePath(`/${locale}${baseSlug}`);
  return routes.has(candidate) ? candidate : `/${locale}/`;
};

const getEnFallback = (path: string) => {
  const match = path.match(/^\/(id|ru|ja|de|pt-br|nl|fi)(\/.*)?$/);
  if (match) {
    return match[2] || "/";
  }
  return path || "/";
};

const enHref = enPath || getEnFallback(currentNorm);
const idHref = resolveLocaleTarget(idRouteSet, "id", idPath);
const ruHref = resolveLocaleTarget(ruRouteSet, "ru", ruPath);
const jaHref = resolveLocaleTarget(jaRouteSet, "ja", jaPath);
const deHref = resolveLocaleTarget(deRouteSet, "de", dePath);
const ptBrHref = resolveLocaleTarget(ptBrRouteSet, "pt-br", ptBrPath);
const nlHref = resolveLocaleTarget(nlRouteSet, "nl", nlPath);
const fiHref = resolveLocaleTarget(fiRouteSet, "fi", fiPath);

const activeLangCode =
  currentNorm === "/id" || currentNorm.startsWith("/id/")
    ? "ID"
    : currentNorm === "/ru" || currentNorm.startsWith("/ru/")
      ? "RU"
      : currentNorm === "/ja" || currentNorm.startsWith("/ja/")
        ? "JA"
        : currentNorm === "/de" || currentNorm.startsWith("/de/")
          ? "DE"
          : currentNorm === "/pt-br" || currentNorm.startsWith("/pt-br/")
            ? "PT"
            : currentNorm === "/nl" || currentNorm.startsWith("/nl/")
              ? "NL"
              : currentNorm === "/fi" || currentNorm.startsWith("/fi/")
                ? "FI"
                : "EN";

const isHomeActive = currentNorm === "/";
const isTestsActive = [
  "/test",
  "/quick-test",
  "/practice",
  "/color-blind-test",
  "/reaction-time-test",
  "/adhd-test",
  "/depression-test",
  "/anxiety-test",
  "/autism-test",
  "/hearing-test",
  "/eye-test",
].some((p) => currentNorm === p || (p !== "/" && currentNorm.startsWith(p)));

const isGamesActive =
  currentNorm === "/games" ||
  currentNorm.startsWith("/games/") ||
  currentNorm === "/typing-test" ||
  currentNorm === "/aim-trainer" ||
  currentNorm === "/flag-quiz";

const isToolsActive = [
  "/tools",
  "/sleep-calculator",
  "/brown-noise",
  "/calorie-calculator",
  "/mic-test",
  "/memento-mori",
  "/circle-of-control",
  "/iq-score-chart",
  "/iq-percentile-calculator",
  "/methodology",
].some((p) => currentNorm === p || (p !== "/" && currentNorm.startsWith(p)));

const isLeaderboardActive = currentNorm === "/leaderboard";
const isBlogActive =
  currentNorm === "/blog" || currentNorm.startsWith("/blog/");

