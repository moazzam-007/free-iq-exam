                    </span>
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-pink-100 dark:bg-pink-950 text-pink-600 dark:text-pink-400">New</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    20 Hz – 20 kHz threshold test
                  </div>
                </div>
              </a>

              <!-- Visual Acuity & Eye Test -->
              <a
                href="/eye-test"
                class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
              >
                <div
                  class="w-8 h-8 rounded-lg bg-teal-50 dark:bg-teal-950/50 text-teal-600 dark:text-teal-400 border border-teal-200/60 dark:border-teal-900/40 flex items-center justify-center shrink-0 mt-0.5 text-sm"
