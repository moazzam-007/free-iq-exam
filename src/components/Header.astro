<script>
  // 1. Theme toggle script
  const themeToggleBtn = document.getElementById("theme-toggle-btn");
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener("click", () => {
      try {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  }

  // 1b. Language dropdowns (Option 1 Minimal Compact, desktop + mobile)
  const closeAllLangMenus = (refocus: boolean) => {
    document.querySelectorAll("[data-lang-menu]").forEach((m) => m.classList.add("hidden"));
    const openTrigger = document.querySelector('[data-lang-trigger][aria-expanded="true"]') as HTMLElement | null;
    document.querySelectorAll("[data-lang-trigger]").forEach((t) => t.setAttribute("aria-expanded", "false"));
    if (refocus && openTrigger) openTrigger.focus();
  };
  document.querySelectorAll("[data-lang-wrap]").forEach((wrap) => {
    const trigger = wrap.querySelector("[data-lang-trigger]");
    const menu = wrap.querySelector("[data-lang-menu]");
    if (!trigger || !menu) return;
    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const opening = menu.classList.contains("hidden");
      closeAllLangMenus(false);
      if (opening) {
        menu.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
      }
    });
    menu.addEventListener("click", (e) => e.stopPropagation());
  });
  document.addEventListener("click", () => closeAllLangMenus(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAllLangMenus(true);
  });

  // 2. Mobile Drawer Toggle logic
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const mobileDrawerClose = document.getElementById("mobile-drawer-close");
  const mobileBackdrop = document.getElementById("mobile-menu-backdrop");

  function openDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove("hidden");
    requestAnimationFrame(() => {
      mobileBackdrop.classList.remove("opacity-0", "pointer-events-none");
      mobileBackdrop.classList.add("opacity-100", "pointer-events-auto");
      mobileDrawer.classList.remove("translate-x-full", "pointer-events-none");
      mobileDrawer.classList.add("translate-x-0", "pointer-events-auto");
      mobileDrawer.setAttribute("aria-hidden", "false");
      mobileMenuBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      if (mobileDrawerClose) mobileDrawerClose.focus();
    });
  }

  function closeDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove("opacity-100", "pointer-events-auto");
    mobileBackdrop.classList.add("opacity-0", "pointer-events-none");
    mobileDrawer.classList.remove("translate-x-0", "pointer-events-auto");
    mobileDrawer.classList.add("translate-x-full", "pointer-events-none");
    mobileDrawer.setAttribute("aria-hidden", "true");
    mobileMenuBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    setTimeout(() => {
      mobileBackdrop.classList.add("hidden");
      mobileMenuBtn.focus();
    }, 300);
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener("click", () => {
      const isExpanded = mobileMenuBtn.getAttribute("aria-expanded") === "true";
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
  }

  if (mobileDrawerClose) {
    mobileDrawerClose.addEventListener("click", closeDrawer);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener("click", closeDrawer);
  }

  window.addEventListener("keydown", (e) => {
    const isDrawerOpen =
      mobileMenuBtn?.getAttribute("aria-expanded") === "true";
    if (!isDrawerOpen) return;

    if (e.key === "Escape") {
      closeDrawer();
      return;
    }

    if (e.key === "Tab" && mobileDrawer) {
      const focusableEls = mobileDrawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      );
      if (focusableEls.length === 0) return;
      const firstEl = focusableEls[0] as HTMLElement;
      const lastEl = focusableEls[focusableEls.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }
  });

  // 3. Desktop Dropdown hover/click toggle & aria-expanded synchronization
  const dropdownTests = document.getElementById("nav-dropdown-tests");
  const dropdownGames = document.getElementById("nav-dropdown-games");
  const dropdownTools = document.getElementById("nav-dropdown-tools");

  const allDropdowns = [dropdownTests, dropdownGames, dropdownTools];

  allDropdowns.forEach((dd) => {
    if (!dd) return;
    const btn = dd.querySelector("button");
    if (!btn) return;

    const setExpanded = (expanded: boolean) => {
      btn.setAttribute("aria-expanded", expanded ? "true" : "false");
    };

    dd.addEventListener("mouseenter", () => setExpanded(true));
    dd.addEventListener("mouseleave", () => {
      if (!dd.classList.contains("active-click")) setExpanded(false);
    });

    dd.addEventListener("focusin", () => setExpanded(true));
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains((e as FocusEvent).relatedTarget as Node)) {
        if (!dd.classList.contains("active-click")) setExpanded(false);
      }
    });

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = dd.classList.contains("active-click");
      allDropdowns.forEach((d) => {
        d?.classList.remove("active-click");
        d?.querySelector("button")?.setAttribute("aria-expanded", "false");
      });
      if (!isCurrentlyOpen) {
        dd.classList.add("active-click");
        setExpanded(true);
      }
    });
  });

  document.addEventListener("click", () => {
    allDropdowns.forEach((d) => {
      d?.classList.remove("active-click");
      d?.querySelector("button")?.setAttribute("aria-expanded", "false");
    });
  });
</script>
