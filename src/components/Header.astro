                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400">Fast</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 leading-snug">
                    12 calibrated rapid items
                  </div>
                </div>
              </a>

              <!-- Color Blind Test -->
              <a
                href="/color-blind-test"
                class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
              >
                <div
                  class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-900/40 flex items-center justify-center shrink-0 mt-0.5 text-sm"
