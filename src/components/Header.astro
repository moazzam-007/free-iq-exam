---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';
const currentNorm = normalizePath(currentPath);

const isHomeActive = currentNorm === '/';
const isAssessmentsActive = ['/test', '/quick-test', '/practice'].some(
  (p) => currentNorm === p || (p !== '/' && currentNorm.startsWith(p))
);

const isGamesActive = currentNorm === '/games' || currentNorm.startsWith('/games/');
const isLeaderboardActive = currentNorm === '/leaderboard';
const isBlogActive = currentNorm === '/blog' || currentNorm.startsWith('/blog/');
const isScienceActive = ['/iq-score-chart', '/iq-percentile-calculator', '/methodology'].some(
  (p) => currentNorm === p
);

const allMobileLinks = [
  { href: '/test', label: 'Full IQ Test (20 min)', badge: 'Official', group: 'Assessments' },
  { href: '/quick-test', label: 'Quick Screening (10 min)', badge: 'Fast', group: 'Assessments' },
  { href: '/practice', label: 'Practice Hub (Untimed)', badge: '', group: 'Assessments' },
  { href: '/games', label: 'Cognitive Games', badge: '', group: 'Training & Rank' },
  { href: '/leaderboard', label: 'Global Leaderboard', badge: '', group: 'Training & Rank' },
  { href: '/profile', label: 'My Cognitive Profile', badge: '', group: 'Training & Rank' },
  { href: '/iq-score-chart', label: 'Score Distribution Chart', badge: '', group: 'Science & Reference' },
  { href: '/iq-percentile-calculator', label: 'Percentile Calculator', badge: '', group: 'Science & Reference' },
  { href: '/methodology', label: 'Psychometric Methodology', badge: '2PL IRT', group: 'Science & Reference' },
  { href: '/blog', label: 'Research Articles & Blog', badge: '', group: 'Science & Reference' },
];

const mobileGroups = ['Assessments', 'Training & Rank', 'Science & Reference'] as const;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/90 dark:bg-zinc-950/85 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- 1. Brand Logo: Minimalist 3-Dot Cognitive Mark + Wordmark -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="FreeIQExam Home">
      <svg class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 group-hover:scale-105 transition-transform duration-200" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="9.5" r="5.5" class="fill-blue-600 dark:fill-blue-500" />
        <circle cx="8" cy="23" r="4.8" class="fill-blue-700 dark:fill-blue-600" />
        <circle cx="24" cy="23" r="4.8" class="fill-sky-400 dark:fill-sky-400" />
      </svg>
      <span class="font-heading font-extrabold text-xl sm:text-2xl tracking-tight text-zinc-950 dark:text-white leading-tight">
        Free<span class="text-blue-600 dark:text-blue-500">IQ</span>Exam
      </span>
    </a>

    <!-- 2. Center Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[13.5px] font-medium" aria-label="Primary Navigation">
      
      <!-- Link: Home -->
      <a
        href="/"
        class={`py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
          isHomeActive
            ? 'text-blue-600 dark:text-blue-400 font-semibold'
            : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
        }`}
        aria-current={isHomeActive ? 'page' : undefined}
      >
        Home
      </a>

      <!-- Dropdown 1: Assessments ▾ -->
      <div class="relative group" id="nav-dropdown-assessments">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
            isAssessmentsActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Assessments</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Assessments Flyout Menu -->
        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-72 p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 shadow-xl shadow-zinc-950/10 dark:shadow-black/40">
            <a
              href="/quick-test"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                ⚡
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Quick Test (10 min)
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  12 adaptive questions for rapid screening
                </div>
              </div>
            </a>

            <a
              href="/test"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                🎯
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Full Exam (20 min)
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  24 items across 4 calibrated CHC domains
                </div>
              </div>
            </a>

            <a
              href="/practice"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item border-t border-zinc-100 dark:border-zinc-800/60 mt-1"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                🧩
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Practice Hub
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Untimed domain drills & explanations
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Cognitive Games -->
      <a
        href="/games"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isGamesActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isGamesActive ? 'page' : undefined}
      >
        Cognitive Games
      </a>

      <!-- Leaderboard -->
      <a
        href="/leaderboard"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isLeaderboardActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isLeaderboardActive ? 'page' : undefined}
      >
        Leaderboard
      </a>

      <!-- Dropdown 2: Science & Tools ▾ -->
      <div class="relative group" id="nav-dropdown-science">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
            isScienceActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Science & Tools</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Science Flyout Menu (without blog, as requested) -->
        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-72 p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 shadow-xl shadow-zinc-950/10 dark:shadow-black/40">
            <a
              href="/iq-score-chart"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                📊
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Score Distribution Chart
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Gaussian bell curve & standard deviations
                </div>
              </div>
            </a>

            <a
              href="/iq-percentile-calculator"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm font-mono font-bold">
                %
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Percentile Calculator
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Convert raw IQ score to population percentile
                </div>
              </div>
            </a>

            <a
              href="/methodology"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                🔬
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Scientific Methodology
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  2PL IRT calibration & psychometric validity
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Standalone Blog (Placed right after Science & Tools, exactly as requested) -->
      <a
        href="/blog"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isBlogActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isBlogActive ? 'page' : undefined}
      >
        Blog
      </a>

    </nav>

    <!-- 3. Right Action Cluster: Theme Button + Profile Button + Segmented CTA Capsule -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      
      <!-- Theme Toggle (Rounded Square) -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-10 h-10 rounded-xl flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer"
        aria-label="Toggle light and dark mode"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- Profile Avatar Button (Rounded Square) -->
      <a
        href="/profile"
        class={`w-10 h-10 rounded-xl hidden sm:flex items-center justify-center bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
          currentNorm === '/profile' ? 'text-blue-600 dark:text-blue-400 border-blue-300 dark:border-blue-800' : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
        }`}
        title="My Cognitive Profile & History"
        aria-label="My Cognitive Profile"
      >
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      </a>

      <!-- Connected Segmented CTA Capsule -->
      <div class="hidden sm:inline-flex items-center bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 rounded-full p-[3px] shadow-xs">
        <a
          href="/quick-test"
          class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center gap-1.5 whitespace-nowrap"
          title="12-question adaptive screening"
        >
          <span class="text-amber-500 font-bold">⚡</span>
          <span>Quick 10m</span>
        </a>
        <a
          href="/test"
          class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-xs shadow-blue-500/20 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-1 whitespace-nowrap"
          title="24-item clinical assessment"
        >
          <span>Full Test</span>
          <span class="font-mono">→</span>
        </a>
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-10 h-10 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

    </div>

  </div>
</header>

<!-- Mobile Drawer Fixed Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-black/50 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none hidden"
  aria-hidden="true"
></div>

<!-- Mobile Navigation Slide Drawer -->
<aside
  id="mobile-drawer"
  class="fixed inset-y-0 right-0 z-50 w-[85vw] max-w-sm bg-white dark:bg-zinc-950 border-l border-zinc-200 dark:border-zinc-800 shadow-2xl transition-transform duration-300 transform translate-x-full overflow-y-auto overscroll-contain flex flex-col pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="h-16 px-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2.5">
      <svg class="w-7 h-7 shrink-0" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="9.5" r="5.5" class="fill-blue-600 dark:fill-blue-500" />
        <circle cx="8" cy="23" r="4.8" class="fill-blue-700 dark:fill-blue-600" />
        <circle cx="24" cy="23" r="4.8" class="fill-sky-400 dark:fill-sky-400" />
      </svg>
      <span class="font-heading font-extrabold text-base text-zinc-950 dark:text-white">
        Free<span class="text-blue-600 dark:text-blue-500">IQ</span>Exam
      </span>
    </div>
    <button
      id="mobile-drawer-close"
      type="button"
      class="w-10 h-10 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 transition-colors"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Fast Action Capsule -->
  <div class="p-4 border-b border-zinc-100 dark:border-zinc-800/80 bg-zinc-50/70 dark:bg-zinc-900/50">
    <div class="flex items-center gap-2">
      <a
        href="/quick-test"
        class="flex-1 py-2.5 px-3 rounded-xl bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-semibold text-zinc-800 dark:text-zinc-200 text-center flex items-center justify-center gap-1.5 shadow-2xs"
      >
        <span>⚡ Quick 10m</span>
      </a>
      <a
        href="/test"
        class="flex-1 py-2.5 px-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold text-center flex items-center justify-center gap-1 shadow-xs"
      >
        <span>Full Test →</span>
      </a>
    </div>
  </div>

  <!-- Drawer Grouped Links -->
  <div class="p-4 flex flex-col gap-5 overflow-y-auto flex-1">
    <div class="flex flex-col gap-1">
      <a
        href="/"
        class={`min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-medium flex items-center justify-between transition-colors ${
          currentNorm === '/'
            ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold'
            : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 hover:text-zinc-950 dark:hover:text-white'
        }`}
        aria-current={currentNorm === '/' ? 'page' : undefined}
      >
        <span>Home</span>
      </a>
    </div>

    {mobileGroups.map((grp) => (
      <div>
        <p class="px-2 pb-2 text-[11px] font-mono font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
          {grp}
        </p>
        <div class="flex flex-col gap-1">
          {allMobileLinks
            .filter((l) => l.group === grp)
            .map((link) => {
              const isActive = currentNorm === normalizePath(link.href);
              return (
                <a
                  href={link.href}
                  class={`min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-medium flex items-center justify-between transition-colors ${
                    isActive
                      ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold'
                      : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 hover:text-zinc-950 dark:hover:text-white'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span>{link.label}</span>
                  {link.badge && (
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
                      {link.badge}
                    </span>
                  )}
                </a>
              );
            })}
        </div>
      </div>
    ))}
  </div>
</aside>

<script>
  // 1. Theme toggle script
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      try {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }

  // 2. Mobile Drawer Toggle logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileDrawerClose = document.getElementById('mobile-drawer-close');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');

  function openDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      mobileDrawer.classList.remove('translate-x-full', 'pointer-events-none');
      mobileDrawer.classList.add('translate-x-0', 'pointer-events-auto');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (mobileDrawerClose) mobileDrawerClose.focus();
    });
  }

  function closeDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
    mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
    mobileDrawer.classList.remove('translate-x-0', 'pointer-events-auto');
    mobileDrawer.classList.add('translate-x-full', 'pointer-events-none');
    mobileDrawer.setAttribute('aria-hidden', 'true');
    mobileMenuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      mobileBackdrop.classList.add('hidden');
      mobileMenuBtn.focus();
    }, 300);
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
  }

  if (mobileDrawerClose) {
    mobileDrawerClose.addEventListener('click', closeDrawer);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', closeDrawer);
  }

  window.addEventListener('keydown', (e) => {
    const isDrawerOpen = mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
    if (!isDrawerOpen) return;

    if (e.key === 'Escape') {
      closeDrawer();
      return;
    }

    if (e.key === 'Tab' && mobileDrawer) {
      const focusableEls = mobileDrawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusableEls.length === 0) return;
      const firstEl = focusableEls[0] as HTMLElement;
      const lastEl = focusableEls[focusableEls.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }
  });

  // 3. Desktop Dropdown hover/click toggle for touch screens
  const dropdownAssessments = document.getElementById('nav-dropdown-assessments');
  const dropdownScience = document.getElementById('nav-dropdown-science');

  [dropdownAssessments, dropdownScience].forEach((dd) => {
    if (!dd) return;
    const btn = dd.querySelector('button');
    if (!btn) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isCurrentlyOpen = dd.classList.contains('active-click');
      [dropdownAssessments, dropdownScience].forEach((d) => d?.classList.remove('active-click'));
      if (!isCurrentlyOpen) {
        dd.classList.add('active-click');
      }
    });
  });

  document.addEventListener('click', () => {
    [dropdownAssessments, dropdownScience].forEach((d) => d?.classList.remove('active-click'));
  });
</script>
