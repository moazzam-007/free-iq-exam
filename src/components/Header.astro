              <!-- Hearing & Ear Age Test -->
              <a
                href="/hearing-test"
                class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
              >
                <div
                  class="w-8 h-8 rounded-lg bg-pink-50 dark:bg-pink-950/50 text-pink-600 dark:text-pink-400 border border-pink-200/60 dark:border-pink-900/40 flex items-center justify-center shrink-0 mt-0.5 text-sm"
