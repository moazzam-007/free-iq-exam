---
interface Props {
  currentPath?: string;
  enPath?: string;
  idPath?: string;
  ruPath?: string;
}

const {
  currentPath = Astro.url.pathname,
  enPath,
  idPath,
  ruPath,
} = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, "") || "/";
const currentNorm = normalizePath(currentPath);

const enHref = enPath || currentNorm || "/";
const idHref = idPath
  ? idPath === "/"
    ? "/id"
    : idPath.startsWith("/id")
      ? idPath
      : `/id${idPath}`
  : currentNorm === "/"
    ? "/id"
    : `/id${currentNorm}`;
const ruHref = ruPath
  ? ruPath === "/"
    ? "/ru"
    : ruPath.startsWith("/ru")
      ? ruPath
      : `/ru${ruPath}`
  : currentNorm === "/"
    ? "/ru"
    : `/ru${currentNorm}`;

const isHomeActive = currentNorm === "/";
const isTestsActive = [
  "/test",
  "/quick-test",
  "/practice",
  "/color-blind-test",
  "/reaction-time-test",
  "/adhd-test",
  "/depression-test",
  "/hearing-test",
  "/eye-test",
].some((p) => currentNorm === p || (p !== "/" && currentNorm.startsWith(p)));

const isGamesActive =
  currentNorm === "/games" ||
  currentNorm.startsWith("/games/") ||
  currentNorm === "/typing-test" ||
  currentNorm === "/aim-trainer";

const isToolsActive = [
  "/tools",
  "/tools/sleep-calculator",
  "/brown-noise",
  "/tools/calorie-calculator",
  "/mic-test",
  "/tools/stoic-memento-mori",
  "/iq-score-chart",
  "/iq-percentile-calculator",
].some((p) => currentNorm === p || (p !== "/" && currentNorm.startsWith(p)));

const isLeaderboardActive = currentNorm === "/leaderboard";
const isBlogActive =
  currentNorm === "/blog" || currentNorm.startsWith("/blog/");

const mobileAccordionSections = [
  {
    id: "assessments",
    icon: "📁",
    title: "Assessments & Screeners",
    description: "Clinical & sensory diagnostics",
    links: [
      {
        href: "/test",
        label: "Full IQ Exam (20 min)",
        badge: "Official",
        desc: "24 items across 4 CHC domains",
        icon: "🎯",
      },
      {
        href: "/quick-test",
