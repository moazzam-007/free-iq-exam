---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';

const toolLinks = [
  { href: '/practice', label: 'Practice Hub' },
  { href: '/games', label: 'Cognitive Games' },
  { href: '/profile', label: 'My Profile' },
  { href: '/leaderboard', label: 'Leaderboard' },
  { href: '/blog', label: 'Blog' },
  { href: '/iq-score-chart', label: 'Score Chart' },
  { href: '/iq-percentile-calculator', label: 'Percentile Calc' },
  { href: '/methodology', label: 'Methodology' },
];

const allMobileLinks = [
  { href: '/profile', label: 'My Cognitive Profile', group: 'Assessments' },
  { href: '/test', label: 'Full IQ Test (20 min)', group: 'Assessments' },
  { href: '/quick-test', label: 'Quick Screening (10 min)', group: 'Assessments' },
  { href: '/practice', label: 'Practice Hub (Untimed Drills)', group: 'Assessments' },
  { href: '/games', label: 'Cognitive Games (5 Drills)', group: 'Assessments' },
  { href: '/leaderboard', label: 'Leaderboard (Hall of Fame)', group: 'Assessments' },
  { href: '/fluid-reasoning-test', label: 'Fluid Reasoning (Gf)', group: 'Specialized Domains' },
  { href: '/spatial-reasoning-test', label: 'Visual-Spatial (Gv)', group: 'Specialized Domains' },
  { href: '/quantitative-reasoning-test', label: 'Quantitative Reasoning (Gq)', group: 'Specialized Domains' },
  { href: '/verbal-reasoning-test', label: 'Verbal Comprehension (Gc)', group: 'Specialized Domains' },
  { href: '/blog', label: 'Cognitive Blog & Research', group: 'Reference Tools' },
  { href: '/iq-score-chart', label: 'IQ Score Chart', group: 'Reference Tools' },
  { href: '/iq-classification-scale', label: 'IQ Classification Scale', group: 'Reference Tools' },
  { href: '/high-iq-societies', label: 'High-IQ Societies Guide', group: 'Reference Tools' },
  { href: '/iq-percentile-calculator', label: 'Percentile Calculator', group: 'Reference Tools' },
  { href: '/matrix-reasoning-test', label: 'Matrix Guide', group: 'Reference Tools' },
  { href: '/average-iq-by-age', label: 'IQ by Age', group: 'Reference Tools' },
  { href: '/mensa-iq-test-practice', label: 'Mensa Practice', group: 'Reference Tools' },
  { href: '/methodology', label: 'Methodology', group: 'Reference Tools' },
];

const groups = ['Assessments', 'Specialized Domains', 'Reference Tools'] as const;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200/80 dark:border-zinc-800 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="FreeIQExam Home">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-lg sm:text-xl shadow-xs group-hover:scale-105 transition-transform duration-200">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-heading font-extrabold text-lg sm:text-xl tracking-tight text-zinc-950 dark:text-white leading-tight">
          FreeIQ<span class="text-blue-600 dark:text-blue-400">Exam</span>
        </span>
        <span class="text-xs font-mono font-medium tracking-widest text-zinc-500 dark:text-zinc-400 uppercase">Scientific Norms</span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Reference Tools only) -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-zinc-600 dark:text-zinc-300" aria-label="Primary">
      {toolLinks.map((link) => {
        const isActive = normalizePath(currentPath) === normalizePath(link.href);
        return (
          <a 
            href={link.href}
            class={`hover:text-zinc-950 dark:hover:text-white transition-colors py-2 ${isActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Theme Toggle & Assessment CTAs -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Dark/Light Theme Toggle (44x44px target) -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-11 h-11 rounded-full flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 border border-zinc-200 dark:border-zinc-800"
        aria-label="Toggle light and dark mode"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- Quick Test Secondary CTA -->
      <a
        href="/quick-test"
        class="hidden sm:inline-flex min-h-[44px] px-4 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 transition-all items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Quick (10 min)</span>
      </a>

      <!-- Primary CTA Button -->
      <a 
        href="/test" 
        class="inline-flex min-h-[44px] px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all hover:scale-102 active:scale-98 items-center gap-1.5"
      >
        <span>Full Test</span>
        <svg class="w-4 h-4 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button (44x44px target) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-11 h-11 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-label="Toggle navigation menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Drawer Fixed Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-black/50 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none hidden"
  aria-hidden="true"
></div>

<!-- Mobile Navigation Slide Drawer -->
<aside
  id="mobile-drawer"
  class="fixed inset-y-0 right-0 z-50 w-[85vw] max-w-sm bg-white dark:bg-zinc-950 border-l border-zinc-200 dark:border-zinc-800 shadow-2xl transition-transform duration-300 transform translate-x-full overflow-y-auto overscroll-contain flex flex-col pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  aria-hidden="true"
>
  <!-- Drawer Top Bar -->
  <div class="h-16 px-5 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2">
      <span class="font-heading font-extrabold text-base text-zinc-950 dark:text-white">
        FreeIQ<span class="text-blue-600 dark:text-blue-400">Exam</span>
      </span>
      <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Menu</span>
    </div>
    <button
      id="mobile-drawer-close"
      type="button"
      class="w-11 h-11 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 transition-colors"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Grouped Link List -->
  <div class="p-4 flex flex-col gap-6 overflow-y-auto flex-1">
    {groups.map((grp) => (
      <div>
        <p class="px-3 pb-2 text-xs font-mono font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
          {grp}
        </p>
        <div class="flex flex-col gap-1">
          {allMobileLinks
            .filter((l) => l.group === grp)
            .map((link) => {
              const isActive = normalizePath(currentPath) === normalizePath(link.href);
              return (
                <a
                  href={link.href}
                  class={`min-h-[44px] px-3.5 py-2.5 rounded-xl text-sm font-medium flex items-center transition-colors ${
                    isActive
                      ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold'
                      : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 hover:text-zinc-950 dark:hover:text-white'
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
        </div>
      </div>
    ))}
  </div>
</aside>

<script>
  // Theme toggle script
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      try {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }

  // Mobile Drawer Toggle logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileDrawerClose = document.getElementById('mobile-drawer-close');
  const mobileBackdrop = document.getElementById('mobile-menu-backdrop');

  function openDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
      mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      mobileDrawer.classList.remove('translate-x-full', 'pointer-events-none');
      mobileDrawer.classList.add('translate-x-0', 'pointer-events-auto');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (mobileDrawerClose) mobileDrawerClose.focus();
    });
  }

  function closeDrawer() {
    if (!mobileDrawer || !mobileBackdrop || !mobileMenuBtn) return;
    mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
    mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
    mobileDrawer.classList.remove('translate-x-0', 'pointer-events-auto');
    mobileDrawer.classList.add('translate-x-full', 'pointer-events-none');
    mobileDrawer.setAttribute('aria-hidden', 'true');
    mobileMenuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      mobileBackdrop.classList.add('hidden');
      mobileMenuBtn.focus();
    }, 300);
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });
  }

  if (mobileDrawerClose) {
    mobileDrawerClose.addEventListener('click', closeDrawer);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', closeDrawer);
  }

  window.addEventListener('keydown', (e) => {
    const isDrawerOpen = mobileMenuBtn?.getAttribute('aria-expanded') === 'true';
    if (!isDrawerOpen) return;

    if (e.key === 'Escape') {
      closeDrawer();
      return;
    }

    if (e.key === 'Tab' && mobileDrawer) {
      const focusableEls = mobileDrawer.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusableEls.length === 0) return;
      const firstEl = focusableEls[0] as HTMLElement;
      const lastEl = focusableEls[focusableEls.length - 1] as HTMLElement;

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          e.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          e.preventDefault();
          firstEl.focus();
        }
      }
    }
  });
</script>
