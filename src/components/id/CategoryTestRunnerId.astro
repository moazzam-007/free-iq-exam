      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      </div>
      <h3 id="modal-exit-title" class="font-heading text-xl font-bold text-zinc-950 dark:text-white mb-2">Keluar dari Tes?</h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
        Your current progress and test mode are saved in this browser. You can return at any time to resume your assessment.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button id="btn-modal-resume" type="button" class="w-full sm:w-auto flex-1 min-h-[44px] px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
          Resume Test
        </button>
        <a href="/id" class="w-full sm:w-auto min-h-[44px] flex items-center justify-center px-5 py-2.5 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
          Exit to Home
        </a>
      </div>
    </div>
  </div>

  <!-- Submit Confirmation Modal with Focus Trap & ARIA Dialog -->
  <div
    id="modal-cat-submit"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cat-submit-modal-title"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm"
  >
    <div class="relative w-full max-w-md p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl">
      <button
        id="btn-close-cat-submit-modal"
        type="button"
        aria-label="Close submit dialog"
        class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 id="cat-submit-modal-title" class="font-heading text-xl font-bold text-zinc-950 dark:text-white mb-2">Submit Category Test?</h3>
      <p id="cat-submit-summary-text" class="text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
        Calculating summary...
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button id="btn-cat-confirm-submit" type="button" class="w-full sm:w-auto flex-1 min-h-[44px] px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
          Calculate Domain Score
        </button>
        <button id="btn-cat-cancel-submit" type="button" class="w-full sm:w-auto min-h-[44px] px-5 py-2.5 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
          Lanjutkan Tes
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Embedded Client Script -->
<script is:inline define:vars={{ questionsJson, runnerConfig, answerKeyToken }}>
  (function () {
    var questions = JSON.parse(questionsJson);
    var config = JSON.parse(runnerConfig);
    var answerKeyMap = {};
    try {
      var decoded = atob(answerKeyToken);
      answerKeyMap = JSON.parse(decoded);
    } catch (e) {}
    var TOTAL_QUESTIONS = questions.length;
    var TOTAL_TIME_SECONDS = config.testDurationMinutes * 60;

    var STORAGE_KEY_SESSION = 'freeiq_cat_session_' + config.domain;

    // State
    var currentMode = 'timed'; // 'timed' or 'practice'
    var currentIndex = 0;
    var userAnswers = {}; // questionId -> optionId
    var flaggedQuestions = {}; // questionId -> boolean
    var timeRemaining = TOTAL_TIME_SECONDS;
    var targetEndTime = null;
    var timerInterval = null;
    var startTimeMs = Date.now();
    var testSubmitted = false;
    var autoAdvanceTimer = null;

    // Check URL params for mode
    try {
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('mode') === 'practice') {
        currentMode = 'practice';
      }
    } catch (e) {}

    // Restore session if available
    try {
      var saved = localStorage.getItem(STORAGE_KEY_SESSION);
      if (saved) {
        var parsed = JSON.parse(saved);
        if (parsed && typeof parsed === 'object') {
          var now = Date.now();
          var isFresh = !parsed.savedAt || (now - parsed.savedAt) < 7200000; // 2 hours
          if (isFresh) {
            if (parsed.answers) userAnswers = parsed.answers;
            if (parsed.flags) flaggedQuestions = parsed.flags;
            if (typeof parsed.timeRemaining === 'number') timeRemaining = parsed.timeRemaining;
            if (typeof parsed.currentIndex === 'number' && parsed.currentIndex < TOTAL_QUESTIONS) currentIndex = parsed.currentIndex;
            if (parsed.mode === 'timed' || parsed.mode === 'practice') currentMode = parsed.mode;
            if (typeof parsed.targetEndTime === 'number' && parsed.mode === 'timed') {
              var remaining = Math.max(0, Math.round((parsed.targetEndTime - now) / 1000));
              if (remaining > 0) {
                targetEndTime = parsed.targetEndTime;
                timeRemaining = remaining;
              }
            }
          }
        }
      }
    } catch (e) {}

    function saveSession() {
      if (testSubmitted) return;
      try {
        localStorage.setItem(STORAGE_KEY_SESSION, JSON.stringify({
          answers: userAnswers,
          flags: flaggedQuestions,
          timeRemaining: timeRemaining,
          targetEndTime: targetEndTime,
          currentIndex: currentIndex,
          mode: currentMode,
          savedAt: Date.now()
        }));
      } catch (e) {}
    }

    // Fisher-Yates shuffle for question options copy
    function shuffleOpsis(opts) {
      var copy = opts.slice();
      for (var i = copy.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = copy[i];
        copy[i] = copy[j];
        copy[j] = temp;
      }
      return copy;
    }

    // DOM References
    var modeTabTimed       = document.getElementById('mode-tab-timed');
    var modeTabPractice    = document.getElementById('mode-tab-practice');
    var activeModeLabel    = document.getElementById('active-mode-label');
    var timerDisplay       = document.getElementById('cat-timer-display');
    var timerContainer     = document.getElementById('cat-timer-container');
    var timerIcon          = document.getElementById('cat-timer-icon');
    var statCurrent        = document.getElementById('cat-stat-current');
    var mobileQNum         = document.getElementById('cat-mobile-q-num');
    var progressBar        = document.getElementById('cat-progress-bar');
    var subtypeBadge       = document.getElementById('cat-subtype-badge');
    var btnFlag            = document.getElementById('btn-cat-flag');
    var flagLabel          = document.getElementById('cat-flag-label');
    var flagIcon           = document.getElementById('cat-flag-icon');
    var answeredCountEl    = document.getElementById('cat-answered-count');
    var promptText         = document.getElementById('cat-prompt-text');
    var stimulusCard       = document.getElementById('cat-stimulus-card');
    var stimulusContainer  = document.getElementById('cat-stimulus-container');
    var optionsGrid        = document.getElementById('cat-options-grid');
    var drillFeedbackBox   = document.getElementById('cat-drill-feedback-box');
    var drillBanner        = document.getElementById('cat-drill-banner');
    var drillIcon          = document.getElementById('cat-drill-icon');
    var drillTitle         = document.getElementById('cat-drill-title');
    var drillExplanation   = document.getElementById('cat-drill-explanation');
    var btnDrillBerikutnya       = document.getElementById('btn-cat-drill-next');
    var btnPrev            = document.getElementById('btn-cat-prev');
    var btnBerikutnya            = document.getElementById('btn-cat-next');
    var btnBerikutnyaText        = document.getElementById('btn-cat-next-text');
    var navigatorStrip     = document.getElementById('cat-navigator-strip');
    var btnSubmit          = document.getElementById('btn-cat-submit');
    var modalSubmit        = document.getElementById('modal-cat-submit');
    var submitSummaryText  = document.getElementById('cat-submit-summary-text');
    var btnConfirmSubmit   = document.getElementById('btn-cat-confirm-submit');
    var btnCancelSubmit    = document.getElementById('btn-cat-cancel-submit');
    var testRunnerRoot     = document.getElementById('test-runner-container');
    var resultsRoot        = document.getElementById('cat-results-container');
    var btnRetake          = document.getElementById('btn-cat-retake');
    var srAnnouncer        = document.getElementById('cat-sr-announcer');

    // Format Time M:SS
    function formatTime(sec) {
      var m = Math.floor(sec / 60);
      var s = sec % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    // Wall-clock synchronization
    function syncTimerFromWallClock() {
      if (currentMode !== 'timed' || !targetEndTime || testSubmitted) return;
      var now = Date.now();
      var remaining = Math.max(0, Math.round((targetEndTime - now) / 1000));
      timeRemaining = remaining;
      if (timerDisplay) timerDisplay.textContent = formatTime(timeRemaining);
      updateTimerStyles(timeRemaining);
      if (timeRemaining <= 0) {
        if (timerInterval) clearInterval(timerInterval);
        finishAssessment();
      }
    }

    function updateTimerStyles(sec) {
      if (!timerContainer) return;
      if (sec <= 60) {
        timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 font-bold';
      } else if (sec <= 180) {
        timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-800 text-amber-600 dark:text-amber-400 font-semibold';
      } else {
        timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200';
      }
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      targetEndTime = Date.now() + timeRemaining * 1000;
      if (timerDisplay) timerDisplay.textContent = formatTime(timeRemaining);
      updateTimerStyles(timeRemaining);
      timerInterval = setInterval(function () {
        if (currentMode !== 'timed') return;
        syncTimerFromWallClock();
        if (timeRemaining % 5 === 0) saveSession();
      }, 1000);
    }

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && currentMode === 'timed') {
        syncTimerFromWallClock();
      }
    });

    window.addEventListener('focus', function () {
      if (currentMode === 'timed') {
        syncTimerFromWallClock();
      }
    });

    // Setup Mode Tabs with safety confirmation to protect psychometric integrity
    function setMode(mode) {
      if (currentMode !== mode && Object.keys(userAnswers).length > 0) {
        var proceed = confirm('Switching modes will reset your current responses for this session. Do you wish to restart in ' + (mode === 'timed' ? 'Timed' : 'Practice Drill') + ' mode?');
        if (!proceed) return;
        userAnswers = {};
        flaggedQuestions = {};
        currentIndex = 0;
        timeRemaining = TOTAL_TIME_SECONDS;
      }

      currentMode = mode;
      clearTimeout(autoAdvanceTimer);

      if (mode === 'timed') {
        modeTabTimed.className = 'flex-1 min-h-[44px] py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 flex items-center justify-center gap-2 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        modeTabPractice.className = 'flex-1 min-h-[44px] py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        modeTabTimed.setAttribute('aria-pressed', 'true');
        modeTabPractice.setAttribute('aria-pressed', 'false');
        activeModeLabel.textContent = 'Asesmen 15 Menit';
        timerContainer.classList.remove('hidden');
        startTimer();
      } else {
        if (timerInterval) clearInterval(timerInterval);
        modeTabPractice.className = 'flex-1 min-h-[44px] py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 flex items-center justify-center gap-2 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        modeTabTimed.className = 'flex-1 min-h-[44px] py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 flex items-center justify-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        modeTabPractice.setAttribute('aria-pressed', 'true');
        modeTabTimed.setAttribute('aria-pressed', 'false');
        activeModeLabel.textContent = 'Practice Drill';
        timerDisplay.textContent = 'Untimed Drill';
      }
      renderCurrentQuestion();
      saveSession();
    }

    if (modeTabTimed) modeTabTimed.addEventListener('click', function () { setMode('timed'); });
    if (modeTabPractice) modeTabPractice.addEventListener('click', function () { setMode('practice'); });

    // Defense-in-depth SVG sanitization helper
    function sanitizeSvg(raw) {
      if (!raw || typeof raw !== 'string') return '';
      return raw
        .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
        .replace(/\bon\w+\s*=\s*(?:'[^']*'|"[^"]*"|[^\s>]+)/gi, '')
        .replace(/javascript:/gi, '');
    }

    // Render Question
    function renderCurrentQuestion() {
      var q = questions[currentIndex];
      if (!q) return;

      if (statCurrent) statCurrent.textContent = String(currentIndex + 1);
      if (mobileQNum) mobileQNum.textContent = String(currentIndex + 1);
      if (progressBar) progressBar.style.width = (((currentIndex + 1) / TOTAL_QUESTIONS) * 100) + '%';
      if (promptText) promptText.textContent = q.promptText;
      if (subtypeBadge) subtypeBadge.textContent = (q.subType || '').replace(/_/g, ' ');

      // Screen reader announcement
      if (srAnnouncer) {
        srAnnouncer.textContent = 'Question ' + (currentIndex + 1) + ' dari ' + TOTAL_QUESTIONS + ': ' + q.promptText;
      }

      // Flag state
      var isFlagged = Boolean(flaggedQuestions[q.id]);
      if (flagLabel) flagLabel.textContent = isFlagged ? 'Flagged' : 'Flag';
      if (btnFlag) {
        if (isFlagged) {
          btnFlag.className = 'min-h-[44px] inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono font-medium border border-amber-400 bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300';
          if (flagIcon) flagIcon.setAttribute('fill', 'currentColor');
        } else {
          btnFlag.className = 'min-h-[44px] inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono font-medium border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:text-amber-600 hover:border-amber-300 transition-colors';
          if (flagIcon) flagIcon.setAttribute('fill', 'none');
        }
      }

      // Stimulus container
      if (stimulusContainer) {
        stimulusContainer.innerHTML = '';
        if (q.promptSvg) {
          stimulusContainer.innerHTML = sanitizeSvg(q.promptSvg);
        }
      }

      // Opsis Rendering
      if (optionsGrid) {
        optionsGrid.innerHTML = '';
        var selectedId = userAnswers[q.id];

        if (!q._shuffledOpsis) {
          q._shuffledOpsis = shuffleOpsis(q.options);
        }
        var displayedOpsis = q._shuffledOpsis;

        displayedOpsis.forEach(function (opt, optIdx) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'relative p-3 sm:p-4 rounded-2xl border transition-all flex flex-col items-center justify-center min-h-[90px] sm:min-h-[110px] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ';

          var isSelected = selectedId === opt.id;

          if (currentMode === 'practice' && selectedId !== undefined) {
            // Practice Drill immediate feedback styling
            var keyInfo = answerKeyMap[q.id];
            var isThisCorrect = keyInfo && opt.id === keyInfo.correctId;
            if (isThisCorrect) {
              btn.className += 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-500 text-emerald-900 dark:text-emerald-100 ring-2 ring-emerald-500 shadow-xs';
            } else if (isSelected && !isThisCorrect) {
              btn.className += 'bg-rose-50 dark:bg-rose-950/40 border-rose-500 text-rose-900 dark:text-rose-100 ring-2 ring-rose-500 shadow-xs';
            } else {
              btn.className += 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-400 dark:text-zinc-600 opacity-60';
            }
          } else {
            // Normal / Timed mode styling
            if (isSelected) {
              btn.className += 'bg-blue-50 dark:bg-blue-950/50 border-blue-600 dark:border-blue-400 text-blue-950 dark:text-white ring-2 ring-blue-600 shadow-sm scale-102';
            } else {
              btn.className += 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-850';
            }
          }

          // Key index badge (Keys 1-N)
          var keyBadge = document.createElement('span');
          keyBadge.className = 'absolute top-2 left-2 text-[10px] font-mono px-1.5 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400';
          keyBadge.textContent = String(optIdx + 1);
          btn.appendChild(keyBadge);

          // Content: SVG or Text
          if (opt.svgContent) {
            var svgWrap = document.createElement('div');
            svgWrap.className = 'w-full flex items-center justify-center max-h-[70px] select-none';
            svgWrap.innerHTML = sanitizeSvg(opt.svgContent);
            btn.appendChild(svgWrap);
          } else {
            var textSpan = document.createElement('span');
            textSpan.className = 'text-sm sm:text-base font-medium';
            textSpan.textContent = opt.text;
            btn.appendChild(textSpan);
          }

          btn.addEventListener('click', function () {
            selectOpsi(opt.id);
          });

          optionsGrid.appendChild(btn);
        });
      }

      // Drill Feedback Display
      if (currentMode === 'practice' && selectedId !== undefined) {
        if (drillFeedbackBox) drillFeedbackBox.classList.remove('hidden');
        var keyInfo = answerKeyMap[q.id];
        var isCorrect = keyInfo && selectedId === keyInfo.correctId;

        if (drillExplanation) drillExplanation.textContent = (keyInfo && keyInfo.explanation) || 'No detailed explanation provided for this item.';

        if (isCorrect) {
          if (drillBanner) drillBanner.className = 'p-4 rounded-2xl border transition-all flex items-start gap-3 bg-emerald-50/80 dark:bg-emerald-950/40 border-emerald-300 dark:border-emerald-800';
          if (drillIcon) {
            drillIcon.className = 'shrink-0 w-7 h-7 rounded-xl flex items-center justify-center mt-0.5 bg-emerald-600 text-white';
            drillIcon.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>';
          }
          if (drillTitle) {
            drillTitle.className = 'font-heading font-bold text-sm sm:text-base mb-1 text-emerald-900 dark:text-emerald-200';
            drillTitle.textContent = 'Deduksi Benar';
          }
        } else {
          if (drillBanner) drillBanner.className = 'p-4 rounded-2xl border transition-all flex items-start gap-3 bg-rose-50/80 dark:bg-rose-950/40 border-rose-300 dark:border-rose-800';
          if (drillIcon) {
            drillIcon.className = 'shrink-0 w-7 h-7 rounded-xl flex items-center justify-center mt-0.5 bg-rose-600 text-white';
            drillIcon.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>';
          }
          if (drillTitle) {
            drillTitle.className = 'font-heading font-bold text-sm sm:text-base mb-1 text-rose-900 dark:text-rose-200';
            drillTitle.textContent = 'Jawaban Kurang Tepat - Tinjau Logika';
          }
        }
      } else {
        if (drillFeedbackBox) drillFeedbackBox.classList.add('hidden');
      }

      // Prev / Berikutnya button states
      if (btnPrev) btnPrev.disabled = currentIndex === 0;
      if (btnBerikutnyaText) btnBerikutnyaText.textContent = currentIndex === TOTAL_QUESTIONS - 1 ? 'Review & Finish' : 'Berikutnya';

      // Sudah dijawab counter
      var ansCount = Object.keys(userAnswers).length;
      if (answeredCountEl) answeredCountEl.textContent = String(ansCount);

      // Navigator strip update
      renderNavigatorStrip();
    }

    // Select Opsi (Debounced with double-guard to eliminate question skipping)
    function selectOpsi(optionId) {
      var q = questions[currentIndex];
      if (!q) return;

      userAnswers[q.id] = optionId;
      saveSession();
      renderCurrentQuestion();

      if (currentMode === 'timed') {
        clearTimeout(autoAdvanceTimer);
        var answeredIdx = currentIndex;
        autoAdvanceTimer = setTimeout(function () {
          if (currentIndex === answeredIdx && currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex++;
            renderCurrentQuestion();
          }
        }, 400);
      }
    }

    // Navigator Strip
    function renderNavigatorStrip() {
      if (!navigatorStrip) return;
      navigatorStrip.innerHTML = '';

      questions.forEach(function (q, idx) {
        var pill = document.createElement('button');
        pill.type = 'button';
        pill.className = 'w-full min-h-[36px] py-1.5 rounded-lg text-xs font-mono font-medium transition-all flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ';
        pill.setAttribute('aria-label', 'Go to item ' + (idx + 1));

        var isCurrent = idx === currentIndex;
        var isAnswered = userAnswers[q.id] !== undefined;
        var isFlagged = Boolean(flaggedQuestions[q.id]);

        if (isCurrent) {
          pill.className += 'bg-blue-600 text-white ring-2 ring-blue-600/30 font-bold scale-105';
        } else if (isFlagged) {
          pill.className += 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300 dark:border-amber-800';
        } else if (isAnswered) {
          if (currentMode === 'practice') {
            var keyInfo = answerKeyMap[q.id];
            var isCorrect = keyInfo && userAnswers[q.id] === keyInfo.correctId;
            if (isCorrect) {
              pill.className += 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-300';
            } else {
              pill.className += 'bg-rose-100 text-rose-900 dark:bg-rose-950/50 dark:text-rose-300 border border-rose-300';
            }
          } else {
            pill.className += 'bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 font-semibold';
          }
        } else {
          pill.className += 'bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-800';
        }

        pill.textContent = String(idx + 1);
        pill.addEventListener('click', function () {
          clearTimeout(autoAdvanceTimer);
          currentIndex = idx;
          renderCurrentQuestion();
        });

        navigatorStrip.appendChild(pill);
      });
    }

    // Toggle Flag
    if (btnFlag) {
      btnFlag.addEventListener('click', function () {
        var q = questions[currentIndex];
        if (!q) return;
        flaggedQuestions[q.id] = !flaggedQuestions[q.id];
        saveSession();
        renderCurrentQuestion();
      });
    }

    // Prev / Berikutnya listeners
    if (btnPrev) {
      btnPrev.addEventListener('click', function () {
        clearTimeout(autoAdvanceTimer);
        if (currentIndex > 0) {
          currentIndex--;
          renderCurrentQuestion();
        }
      });
    }

    if (btnBerikutnya) {
      btnBerikutnya.addEventListener('click', function () {
        clearTimeout(autoAdvanceTimer);
        if (currentIndex < TOTAL_QUESTIONS - 1) {
          currentIndex++;
          renderCurrentQuestion();
        } else {
          showSubmitModal();
        }
      });
    }

    if (btnDrillBerikutnya) {
      btnDrillBerikutnya.addEventListener('click', function () {
        clearTimeout(autoAdvanceTimer);
        if (currentIndex < TOTAL_QUESTIONS - 1) {
          currentIndex++;
          renderCurrentQuestion();
        } else {
          showSubmitModal();
        }
      });
    }

    // Keyboard Shortcuts (1-9 for choices, ArrowLeft/ArrowRight)
    window.addEventListener('keydown', function (e) {
      if (testSubmitted) return;
      if (modalExit && !modalExit.classList.contains('hidden')) {
        if (e.key === 'Escape') closeExitModal();
        return;
      }
      if (modalSubmit && !modalSubmit.classList.contains('hidden')) {
        if (e.key === 'Escape') closeSubmitModal();
        return;
      }

      var num = parseInt(e.key, 10);
      var q = questions[currentIndex];
      if (q && !isNaN(num) && num >= 1 && num <= q.options.length) {
        var opts = q._shuffledOpsis || q.options;
        var opt = opts[num - 1];
        if (opt) selectOpsi(opt.id);
      }

      if (e.key === 'ArrowLeft' && currentIndex > 0) {
        clearTimeout(autoAdvanceTimer);
        currentIndex--;
        renderCurrentQuestion();
      } else if (e.key === 'ArrowRight' && currentIndex < TOTAL_QUESTIONS - 1) {
        clearTimeout(autoAdvanceTimer);
        currentIndex++;
        renderCurrentQuestion();
      }
    });

    // Submit Modal with focus trap and Escape handler
    function showSubmitModal() {
      clearTimeout(autoAdvanceTimer);
      var ansCount = Object.keys(userAnswers).length;
      var unansCount = TOTAL_QUESTIONS - ansCount;

      if (submitSummaryText) {
        if (unansCount === 0) {
          submitSummaryText.textContent = 'Semua 16 soal telah dijawab! Pola respons Anda siap dikalkulasi untuk skor domain psikometri.';
        } else {
          submitSummaryText.textContent = 'Anda telah menjawab ' + ansCount + ' dari ' + TOTAL_QUESTIONS + ' soal (' + unansCount + ' soal belum dijawab). Anda dapat menyelesaikan sekarang atau kembali untuk menjawab soal yang tersisa.';
        }
      }
      if (modalSubmit) {
        modalSubmit.classList.remove('hidden');
        modalSubmit.classList.add('flex');
        if (btnConfirmSubmit) btnConfirmSubmit.focus();
      }
    }

    function closeSubmitModal() {
      if (!modalSubmit) return;
      modalSubmit.classList.add('hidden');
      modalSubmit.classList.remove('flex');
      if (btnSubmit) btnSubmit.focus();
    }

    var modalExit = document.getElementById('modal-exit');
    var btnCloseExitModal = document.getElementById('btn-close-exit-modal');
    var btnModalResume = document.getElementById('btn-modal-resume');
    var btnCloseCatSubmit = document.getElementById('btn-close-cat-submit-modal');

    function closeExitModal() {
      if (!modalExit) return;
      modalExit.classList.add('hidden');
      modalExit.classList.remove('flex');
    }

    if (btnCloseExitModal) btnCloseExitModal.addEventListener('click', closeExitModal);
    if (btnModalResume) btnModalResume.addEventListener('click', closeExitModal);
    if (btnCloseCatSubmit) btnCloseCatSubmit.addEventListener('click', closeSubmitModal);
    if (modalExit) {
      modalExit.addEventListener('click', function (e) {
        if (e.target === modalExit) closeExitModal();
      });
    }

    if (btnSubmit) btnSubmit.addEventListener('click', showSubmitModal);
    if (btnCancelSubmit) btnCancelSubmit.addEventListener('click', closeSubmitModal);
    if (modalSubmit) {
      modalSubmit.addEventListener('click', function (e) {
        if (e.target === modalSubmit) closeSubmitModal();
      });
    }

    if (btnConfirmSubmit) {
      btnConfirmSubmit.addEventListener('click', function () {
        closeSubmitModal();
        finishAssessment();
      });
    }

    // Selesaikan Tes and Render In-Page Results
    function finishAssessment() {
      testSubmitted = true;
      if (timerInterval) clearInterval(timerInterval);
      try { localStorage.removeItem(STORAGE_KEY_SESSION); } catch (e) {}

      var correctCount = 0;
      questions.forEach(function (q) {
        var chosenId = userAnswers[q.id];
        var keyInfo = answerKeyMap[q.id];
        if (keyInfo && chosenId === keyInfo.correctId) {
          correctCount++;
        }
      });

      var accuracyPct = Math.round((correctCount / TOTAL_QUESTIONS) * 100);
      var timeElapsedSec = Math.max(1, TOTAL_TIME_SECONDS - timeRemaining);
      if (currentMode === 'practice') {
        timeElapsedSec = Math.round((Date.now() - startTimeMs) / 1000);
      }

      // Reconstruct scored items for scoring engine and persistence
      var scoredQuestions = questions.map(function (q) {
        var keyInfo = answerKeyMap[q.id];
        var correctId = keyInfo ? keyInfo.correctId : 0;
        return {
          id: q.id,
          domain: q.domain,
          subType: q.subType,
          domainLabel: q.domainLabel,
          promptType: q.promptType,
          promptText: q.promptText,
          promptSvg: q.promptSvg,
          a: q.a,
          b: q.b,
          explanation: keyInfo ? keyInfo.explanation : '',
          options: q.options.map(function (opt) {
            return {
              id: opt.id,
              text: opt.text,
              svgContent: opt.svgContent,
              isCorrect: opt.id === correctId,
            };
          }),
        };
      });

      // Persist category assessment result to profileStore via 2PL/3PL IRT engine
      try {
        if (typeof window.__fiqSaveCategoryAssessment === 'function') {
          window.__fiqSaveCategoryAssessment(config.domain, timeElapsedSec, userAnswers, scoredQuestions);
        } else {
          window.addEventListener('DOMContentLoaded', function () {
            if (typeof window.__fiqSaveCategoryAssessment === 'function') {
              window.__fiqSaveCategoryAssessment(config.domain, timeElapsedSec, userAnswers, scoredQuestions);
            }
          });
        }
      } catch (e) {
        console.warn('[CategoryTestRunner] Assessment persistence failed:', e);
      }

      // Hide runner, show results
      if (testRunnerRoot) testRunnerRoot.classList.add('hidden');
      if (resultsRoot) resultsRoot.classList.remove('hidden');

      // Populate Hero Card
      var resAccuracy = document.getElementById('cat-res-accuracy');
      var resPct      = document.getElementById('cat-res-pct');
      var resTier     = document.getElementById('cat-res-tier');
      var resCorrect  = document.getElementById('cat-res-correct-count');
      var resTime     = document.getElementById('cat-res-time-elapsed');
      var resMode     = document.getElementById('cat-res-mode-name');

      if (resAccuracy) resAccuracy.textContent = correctCount + ' / ' + TOTAL_QUESTIONS;
      if (resPct)      resPct.textContent = '(' + accuracyPct + '%)';
      if (resCorrect)  resCorrect.textContent = String(correctCount);
      if (resTime)     resTime.textContent = formatTime(timeElapsedSec);
      if (resMode)     resMode.textContent = currentMode === 'timed' ? 'Timed 15m' : 'Practice Drill';

      // Tier Badge
      if (resTier) {
        if (accuracyPct >= 83) {
          resTier.textContent = 'Strength Area';
          resTier.className = 'inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800';
        } else if (accuracyPct >= 67) {
          resTier.textContent = 'High Average';
          resTier.className = 'inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-800';
        } else if (accuracyPct >= 50) {
          resTier.textContent = 'Average Range';
          resTier.className = 'inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700';
        } else {
          resTier.textContent = 'Developing Area';
          resTier.className = 'inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800';
        }
      }

      // Populate Accordion
      renderReviewAccordion();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Review Accordion
    function renderReviewAccordion() {
      var list = document.getElementById('cat-review-list');
      if (!list) return;
      list.innerHTML = '';

      questions.forEach(function (q, idx) {
        var chosenId = userAnswers[q.id];
        var keyInfo = answerKeyMap[q.id];
        var isCorrect = keyInfo && chosenId === keyInfo.correctId;

        var card = document.createElement('div');
        card.className = 'rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden';

        // Accordion header button (44px target)
        var headBtn = document.createElement('button');
        headBtn.type = 'button';
        headBtn.className = 'w-full min-h-[44px] px-4 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between gap-3 text-left hover:bg-zinc-50 dark:hover:bg-zinc-850 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';

        var left = document.createElement('div');
        left.className = 'flex items-center gap-3';

        var statusIcon = document.createElement('span');
        statusIcon.className = 'w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0 ' +
          (isCorrect ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' : 'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300');
        statusIcon.textContent = isCorrect ? '✓' : '✗';
        left.appendChild(statusIcon);

        var qTitle = document.createElement('span');
        qTitle.className = 'font-heading font-semibold text-sm sm:text-base text-zinc-900 dark:text-white';
        qTitle.textContent = 'Question ' + (idx + 1) + ' - ' + (q.subType || '').replace(/_/g, ' ');
        left.appendChild(qTitle);

        headBtn.appendChild(left);

        var chevron = document.createElement('span');
        chevron.className = 'text-zinc-400 font-mono text-xs transition-transform duration-200';
        chevron.textContent = '▼';
        headBtn.appendChild(chevron);

        // Accordion content panel
        var panel = document.createElement('div');
        panel.className = 'hidden p-4 sm:p-6 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/40';

        var explanation = document.createElement('p');
        explanation.className = 'text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed';
        explanation.textContent = (keyInfo && keyInfo.explanation) || 'No explanation available.';
        panel.appendChild(explanation);

        headBtn.addEventListener('click', function () {
          var isHidden = panel.classList.contains('hidden');
          panel.classList.toggle('hidden');
          chevron.textContent = isHidden ? '▲' : '▼';
        });

        card.appendChild(headBtn);
        card.appendChild(panel);
        list.appendChild(card);
      });
    }

    // Retake handler
    if (btnRetake) {
      btnRetake.addEventListener('click', function () {
        userAnswers = {};
        flaggedQuestions = {};
        currentIndex = 0;
        timeRemaining = TOTAL_TIME_SECONDS;
        testSubmitted = false;
        startTimeMs = Date.now();
        if (resultsRoot) resultsRoot.classList.add('hidden');
        if (testRunnerRoot) testRunnerRoot.classList.remove('hidden');
        setMode(currentMode);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Initial Start
    setMode(currentMode);
  })();
</script>

<script>
  import { calculateScore } from '../../utils/scoring';
  import { saveAssessmentRecord } from '../../utils/profileStore';
  import type { AssessmentType } from '../../utils/profileStore';
  import type { QuestionItem } from '../../data/questions-id';

  declare global {
    interface Window {
      __fiqSaveCategoryAssessment?: (
        domain: string,
        durationSeconds: number,
        userAnswers: Record<number, number>,
        questions: QuestionItem[]
      ) => void;
    }
  }

  window.__fiqSaveCategoryAssessment = function (domain, durationSeconds, userAnswers, questions) {
    try {
      const scoreResult = calculateScore(userAnswers, questions, 'category');
      const assessmentType = ('category-' + domain) as AssessmentType;

      saveAssessmentRecord({
        assessmentType,
        assessmentVersion: '1.0.0',
        completedAt: new Date().toISOString(),
        durationSeconds,
        rawScore: scoreResult.rawScore,
        totalQuestions: questions.length,
        theta: scoreResult.theta,
        sem: scoreResult.sem,
        iqEstimate: scoreResult.iqEstimate,
        confidenceInterval: scoreResult.confidenceInterval,
        percentile: scoreResult.percentile,
        domainBreakdown: scoreResult.domainBreakdown,
      });
    } catch (err) {
      console.warn('[CategoryTestRunner] Failed to persist assessment record:', err);
    }
  };
</script>
