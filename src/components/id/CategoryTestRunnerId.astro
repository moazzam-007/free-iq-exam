---
import { getDomainTestSetId as getDomainTestSet } from '../../data/questions-id';

export interface Props {
  domain: 'fluid' | 'spatial' | 'quantitative' | 'verbal';
  domainCode: string; // 'Gf', 'Gv', 'Gq', 'Gc'
  domainTitle: string;
  domainSubtitle: string;
  domainDescription: string;
  testDurationMinutes?: number;
  itemCount?: number;
  gradientClass?: string;
  badgeClass?: string;
}

const {
  domain,
  domainCode,
  domainTitle,
  domainSubtitle,
  domainDescription,
  testDurationMinutes = 15,
  itemCount = 16,
  gradientClass = 'from-blue-600 to-indigo-600',
  badgeClass = 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700',
} = Astro.props;

// Fetch 16 items sorted by difficulty ascending
const items = getDomainTestSet(domain, itemCount);

// Sanitize question options passed to client: strip isCorrect and explanation
const clientQuestions = items.map((q) => ({
  id: q.id,
  domain: q.domain,
  subType: q.subType,
  domainLabel: q.domainLabel,
  promptType: q.promptType,
  promptText: q.promptText,
  promptSvg: q.promptSvg ?? null,
  a: q.a,
  b: q.b,
  options: q.options.map((opt) => ({
    id: opt.id,
    text: opt.text ?? '',
    svgContent: opt.svgContent ?? null,
  })),
}));

// Obfuscated scoring answer key token to prevent raw booleans from leaking in HTML options
const answerKeyToken = Buffer.from(
  JSON.stringify(
    items.reduce((acc, q) => {
      const correctOpt = q.options.find((o) => o.isCorrect);
      acc[q.id] = {
        correctId: correctOpt ? correctOpt.id : 1,
        explanation: q.explanation || '',
      };
      return acc;
    }, {} as Record<number, { correctId: number; explanation: string }>)
  )
).toString('base64');

const questionsJson = JSON.stringify(clientQuestions);
const runnerConfig = JSON.stringify({
  domain,
  domainCode,
  domainTitle,
  testDurationMinutes,
  totalQuestions: items.length,
});
---

<div id="category-assessment-root" class="w-full">
  <!-- Mode Selector Tabs -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 mb-6">
    <div class="p-1.5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-center gap-2 max-w-md mx-auto">
      <button
        id="mode-tab-timed"
