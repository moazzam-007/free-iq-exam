---
interface Props {
  currentPath?: string;
  enPath?: string;
}

const { currentPath = Astro.url.pathname, enPath = '/' } = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';
const currentNorm = normalizePath(currentPath);

const isHomeActive = currentNorm === '/id';
const isAssessmentsActive = ['/id/tes', '/id/tes-singkat', '/id/latihan'].some(
  (p) => currentNorm === p || (p !== '/id' && currentNorm.startsWith(p))
);

const isGamesActive = currentNorm === '/id/permainan' || currentNorm.startsWith('/id/permainan/');
const isLeaderboardActive = currentNorm === '/id/papan-peringkat';
const isBlogActive = currentNorm === '/id/blog' || currentNorm.startsWith('/id/blog/');
const isScienceActive = ['/id/tabel-skor-iq', '/id/kalkulator-persentil-iq', '/id/metodologi'].some(
  (p) => currentNorm === p
);

const allMobileLinks = [
  { href: '/id/tes', label: 'Tes IQ Lengkap (20 menit)', badge: 'Resmi', group: 'Asesmen' },
  { href: '/id/tes-singkat', label: 'Skrining Cepat (10 menit)', badge: 'Cepat', group: 'Asesmen' },
  { href: '/id/latihan', label: 'Pusat Latihan (Tanpa Waktu)', badge: '', group: 'Asesmen' },
  { href: '/id/permainan', label: 'Permainan Kognitif', badge: '', group: 'Latihan & Peringkat' },
  { href: '/id/papan-peringkat', label: 'Papan Peringkat Global', badge: '', group: 'Latihan & Peringkat' },
  { href: '/id/profil', label: 'Profil Kognitif Saya', badge: '', group: 'Latihan & Peringkat' },
  { href: '/id/tabel-skor-iq', label: 'Tabel Distribusi Skor IQ', badge: '', group: 'Sains & Referensi' },
  { href: '/id/kalkulator-persentil-iq', label: 'Kalkulator Persentil', badge: '', group: 'Sains & Referensi' },
  { href: '/id/metodologi', label: 'Metodologi Psikometri', badge: '2PL IRT', group: 'Sains & Referensi' },
  { href: '/id/blog', label: 'Artikel Riset & Blog', badge: '', group: 'Sains & Referensi' },
];

const mobileGroups = ['Asesmen', 'Latihan & Peringkat', 'Sains & Referensi'] as const;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/90 dark:bg-zinc-950/85 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-3">
    
    <!-- 1. Logo Brand -->
    <a href="/id" class="flex items-center gap-2.5 group shrink-0" aria-label="Beranda FreeIQExam Indonesia">
      <svg class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 group-hover:scale-105 transition-transform duration-200" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="9.5" r="5.5" class="fill-blue-600 dark:fill-blue-500" />
        <circle cx="8" cy="23" r="4.8" class="fill-blue-700 dark:fill-blue-600" />
        <circle cx="24" cy="23" r="4.8" class="fill-sky-400 dark:fill-sky-400" />
      </svg>
      <span class="font-heading font-extrabold text-xl sm:text-2xl tracking-tight text-zinc-950 dark:text-white leading-tight">
        Free<span class="text-blue-600 dark:text-blue-500">IQ</span>Exam
      </span>
      <span class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-bold uppercase rounded bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-300 ml-1">
        ID
      </span>
    </a>

    <!-- 2. Navigasi Desktop -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-6 text-[13.5px] font-medium" aria-label="Navigasi Utama">
      
      <!-- Beranda -->
      <a
        href="/id"
        class={`py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
          isHomeActive
            ? 'text-blue-600 dark:text-blue-400 font-semibold'
            : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
        }`}
        aria-current={isHomeActive ? 'page' : undefined}
      >
        Beranda
      </a>

      <!-- Dropdown Asesmen -->
      <div class="relative group" id="nav-dropdown-assessments">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
            isAssessmentsActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Asesmen</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-72 p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 shadow-xl shadow-zinc-950/10 dark:shadow-black/40">
            <a
              href="/id/tes-singkat"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                ⚡
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Tes Singkat (10 Menit)
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  12 soal adaptif untuk skrining kognitif cepat
                </div>
              </div>
            </a>

            <a
              href="/id/tes"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                🎯
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Tes Lengkap (20 Menit)
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  24 soal 4 domain CHC berskala psikometri IRT
                </div>
              </div>
            </a>

            <div class="my-1 border-t border-zinc-100 dark:border-zinc-800"></div>

            <a
              href="/id/latihan"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                📚
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Pusat Latihan Mandiri
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Latihan soal santai tanpa batas waktu dan penjelasan
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Permainan -->
      <a
        href="/id/permainan"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isGamesActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isGamesActive ? 'page' : undefined}
      >
        Permainan
      </a>

      <!-- Papan Peringkat -->
      <a
        href="/id/papan-peringkat"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isLeaderboardActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isLeaderboardActive ? 'page' : undefined}
      >
        Peringkat
      </a>

      <!-- Dropdown Sains & Alat -->
      <div class="relative group" id="nav-dropdown-science">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
            isScienceActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Sains &amp; Alat</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-72 p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 shadow-xl shadow-zinc-950/10 dark:shadow-black/40">
            <a
              href="/id/tabel-skor-iq"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                📊
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Tabel Distribusi Skor IQ
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Kurva lonceng Gauss normal &amp; simpangan baku
                </div>
              </div>
            </a>

            <a
              href="/id/kalkulator-persentil-iq"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm font-mono font-bold">
                %
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Kalkulator Persentil
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Konversi skor IQ ke peringkat persentil populasi
                </div>
              </div>
            </a>

            <a
              href="/id/metodologi"
              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/80 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 flex items-center justify-center shrink-0 mt-0.5 text-sm">
                🔬
              </div>
              <div>
                <div class="font-semibold text-zinc-900 dark:text-white text-xs sm:text-sm group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                  Metodologi Psikometri
                </div>
                <div class="text-[11.5px] text-zinc-500 dark:text-zinc-400 leading-snug">
                  Kalibrasi 2PL IRT &amp; kerangka teori CHC
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a
        href="/id/blog"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isBlogActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isBlogActive ? 'page' : undefined}
      >
        Blog
      </a>

    </nav>

    <!-- 3. Klaster Aksi Kanan -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      
      <!-- Language Capsule Switcher (EN | ID) -->
      <div class="inline-flex items-center rounded-lg bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 p-0.5 text-xs font-semibold shadow-xs">
        <a
          href={enPath}
          class="px-2 py-1 rounded text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors"
          title="Switch to English"
        >
          EN
        </a>
        <span class="px-2 py-1 rounded bg-blue-600 text-white shadow-xs font-bold">
          ID
        </span>
      </div>

      <!-- Tombol Toggle Tema -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer"
        aria-label="Alihkan tema gelap dan terang"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <svg class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
        </svg>
      </button>

      <!-- Tombol Profil Pengguna -->
      <a
        href="/id/profil"
        class={`w-9 h-9 sm:w-10 sm:h-10 rounded-xl hidden sm:flex items-center justify-center bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ${
          currentNorm === '/id/profil' ? 'text-blue-600 dark:text-blue-400 border-blue-300 dark:border-blue-800' : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
        }`}
        title="Profil Kognitif &amp; Riwayat Skor Saya"
        aria-label="Profil Kognitif Saya"
      >
        <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      </a>

      <!-- Kapsul Tombol Aksi CTA -->
      <div class="hidden sm:inline-flex items-center bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/90 dark:border-zinc-800 rounded-full p-[3px] shadow-xs">
        <a
          href="/id/tes-singkat"
          class="px-3 py-1.5 rounded-full text-xs font-semibold text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white transition-colors flex items-center gap-1 whitespace-nowrap"
          title="Skrining adaptif 12 soal"
        >
          <span class="text-amber-500 font-bold">⚡</span>
          <span>Singkat 10m</span>
        </a>
        <a
          href="/id/tes"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white shadow-xs shadow-blue-500/20 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-1 whitespace-nowrap"
          title="Tes klinis 24 soal"
        >
          <span>Tes Lengkap</span>
          <span class="font-mono">→</span>
        </a>
      </div>

      <!-- Tombol Menu Seluler (Hamburger) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-label="Buka menu navigasi"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

    </div>

  </div>
</header>

<!-- Backdrop Menu Seluler -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-black/50 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none hidden"
  aria-hidden="true"
></div>

<!-- Laci Menu Seluler -->
<div
  id="mobile-drawer"
  class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-white dark:bg-zinc-950 border-l border-zinc-200 dark:border-zinc-800 z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-2xl"
  aria-label="Menu Seluler"
  role="dialog"
  aria-modal="true"
  tabindex="-1"
>
  <div class="p-4 border-b border-zinc-100 dark:border-zinc-900 flex items-center justify-between">
    <span class="font-heading font-bold text-base text-zinc-900 dark:text-white">Menu Navigasi</span>
    <button
      id="mobile-menu-close"
      type="button"
      class="p-2 rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
      aria-label="Tutup menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto p-4 space-y-6">
    <!-- Language Capsule in Drawer -->
    <div class="flex items-center justify-between p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800">
      <span class="text-xs font-semibold text-zinc-700 dark:text-zinc-300">Pilih Bahasa</span>
      <div class="inline-flex items-center rounded-lg bg-zinc-200/70 dark:bg-zinc-800 p-0.5 text-xs font-semibold">
        <a href={enPath} class="px-2.5 py-1 rounded text-zinc-600 dark:text-zinc-400">English</a>
        <span class="px-2.5 py-1 rounded bg-blue-600 text-white font-bold">Indonesia</span>
      </div>
    </div>

    <!-- Group Links -->
    {mobileGroups.map((group) => (
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-2 px-2">
          {group}
        </h3>
        <div class="space-y-1">
          {allMobileLinks
            .filter((l) => l.group === group)
            .map((link) => (
              <a
                href={link.href}
                class={`flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-colors ${
                  currentNorm === link.href
                    ? 'bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 font-semibold'
                    : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900'
                }`}
              >
                <span>{link.label}</span>
                {link.badge && (
                  <span class="px-1.5 py-0.5 text-[10px] font-bold uppercase rounded bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                    {link.badge}
                  </span>
                )}
              </a>
            ))}
        </div>
      </div>
    ))}
  </div>

  <div class="p-4 border-t border-zinc-100 dark:border-zinc-900 bg-zinc-50/50 dark:bg-zinc-900/40">
    <a
      href="/id/tes"
      class="w-full py-2.5 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-sm transition-colors"
    >
      <span>Mulai Tes IQ Lengkap</span>
      <span class="font-mono">→</span>
    </a>
  </div>
</div>

<script is:inline>
  (function() {
    // Theme toggle
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.addEventListener('click', function() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    // Mobile menu drawer
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    function openMenu() {
      if (!drawer || !backdrop) return;
      backdrop.classList.remove('hidden');
      requestAnimationFrame(function() {
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        drawer.classList.remove('translate-x-full');
      });
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!drawer || !backdrop) return;
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0');
      drawer.classList.add('translate-x-full');
      setTimeout(function() {
        backdrop.classList.add('hidden');
      }, 300);
      if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
    }

    if (menuBtn) menuBtn.addEventListener('click', openMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (backdrop) backdrop.addEventListener('click', closeMenu);
  })();
</script>
