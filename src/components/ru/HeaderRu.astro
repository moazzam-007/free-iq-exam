---
interface Props {
  currentPath?: string;
  enPath?: string;
  idPath?: string;
  ruPath?: string;
}

const { currentPath = Astro.url.pathname, enPath, idPath, ruPath } = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';
const currentNorm = normalizePath(currentPath);
// Strip /ru prefix for active-state comparison so /ru/test matches /test rules
const basePath = currentNorm.replace(/^\/ru(?=\/|$)/, '') || '/';

const isHomeActive = basePath === '/';
const isTestsActive = [
  '/test',
  '/quick-test',
  '/practice',
  '/color-blind-test',
  '/reaction-time-test',
  '/adhd-test',
  '/depression-test',
  '/anxiety-test',
  '/autism-test',
  '/hearing-test',
  '/eye-test',
].some((p) => basePath === p || (p !== '/' && basePath.startsWith(p)));

const isGamesActive =
  basePath === '/games' ||
  basePath.startsWith('/games/') ||
  basePath === '/typing-test' ||
  basePath === '/aim-trainer' ||
  basePath === '/flag-quiz';

const isToolsActive = [
  '/tools',
  '/sleep-calculator',
  '/brown-noise',
  '/calorie-calculator',
  '/mic-test',
  '/memento-mori',
  '/circle-of-control',
  '/iq-score-chart',
  '/iq-percentile-calculator',
  '/methodology',
].some((p) => basePath === p || (p !== '/' && basePath.startsWith(p)));

const isLeaderboardActive = basePath === '/leaderboard';
const isBlogActive =
  basePath === '/blog' || basePath.startsWith('/blog/');

// Language switcher targets (explicit props win, else 1:1 slug mapping)
const pathWithoutLang = currentNorm.replace(/^\/ru(?=\/|$)/, '') || '/';

const enHref = enPath
  ? enPath
  : pathWithoutLang === '/'
    ? '/'
    : pathWithoutLang;

const idHref = idPath
  ? idPath === '/'
    ? '/id'
    : idPath.startsWith('/id')
      ? idPath
      : `/id${idPath}`
  : pathWithoutLang === '/'
    ? '/id'
    : `/id${pathWithoutLang}`;

const ruHref = ruPath
  ? ruPath === '/'
    ? '/ru'
    : ruPath.startsWith('/ru')
      ? ruPath
      : `/ru${ruPath}`
  : currentNorm.startsWith('/ru')
    ? currentNorm
    : currentNorm === '/'
      ? '/ru'
      : `/ru${currentNorm}`;

const activeLangCode = 'RU';

const mobileAccordionSections = [
  {
    id: 'assessments',
    iconKey: 'folder',
    title: 'Оценки и тесты',
    description: 'Клиническая и сенсорная диагностика',
    links: [
      { href: '/ru/test', label: 'Полный тест (20 мин)', badge: 'Official', desc: '24 вопроса по 4 доменам CHC', iconKey: 'target' },
      { href: '/ru/quick-test', label: 'Экспресс-тест (10 мин)', badge: 'Fast', desc: '12 калиброванных вопросов', iconKey: 'bolt' },
      { href: '/ru/practice', label: 'Практический центр', badge: '', desc: 'Тренировки по доменам без учета времени', iconKey: 'puzzle' },
      { href: '/ru/color-blind-test', label: 'Тест на цветослепоту', badge: 'New', desc: '22 таблицы Исихары', iconKey: 'eye' },
      { href: '/ru/reaction-time-test', label: 'Тест времени реакции', badge: 'New', desc: 'Скорость реакции в миллисекундах', iconKey: 'timer' },
      { href: '/ru/adhd-test', label: 'Тест на СДВГ', badge: 'New', desc: 'Скрининг ASRS v1.1 (ВОЗ)', iconKey: 'brain' },
      { href: '/ru/depression-test', label: 'Тест на депрессию (PHQ-9)', badge: 'New', desc: 'Клинический тест (PHQ-9)', iconKey: 'clipboard' },
      { href: '/ru/anxiety-test', label: 'Тест на тревожность (GAD-7)', badge: 'New', desc: 'Клинический тест (GAD-7)', iconKey: 'shield' },
      { href: '/ru/autism-test', label: 'Тест на аутизм (AQ-10)', badge: 'New', desc: 'Скрининг AQ-10 с профилем черт', iconKey: 'infinity' },
      { href: '/ru/hearing-test', label: 'Тест слуха', badge: 'New', desc: 'Проверка слуха 20 Гц – 20 кГц', iconKey: 'sound' },
      { href: '/ru/eye-test', label: 'Тест зрения', badge: 'New', desc: 'Таблица Снеллена для остроты зрения', iconKey: 'glasses' },
    ],
  },
  {
    id: 'games',
    iconKey: 'gamepad',
    title: 'Тренировки и рейтинг',
    description: 'Когнитивные игры и рейтинг',
    links: [
      { href: '/ru/typing-test', label: 'Тест скорости печати', badge: 'New', desc: 'Скорость печати (WPM) и точность', iconKey: 'keyboard' },
      { href: '/ru/flag-quiz', label: 'Тест на знание флагов', badge: 'New', desc: 'Географическая память по 195+ странам', iconKey: 'flag' },
      { href: '/ru/games/click-speed-test', label: 'Тест скорости кликов (CPS)', badge: 'New', desc: 'Клики в секунду (CPS)', iconKey: 'mouse' },
      { href: '/ru/aim-trainer', label: 'FPS-тренажёр аима', badge: 'New', desc: 'Точность мыши и скорость реакции', iconKey: 'crosshair' },
      { href: '/ru/games', label: 'Все когнитивные игры', badge: 'Hub', desc: 'Игры на память, скорость и логику', iconKey: 'gamepad' },
      { href: '/ru/leaderboard', label: 'Таблица лидеров', badge: '', desc: 'Сравнение процентилей участников', iconKey: 'trophy' },
    ],
  },
  {
    id: 'tools',
    iconKey: 'tools',
    title: 'Наука и справка',
    description: 'Методология, статистика и блог',
    links: [
      { href: '/ru/sleep-calculator', label: 'Калькулятор сна', badge: 'New', desc: 'Циклы сна и хронотип', iconKey: 'moon' },
      { href: '/ru/brown-noise', label: 'Генератор коричневого шума', badge: 'New', desc: 'Звуки для сна и фокуса', iconKey: 'headphones' },
      { href: '/ru/calorie-calculator', label: 'Калькулятор калорий', badge: 'New', desc: 'Расчёт BMR, дефицита и БЖУ', iconKey: 'flame' },
      { href: '/ru/mic-test', label: 'Проверка микрофона', badge: 'New', desc: 'Спектрограмма частот', iconKey: 'mic' },
      { href: '/ru/memento-mori', label: 'Memento Mori', badge: 'New', desc: 'Календарь жизни в 4 000 недель', iconKey: 'calendar' },
      { href: '/ru/circle-of-control', label: 'Круг контроля', badge: 'New', desc: 'Стоический инструмент ясности', iconKey: 'circle' },
      { href: '/ru/iq-score-chart', label: 'График распределения баллов', badge: '', desc: 'Гауссова кривая и стандартные отклонения', iconKey: 'chart' },
      { href: '/ru/iq-percentile-calculator', label: 'Калькулятор процентилей', badge: '', desc: 'Преобразование сырого балла IQ в процентиль', iconKey: 'percent' },
      { href: '/ru/methodology', label: 'Психометрическая методология', badge: '2PL IRT', desc: 'Калибровка по современной теории тестов', iconKey: 'microscope' },
      { href: '/ru/blog', label: 'Блог', badge: '', desc: 'Психометрика и когнитивная наука', iconKey: 'book' },
      { href: '/ru/profile', label: 'Мой когнитивный профиль', badge: '', desc: 'История тестов и радарная диаграмма', iconKey: 'user' },
