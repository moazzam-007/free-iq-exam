---
interface Props {
  currentPath?: string;
  enPath?: string;
  idPath?: string;
  ruPath?: string;
}

const { currentPath = Astro.url.pathname, enPath, idPath, ruPath } = Astro.props;

const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';
const currentNorm = normalizePath(currentPath);
// Strip /ru prefix for active-state comparison so /ru/test matches /test rules
const basePath = currentNorm.replace(/^\/ru(?=\/|$)/, '') || '/';

const isГлавнаяActive = basePath === '/';
const isОценкиActive = ['/test', '/quick-test', '/practice'].some(
  (p) => basePath === p || (p !== '/' && basePath.startsWith(p))
);

const isИгрыActive = basePath === '/games' || basePath.startsWith('/games/');
const isLeaderboardActive = basePath === '/leaderboard';
const isБлогActive = basePath === '/blog' || basePath.startsWith('/blog/');
const isScienceActive = ['/iq-score-chart', '/iq-percentile-calculator', '/methodology'].some(
  (p) => basePath === p
);

// Language capsule switcher targets (explicit props win, else 1:1 slug mapping)
const _pathWithoutLang = currentNorm.replace(/^\/ru(?=\/|$)/, '') || '/';

const resolvedEnHref = enPath
  ? enPath
  : _pathWithoutLang === '/'
    ? '/'
    : _pathWithoutLang;

const resolvedIdHref = idPath
  ? idPath === '/'
    ? '/id'
    : idPath.startsWith('/id')
      ? idPath
      : `/id${idPath}`
  : _pathWithoutLang === '/'
    ? '/id'
    : `/id${_pathWithoutLang}`;

const resolvedRuHref = ruPath
  ? ruPath === '/'
    ? '/ru'
    : ruPath.startsWith('/ru')
      ? ruPath
      : `/ru${ruPath}`
  : currentNorm.startsWith('/ru')
    ? currentNorm
    : currentNorm === '/'
      ? '/ru'
      : `/ru${currentNorm}`;

const mobileAccordionSections = [
  {
    id: "assessments",
    iconKey: "folder",
    title: "Оценки и тесты",
    description: "Клиническая и сенсорная диагностика",
    links: [
      {
        href: "/ru/test",
        label: "Полный тест на IQ (20 мин)",
        badge: "Official",
        desc: "24 вопроса по 4 калиброванным доменам CHC",
        iconKey: "target",
      },
      {
        href: "/ru/quick-test",
        label: "Экспресс-тест (10 мин)",
        badge: "Fast",
        desc: "12 калиброванных вопросов для быстрой оценки",
        iconKey: "bolt",
      },
      {
        href: "/ru/practice",
        label: "Практический центр",
        badge: "",
        desc: "Тренировки по доменам без учета времени",
        iconKey: "puzzle",
      },
    ],
  },
  {
    id: "games",
    iconKey: "gamepad",
    title: "Тренировки и рейтинг",
    description: "Когнитивные игры и рейтинг",
    links: [
      {
        href: "/ru/games",
        label: "Когнитивные игры",
        badge: "Hub",
        desc: "Игры на память, скорость и логику",
        iconKey: "gamepad",
      },
      {
        href: "/ru/leaderboard",
        label: "Глобальная таблица лидеров",
        badge: "",
        desc: "Сравнение процентилей участников",
        iconKey: "trophy",
      },
      {
        href: "/ru/profile",
        label: "Мой когнитивный профиль",
        badge: "",
        desc: "История тестов и радарная диаграмма",
        iconKey: "user",
      },
    ],
  },
  {
    id: "science",
    iconKey: "tools",
    title: "Наука и справка",
    description: "Методология, статистика и блог",
    links: [
      {
        href: "/ru/iq-score-chart",
        label: "График распределения баллов",
        badge: "",
        desc: "Гауссова кривая и стандартные отклонения",
        iconKey: "chart",
      },
      {
        href: "/ru/iq-percentile-calculator",
        label: "Калькулятор процентилей",
        badge: "",
        desc: "Преобразование сырого балла IQ в процентиль",
        iconKey: "percent",
      },
      {
        href: "/ru/methodology",
        label: "Психометрическая методология",
        badge: "2PL IRT",
        desc: "Калибровка по современной теории тестов",
        iconKey: "microscope",
      },
      {
        href: "/ru/blog",
        label: "Исследовательские статьи",
        badge: "",
        desc: "Психометрика и когнитивная наука",
        iconKey: "book",
      },
    ],
  },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/90 dark:bg-zinc-950/85 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- 1. Brand Logo: Minimalist 3-Dot Cognitive Mark + Wordmark -->
    <a href="/ru/" class="flex items-center gap-2.5 group shrink-0" aria-label="FreeIQExam Главная">
      <svg class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 group-hover:scale-105 transition-transform duration-200" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="16" cy="9.5" r="5.5" class="fill-blue-600 dark:fill-blue-500" />
        <circle cx="8" cy="23" r="4.8" class="fill-blue-700 dark:fill-blue-600" />
        <circle cx="24" cy="23" r="4.8" class="fill-sky-400 dark:fill-sky-400" />
      </svg>
      <span class="font-heading font-extrabold text-xl sm:text-2xl tracking-tight text-zinc-950 dark:text-white leading-tight">
        Free<span class="text-blue-600 dark:text-blue-500">IQ</span>Exam
      </span>
      <span class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono font-bold uppercase rounded border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400 ml-0.5">
        RU
      </span>
    </a>

    <!-- 2. Center Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-7 text-[13.5px] font-medium" aria-label="Primary Navigation">
      
      <!-- Link: Главная -->
      <a
        href="/ru/"
        class={`py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
          isГлавнаяActive
            ? 'text-blue-600 dark:text-blue-400 font-semibold'
            : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
        }`}
        aria-current={isГлавнаяActive ? 'page' : undefined}
      >
        Главная
      </a>

      <!-- Dropdown 1: Оценки ▾ -->
      <div class="relative group" id="nav-dropdown-assessments">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md cursor-pointer ${
            isОценкиActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Оценки</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Оценки Flyout Menu -->
        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-80 p-2 rounded-2xl bg-white/95 dark:bg-[#0c0d12]/95 backdrop-blur-2xl border border-zinc-200/80 dark:border-white/10 shadow-2xl shadow-black/10 dark:shadow-black/60">
            <div class="px-3 pt-2 pb-1.5 text-[11px] font-mono font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 border-b border-zinc-100 dark:border-white/5 mb-1.5">
              Диагностика интеллекта
            </div>
            <div class="space-y-0.5">
              <a
                href="/ru/test"
                class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] transition-colors duration-150 group/item cursor-pointer"
              >
                <div class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-white/[0.05] border border-zinc-200/60 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-zinc-600 dark:text-zinc-400 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[13.5px] font-medium text-zinc-900 dark:text-zinc-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Полный экзамен (20 мин)
                    </span>
                    <span class="px-1.5 py-0.5 rounded-md border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono text-[10px] font-medium tracking-wide uppercase">Official</span>
                  </div>
                  <div class="text-[12px] text-zinc-500 dark:text-zinc-400 leading-snug font-normal mt-0.5 line-clamp-1">
                    24 вопроса по 4 доменам CHC
                  </div>
                </div>
              </a>

              <a
                href="/ru/quick-test"
                class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] transition-colors duration-150 group/item cursor-pointer"
              >
                <div class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-white/[0.05] border border-zinc-200/60 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-zinc-600 dark:text-zinc-400 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[13.5px] font-medium text-zinc-900 dark:text-zinc-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Экспресс-тест (10 мин)
                    </span>
                    <span class="px-1.5 py-0.5 rounded-md border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono text-[10px] font-medium tracking-wide uppercase">Fast</span>
                  </div>
                  <div class="text-[12px] text-zinc-500 dark:text-zinc-400 leading-snug font-normal mt-0.5 line-clamp-1">
                    12 калиброванных вопросов
                  </div>
                </div>
              </a>
            </div>

            <!-- Footer Dock: Practice Hub -->
            <div class="mt-1.5 pt-2 border-t border-zinc-100 dark:border-white/5">
              <a
                href="/ru/practice"
                class="flex items-center justify-between px-3 py-2 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors group/dock"
              >
                <span class="flex items-center gap-2.5">
                  <span class="w-5 h-5 rounded flex items-center justify-center text-zinc-400 group-hover/dock:text-blue-600 dark:group-hover/dock:text-blue-400 transition-colors">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/>
                    </svg>
                  </span>
                  <span class="font-medium text-zinc-800 dark:text-zinc-200 group-hover/dock:text-blue-600 dark:group-hover/dock:text-blue-400 transition-colors">Практический центр</span>
                </span>
                <span class="text-zinc-400 dark:text-zinc-500 font-mono text-xs group-hover/dock:text-blue-600 dark:group-hover/dock:text-blue-400 transition-colors">Перейти →</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Когнитивные игры -->
      <a
        href="/ru/games"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isИгрыActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isИгрыActive ? 'page' : undefined}
      >
        Когнитивные игры
      </a>

      <!-- Таблица лидеров -->
      <a
        href="/ru/leaderboard"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isLeaderboardActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isLeaderboardActive ? 'page' : undefined}
      >
        Таблица лидеров
      </a>

      <!-- Dropdown 2: Наука и инструменты ▾ -->
      <div class="relative group" id="nav-dropdown-science">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md cursor-pointer ${
            isScienceActive
              ? 'text-blue-600 dark:text-blue-400 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Наука и инструменты</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <!-- Science Flyout Menu -->
        <div class="absolute top-full left-0 pt-2 opacity-0 translate-y-1.5 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
          <div class="w-80 p-2 rounded-2xl bg-white/95 dark:bg-[#0c0d12]/95 backdrop-blur-2xl border border-zinc-200/80 dark:border-white/10 shadow-2xl shadow-black/10 dark:shadow-black/60">
            <div class="px-3 pt-2 pb-1.5 text-[11px] font-mono font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 border-b border-zinc-100 dark:border-white/5 mb-1.5">
              Психометрика и калькуляторы
            </div>
            <div class="space-y-0.5">
              <a
                href="/ru/iq-score-chart"
                class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] transition-colors duration-150 group/item cursor-pointer"
              >
                <div class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-white/[0.05] border border-zinc-200/60 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-zinc-600 dark:text-zinc-400 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[13.5px] font-medium text-zinc-900 dark:text-zinc-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      График распределения баллов
                    </span>
                  </div>
                  <div class="text-[12px] text-zinc-500 dark:text-zinc-400 leading-snug font-normal mt-0.5 line-clamp-1">
                    Гауссова кривая и отклонения
                  </div>
                </div>
              </a>

              <a
                href="/ru/iq-percentile-calculator"
                class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] transition-colors duration-150 group/item cursor-pointer"
              >
                <div class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-white/[0.05] border border-zinc-200/60 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-zinc-600 dark:text-zinc-400 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[13.5px] font-medium text-zinc-900 dark:text-zinc-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Калькулятор процентилей
                    </span>
                  </div>
                  <div class="text-[12px] text-zinc-500 dark:text-zinc-400 leading-snug font-normal mt-0.5 line-clamp-1">
                    Преобразование сырого балла IQ
                  </div>
                </div>
              </a>

              <a
                href="/ru/methodology"
                class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-zinc-100/70 dark:hover:bg-white/[0.06] transition-colors duration-150 group/item cursor-pointer"
              >
                <div class="w-7 h-7 rounded-lg bg-zinc-100 dark:bg-white/[0.05] border border-zinc-200/60 dark:border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-zinc-600 dark:text-zinc-400 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 group-hover/item:border-blue-500/30 transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0-7-7h1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[13.5px] font-medium text-zinc-900 dark:text-zinc-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                      Научная методология
                    </span>
                    <span class="px-1.5 py-0.5 rounded-md border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-zinc-800/60 font-mono text-[10px] font-medium text-zinc-500 dark:text-zinc-400 tracking-wide uppercase">2PL IRT</span>
                  </div>
                  <div class="text-[12px] text-zinc-500 dark:text-zinc-400 leading-snug font-normal mt-0.5 line-clamp-1">
                    Калибровка 2PL IRT и валидность
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Standalone Блог -->
      <a
        href="/ru/blog"
        class={`py-2 transition-colors hover:text-zinc-950 dark:hover:text-white ${
          isБлогActive ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-zinc-600 dark:text-zinc-300'
        }`}
        aria-current={isБлогActive ? 'page' : undefined}
      >
        Блог
      </a>

    </nav>

    <!-- 3. Right Action Cluster: Language Switcher + Theme Button + Profile Button + Segmented CTA Capsule -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <!-- Language capsule switcher EN | ID | RU -->
      <div
        class="inline-flex items-center rounded-xl bg-zinc-100/90 dark:bg-white/[0.05] border border-zinc-200/80 dark:border-white/10 p-0.5 text-xs font-semibold shadow-2xs"
        aria-label="Выбор языка"
      >
        <a
          href={resolvedEnHref}
          hreflang="en"
          class="px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors"
          title="Switch to English"
        >
          EN
        </a>
        <a
          href={resolvedIdHref}
          hreflang="id"
          class="px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-colors"
          title="Beralih ke Bahasa Indonesia"
        >
          ID
        </a>
        <span
          class="px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-lg bg-white dark:bg-white/[0.12] text-blue-600 dark:text-blue-400 shadow-xs font-bold"
          title="Русский (активен)"
        >
          RU
        </span>
      </div>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-btn"
