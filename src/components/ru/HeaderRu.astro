---

<header
  class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/90 dark:bg-zinc-950/85 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors duration-200"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4"
  >
    <!-- 1. Brand Logo: Minimalist 3-Dot Cognitive Mark + Wordmark -->
    <a
      href="/ru/"
      class="flex items-center gap-2.5 group shrink-0 transition-opacity duration-200 hover:opacity-90 active:scale-[0.98]"
      aria-label="FreeIQExam Главная"
    >
      <svg
        class="w-8 h-8 sm:w-9 sm:h-9 shrink-0"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <circle
          cx="16"
          cy="9.5"
          r="5.5"
          class="fill-blue-600 dark:fill-blue-500"></circle>
        <circle cx="8" cy="23" r="4.8" class="fill-blue-700 dark:fill-blue-600"
        ></circle>
        <circle cx="24" cy="23" r="4.8" class="fill-sky-400 dark:fill-sky-400"
        ></circle>
      </svg>
      <span
        class="font-heading font-extrabold text-xl sm:text-2xl tracking-tight text-zinc-950 dark:text-white leading-tight"
      >
        Free<span class="text-blue-600 dark:text-blue-500">IQ</span>Exam
      </span>
    </a>

    <!-- 2. Center Desktop Navigation Links (3 Core Dropdowns: Tests, Games, Tools) -->
    <nav
      class="hidden lg:flex items-center gap-5 xl:gap-7 text-[13.5px] font-medium"
      aria-label="Primary Navigation"
    >
      <!-- Link: Home -->
      <a
        href="/ru/"
        class={`py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md ${
          isHomeActive
            ? "text-blue-600 dark:text-blue-400 font-semibold"
            : "text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white"
        }`}
        aria-current={isHomeActive ? "page" : undefined}
      >
        Главная
      </a>

      <!-- Dropdown 1: Tests ▾ (Клиническая и сенсорная диагностика) -->
      <div class="relative group" id="nav-dropdown-tests">
        <button
          type="button"
          class={`flex items-center gap-1.5 py-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md cursor-pointer ${
            isTestsActive
              ? "text-blue-600 dark:text-blue-400 font-semibold"
              : "text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white"
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Тесты</span>
          <svg
            class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:rotate-180 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 8.25l-7.5 7.5-7.5-7.5"
            ></path>
          </svg>
        </button>

        <!-- Tests Flyout Menu (2-Column Apple Frosted Glass Grid) -->
