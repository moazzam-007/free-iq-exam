---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  // Map of locale -> relative or absolute path
  // e.g. { 'id': '/id/tes-buta-warna', 'fi': '/fi/varinakotesti', 'de': '/de/farbsehtest' }
  alternates?: Record<string, string>;
  idPath?: string;
  ruPath?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
  lang?: string;
}

const {
  title = "Free IQ Test 2026: Instant Results, No Email Required",
  description = "Take our fast, free IQ test with instant, reliable results. 24 reasoning items, standardized IQ-scale estimate and percentile breakdown. 100% free, no sign-up or credit card.",
  canonicalUrl,
  alternates,
  idPath,
  ruPath,
  ogImage = "/og-image.png",
  noindex = false,
  schema,
  lang = "en",
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, siteOrigin).href;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).href;

// Normalization helper
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';

// Legacy routes that have verified full Indonesian and Russian localizations
const LEGACY_LOCALIZED_PATHS = new Set([
  '/',
  '/test',
  '/quick-test',
  '/results',
  '/practice',
  '/methodology',
  '/about',
  '/contact',
  '/privacy',
  '/terms',
  '/blog',
  '/iq-score-chart',
  '/iq-classification-scale',
  '/iq-percentile-calculator',
  '/average-iq-by-age',
  '/high-iq-societies',
  '/mensa-iq-test-practice',
  '/matrix-reasoning-test',
  '/spatial-reasoning-test',
  '/quantitative-reasoning-test',
  '/verbal-reasoning-test',
  '/fluid-reasoning-test',
  '/games',
  '/games/digit-span',
  '/games/flanker-test',
  '/games/memory-matrix',
  '/games/rotation',
  '/games/stroop-clash',
  '/games/symbol-match',
  '/games/syllogism',
  '/games/sequence-rush',
  '/games/math-sprint',
  '/games/n-back',
  '/leaderboard',
  '/profile',
]);

// Dynamic reciprocal alternates map
const computedAlternates: Record<string, string> = {};

if (alternates) {
  // Explicit alternates take highest priority
  for (const [locale, path] of Object.entries(alternates)) {
    if (path) computedAlternates[locale] = path;
  }
} else {
  // Backwards-compatibility for explicit idPath or ruPath props
  if (idPath) computedAlternates['id'] = idPath;
  if (ruPath) computedAlternates['ru'] = ruPath;

  // Gracefully maintain legacy mappings ONLY for verified routes
  if (LEGACY_LOCALIZED_PATHS.has(normalizedPath)) {
    if (!computedAlternates['id']) {
      computedAlternates['id'] = normalizedPath === '/' ? '/id/' : `/id${normalizedPath}`;
    }
    if (!computedAlternates['ru']) {
      computedAlternates['ru'] = normalizedPath === '/' ? '/ru/' : `/ru${normalizedPath}`;
    }
  }
}

// Format resolved hrefs (relative -> absolute)
const formatHref = (pathOrUrl: string) => {
  if (pathOrUrl.startsWith('http://') || pathOrUrl.startsWith('https://')) {
    return pathOrUrl;
  }
  const cleanPath = pathOrUrl.startsWith('/') ? pathOrUrl : `/${pathOrUrl}`;
  return `${siteOrigin}${cleanPath}`;
};

const alternateEntries = Object.entries(computedAlternates)
  .filter(([locale]) => locale !== lang && locale !== 'x-default')
  .map(([locale, targetPath]) => ({
    locale,
    href: formatHref(targetPath),
  }));

const publicGaId = import.meta.env.PUBLIC_GA_ID;
const publicAdsensePubId = import.meta.env.PUBLIC_ADSENSE_PUB_ID;
---

<!doctype html>
<html lang={lang} class="scroll-smooth no-transitions">
  <head>
    <!-- Theme Initialization Script: Executed immediately before rendering to eliminate FOUC -->
    <script is:inline>
      (function() {
        try {
          var savedTheme = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
        window.addEventListener('DOMContentLoaded', function() {
          requestAnimationFrame(function() {
            document.documentElement.classList.remove('no-transitions');
          });
        });
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Search Engine Verification -->
    <meta name="msvalidate.01" content="C2DBC1FA32C5B57B6FE8E77D67B72F99" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Reciprocal Hreflang Tags -->
    <link rel="alternate" hreflang={lang} href={resolvedCanonical} />
    <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />
    {alternateEntries.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FreeIQExam" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={resolvedCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />
    <meta property="twitter:image:alt" content={title} />

    <!-- Schema.org JSON-LD Structured Data -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Analytics: Google Analytics 4 (guarded by PUBLIC_GA_ID) -->
    {publicGaId && publicGaId !== 'G-XXXXXXXXXX' && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${publicGaId}`}></script>
        <script is:inline define:vars={{ gaId: publicGaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Google AdSense (guarded by PUBLIC_ADSENSE_PUB_ID) -->
    {publicAdsensePubId && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${publicAdsensePubId}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen bg-white text-zinc-900 dark:bg-black dark:text-zinc-50 font-sans antialiased flex flex-col selection:bg-blue-600 selection:text-white">
    <!-- Accessible Skip Link (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-white text-sm font-semibold"
    >
      Skip to main content
    </a>

    <div id="main-content" tabindex="-1" class="outline-none flex-1 flex flex-col">
      <slot />
    </div>
  </body>
</html>
