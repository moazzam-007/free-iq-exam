---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "About Us: Our Mission & Psychometric Standards | FreeIQExam";
const description = "Learn about FreeIQExam.com's mission to provide scientifically validated, transparent, and paywall-free cognitive testing based on modern CHC psychometrics.";
---

<Layout title={title} description={description}>
  <Header currentPath="/about" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    
    <!-- Hero Header -->
    <header class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900 text-xs font-mono font-medium text-blue-700 dark:text-blue-300 mb-4">
        <span>TRANSPARENCY &bull; RIGOR &bull; ACCESSIBILITY</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Democratizing Scientific Cognitive Assessment
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Why FreeIQExam was created: To eliminate deceptive paywalls and restore scientific integrity to online cognitive measurement.
      </p>
    </header>

    <!-- Mission Statement Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Our Founding Mission
      </h2>
      <p>
        The online intelligence testing vertical is dominated by predatory practices. More than 95% of consumer testing websites lure users into completing a 20 to 40 minute exam, only to withhold their score behind an unexpected $9.99 to $29.99 paywall, a recurring credit card trial, or an invasive email marketing capture form.
      </p>
      <p>
        FreeIQExam was established with a singular, uncompromising principle: <strong>High-quality cognitive screening should be 100% free, instantaneous, and private.</strong> You will never be asked for a credit card, subscription sign-up, or email address to view your complete psychometric breakdown.
      </p>
    </section>

    <!-- Core Pillars Grid -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg mb-4">
          01
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          CHC Psychometric Grounding
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Anchored to the empirical Cattell-Horn-Carroll (CHC) consensus, isolating Non-Verbal Fluid Reasoning (Gf) and Visual Processing (Gv).
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-4">
          02
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          2PL IRT Mathematical Modeling
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Scored using 2-Parameter Logistic Item Response Theory with Bayesian Expected A Posteriori (EAP) latent trait estimation.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-purple-100 dark:bg-purple-950 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg mb-4">
          03
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          Zero Data Tracking
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          All scoring computations execute client-side in your local browser runtime. We never sell, transmit, or monetize your test data.
        </p>
      </div>
    </section>

    <!-- Assessment CTA -->
    <section class="p-8 sm:p-12 rounded-3xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 text-white text-center shadow-lg">
      <h2 class="font-heading font-extrabold text-2xl sm:text-4xl mb-3 tracking-tight">
        Ready to Discover Your Cognitive Profile?
      </h2>
      <p class="text-blue-100 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
        Take our 24-item non-verbal fluid intelligence assessment and receive your estimated IQ score and percentile ranking instantly.
      </p>
      <a 
        href="/test" 
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-zinc-950 bg-white hover:bg-zinc-100 transition-all shadow-md hover:scale-102 active:scale-98"
      >
        <span>Take Free Assessment (20 Mins)</span>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </section>

  </main>

  <Footer />
</Layout>
