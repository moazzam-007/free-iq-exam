---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "About FreeIQExam - Psychometric Standards, Mission & Transparency";
const description = "Learn why FreeIQExam was created: To eliminate predatory paywalls and restore scientific rigor to free online cognitive testing using modern CHC psychometrics and 2PL IRT.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About FreeIQExam: Mission, Psychometrics & Transparency",
    "url": "https://freeiqexam.com/about/",
    "description": "Learn about FreeIQExam.com's mission to provide scientifically grounded, transparent, and paywall-free cognitive testing based on modern CHC psychometrics."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "An open, privacy-first psychometric platform providing free, research-backed cognitive assessments and brain training drills with zero paywalls."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About Us",
        "item": "https://freeiqexam.com/about/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is there an actually free IQ test with no paywall or email required?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. FreeIQExam provides fully free cognitive screening tests with instant results. There is no paywall, no credit card request, and no mandatory email sign-up. Your full score report and psychometric breakdown appear immediately upon submission."
        }
      },
      {
        "@type": "Question",
        "name": "Why do so many online IQ tests charge money after you complete them?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many commercial test sites employ a deliberate bait-and-switch conversion funnel. They advertise the exam as 'free' to maximize engagement, capitalize on the sunk-cost fallacy after you spend 30 minutes answering questions, and demand a recurring subscription or payment before revealing your results. FreeIQExam was created specifically to counter this predatory practice."
        }
      },
      {
        "@type": "Question",
        "name": "Is FreeIQExam considered a legitimate free IQ test on Reddit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Communities like Reddit's r/cognitivetesting and r/iq routinely warn users against commercial paywalled scam sites and look for transparent, non-monetized tests. FreeIQExam is built on open psychometric principles—using 2PL Item Response Theory (IRT) and Cattell-Horn-Carroll (CHC) theory—with client-side privacy, transparent norming, and zero monetization traps."
        }
      },
      {
        "@type": "Question",
        "name": "Can an online IQ test give an official clinical diagnosis?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No online test can provide an official clinical diagnosis. A legal clinical IQ diagnosis requires individual administration by a licensed clinical psychologist using comprehensive batteries like the WAIS-IV or Stanford-Binet 5. FreeIQExam serves as a research-grounded cognitive screening tool and educational resource."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/about" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">About Us</span>
    </nav>
    
    <!-- Hero Header -->
    <header class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>TRANSPARENCY &bull; RIGOR &bull; ACCESSIBILITY</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Democratizing Scientific Cognitive Assessment
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Why FreeIQExam was created: To eliminate deceptive paywalls and restore scientific integrity to online cognitive measurement.
      </p>
    </header>

    <!-- Mission Statement Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Our Founding Mission: Ending the "Free IQ Test" Bait-and-Switch
      </h2>
      <p>
        The online intelligence testing vertical is infamous for predatory consumer practices. Millions of people every month search for <em>"free iq test reddit"</em>, <em>"legitimate free iq test"</em>, or <em>"actually free iq test no paywall"</em> because they have experienced the pervasive bait-and-switch pattern:
      </p>
      <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-900 dark:text-red-200 my-4 text-xs sm:text-sm">
        <strong>The Common Industry Trap:</strong> Commercial sites lure you in with banners declaring "100% Free IQ Test." After spending 30 to 45 minutes answering complex matrix reasoning problems, you reach the final submission button—only to be told: <em>"Your IQ report is ready! Pay $19.99 (or enter your card for a $1 trial that auto-bills $39.99/month) to reveal your score."</em>
      </div>
      <p>
        This tactic exploits the psychological <strong>sunk-cost fallacy</strong>: after investing substantial mental energy, users feel pressured to pay. Worse yet, many of these paid services generate artificially inflated, feel-good scores to prevent chargebacks, rendering the results psychometrically meaningless.
      </p>
      <p>
        FreeIQExam was established with a singular, uncompromising principle: <strong>High-quality cognitive screening should be 100% free, instantaneous, and private.</strong> You will never be asked for a credit card, subscription sign-up, or email address to view your complete psychometric breakdown.
      </p>
    </section>

    <!-- Core Pillars Grid -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base font-mono mb-4">
          01
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          CHC Psychometric Grounding
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Anchored to the empirical Cattell-Horn-Carroll (CHC) taxonomy of human cognitive abilities, evaluating Non-Verbal Fluid Reasoning (<em>Gf</em>), Visual Processing (<em>Gv</em>), and Working Memory (<em>Gwm</em>).
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base font-mono mb-4">
          02
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          2PL IRT Mathematical Modeling
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Scored using 2-Parameter Logistic Item Response Theory (2PL IRT) with item difficulty ($b_i$), discrimination ($a_i$), and Bayesian Expected A Posteriori (EAP) latent trait ($\theta$) estimation.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base font-mono mb-4">
          03
        </div>
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          Private Client-Side Execution
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          All scoring algorithms, norm tables, and item curves execute locally in your web browser. We never sell, transmit, or monetize your individual responses or demographic data.
        </p>
      </div>
    </section>

    <!-- Psychometric Methodology Section -->
    <section class="p-6 sm:p-10 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Psychometric Rigor: How FreeIQExam Computes Your Score
      </h2>
      <p>
        Traditional amateur quizzes simply count raw correct answers and multiply by an arbitrary scaling factor. This naive approach fails to account for the fact that solving an extremely difficult matrix reasoning problem provides vastly more information about latent cognitive capacity than answering a trivial warmup item.
      </p>
      <p>
        FreeIQExam applies contemporary psychometric modeling:
      </p>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong>Item Characteristic Curves (ICC):</strong> Each test item is defined by a mathematical discrimination parameter ($a$) determining how sharply it separates cognitive strata, and a difficulty parameter ($b$) calibrated on standard normal z-score distributions ($\mu = 0, \sigma = 1$).</li>
        <li><strong>Bayesian EAP Trait Estimation:</strong> Your continuous latent trait parameter ($\theta$) is estimated via numerical integration across a Gaussian prior distribution, penalizing lucky guesses and providing realistic Standard Errors of Measurement (SEM).</li>
        <li><strong>Standard Deviation ($\sigma = 15$) Scaling:</strong> The latent trait $\theta$ is mapped to the standard Wechsler IQ metric ($IQ = 100 + 15\theta$) and converted into population percentiles using the cumulative normal distribution function $\Phi(z)$.</li>
      </ul>
      <div class="mt-4 p-4 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-900 dark:text-blue-200">
        For an in-depth mathematical walkthrough of our calibration curves and integration formulas, explore our <a href="/methodology" class="font-semibold underline">Science & Psychometrics Whitepaper</a>.
      </div>
    </section>

    <!-- Transparent Boundaries & Clinical Disclaimer -->
    <section class="p-6 sm:p-10 rounded-3xl bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-amber-950 dark:text-amber-200 leading-relaxed space-y-3">
      <h2 class="font-heading font-bold text-lg sm:text-xl text-amber-950 dark:text-amber-100">
        Clinical Scope & Scientific Boundaries
      </h2>
      <p>
        Psychometric honesty requires clear boundaries. While our assessments are engineered with high mathematical and psychometric rigor:
      </p>
      <ul class="list-disc pl-5 space-y-1.5">
        <li><strong>Screening Tool, Not Clinical Diagnosis:</strong> FreeIQExam is an educational self-assessment and cognitive screening instrument. It does not replace a comprehensive, individually proctored evaluation by a licensed neuropsychologist or educational psychologist.</li>
        <li><strong>Non-Verbal Focus:</strong> Our primary 20-minute exam evaluates non-verbal fluid reasoning ($Gf$) and abstract matrix pattern induction, minimizing cultural and linguistic bias. It does not measure crystallized vocabulary knowledge ($Gc$) or auditory working memory, which require multi-subtest batteries like the WAIS-IV.</li>
        <li><strong>Special Education & Mensa Admissions:</strong> Mensa and school gifted programs require supervised, proctored examinations or qualifying prior evidence tests (such as historical SAT/GRE scores or proctored Stanford-Binet exams). Learn more on our <a href="/mensa-iq-test-practice" class="font-semibold underline">Mensa Practice & Qualifying Guide</a>.</li>
      </ul>
    </section>

    <!-- PAA FAQs Accordion -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-6">
        Frequently Asked Questions About FreeIQExam
      </h2>
      <div class="space-y-4">
        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Is there an actually free IQ test with no paywall or email required?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Yes. FreeIQExam provides fully free cognitive screening tests with instant results. There is no paywall, no credit card request, and no mandatory email sign-up. Your full score report and psychometric breakdown appear immediately upon submission.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Why do so many online IQ tests charge money after you complete them?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Many commercial test sites employ a deliberate bait-and-switch conversion funnel. They advertise the exam as "free" to maximize engagement, capitalize on the sunk-cost fallacy after you spend 30 minutes answering questions, and demand a recurring subscription or payment before revealing your results. FreeIQExam was created specifically to counter this predatory practice.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Is FreeIQExam considered a legitimate free IQ test on Reddit?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Communities like Reddit's r/cognitivetesting and r/iq routinely warn users against commercial paywalled scam sites and look for transparent, non-monetized tests. FreeIQExam is built on open psychometric principles—using 2PL Item Response Theory (IRT) and Cattell-Horn-Carroll (CHC) theory—with client-side privacy, transparent norming, and zero monetization traps.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Can an online IQ test give an official clinical diagnosis?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            No online test can provide an official clinical diagnosis. A legal clinical IQ diagnosis requires individual administration by a licensed clinical psychologist using comprehensive batteries like the WAIS-IV or Stanford-Binet 5. FreeIQExam serves as a research-grounded cognitive screening tool and educational resource.
          </p>
        </details>
      </div>
    </section>

    <!-- Assessment CTA -->
    <section class="p-8 sm:p-12 rounded-3xl bg-zinc-900 border border-zinc-800 text-white text-center shadow-lg">
      <h2 class="font-heading font-extrabold text-2xl sm:text-4xl mb-3 tracking-tight">
        Ready to Test Your Fluid Intelligence?
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
        Take our 24-item non-verbal fluid intelligence assessment and receive your estimated IQ score and percentile ranking instantly.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/test" 
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-white bg-blue-600 hover:bg-blue-500 transition-all shadow-md hover:scale-102 active:scale-98"
        >
          <span>Take Full Test (20 Mins)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a 
          href="/quick-test" 
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition-all border border-zinc-700 hover:scale-102 active:scale-98"
        >
          <span>Take Quick Test (10 Mins)</span>
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
