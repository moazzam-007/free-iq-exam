---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Alternate links for future i18n releases
const alternates = {};

const title = "Free Online FPS Aim Trainer | Mouse Accuracy & Reflex Benchmark";
const description = "Improve your mouse accuracy, reaction speed, and flicking precision with our free browser-based FPS aim trainer. Features Gridshot, tracking, and precision reflex modes with eDPI sensitivity conversion. No download required.";
const canonicalUrl = "https://freeiqexam.com/aim-trainer";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam FPS Aim Trainer & Mouse Accuracy Benchmark",
    "url": "https://freeiqexam.com/aim-trainer",
    "applicationCategory": "GameApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript and HTML5 Canvas support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Triple Training Disciplines: Gridshot (Flicking), Smooth Tracking, and Precision Micro-Targets",
      "High-Performance 60FPS+ HTML5 Canvas rendering with sub-pixel hitboxes and particle physics",
      "Web Audio API pitch-scaling combo hit chimes and acoustic miss feedback",
      "Real-time Kinematic metrics: Overall Score, TPS (Targets/Sec), Raw Accuracy %, and Reaction Delay (ms)",
      "In-game eDPI sensitivity converter for Valorant, CS2 / Counter-Strike, Overwatch 2, Apex Legends, and R6 Siege",
      "Customizable crosshair styles (Crosshair, Dot, Circle-Dot) and high-visibility neon colors",
      "Downloadable high-resolution esports scorecard certificate (1200x675 PNG)",
      "Zero download, zero signup, 100% private browser-based execution"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.97",
      "ratingCount": "48900",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://freeiqexam.com/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "FPS Aim Trainer",
        "item": "https://freeiqexam.com/aim-trainer"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is an FPS aim trainer and how does it improve mouse accuracy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An FPS aim trainer is a specialized software environment designed to isolate and drill the core motor mechanics of aiming: target acquisition (flicking), dynamic target tracking, and micro-correction precision. By removing in-game distractions (recoil patterns, abilities, movement physics), aim trainers allow players to perform hundreds of high-density repetitions per minute, accelerating cerebellar motor learning and neural pathway myelination."
        }
      },
      {
        "@type": "Question",
        "name": "What is eDPI and how do I calculate it across different games?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "eDPI (effective Dots Per Inch) represents your true mouse sensitivity by multiplying your physical mouse hardware DPI by your in-game sensitivity value (eDPI = DPI × In-Game Sens). Because different game engines utilize different yaw constants (e.g. CS2/Source engine uses 0.022 yaw while Valorant uses 0.07 yaw), 1.0 sensitivity in Valorant equals 3.1818 in CS2. Use our built-in sensitivity converter to maintain identical 360-degree rotation distances across all your games."
        }
      },
      {
        "@type": "Question",
        "name": "Should I aim with my arm, wrist, or fingertips?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Top esports athletes utilize a hybrid aiming technique: 1) Arm aiming (elbow pivot) handles large swiping rotations (90° to 180° turns) on low sensitivity, 2) Wrist aiming (carpal pivot) executes medium flicks and tracking across the monitor screen, and 3) Fingertip micro-adjustments fine-tune the final 5–15 pixel headshot alignment and vertical recoil control. Relying solely on wrist aiming at high sensitivity increases the risk of carpal tunnel syndrome and degrades long-range precision."
        }
      },
      {
        "@type": "Question",
        "name": "Does higher monitor refresh rate (144Hz, 240Hz, 360Hz) improve aim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. A 240Hz monitor refreshes the display frame every 4.16ms compared to 16.67ms on a standard 60Hz display. This 12.5ms reduction in end-to-end motion-to-photon latency renders target trajectories with significantly less motion blur and temporal ghosting, allowing your ocular saccadic system to calculate target interception coordinates with higher statistical fidelity."
        }
      },
      {
        "@type": "Question",
        "name": "What is considered a good score on Gridshot (Flicking)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In a standard 30-second Gridshot benchmark: Scores below 40,000 (under 2.0 targets/sec) correspond to Novice/Bronze tiers; 50,000 to 70,000 (2.5–3.2 targets/sec with 85%+ accuracy) represents average to intermediate competitive rank (Gold/Platinum); 80,000 to 95,000 represents elite Master/Grandmaster tier; and scores exceeding 100,000 (4.5+ targets/sec with 95%+ accuracy) reflect professional esports level flick speed."
        }
      },
      {
        "@type": "Question",
        "name": "How does mouse polling rate (1000Hz vs 4000Hz vs 8000Hz) impact accuracy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard 1000Hz polling reports mouse coordinates every 1.0ms. High-polling sensors operating at 4000Hz (0.25ms) and 8000Hz (0.125ms) reduce sensor-to-CPU input latency and micro-stuttering, producing smoother micro-tracking curves on high-refresh monitors (240Hz+). However, 8000Hz requires substantial CPU thread performance to prevent frame drops in demanding 3D games."
        }
      },
      {
        "@type": "Question",
        "name": "Why is accuracy more important than raw flick speed during practice?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Motor learning research demonstrates that rapid inaccurate movements reinforce incorrect neural pathways and trigger overshooting habits. By deliberately training at a rhythm where you maintain 90% to 95% accuracy, your motor cortex establishes precise kinematic trajectories. Speed naturally emerges as a byproduct of movement efficiency and reduced correction latency."
        }
      },
      {
        "@type": "Question",
        "name": "Does mouse weight and mousepad friction affect precision aiming?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ultralight mice (sub-60 grams) minimize kinetic inertia, enabling faster initial acceleration and instantaneous stopping power without muscular strain. Mousepads with low static friction (hybrid or glass surfaces) facilitate effortless micro-adjustments for pixel-level precision, while cloth control pads offer higher dynamic friction for stable tracking."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
>
  <Header currentPath="/aim-trainer" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span>FPS Aim Trainer & Mouse Accuracy Benchmark</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Free Online FPS Aim Trainer
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        Sharpen your flicking precision, dynamic tracking, and micro-target reflexes with our hardware-accelerated 60FPS canvas engine. Calibrate crosshairs, convert eDPI sensitivity across games, and benchmark your reaction kinematics.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- Control Bar / Settings -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-4 sm:p-6 mb-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          
          <!-- Mode Selector -->
          <div class="flex items-center gap-1.5 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs font-medium">
            <button
              type="button"
              class="aim-mode-btn active px-3.5 py-2 rounded-xl transition-all duration-150 bg-rose-500/10 text-rose-500 border border-rose-500/40 font-semibold cursor-pointer"
              data-mode="gridshot"
            >
              🎯 Gridshot (Flicking)
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-mode="tracking"
            >
              🌊 Smooth Tracking
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-mode="precision"
            >
              ⚡ Precision Micro
            </button>
          </div>

          <!-- Duration & Crosshair Settings -->
          <div class="flex flex-wrap items-center gap-3">
            
            <!-- Duration -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="aim-time-btn active px-3 py-1.5 rounded-xl transition-all duration-150 text-rose-500 font-bold cursor-pointer"
                data-time="30"
              >
                30s
              </button>
              <button
                type="button"
                class="aim-time-btn px-3 py-1.5 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-time="60"
              >
                60s
              </button>
            </div>

            <!-- Crosshair Style -->
            <div class="flex items-center gap-2 text-xs">
              <label for="crosshairStyleSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Crosshair:</label>
              <select
                id="crosshairStyleSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-xs rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-rose-500 cursor-pointer"
              >
                <option value="crosshair">Crosshair</option>
                <option value="dot">Dot</option>
                <option value="circle">Circle + Dot</option>
              </select>
            </div>

            <!-- Crosshair Color -->
            <div class="flex items-center gap-2 text-xs">
              <label for="crosshairColorSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Color:</label>
              <select
                id="crosshairColorSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-xs rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-rose-500 cursor-pointer"
              >
                <option value="#22c55e">Neon Green</option>
                <option value="#06b6d4">Cyan</option>
                <option value="#f43f5e" selected>Rose Red</option>
                <option value="#ffffff">Pure White</option>
                <option value="#eab308">Amber Gold</option>
              </select>
            </div>

          </div>
        </div>
      </div>

      <!-- Interactive Game Arena Container -->
      <div id="arenaContainer" class="relative bg-zinc-950 rounded-3xl p-3 sm:p-4 border border-zinc-800 shadow-2xl overflow-hidden select-none">
        
        <!-- Live HUD Bar -->
        <div class="flex items-center justify-between px-3 py-2 mb-3 bg-zinc-900/90 backdrop-blur-md rounded-2xl border border-zinc-800/80 text-zinc-100 text-xs sm:text-sm font-mono">
          <div class="flex items-center gap-4 sm:gap-8">
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Time Left</span>
              <span id="hudAimTimer" class="font-bold text-base sm:text-lg text-rose-400">30s</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Score</span>
              <span id="hudAimScore" class="font-bold text-base sm:text-lg text-white">0</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Targets Hit</span>
              <span id="hudAimHits" class="font-bold text-base sm:text-lg text-emerald-400">0</span>
            </div>
          </div>

          <div class="flex items-center gap-4 sm:gap-6 text-right">
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Accuracy</span>
              <span id="hudAimAcc" class="font-bold text-base sm:text-lg text-cyan-400">100%</span>
            </div>
            <div class="hidden sm:block text-zinc-500 text-xs font-sans">
              <span class="kbd px-1.5 py-0.5 rounded bg-zinc-800 text-[11px] text-zinc-400 border border-zinc-700">ESC</span> Reset
            </div>
          </div>
        </div>

        <!-- Canvas Game Surface -->
        <div class="relative w-full h-[420px] sm:h-[540px] rounded-2xl overflow-hidden bg-[#0a0a0f] border border-zinc-800/60 flex items-center justify-center">
          <canvas id="aimCanvas" class="w-full h-full cursor-none touch-none block"></canvas>

          <!-- Start Game Overlay -->
          <div
            id="startOverlay"
            class="absolute inset-0 bg-zinc-950/85 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-all duration-200 z-10"
          >
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-rose-500/10 border-2 border-rose-500/40 flex items-center justify-center mb-5 text-rose-500 animate-pulse">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="3"></circle>
                <path stroke-linecap="round" d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
              </svg>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-2 tracking-tight">
              Click Anywhere to Begin Training
            </h2>
            <p class="text-sm text-zinc-400 max-w-md mb-6">
              Keep your wrist relaxed and focus on steady cadence. Eliminate targets as fast and accurately as possible.
            </p>

            <div class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold text-sm shadow-sm transition-all duration-200 active:scale-[0.97] cursor-pointer">
              <span>Start Aim Session</span>
              <span>→</span>
            </div>

            <div class="mt-8 flex items-center gap-4 text-xs text-zinc-500">
              <span>⚡ 60FPS Physics</span>
              <span>•</span>
              <span>🔊 Web Audio Feedback</span>
              <span>•</span>
              <span>🎯 Custom Crosshairs</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Results Scorecard Container (Hidden by default) -->
      <div id="resultsWrap" class="hidden mt-8 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-xl transition-all duration-300">
        
        <!-- Score Header & Tier Badge -->
        <div class="text-center pb-8 border-b border-zinc-200 dark:border-zinc-800/80">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
            <span>Session Complete</span>
          </div>

          <div class="text-5xl sm:text-7xl font-black text-zinc-950 dark:text-white font-mono tracking-tight mb-2">
            <span id="resAimScore">0</span>
            <span class="text-base sm:text-xl font-sans font-normal text-zinc-500">pts</span>
          </div>

          <div class="flex items-center justify-center gap-3 mb-3">
            <span id="resAimTier" class="px-3.5 py-1 rounded-xl bg-zinc-900 text-rose-400 border border-rose-500/30 text-sm font-bold tracking-wide">
              Diamond II
            </span>
            <span id="resAimPercentile" class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
              Top 12% Worldwide
            </span>
          </div>

          <p id="resAimDesc" class="text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
            High target acquisition velocity with solid flick stability and minimal overshooting.
          </p>
        </div>

        <!-- Kinematic Performance Metric Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 py-8 border-b border-zinc-200 dark:border-zinc-800/80">
          
          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Accuracy</span>
            <span id="resAimAcc" class="text-2xl sm:text-3xl font-black font-mono text-cyan-500">0%</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Hits vs Misses</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Targets / Sec</span>
            <span id="resAimTps" class="text-2xl sm:text-3xl font-black font-mono text-emerald-500">0.00</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Throughput Rate</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Reaction Delay</span>
            <span id="resAimReaction" class="text-2xl sm:text-3xl font-black font-mono text-rose-500">0ms</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Avg Time to Hit</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Total Hits</span>
            <span id="resAimHits" class="text-2xl sm:text-3xl font-black font-mono text-indigo-500">0</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Confirmed Targets</span>
          </div>

          <div class="col-span-2 sm:col-span-1 bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Max Streak</span>
            <span id="resAimStreak" class="text-2xl sm:text-3xl font-black font-mono text-amber-500">0x</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Consecutive Hits</span>
          </div>

        </div>

        <!-- Sensitivity Converter & Actions -->
        <div class="pt-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            
            <!-- Sensitivity Matcher Mini Box -->
            <div class="w-full md:w-auto flex-1 bg-white dark:bg-zinc-900/40 p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800">
              <h3 class="text-xs font-bold font-mono uppercase tracking-wider text-zinc-500 mb-3 flex items-center gap-2">
                <span>⚙️ In-Game Sensitivity & eDPI Matcher</span>
              </h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3 text-xs">
                <div>
                  <label for="sensSourceGame" class="block text-zinc-500 mb-1">Game</label>
                  <select id="sensSourceGame" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-2.5 py-1.5 text-zinc-900 dark:text-zinc-100 focus:outline-none">
                    <option value="valorant" selected>Valorant</option>
                    <option value="cs2">CS2 / Source / Apex</option>
                    <option value="overwatch">Overwatch 2</option>
                    <option value="r6">Rainbow Six Siege</option>
                  </select>
                </div>
                <div>
                  <label for="sensSourceVal" class="block text-zinc-500 mb-1">In-Game Sens</label>
                  <input type="number" id="sensSourceVal" step="0.01" value="0.40" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-2.5 py-1.5 text-zinc-900 dark:text-zinc-100 focus:outline-none" />
                </div>
                <div>
                  <label for="sensDpi" class="block text-zinc-500 mb-1">Mouse DPI</label>
                  <input type="number" id="sensDpi" step="50" value="800" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-2.5 py-1.5 text-zinc-900 dark:text-zinc-100 focus:outline-none" />
                </div>
              </div>

              <!-- Output Conversions -->
              <div class="grid grid-cols-4 gap-2 pt-2 border-t border-zinc-200 dark:border-zinc-800/80 text-center font-mono text-xs">
                <div class="bg-zinc-100 dark:bg-zinc-800/60 p-1.5 rounded-lg">
                  <span class="text-[10px] text-zinc-500 block font-sans">Valorant</span>
                  <span id="outValorant" class="font-bold text-rose-500">0.400</span>
                </div>
                <div class="bg-zinc-100 dark:bg-zinc-800/60 p-1.5 rounded-lg">
                  <span class="text-[10px] text-zinc-500 block font-sans">CS2 / Apex</span>
                  <span id="outCs2" class="font-bold text-indigo-400">1.273</span>
                </div>
                <div class="bg-zinc-100 dark:bg-zinc-800/60 p-1.5 rounded-lg">
                  <span class="text-[10px] text-zinc-500 block font-sans">Overwatch</span>
                  <span id="outOverwatch" class="font-bold text-amber-500">4.24</span>
                </div>
                <div class="bg-zinc-100 dark:bg-zinc-800/60 p-1.5 rounded-lg">
                  <span class="text-[10px] text-zinc-500 block font-sans">eDPI</span>
                  <span id="outEdpi" class="font-bold text-emerald-500">320</span>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
              <button
                type="button"
                id="retakeAimBtn"
                class="px-6 py-3.5 min-h-[44px] rounded-2xl bg-zinc-200 dark:bg-zinc-800 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 font-bold text-sm transition-all duration-200 active:scale-[0.97] cursor-pointer text-center"
              >
                ↻ Train Again
              </button>
              <button
                type="button"
                id="downloadAimCertBtn"
                class="px-6 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold text-sm shadow-sm transition-all duration-200 active:scale-[0.97] cursor-pointer text-center flex items-center justify-center gap-2"
              >
