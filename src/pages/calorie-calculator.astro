---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Alternate links for future i18n releases
const alternates = {
  'fi': 'https://freeiqexam.com/fi/kalorilaskuri'
};

const title = "Free Calorie Calculator & TDEE Deficit Calculator | FreeIQExam";;
const description = "Calculate your maintenance calories, TDEE, and optimal calorie deficit with our free, science-backed calculator. Instant macro targets with zero sign-up required.";;
const canonicalUrl = "https://freeiqexam.com/calorie-calculator";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Clinical TDEE & Calorie Calculator",
    "url": "https://freeiqexam.com/calorie-calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Clinical BMR calculation using Mifflin-St Jeor (Gold Standard), Katch-McArdle (LBM), and Oxford formulas",
      "Exact Total Daily Energy Expenditure (TDEE) based on 5 physical activity multipliers (PAL)",
      "Goal-driven calorie targets: Mild Cut (-10%), Standard Cut (-20%), Aggressive Cut (-25%), Lean Bulk (+10%), and Heavy Bulk (+20%)",
      "Interactive Macronutrient gram splitter for 4 diet protocols: High Protein, Balanced, Low-Carb/Keto, and Plant-Based Endurance",
      "Neuro-Metabolic Brain Glucose Consumption Index (~20% of basal metabolic energy)",
      "US Navy Body Fat Calculator Module for neck, waist, and hip circumferences",
      "Dual unit conversion: Metric (kg/cm) and Imperial (lbs/ft-in) with real-time sync",
      "Interactive 60FPS high-DPI canvas macronutrient doughnut chart"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.99",
      "ratingCount": "95400",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://freeiqexam.com/tools"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Calorie & TDEE Calculator",
        "item": "https://freeiqexam.com/calorie-calculator"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between BMR and TDEE?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "BMR (Basal Metabolic Rate) is the baseline number of calories your body burns at complete rest just to keep vital organs functioning (brain, heart, lungs, liver, cellular repair). TDEE (Total Daily Energy Expenditure) is your true daily calorie burn, calculated by multiplying your BMR by your Physical Activity Level (PAL) to account for daily walking, work, digestion, and exercise."
        }
      },
      {
        "@type": "Question",
        "name": "Which BMR formula is the most accurate?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Mifflin-St Jeor formula is widely recognized by the Academy of Nutrition and Dietetics as the clinical gold standard for the general population. However, if you know your accurate body fat percentage, the Katch-McArdle formula is even more precise because it calculates metabolic rate directly from Lean Body Mass (LBM), accounting for muscular hypertrophy or high adiposity."
        }
      },
      {
        "@type": "Question",
        "name": "What is a safe calorie deficit for sustainable fat loss?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A standard calorie deficit of 20% below your TDEE (approximately 400 to 500 kcal/day) is optimal. This yields approximately 0.45 to 0.50 kg (1 lb) of fat loss per week while preserving lean muscle mass, thyroid function, and metabolic rate. Aggressive deficits exceeding 25% often trigger muscle catabolism, severe hunger hormones (ghrelin spikes), and metabolic adaptation."
        }
      },
      {
        "@type": "Question",
        "name": "How much energy does the human brain consume daily?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The human brain accounts for approximately 2% of total body weight but commands approximately 20% of your resting Basal Metabolic Rate (BMR)—roughly 300 to 400 kcal per day (equivalent to ~100-130 grams of pure glucose). During intense cognitive work, the brain requires constant glucose perfusion to maintain sodium-potassium ion pumping across neuronal membranes and neurotransmitter synthesis."
        }
      },
      {
        "@type": "Question",
        "name": "How much daily protein do I need while cutting calories?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "During a caloric deficit, clinical sports nutrition guidelines recommend consuming 1.8 to 2.4 grams of protein per kilogram of body weight (0.8 to 1.1 g/lb). High protein intake leverages the Thermic Effect of Food (TEF burns 20-30% of protein calories during digestion), maximally spares lean skeletal muscle via muscle protein synthesis (MPS), and stimulates satiety hormones like Peptide YY and GLP-1."
        }
      },
      {
        "@type": "Question",
        "name": "What is metabolic adaptation (starvation mode)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Metabolic adaptation (adaptive thermogenesis) is an evolutionary biological response where your body reduces energy expenditure beyond what is predicted by weight loss alone. The body downregulates non-exercise activity (NEAT), decreases resting heart rate, and lowers leptin and thyroid hormones (T3). To prevent severe metabolic adaptation, avoid chronic deficits exceeding 25% and incorporate structured maintenance diet breaks every 8 to 12 weeks."
        }
      },
      {
        "@type": "Question",
        "name": "How does the US Navy Body Fat formula estimate body fat?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The US Navy Body Fat method uses logarithmic circumference ratios of the neck, waist (at navel level), and hips (for females) compared against standing height. Because abdominal fat accumulation correlates strongly with total visceral and subcutaneous adipose tissue, the Navy formula provides a reliable estimate with a 3-4% margin of error compared to DEXA scans."
        }
      },
      {
        "@type": "Question",
        "name": "Should I eat back the calories burned during exercise?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In most cases, no. Fitness trackers and cardio machines systematically overestimate exercise calorie expenditure by 20% to 40%. Because our TDEE calculation already incorporates your weekly exercise volume through the Physical Activity Level (PAL) multiplier, eating back additional tracked calories often eliminates your caloric deficit."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
>
  <Header currentPath="/calorie-calculator" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Clinical Mifflin-St Jeor & Katch-McArdle Engine</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Free Calorie & TDEE Deficit Calculator
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        Calculate your exact Total Daily Energy Expenditure (TDEE), Basal Metabolic Rate (BMR), target calorie deficit, and macronutrient grams. Features clinical body composition modeling and neuro-metabolic brain energy metrics.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left Column: Inputs Form (7 Cols) -->
        <div class="lg:col-span-7 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-7 shadow-lg space-y-6">
          
          <!-- Unit & Gender Selectors -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-zinc-200 dark:border-zinc-800/80">
            
            <!-- Unit Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="cal-unit-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer"
                data-unit="metric"
              >
                Metric (kg / cm)
              </button>
              <button
                type="button"
                class="cal-unit-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-unit="imperial"
              >
                Imperial (lbs / ft-in)
              </button>
            </div>

            <!-- Gender Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="cal-gender-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer"
                data-gender="male"
              >
                ♂ Male
              </button>
              <button
                type="button"
                class="cal-gender-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-gender="female"
              >
                ♀ Female
              </button>
            </div>

          </div>

          <!-- Biometric Inputs Grid -->
          <div class="space-y-4">
            
            <!-- Age & Optional Body Fat -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calAge" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Age (Years)
                </label>
                <input
                  type="number"
                  id="calAge"
                  value="28"
                  min="12"
                  max="110"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="calBodyFat" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                    Body Fat % <span class="text-[10px] text-zinc-400 lowercase font-sans">(optional)</span>
                  </label>
                  <span id="navyBfResultBadge" class="hidden text-[10px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full"></span>
                </div>
                <input
                  type="number"
                  id="calBodyFat"
                  placeholder="e.g. 16"
                  step="0.1"
                  min="4"
                  max="60"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Metric Inputs (Weight kg, Height cm) -->
            <div id="metricInputsWrap" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Weight (kg)
                </label>
                <input
                  type="number"
                  id="calWeightMetric"
                  value="75"
                  step="0.5"
                  min="25"
                  max="300"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label for="calHeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Height (cm)
                </label>
                <input
                  type="number"
                  id="calHeightMetric"
                  value="178"
                  min="80"
                  max="250"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Imperial Inputs (Weight lbs, Height ft-in) - Hidden by default -->
            <div id="imperialInputsWrap" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightImperial" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Weight (lbs)
                </label>
                <input
                  type="number"
                  id="calWeightImperial"
                  value="165"
                  step="1"
                  min="55"
                  max="660"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Height (Feet & Inches)
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <input
                    type="number"
                    id="calHeightFeet"
                    value="5"
                    min="3"
                    max="8"
                    placeholder="Feet"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                  <input
                    type="number"
                    id="calHeightInches"
                    value="10"
                    min="0"
                    max="11"
                    placeholder="Inches"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                </div>
              </div>
            </div>

            <!-- Activity Level (PAL) -->
            <div>
              <label for="calActivity" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                Physical Activity Level (PAL)
              </label>
              <select
                id="calActivity"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
              >
                <option value="1.20">Sedentary (Desk job, minimal exercise)</option>
                <option value="1.375">Lightly Active (Light exercise 1-3 days/week)</option>
                <option value="1.55" selected>Moderately Active (Moderate training 3-5 days/week)</option>
                <option value="1.725">Very Active (Heavy training 6-7 days/week)</option>
                <option value="1.90">Athlete / Physical Labor (2x daily training or construction)</option>
              </select>
            </div>

          </div>

          <!-- US Navy Body Fat Calculator Drawer -->
          <details class="group p-4 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs">
            <summary class="font-bold text-zinc-900 dark:text-zinc-200 cursor-pointer select-none flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0Z" /><path d="m14.5 12.5 2-2" /><path d="m11.5 9.5 2-2" /><path d="m8.5 6.5 2-2" /><path d="m17.5 15.5 2-2" /></svg>Estimate Body Fat % (US Navy Method)</span>
              <svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            
            <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800/80 space-y-3">
              <p class="text-zinc-500 dark:text-zinc-400">
                Measure circumferences in cm with a flexible tape measure. Used to unlock the body-composition-based Katch-McArdle equation.
              </p>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="navyNeck" class="block text-zinc-500 mb-1">Neck (cm)</label>
                  <input type="number" id="navyNeck" value="38" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
                <div>
                  <label for="navyWaist" class="block text-zinc-500 mb-1">Waist at Navel (cm)</label>
                  <input type="number" id="navyWaist" value="84" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
                <div id="femaleHipWrap" class="hidden">
                  <label for="navyHip" class="block text-zinc-500 mb-1">Hips (cm)</label>
                  <input type="number" id="navyHip" value="98" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
              </div>

              <button
                type="button"
                id="calcNavyBfBtn"
                class="w-full mt-2 py-2 min-h-[44px] rounded-xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold transition-all duration-200 active:scale-[0.97] cursor-pointer"
              >
                Compute & Apply Body Fat %
              </button>
            </div>
          </details>

          <!-- Goal Preset Buttons -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2.5">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>Caloric Target & Objective</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <button type="button" class="cal-goal-btn active p-2.5 rounded-2xl text-xs font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 text-left cursor-pointer" data-goal="maintenance">
                <span class="block">Maintenance</span>
                <span class="text-[10px] text-zinc-400 font-normal">0 kcal delta</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="mild-cut">
                <span class="block">Mild Cut (-10%)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0.25 kg/week</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="standard-cut">
                <span class="block">Standard Cut (-20%)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0.50 kg/week</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="aggressive-cut">
                <span class="block">Aggressive (-25%)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0.75 kg/week</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="lean-bulk">
                <span class="block">Lean Bulk (+10%)</span>
                <span class="text-[10px] text-zinc-400 font-normal">+0.25 kg/week</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="heavy-bulk">
                <span class="block">Heavy Bulk (+20%)</span>
                <span class="text-[10px] text-zinc-400 font-normal">+0.50 kg/week</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Right Column: Results & Interactive Scorecard (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Hero Target Calories Card -->
          <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold">Daily Calorie Target</span>
              <span id="resDeltaVal" class="text-xs font-mono px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold">0 kcal</span>
            </div>

            <div class="text-5xl font-black font-mono tracking-tight mb-1 text-white">
              <span id="resTargetCalories">2,450</span>
              <span class="text-lg font-sans font-normal text-zinc-400">kcal/day</span>
            </div>

            <p id="resGoalDesc" class="text-xs text-zinc-400 mb-6 leading-relaxed">
              Maintenance (0 kcal) · Metabolic equilibrium and body recomposition
            </p>

            <!-- BMR & TDEE Badges Grid -->
            <div class="grid grid-cols-2 gap-3 pt-4 border-t border-zinc-800 text-xs font-mono">
              <div class="bg-zinc-900/80 p-3 rounded-2xl border border-zinc-800">
                <span class="text-[10px] text-zinc-500 block uppercase font-sans">Basal Metabolic Rate</span>
                <span id="resBmrVal" class="text-lg font-bold text-emerald-400">1,720</span>
