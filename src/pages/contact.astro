---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contact FreeIQExam - Psychometric Support & Inquiries";
const description = "Contact the FreeIQExam team for support, psychometric inquiries, bug reports, or feedback. We respond within 24-48 business hours.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact FreeIQExam",
    "url": "https://freeiqexam.com/contact/",
    "description": "Contact the FreeIQExam team for support, psychometric inquiries, bug reports, or feedback."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact",
        "item": "https://freeiqexam.com/contact/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/contact" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Contact</span>
    </nav>
    
    <!-- Hero Header -->
    <header class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>DIRECT SUPPORT &bull; FEEDBACK CHANNELS</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Get in Touch
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Have questions regarding psychometric scoring, bug reports, or partnership inquiries? We are here to assist.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Contact Info Card -->
      <div class="md:col-span-1 space-y-6">
        <div class="p-6 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
          <span class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-1">
            Official Inquiries
          </span>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Email Support
          </h3>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">
            Direct email communication for general support, editorial questions, and feedback.
          </p>
          <a href="mailto:support@freeiqexam.com" class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
            support@freeiqexam.com
          </a>
        </div>

        <div class="p-6 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
          <span class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-1">
            Turnaround Time
          </span>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Response Policy
          </h3>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            We review all inquiries within 24 to 48 business hours. For privacy deletion requests, please specify your request clearly.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form Card -->
      <div class="md:col-span-2 p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <h2 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-4">
          Send a Message
        </h2>

        <form id="contact-form" action="mailto:support@freeiqexam.com" method="post" enctype="text/plain" class="space-y-4">
          <!-- Honeypot for spam protection -->
          <div class="hidden" aria-hidden="true">
            <input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div>
            <label for="contact-name" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1 font-mono">
              Your Name
            </label>
            <input
              id="contact-name"
              type="text"
              required
              autocomplete="name"
              placeholder="e.g. Alex Miller"
              class="w-full px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1 font-mono">
              Email Address
            </label>
            <input
              id="contact-email"
              type="email"
              required
              autocomplete="email"
              placeholder="alex@example.com"
              class="w-full px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1 font-mono">
              Inquiry Subject
            </label>
            <select
              id="contact-subject"
              class="w-full px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            >
              <option value="General Feedback & Suggestions">General Feedback &amp; Suggestions</option>
              <option value="Psychometric / Scoring Question">Psychometric / Scoring Question</option>
              <option value="Bug Report / Technical Issue">Bug Report / Technical Issue</option>
              <option value="Privacy & Data Inquiry">Privacy &amp; Data Inquiry</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1 font-mono">
              Your Message
            </label>
            <textarea
              id="contact-message"
              required
              rows="4"
              placeholder="How can we assist you?"
              class="w-full px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full py-3.5 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/20 active:scale-98 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            <span>Send Message via Email</span>
          </button>

          <div id="form-feedback" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs text-zinc-700 dark:text-zinc-300 space-y-2">
            <div class="font-semibold text-emerald-700 dark:text-emerald-400 text-sm">Email client opened!</div>
            <p>
              Your default email app has been opened with your message pre-filled. If it did not open automatically, you can send your message directly to:
            </p>
            <div class="font-mono font-semibold text-blue-600 dark:text-blue-400">
              <a href="mailto:support@freeiqexam.com" id="fallback-mailto-link" class="underline">support@freeiqexam.com</a>
            </div>
          </div>
        </form>
      </div>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const fallbackLink = document.getElementById('fallback-mailto-link') as HTMLAnchorElement;

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Honeypot bot check
      const gotcha = (document.getElementById('contact-gotcha') as HTMLInputElement)?.value;
      if (gotcha) return;

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const subjectSelect = document.getElementById('contact-subject') as HTMLSelectElement;
      const subject = subjectSelect?.value || 'General Inquiry';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

      const mailtoSubject = encodeURIComponent(`[FreeIQExam] ${subject} - ${name}`);
      const mailtoBody = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nInquiry Type: ${subject}\n\nMessage:\n${message}\n\n---\nSent from FreeIQExam.com contact form`);
      const mailtoUri = `mailto:support@freeiqexam.com?subject=${mailtoSubject}&body=${mailtoBody}`;

      if (fallbackLink) fallbackLink.href = mailtoUri;
      feedback.classList.remove('hidden');

      // Attempt to trigger the user's email client
      window.location.href = mailtoUri;
    });
  }
</script>
