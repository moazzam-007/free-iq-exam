---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Online-Depressionstest: PHQ-9 Selbsttest & Orientierung | FreeIQExam";
const description = "Testen Sie Anzeichen einer depressiven Verstimmung mit dem PHQ-9 Fragebogen. Anonyme Orientierung und sofortige Auswertung direkt im Browser.";
const canonicalUrl = "https://freeiqexam.com/de/depressionstest";

const alternates = {
  en: "https://freeiqexam.com/depression-test",
  ru: "https://freeiqexam.com/ru/depression-test",
  id: "https://freeiqexam.com/id/tes-depresi",
  fi: "https://freeiqexam.com/fi/masennustesti",
  de: "https://freeiqexam.com/de/depressionstest"
};

const faqItems = [
  [
    'Was ist der PHQ-9 Fragebogen und wer hat ihn entwickelt?',
    'Der PHQ-9 (Patient Health Questionnaire-9) ist das 9-Fragen-Modul zur Depressionserfassung des Patient Health Questionnaire. Er wurde von Dr. Robert L. Spitzer, Dr. Janet B. W. Williams, Dr. Kurt Kroenke und Kollegen entwickelt. Jedes der neun Items bildet exakt eines der neun Kriterien für eine Major Depression nach dem DSM-5 bzw. ICD-10/ICD-11 über einen Zeitraum von 14 Tagen ab.'
  ],
  [
    'Wie verlässlich ist der PHQ-9 beim Erkennen von Depressionen?',
    'In umfangreichen Validierungsstudien zeigt ein Schwellenwert von 10 oder mehr Punkten eine Sensitivität und Spezifität von jeweils rund 88 % im Vergleich zu strukturierten klinischen Interviews. Er wird weltweit in Kliniken, Praxen und Studien als zuverlässiges Screening-Instrument eingesetzt.'
  ],
  [
    'Kann dieser Online-Test eine ärztliche Diagnose stellen?',
    'Nein. Der PHQ-9 ist ein orientierendes Screening-Instrument und kein Ersatz für eine fachärztliche oder psychotherapeutische Untersuchung. Eine formale Diagnose erfordert eine umfassende klinische Exploration, die Dauer, Leidensdruck, biografische Anamnese und organische Ausschlusskriterien einbezieht.'
  ],
  [
    'Wie ist ein Gesamtwert zwischen 10 und 14 Punkten zu bewerten?',
    'Ein Score von 10 bis 14 Punkten entspricht einer mittelgradigen depressiven Symptomatik. Ab diesem Schwellenwert wird eine professionelle Abklärung durch einen Arzt oder Psychotherapeuten empfohlen, da strukturierte Behandlungsansätze (z. B. Psychotherapie) in diesem Bereich nachweislich wirksam sind.'
  ],
  [
    'Was bedeutet es, wenn Frage 9 positiv beantwortet wird?',
    'Frage 9 erfasst Gedanken an Selbstabwertung, Todeswünsche oder Selbstverletzung. Jede Antwort über 0 Punkten aktiviert ein wichtiges Sicherheitsflag, unabhängig von der Gesamtsumme. Es zeigt, dass emotionale Not vorliegt, die dringend im persönlichen Gespräch mit einem Facharzt, Therapeuten oder einer Krisen-Hotline besprochen werden sollte.'
  ],
  [
    'Warum gibt es eine 10. Zusatzfrage zur Alltagsbeeinträchtigung?',
    'Frage 10 bewertet die funktionale Beeinträchtigung: Wie schwer die Symptome Arbeit, Haushalt oder soziale Kontakte einschränken. Diese Frage fließt nicht in den Summenscore von 0–27 ein, liefert Behandlern jedoch wichtige Hinweise auf den tatsächlichen Schweregrad im Lebensalltag.'
  ],
  [
    'Wie unterscheidet sich eine Depression von Trauer oder Burnout?',
    'Normale Trauer ist eine gesunde Reaktion auf Verluste und lässt wellenförmig nach. Burnout ist primär an chronische Überlastung im Beruf gebunden und bessert sich durch Entlastung. Eine depressive Episode hingegen ist durch anhaltende Freudlosigkeit (Anhedonie), Wertlosigkeitsgefühle und neurovegetative Symptome (Schlaf- und Appetitstörungen) gekennzeichnet, die kontextübergreifend anhalten.'
  ],
  [
    'Wie oft sollte der PHQ-9 wiederholt werden?',
    'Im Verlauf einer Behandlung oder zur Verlaufskontrolle wird der PHQ-9 häufig im Abstand von 2 bis 4 Wochen wiederholt, um Veränderungen objektiv messbar zu machen. Eine Veränderung von 5 oder mehr Punkten gilt dabei als klinisch bedeutsam.'
  ]
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Online-Depressionstest (PHQ-9 Fragebogen)',
    url: canonicalUrl,
    inLanguage: 'de',
    medicalAudience: 'Patient',
    aspect: 'Screening',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Depressive Episode',
      alternateName: ['Depression', 'Major Depression', 'Depressive Störung'],
      code: { '@type': 'MedicalCode', code: 'F32', codingSystem: 'ICD-10' }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Online-Depressionstest & PHQ-9 Screening',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'All',
    inLanguage: 'de',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    accessibilitySummary: 'Tastaturnavigation (Ziffern 1–4, Pfeiltasten), Notfall-Kriseninterstitial, Screenreader-Unterstützung und druckbarer Befundbericht.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://freeiqexam.com/de/' },
      { '@type': 'ListItem', position: 2, name: 'Selbsttests', item: 'https://freeiqexam.com/de/#tests' },
      { '@type': 'ListItem', position: 3, name: 'Online-Depressionstest (PHQ-9)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'PHQ-9 Depressionsfragebogen — 9 Fragen',
    url: canonicalUrl,
    inLanguage: 'de',
    numberOfQuestions: 9,
    isAccessibleForFree: true,
    about: { '@type': 'MedicalCondition', name: 'Depressive Episode' }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="de"
>
  <Header currentPath="/de/depressionstest" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-[#000000] dark:text-white transition-colors duration-200">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/de/" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Startseite</a>
        <span aria-hidden="true">/</span>
        <span class="text-zinc-600 dark:text-zinc-300">Selbsttests</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white font-semibold">Depressionstest</span>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-[#2997ff] sm:text-sm">
          <svg class="w-4 h-4 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          PHQ-9 · Standardisiertes Orientierungsinstrument
        </div>

        <h1 class="mt-6 font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em]">
          Online-Depressionstest: PHQ-9 Selbsttest &amp; Orientierung
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Führen Sie den standardisierten Patient Health Questionnaire-9 (PHQ-9) durch. Neun gezielte Fragen, unmittelbare Auswertung auf einer Skala von 0 bis 27 Punkten, Aufschlüsselung nach Symptombereichen und integrierte Krisenhilfen – vertraulich, kostenlos und ohne Registrierung.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['9 klinische Fragen', '2-Wochen-Zeitraum', 'Sofortiger Score 0–27', 'Integrierte Krisenhilfen', 'Keine Anmeldung erforderlich'].map((item) => (
            <span class="rounded-full border border-zinc-200 bg-zinc-50/80 px-4 py-2 text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 shadow-sm">{item}</span>
          ))}
        </div>
      </header>

      <!-- Main Screener App Container -->
      <section id="depression-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/90 p-5 dark:border-zinc-800 dark:bg-zinc-950 p-6 sm:p-9 shadow-sm">

          <!-- Assessment Intro -->
          <div id="assessment-intro" class="rounded-[1.5rem] border border-blue-200 bg-blue-50/70 p-6 dark:border-blue-900/50 dark:bg-blue-950/20 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Hinweis vor Beginn</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Orientierender Selbsttest — keine Diagnose</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Beantworten Sie die folgenden Fragen danach, wie oft Sie sich in den <strong>letzten zwei Wochen</strong> durch die beschriebenen Beschwerden beeinträchtigt gefühlt haben. Alle Eingaben bleiben ausschließlich lokal in Ihrem Browser und werden nicht übertragen oder gespeichert.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <button
                id="begin-assessment"
                type="button"
                class="rounded-full bg-[#0066cc] hover:bg-[#0055b3] text-white px-8 py-4 text-base font-semibold shadow-sm transition-all duration-150 hover:scale-[1.02] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              >
                PHQ-9 Selbsttest starten
              </button>
              <span class="text-sm text-zinc-500 dark:text-zinc-400">Tastatur: 1–4 zum Antworten · Pfeiltasten zum Navigieren</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-xs sm:text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200">
              <strong>Befinden Sie sich in einer akuten Notlage?</strong> Bitte wenden Sie sich umgehend an den Notruf 112 oder die TelefonSeelsorge (0800 111 0 111 / 0800 111 0 222). Dieser Selbsttest ist kein Notfalldienst.
            </p>
          </div>

          <!-- Questionnaire Section -->
          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">PHQ-9 · Letzte 2 Wochen</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-800 dark:text-zinc-200">Affektiv · Stimmung &amp; Freude</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold text-zinc-900 dark:text-white sm:text-lg">Frage 1 von 9</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">0 % beantwortet</div>
              </div>
            </div>

            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
              <div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:4%"></div>
            </div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <div class="flex flex-wrap gap-2 text-xs sm:text-sm font-semibold text-zinc-500 dark:text-zinc-400">
                <span class="rounded-full border border-zinc-200 px-3 py-1 dark:border-zinc-700">Eine Antwort auswählen</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1 dark:border-zinc-700">Wie oft wurden Sie beeinträchtigt durch:</span>
              </div>

              <h2 id="question-heading" class="mt-6 text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white"></h2>
              <p id="question-context" class="mt-3 text-sm sm:text-base text-zinc-500 dark:text-zinc-400"></p>

              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Antwortoptionen Häufigkeit"></div>

              <p id="question-safety-note" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-xs sm:text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200">
                Diese Frage wird standardmäßig gestellt. Antworten Sie offen: Falls Sie eine Belastung angeben, werden Ihnen unmittelbar kostenfreie Hilfs- und Notfallkontakte angezeigt.
              </p>

              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button
                  id="back-button"
                  type="button"
                  class="rounded-full border border-zinc-300 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 hover:bg-zinc-50 transition active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200"
                >
                  Zurück
                </button>
                <button
                  id="next-button"
                  type="button"
                  class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition hover:bg-black active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-900"
                >
                  Nächste Frage
                </button>
              </div>
            </article>
          </section>

          <!-- Crisis Interstitial Modal (Triggers on Item 9 > 0) -->
          <section id="crisis-interstitial" class="hidden" role="alertdialog" aria-labelledby="crisis-interstitial-title" aria-describedby="crisis-interstitial-body">
            <div class="rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-9 shadow-lg">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Wichtiger Sicherheitshinweis</p>
              <h2 id="crisis-interstitial-title" class="mt-3 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100 sm:text-3xl">Danke für Ihre ehrliche Antwort</h2>
              <p id="crisis-interstitial-body" class="mt-4 text-base leading-relaxed text-red-950 dark:text-red-100 sm:text-lg">
                Sie haben angegeben, dass Sie an Selbstabwertung, Lebensüberdruss oder Selbstverletzung gedacht haben. Solche Gedanken sind ein Anzeichen großer seelischer Belastung – Sie müssen diese Last nicht alleine tragen. Es gibt professionelle, vertrauliche und kostenfreie Unterstützung:
              </p>

              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                <li class="crisis-line">
                  <span class="crisis-flag"><span class="badge-flag">DE</span> Deutschland</span>
                  <strong>0800 111 0 111 / 0800 111 0 222</strong>
                  <span>TelefonSeelsorge · 24/7 · kostenfrei &amp; anonym</span>
                </li>
                <li class="crisis-line">
                  <span class="crisis-flag"><span class="badge-flag">DE</span> Ärztlicher Bereitschaftsdienst</span>
                  <strong>116 117</strong>
                  <span>Kassenärztlicher Bereitschaftsdienst Deutschland</span>
                </li>
                <li class="crisis-line">
                  <span class="crisis-flag"><span class="badge-flag">AT</span> Österreich</span>
                  <strong>142</strong>
                  <span>Telefonseelsorge Österreich · rund um die Uhr</span>
                </li>
                <li class="crisis-line">
                  <span class="crisis-flag"><span class="badge-flag">CH</span> Schweiz</span>
                  <strong>143</strong>
                  <span>Die Dargebotene Hand · 24/7 Notfallkontakt</span>
                </li>
                <li class="crisis-line sm:col-span-2">
                  <span class="crisis-flag">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                    </svg>
                    International &amp; Akutnotfall
                  </span>
                  <strong>Notruf: 112 (EU/CH) | findahelpline.com</strong>
                  <span>Bei akuter Selbstgefährdung wählen Sie sofort den Notruf 112</span>
                </li>
              </ul>

              <div class="mt-8">
                <button
                  id="crisis-continue"
                  type="button"
                  class="rounded-full bg-red-700 hover:bg-red-800 text-white px-8 py-4 text-base font-semibold shadow-sm transition active:scale-[0.97]"
                >
                  Ich habe diesen Hinweis gelesen — weiter zur Auswertung
                </button>
              </div>
            </div>
          </section>

          <!-- Results Section -->
          <section id="results-section" class="hidden" aria-labelledby="results-title">

            <!-- Crisis Banner in Results -->
            <div id="crisis-banner" class="hidden mb-6 rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-8 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Sofortige Unterstützung verfügbar</p>
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100">Hinweis zu Frage 9 (Sicherheitsaspekt)</h3>
              <p class="mt-3 text-base leading-relaxed text-red-950 dark:text-red-100">
                Unabhängig von Ihrer Gesamtpunktzahl gilt die Angabe von suizidalen Gedanken oder Selbstverletzungsimpulsen als wichtiges Signal. Bitte nutzen Sie die kostenfreien Krisenangebote (TelefonSeelsorge: 0800 111 0 111 / 116 117 / Notruf 112 in Deutschland, 142 in Österreich, 143 in der Schweiz).
              </p>
            </div>

            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div id="result-badge" class="result-badge minimal">Minimal</div>
                  <h2 id="results-title" class="mt-5 text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">Ihre PHQ-9 Auswertung</h2>
                  <p id="result-classification" class="mt-2 text-xl font-bold text-[#0066cc] dark:text-[#2997ff]">—</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-xs sm:text-sm font-semibold text-zinc-600 dark:border-zinc-800 dark:bg-zinc-800 dark:text-zinc-300">
                  Keine ärztliche Diagnose
                </div>
              </div>

              <p id="result-narrative" class="mt-6 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg"></p>

              <!-- Scores Grid -->
              <div class="mt-8 grid gap-4 sm:grid-cols-4">
                <article class="score-card">
                  <div class="score-label">Gesamtwert (PHQ-9)</div>
                  <div id="total-score" class="mt-3 text-3xl font-extrabold text-zinc-900 dark:text-white">0 / 27</div>
                  <div id="total-status" class="score-status">Minimal</div>
                  <div class="meter"><span id="total-bar"></span></div>
                </article>
                <article class="score-card">
                  <div class="score-label">Stimmung &amp; Freude</div>
                  <div id="affective-score" class="mt-3 text-3xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div class="score-status text-xs text-zinc-500 mt-1">Affektive Achse</div>
                  <div class="meter"><span id="affective-bar"></span></div>
                </article>
                <article class="score-card">
                  <div class="score-label">Schlaf, Energie &amp; Appetit</div>
                  <div id="somatic-score" class="mt-3 text-3xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div class="score-status text-xs text-zinc-500 mt-1">Somatische Achse</div>
                  <div class="meter"><span id="somatic-bar"></span></div>
                </article>
                <article class="score-card">
                  <div class="score-label">Fokus &amp; Psychomotorik</div>
                  <div id="cognitive-score" class="mt-3 text-3xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div class="score-status text-xs text-zinc-500 mt-1">Kognitive Achse</div>
                  <div class="meter"><span id="cognitive-bar"></span></div>
                </article>
              </div>

              <!-- Functional Impairment Box -->
              <div class="mt-6 rounded-2xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-800/60">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                  <span class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Alltägliche Beeinträchtigung (Item 10):</span>
                  <span id="functional-status" class="font-bold text-zinc-900 dark:text-white">Überhaupt nicht erschwert</span>
                </div>
              </div>

              <!-- Recommendations Section -->
              <div class="mt-8 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white sm:text-2xl">Empfohlene nächste Schritte</h3>
                <ul id="recommendations-list" class="mt-4 list-disc pl-5 space-y-2 text-base text-zinc-700 dark:text-zinc-300"></ul>
              </div>

              <!-- Action Buttons -->
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button
                  id="print-result"
                  type="button"
                  class="rounded-full bg-zinc-950 px-7 py-4 text-base font-semibold text-white dark:bg-white dark:text-zinc-950 hover:opacity-90 transition active:scale-[0.97]"
                >
                  Ärztlichen Vorab-Befund drucken
                </button>
                <button
                  id="share-result"
                  type="button"
                  class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800 transition active:scale-[0.97]"
                >
                  Ergebnis kopieren
                </button>
                <button
                  id="retake-result"
                  type="button"
