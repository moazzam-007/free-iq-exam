---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  en: "https://freeiqexam.com/color-blind-test",
  ru: "https://freeiqexam.com/ru/color-blind-test",
  id: "https://freeiqexam.com/id/tes-buta-warna",
  fi: "https://freeiqexam.com/fi/varisokeustesti",
  de: "https://freeiqexam.com/de/farbsehtest"
};
const title = "Farbsehtest: Rot-Grün-Schwäche & Ishihara-Farbtest online | FreeIQExam";
const description = "Online-Farbsehtest zur Orientierung bei Rot-Grün-Schwäche und Farbfehlsichtigkeiten mit digitalen Ishihara-Farbtafeln.";
const canonicalUrl = "https://freeiqexam.com/de/farbsehtest";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Ishihara-Farbsehtest online",
    "description": "Digitaler Ishihara-Test zur orientierenden Überprüfung auf Rot-Grün-Schwäche (Deuteranopie, Protanopie) und Farbsehstörungen im Browser.",
    "url": "https://freeiqexam.com/de/farbsehtest",
    "medicalAudience": "Patient",
    "aspect": "Diagnostic",
    "inLanguage": "de"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Online-Farbsehtest",
    "url": "https://freeiqexam.com/de/farbsehtest",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript and HTML5 Canvas/SVG support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "22 standardisierte Ishihara-Farbtafeln",
      "Orientierende Erkennung von Rot-Grün-Schwäche (Deutan/Protan)",
      "Interaktiver Farbseh-Simulator für verschiedene Farbspektrumsdefizite",
      "Kindgerechter Symbolmodus mit geometrischen Formen",
      "Aufschlüsselung der L-, M- und S-Zapfenempfindlichkeit",
      "Wissenschaftlicher Hintergrund und druckbarer Ergebnisbericht"
    ],
    "inLanguage": "de"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://freeiqexam.com/de"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Werkzeuge",
        "item": "https://freeiqexam.com/de/farbsehtest"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Farbsehtest",
        "item": "https://freeiqexam.com/de/farbsehtest"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="de"
>
  <Header />

  <!-- CVD SVG Simulation Filter Matrices (Hidden in DOM, referenced by CSS) -->
  <svg class="hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="deutan-filter">
      <feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0" />
    </filter>
    <filter id="protan-filter">
      <feColorMatrix type="matrix" values="0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0" />
    </filter>
    <filter id="tritan-filter">
      <feColorMatrix type="matrix" values="0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0" />
    </filter>
  </svg>

  <style>
    .plate-container {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    @keyframes pilestonePop {
      0% { transform: scale(1); }
      30% { transform: scale(0.96); opacity: 0.9; }
      70% { transform: scale(1.02); opacity: 0.98; }
      100% { transform: scale(1); opacity: 1; }
    }

    .pilestone-transition {
      animation: pilestonePop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .timeline-dot {
      transition: all 0.25s ease;
    }

    .plate-dot {
      vector-effect: non-scaling-stroke;
      shape-rendering: geometricPrecision;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    .filter-normal { filter: none; }
    .filter-deutan { filter: url('#deutan-filter'); }
    .filter-protan { filter: url('#protan-filter'); }
    .filter-tritan { filter: url('#tritan-filter'); }
    .filter-achroma { filter: grayscale(100%); }

    @media print {
      header, footer, #calibration-banner, #keypad-numbers, #keypad-kids, .mode-toggle-container, #btn-restart-link, .no-print {
        display: none !important;
      }
      #results-view {
        display: flex !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/de" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Startseite</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-500 dark:text-zinc-400">Werkzeuge</span>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Farbsehtest</span>
    </nav>

    <!-- Page Header & Eyebrow -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs sm:text-sm font-mono font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>FARBSINN-ORIENTIERUNGSTEST • 22 Ishihara-Tafeln</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Farbsehtest: Rot-Grün-Schwäche &amp; Ishihara-Test
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
        Erkennen Sie verborgene Zahlen und Symbole in standardisierten <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">Ishihara-Farbtafeln</strong>. Der Test liefert eine zuverlässige Selbsteinschätzung auf <strong class="text-emerald-600 dark:text-emerald-400 font-bold">Rot-Grün-Schwäche</strong> und Farbwahrnehmungsstörungen.
      </p>
      
      <!-- MANDATORY SENSORY SAFETY DISCLAIMER -->
      <p class="text-xs sm:text-sm text-amber-800 dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 rounded-xl px-4 py-3 mt-4 max-w-2xl mx-auto leading-relaxed">
        <strong>Medizinischer Hinweis:</strong> Dieser Online-Sehtest / Hörtest dient rein als orientierende Selbsteinschätzung für den Heimgebrauch und ersetzt keine professionelle augenärztliche oder HNO-ärztliche Untersuchung.
      </p>
    </header>

    <!-- PRE-TEST DISPLAY CALIBRATION ADVISORY -->
    <div id="calibration-banner" class="max-w-3xl mx-auto mb-8 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
          <div class="space-y-1">
            <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Bildschirm-Vorbereitung für genaue Farberkennung</h4>
            <p class="text-amber-800 dark:text-amber-300/90 text-sm leading-relaxed">
              Für ein unverfälschtes Ergebnis: <strong>1)</strong> Bildschirmhelligkeit auf ca. 80–100 % stellen, <strong>2)</strong> Blaulichtfilter, Night Shift oder TrueTone deaktivieren und <strong>3)</strong> einen Betrachtungsabstand von ca. 50–75 cm einhalten.
            </p>
          </div>
        </div>
        <button id="btn-dismiss-calibration" type="button" class="text-amber-600 dark:text-amber-400 hover:text-amber-950 dark:hover:text-white p-1 cursor-pointer min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Kalibrierungshinweis schließen">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- TEST MODE TOGGLE (STANDARD NUMBERS VS KIDS SHAPES) -->
    <div class="mode-toggle-container max-w-md mx-auto mb-8 flex items-center justify-center p-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs font-medium text-xs sm:text-sm">
      <button id="mode-btn-numbers" type="button" class="flex-1 py-3 px-4 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-bold shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.97]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /><line x1="10" y1="3" x2="8" y2="21" /><line x1="16" y1="3" x2="14" y2="21" /></svg><span>Zahlenmodus (22 Tafeln)</span>
      </button>
      <button id="mode-btn-kids" type="button" class="flex-1 py-3 px-4 rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.97]">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg><span>Kindermodus (Symbole)</span>
      </button>
    </div>

    <!-- INTERACTIVE TEST ARENA CARD -->
    <div class="relative w-full max-w-4xl mx-auto">
      <div id="test-card" class="plate-container w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl flex flex-col items-center">
        
        <!-- Header Bar with Brand & Plate Progress -->
        <div class="w-full flex items-center justify-between pb-4 mb-6 text-xs sm:text-sm font-mono border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <span class="font-heading font-extrabold tracking-wider uppercase text-zinc-900 dark:text-zinc-100 text-xs sm:text-sm">
              FREE<span class="text-[#0066cc] dark:text-[#2997ff]">IQ</span>EXAM <span class="text-zinc-400 dark:text-zinc-500 font-normal">ISHIHARA</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span id="plate-counter-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-zinc-100 dark:bg-zinc-800 text-[#0066cc] dark:text-[#2997ff] border border-zinc-200 dark:border-zinc-700">
              TAFEL 1 / 22
            </span>
          </div>
        </div>

        <!-- 22-Plate Connected Timeline Progress Bar -->
        <div class="w-full mb-8 px-1 sm:px-4">
          <div id="timeline-chain" class="relative flex items-center justify-between w-full h-8">
            <div class="absolute left-2 right-2 top-1/2 -translate-y-1/2 h-[2px] bg-zinc-200 dark:bg-zinc-800 z-0"></div>
            <div id="timeline-dots" class="relative z-10 flex items-center justify-between w-full"></div>
          </div>
        </div>

        <!-- ACTIVE TESTING ARENA (SIDE-BY-SIDE ON DESKTOP, STACKED ON MOBILE) -->
        <div id="active-test-view" class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-14 my-2">
          
          <!-- High-DPI Procedural 764-Circle Ishihara SVG Stage -->
          <div id="plate-stage" class="relative w-[300px] sm:w-[380px] lg:w-[440px] aspect-square rounded-full bg-zinc-100 dark:bg-[#18181c] p-2 shadow-2xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center shrink-0">
            <svg id="plate-svg" class="w-full h-full rounded-full block cursor-pointer select-none" viewBox="0 0 666 666" role="img" aria-label="Ishihara-Farbsehtest Tafel" xmlns="http://www.w3.org/2000/svg">
              <circle cx="333" cy="333" r="328" fill="#121215"></circle>
              <g id="plate-dots"></g>
            </svg>
          </div>

          <!-- Keypad & Touch Controls Column -->
          <div class="flex flex-col items-center justify-center w-full max-w-[300px]">
            <!-- Instruction Prompt -->
            <div class="text-center mb-5">
              <p id="prompt-main-text" class="text-xs sm:text-sm font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-300 font-semibold mb-1">Welche Zahl sehen Sie?</p>
              <p id="prompt-sub-text" class="text-xs text-zinc-400 dark:text-zinc-500">Tastatur: [1-9], [N] Keine Zahl, [U] Unsicher</p>
            </div>

            <!-- NUMBERS MODE KEYPAD (1-9, NOTHING, NOT SURE) -->
            <div id="keypad-numbers" class="w-full flex flex-col items-center">
              <div class="grid grid-cols-3 gap-3 w-full mb-3">
                <button type="button" data-val="1" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">1</button>
                <button type="button" data-val="2" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">2</button>
                <button type="button" data-val="3" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">3</button>
                <button type="button" data-val="4" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">4</button>
                <button type="button" data-val="5" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">5</button>
                <button type="button" data-val="6" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">6</button>
                <button type="button" data-val="7" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">7</button>
                <button type="button" data-val="8" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">8</button>
                <button type="button" data-val="9" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">9</button>
              </div>

              <!-- Action Row: NOTHING / NOT SURE -->
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="nothing" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  Keine Zahl
                </button>
                <button type="button" data-val="unsure" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  Unsicher
                </button>
              </div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">Nächste Tafel erfolgt automatisch nach Auswahl</p>
            </div>

            <!-- KIDS & SHAPES MODE KEYPAD (CIRCLE, SQUARE, TRIANGLE, STAR) -->
            <div id="keypad-kids" class="w-full flex flex-col items-center hidden">
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="Circle" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-emerald-500/40 hover:border-emerald-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-emerald-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="currentColor" /></svg></span><span>Kreis</span>
                </button>
                <button type="button" data-val="Square" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-blue-500/40 hover:border-blue-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-blue-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="2" fill="currentColor" /></svg></span><span>Quadrat</span>
                </button>
                <button type="button" data-val="Triangle" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-amber-500/40 hover:border-amber-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-amber-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polygon points="12 4 21 20 3 20" fill="currentColor" /></svg></span><span>Dreieck</span>
                </button>
                <button type="button" data-val="Star" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-purple-500/40 hover:border-purple-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-purple-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor" /></svg></span><span>Stern</span>
                </button>
              </div>

              <button type="button" data-val="nothing" class="shape-btn w-full h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center mb-4 cursor-pointer">
                <span class="inline-flex items-center gap-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /></svg>Keine Form erkennbar</span>
              </button>
            </div>

            <!-- Restart Test Link -->
            <button id="btn-restart-link" type="button" class="text-xs sm:text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white underline underline-offset-4 transition-colors cursor-pointer py-1">
              Test von vorne beginnen
            </button>
          </div>
        </div>

        <!-- DIAGNOSTIC RESULTS REPORT VIEWPORT -->
        <div id="results-view" class="w-full hidden flex flex-col items-center">
