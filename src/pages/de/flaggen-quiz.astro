---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  'en': 'https://freeiqexam.com/flag-quiz',
  'ru': 'https://freeiqexam.com/ru/flag-quiz',
  'id': 'https://freeiqexam.com/id/kuis-bendera',
  'de': 'https://freeiqexam.com/de/flaggen-quiz'
};

const title = "Flaggen-Quiz: Länderflaggen erkennen & Gedächtnis trainieren | FreeIQExam";
const description = "Testen Sie Ihr Wissen über die Flaggen aller Länder weltweit. Ein interaktives Geografie- und Gedächtnisquiz mit Sofortfeedback.";
const canonicalUrl = "https://freeiqexam.com/de/flaggen-quiz";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Flaggen-Quiz & Geografie-Gedächtnis-Arena",
    "url": "https://freeiqexam.com/de/flaggen-quiz",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "inLanguage": "de",
    "browserRequirements": "Erfordert JavaScript-Unterstützung",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Datenbank aller 195+ von den Vereinten Nationen anerkannten Staaten",
      "4 Spielmodi: 20-Fragen-Sprint, Überlebensmodus, Umkehrmodus und Vexillologie-Schwer",
      "Kontinentale Filter (Alle, Europa, Asien, Amerika, Afrika, Ozeanien)",
      "Dynamische Reaktionszeitmessung in Millisekunden",
      "Streak-Multiplikator & Web Audio Sound-Synthese",
      "Detaillierte Fehler- und Wissensanalyse"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://freeiqexam.com/de"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Spiele",
        "item": "https://freeiqexam.com/de"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Flaggen-Quiz",
        "item": "https://freeiqexam.com/de/flaggen-quiz"
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="de">
  <Header currentPath="/de/flaggen-quiz" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    
    <!-- Hero Header -->
    <section class="relative pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center overflow-hidden">
      <!-- Navigation Breadcrumb -->
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
        <a href="/de" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Startseite</a>
        <span>/</span>
        <span class="text-zinc-500">Spiele</span>
        <span>/</span>
        <span class="text-zinc-800 dark:text-zinc-200">Flaggen-Quiz</span>
      </nav>

      <!-- Badge Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-[#0066cc] dark:text-[#2997ff] text-xs font-bold tracking-wide uppercase mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        Räumliche Geografie &bull; Visuelles Gedächtnistraining
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] mb-4">
        Flaggen-Quiz: <span class="text-[#0066cc] dark:text-[#2997ff]">Länderflaggen erkennen</span>
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-6">
        Testen Sie Ihre visuelle Mustererkennung und Ihr geografisches Wissen an über 195 Ländern weltweit. Messen Sie Ihre Reaktionszeit und meistern Sie selbst kniffligste Zwillingsflaggen.
      </p>

      <!-- Feature Chips -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-600 dark:text-zinc-400">
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">195+</span> Staaten
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">4</span> Spielmodi
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">ms</span> Reaktionsmessung
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-emerald-500 font-bold">100%</span> Kostenlos &bull; Ohne Anmeldung
        </span>
      </div>
    </section>

    <!-- Interactive Flag Quiz Arena -->
    <section class="px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto mb-16">
      <div class="relative rounded-3xl bg-zinc-50 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 shadow-2xl p-6 sm:p-8 backdrop-blur-xl transition-all">

        <!-- 1. START / CONFIGURATION CARD -->
        <div id="flagStartCard" class="space-y-6">
          
          <div class="text-center space-y-2">
            <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white tracking-tight">Quiz-Einstellungen wählen</h2>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">Wählen Sie den gewünschten Spielmodus und den regionalen Filter.</p>
          </div>

          <!-- Mode Selector Grid -->
          <div class="space-y-2">
            <label class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Spielmodus wählen</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <button type="button" data-mode="sprint" class="flag-mode-btn active p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border-2 border-[#0066cc] dark:border-[#2997ff] text-[#0066cc] dark:text-[#2997ff] text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">20-Fragen-Sprint</span>
                  <span class="text-xs font-mono opacity-80">Standard</span>
                </div>
                <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">Standardisierte 20-Runden-Prüfung für Treffsicherheit und schnelle Reaktionszeit.</p>
              </button>

              <button type="button" data-mode="survival" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Endlos-Überlebensmodus</span>
                  <span class="text-xs font-mono text-rose-500">Sudden Death</span>
                </div>
                <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">Spielen Sie so lange, bis der erste Fehler passiert. Mit steigendem Punkte-Multiplikator.</p>
              </button>

              <button type="button" data-mode="reverse" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Umgekehrter Modus</span>
                  <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff]">Name &rarr; Flagge</span>
                </div>
                <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">Finden Sie anhand des Ländernamens und der Hauptstadt die passende Flagge unter 4 Optionen.</p>
              </button>

              <button type="button" data-mode="hard" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Vexillologie-Schwer</span>
                  <span class="text-xs font-mono text-amber-500">Zwillingsflaggen</span>
                </div>
                <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">Konfrontiert Sie gezielt mit verwechslungsgefährdeten Paaren (z.B. Tschad vs. Rumänien).</p>
              </button>
            </div>
          </div>

          <!-- Continent Filter -->
          <div class="space-y-2">
            <label for="flagContinentSelect" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Regionaler Filter</label>
            <div class="relative">
              <select id="flagContinentSelect" class="w-full p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-semibold text-zinc-900 dark:text-white focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors appearance-none cursor-pointer">
                <option value="all">Alle souveränen Staaten (195+ Länder)</option>
                <option value="Europe">Europa (44 Länder)</option>
                <option value="Asia">Asien (49 Länder)</option>
                <option value="Americas">Amerika (35 Länder)</option>
                <option value="Africa">Afrika (54 Länder)</option>
                <option value="Oceania">Ozeanien (14 Länder)</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-zinc-400 text-xs">▼</div>
            </div>
          </div>

          <!-- Start Action Button -->
          <button id="startFlagQuizBtn" type="button" class="w-full py-4 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-base tracking-wide uppercase transition-all duration-200 shadow-sm active:scale-[0.97] cursor-pointer">
            Quiz jetzt starten
          </button>
        </div>

        <!-- 2. LIVE GAMEPLAY ARENA CARD (Hidden by default) -->
        <div id="flagArenaCard" class="hidden space-y-6">
          
          <!-- Arena Header: Stats & Progress -->
          <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
            <div class="space-y-0.5">
              <span id="flagQuizProgress" class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Frage 1 / 20</span>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-zinc-700 dark:text-zinc-300">Punkte:</span>
                <span id="flagLiveScore" class="text-base font-extrabold font-mono text-[#0066cc] dark:text-[#2997ff]">0</span>
              </div>
            </div>

            <!-- Streak Combo Badge -->
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
              <span class="text-xs text-zinc-500 dark:text-zinc-400 font-sans">Serie:</span>
              <span id="flagLiveStreak" class="text-sm font-extrabold font-mono text-amber-500">0x</span>
            </div>
          </div>

          <!-- Target Presentation (Flag or Reverse Question) -->
          <div class="flex flex-col items-center justify-center py-4 space-y-4">
            <!-- Normal Mode Flag Image -->
            <div class="relative p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl overflow-hidden max-w-sm w-full flex items-center justify-center min-h-[160px]">
              <img id="flagTargetImage" src="" alt="Länderflagge" class="max-h-40 w-auto rounded-lg shadow object-contain transition-transform duration-200" />
            </div>

            <!-- Reverse Mode Country Title (Hidden during normal mode) -->
            <h3 id="flagCountryTitle" class="hidden text-xl sm:text-2xl font-extrabold text-zinc-950 dark:text-white text-center tracking-tight"></h3>
          </div>

          <!-- Multiple Choice Options Grid -->
          <div id="flagOptionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Dynamically populated 4 options -->
          </div>

        </div>

        <!-- 3. DETAILED RESULTS SCORECARD (Hidden by default) -->
        <div id="flagResultsCard" class="hidden space-y-8">
          
          <!-- Hero Score Banner -->
          <div class="text-center space-y-2 p-6 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
            <span class="text-xs font-mono uppercase tracking-widest text-[#0066cc] dark:text-[#2997ff]">Quiz abgeschlossen</span>
            <div id="resFlagScore" class="text-4xl sm:text-6xl font-mono font-bold text-zinc-900 dark:text-white">
              0
            </div>
            <div class="flex items-center justify-center gap-2 pt-1">
              <span id="resFlagTier" class="px-3 py-1 rounded-full bg-blue-500/20 text-[#0066cc] dark:text-[#2997ff] font-extrabold text-xs tracking-wide">
                Großmeister der Vexillologie
              </span>
              <span id="resFlagPercentile" class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                Top 1% Perzentil
              </span>
            </div>
            <p id="resFlagDesc" class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-md mx-auto pt-2 leading-relaxed"></p>
          </div>

          <!-- Core Metric Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
            <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Genauigkeit</span>
              <div id="resFlagAccuracy" class="text-lg sm:text-xl font-bold font-mono text-zinc-950 dark:text-white">0%</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Reaktionszeit</span>
              <div id="resFlagReaction" class="text-lg sm:text-xl font-bold font-mono text-[#0066cc] dark:text-[#2997ff]">0ms</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Richtig</span>
              <div id="resFlagCorrect" class="text-lg sm:text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400">0 / 0</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Max. Serie</span>
              <div id="resFlagMaxStreak" class="text-lg sm:text-xl font-bold font-mono text-amber-500">0x</div>
            </div>
          </div>

          <!-- Regional Mastery Breakdown -->
          <div class="space-y-3">
            <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-400">Regionale Erfolgsquote</h4>
            <div id="resFlagRegionsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- Dynamically populated progress bars -->
            </div>
          </div>

          <!-- Missed Flags Review Section -->
          <div id="resFlagMissedWrap" class="hidden space-y-3">
            <h4 class="text-xs font-mono uppercase tracking-wider text-rose-500">Verpasste Flaggen zur Wiederholung</h4>
            <div id="resFlagMissedList" class="space-y-2 max-h-60 overflow-y-auto pr-1">
              <!-- Dynamically populated missed flag rows -->
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <button id="retakeFlagQuizBtn" type="button" class="flex-1 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-sm uppercase tracking-wider transition-all duration-200 shadow-sm active:scale-[0.97] cursor-pointer">
              Erneut spielen
            </button>
            <a href="/de" class="py-3.5 px-6 rounded-2xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-900 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-center text-sm font-bold text-zinc-700 dark:text-zinc-300 transition-colors">
              Alle Tools
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- Comprehensive Educational Guide -->
    <article class="px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto pb-24 text-zinc-700 dark:text-zinc-300 leading-relaxed space-y-12">
      
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white tracking-tight border-b border-zinc-200 dark:border-zinc-800 pb-3">
          1. Kognition &amp; visuelles Gedächtnis beim Erkennen von Flaggen
        </h2>
        <p>
          Das visuelle Gedächtnis des Menschen verarbeitet geometrische Formen, Farbkontraste und räumliche Anordnungen parallel über den primären visuellen Kortex (V1 bis V4). Das Erkennen von Länderflaggen stützt sich auf <strong>Paivios Dual-Coding-Theorie</strong>, bei der Bildinformationen und semantisches Wissen (Ländername, Kontinent, Hauptstadt) gleichzeitig im Gedächtnis verknüpft werden.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white tracking-tight border-b border-zinc-200 dark:border-zinc-800 pb-3">
          2. Die 5 Grundregeln des Flaggendesigns (Vexillologie)
        </h2>
        <p>
          Die North American Vexillological Association (NAVA) und führende Vexillologen definieren fünf universelle Kriterien für gelungenes Flaggendesign:
        </p>
        <div class="space-y-3 my-4">
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-[#0066cc] dark:text-[#2997ff]">01</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Einfachheit</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Die Flagge sollte so einfach sein, dass ein Kind sie aus dem Gedächtnis zeichnen kann (z.B. Japan, Schweiz).</p>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-[#0066cc] dark:text-[#2997ff]">02</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Bedeutungsvolle Symbolik</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Farben und Figuren stehen für die Geschichte, Kultur oder Natur des Landes.</p>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-[#0066cc] dark:text-[#2997ff]">03</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">2 bis 3 Grundfarben</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Verwendung kontrastreicher Primär- und Sekundärfarben (Rot, Blau, Gelb, Grün, Weiß, Schwarz).</p>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-[#0066cc] dark:text-[#2997ff]">04</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Keine Schriftzüge oder Staatssiegel</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Buchstaben und feingliedrige Wappen sind aus der Ferne oder im Wind unlesbar.</p>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-[#0066cc] dark:text-[#2997ff]">05</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Eigenständigkeit</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Vermeidung von Verwechslungen, außer bei bewusster regionaler Zusammengehörigkeit (z.B. Skandinavisches Kreuz).</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Accordion Section (Visible HTML Accordions only, no schema) -->
      <section class="pt-8 border-t border-zinc-200 dark:border-zinc-800">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-600 dark:text-zinc-400 uppercase tracking-wider mb-2">
            Häufige Fragen
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Fragen und Antworten zum Flaggen-Quiz
          </h2>
        </div>

        <div class="space-y-3">
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Wie wird die Punktzahl im Flaggen-Quiz berechnet?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Ihre Gesamtpunktzahl kombiniert Genauigkeit, millisekundengenaue Reaktionszeit und Serien-Multiplikatoren (Streaks). Schnelle, fehlerfreie Antworten bringen die höchste Punktzahl.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Warum sehen manche Flaggen fast identisch aus (z.B. Tschad und Rumänien)?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Tschad und Rumänien teilen die vertikale Trikolore Blau-Gelb-Rot durch unabhängige historische Entwicklungen. Monaco und Indonesien nutzen dieselbe rot-weiße Bikolore, unterscheiden sich jedoch im Seitenverhältnis (Monaco 4:5 vs. Indonesien 2:3).
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Wie viele Länderflaggen sind in der Datenbank enthalten?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Die Datenbank umfasst alle 195+ von den Vereinten Nationen anerkannten souveränen Staaten weltweit, sortiert nach Kontinenten.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Trainiert das Flaggen-Quiz das visuelle Gedächtnis?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Ja. Die Kombination aus visuellen Farbmustern und semantischen Länderdaten stärkt die synaptischen Verknüpfungen im Langzeitgedächtnis.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Werden Spieldaten oder Ergebnisse auf externen Servern gespeichert?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Nein. Das gesamte Quiz und die Auswertung laufen zu 100% lokal in Ihrem Browser ab.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Kann ich das Quiz auf einzelne Kontinente einschränken?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Ja. Vor dem Start können Sie über das Dropdown-Menü gezielt nur Europa, Asien, Amerika, Afrika oder Ozeanien auswählen.
            </p>
          </details>
        </div>
      </section>

