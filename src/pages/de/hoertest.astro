  <!-- Pure Web Audio Client Engine Script -->
  <script src="../../scripts/tools/hearing-engine.js"></script>

  <script>
    // Patch German safety and UI labels after engine initializes
    (function() {
      const workspaceTitle = document.getElementById('workspaceTitle');
      const audEarLabel = document.getElementById('audEarLabel');
      const stepNum = document.getElementById('stepNum');
      const resultRating = document.getElementById('resultRating');
      const resultEarAgeDesc = document.getElementById('resultEarAgeDesc');

      if (workspaceTitle) {
        const mo = new MutationObserver(() => {
          const t = workspaceTitle.textContent || '';
          if (t === 'Ear Age Frequency Test') workspaceTitle.textContent = 'Biologischer Gehör-Alterstest';
          if (t === 'Pure-Tone Audiometry') workspaceTitle.textContent = 'Reinton-Audiometrie';
        });
        mo.observe(workspaceTitle, { childList: true, characterData: true, subtree: true });
      }

      if (audEarLabel) {
        const moEar = new MutationObserver(() => {
          const t = audEarLabel.textContent || '';
          if (t.includes('Left Ear')) audEarLabel.textContent = 'Linkes Ohr (Blau)';
          if (t.includes('Right Ear')) audEarLabel.textContent = 'Rechtes Ohr (Rot)';
        });
        moEar.observe(audEarLabel, { childList: true, characterData: true, subtree: true });
      }

      if (resultRating) {
        const moRating = new MutationObserver(() => {
          const t = resultRating.textContent || '';
          if (t === 'Exceptional') resultRating.textContent = 'Hervorragend';
          else if (t === 'Excellent') resultRating.textContent = 'Sehr gut';
          else if (t === 'Normal') resultRating.textContent = 'Altersentsprechend';
          else if (t === 'Mild Loss') resultRating.textContent = 'Leicht reduziert';
          else if (t === 'Moderate Loss') resultRating.textContent = 'Mäßig reduziert';
        });
        moRating.observe(resultRating, { childList: true, characterData: true, subtree: true });
      }

      if (resultEarAgeDesc) {
        const moDesc = new MutationObserver(() => {
          const t = resultEarAgeDesc.textContent || '';
          if (t.includes('exceptional high-frequency')) {
            resultEarAgeDesc.textContent = 'Hervorragendes Gehör im Hochtonbereich. Ihre Haarsinneszellen erfassen Frequenzen, die für junge gesunde Ohren typisch sind.';
          } else if (t.includes('typical of young')) {
            resultEarAgeDesc.textContent = 'Sehr gute Wahrnehmung hoher Frequenzen, typisch für junge Erwachsene. Schützen Sie Ihr Gehör weiterhin vor Lärm.';
          } else if (t.includes('mild high-frequency')) {
            resultEarAgeDesc.textContent = 'Leichte altersentsprechende Einschränkung im obersten Hochtonbereich. Normale Sprachfrequenzen sind davon in der Regel unberührt.';
          } else if (t.includes('moderate high-frequency')) {
            resultEarAgeDesc.textContent = 'Deutlichere Hochton-Einschränkung. Achten Sie auf Sprachverständlichkeit in lauter Umgebung und erwägen Sie einen Check beim HNO-Arzt.';
          }
        });
        moDesc.observe(resultEarAgeDesc, { childList: true, characterData: true, subtree: true });
      }
    })();
  </script>
