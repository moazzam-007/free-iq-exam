---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Kostenlose Online-Tests, Rechner & Kognitive Selbsttests | FreeIQExam Deutschland";
const description = "Entdecken Sie die deutschsprachigen Tools von FreeIQExam: Kalorienrechner, IQ-Tests, ADHS- und Depressionstests sowie sensorische Online-Tests ohne Anmeldung.";
const canonicalUrl = "https://freeiqexam.com/de/";
const alternates = {}; // Partial hub — no 1:1 homepage hreflang

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection-page`,
    "name": title,
    "url": canonicalUrl,
    "inLanguage": "de",
    "description": description,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 12,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Kalorienrechner & TDEE-Rechner", "url": "https://freeiqexam.com/de/kalorienrechner" },
        { "@type": "ListItem", "position": 2, "name": "Kostenloser IQ-Test (24 Aufgaben)", "url": "https://freeiqexam.com/de/iq-test" },
        { "@type": "ListItem", "position": 3, "name": "Mensa-Test Vorbereitung & Übungsaufgaben", "url": "https://freeiqexam.com/de/mensa-test" },
        { "@type": "ListItem", "position": 4, "name": "CPS-Test (Klick-Geschwindigkeitstest)", "url": "https://freeiqexam.com/de/spiele/klick-test" },
        { "@type": "ListItem", "position": 5, "name": "Tipptest (WPM Schreibgeschwindigkeit)", "url": "https://freeiqexam.com/de/tipptest" },
        { "@type": "ListItem", "position": 6, "name": "Flaggen-Quiz (Geografie-Gedächtnis)", "url": "https://freeiqexam.com/de/flaggen-quiz" },
        { "@type": "ListItem", "position": 7, "name": "ADHS-Test Erwachsene (WHO ASRS v1.1)", "url": "https://freeiqexam.com/de/adhs-test" },
        { "@type": "ListItem", "position": 8, "name": "Depressionstest (PHQ-9)", "url": "https://freeiqexam.com/de/depressionstest" },
        { "@type": "ListItem", "position": 9, "name": "Autismus-Test Erwachsene (AQ-10)", "url": "https://freeiqexam.com/de/autismus-test" },
        { "@type": "ListItem", "position": 10, "name": "Online-Sehtest (Snellen-Sehtafel)", "url": "https://freeiqexam.com/de/sehtest" },
        { "@type": "ListItem", "position": 11, "name": "Farbsehtest (Rot-Grün-Schwäche & Ishihara)", "url": "https://freeiqexam.com/de/farbsehtest" },
        { "@type": "ListItem", "position": 12, "name": "Online-Hörtest (Frequenzprüfung)", "url": "https://freeiqexam.com/de/hoertest" }
      ]
    }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="de"
>
  <Header currentPath="/de/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">

    <!-- HERO SECTION (Pure flat canvas — ZERO radial glow) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>FREEIQEXAM DEUTSCHLAND — 12 WERKZEUGE</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Kostenlose Tools &amp;<br />
          <span class="text-zinc-500 dark:text-zinc-400">
            kognitive Tests.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          Nützliche Berechnungen, kognitive Selbsttests und sensorische Online-Tests – direkt im Browser ohne Anmeldung.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/de/kalorienrechner"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97]"
          >
            Kalorienrechner öffnen
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CATEGORY 1: Gesundheit & Stoffwechsel -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategorie 1</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Gesundheit &amp; Stoffwechsel
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/de/kalorienrechner"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Kalorienrechner &amp; TDEE-Rechner
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Berechnen Sie Ihren geschätzten Grundumsatz (BMR) und täglichen Energiebedarf (TDEE) mit der Mifflin-St Jeor-Formel.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Rechner öffnen →
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 2: Kognition, IQ & Reaktionsspiele -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategorie 2</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Kognition, IQ &amp; Reaktionsspiele
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- IQ-Test -->
        <a
          href="/de/iq-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Kostenloser IQ-Test (24 Aufgaben)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              24-teiliger visueller Matrixschlusstest mit Zeitnahme und sofortiger Auswertung.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Test starten
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Mensa-Test -->
        <a
          href="/de/mensa-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Mensa-Test Vorbereitung &amp; Übungsaufgaben
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Umfassende Übungsanleitung und Grundlagen des Matrixdenkens zur Vorbereitung auf Intelligenztests.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Leitfaden öffnen
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- CPS-Test -->
        <a
          href="/de/spiele/klick-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 9 5 12 1.8-5.2L21 14Z" /><path d="M7.2 2.2 8 2.8" /><path d="M5.1 5.1l.2.1" /><path d="M3.4 9.5l.5.1" /><path d="M2.9 14.1l.5-.1" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              CPS-Test (Klick-Geschwindigkeitstest)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Messen Sie Ihre Klickgeschwindigkeit in Klicks pro Sekunde (CPS) mit 5-, 10- und 30-Sekunden-Tests.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Test starten
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Tipptest -->
        <a
          href="/de/tipptest"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="12" x="3" y="6" rx="2" /><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Tipptest (WPM Schreibgeschwindigkeit)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Messen Sie Ihre Schreibgeschwindigkeit und Genauigkeit in Wörtern pro Minute (WPM).
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Test starten
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Flaggen-Quiz -->
        <a
          href="/de/flaggen-quiz"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" /><line x1="4" x2="4" y1="22" y2="15" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Flaggen-Quiz (Geografie-Gedächtnis)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Trainieren Sie Ihr visuelles Gedächtnis mit Länderflaggen aus aller Welt.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Quiz starten
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 3: Gesundheitliche Selbsttests (YMYL Safe) -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategorie 3</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Gesundheitliche Selbsttests
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Orientierende Selbsttests zur Betrachtung von Symptomen und Stimmung. Ersetzen keine ärztliche Diagnose.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- ADHS-Test -->
        <a
          href="/de/adhs-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Aktiv
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              ADHS-Test Erwachsene (ASRS v1.1)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Orientierende Selbsteinschätzung anhand des standardisierten WHO ASRS v1.1-Fragebogens.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Test starten
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Depressionstest -->
        <a
          href="/de/depressionstest"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
