---
import Layout from '../../layouts/Layout.astro';
import { getStandardTestSet } from '../../data/questions';

const title = "Kostenloser IQ-Test Online: 24 Fragen mit Sofortauswertung | FreeIQExam";
const description = "Absolvieren Sie den 24-teiligen Matrix-Intelligenztest online. Kognitiver Kurztest mit automatischer Auswertung in 20 Minuten ohne Registrierung.";
const canonicalUrl = "https://freeiqexam.com/de/iq-test";

const alternates = {
  'en': 'https://freeiqexam.com/test',
  'ru': 'https://freeiqexam.com/ru/test',
  'id': 'https://freeiqexam.com/id/tes',
  'fi': 'https://freeiqexam.com/fi/alykkyystesti',
  'de': 'https://freeiqexam.com/de/iq-test'
};

// Sample 24 items (6 per CHC domain) on the server.
const selectedItems = getStandardTestSet();

const sanitizedBank = selectedItems.map((q) => ({
  id: q.id,
  domain: q.domain,
  subType: q.subType,
  domainLabel: q.domainLabel,
  promptType: q.promptType,
  promptText: q.promptText,
  promptSvg: q.promptSvg ?? null,
  a: q.a,
  b: q.b,
  options: q.options.map((opt) => ({
    id: opt.id,
    text: opt.text ?? '',
    svgContent: opt.svgContent ?? null,
  })),
}));

const bankJson = JSON.stringify(sanitizedBank);

// Obfuscated scoring answer key token: questionId -> { c: correctOptionId, exp: explanation }
const answerKeyToken = Buffer.from(
  JSON.stringify(
    selectedItems.reduce((acc, q) => {
      const correctOpt = q.options.find((o) => o.isCorrect);
      acc[q.id] = {
        c: correctOpt ? correctOpt.id : 1,
        exp: q.explanation || '',
      };
      return acc;
    }, {} as Record<number, { c: number; exp: string }>)
  )
).toString('base64');

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Kostenloser Online-IQ-Test: 24 Fragen, 20 Minuten",
    "description": "Standardisierte 24-teilige kognitive Diagnostik auf Basis des 2-Parameter-Logistic (2PL) Modells der Item-Response-Theorie. Erfasst fluide Intelligenz (Gf), visuell-räumliche Verarbeitung (Gv), quantitatives Denken (Gq) und verbales Verständnis (Gc).",
    "url": "https://freeiqexam.com/de/iq-test",
    "inLanguage": "de",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "about": {
      "@type": "Thing",
      "name": "Intelligenzquotient (IQ)"
    },
    "timeRequired": "PT20M",
    "numberOfQuestions": 24
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Kostenloser Online-IQ-Test",
    "url": "https://freeiqexam.com/de/iq-test",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://freeiqexam.com/de"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kostenloser IQ-Test",
        "item": "https://freeiqexam.com/de/iq-test"
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="de">
  <!-- Distraction-Free Top Navigation Bar -->
  <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">

      <!-- Brand / Exit Trigger -->
      <button
        id="btn-exit"
        type="button"
        class="flex items-center gap-2.5 group text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black rounded-xl p-1.5 -ml-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        aria-label="Test beenden und verlassen"
      >
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] flex items-center justify-center text-white font-bold text-base shadow-xs transition-opacity group-hover:opacity-90">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-base sm:text-lg tracking-tight text-zinc-950 dark:text-white leading-tight">
            FreeIQ<span class="text-[#0066cc] dark:text-[#2997ff]">Exam</span>
          </span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Test verlassen</span>
        </div>
      </button>

      <!-- Center: Live Countdown Timer and Item Counter -->
      <div class="flex items-center gap-3 sm:gap-6">
        <div
          id="timer-container"
          class="flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors duration-300"
          role="timer"
          aria-live="polite"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="timer-display" class="font-mono text-sm sm:text-base font-medium tracking-tight text-zinc-800 dark:text-zinc-200">
            20:00
          </span>
        </div>

        <!-- Question Counter Badge -->
        <div class="hidden sm:flex items-center gap-1 text-sm font-medium text-zinc-500 dark:text-zinc-400">
          <span>Frage</span>
          <span id="stat-current" class="font-bold text-zinc-900 dark:text-white">1</span>
          <span>/</span>
          <span class="font-semibold text-zinc-900 dark:text-white">24</span>
        </div>
      </div>

      <!-- Right: Finish Action -->
      <div class="flex items-center gap-2">
        <button
          id="btn-top-submit"
          type="button"
          class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black min-h-[44px] flex items-center"
        >
          Test abgeben
        </button>
      </div>

    </div>
  </header>

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

      <!-- Storage warning banner (hidden by default) -->
      <div id="storage-warning-banner" class="hidden mb-6 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-200 text-xs sm:text-sm">
        <strong>Hinweis:</strong> Der lokale Speicher Ihres Browsers ist deaktiviert. Ihr Testfortschritt kann bei einem Neuladen der Seite nicht wiederhergestellt werden.
      </div>

      <!-- Live Assessment Card -->
      <div class="rounded-3xl bg-zinc-50/90 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 shadow-sm overflow-hidden p-6 sm:p-10 mb-10">

        <!-- Header of Card: Category Badge & Mobile Counter -->
        <div class="flex items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="domain-badge" class="px-3 py-1 rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-mono font-bold tracking-wide uppercase">
              Fluide Intelligenz
            </span>
            <span id="domain-category" class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              Abstrakte Induktion (Gf)
            </span>
          </div>

          <div class="sm:hidden text-xs font-mono font-bold text-zinc-600 dark:text-zinc-400">
            Frage <span id="mobile-q-num">1</span> / 24
          </div>
        </div>

        <!-- Question Prompt Heading -->
        <div class="mb-6 text-center sm:text-left">
          <h1 id="question-prompt-text" class="text-lg sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center">
            Wählen Sie die Option, die das Muster logisch vervollständigt:
          </h1>
        </div>

        <!-- Stimulus Container (Matrix SVG or Diagram) -->
        <div id="stimulus-card" class="mb-8 p-4 sm:p-8 rounded-2xl bg-white dark:bg-[#0a0a0c] border border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-center min-h-[220px] sm:min-h-[280px]">
          <div id="stimulus-container" class="w-full flex items-center justify-center">
            <!-- Rendered SVG stimulus injected dynamically -->
          </div>
        </div>

        <!-- Multiple Choice Options Grid -->
        <div class="mb-8">
          <div id="options-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
            <!-- Option buttons injected dynamically -->
          </div>
        </div>

        <!-- Keyboard hint & Answered tally -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400 pt-4 border-t border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
            </svg>
            <span>Tasten 1–<span id="opt-count-hint">6</span> zur Auswahl &bull; Pfeiltasten zur Navigation</span>
          </div>
          <div>
            Beantwortet: <span id="answered-count" class="font-bold text-zinc-900 dark:text-white">0</span> / 24
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-1.5 mt-6 overflow-hidden">
          <div id="progress-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-1.5 rounded-full transition-all duration-300" style="width: 4.16%;"></div>
        </div>

        <!-- Item Navigator Strip -->
        <div class="mt-6 pt-6 border-t border-zinc-200/80 dark:border-zinc-800">
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3 text-center sm:text-left">
            Aufgabenübersicht:
          </div>
          <div id="navigator-strip" class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-thin">
            <!-- 24 numbered pills injected dynamically -->
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between gap-4 mt-8 pt-6 border-t border-zinc-200/80 dark:border-zinc-800">
          <button
            id="btn-prev"
            type="button"
            disabled
            class="px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all disabled:opacity-40 disabled:pointer-events-none min-h-[44px] flex items-center gap-2 active:scale-[0.97]"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            Zurück
          </button>

          <button
            id="btn-next"
            type="button"
            class="px-6 py-2.5 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white font-semibold text-sm transition-all hover:opacity-95 active:scale-[0.97] min-h-[44px] flex items-center gap-2 shadow-xs"
          >
            <span id="btn-next-text">Weiter</span>
            <svg id="btn-next-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>

      </div>

      <!-- Screen reader announcer -->
      <div id="sr-announcer" class="sr-only" aria-live="polite"></div>

      <!-- Educational Content Section (6 H2s) -->
      <article class="prose prose-zinc dark:prose-invert max-w-none border-t border-zinc-200 dark:border-zinc-800 pt-16 space-y-16">

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 1 &bull; Psychometrische Grundlagen
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Das Cattell-Horn-Carroll (CHC) Modell der Intelligenz
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Die moderne Psychometrie stützt sich auf das hierarchische CHC-Modell, das die menschliche Kognition in drei Schichten unterteilt: die allgemeine Intelligenz (General Factor <em>g</em>), breit gefächerte kognitive Domänen und spezifische Primärfähigkeiten. Unser 24-Aufgaben-Test prüft vier der prädiktivsten Breitbanddomänen:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose mt-4">
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Fluide Intelligenz (Gf)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Fähigkeit zum Lösen neuartiger, unvertrauter Probleme mittels induktiver und deduktiver Mustererkennung ohne Vorwissen.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Visuell-räumliche Verarbeitung (Gv)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Mentale Rotation, räumliche Faltung und optische Transformation geometrischer Figuren im zweidimensionalen Raum.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Quantitatives Denken (Gq)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Erkennen von mathematischen Reihen, Zahlenverhältnissen und formalen arithmetischen Gesetzmäßigkeiten.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Verbales Verständnis (Gc)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Logische Begriffsbeziehungen, Analogien und semantische Strukturierung abstrakter Sprachkonzepte.</p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 2 &bull; Statistische Methodik
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Item-Response-Theorie (2PL IRT): Wissenschaftliche Skalierung
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Klassische Testtheorien zählen lediglich die Rohpunkte (richtige Antworten). Dies verzerrt das Ergebnis, da schwere Aufgaben denselben Wert haben wie leichte. FreeIQExam nutzt das mathematische 2-Parameter-Logistic (2PL) Modell:
          </p>
          <div class="p-5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-sm text-zinc-800 dark:text-zinc-200 not-prose text-center">
            P(θ) = 1 / (1 + e<sup>-a(θ - b)</sup>)
          </div>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Hierbei repräsentiert <em>b</em> die Schwierigkeit des Items, <em>a</em> die Trennschärfe (Diskrimination) und <em>&theta;</em> Ihre latente kognitive Fähigkeit. Dadurch wird ein individueller Standardfehler (SEM) berechnet, der ein realistisches 95%-Konfidenzintervall liefert.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 3 &bull; Normierung
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Der Standard-IQ: Normalverteilung &amp; Standardabweichung (SD 15)
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Der Intelligenzquotient ist eine standardisierte Maßzahl. Auf der weltweit am weitesten verbreiteten Wechsler-Skala ist der Mittelwert auf 100 mit einer Standardabweichung (&sigma;) von 15 normiert:
          </p>
          <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-300">
            <li><strong>IQ 70–84:</strong> Unterdurchschnittlicher Bereich (~14% der Bevölkerung)</li>
            <li><strong>IQ 85–114:</strong> Durchschnittsbereich (~68% der Bevölkerung)</li>
            <li><strong>IQ 115–129:</strong> Überdurchschnittliche Intelligenz (~14% der Bevölkerung)</li>
            <li><strong>IQ 130+:</strong> Hochbegabung &ndash; Mensa-Aufnahmekriterium (oberste 2%, 98. Perzentil)</li>
          </ul>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 4 &bull; Fairness &amp; Validität
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Nonverbale Matrizentests &amp; Kulturfairness
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Um sprachliche, bildungsbiografische und soziokulturelle Verzerrungen zu minimieren, setzt der Kern des Tests auf progressive Matrizen nach dem Vorbild von Raven und Cattell Culture Fair. Diese rein visuellen Logikrätsel fordern die reine Verarbeitungsgeschwindigkeit und relationale Abstraktionsfähigkeit des Gehirns heraus.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 5 &bull; Testökonomie
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Testbedingungen: Zeitbegrenzung &amp; Konzentrationsfaktoren
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Das Zeitlimit von 20 Minuten (durchschnittlich 50 Sekunden pro Aufgabe) misst die kognitive Effizienz unter Belastung. Ein Überspringen unklarer Aufgaben mit späterer Rückkehr ist dank des interaktiven Aufgaben-Navigators jederzeit möglich.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Abschnitt 6 &bull; Diagnostik
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Ergebnisinterpretation &amp; kognitive Profildiagnostik
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Nach Abschluss erhalten Sie eine detaillierte Auswertung mit Gesamtwert, Perzentilrang, Konfidenzintervall sowie einer separaten Aufschlüsselung der Stärken in fluidem, räumlichem, numerischem und verbalem Denken.
          </p>
        </section>

      </article>

      <!-- FAQ Accordion Section (Visible HTML Accordions only, no schema) -->
      <section class="mt-16 pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-600 dark:text-zinc-400 uppercase tracking-wider mb-2">
            Häufige Fragen
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Fragen und Antworten zum Online-IQ-Test
          </h2>
        </div>

        <div class="space-y-3">
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Wie lange dauert der kostenlose IQ-Test?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Der Test umfasst 24 Fragen und hat ein festes Zeitlimit von 20 Minuten. Sie können den Test jedoch jederzeit vorzeitig einreichen, wenn Sie alle Fragen beantwortet haben.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Ist das Testergebnis wissenschaftlich valide?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Unser Test basiert auf etablierten psychometrischen Modellen (2PL IRT) und dem CHC-Rahmenwerk. Er bietet eine verlässliche kognitive Orientierung und Selbsteinschätzung.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Was bedeutet ein IQ-Wert von 100, 115 oder 130?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Ein IQ von 100 entspricht genau dem Populationsmittelwert (50. Perzentil). Ein IQ von 115 liegt eine Standardabweichung über dem Schnitt (ca. 84. Perzentil), und ein IQ von 130 markiert die Schwelle zur Hochbegabung (98. Perzentil).
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Werden meine Daten oder Antworten gespeichert?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Nein. Die Auswertung erfolgt 100% lokal in Ihrem Browser. Es ist keine E-Mail-Adresse und keine Registrierung erforderlich.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Warum basiert der Test auf 24 Aufgaben?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              24 Aufgaben bieten das optimale Verhältnis aus testtheoretischer Reliabilität (&alpha; &gt; 0.85) und zeitlicher Ökonomie (ca. 20 Minuten Bearbeitungsdauer), ohne Ermüdungseffekte hervorzurufen.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Wie unterscheidet sich dieser Test von einem klinischen Intelligenztest?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Klinische Testbatterien wie der WAIS-IV werden über mehrere Stunden von approbierten Psychologen vor Ort durchgeführt und umfassen auditive sowie motorische Subtests. Unser Screening ist eine standardisierte digitale Selbsteinschätzung.
            </p>
          </details>
        </div>
      </section>

    </div>
  </main>

  <!-- Exit Modal -->
  <div id="modal-exit" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" role="dialog" aria-modal="true">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl">
      <h3 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-2">
