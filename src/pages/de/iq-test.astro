      <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
        Wenn Sie den Test jetzt verlassen, geht Ihr bisheriger Bearbeitungsstand verloren.
      </p>
      <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3">
        <a
          href="/de"
          class="w-full sm:w-auto px-5 py-2.5 rounded-full text-sm font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors text-center"
        >
          Ja, abbrechen
        </a>
        <button
          id="btn-modal-resume"
          type="button"
          class="w-full sm:w-auto px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-[#0066cc] dark:bg-[#2997ff] hover:opacity-95 transition-opacity"
        >
          Test fortsetzen
        </button>
      </div>
