  </div>

  <!-- Submit Modal -->
  <div id="modal-submit" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" role="dialog" aria-modal="true">
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl">
      <h3 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-2">
        Test abschließen &amp; auswerten
      </h3>
      <p id="submit-modal-summary" class="text-sm text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
        Alle 24 Aufgaben wurden beantwortet. Ihr Antwortprofil ist bereit zur 2PL-IRT-Normierung.
      </p>
      <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3">
        <button
          id="btn-cancel-submit"
          type="button"
          class="w-full sm:w-auto px-5 py-2.5 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          Fragen überprüfen
        </button>
        <button
          id="btn-confirm-submit"
          type="button"
          class="w-full sm:w-auto px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-[#0066cc] dark:bg-[#2997ff] hover:opacity-95 transition-opacity"
        >
          Auswertung starten
        </button>
      </div>
    </div>
  </div>

  <!-- Embedded Client Logic -->
  <script is:inline define:vars={{ bankJson, answerKeyToken }}>
    (function () {
      var FULL_BANK = JSON.parse(bankJson);
      var TOTAL_QUESTIONS = 24;
      var TOTAL_TIME_SECONDS = 20 * 60; // 1200 seconds

      var STORAGE_KEY_SESSION   = 'de_iq_session';
      var STORAGE_KEY_ANSWERS   = 'de_iq_answers';
      var STORAGE_KEY_QUESTIONS = 'de_iq_active_questions';
      var STORAGE_KEY_TYPE      = 'de_iq_test_type';

      // CHC domain display labels (German)
      var DOMAIN_LABELS = {
        fluid:        { label: 'Fluide Intelligenz', cat: 'Abstrakte Induktion (Gf)' },
        spatial:      { label: 'Visuell-räumlich', cat: 'Mentale Rotation & Faltung (Gv)' },
        quantitative: { label: 'Quantitatives Denken', cat: 'Numerische Logik (Gq)' },
        verbal:       { label: 'Verbales Verständnis', cat: 'Sprachliche Kognition (Gc)' }
      };

      // Seeded RNG (Mulberry32)
      function createRng(seed) {
        var s = seed >>> 0;
        return function () {
          s += 0x6d2b79f5;
          var t = s;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function shuffle(arr, rng) {
        var out = arr.slice();
        for (var i = out.length - 1; i > 0; i--) {
          var j = Math.floor(rng() * (i + 1));
          var tmp = out[i]; out[i] = out[j]; out[j] = tmp;
        }
        return out;
      }

      function sampleDomain(domain, count, rng) {
        var pool = FULL_BANK.filter(function (item) { return item.domain === domain; });
        return shuffle(pool, rng).slice(0, count);
      }

      function buildStandardSet(seed) {
        var rng = createRng(seed);
        var domains = ['fluid', 'spatial', 'quantitative', 'verbal'];
        var result = [];
        domains.forEach(function (d) {
          sampleDomain(d, 6, rng).forEach(function (item) { result.push(item); });
        });
        return result;
      }

      // State
      var questions = [];
      var currentIndex = 0;
      var userAnswers = {};
      var timeRemaining = TOTAL_TIME_SECONDS;
      var timerInterval = null;
      var autoAdvanceTimer = null;
      var targetEndTime = null;
      var sessionSeed = null;
      var startTimeMs = Date.now();
      var sessionExpired = false;

      // Restore or init session
      try {
        var saved = localStorage.getItem(STORAGE_KEY_SESSION);
        if (saved) {
          var parsed = JSON.parse(saved);
          if (parsed && typeof parsed === 'object') {
            var now = Date.now();
            var isFresh = !parsed.savedAt || (now - parsed.savedAt) < 7200000;
            if (isFresh) {
              if (typeof parsed.startTimeMs === 'number') startTimeMs = parsed.startTimeMs;
              if (typeof parsed.seed === 'number') sessionSeed = parsed.seed;
              if (parsed.answers && typeof parsed.answers === 'object') userAnswers = parsed.answers;
              if (typeof parsed.timeRemaining === 'number' && parsed.timeRemaining > 0) timeRemaining = parsed.timeRemaining;
              if (typeof parsed.currentQuestionIndex === 'number' && parsed.currentQuestionIndex >= 0) {
                currentIndex = parsed.currentQuestionIndex;
              }
              if (typeof parsed.targetEndTime === 'number') {
                if (parsed.targetEndTime <= now) {
                  timeRemaining = 0;
                  sessionExpired = true;
                } else {
                  targetEndTime = parsed.targetEndTime;
                  timeRemaining = Math.max(0, Math.round((targetEndTime - now) / 1000));
                }
              } else {
                targetEndTime = now + timeRemaining * 1000;
              }
            } else {
              localStorage.removeItem(STORAGE_KEY_SESSION);
              targetEndTime = now + timeRemaining * 1000;
            }
          }
        } else {
          targetEndTime = Date.now() + timeRemaining * 1000;
        }
      } catch (err) {
        targetEndTime = Date.now() + timeRemaining * 1000;
      }

      if (!sessionSeed) sessionSeed = Math.floor(Math.random() * 0xffffffff);
      questions = buildStandardSet(sessionSeed);
      if (currentIndex >= questions.length) currentIndex = 0;

      if (sessionExpired) {
        localStorage.removeItem(STORAGE_KEY_SESSION);
        submitTestImmediately();
        return;
      }

      function shuffleOptions(opts) {
        var copy = opts.slice();
        for (var i = copy.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var temp = copy[i];
          copy[i] = copy[j];
          copy[j] = temp;
        }
        return copy;
      }

      // DOM Elements
      var timerDisplay    = document.getElementById('timer-display');
      var timerContainer  = document.getElementById('timer-container');
      var statCurrent     = document.getElementById('stat-current');
      var mobileQNum      = document.getElementById('mobile-q-num');
      var progressBar     = document.getElementById('progress-bar');
      var domainBadge     = document.getElementById('domain-badge');
      var domainCategory  = document.getElementById('domain-category');
      var promptText      = document.getElementById('question-prompt-text');
      var stimulusCard    = document.getElementById('stimulus-card');
      var stimulusContainer = document.getElementById('stimulus-container');
      var optionsGrid     = document.getElementById('options-grid');
      var answeredCountEl = document.getElementById('answered-count');
      var optCountHint    = document.getElementById('opt-count-hint');
      var btnPrev         = document.getElementById('btn-prev');
      var btnNext         = document.getElementById('btn-next');
      var btnNextText     = document.getElementById('btn-next-text');
      var btnNextIcon     = document.getElementById('btn-next-icon');
      var navigatorStrip  = document.getElementById('navigator-strip');
      var btnTopSubmit    = document.getElementById('btn-top-submit');
      var modalExit       = document.getElementById('modal-exit');
      var btnExit         = document.getElementById('btn-exit');
      var btnModalResume  = document.getElementById('btn-modal-resume');
      var modalSubmit     = document.getElementById('modal-submit');
      var submitModalSummary = document.getElementById('submit-modal-summary');
      var btnConfirmSubmit   = document.getElementById('btn-confirm-submit');
      var btnCancelSubmit    = document.getElementById('btn-cancel-submit');
      var srAnnouncer     = document.getElementById('sr-announcer');

      var testSubmitted = false;

      function saveSession() {
        if (testSubmitted) return;
        try {
          localStorage.setItem(STORAGE_KEY_SESSION, JSON.stringify({
            startTimeMs: startTimeMs,
            seed: sessionSeed,
            answers: userAnswers,
            timeRemaining: timeRemaining,
            currentQuestionIndex: currentIndex,
            targetEndTime: targetEndTime,
            savedAt: Date.now()
          }));
        } catch (e) {}
      }

      function updateTimerDisplay() {
        var mins = Math.floor(timeRemaining / 60);
        var secs = timeRemaining % 60;
        var formatted = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = formatted;

        if (timeRemaining <= 60) {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 font-bold animate-pulse';
        } else if (timeRemaining <= 300) {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-800 text-amber-600 dark:text-amber-400 font-semibold';
        } else {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 font-medium';
        }
      }

      function syncTimerFromWallClock() {
        if (!targetEndTime || testSubmitted) return;
        var secondsLeft = Math.max(0, Math.round((targetEndTime - Date.now()) / 1000));
        timeRemaining = secondsLeft;
        updateTimerDisplay();
        if (secondsLeft <= 0) {
          clearInterval(timerInterval);
          submitTestImmediately();
        }
      }

      function startTimer() {
        updateTimerDisplay();
        timerInterval = setInterval(function () {
          syncTimerFromWallClock();
          saveSession();
        }, 1000);
      }

      window.addEventListener('beforeunload', function (e) {
        if (!testSubmitted && Object.keys(userAnswers).length > 0) {
          e.preventDefault();
          e.returnValue = '';
        }
      });

      function submitTestImmediately() {
        testSubmitted = true;
        try {
          var answerKeyMap = {};
          try {
            var decoded = atob(answerKeyToken);
            answerKeyMap = JSON.parse(decoded);
          } catch (e) {}
          var timeElapsedSec = Math.max(1, Math.round((Date.now() - startTimeMs) / 1000));
          var scoredQuestions = questions.map(function (q) {
            var key = answerKeyMap[q.id];
            var correctId = key ? key.c : 0;
            return {
              id: q.id,
              domain: q.domain,
              subType: q.subType,
              domainLabel: q.domainLabel,
              promptType: q.promptType,
              promptText: q.promptText,
              promptSvg: q.promptSvg,
              a: q.a,
              b: q.b,
              explanation: key ? key.exp : '',
              options: q.options.map(function (opt) {
                return {
                  id: opt.id,
                  text: opt.text,
                  svgContent: opt.svgContent,
                  isCorrect: opt.id === correctId,
                };
              }),
            };
          });

          localStorage.setItem(STORAGE_KEY_ANSWERS, JSON.stringify(userAnswers));
          localStorage.setItem(STORAGE_KEY_QUESTIONS, JSON.stringify(questions.map(function (q) { return q.id; })));
          localStorage.setItem(STORAGE_KEY_TYPE, 'standard');

          if (typeof window.__fiqSaveSessionResult === 'function') {
            window.__fiqSaveSessionResult(userAnswers, scoredQuestions, 'standard', timeElapsedSec);
          }
          localStorage.removeItem(STORAGE_KEY_SESSION);
        } catch (e) {}
        window.location.href = '/results';
      }

      function openSubmitModal() {
        var count = Object.keys(userAnswers).length;
        var unanswered = TOTAL_QUESTIONS - count;
        if (count === TOTAL_QUESTIONS) {
          submitModalSummary.textContent = 'Alle 24 Aufgaben beantwortet! Ihr Antwortprofil ist bereit zur 2PL-IRT-Normierung.';
        } else {
          submitModalSummary.textContent = 'Sie haben ' + count + ' von 24 Aufgaben beantwortet (' + unanswered + ' noch offen). Unbeantwortete Aufgaben werden als fehlerhaft gewertet. Möchten Sie den Test jetzt wirklich beenden?';
        }
        modalSubmit.classList.remove('hidden');
        modalSubmit.classList.add('flex');
        requestAnimationFrame(function () { if (btnConfirmSubmit) btnConfirmSubmit.focus(); });
      }

      function closeSubmitModal() {
        modalSubmit.classList.add('hidden');
        modalSubmit.classList.remove('flex');
      }

      function openExitModal() {
        modalExit.classList.remove('hidden');
        modalExit.classList.add('flex');
        requestAnimationFrame(function () { if (btnModalResume) btnModalResume.focus(); });
      }

      function closeExitModal() {
        modalExit.classList.add('hidden');
        modalExit.classList.remove('flex');
      }

      function sanitizeSvg(raw) {
        if (!raw || typeof raw !== 'string') return '';
        return raw
          .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
          .replace(/\bon\w+\s*=\s*(?:'[^']*'|"[^"]*"|[^\s>]+)/gi, '')
          .replace(/javascript:/gi, '');
      }

      function renderCurrentQuestion() {
        var q = questions[currentIndex];
        if (!q) return;

        var qNum = currentIndex + 1;
        if (statCurrent) statCurrent.textContent = String(qNum);
        if (mobileQNum) mobileQNum.textContent = String(qNum);
        if (progressBar) progressBar.style.width = ((qNum / TOTAL_QUESTIONS) * 100) + '%';

        var answeredCount = Object.keys(userAnswers).length;
        if (answeredCountEl) answeredCountEl.textContent = String(answeredCount);

        var domInfo = DOMAIN_LABELS[q.domain] || { label: 'Kognitiver Test', cat: 'CHC-Modell' };
        if (domainBadge) domainBadge.textContent = domInfo.label;
        if (domainCategory) domainCategory.textContent = domInfo.cat;

        var optCount = q.options.length;
        if (optCountHint) optCountHint.textContent = String(optCount);

        if (stimulusContainer) {
          stimulusContainer.innerHTML = '';
        }

        if (q.promptType === 'text') {
          if (stimulusCard) stimulusCard.style.display = 'none';
          if (promptText) {
            promptText.textContent = q.promptText;
            promptText.className = 'text-lg sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center';
          }
        } else if (q.promptType === 'svg' && q.promptSvg) {
          if (stimulusCard) stimulusCard.style.display = '';
          if (stimulusContainer) stimulusContainer.innerHTML = sanitizeSvg(q.promptSvg);
          if (promptText) {
            promptText.textContent = (q.promptText && q.promptText.trim().length > 0)
              ? q.promptText
              : 'Wählen Sie die Option, die das Muster logisch vervollständigt:';
            promptText.className = 'text-base sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center';
          }
        } else {
          if (stimulusCard) stimulusCard.style.display = '';
          if (stimulusContainer && q.promptSvg) {
            var hybridText = document.createElement('p');
            hybridText.className = 'text-sm text-zinc-700 dark:text-zinc-300 mb-3 leading-relaxed';
            hybridText.textContent = q.promptText;
            stimulusContainer.appendChild(hybridText);
            var svgWrap = document.createElement('div');
            svgWrap.innerHTML = sanitizeSvg(q.promptSvg);
            stimulusContainer.appendChild(svgWrap);
          }
          if (promptText) {
            promptText.textContent = 'Analysieren Sie die Angaben und wählen Sie die richtige Antwort:';
            promptText.className = 'text-base sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center';
          }
        }

        if (optionsGrid) {
          optionsGrid.innerHTML = '';
          var selectedOptionId = userAnswers[q.id];
          if (!q._shuffledOptions) {
            q._shuffledOptions = shuffleOptions(q.options);
          }
          var displayedOptions = q._shuffledOptions;
          var hasSvgOptions = displayedOptions.some(function (o) { return o.svgContent; });
          optionsGrid.className = hasSvgOptions
            ? 'grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4'
            : 'grid grid-cols-1 gap-3';

          displayedOptions.forEach(function (opt, optIdx) {
            var isSelected = selectedOptionId === opt.id;
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-option-id', String(opt.id));
            btn.setAttribute('aria-label', 'Option ' + (optIdx + 1));

            var baseClass = 'relative p-3 sm:p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-200 active:scale-[0.98] cursor-pointer text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black min-h-[44px] ';
            var stateClass = isSelected
              ? 'bg-blue-50/70 dark:bg-blue-950/40 border-2 border-[#0066cc] dark:border-[#2997ff] ring-2 ring-blue-600/20 shadow-md'
              : 'bg-white/80 dark:bg-[#0f1016]/90 border border-zinc-200/80 dark:border-white/10 hover:border-zinc-300 dark:hover:border-white/20 hover:shadow-xs';
            if (opt.svgContent) stateClass += ' min-h-[90px] sm:min-h-[110px]';
            btn.className = baseClass + stateClass;

            var badge = document.createElement('span');
            badge.className = isSelected
              ? 'absolute top-2 left-2 w-5 h-5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] text-white font-mono text-xs font-bold flex items-center justify-center'
              : 'absolute top-2 left-2 w-5 h-5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-mono text-xs font-semibold flex items-center justify-center border border-zinc-200 dark:border-zinc-700';
            badge.textContent = String(optIdx + 1);
            btn.appendChild(badge);

            if (opt.svgContent) {
              var svgWrap = document.createElement('div');
              svgWrap.className = 'w-full flex items-center justify-center pointer-events-none mt-2';
              svgWrap.innerHTML = sanitizeSvg(opt.svgContent);
              btn.appendChild(svgWrap);
            }
            if (opt.text) {
              var textWrap = document.createElement('div');
              textWrap.className = 'w-full px-6 py-1 text-sm sm:text-base text-zinc-800 dark:text-zinc-200 leading-snug pointer-events-none';
              textWrap.textContent = opt.text;
              btn.appendChild(textWrap);
            }

            btn.addEventListener('click', function () { selectOption(q.id, opt.id); });
            optionsGrid.appendChild(btn);
          });
        }

        if (btnPrev) btnPrev.disabled = currentIndex === 0;
        if (btnNextText && btnNextIcon) {
          if (currentIndex === TOTAL_QUESTIONS - 1) {
            btnNextText.textContent = 'Test auswerten';
            btnNextIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />';
          } else {
            btnNextText.textContent = 'Weiter';
            btnNextIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />';
          }
        }

        renderNavigatorStrip();
        saveSession();

        if (srAnnouncer) {
          srAnnouncer.textContent = 'Frage ' + (currentIndex + 1) + ' von ' + TOTAL_QUESTIONS + ': ' + (q.promptText || 'Muster vervollständigen');
        }
      }

      function renderNavigatorStrip() {
        if (!navigatorStrip) return;
        navigatorStrip.innerHTML = '';
        for (var i = 0; i < TOTAL_QUESTIONS; i++) {
          var qId = questions[i].id;
          var isCurrent = i === currentIndex;
          var isAnswered = typeof userAnswers[qId] === 'number';
          var pill = document.createElement('button');
          pill.type = 'button';
          pill.setAttribute('aria-label', 'Gehe zu Frage ' + (i + 1));
          var pillClass = 'min-w-[44px] min-h-[44px] shrink-0 px-2 rounded-xl font-mono text-xs font-semibold flex items-center justify-center transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 ';
          if (isCurrent) {
            pillClass += 'bg-[#0066cc] dark:bg-[#2997ff] text-white ring-2 ring-blue-600 ring-offset-2 dark:ring-offset-black shadow-xs font-bold scale-105';
          } else if (isAnswered) {
            pillClass += 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 shadow-2xs';
          } else {
            pillClass += 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800/80 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-700/60 hover:bg-zinc-200 dark:hover:bg-zinc-700';
          }
          pill.className = pillClass;
          pill.textContent = String(i + 1);
          pill.addEventListener('click', (function (idx) {
            return function () {
              clearTimeout(autoAdvanceTimer);
              currentIndex = idx;
              renderCurrentQuestion();
            };
          })(i));
          navigatorStrip.appendChild(pill);
        }
      }

      function selectOption(questionId, optionId) {
        userAnswers[questionId] = optionId;
        renderCurrentQuestion();
        clearTimeout(autoAdvanceTimer);
        var answeredIdx = currentIndex;
        autoAdvanceTimer = setTimeout(function () {
          if (currentIndex === answeredIdx && currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
          }
        }, 400);
      }

      // Button Listeners
      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          clearTimeout(autoAdvanceTimer);
          if (currentIndex > 0) { currentIndex -= 1; renderCurrentQuestion(); }
        });
      }
      if (btnNext) {
        btnNext.addEventListener('click', function () {
          clearTimeout(autoAdvanceTimer);
          if (currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
          } else {
            openSubmitModal();
          }
        });
      }
      if (btnTopSubmit) btnTopSubmit.addEventListener('click', openSubmitModal);
      if (btnExit) btnExit.addEventListener('click', openExitModal);
      if (btnModalResume) btnModalResume.addEventListener('click', closeExitModal);

      modalExit.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var focusable = Array.from(modalExit.querySelectorAll('button, a, [tabindex]:not([tabindex="-1"])'));
        var first = focusable[0]; var last = focusable[focusable.length - 1];
        if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
        else { if (document.activeElement === last) { e.preventDefault(); first.focus(); } }
      });
      modalSubmit.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var focusable = Array.from(modalSubmit.querySelectorAll('button, a, [tabindex]:not([tabindex="-1"])'));
        var first = focusable[0]; var last = focusable[focusable.length - 1];
        if (e.shiftKey) { if (document.activeElement === first) { e.preventDefault(); last.focus(); } }
        else { if (document.activeElement === last) { e.preventDefault(); first.focus(); } }
      });

      if (modalExit) {
        modalExit.addEventListener('click', function (e) {
          if (e.target === modalExit) closeExitModal();
        });
      }
      if (modalSubmit) {
        modalSubmit.addEventListener('click', function (e) {
          if (e.target === modalSubmit) closeSubmitModal();
        });
      }

      if (btnCancelSubmit) btnCancelSubmit.addEventListener('click', closeSubmitModal);
      if (btnConfirmSubmit) btnConfirmSubmit.addEventListener('click', submitTestImmediately);

      // Keyboard navigation
      window.addEventListener('keydown', function (e) {
        if (!modalExit.classList.contains('hidden') || !modalSubmit.classList.contains('hidden')) {
          if (e.key === 'Escape') { closeExitModal(); closeSubmitModal(); }
          return;
        }

        var currentQ = questions[currentIndex];
        var optionCount = currentQ ? currentQ.options.length : 0;

        if (e.key >= '1' && parseInt(e.key, 10) <= optionCount) {
          var keyIdx = parseInt(e.key, 10) - 1;
          var opts = currentQ._shuffledOptions || currentQ.options;
          if (currentQ && opts[keyIdx]) selectOption(currentQ.id, opts[keyIdx].id);
          return;
        }

        if (e.key === 'ArrowLeft' || e.key === 'p' || e.key === 'P') {
          clearTimeout(autoAdvanceTimer);
          if (currentIndex > 0) { currentIndex -= 1; renderCurrentQuestion(); }
          return;
        }
        if (e.key === 'ArrowRight' || e.key === 'n' || e.key === 'N') {
          clearTimeout(autoAdvanceTimer);
          if (currentIndex < TOTAL_QUESTIONS - 1) { currentIndex += 1; renderCurrentQuestion(); }
          return;
        }
        if (e.key === 'Enter') {
          if (currentIndex === TOTAL_QUESTIONS - 1) openSubmitModal();
        }
      });

      // Initialize
      startTimer();
      renderCurrentQuestion();
    })();
  </script>

  <script>
    import { calculateScore } from '../../utils/scoring';
    import { saveAssessmentRecord } from '../../utils/profileStore';
    import type { QuestionItem } from '../../data/questions';

    declare global {
      interface Window {
        __fiqSaveSessionResult?: (
          userAnswers: Record<number, number>,
          scoredQuestions: QuestionItem[],
          testType: 'standard' | 'quick',
          durationSeconds?: number
        ) => void;
      }
    }

    window.__fiqSaveSessionResult = function (userAnswers, scoredQuestions, testType, durationSeconds) {
      try {
        const scoreResult = calculateScore(userAnswers, scoredQuestions, testType);
        localStorage.setItem('iq_assessment_result', JSON.stringify(scoreResult));

        const reviewData = scoredQuestions.map((q) => {
          const selectedId = userAnswers[q.id];
          const selectedOpt = q.options.find((o) => o.id === selectedId);
          return {
            id: q.id,
            domain: q.domain,
            subType: q.subType,
            promptType: q.promptType,
            promptText: q.promptText,
            promptSvg: q.promptSvg ?? null,
            a: q.a,
            b: q.b,
            explanation: q.explanation,
            options: q.options,
            selectedOptionId: selectedId,
            isCorrect: selectedOpt ? selectedOpt.isCorrect : false,
          };
        });
        localStorage.setItem('iq_review_data', JSON.stringify(reviewData));

        const defaultDuration = testType === 'quick' ? 600 : 1200;
        const actualDuration = typeof durationSeconds === 'number' && durationSeconds > 0 ? durationSeconds : defaultDuration;

        saveAssessmentRecord({
          assessmentType: testType === 'quick' ? 'quick-12' : 'flagship-24',
          assessmentVersion: '1.0.0',
          completedAt: new Date().toISOString(),
          durationSeconds: actualDuration,
          rawScore: scoreResult.rawScore,
          totalQuestions: scoredQuestions.length,
          theta: scoreResult.theta,
          sem: scoreResult.sem,
          iqEstimate: scoreResult.iqEstimate,
          confidenceInterval: scoreResult.confidenceInterval,
          percentile: scoreResult.percentile,
          domainBreakdown: scoreResult.domainBreakdown,
        });
      } catch (err) {
        console.warn('[Test] Failed to persist scored assessment:', err);
      }
    };
  </script>
</Layout>
