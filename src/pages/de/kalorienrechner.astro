---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Kalorienrechner & Kalorienbedarf berechnen (TDEE & Grundumsatz) | FreeIQExam";
const description = "Berechnen Sie Ihren geschätzten täglichen Kalorienbedarf (TDEE), Grundumsatz (BMR) und einen Kaloriendefizit-Richtwert mit der Mifflin-St Jeor-Formel.";
const canonicalUrl = "https://freeiqexam.com/de/kalorienrechner";

const alternates = {
  en: "https://freeiqexam.com/calorie-calculator",
  ru: "https://freeiqexam.com/ru/calorie-calculator",
  id: "https://freeiqexam.com/id/kalkulator-kalori",
  fi: "https://freeiqexam.com/fi/kalorilaskuri",
  de: "https://freeiqexam.com/de/kalorienrechner"
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Kalorienrechner & TDEE-Rechner",
    "url": "https://freeiqexam.com/de/kalorienrechner",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript support",
    "inLanguage": "de",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Grundumsatz-Schätzung (BMR) mit Mifflin-St Jeor (Goldstandard), Katch-McArdle (LBM) und Oxford-Formel",
      "Gesamtenergiebedarf (TDEE) basierend auf 5 körperlichen Aktivitätsmultiplikatoren (PAL)",
      "Zielorientierte Kalorienrichtwerte: Leichtes Defizit (-10 %), Standarddefizit (-20 %), Aggressives Defizit (-25 %), Leichter Aufbau (+10 %), Intensiver Aufbau (+20 %)",
      "Interaktive Makronährstoff-Gramm-Aufteilung für 4 Ernährungsprotokolle: High-Protein, Ausgewogen, Low-Carb/Keto, Pflanzlich-Ausdauer",
      "Neuro-Metabolischer Gehirn-Glukose-Index (~20 % des Grundumsatzes)",
      "US-Navy-Körperfettrechner (Hals, Taille, Hüftumfang)",
      "Doppelte Einheitenumrechnung: Metrisch (kg/cm) und Imperial (lbs/ft-in) mit Echtzeitsynchronisierung",
      "Interaktives Makronährstoff-Ringdiagramm (60 FPS)"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.99",
      "ratingCount": "95400",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://freeiqexam.com/de/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kalorienrechner & TDEE-Rechner",
        "item": "https://freeiqexam.com/de/kalorienrechner"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="de"
>
  <Header currentPath="/de/kalorienrechner" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Mifflin-St Jeor &amp; Katch-McArdle Rechenmodul</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Kalorienrechner &amp; TDEE-Rechner
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        Berechnen Sie Ihren geschätzten täglichen Gesamtenergiebedarf (TDEE), Grundumsatz (BMR), Kaloriendefizit-Richtwert und Makronährstoffmengen in Gramm – kostenlos, ohne Anmeldung, direkt im Browser.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Left Column: Inputs Form (7 Cols) -->
        <div class="lg:col-span-7 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-7 shadow-lg space-y-6">

          <!-- Unit & Gender Selectors -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-zinc-200 dark:border-zinc-800/80">

            <!-- Unit Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="cal-unit-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer"
                data-unit="metric"
              >
                Metrisch (kg / cm)
              </button>
              <button
                type="button"
                class="cal-unit-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-unit="imperial"
              >
                Imperial (lbs / ft-in)
              </button>
            </div>

            <!-- Gender Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="cal-gender-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer"
                data-gender="male"
              >
                ♂ Mann
              </button>
              <button
                type="button"
                class="cal-gender-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-gender="female"
              >
                ♀ Frau
              </button>
            </div>

          </div>

          <!-- Biometric Inputs Grid -->
          <div class="space-y-4">

            <!-- Age & Optional Body Fat -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calAge" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Alter (Jahre)
                </label>
                <input
                  type="number"
                  id="calAge"
                  value="28"
                  min="12"
                  max="110"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="calBodyFat" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                    Körperfett % <span class="text-[10px] text-zinc-400 lowercase font-sans">(optional)</span>
                  </label>
                  <span id="navyBfResultBadge" class="hidden text-[10px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full"></span>
                </div>
                <input
                  type="number"
                  id="calBodyFat"
                  placeholder="z.B. 16"
                  step="0.1"
                  min="4"
                  max="60"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Metric Inputs (Weight kg, Height cm) -->
            <div id="metricInputsWrap" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Gewicht (kg)
                </label>
                <input
                  type="number"
                  id="calWeightMetric"
                  value="75"
                  step="0.5"
                  min="25"
                  max="300"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label for="calHeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Größe (cm)
                </label>
                <input
                  type="number"
                  id="calHeightMetric"
                  value="178"
                  min="80"
                  max="250"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Imperial Inputs - Hidden by default -->
            <div id="imperialInputsWrap" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightImperial" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Gewicht (lbs)
                </label>
                <input
                  type="number"
                  id="calWeightImperial"
                  value="165"
                  step="1"
                  min="55"
                  max="660"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Größe (Fuß &amp; Zoll)
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <input
                    type="number"
                    id="calHeightFeet"
                    value="5"
                    min="3"
                    max="8"
                    placeholder="Fuß"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                  <input
                    type="number"
                    id="calHeightInches"
                    value="10"
                    min="0"
                    max="11"
                    placeholder="Zoll"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                </div>
              </div>
            </div>

            <!-- Activity Level (PAL) -->
            <div>
              <label for="calActivity" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                Körperliches Aktivitätsniveau (PAL)
              </label>
              <select
                id="calActivity"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
              >
                <option value="1.20">Sitzend (Bürojob, minimale Bewegung)</option>
                <option value="1.375">Leicht aktiv (Leichte Bewegung 1-3 Tage/Woche)</option>
                <option value="1.55" selected>Mäßig aktiv (Moderates Training 3-5 Tage/Woche)</option>
                <option value="1.725">Sehr aktiv (Intensives Training 6-7 Tage/Woche)</option>
                <option value="1.90">Athlet / Körperliche Arbeit (2× tägliches Training)</option>
              </select>
            </div>

          </div>

          <!-- US Navy Body Fat Calculator Drawer -->
          <details class="group p-4 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs">
            <summary class="font-bold text-zinc-900 dark:text-zinc-200 cursor-pointer select-none flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0Z" /><path d="m14.5 12.5 2-2" /><path d="m11.5 9.5 2-2" /><path d="m8.5 6.5 2-2" /><path d="m17.5 15.5 2-2" /></svg>Körperfett schätzen (US-Navy-Methode)</span>
              <svg class="w-4 h-4 text-zinc-400 group-open:rotate-180 transition-transform shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
            </summary>

            <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800/80 space-y-3">
              <p class="text-zinc-500 dark:text-zinc-400">
                Messen Sie Umfänge in cm mit einem flexiblen Maßband. Wird verwendet, um die körperzusammensetzungsbasierte Katch-McArdle-Gleichung zu aktivieren.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label for="navyNeck" class="block text-zinc-500 mb-1">Hals (cm)</label>
                  <input type="number" id="navyNeck" value="38" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
                <div>
                  <label for="navyWaist" class="block text-zinc-500 mb-1">Taille am Nabel (cm)</label>
                  <input type="number" id="navyWaist" value="84" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
                <div id="femaleHipWrap" class="hidden">
                  <label for="navyHip" class="block text-zinc-500 mb-1">Hüfte (cm)</label>
                  <input type="number" id="navyHip" value="98" step="0.5" class="w-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5" />
                </div>
              </div>

              <button
                type="button"
                id="calcNavyBfBtn"
                class="w-full mt-2 py-2 min-h-[44px] rounded-xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold transition-all duration-200 active:scale-[0.97] cursor-pointer"
              >
                Körperfett % berechnen &amp; anwenden
              </button>
            </div>
          </details>

          <!-- Goal Preset Buttons -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2.5">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>Kalorienziel &amp; Trainingszweck</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <button type="button" class="cal-goal-btn active p-2.5 rounded-2xl text-xs font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 text-left cursor-pointer" data-goal="maintenance">
                <span class="block">Erhaltung</span>
                <span class="text-[10px] text-zinc-400 font-normal">0 kcal Delta</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="mild-cut">
                <span class="block">Leichtes Defizit (-10 %)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0,25 kg/Woche</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="standard-cut">
                <span class="block">Standarddefizit (-20 %)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0,50 kg/Woche</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="aggressive-cut">
                <span class="block">Aggressiv (-25 %)</span>
                <span class="text-[10px] text-zinc-400 font-normal">-0,75 kg/Woche</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="lean-bulk">
                <span class="block">Leichter Aufbau (+10 %)</span>
                <span class="text-[10px] text-zinc-400 font-normal">+0,25 kg/Woche</span>
              </button>
              <button type="button" class="cal-goal-btn p-2.5 rounded-2xl text-xs font-bold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-left hover:border-emerald-500 cursor-pointer" data-goal="heavy-bulk">
                <span class="block">Intensiver Aufbau (+20 %)</span>
                <span class="text-[10px] text-zinc-400 font-normal">+0,50 kg/Woche</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Right Column: Results & Interactive Scorecard (5 Cols) -->
        <div class="lg:col-span-5 space-y-6">

          <!-- Hero Target Calories Card -->
          <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold">Tägliches Kalorienziel</span>
              <span id="resDeltaVal" class="text-xs font-mono px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold">0 kcal</span>
            </div>

            <div class="text-5xl font-black font-mono tracking-tight mb-1 text-white">
              <span id="resTargetCalories">2.450</span>
              <span class="text-lg font-sans font-normal text-zinc-400">kcal/Tag</span>
            </div>

            <p id="resGoalDesc" class="text-xs text-zinc-400 mb-6 leading-relaxed">
              Erhaltung (0 kcal) · Metabolisches Gleichgewicht und Körperzusammensetzung
            </p>

            <!-- BMR & TDEE Badges Grid -->
            <div class="grid grid-cols-2 gap-3 pt-4 border-t border-zinc-800 text-xs font-mono">
              <div class="bg-zinc-900/80 p-3 rounded-2xl border border-zinc-800">
                <span class="text-[10px] text-zinc-500 block uppercase font-sans">Grundumsatz (BMR)</span>
                <span id="resBmrVal" class="text-lg font-bold text-emerald-400">1.720</span>
                <span class="text-[10px] text-zinc-400 font-sans block">kcal (Ruhe)</span>
              </div>

              <div class="bg-zinc-900/80 p-3 rounded-2xl border border-zinc-800">
                <span class="text-[10px] text-zinc-500 block uppercase font-sans">Gesamtbedarf (TDEE)</span>
                <span id="resTdeeVal" class="text-lg font-bold text-cyan-400">2.450</span>
                <span class="text-[10px] text-zinc-400 font-sans block">kcal (Aktiv)</span>
              </div>
            </div>

            <!-- BMI Quick Card -->
            <div class="mt-3 bg-zinc-900/50 px-3.5 py-2 rounded-xl border border-zinc-800 flex items-center justify-between text-xs font-mono">
              <span class="text-zinc-400 font-sans">Body-Mass-Index:</span>
              <div class="flex items-center gap-2">
                <span id="resBmiVal" class="font-bold text-white">23,7</span>
                <span id="resBmiCategory" class="text-xs font-bold text-emerald-500">Normalgewicht</span>
              </div>
            </div>
          </div>

          <!-- Macro Doughnut Chart & Split Card -->
          <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 shadow-sm">

            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>Makronährstoffverteilung</span>
              </h3>
            </div>

            <!-- Diet Protocol Selector Tabs -->
            <div class="grid grid-cols-2 gap-1.5 p-1 bg-zinc-200/70 dark:bg-zinc-900 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs mb-5">
