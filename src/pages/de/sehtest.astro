  <script>
    // German UI Localization Patch for dynamic eye-tester texts
    (function() {
      const eyeLabel = document.getElementById('acuity-eye-label');
      const eyeInstruction = document.getElementById('acuity-instruction');
      const eyeProgress = document.getElementById('acuity-eye-progress');

      function patchTexts() {
        if (eyeLabel) {
          const t = eyeLabel.textContent || '';
          if (t.includes('Right eye')) eyeLabel.textContent = 'Rechtes Auge';
          else if (t.includes('Left eye')) eyeLabel.textContent = 'Linkes Auge';
          else if (t.includes('Both eyes')) eyeLabel.textContent = 'Beide Augen';
        }
        if (eyeInstruction) {
          const inst = eyeInstruction.textContent || '';
          if (inst.includes('Cover your LEFT eye')) eyeInstruction.textContent = 'Decken Sie Ihr LINKES Auge ab.';
          else if (inst.includes('Cover your RIGHT eye')) eyeInstruction.textContent = 'Decken Sie Ihr RECHTES Auge ab.';
          else if (inst.includes('Keep BOTH eyes open')) eyeInstruction.textContent = 'Lassen Sie BEIDE Augen geöffnet.';
        }
        if (eyeProgress) {
          const ep = eyeProgress.textContent || '';
          if (ep.includes('Eye 1 of 3')) eyeProgress.textContent = 'Auge 1 von 3';
          else if (ep.includes('Eye 2 of 3')) eyeProgress.textContent = 'Auge 2 von 3';
          else if (ep.includes('Eye 3 of 3')) eyeProgress.textContent = 'Auge 3 von 3';
        }
      }

      const observer = new MutationObserver(patchTexts);
      if (eyeLabel) observer.observe(eyeLabel, { childList: true, characterData: true, subtree: true });
      if (eyeInstruction) observer.observe(eyeInstruction, { childList: true, characterData: true, subtree: true });
    })();
  </script>
