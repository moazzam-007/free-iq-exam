---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Online-Sehtest: Sehschärfe mit Snellen-Sehtafel prüfen | FreeIQExam";
const description = "Testen Sie Ihre Sehschärfe (Visus) orientierend online mit unserer digitalen Snellen-Sehtafel und Bildschirmkalibrierung. Schnell und ohne Anmeldung.";
const canonicalUrl = "https://freeiqexam.com/de/sehtest";

const alternates = {
  en: "https://freeiqexam.com/eye-test",
  ru: "https://freeiqexam.com/ru/eye-test",
  id: "https://freeiqexam.com/id/tes-mata",
  fi: "https://freeiqexam.com/fi/nakotesti",
  de: "https://freeiqexam.com/de/sehtest"
};

const faqItems = [
  [
    'Wie zuverlässig ist ein Online-Sehtest im Vergleich zum Augenarzt oder Optiker?',
    'Ein Online-Sehtest liefert eine wertvolle Orientierung darüber, wie gut Sie auf eine bestimmte Distanz sehen. Er kann jedoch weder Refraktionswerte präzise bestimmen noch Augeninnendruck, Hornhautbeschaffenheit oder Netzhautgesundheit prüfen. Bildschirmauflösung, Sehabstand und Raumbeleuchtung beeinflussen das Ergebnis. Betrachten Sie das Resultat als Anlass für einen professionellen Sehtest, nicht als Ersatz dafür.'
  ],
  [
    'Warum muss zu Beginn eine Plastikkarte an den Bildschirm gehalten werden?',
    'Sehschärfe (Visus) ist optisch als Sehwinkel definiert, den ein Buchstabe am Auge einnimmt – nicht in Bildschirmpixeln. Auf 1 Meter Abstand muss ein 20/20-Zeichen (Visus 1,0) exakt 1,45 mm hoch sein. Da Webbrowser die physische Pixeldichte Ihres Bildschirms nicht verlässlich kennen, ermittelt der Abgleich mit einer genormten Karte (ISO-Kreditkartenformat: 85,6 mm) den realen Millimeter-pro-Pixel-Faktor.'
  ],
  [
    'Warum bricht der Test bei manchen Bildschirmen vor 20/20 ab?',
    'Bei geringem Sehabstand (z. B. 40 cm oder 1 m) ist ein Visus-1,0-Zeichen auf normalen PC-Monitoren nur etwa 5 Pixel hoch. Um eine saubere 5-Strich-Snellen-Geometrie darzustellen, sind jedoch mindestens 12 Pixel nötig. Anstatt fiktive Schätzwerte anzuzeigen, stoppt die Software ehrlich an der physikalischen Auflösungsgrenze Ihres Monitors. Bei größerem Testabstand (z. B. 2 oder 3 Meter) können feinere Stufen physisch größer dargestellt werden.'
  ],
  [
    'Was ist die Tumbling-E-Sehtafel und warum werden keine Buchstaben abgefragt?',
    'Das Snellen-E (Tumbling-E) ist ein E-Haken, dessen Öffnung nach oben, unten, links oder rechts zeigt. Da lediglich die Richtung angegeben wird, ist der Test unabhängig von Sprache, Alphabetkenntnis oder Lesekompetenz. Es handelt sich um den internationalen Goldstandard für standardisierte Sehtests.'
  ],
  [
    'Was zeigt das Astigmatismus-Sonnenrad (Strahlenkranz)?',
    'Das Sonnenrad besteht aus radialen Linien in alle Richtungen. Liegt eine Hornhautverkrümmung (Stabsichtigkeit / Astigmatismus) vor, bricht das Auge das Licht in verschiedenen Achsen ungleichmäßig. Dadurch erscheinen einzelne Linienpaare deutlich dunkler oder schärfer als andere. Ist dieser Effekt ausgeprägt, empfiehlt sich eine optometrische Überprüfung.'
  ],
  [
    'Was bedeutet der Rot-Grün-Duochrom-Test?',
    'Der Duochrom-Test nutzt die chromatische Aberration des Auges: Grünes Licht (~535 nm) wird im Auge stärker gebrochen als rotes Licht (~650 nm). Erscheinen die Zeichen auf dem roten Feld schärfer, liegt tendenziell eine Kurzsichtigkeit (Myopie) vor; wirken sie auf Grün schärfer, deutet dies auf Weitsichtigkeit (Hyperopie) hin. Bei ausgeglichener Sehschärfe wirken beide Felder gleich scharf.'
  ],
  [
    'Ersetzt dieser Test den Sehtest für den Führerschein?',
    'Nein. Der amtliche Führerschein-Sehtest in Deutschland, Österreich und der Schweiz (nach FeV bzw. Führerscheingesetz) darf ausschließlich von amtlich anerkannten Sehteststellen, Augenoptikern oder Augenärzten unter standardisierten Licht- und Messbedingungen abgenommen und bescheinigt werden.'
  ],
  [
    'Wann sollte sofort ein Augenarzt aufgesucht werden?',
    'Bei plötzlichem Sehverlust, dem Auftreten von Lichtblitzen, rußartigem Flockenregen, einem dunklen Vorhang im Gesichtsfeld, Doppelbildern oder akuten Augenschmerzen handelt es sich um augenärztliche Notfälle. In diesen Fällen darf keinesfalls abgewartet oder online getestet werden – suchen Sie sofort eine Augenklinik auf.'
  ]
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Online-Sehtest: Sehschärfe, Astigmatismus & Rot-Grün-Abgleich',
    url: canonicalUrl,
    inLanguage: 'de',
    medicalAudience: 'Patient',
    aspect: 'Screening',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Refraktionsfehler',
      alternateName: ['Myopie', 'Hyperopie', 'Astigmatismus', 'Presbyopie']
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Online-Sehtest mit Snellen-E-Sehtafel & Bildschirmkalibrierung',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'All',
    inLanguage: 'de',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    accessibilitySummary: 'Pfeiltastatur-Steuerung für E-Haken, physische Bildschirmkalibrierung mit Standardkarte, Screenreader-Unterstützung und druckbarer Ergebnisbericht.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://freeiqexam.com/de/' },
      { '@type': 'ListItem', position: 2, name: 'Selbsttests', item: 'https://freeiqexam.com/de/#tests' },
      { '@type': 'ListItem', position: 3, name: 'Online-Sehtest', item: canonicalUrl }
    ]
  }
];

const stages = [
  ['intro-section', '1 · Übersicht'],
  ['calibration-section', '2 · Kalibrierung'],
  ['acuity-section', '3 · Sehschärfe'],
  ['astigmatism-section', '4 · Astigmatismus'],
  ['duochrome-section', '5 · Rot-Grün'],
  ['results-section', '6 · Auswertung']
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="de"
>
  <Header currentPath="/de/sehtest" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-[#000000] dark:text-white transition-colors duration-200">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/de/" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Startseite</a>
        <span aria-hidden="true">/</span>
        <span class="text-zinc-600 dark:text-zinc-300">Selbsttests</span>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white font-semibold">Online-Sehtest</span>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-[#2997ff] sm:text-sm">
          <svg class="w-4 h-4 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          Bildschirmkalibrierte Sehschärfeprüfung
        </div>

        <h1 class="mt-6 font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em]">
          Online-Sehtest: Sehschärfe mit Snellen-Sehtafel prüfen
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Prüfen Sie Ihre Sehschärfe (Visus) mit physisch kalibrierten Snellen Tumbling-E-Haken, testen Sie Hornhautverkrümmung mit dem Astigmatismus-Sonnenrad und vergleichen Sie Rot-Grün-Farbkontraste direkt im Browser.
        </p>

        <!-- MANDATORY SENSORY SAFETY DISCLAIMER -->
        <p class="text-xs sm:text-sm text-amber-800 dark:text-amber-200 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 rounded-xl px-4 py-3 mt-4 max-w-2xl mx-auto leading-relaxed">
          <strong>Medizinischer Hinweis:</strong> Dieser Online-Sehtest / Hörtest dient rein als orientierende Selbsteinschätzung für den Heimgebrauch und ersetzt keine professionelle augenärztliche oder HNO-ärztliche Untersuchung.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['Physische Kartenkalibrierung', 'Tumbling-E Snellen-Haken', 'Astigmatismus-Sonnenrad', 'Rot-Grün-Duochrom-Abgleich', 'Ohne Anmeldung'].map((item) => (
            <span class="rounded-full border border-zinc-200 bg-zinc-50/80 px-4 py-2 text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 shadow-sm">{item}</span>
          ))}
        </div>
      </header>

      <!-- Main Vision App Container -->
      <section id="eye-app" class="mx-auto mt-12 max-w-4xl">
        <ol class="stage-strip" aria-label="Testfortschritt">
          {stages.map(([id, label]) => (
            <li data-stage={id} class="stage-chip">{label}</li>
          ))}
        </ol>

        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/90 p-5 dark:border-zinc-800 dark:bg-zinc-950 p-6 sm:p-9 shadow-sm">

          <!-- Stage 1: Intro Section -->
          <section id="intro-section" class="rounded-[1.5rem] border border-blue-200 bg-blue-50/70 p-6 dark:border-blue-900/50 dark:bg-blue-950/20 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Hinweis vor Beginn</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Orientierender Selbsttest — keine augenärztliche Untersuchung</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Dieser Test schätzt Ihre Sehschärfe auf eine gewählte Distanz ab. Er kann weder den Augeninnendruck noch den Sehnerv oder die Netzhaut beurteilen und ersetzt kein augenärztliches Rezept.
            </p>
            <ul class="mt-5 space-y-3 text-sm sm:text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
              <li class="flex items-start gap-2">
                <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">•</span>
                Halten Sie eine handelsübliche Plastikkarte (z. B. Bankkarte oder Personalausweis) bereit, um den Bildschirm exakt zu kalibrieren.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">•</span>
                Sie decken während des Tests jeweils ein Auge mit der flachen Hand ab, ohne Druck auf das Auge auszuüben.
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">•</span>
                Tragen Sie Ihre gewohnte Sehhilfe (Brille oder Kontaktlinsen), falls Sie Ihre korrigierte Sehschärfe überprüfen möchten.
              </li>
            </ul>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <button
                id="begin-eye-test"
                type="button"
                class="rounded-full bg-[#0066cc] hover:bg-[#0055b3] text-white px-8 py-4 text-base font-semibold shadow-sm transition-all duration-150 hover:scale-[1.02] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              >
                Sehtest jetzt starten
              </button>
              <span class="text-sm text-zinc-500 dark:text-zinc-400">Tastatur: Pfeiltasten ↑ ↓ ← → während der Sehschärfeprüfung</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-xs sm:text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200">
              <strong>Plötzlicher Sehverlust, Rußregen, Lichtblitze oder akute Augenschmerzen sind medizinische Notfälle.</strong> Testen Sie nicht online, sondern suchen Sie sofort einen Augenarzt oder eine Notaufnahme auf.
            </p>
          </section>

          <!-- Stage 2: Calibration Section -->
          <section id="calibration-section" class="hidden" aria-labelledby="calibration-title">
            <div class="rounded-[1.5rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-8 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Schritt 1 · Physische Bildschirmkalibrierung</p>
              <h2 id="calibration-title" class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Passen Sie die Karte an Ihren Bildschirm an</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Halten Sie eine echte Bank- oder Ausweiskarte flach an den Bildschirm und verschieben Sie den Regler, bis der weiße Umriss exakt so breit ist wie die Karte. Dies ermittelt das reale Millimeter-Pixel-Verhältnis Ihres Displays.
              </p>

              <div class="calibration-stage mt-6">
                <div id="card-preview" class="card-preview" aria-hidden="true"></div>
              </div>

              <label for="card-slider" class="mt-8 block text-base font-semibold text-zinc-900 dark:text-white">Kartenbreite auf dem Display</label>
              <input id="card-slider" type="range" min="100" max="600" step="1" value="260" class="calibration-slider" />
              <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-zinc-500 dark:text-zinc-400">
                <span>Kartenbreite: <strong id="card-width-label" class="font-mono text-zinc-900 dark:text-white">260 px</strong></span>
                <span>Bildschirm-Maßstab: <strong id="ppm-readout" class="font-mono text-zinc-900 dark:text-white">—</strong></span>
              </div>

              <div class="mt-8">
                <p class="text-base font-semibold text-zinc-900 dark:text-white">Testabstand zum Bildschirm</p>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">Wählen Sie die Distanz zwischen Ihren Augen und dem Bildschirm:</p>
                <div class="mt-4 flex flex-wrap gap-3">
                  {[
                    ['near', '40 cm', 'Smartphone / Tablet'],
                    ['desk', '1 m', '3,3 ft · Schreibtischabstand'],
                    ['room', '2 m', '6,6 ft · Zimmerabstand'],
                    ['hall', '3 m', '10 ft · Wohnzimmer'],
                    ['snellen', '6 m', '20 ft · Snellen-Standard']
                  ].map(([id, label, hint]) => (
                    <button type="button" data-distance={id} class="distance-button">
                      <span class="distance-label">{label}</span>
                      <span class="distance-hint">{hint}</span>
                    </button>
                  ))}
                </div>
              </div>

              <p id="resolution-warning" class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200"></p>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button
                  id="confirm-calibration"
                  type="button"
                  class="rounded-full bg-[#0066cc] hover:bg-[#0055b3] text-white px-7 py-4 text-base font-semibold transition active:scale-[0.97]"
                >
                  Kalibriert — Sehschärfetest starten
                </button>
                <button
                  id="skip-calibration"
                  type="button"
                  class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800 transition active:scale-[0.97]"
                >
                  Weiter zu Astigmatismus &amp; Duochrom
                </button>
              </div>
            </div>
          </section>

          <!-- Stage 3: Acuity Section -->
          <section id="acuity-section" class="hidden" aria-labelledby="acuity-title">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Schritt 2 · Sehschärfenprüfung (Visus)</p>
                <h2 id="acuity-title" class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl"><span id="acuity-eye-label">Rechtes Auge</span></h2>
              </div>
              <div class="text-left sm:text-right">
                <div id="acuity-eye-progress" class="text-base font-semibold text-zinc-900 dark:text-white sm:text-lg">Auge 1 von 3</div>
                <div id="acuity-trial-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">—</div>
              </div>
            </div>

            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
              <div id="acuity-progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:0%"></div>
            </div>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div id="acuity-tier-dots" class="tier-dots" aria-hidden="true"></div>
              <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">3 richtige Antworten schalten die nächste Stufe frei</p>
            </div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <p id="acuity-instruction" class="rounded-2xl border border-blue-200 bg-blue-50/70 px-5 py-4 text-base font-semibold text-blue-900 dark:border-blue-900/50 dark:bg-blue-950/30 dark:text-blue-200 sm:text-lg">
                Decken Sie Ihr LINKES Auge ab.
              </p>

              <p class="mt-6 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg">
                In welche Richtung zeigt die Öffnung des E? Aktuelle Stufe: <strong id="acuity-tier-label" class="font-mono text-zinc-900 dark:text-white">—</strong>
              </p>

              <div id="optotype-mount" class="mt-6"></div>

              <div class="direction-pad mt-8">
                <div></div>
                <button type="button" data-direction="up" class="direction-button" aria-label="E zeigt nach oben">↑</button>
                <div></div>
                <button type="button" data-direction="left" class="direction-button" aria-label="E zeigt nach links">←</button>
                <div class="direction-center" aria-hidden="true">E</div>
                <button type="button" data-direction="right" class="direction-button" aria-label="E zeigt nach rechts">→</button>
                <div></div>
                <button type="button" data-direction="down" class="direction-button" aria-label="E zeigt nach unten">↓</button>
                <div></div>
              </div>

              <p class="mt-6 text-center text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
                Nutzen Sie die Bildschirmtasten oder die Pfeiltasten auf Ihrer Tastatur.
              </p>
            </article>
          </section>

          <!-- Stage 4: Astigmatism Section -->
          <section id="astigmatism-section" class="hidden" aria-labelledby="astig-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Schritt 3 · Astigmatismus-Sonnenrad</p>
              <h2 id="astig-title" class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Erscheinen bestimmte Linien dunkler oder schärfer?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Blicken Sie aus dem gewählten Sehabstand abwechselnd mit jedem Auge auf das Zentrum des Sonnenrads. Vergleichen Sie die 12 Strahlen: Bei einer Hornhautverkrümmung heben sich oft einzelne Achsen spürbar schwärzer oder klarer ab als die übrigen.
              </p>
              <div id="dial-mount" class="dial-stage mt-8"></div>
              <p id="dial-selection-label" class="mt-6 text-base font-semibold text-[#0066cc] dark:text-[#2997ff]">Noch keine Linien ausgewählt.</p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="submit-astigmatism" type="button" class="rounded-full bg-[#0066cc] hover:bg-[#0055b3] text-white px-7 py-4 text-base font-semibold transition active:scale-[0.97]">Weiter zum Rot-Grün-Test</button>
                <button id="dial-none" type="button" aria-pressed="false" class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800 transition active:scale-[0.97]">Alle Linien erscheinen gleichmäßig</button>
              </div>
            </div>
          </section>

          <!-- Stage 5: Duochrome Section -->
          <section id="duochrome-section" class="hidden" aria-labelledby="duo-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Schritt 4 · Rot-Grün-Duochrom-Abgleich</p>
              <h2 id="duo-title" class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Auf welchem Farbfeld wirkt der Ring schärfer?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Vergleichen Sie den schwarzen Ring auf rotem Hintergrund mit dem Ring auf grünem Hintergrund. Beurteilen Sie die <strong>Randschärfe und Klarheit</strong>, nicht die Helligkeit der Farben.
              </p>
              <div class="duochrome-grid mt-8">
                <div class="duochrome-panel duo-red">
                  <div id="duochrome-red" class="duochrome-target"></div>
                  <span class="duochrome-caption">Rot · ~650 nm</span>
                </div>
                <div class="duochrome-panel duo-green">
