---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Ilmainen Aikuisten ADHD-Testi (ASRS v1.1 -itsearviointi) | FreeIQExam";
const description = "Tee standardoitu aikuisten ADHD-itsearviointikysely (ASRS v1.1). Tunnista tarkkaamattomuuden ja keskittymisvaikeuksien oireet luotettavasti verkossa.";
const canonicalUrl = 'https://freeiqexam.com/fi/adhd-testi';

const alternates = {
  en: 'https://freeiqexam.com/adhd-test',
  ru: 'https://freeiqexam.com/ru/adhd-test',
  id: 'https://freeiqexam.com/id/tes-adhd',
  fi: 'https://freeiqexam.com/fi/adhd-testi'
};

const faqItems = [
  ['Kuinka tarkka online-aikuisten ADHD-seulontatesti on?', 'Online-seulonta voi tunnistaa oireita, jotka voisivat olla peruste laajemmalle arviointille, mutta se ei voi diagnosoida ADHD:ta yksin. Kliinikon on otettava huomioon oireiden pysyvyys, toimintahäiriö, kehityshistoria, konteksti ja vaihtoehtoiset selitykset.'],
  ['Mikä ero on ADD:lla ja ADHD:lla?', 'ADD on vanhempi termi. Nykyinen diagnostinen kieli käyttää ADHD:tä ja kuvaa pääosin tarkkaamatonta, pääosin hyperaktiivista/impulsiivista tai yhdistettyä esitystyyppiä. Ihmiset, jotka käyttävät termiä ADD, viittaavat usein tarkkaamattomaan esitystyyppiin.'],
  ['Miksi aikuisten ADHD voi ilmetä eri tavoin naisilla?', 'Tarkkaamattomuusoireet, sisäinen levottomuus, perfektionistinen kompensointi ja sosiaalinen maskaus voivat tehdä oireista vähemmän näkyviä. Hormonaaliset muutokset voivat myös muuttaa tarkkaavuuskykyä, unia ja oireiden taakkaa, mutta ne eivät ole ADHD:n spesifisiä.'],
  ['Mitkä ovat kuusi kysymystä WHO:n ASRS-osan A seulonnassa?', 'Osan A kysymykset koskevat projektien viimeistelemistä, tehtävien organisointia, tapaamisten tai velvollisuuksien muistamista, vaativien tehtävien lykkäämistä, puudutusta istuessa ja tunnetta liiallisesta aktiivisuudesta tai motorisesta ajamisesta.'],
  ['Voiko aikuinen saada ADHD:n, jos hänellä ei ollut sitä lapsena?', 'Selainta käyttävä seulonta ei voi vastata tähän lopullisesti. ADHD on neurologisen kehityksen tila, joten muodollinen arviointi etsii näyttöä oireiden olemassaolosta varhaisemmassa vaiheessa ja ottaa huomioon muut mahdolliset selitykset uusille aikuisiän keskittymisvaikeuksille.'],
  ['Miten ADHD eroaa kroonisesta ahdistuneisuudesta tai masennuksesta?', 'Ahdistuneisuus ja masennus voivat molemmat heikentää keskittymiskykyä ja toiminnanohjausta. ADHD voi myös overlappata näiden kanssa, ja useampi kuin yksi tila voi esiintyä samanaikaisesti. Aikajänite, käynnistäjät, toimintahäiriö, uni, mieliala ja kehityshauta auttavat erottamaan kuviot.'],
  ['Mitä pitäisi tehdä, jos seulonta viittaa korkeaan ADHD:n todennäköisyyteen?', 'Käytä tulosta rakennettuna keskustelun aloittajana. Kirjaa todellisia esimerkkejä, esiintymistiheyttä, toiminnallisia vaikutuksia, lapsuuden historiaa (jos saatavilla), unia ja mielialatekijöitä, lääkkeitä ja muita olennaisia konteksteja ja keskustele niistä asianmukaisen kliinikon kanssa.'],
  ['Lasketaanko online-seulontatesti muodolliseksi lääketieteelliseksi diagnoosiksi?', 'Ei. Se tuottaa vain seulontatietoa. Muodollinen diagnoosi vaatii laajemman kliinisen arvioinnin. Valinnainen Go/No-Go-tehtävä on suorituskykyviite eikä itsenäinen diagnostinen testi.']
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Aikuisten ADHD-Itsearviointiasteikko (ASRS v1.1) -seulonta',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Ilmainen Aikuisten ADHD-Seulontakysely',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Näppäimistöllä ohjattavat vastauskontrollit, näkyvät kohdistustilat, semanttiset otsikot, live-ilmoitukset ja tulostettavat tulokset.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Koti', item: 'https://freeiqexam.com/' },
      { '@type': 'ListItem', position: 2, name: 'Arvioinnit', item: 'https://freeiqexam.com/test' },
      { '@type': 'ListItem', position: 3, name: 'Aikuisten ADHD-Testi', item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Aikuisten ADHD-Seulontakysely — 18 kysymystä',
    url: canonicalUrl,
    numberOfQuestions: 18,
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schemas}>
  <Header />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/" class="hover:text-zinc-950 dark:hover:text-white">Koti</a><span aria-hidden="true">/</span>
        <a href="/test" class="hover:text-zinc-950 dark:hover:text-white">Arvioinnit</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Aikuisten ADHD-Testi</span>
      </nav>

      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center rounded-full border border-violet-200 bg-violet-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-violet-700 dark:border-violet-900/60 dark:bg-violet-950/40 dark:text-violet-300 sm:text-sm">
          KLIININEN ITSEARVIOINTI & ASRS V1.1 SEULONTA
        </div>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Aikuisten ADHD-Testi & Itsearviointi
      </h1>
        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Arvioi tarkkaamattomuuden, impulsiivisuuden ja keskittymisvaikeuksien oireita standardoidulla ASRS v1.1 -seulontakyselyllä.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['18 kysymystä', 'Vastausvaihtoehdot', 'Tulostettava yhteenveto', 'Ei tarvita tiliä'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="adhd-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">
          <div id="assessment-intro" class="rounded-[1.5rem] border border-violet-200 bg-violet-50 p-6 dark:border-violet-900/50 dark:bg-violet-950/30 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300 sm:text-sm">Ennen aloittamista</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Seulonta ei ole diagnoosi</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Vastaa perustuen tyyppillisiiin kokemuksiisi. Seulonta arvioi oireiden esiintyvyyttä tämän toteutuksen käyttämien kynnysarvojen mukaisesti. Se ei voi vahvistaa ADHD:ta eikä korvaa lääketieteellistä tai psykologista arviointia.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-assessment" type="button" class="rounded-full bg-violet-600 px-7 py-4 text-base font-semibold text-white transition hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500">Aloita aikuisten ADHD-seulonta</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Näppäimet: 1–5 vastaamiseen · ← / → siirtymiseen</span>
            </div>
          </div>

          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300 sm:text-sm">Osa A · Kliininen seulonta</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-700 dark:text-zinc-300">Tarkkaamattomuus</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold sm:text-lg">Kysymys 1 / 18</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">0% vastattu</div>
              </div>
            </div>
            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="progress-fill" class="h-full rounded-full bg-violet-600 transition-all duration-300" style="width:4%"></div></div>
            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-wrap gap-2 text-sm font-semibold text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Valitse yksi</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Ei koskaan → Erittäin usein</span>
              </div>
              <h2 id="question-heading" class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl"></h2>
              <p id="question-context" class="mt-3 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg"></p>
              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-5" role="group" aria-label="Frequency response options"></div>
              <p class="mt-6 rounded-2xl border border-violet-200 bg-violet-50/70 px-5 py-4 text-sm text-violet-900 dark:border-violet-900/50 dark:bg-violet-950/30 dark:text-violet-200 sm:text-base">Korostetut vaihtoehdot ovat vastauksia, jotka lasketaan merkityksi nykyiselle kohteelle.</p>
              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="rounded-full border border-zinc-300 bg-white px-6 py-3.5 text-base font-semibold dark:border-zinc-700 dark:bg-zinc-900">Takaisin</button>
                <button id="next-button" type="button" class="rounded-full bg-zinc-950 px-7 py-3.5 text-base font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-950">Seuraava kysymys</button>
              </div>
            </article>
          </section>

          <section id="cognitive-section" class="hidden" aria-labelledby="cognitive-title">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300 sm:text-sm">Valinnainen objektiivinen osio</p>
                <h2 id="cognitive-title" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">20-kokeen Go/No-Go impulssikoe</h2>
              </div>
              <div class="text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Istunto <span id="cognitive-session-id" class="font-mono">—</span></div>
            </div>
            <div class="mt-6 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div id="cognitive-start-panel">
                <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">Vihreä tarkoittaa <strong>paina Välilyönti tai napauta</strong>. Punainen tarkoittaa <strong>pidätä</strong>. Tehtävä tallentaa kelvolliset Go-reaktoajat ja No-Go komissiovirheet. Se on suorituskyvyn viitearvo, ei diagnostinen testi.</p>
                <div class="mt-6 flex flex-wrap gap-3">
                  <button id="begin-cognitive" type="button" class="rounded-full bg-violet-600 px-7 py-4 text-base font-semibold text-white transition hover:scale-[1.02] active:scale-[0.98]">Aloita 20-kokeen haaste</button>
                  <button id="skip-cognitive" type="button" class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold dark:border-zinc-700">Ohita ja katsele kyselyn tuloksia</button>
                </div>
              </div>
              <div id="cognitive-countdown" class="hidden py-5 text-center text-5xl font-extrabold tracking-tight text-violet-600 dark:text-violet-400" aria-live="polite">3</div>
              <div class="mt-7 flex items-center justify-between text-sm text-zinc-500 dark:text-zinc-400 sm:text-base"><span>Koe</span><span id="cognitive-trial">0 / 20</span></div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="cognitive-progress-fill" class="h-full rounded-full bg-violet-600" style="width:0%"></div></div>
              <button id="cognitive-target" type="button" class="mx-auto mt-10 flex aspect-square w-full max-w-[22rem] items-center justify-center rounded-full border-2 border-zinc-300 bg-zinc-100 opacity-0 transition-transform duration-75 focus:outline-none focus-visible:ring-4 focus-visible:ring-violet-500 dark:border-zinc-700 dark:bg-zinc-900" aria-label="Go/No-Go response target">
                <span id="cognitive-target-label" class="text-2xl font-extrabold tracking-tight sm:text-3xl">Odota…</span>
              </button>
              <p class="mt-5 text-center text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Paina <kbd class="rounded border border-zinc-300 bg-zinc-100 px-2 py-1 font-mono dark:border-zinc-700 dark:bg-zinc-900">Välilyönti</kbd> tai napauta ympyrää.</p>
            </div>
          </section>

          <section id="results-section" class="hidden" aria-labelledby="results-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div id="result-badge" class="result-badge low">Matala kliininen todennäköisyys</div>
                  <h2 id="results-title" class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">Seulontaprofiilisi</h2>
                  <p id="result-classification" class="mt-2 text-xl font-bold text-violet-700 dark:text-violet-300">Matala / ei-kliininen kuva</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 sm:text-base">Ei diagnoosia</div>
              </div>
              <p id="result-narrative" class="mt-6 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg"></p>

              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <article class="score-card"><div class="score-label">Osa A</div><div id="part-a-score" class="mt-3 text-3xl font-extrabold">0 / 6</div><div id="part-a-status" class="score-status">Alittaa kynnysarvon</div><div class="meter"><span id="part-a-bar"></span></div></article>
                <article class="score-card"><div class="score-label">Tarkkaamattomuus</div><div id="inattention-score" class="mt-3 text-3xl font-extrabold">0 / 36</div><div id="inattention-status" class="score-status">Matalampi ilmaantuvuus</div><div class="meter"><span id="inattention-bar"></span></div></article>
                <article class="score-card"><div class="score-label">Hyperaktiivisuus / Impulsiivisuus</div><div id="hyperactivity-score" class="mt-3 text-3xl font-extrabold">0 / 36</div><div id="hyperactivity-status" class="score-status">Matalampi ilmaantuvuus</div><div class="meter"><span id="hyperactivity-bar"></span></div></article>
              </div>

              <article id="cognitive-result-card" class="mt-4 hidden rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900">
                <p class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-base">Go / No-Go viitearvo</p>
                <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  <div class="stat-card"><span>Keskim. RT</span><strong id="cognitive-rt">—</strong></div>
                  <div class="stat-card"><span>RT-vaihtelu</span><strong id="cognitive-rtv">—</strong></div>
                  <div class="stat-card"><span>Komissiovirheet</span><strong id="cognitive-errors">—</strong></div>
                  <div class="stat-card"><span>Ohitukset</span><strong id="cognitive-omissions">—</strong></div>
                </div>
              </article>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-base">Toiminnanhallintamatriisi</p>
                <h3 class="mt-2 text-xl font-bold sm:text-2xl">Oirealueiden hetkikuva</h3>
                <div id="profile-matrix" class="mt-6 space-y-5"></div>
              </article>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="print-result" type="button" class="rounded-full bg-zinc-950 px-7 py-4 text-base font-semibold text-white dark:bg-white dark:text-zinc-950">Tulosta kliinikön vastaanottoyhteenveto</button>
                <button id="share-result" type="button" class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold dark:border-zinc-700">Jaa seulontayhteenveto</button>
                <button id="retake-result" type="button" class="rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold dark:border-zinc-700">Suorita arviointi uudelleen</button>
              </div>

              <div class="mt-8 rounded-3xl border border-violet-200 bg-violet-50 p-6 dark:border-violet-900/50 dark:bg-violet-950/30">
                <h3 class="text-xl font-bold sm:text-2xl">Lue tulos kontekstissa</h3>
                <p class="mt-3 text-base leading-relaxed text-violet-950 dark:text-violet-100 sm:text-lg">Myönteinen seulonta tarkoittaa, että vastauskuviot ylittivät tämän seulontatyökalun kynnysarvon. Se ei vahvista ADHD:ta, sen vaikeusastetta, esitystyyppiä tai hoitoa. Uniapnea, ahdistuneisuus, masennus, kaksisuuntaisen mielialahäiriön oireet, lääkkeiden vaikutukset, stressi ja muut sairaudet voivat overlappata keskittymis- ja toiminnanohjausoireiden kanssa.</p>
              </div>
            </div>
          </section>

          <p id="adhd-live-region" class="sr-only" aria-live="polite"></p>
        </div>
      </section>

      <article class="mx-auto mt-16 max-w-4xl text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
        <section><p class="eyebrow">Kliininen opas</p><h2 class="mt-3 section-title">Aikuisten ADHD:n ymmärtäminen yksittäisen pisteytyksen ulkopuolella</h2><p class="mt-6">Aikuisten ADHD:ta on paras ymmärtää pysyvänä kuviotena tarkkaavuuden sääntelyn, estämisen, organisoinnin ja toiminnanohjauksen vaikeuksista, jotka aiheittavat merkittäviä ongelmia arjessa. Kysely auttaa järjestämään oireita, mutta diagnoosi riippuu laajemmasta tarinasta: kuinka kauan kuvio on ollut olemassa, kuinka johdonmukaisesti se ilmenee, kuinka paljon se häiritsee toimintaa ja mitä muita selityksiä samoihin kokemuksiin voi olla.</p></section>

        <section class="guide-section"><h2 class="section-title">1. Aikuisten ADHD:n neurobiologia</h2><p class="mt-5">ADHD:ta yhdistetään erilaisuuksiin hajautettujen aivojen järjestelmien välillä, jotka osallistuvat tarkkaavuuteen, motivaatioon, ajanmittaukseen, toiminnan valintaan ja toiminnanohjaukseen. Frontostriaalisia verkostoja keskustellaan usein, koska ne tukevat suunnittelua, vastausten valintaa, palkintoprosessointia ja tavoitteiden ylläpitämistä. Dopamiini ja noradrenaliini molemmat osallistuvat näihin verkostoihin. On tarkempi ajatella ADHD:ta sääntelyn ongelmana eri järjestelmien välillä kuin yksittäisen neurotransmitterin yksinkertaisena puutteena.</p><p class="mt-5">Dorsolateraali prefrontaalikorttali osallistuu työmuistiin, suunnitteluun, estämiseen ja tavoitteiden ylläpitämiseen, kun häiriöt kilpailevat tarkkaavuudesta. Ihminen voi siis tietää mitä pitäisi tapahtua ja silti taistella sen ylläpitämisen kanssa, jota mielen tila vaatii aloittamiseksi tai viimeistelemiseksi. Tämä selittää, miksi älykkyys ja koulutustaso eivät suojaa toiminnanohjauksen häiriöiltä.</p><p class="mt-5">Oletusverkosto on aktiivinen sisäisesti suunnatuissa ajatuksissa. Tehokas tehtävien suorittaminen vaatii joustavaa koordinaatiota sisäisesti keskittyvien ja tehtävään keskittyvien verkostojen välillä. Vaikeudet spontaanien sisäisten ajatusten tukahduttamisessa tai niistä siirtymisessä voivat tuntua mieleen vaeltamisesta, tunkeutuvista ajatuksista tai kyvyttömyydestä pysyä henkisesti kiinnittyneenä matalan kiinnostuksen työhön. Nämä ajatusmuodot ovat hyödyllisiä tutkimuksen ymmärtämisessä, ei yksilön diagnosoimisessa selaintestillä.</p></section>

        <section class="guide-section"><h2 class="section-title">2. DSM-5 diagnostiset kriteerit ja mitä seulonta jättää pois</h2><p class="mt-5">Seulontakysely otannöi oireita; diagnoosi on kliininen muotoilu. Täydellinen aikuisten ADHD-arviointi ottaa huomioon pysyvät oireet tarkkaamattomuudesta ja/tai hyperaktiivisuudesta/impulsiivisuudesta, kliinisesti merkittävän toimintahäiriön, näytön siitä, että kuvio oli olemassa aikaisemmin kehityksessä ja onko jokin toinen tila parempi selitys. Oireita ei pitäisi tulkita yhdestä tavallisesti stressaavasta viikosta.</p><p class="mt-5">Toimintahäiriö voi ilmetä kroonisena myöhästymisenä, ohitettuina määräaikoina, keskeneräisinä tehtävinä, toistuvina hallinnollisina virheinä, tärkeiden esineiden kadottamisena, liiallisena tehtävien vaihteluna, vaarallisina impulsiivisina päätöksinä tai suhteita rasittavana keskeyttämisena ja unhokkainisuutena. Kliinikot etsivät usein esimerkkejä useammasta ympäristöstä, koska konteksti merkitsee. Vahva suorituskyky erittäin rakennetussa ympäristössä ei automaattiseta poista vaikeuksia muualla, erityisesti kun se perustuu voimakkaaseen kompensoivaan vaivaan.</p></section>

        <section class="guide-section"><h2 class="section-title">3. Kolme aikuisten esitystyyppiä</h2><h3 class="mt-8 text-xl font-bold sm:text-2xl">Pääosin tarkkaamaton</h3><p class="mt-4">Tämä kuvio keskittyy herkkyyteen häiriöihin, organisationointivaikeuksiin, unhokkainisuuteen, asioiden kadottamiseen, vaikeuksiin pitää huomiota yllä ja vaikeuksiin saattaa asiat loppuun. Aikuiset voivat kuvata tietävänsä täsmälleen mitä pitäisi tehdä mutta olevansa kykenemättömiä aloittamaan matalan kiinnostuksen tehtävää, kunnes kiireellisyys kasvaa korkeaksi. Ajan arviointi, työmuistin kuorma ja prioriteettien vaihtelu voivat muodostua merkittäviksi pullonkauloiksi.</p><h3 class="mt-8 text-xl font-bold sm:text-2xl">Pääosin hyperaktiivinen/impulsiivinen</h3><p class="mt-4">Aikuisten hyperaktiivisuus voi olla sisäistä eikä näkyvästi dramaattista. Ihmiset voivat kuvata motorista levottomuutta, vaikeuksia istua pitkissä tilanteissa, vaikeuksia rentoutua, liiallista puhumista, kärsimättömyyttä, keskeyttämistä tai toimimista ennen kuin keskustelu- tai menettelyvuoro on päättynyt.</p><h3 class="mt-8 text-xl font-bold sm:text-2xl">Yhdistetty esitystyyppi</h3><p class="mt-4">Yhdistetty esitystyyppi sisältää kliinisesti merkittäviä piirteitä molemmilta alueilta. Kokemus voi olla paradoksaalinen: henkilö voi tuntua fyysisesti tai henkisesti levottomalta ja samalla taistella tärkeän rutiinitehtävän aloittamisen kanssa. Korkean kiinnostuksen toiminta voi edelleen tuottaa intensiivistä sitoutumista, kun taas tylsät mutta välttämättömät tehtävät vaikeuttavat sääntelyä.</p></section>

        <section class="guide-section"><h2 class="section-title">4. Aikuisten ADHD naisilla: maskaus ja hormonaalinen konteksti</h2><p class="mt-5">Toimitettu korostaa tarkkaamattomuuden maskausta, sisäistä levottomuutta, kompensoivaa perfektionismia ja myöhempää tunnistamista naisilla. Henkilö voi luoda monimutkaisia muistutusjärjestelmiä, yliaavalmistella rutiinitehtäviä, tarkistaa työtä toistuvasti tai viettää öitä kiinni päästäkseen kiinni päivän aikana syrjäytyneistä asioista. Ulkoinen suorituskyky voi näyttää vahvalta, kun taas sisäinen kognitiivinen kustannus on korkea.</p><p class="mt-5">Hormonaaliset muutokset voivat muuttaa unia, mielialaa, energiaa ja kognitiivista kokemusta. Puberteetti, synnytyksen jälkeiset muutokset ja perimenopausi voivat muuttaa olemassa olevien oireiden taakkaa joillakin ihmisillä. Estrogeeni vuorovaikuttaa dopamiinergisten järjestelmien kanssa, mutta hormonaalinen muutos ei ole diagnostinen oikotie. Kliinikon on myös otettava huomioon kilpirauhasen sairaus, anemia, lääkkeiden vaikutukset, unihäiriöt, masennus, ahdistuneisuus ja tavallinen elämän stressi.</p></section>

        <section class="guide-section"><h2 class="section-title">5. Differentiaalidiagnostiikka ja komorbiditeetit</h2><p class="mt-5">Ahdistuneisuus voi vetää huomiota huoleen ja uhkien seuraamiseen. Masennus voi vähentää keskittymiskykyä, energiaa, motivaatiota ja mielihyvää. Kaksisuuntaisen mielialahäiriön spektrin häiriöt liittyvät episodisiin muutoksiin mielialassa, unessa, energiassa ja käyttäytymisessä eivätkä vakaaseen elinikäiseen toiminnanohjauskuvi Autismi voi overlappata toiminnanohjauksen, aistien sääntelyn ja sosiaalisen viestinnän erojen kanssa. Uniapnea ja krooninen unen rajoittaminen voivat aiheittaa merkittäviä päivän aikana ilmeneviä keskittymisvaikeuksia.</p><p class="mt-5">Tavoitteena ei ole valita nimikettä, joka kuulostaa tutuimmalta. Tavoitteena on ymmärtää täydellinen aikajänite, käynnistäjät, toimintahäiriö ja samanaikaiset oireet. Useampi kuin yksi tila voi olla läsnä samanaikaisesti, ja hyvä arviointi ottaa sen mahdollisuuden huomioon sen sijaan, että pakottaisi jokaisen oireen yhteen kategoriaan.</p></section>

        <section class="guide-section"><h2 class="section-title">6. Näyttöön perustuvat hoitopolut</h2><p class="mt-5">Hoito on yksilöllistä. Riippuen henkilön tavoitteista ja kliinisestä historiasta, hoito voi yhdistää koulutusta, ympäristön muutoksia, käyttäytymisstrategioita, psykoterapiaa ja lääkitystä. Yleisiä lääkeryhmiä ovat stimulanttilääkkeitä, kuten metyylifenidaati tai amfetamiinivalmisteet ja stimulanttimattomat lääkkeet, kuten atomoksetiini tai guanfatsiini. Nillä lääkkeillä on erilaiset hyödyt, riskit, vasta-aiheet ja seurantavaatimukset, ja ne tulisi valita asianmukaisen kliinikon kanssa.</p><p class="mt-5">CBT:ta ADHD:lle sovellettuna voidaan kohdistaa lykkäämistä, suunnittelua, priorisointia, tunteiden sääntelyä ja loppuunsaattamista. Ulkoistaminen työmuisti näkyvien kalentereiden, muistutusten, tarkistuslistojen ja tehtävien jaottelujen kautta voi vähentää kognitiivista kuormaa. Työpaikan mukautukset voivat sisältää kirjalliset ohjeet, ennustettavan aikataulun, vähemmän keskeytyksiä tai rauhallisemman työtilan, kun se on asianmukaista ja laillisesti mahdollista.</p></section>

        <section class="guide-section"><h2 class="section-title">7. Kuinka käyttää tulosta rakentavasti</h2><p class="mt-5">Seulonta on hyödyllisin rakennettuna keskustelun aloittajana. Kirjaa muutamia konkreettisia esimerkkejä työstä, koulusta, kodista, raha-asioista, ajamisesta ja suhteista. Merkitse esiintymistiheys, seuraukset, selviytymisjärjestelmät ja onko vaikeus pitkäaikainen. Vanhemmat kouluraportit, perheen havainnot tai muut historialliset merkinnät voivat joskus auttaa jäljittelemään lapsuuden kuviota, joita ei koskaan tunnistettu muodollisesti.</p><p class="mt-5">Valinnainen Go/No-Go-tehtävä voi antaa mielenkiintoisen katsauksen vasteiden estokykyyn ja reaktioajan johdonmukaisuuteen, mutta normaali tai poikkeava suorituskyky ei vahvista tai kumoa ADHD:ta. Tietokoneen tehtävät ovat herkkiä monille tekijöille, mukaan lukien väsymys, harjoitus, häiriöt, uni, laitteen viive ja motivaatio. Kliinikon pitäisi sijoittaa mahdollinen suoritustulos laajempaan historiaan.</p><p class="mt-5">Jos kysely ehdottaa korkeaa ADHD:n todennäköisyyttä ja oireet aiheittavat todellista toimintahäiriöä, keskustele kuvioista primaariterveydenhuollon kliinikon, psykiatran, psykologin tai muun pätevän ammattilaisen kanssa. Jos tulos on matala mutta vaikeutesi ovat edelleen vakavia, sekin on keskustelun arvoinen; matala seulonta ei sulje pois muita mielenterveydellisiä, lääketieteellisiä, unia tai ympäristöllisiä syitä kognitiivisille vaikeuksille.</p></section>

        <section id="faq" class="guide-section"><p class="eyebrow">UKK</p><h2 class="section-title mt-3">Usein kysytyt kysymykset aikuisten ADHD-testeistä</h2><div class="mt-7 space-y-3">{faqItems.map(([question, answer]) => (<details class="group rounded-2xl border border-zinc-200 bg-white px-5 py-5 dark:border-zinc-800 dark:bg-zinc-950"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold sm:text-lg"><span>{question}</span><span aria-hidden="true" class="transition group-open:rotate-45">+</span></summary><p class="mt-4 border-t border-zinc-200 pt-4 text-base leading-relaxed text-zinc-600 dark:border-zinc-800 dark:text-zinc-300 sm:text-lg">{answer}</p></details>))}</div></section>

        <section class="guide-section rounded-[2rem] border border-zinc-200 bg-zinc-50 p-7 dark:border-zinc-800 dark:bg-zinc-900/60 sm:p-9"><h2 class="text-2xl font-bold sm:text-3xl">Kliininen vastuuvapauslauseke</h2><p class="mt-4">FreeIQExam tarjoaa koulutus- ja seulontapohjaisia työkaluja. Tämä sivu ei korvaa lisensoitua kliinistä hoitoa, hätäpalveluja tai henkilökohtaista lääketieteellistä neuvontaa.</p><p class="mt-4">Jos koet akuuttia hätää tai tarvitset välitöntä tukea, ota yhteys hätänumeroon (112) tai MIELI ry:n valtakunnalliseen Kriisipuhelimeen: 09 2525 0111 (avoinna 24/7).</p></section>
      </article>
