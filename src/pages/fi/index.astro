---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Suomenkieliset Työkalut & Kognitiiviset Testit | FreeIQExam Suomi";
const description = "Tutustu FreeIQExam-palvelun suomenkielisiin työkaluihin: kalorilaskuri, muistitestit, ADHD- ja masennusseulonnat sekä älykkyystestit ilman maksua.";
const canonicalUrl = "https://freeiqexam.com/fi/";
const alternates = {}; // Partial hub — no 1:1 homepage hreflang

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection-page`,
    "name": title,
    "url": canonicalUrl,
    "inLanguage": "fi",
    "description": description,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 11,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Kalorilaskuri & TDEE-laskuri", "url": "https://freeiqexam.com/fi/kalorilaskuri" },
        { "@type": "ListItem", "position": 2, "name": "Muistitesti & Muistipeli", "url": "https://freeiqexam.com/fi/muistitesti" },
        { "@type": "ListItem", "position": 3, "name": "CPS-testi (Klikkausnopeustesti)", "url": "https://freeiqexam.com/fi/permainan/click-speed-test" },
        { "@type": "ListItem", "position": 4, "name": "Kirjoitustesti", "url": "https://freeiqexam.com/fi/kirjoitustesti" },
        { "@type": "ListItem", "position": 5, "name": "Värisokeustesti", "url": "https://freeiqexam.com/fi/varisokeustesti" },
        { "@type": "ListItem", "position": 6, "name": "Aikuisten ADHD-testi", "url": "https://freeiqexam.com/fi/adhd-testi" },
        { "@type": "ListItem", "position": 7, "name": "PHQ-9-masennustesti", "url": "https://freeiqexam.com/fi/masennustesti" },
        { "@type": "ListItem", "position": 8, "name": "Mensan testi -opas", "url": "https://freeiqexam.com/fi/mensan-testi" },
        { "@type": "ListItem", "position": 9, "name": "Älykkyystesti", "url": "https://freeiqexam.com/fi/alykkyystesti" },
        { "@type": "ListItem", "position": 10, "name": "Kuulotesti", "url": "https://freeiqexam.com/fi/kuulotesti" },
        { "@type": "ListItem", "position": 11, "name": "Näkötesti", "url": "https://freeiqexam.com/fi/nakotesti" }
      ]
    }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="fi"
>
  <Header currentPath="/fi/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">
    <!-- HERO SECTION (Pure flat canvas) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>FREEIQEXAM SUOMI — 11 TYÖKALUA</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Suomenkieliset työkalut<br />
          <span class="text-zinc-500 dark:text-zinc-400">
            ja kognitiiviset testit.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          Tutustu FreeIQExam-palvelun suomenkielisiin työkaluihin: kalorilaskuri, muistitestit, ADHD- ja masennusseulonnat sekä älykkyystestit ilman maksua — ilman rekisteröitymistä.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/fi/alykkyystesti"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97]"
          >
            Aloita älykkyystesti
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a
            href="/fi/kalorilaskuri"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97] hover:border-zinc-400 dark:hover:border-zinc-600"
          >
            Avaa kalorilaskuri
          </a>
        </div>
      </div>
    </section>

    <!-- CATEGORY 1: Terveys ja aineenvaihdunta -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategoria 1</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Terveys ja aineenvaihdunta
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/fi/kalorilaskuri"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Kalorilaskuri &amp; TDEE-laskuri
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Laske arvio päivittäisestä energiantarpeestasi (TDEE) ja perusaineenvaihdunnastasi (BMR) Mifflin–St Jeor -kaavalla.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Avaa työkalu
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 2: Kognitiiviset pelit ja nopeustestit -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategoria 2</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Kognitiiviset pelit ja nopeustestit
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/fi/muistitesti"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" /><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Muistitesti &amp; Muistipeli
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Harjoittele ja arvioi visuaalista työmuistia ruudukkoon perustuvalla testillä.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <a
          href="/fi/permainan/click-speed-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 9 5 12 1.8-5.2L21 14Z" /><path d="M7.2 2.2 8 2.8" /><path d="M5.1 5.1l.2.1" /><path d="M3.4 9.5l.5.1" /><path d="M2.9 14.1l.5-.1" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              CPS-testi (Klikkausnopeustesti)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Mittaa klikkausnopeutesi sekunnissa (CPS) 5, 10 ja 30 sekunnin kokeilla.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <a
          href="/fi/kirjoitustesti"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="12" x="3" y="6" rx="2" /><path d="M7 10h.01M11 10h.01M15 10h.01M7 14h10" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Kirjoitustesti (WPM-nopeus)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Mittaa kirjoitusnopeutesi ja tarkkuutesi WPM-testillä.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <a
          href="/fi/varisokeustesti"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Värisokeustesti
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Suuntaa-antava digitaalinen värinäkötesti Ishihara-tyyppisillä tauluilla.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 3: Terveysaiheiset itsearvioinnit -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Kategoria 3</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Terveysaiheiset itsearvioinnit
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Suuntaa-antavat itsearvioinnit oireiden ja mielialan tarkasteluun. Eivät korvaa lääketieteellistä diagnoosia.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/fi/adhd-testi"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Aikuisten ADHD-testi (ASRS v1.1)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Standardoidun WHO ASRS v1.1 -kyselyn oirekohtien suuntaa-antava itsearviointi.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <a
          href="/fi/masennustesti"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                Käytössä
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              PHQ-9-masennustesti
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Standardoitu 9-kysymyksen Patient Health Questionnaire (PHQ-9) mielialan kartoittamiseen.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Aloita testi
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 4: Aistit ja älykkyystestit -->
