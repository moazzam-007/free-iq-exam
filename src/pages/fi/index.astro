---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {};

const title = "Suomenkieliset Työkalut & Kognitiiviset Testit | FreeIQExam Suomi";
const description = "Tutustu FreeIQExam-palvelun suomenkielisiin työkaluihin. Laske kaloritarpeesi, testaa muistisi ja suorita kognitiivisia itsearviointeja verkossa.";
const canonicalUrl = "https://freeiqexam.com/fi/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeIQExam Suomi",
    "url": "https://freeiqexam.com/fi/",
    "inLanguage": "fi",
    "description": "FreeIQExam-palvelun suomenkieliset työkalut: kalorilaskuri, muistitestit ja kognitiiviset itsearvioinnit verkossa ilman maksua."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/fi/",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "description": "Avoin, yksityisyyttä kunnioittava arviointialusta, joka tarjoaa maksuttomia suomenkielisiä työkaluja ja kognitiivisia itsearviointeja."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Suomi",
        "item": "https://freeiqexam.com/fi/"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="fi"
>
  <Header currentPath="/fi/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">
    <!-- HERO SECTION (Pure flat canvas) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>FREEIQEXAM SUOMI — VAIHE 1</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Suomenkieliset työkalut<br />
          <span class="text-zinc-500 dark:text-zinc-400">
            ja kognitiiviset testit.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          Tutustu FreeIQExam-palvelun suomenkielisiin työkaluihin. Laske kaloritarpeesi, testaa muistisi ja suorita kognitiivisia itsearviointeja verkossa — maksutta ja ilman rekisteröitymistä.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/fi/kalorilaskuri"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97]"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
            Avaa kalorilaskuri
          </a>
          <a
            href="/calorie-calculator"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97] hover:border-zinc-400 dark:hover:border-zinc-600"
          >
            English version
          </a>
        </div>
      </div>
    </section>

    <!-- ACTIVE TOOLS SECTION -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">Saatavilla nyt</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Käytettävissä olevat työkalut
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Ensimmäisen vaiheen suomenkielinen työkalu on julkaistu. Lisää työkaluja julkaistaan vaiheissa 2–4.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Active: Kalorilaskuri -->
        <a
          href="/fi/kalorilaskuri"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 dark:hover:border-emerald-500 transition-all duration-200 active:scale-[0.99] flex flex-col gap-3"
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
              Käytössä
            </span>
          </div>
          <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            Kalorilaskuri &amp; TDEE-Laskuri
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Laske arvio päivittäisestä energiantarpeestasi (TDEE), perusaineenvaihdunnastasi (BMR) ja kalorivajeesta Mifflin–St Jeor -kaavaan perustuvalla laskennalla. Sisältää makrojakauman ja aktiivisuustasot.
          </p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 dark:text-emerald-400 mt-auto pt-2">
            Avaa työkalu
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Info card: privacy promise -->
        <div class="p-6 rounded-3xl bg-zinc-950 text-white border border-zinc-800 flex flex-col gap-3">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-white/10 text-white border border-white/15">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
          </span>
          <h3 class="font-bold text-lg text-white">
            Yksityisyys ensin
          </h3>
          <p class="text-sm text-zinc-400 leading-relaxed">
            Kaikki laskelmat tehdään selaimessasi. Tuloksiasi ei lähetetä palvelimelle, eikä käyttö vaadi sähköpostia tai tiliä.
          </p>
        </div>
      </div>
    </section>

    <!-- UPCOMING ROADMAP SECTION -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-20">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Tiekartta vaiheille 2–4</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Tulossa pian
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Seuraavien vaiheiden työkalut julkaistaan suomeksi vaiheittain. Kortit ovat esikatseluja — niistä ei lähde vielä linkkejä.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" /><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Muistitesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Työmuistin ja numerosarjojen itsearviointi verkossa.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 9 5 12 1.8-5.2L21 14Z" /><path d="M7.2 2.2 8 2.8" /><path d="M5.1 5.1 5.3 5.2" /><path d="M3.4 9.5 3.9 9.6" /><path d="M2.9 14.1 3.4 14" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">CPS-testi</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Napsautusnopeuden (CPS) mittaus 5, 10 ja 30 sekunnin kokeilla.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Värisokeustesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Värinäön suuntaa-antava seulonta Ishihara-tyyppisillä tauluilla.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M7 8h10" /><path d="M7 12h10" /><path d="M7 16h6" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Kirjoitustesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Kirjoitusnopeuden ja sanojen minuuttivauhdin (WPM) mittaus.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-5 .5 2.5 2.5 0 0 1 .5-5H11" /><path d="M14.5 22A2.5 2.5 0 0 0 12 19.5v-15a2.5 2.5 0 0 0 5-.5 2.5 2.5 0 0 0-.5 5H13" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">ADHD-testi</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Keskittymiseen liittyvien piirteiden suuntaa-antava itsearviointi.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Masennustesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Mielialan suuntaa-antava itsearviointi opetukselliseen käyttöön.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18h8" /><path d="M3 22h18" /><path d="M14 22a7 7 0 1 0-7-7h1" /><path d="M9 14h2" /><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z" /><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Älykkyystesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Päättelykyvyn suuntaa-antava arviointi 24 tehtävällä.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a6.5 6.5 0 1 1-7-10" /><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 0 0 4" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Kuulotesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Kuulon suuntaa-antava seulonta taajuuspyyhkäisyillä.</p>
        </div>

        <div class="p-5 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col gap-2.5 opacity-90">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-800">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
            </span>
            <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/70 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-800">Valmisteilla</span>
          </div>
          <h3 class="font-bold text-base text-zinc-950 dark:text-white">Näkötesti</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Näkökyvyn suuntaa-antava itsearviointi kotoa.</p>
        </div>
      </div>
    </section>

    <!-- About strip -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-24">
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 space-y-3">
        <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Mikä on FreeIQExam Suomi?
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
          FreeIQExam Suomi kokoaa palvelun suomenkieliset työkalut yhteen paikkaan. Kaikki sisällöt on tarkoitettu opetukselliseen ja suuntaa-antavaan käyttöön. Laskurit ja itsearvioinnit eivät korvaa terveydenhuollon ammattilaisen antamaa yksilöllistä neuvontaa.
