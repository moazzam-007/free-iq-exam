---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  'en': 'https://freeiqexam.com/hearing-test',
  'ru': 'https://freeiqexam.com/ru/hearing-test',
  'id': 'https://freeiqexam.com/id/tes-pendengaran',
  'fi': 'https://freeiqexam.com/fi/kuulotesti'
};

const title = "Ilmainen Kuulotesti Netissä (Taajuustesti 20Hz–20kHz) | FreeIQExam";
const description = "Testaa kuulosi ja korkeiden äänien havaitseminen interaktiivisella verkkokuulotestillä. Arvioi taajuusalueesi kuulokkeilla nopeasti.";
const canonicalUrl = "https://freeiqexam.com/fi/kuulotesti";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Verkkokuulotesti ja biologinen korvien ikä (suuntaa-antava taajuustesti)",
    "description": "Suuntaa-antava verkkokuulotesti: puhdasäänitesti (250 Hz – 8 000 Hz) ja korkeataajuinen korvien iän arvio (8 000 Hz – 20 000 Hz). Ei korvaa lääkärin tai audionomin tutkimusta.",
    "url": "https://freeiqexam.com/fi/kuulotesti",
    "inLanguage": "fi",
    "medicalAudience": "Patient",
    "aspect": "Diagnostic"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam verkkokuulotesti ja korvien ikälaskuri",
    "url": "https://freeiqexam.com/fi/kuulotesti",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires Web Audio API support and stereo headphones",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Suuntaa-antava puhdasäänitesti (250 Hz – 8 000 Hz) Hughson–Westlake-menetelmällä",
      "Biologinen korvien ikä korkeataajuuspyyhkäisyllä (8 000 Hz – 20 000 Hz)",
      "Stereokanavien erottelu: vasemman ja oikean korvan itsenäinen arviointi",
      "Vuorovaikutteinen audiogrammikaavio",
      "Ladattava korvien iän yhteenveto",
      "Ei maksua, ei rekisteröitymistä, laskenta kokonaan selaimessa"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Etusivu",
        "item": "https://freeiqexam.com/fi/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Työkalut",
        "item": "https://freeiqexam.com/fi/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Kuulotesti ja korvien ikä",
        "item": "https://freeiqexam.com/fi/kuulotesti"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Kuinka luotettava verkkokuulotesti on?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Web Audio -rajapintaan perustuva verkkotesti antaa suuntaa-antavan arvion kuulokynnyksistä, kun se tehdään laadukkailla kuulokkeilla hiljaisessa ympäristössä. Se ei korvaa äänieristetyssä tilassa kalibroiduilla laitteilla tehtävää tutkimusta, mutta se tunnistaa korkeataajuisen kuulonaleneman ja korvien väliset erot."
        }
      },
      {
        "@type": "Question",
        "name": "Tarvitsenko kuulokkeet kuulotestiin?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kyllä, stereokuulokkeet ovat välttämättömät. Kaiuttimet sekoittavat vasemman ja oikean kanavan, joten korvia ei voi arvioida erikseen. Käytä langallisia kuulokkeita ja kytke tilaääni- ja taajuuskorjainasetukset pois päältä."
        }
      },
      {
        "@type": "Question",
        "name": "Mikä on biologinen korvien ikä ja miten se lasketaan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Biologinen korvien ikä on arvio kuuloelimistön kulumisesta korkeimman kuultavan taajuuden perusteella. Terve vastasyntynyt kuulee noin 20 000 Hz:iin asti. Vuosikymmenten melualtistus ja ikääntyminen vaurioittavat simpukan tyven aistinsoluja, jolloin ylin kuultava taajuus laskee: 19 kHz vastaa alle 18 vuotta, 15 kHz noin 34 vuotta ja 8 kHz yli 65 vuotta."
        }
      },
      {
        "@type": "Question",
        "name": "Mitä eroa on hertseillä (Hz) ja desibeleillä (dB)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hertsi (Hz) mittaa taajuutta eli äänen korkeutta — kuinka nopeasti ääniaallot värähtelevät sekunnissa. Desibeli (dB) mittaa äänenpainetasoa eli voimakkuutta logaritmisella asteikolla. Kuulontutkimuksessa dB HL kuvaa kuulokynnystä suhteessa nuoren terveen korvan keskitasoon."
        }
      },
      {
        "@type": "Question",
        "name": "Miksi nuoret kuulevat hyttysäänen, jota vanhemmat eivät kuule?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hyttysääni on noin 17 400 Hz (17,4 kHz). Tästä taajuudesta vastaavat aistinsolut sijaitsevat simpukan sisäänkäynnin luona ja kuluvat elämän aikana ensimmäisinä. Noin 25 ikävuoteen mennessä useimmat eivät enää kuule 17,4 kHz:iä, kun taas teini-ikäiset kuulevat sen helposti."
        }
      },
      {
        "@type": "Question",
        "name": "Mikä on puheaudiogrammin puhebanaani?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Puhebanaani on audiogrammin banaaninmuotoinen alue noin 250 Hz – 6 000 Hz ja 20–55 dB HL, johon lähes kaikki puheäänteet sijoittuvat. Vokaalit ovat matalataajuisia (250–1 000 Hz), kun taas keskeiset konsonantit (s, f, k) ovat korkeataajuisia (yli 2 000 Hz). Jos kuulonalenema ulottuu tälle alueelle, puhe kuulostaa epäselvältä."
        }
      },
      {
        "@type": "Question",
        "name": "Mikä on WHO:n 60/60-sääntö turvalliseen kuunteluun?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Maailman terveysjärjestön (WHO) 60/60-sääntö suosittelee kuuntelemaan henkilökohtaisia audiolaitteita enintään 60 prosentin äänenvoimakkuudella ja korkeintaan 60 minuuttia kerrallaan, minkä jälkeen pidetään vähintään 10–15 minuutin tauko. Sääntö ehkäisee melun aiheuttamaa kuulovauriota ja tinnitusta."
        }
      },
      {
        "@type": "Question",
        "name": "Voiko pysyvän kuulonaleneman parantaa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sisäkorvaperäinen kuulonalenema, joka johtuu aistinsolujen tai kuulohermon vauriosta, on nykykäsityksen mukaan pysyvä, koska aistinsolut eivät uusiudu. Välikorvaperäisiä syitä (kuten vahatulppa) voidaan usein hoitaa. Sisäkorvaperäistä alenemaa kuntoutetaan kuulokojeilla tai sisäkorvaistutteilla. Tämä verkkotesti ei tee diagnoosia."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="fi"
>
  <Header currentPath="/fi/kuulotesti" />

  <style>
    /* Custom acoustic waveform bar animations */
    .earage-waveform {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 64px;
      margin: 24px 0;
    }

    .earage-waveform .bar {
      width: 4px;
      background: #06b6d4;
      border-radius: 9999px;
      height: 8px;
      transition: height 0.1s ease;
    }

    .earage-waveform.active .bar {
      animation: waveBar 0.8s infinite ease-in-out;
    }

    .earage-waveform.active .bar:nth-child(2) { animation-delay: 0.05s; }
    .earage-waveform.active .bar:nth-child(3) { animation-delay: 0.10s; }
    .earage-waveform.active .bar:nth-child(4) { animation-delay: 0.15s; }
    .earage-waveform.active .bar:nth-child(5) { animation-delay: 0.20s; }
    .earage-waveform.active .bar:nth-child(6) { animation-delay: 0.25s; }
    .earage-waveform.active .bar:nth-child(7) { animation-delay: 0.30s; }
    .earage-waveform.active .bar:nth-child(8) { animation-delay: 0.35s; }
    .earage-waveform.active .bar:nth-child(9) { animation-delay: 0.40s; }
    .earage-waveform.active .bar:nth-child(10) { animation-delay: 0.45s; }
    .earage-waveform.active .bar:nth-child(11) { animation-delay: 0.50s; }
    .earage-waveform.active .bar:nth-child(12) { animation-delay: 0.55s; }
    .earage-waveform.active .bar:nth-child(13) { animation-delay: 0.60s; }
    .earage-waveform.active .bar:nth-child(14) { animation-delay: 0.65s; }
    .earage-waveform.active .bar:nth-child(15) { animation-delay: 0.70s; }
    .earage-waveform.active .bar:nth-child(16) { animation-delay: 0.75s; }
    .earage-waveform.active .bar:nth-child(17) { animation-delay: 0.80s; }
    .earage-waveform.active .bar:nth-child(18) { animation-delay: 0.85s; }
    .earage-waveform.active .bar:nth-child(19) { animation-delay: 0.90s; }
    .earage-waveform.active .bar:nth-child(20) { animation-delay: 0.95s; }

    @keyframes waveBar {
      0%, 100% { height: 10px; }
      50% { height: 58px; }
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @media print {
      header, footer, #calibrationPanel, .no-print {
        display: none !important;
      }
      #resultsWrap {
        display: block !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/fi/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Etusivu</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-500 dark:text-zinc-400">Työkalut</span>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Kuulotesti ja korvien ikä</span>
    </nav>

    <!-- Header & Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-200 dark:border-cyan-800 text-xs sm:text-sm font-mono font-semibold text-cyan-700 dark:text-cyan-400 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>Audiofrekvenssityökalu</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Kuulotesti Netissä &amp; Taajuustesti
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
        Testaa kuuloalueesi 20 Hz — 20 000 Hz taajuuspyyhkäisyllä ja arvioi korviesi herkkyys puhtailla siniaalloilla.
      </p>
    </header>

    <!-- ACOUSTIC SAFETY & CALIBRATION ADVISORY -->
    <div class="max-w-3xl mx-auto mb-10 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
        <div class="space-y-1">
          <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Ääniturvallisuus ja kuulokevaatimus</h4>
          <p class="text-amber-800 dark:text-amber-300/90 text-xs sm:text-sm leading-relaxed">
            <strong>1)</strong> Käytä laadukkaita stereokuulokkeita. <strong>2)</strong> Älä aseta järjestelmän äänenvoimakkuutta täysille; aloita 50 prosentista ja varmista 1 000 Hz kalibrointiäänellä miellyttävä kuuluvuus. <strong>3)</strong> Kytke tilaääni ja taajuuskorjainasetukset pois päältä.
          </p>
          <p class="text-amber-800 dark:text-amber-300/90 text-xs sm:text-sm leading-relaxed font-semibold">
            Tämä testi on suuntaa-antava taajuustesti. Se ei korvaa erikoislääkärin tai audionomin tekemää kliinistä äänesaudiometriaa.
          </p>
        </div>
      </div>
    </div>

    <!-- TESTING ARENA -->
    <section id="test-arena" class="relative w-full max-w-4xl mx-auto mb-16 scroll-mt-6">

      <!-- MODE SELECTOR CARDS -->
      <div id="modeSelector" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Ear Age Test -->
        <button
          type="button"
          data-mode="ear-age"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              Korkeataajuuspyyhkäisy (8–20 kHz)
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Biologinen korvien ikätesti
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Etsi korkein taajuus, jonka korvasi havaitsevat. Tulos suhteutetaan ikäkuulon epidemiologiseen aineistoon biologisen kuulo-iän arvioimiseksi.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Kesto: ~60 sekuntia</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Aloita korvien ikätesti →
            </span>
          </div>
        </button>

        <!-- Card 2: Pure-Tone Audiometry -->
        <button
          type="button"
          data-mode="audiometry"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              Hughson–Westlake-menetelmä
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Puhdasäänitesti
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Suuntaa-antava seulonta 250 Hz – 8 000 Hz erikseen vasemmalle ja oikealle korvalle. Piirtää audiogrammin normaaleja kuulokynnyksiä vasten.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Kesto: ~3 minuuttia</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Aloita puhdasäänitesti →
            </span>
          </div>
        </button>
      </div>

      <!-- ACTIVE WORKSPACE WRAPPER -->
      <div id="workspace" class="hidden rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl">
        <!-- Workspace Header Status -->
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
            <h2 id="workspaceTitle" class="font-heading font-bold text-lg sm:text-xl text-zinc-900 dark:text-white">
              Kuulotestaus
            </h2>
          </div>
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Vaihe <span id="stepNum" class="font-bold text-cyan-600 dark:text-cyan-400">1</span> / 3
          </div>
        </div>

        <!-- STEP 1: CALIBRATION PANEL -->
        <div id="calibrationPanel" class="max-w-xl mx-auto text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center" aria-hidden="true">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white">
              Vertailuäänen kalibrointi
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Toistamme turvallisen 1 000 Hz vertailuäänen. Säädä järjestelmän äänenvoimakkuus niin, että ääni kuuluu selvästi mutta ei epämiellyttävän kovaa.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 space-y-4">
            <div class="flex items-center justify-between text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400">
              <span>Kalibrointitaso</span>
              <span id="calibDbDisplay" class="text-cyan-600 dark:text-cyan-400 font-bold">40 dB HL</span>
            </div>
            <input
              id="calibSlider"
              type="range"
              min="20"
              max="80"
              step="5"
              value="40"
              class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
            />
            <div class="flex gap-3 justify-center pt-2">
              <button
                id="calibPlayBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor" /></svg> Testiääni (1 kHz)
              </button>
              <button
                id="calibStopBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" /></svg> Pysäytä
              </button>
            </div>
          </div>

          <button
            id="startTestBtn"
            type="button"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-heading font-bold text-base shadow-lg hover:shadow-cyan-500/25 transition-all cursor-pointer inline-flex items-center justify-center gap-2"
          >
            <span>Äänenvoimakkuus asetettu · aloita testi</span>
            <span>→</span>
