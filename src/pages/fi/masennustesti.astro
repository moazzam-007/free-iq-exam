---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Ilmainen Masennustesti (PHQ-9 Mielialan Seulonta) | FreeIQExam";
const description = "Arvioi mielialasi ja masennusoireiden vaikeusaste standardoidulla PHQ-9-itsearvioinnilla. Luotettava, anonyymi ja ilmainen työkalu.";
const canonicalUrl = 'https://freeiqexam.com/fi/masennustesti';

const alternates = {
  en: 'https://freeiqexam.com/depression-test',
  ru: 'https://freeiqexam.com/ru/depression-test',
  id: 'https://freeiqexam.com/id/tes-depresi',
  fi: 'https://freeiqexam.com/fi/masennustesti'
};

const faqItems = [
  [
    'Mikä PHQ-9 on ja kuka sen kehitti?',
    'PHQ-9 on Patient Health Questionnaire -kyselyn yhdeksän kohtaan masennusosio, jonka kehittivät Robert L. Spitzer -tri, Janet B. W. Williams -tri, Kurt Kroenke -tri ja heidän kollegansa Pfizerin koulutusavustuksella. Jokainen kohta vastaa suoraan yhtä DSM-5:n päädepression kriteerioireista, pisteytetty 0–3 kahden viikon muistiinpanojaksolla.'
  ],
  [
    'Kuinka tarkka PHQ-9 on masennuksen havaitsemisessa?',
    'Alkuperäisissä vahvistustutkimuksissa ja seuraavissa meta-analyyseissä 10 pistettä tai enemmän tuottaa yhdistetyn herkkyyden ja tarkkuuden noin 88% päädepression osalta verrattuna strukturoidussa kliinisessä haastattelussa. Herkkyys ja tarkkuus vaihtelevat jonkin verran väestöryhmän ja asetelman mukaan, minkä vuoksi pistemäärää käsitellään seulontasignaalina eikä diagnoosina.'
  ],
  [
    'Voiko tämä testi diagnosoida masennuksen?',
    'Ei. PHQ-9 on vahvistettu seulonta-avustin, ei väline diagnoosin asettamiseen. Muodollinen diagnoosi vaatii kliinisen arvioinnin pätevän terveydenhuoltoalan ammattilaisen toimesta, joka voi arvioida keston, haitan, sairashistorian ja vaihtoehtoiset selitykset. Korkea pistemäärä tarkoittaa, että oirekuviota tulisi arvioida ammattimaisesti, ei että sinulla on vahvistettu diagnoosi.'
  ],
  [
    'Kuinka tulkitaan pistemäärä 10-14 välillä?',
    'Pistemäärä 10–14 sijoittuu kohtalaisen vaikeustason ja täyttää PHQ-9:n vahvistetun kynnysarvon todennäköisestä päädepression. Tällä tasolla kliininen arviointi on suositeltavaa ja aktiivista hoitoa harkitaan yleensä. Se on myös piste, jossa aktiivinen hoito yleensä suoriutuu paremmin kuin odotusvalvonta.'
  ],
  [
    'Mitä tarkoittaa, jos pistit enemmän kuin 0 itsetuhoisessa kysymyksessä?',
    'Kohta 9 kysyy ajatuksista, että sinun olisi parempi olla kuollut tai satuttaa itseäsi. Mikä tahansa pistemäärä yli 0 tässä kohdassa käsitellään turvallisuuslippuna riippumatta kokonaispistemäärästä. Se ei automaattisesti tarkoita, että olet välittömässä vaarassa, mutta se tarkoittaa, että aiheesta tulisi keskustella suoraan kliinikon tai kriisipalvelun kanssa sen sijaan, että se jätetään huomiotta.'
  ],
  [
    'Miksi on kymmenes kysymys, jos PHQ-9:ssä on yhdeksän?',
    'Kymmenes kohta on toimintahäiriökysymys. Se ei ole osa 0–27 kokonaispistemäärää. Se kysyy, kuinka vaikeaa oireesi ovat tehneet työssä, kotielämän hallinnassa tai muiden kanssa toimeentulemisessa. Kliinikot painottavat tätä voimakkaasti, koska oireiden vaikeusaste ja toimintahäiriö ovat toisiinsa liittyviä mutta todellisesti erillisiä, ja toimintahäiriö määrittää usein hoitopäätökset.'
  ],
  [
    'Kuinka masennus eroaa lääkityksestä tai tavallisesta surusta?',
    'Suru on yleensä suhteessa tapahtumaan ja helpottuu olosuhteiden muuttuessa. Läsytytyyminen on yleensä kontekstisidonnaista, liittyy krooniseen ammatilliseen tai hoitajasta vastaavaan rasitukseen, ja paranee lepoa ja rajojen muutoksia vastaavalla tavalla. Päämasennus on laajemmin levinnyttä, säilyy eri konteksteissa, ja sisältää yleensä anhedoniaa, syyllisyyttä ja neurovegetatiivisia oireita, kuten unen ja ruokahalun muutoksia. Erot merkitsevät, koska hoidot eroavat toisistaan.'
  ],
  [
    'Kuinka usein PHQ-9:tä pitäisi uudelleentestata?',
    'Jos et ole hoidossa, uudelleenseulonta joka toinen neljäs viikko on järkevää, kun oireet ovat lieviä, ja nopeammin, jos ne pahenevat. Jos olet aloittanut hoidon, PHQ-9 toistetaan yleensä joka toinen viikko, jotta vastetta voidaan mitata sen sijaan, että arvotaisiin. 5 pistettä tai enemmän muutos pidetään yleensä kliinisesti merkittävänä.'
  ]
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'PHQ-9 Masennus- ja mielialanseulonta',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Päämasennus',
      alternateName: ['Masennus', 'Kliininen masennus', 'Päämasennus'],
      code: { '@type': 'MedicalCode', code: 'F32', codingSystem: 'ICD-10' }
    },
    lastReviewed: '2026-09-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Ilmainen kliininen masennustesti (PHQ-9)',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    accessibilitySummary: 'Näppäimistöllä ohjattavat vastauskontrollit (näppäimet 1–4), näkyvät kohdistustilat, semanttiset otsikot, live-ilmoitukset, kriisiresurssien väliotsiot ja tulostettava kliinikon yhteenveto.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Koti', item: 'https://freeiqexam.com/' },
      { '@type': 'ListItem', position: 2, name: 'Arvioinnit', item: 'https://freeiqexam.com/test' },
      { '@type': 'ListItem', position: 3, name: 'Masennustesti (PHQ-9)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'PHQ-9 masennusseulontakysely – 9 kysymystä',
    url: canonicalUrl,
    numberOfQuestions: 9,
    isAccessibleForFree: true,
    about: { '@type': 'MedicalCondition', name: 'Päämasennus' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text }
    }))
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schemas}>
  <Header />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/" class="hover:text-zinc-950 dark:hover:text-white">Koti</a><span aria-hidden="true">/</span>
        <a href="/test" class="hover:text-zinc-950 dark:hover:text-white">Arvioinnit</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Masennustesti</span>
      </nav>

      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:border-indigo-900/60 dark:bg-indigo-950/40 dark:text-indigo-300 sm:text-sm">
          KLIININEN MIELIALAN JA MASENNUKSEN SEULONTA
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">PHQ-9 Masennustesti &amp; Mielialan Arviointi</h1>
        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Vastaa 9 kysymykseen viimeisen kahden viikon vointisi perusteella standardoidulla PHQ-9-asteikolla.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['9 kliinistä kohdetta', '2 viikon muistiinpanojakso', 'Välitön 0–27 pistemäärä', 'Tulostettava yhteenveto', 'Ei tarvita tiliä'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="depression-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">
          <div id="assessment-intro" class="rounded-[1.5rem] border border-indigo-200 bg-indigo-50 p-6 dark:border-indigo-900/50 dark:bg-indigo-950/30 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-300 sm:text-sm">Ennen aloittamista</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Seulonta ei ole diagnoosi</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Vastaa kuinka usein jokainen oire on häirinnyt sinua <strong>viime kahden viikon aikana</strong>. PHQ-9 arvioi oireiden taakkaa vahvistettujen vakavuuskynnysarvojen mukaisesti. Se ei voi vahvistaa tai sulkea pois masennusta, eikä se korvaa pätevän kliinikon arviointia.
            </p>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Kaikki, mitä syötät, jää selaimellesi. Mitään vastauksia ei siirretä, tallennetaan tai yhdistetä henkilöllisyyteesi.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-assessment" type="button" class="rounded-2xl bg-indigo-600 px-7 py-4 text-base font-semibold text-white transition hover:scale-[1.02] active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 sm:rounded-full">Aloita PHQ-9 seulonta</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Näppäimet: 1–4 vastaamiseen · ? / ? siirtymiseen</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
              <strong>Jos olet välittömässä vaarassa,</strong> ota yhteys paikalliseen hätänumeroon nyt. Suomessa soita 112. Tätä työkalua ei valvota, eikä se voi kutsua apua.
            </p>
          </div>

          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-xs font-semibold uppercase tracking-wider text-indigo-700 dark:text-indigo-300 sm:text-sm">PHQ-9 · Viime 2 viikkoa</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-700 dark:text-zinc-300">Affektiivinen · mieliala ja anhedonia</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold sm:text-lg">Kysymys 1 / 9</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">0% vastattu</div>
              </div>
            </div>
            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="progress-fill" class="h-full rounded-full bg-indigo-600 transition-all duration-300" style="width:4%"></div></div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-wrap gap-2 text-sm font-semibold text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Valitse yksi</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Viimeisen 2 viikon aikana kuinka usein oiret ovat häirinneet sinua…</span>
              </div>
              <h2 id="question-heading" class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl"></h2>
              <p id="question-context" class="mt-3 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg"></p>
              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Frekvenssivastausvaihtoehdot"></div>
              <p id="question-safety-note" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
                Tätä kysymystä esitetään kaikille, eikä se ole syytös. Vastaa rehellisesti — se muuttaa sitä, miten apua tarjotaan, ei sitä, miten sinua kohdellaan. Tukiresurssit ilmestyvät, kun valitset vastauksen suuremman kuin nolla.
              </p>
              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="rounded-2xl border border-zinc-300 bg-white px-6 py-4 text-base font-semibold transition active:scale-[0.99] dark:border-zinc-700 dark:bg-zinc-900 sm:rounded-full">Takaisin</button>
                <button id="next-button" type="button" class="rounded-2xl bg-zinc-950 px-7 py-4 text-base font-semibold text-white transition active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-950 sm:rounded-full">Seuraava kysymys</button>
              </div>
            </article>
          </section>

          <section id="crisis-interstitial" class="hidden" role="alertdialog" aria-labelledby="crisis-interstitial-title" aria-describedby="crisis-interstitial-body">
            <div class="rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-9">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Turvallisuustarkistus</p>
              <h2 id="crisis-interstitial-title" class="mt-3 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100 sm:text-3xl">Kiitos rehellisestä vastauksesta</h2>
              <p id="crisis-interstitial-body" class="mt-4 text-base leading-relaxed text-red-950 dark:text-red-100 sm:text-lg">
                Ilmoitit ajatuksista, että sinun olisi parempi olla kuollut, tai satuttaa itseäsi jollain tavalla. Nämä ajatukset ovat merkki siitä, kuinka paljon kipua kannat — ei luonnetta tai jotain, jonon sinun on kannettava yksin. Juttele jollekin nyt, se aidosti auttaa.
              </p>
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">US</span> <span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">CA</span> US &amp; Canada</span><strong>Call or text 988</strong><span>Suicide &amp; Crisis Lifeline · 24/7 · free</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">GB</span> UK &amp; Ireland</span><strong>Call 116 123</strong><span>Samaritans · 24/7 · or NHS 111</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">AU</span> Australia</span><strong>Call 13 11 14</strong><span>Lifeline Australia · 24/7</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">DE</span> Germany</span><strong>0800 111 0 111</strong><span>TelefonSeelsorge · free &amp; anonymous</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">FI</span> Finland</span><strong>09 2525 0111</strong><span>MIELI Kriisipuhelin · 24/7</span></li>
                <li class="crisis-line"><span class="crisis-flag"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg> Everywhere else</span><strong>findahelpline.com</strong><span>Free helplines in 130+ countries</span></li>
              </ul>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="crisis-continue" type="button" class="rounded-2xl bg-zinc-950 px-7 py-4 text-base font-semibold text-white transition active:scale-[0.99] dark:bg-white dark:text-zinc-950 sm:rounded-full">Olen lukenut tämän — jatka tuloksiini</button>
              </div>
            </div>
          </section>

          <section id="results-section" class="hidden" aria-labelledby="results-title">
            <div id="crisis-banner" class="hidden mb-6 rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-8">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Välittömä tuki on saatavilla</p>
              <h2 class="mt-3 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100 sm:text-3xl">Olet tukenut itsetuhoisia ajatuksia</h2>
              <p class="mt-4 text-base leading-relaxed text-red-950 dark:text-red-100 sm:text-lg">
                Riippumatta kokonaispistemäärästä, tätä kohdetta käsitellään turvallisuusprioriteettina. Ota yhteyttä johonkin näistä palveluista nyt — ne ovat ilmaisia, luottamuksellisia ja niissä työskentelee juuri tällaiseen keskusteluun koulutettuja henkilöitä.
              </p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">US</span> <span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">CA</span> US &amp; Canada</span><strong>Call or text 988</strong><span>Suicide &amp; Crisis Lifeline · 24/7</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">GB</span> UK &amp; Ireland</span><strong>Call 116 123</strong><span>Samaritans · or NHS 111</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">AU</span> Australia</span><strong>Call 13 11 14</strong><span>Lifeline Australia · 24/7</span></li>
                <li class="crisis-line"><span class="crisis-flag"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg> Global</span><strong>findahelpline.com</strong><span>Also befrienders.org</span></li>
              </ul>
            </div>

            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div id="result-badge" class="result-badge minimal">Ei merkittäviä masennusoireita</div>
                  <h2 id="results-title" class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">PHQ-9 tuloksesi</h2>
                  <p id="result-classification" class="mt-2 text-xl font-bold text-indigo-700 dark:text-indigo-300">Ei merkittäviä oireita</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-5 py-4 text-center dark:border-zinc-800 dark:bg-zinc-900">
                  <div class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-sm">Kokonaispistemäärä</div>
                  <div id="result-score" class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">0 / 27</div>
                </div>
              </div>

              <p id="result-narrative" class="mt-6 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg"></p>

