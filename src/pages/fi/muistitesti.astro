        <!-- Practice Effects Disclaimer -->
        <div class="text-left p-3 rounded-2xl bg-zinc-100/70 dark:bg-zinc-800/30 border border-zinc-200/80 dark:border-zinc-800 mb-6 text-[11px] text-zinc-500 dark:text-zinc-400 leading-normal italic">
          Pisteet heijastavat tehtäväkohtaista sujuvuutta ja vasteaikaa harjoittelun alla, eivät synnynnäistä yleisälykkyyttä (g). Toistuva harjoittelu kehittää kognitiivista ketteryyttä.
        </div>

        <!-- Modal Actions -->
        <div class="flex items-center gap-3">
          <button
            id="btn-modal-restart"
            type="button"
