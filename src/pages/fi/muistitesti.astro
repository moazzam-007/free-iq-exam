          >
            Pelaa uudelleen
          </button>
          <a
            href="/games"
            class="px-5 min-h-[44px] flex items-center justify-center rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-colors"
          >
            Pelit
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Guide & Cognitive Science Section (Crawler Visible) -->
    <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-cyan mb-2">
          CHC-kyky: Visuaalinen prosessointi (Gv) &amp; Työmuisti (Gwm)
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          Muistimatriisi: Visuospatiaalinen luonnoslehtiö &amp; kuvioiden palautus
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          Muistimatriisi mittaa visuospatiaalista lyhytkestoista muistia ja kokonaisuuksien muodostamista. Toisin kuin kielelliseen toistoon nojaavat muistitehtävät, matriisitehtävät eristävät visuospatiaalisen luonnoslehtiön – kognitiivisen järjestelmän, joka luo, säilyttää ja käsittelee tilapäisiä visuaalisia kuvioita.
        </p>
