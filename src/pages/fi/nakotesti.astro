---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Ilmainen Näkötesti Netissä (Snellen-näöntarkastus) | FreeIQExam";
const description = "Testaa näöntarkkuutesi ja optinen erotuskykysi Snellen- ja Landolt C -näkötestillä. Nopea ja helppo suuntaa-antava itsearviointi.";
const canonicalUrl = 'https://freeiqexam.com/fi/nakotesti';

const alternates = {
  'en': 'https://freeiqexam.com/eye-test',
  'ru': 'https://freeiqexam.com/ru/eye-test',
  'id': 'https://freeiqexam.com/id/tes-mata',
  'fi': 'https://freeiqexam.com/fi/nakotesti'
};

const faqItems = [
  [
    'Kuinka luotettava verkkonäkötesti on optikkoon verrattuna?',
    'Verkkotesti antaa käyttökelpoisen viitteen siitä, miten hyvin näet valitulla etäisyydellä, mutta se ei mittaa taittovirhettä, silmänpainetta, verkkokalvon terveyttä tai yhteisnäköä. Näytön koko, pikselitiheys, katseluetäisyys, huoneen valaistus ja selaimen zoomaus aiheuttavat virhettä. Pidä tulosta syynä varata näöntutkimus — älä korvikkeena sille.'
  ],
  [
    'Miksi testi pyytää mittaamaan pankkikortin näyttöä vasten?',
    'Näöntarkkuus määritellään näkökulmana, jonka kirjainmerkki muodostaa silmään — ei pikseleinä. Yhden metrin etäisyydellä 20/20-kirjain on 1,45 mm korkea näytöstä riippumatta. Koska selain ei tunnista luotettavasti näytön fyysistä pikselitiheyttä, standardikortin (85,60 mm leveä) sovitus antaa testille näytön todellisen pikselisuhteen, jolloin merkit piirretään oikeassa koossa.'
  ],
  [
    'Miksi testi ei joskus mittaa tarkemmin kuin 20/40?',
    'Yhden metrin etäisyydellä 20/20-merkki on 1,45 mm korkea, mikä on tyypillisellä näytöllä vain noin 5 pikseliä — liian vähän viisiviivaisen kirjaimen piirtämiseen. Sen sijaan että kirjain suurennettaisiin ja ilmoitettaisiin mittaamaton tulos, testi ilmoittaa tarkimman tason, jonka näyttösi todella kykenee piirtämään. Kauempaa katsottuna ja pidempi etäisyys valittuna tarkemmat tasot kasvavat fyysisesti ja muuttuvat mitattaviksi.'
  ],
  [
    'Mikä on E-merkki ja miksi sitä käytetään kirjainten sijaan?',
    'E-merkki on Snellenin E käännettynä osoittamaan ylös, alas, vasemmalle tai oikealle. Katselija ilmoittaa suunnan kirjaimen nimeämisen sijaan, jolloin lukutaito, kieli ja kirjaintuntemus eivät vaikuta mittaukseen. Se on vakiomerkki pienille lapsille ja kaikille, jotka eivät lue latinalaisia aakkosia.'
  ],
  [
    'Mitä hajataittoisuuskello todella havaitsee?',
    'Kelloskaala esittää säteittäisiä viivoja joka suunnassa. Kun sarveiskalvon tai mykiön kaarevuus poikkeaa suunnittain, valo taittuu eri suuntiin eri tavoin, joten osa viivoista näyttää tummemmilta tai terävämmiltä kuin muut. Jos ilmoitat osan viivoista selkeämmiksi, epäsymmetria viittaa hajataittoisuuteen ja kannattaa mittauttaa asianmukaisesti.'
  ],
  [
    'Miksi punainen ja vihreä paneeli kertovat liki- tai kaukonäköisyydestä?',
    'Kyse on pitkittäisestä kromaattisesta aberraatiosta. Vihreä valo (noin 535 nm) taittuu voimakkaammin kuin punainen (noin 650 nm), joten vihreä tarkentuu hieman verkkokalvon eteen ja punainen hieman taakse. Jos punainen näyttää terävämmältä, silmä on suhteellisesti likinäköinen; jos vihreä näyttää terävämmältä, suhteellisesti kaukonäköinen. Kun molemmat näyttävät samoilta, pallomainen tarkennus osuu lähelle verkkokalvoa.'
  ],
  [
    'Kertooko tämä testi silmälasireseptini?',
    'Ei. Resepti määrittää sfäärin, sylinterin, akselin ja usein lukulisän sekä pupillivälin. Tämä testi arvioi näöntarkkuuden yhdellä etäisyydellä ja antaa karkean viitteen hajataittoisuuden epäsymmetriasta ja pallomaisesta tasapainosta. Vain laillistettu optikko tai silmälääkäri voi määrätä reseptin.'
  ],
  [
    'Milloin optikolle on hakeuduttava tuloksesta riippumatta?',
    'Varaa tutkimus, jos näkö muuttuu äkillisesti tai vähitellen, ilmenee välähdyksiä tai runsaita samentumia, näkökenttään tulee verho tai varjo, silmä kipeytyy tai punoittaa jatkuvasti, näet kahtena, päänsärkyyn liittyy näkömuutos tai sairastat diabetesta tai glaukoomaa. Äkillinen näönmenetys on hätätilanne — hakeudu hoitoon välittömästi verkkotestauksen sijaan.'
  ]
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Verkkonäöntarkkuuden, hajataittoisuuden ja duokromin suuntaa-antava seulonta',
    url: canonicalUrl,
    inLanguage: 'fi',
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Refractive Error',
      alternateName: ['Myopia', 'Hyperopia', 'Astigmatism', 'Presbyopia']
    },
    lastReviewed: '2026-09-19'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Ilmainen näkötesti netissä — Snellen, hajataittoisuuskello ja duokromi',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    accessibilitySummary: 'Näppäimistöllä vastattavat suuntavastaukset, näytön suuntapainikkeet, koko kortin kalibrointiliukusäädin, näkyvät kohdistustilat, live-ilmoitukset ja tulostettava yhteenveto.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Etusivu', item: 'https://freeiqexam.com/fi/' },
      { '@type': 'ListItem', position: 2, name: 'Arvioinnit', item: 'https://freeiqexam.com/fi/alykkyystesti' },
      { '@type': 'ListItem', position: 3, name: 'Näkötesti', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text }
    }))
  }
];

const stages = [
  ['intro-section', '1 · Yleiskatsaus'],
  ['calibration-section', '2 · Kalibrointi'],
  ['acuity-section', '3 · Näöntarkkuus'],
  ['astigmatism-section', '4 · Hajataittoisuus'],
  ['duochrome-section', '5 · Duokromi'],
  ['results-section', '6 · Tulokset']
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schemas} lang="fi">
  <Header currentPath="/fi/nakotesti" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/fi/" class="hover:text-zinc-950 dark:hover:text-white">Etusivu</a><span aria-hidden="true">/</span>
        <a href="/fi/alykkyystesti" class="hover:text-zinc-950 dark:hover:text-white">Arvioinnit</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Näkötesti</span>
      </nav>

      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300 sm:text-sm">
          Visuaalisen tarkkuuden itsearviointi
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">Snellen Näkötesti &amp; Näöntarkastus Netissä</h1>
        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Arvioi näöntarkkuutesi (Visus) Snellen- ja Landolt C -taululla sopivalta katseluetäisyydeltä.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['Kortilla kalibroitu mittakaava', 'E-merkin näöntarkkuus', 'Hajataittoisuuskello', 'Duokromitasapaino', 'Ei tiliä vaadita'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="eye-app" class="mx-auto mt-12 max-w-4xl">
        <ol class="stage-strip" aria-label="Testin eteneminen">
          {stages.map(([id, label]) => (
            <li data-stage={id} class="stage-chip">{label}</li>
          ))}
        </ol>

        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">

          <section id="intro-section" class="rounded-[1.5rem] border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-900/50 dark:bg-emerald-950/30 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 sm:text-sm">Ennen aloittamista</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Seulontatyökalu, ei tutkimus</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Tämä testi arvioi, miten hyvin näet valitulla etäisyydellä. Se ei mittaa taittovirhettäsi, silmänpainetta, näkökenttiä tai verkkokalvon terveyttä eikä tuota reseptiä. Näytön koko, pikselitiheys, katseluetäisyys ja huoneen valaistus vaikuttavat tulokseen.
            </p>
            <ul class="mt-5 space-y-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              <li class="intro-bullet">Pidä tavallinen pankki- tai henkilökortti valmiina — sovitat sen näyttöä vasten fyysisen mittakaavan kalibroimiseksi.</li>
              <li class="intro-bullet">Peitä toinen silmä kerrallaan. Kämmen toimii paremmin kuin silmän päälle kuperoitu käsi.</li>
              <li class="intro-bullet">Testaa tasaisessa, kohtalaisessa valaistuksessa. Vältä kirkasta ikkunaa suoraan näytön takana tai edessä.</li>
              <li class="intro-bullet">Käytä tavallisia silmälasejasi tai piilolinssejäsi, jos testaat nykyisen korjauksen toimivuutta. Poista ne vain, jos haluat tietää korjaamattoman tarkkuutesi.</li>
            </ul>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-eye-test" type="button" class="rounded-2xl bg-emerald-600 px-7 py-4 text-base font-semibold text-white transition hover:scale-[1.02] active:scale-[0.99] focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 sm:rounded-full">Aloita näkötesti</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Näppäimistö: ↑ ↓ ← → vastaamiseen tarkkuusosiossa</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
              <strong>Äkillinen näönmenetys, välähdykset, verho näkökentässä tai silmäkipu on lääketieteellinen hätätilanne.</strong> Älä testaa verkossa — hakeudu välittömästi hoitoon.
            </p>
          </section>

          <section id="calibration-section" class="hidden" aria-labelledby="calibration-title">
            <div class="rounded-[1.5rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-8">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 sm:text-sm">Vaihe 1 · Fyysinen kalibrointi</p>
              <h2 id="calibration-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Sovita oikea kortti näyttöön</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Pidä tavallista pankki-, henkilöllisyys- tai kirjastokorttia näyttöä vasten ja vedä liukusäädintä, kunnes alla oleva valkoinen ääriviiva on täsmälleen kortin levyinen. Näin testi saa näytön todellisen pikselisuhteen, mikä tekee merkeistä fyysisesti oikean kokoisia.
              </p>

              <div class="calibration-stage">
                <div id="card-preview" class="card-preview" aria-hidden="true"></div>
              </div>

              <label for="card-slider" class="mt-8 block text-base font-semibold">Kortin leveys näytöllä</label>
              <input id="card-slider" type="range" min="100" max="600" step="1" value="260" class="calibration-slider" />
              <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span>Kortin leveys: <strong id="card-width-label" class="font-mono">260 px</strong></span>
                <span>Näytön mittakaava: <strong id="ppm-readout" class="font-mono">—</strong></span>
              </div>

              <div class="mt-8">
                <p class="text-base font-semibold">Testietäisyys</p>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Istu tai seiso niin, että silmäsi on täsmälleen tämän etäisyyden päässä näytöstä. Kauempaa tarkemmat merkit kasvavat fyysisesti — ja muuttuvat mitattaviksi.</p>
                <div class="mt-4 flex flex-wrap gap-3">
                  {[['near', '40 cm', '16 in · puhelin'], ['desk', '1 m', '3.3 ft · työpöytä'], ['room', '2 m', '6.6 ft'], ['hall', '3 m', '10 ft'], ['snellen', '6 m', '20 ft · Snellen-standardi']].map(([id, label, hint]) => (
                    <button type="button" data-distance={id} class="distance-button">
                      <span class="distance-label">{label}</span>
                      <span class="distance-hint">{hint}</span>
                    </button>
                  ))}
                </div>
              </div>

              <p id="resolution-warning" class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200 sm:text-base"></p>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="confirm-calibration" type="button" class="rounded-2xl bg-emerald-600 px-7 py-4 text-base font-semibold text-white transition active:scale-[0.99] sm:rounded-full">Kalibroitu — aloita näöntarkkuustesti</button>
                <button id="skip-calibration" type="button" class="rounded-2xl border border-zinc-300 px-6 py-4 text-base font-semibold transition active:scale-[0.99] dark:border-zinc-700 sm:rounded-full">Siirry kellotauluun &amp; duokromiin</button>
              </div>
              <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Kalibrointi tarvitaan vain tarkkuustauluun. Kellotaulu ja duokromi toimivat ilman sitä.</p>
            </div>
          </section>

          <section id="acuity-section" class="hidden" aria-labelledby="acuity-title">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 sm:text-sm">Vaihe 2 · Näöntarkkuus</p>
                <h2 id="acuity-title" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl"><span id="acuity-eye-label">Oikea silmä</span></h2>
              </div>
              <div class="text-left sm:text-right">
                <div id="acuity-eye-progress" class="text-base font-semibold sm:text-lg">Silmä 1 / 3</div>
                <div id="acuity-trial-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">—</div>
              </div>
            </div>
            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="acuity-progress-fill" class="h-full rounded-full bg-emerald-600 transition-all duration-300" style="width:0%"></div></div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div id="acuity-tier-dots" class="tier-dots" aria-hidden="true"></div>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Kolme oikein läpäisee tason · kaksi hutiä pudottaa tasoa tai päättää silmän</p>
            </div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p id="acuity-instruction" class="rounded-2xl border border-emerald-200 bg-emerald-50/70 px-5 py-4 text-base font-semibold text-emerald-900 dark:border-emerald-900/50 dark:bg-emerald-950/30 dark:text-emerald-200 sm:text-lg">Peitä VASEN silmäsi.</p>
              <p class="mt-6 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg">
                Mihin suuntaan E osoittaa? Nykyinen taso <strong id="acuity-tier-label" class="font-mono text-zinc-900 dark:text-white">—</strong>
              </p>

              <div id="optotype-mount" class="mt-6"></div>

              <div class="direction-pad mt-8">
                <div></div>
                <button type="button" data-direction="up" class="direction-button" aria-label="E osoittaa ylös">↑</button>
                <div></div>
                <button type="button" data-direction="left" class="direction-button" aria-label="E osoittaa vasemmalle">←</button>
                <div class="direction-center" aria-hidden="true">E</div>
                <button type="button" data-direction="right" class="direction-button" aria-label="E osoittaa oikealle">→</button>
                <div></div>
                <button type="button" data-direction="down" class="direction-button" aria-label="E osoittaa alas">↓</button>
                <div></div>
              </div>

              <p id="acuity-feedback" class="acuity-feedback" role="status" aria-live="polite"></p>
              <p class="mt-6 text-center text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">
                Kolme oikein tasolla läpäisee sen. Kaksi väärin päättää silmän.
              </p>
            </article>
          </section>

          <section id="astigmatism-section" class="hidden" aria-labelledby="astig-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 sm:text-sm">Vaihe 3 · Hajataittoisuuskello</p>
              <h2 id="astig-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Näyttävätkö jotkin viivat tummemmilta tai terävämmiltä?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Katso valitsemaltasi etäisyydeltä kellotaulun keskustaa silmä kerrallaan ja vertaa kahtatoista viivaa. Korjaamattomasta hajataittoisuudesta kärsivillä yksi tai kaksi viivaa erottuu selvästi tummempana tai terävämpänä kuin muut. Valitse jokainen erottuva viiva.
              </p>
              <p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Jokainen säde on valittavissa erikseen, mukaan lukien kaksi vastakkaista sädettä samalla keskustan kautta kulkevalla viivalla — ne kuvaavat yhtä ja samaa meridiaania, joten jos viiva näyttää sumealta molemmista päistä, merkitse molemmat.
              </p>
              <div id="dial-mount" class="dial-stage mt-8"></div>
              <p id="dial-selection-label" class="mt-6 text-base font-semibold text-emerald-800 dark:text-emerald-300 sm:text-lg">Ei valittuja viivoja vielä.</p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="submit-astigmatism" type="button" class="rounded-2xl bg-emerald-600 px-7 py-4 text-base font-semibold text-white transition active:scale-[0.99] sm:rounded-full">Jatka duokromiin</button>
                <button id="dial-none" type="button" aria-pressed="false" class="rounded-2xl border border-zinc-300 px-6 py-4 text-base font-semibold transition active:scale-[0.99] dark:border-zinc-700 sm:rounded-full">Kaikki viivat näyttävät samoilta</button>
              </div>
            </div>
          </section>

          <section id="duochrome-section" class="hidden" aria-labelledby="duo-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 sm:text-sm">Vaihe 4 · Puna-viherduokromi</p>
              <h2 id="duo-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Kumpi rengas näyttää terävämmältä?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Vertaa mustaa rengasta punaisella paneelilla ja mustaa rengasta vihreällä paneelilla. Arvioi <strong>terävyyttä ja selkeyttä</strong>, älä kirkkautta — värit eroavat tarkoituksella luminanssiltaan. Katso molempia muutama sekunti ennen päätöstä.
              </p>
              <div class="duochrome-grid mt-8">
                <div class="duochrome-panel duo-red">
                  <div id="duochrome-red" class="duochrome-target"></div>
                  <span class="duochrome-caption">Punainen · ~650 nm</span>
                </div>
                <div class="duochrome-panel duo-green">
                  <div id="duochrome-green" class="duochrome-target"></div>
                  <span class="duochrome-caption">Vihreä · ~535 nm</span>
                </div>
              </div>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
