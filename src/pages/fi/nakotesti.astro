      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes revealUp {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes keyPulse {
      0% { transform: scale(1); }
      45% { transform: scale(0.93); }
      100% { transform: scale(1); }
    }
    @keyframes dotPop {
      from { transform: scale(0.55); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .stage-enter { animation: stageEnter 0.42s cubic-bezier(0.22, 1, 0.36, 1) both; }
    /* Animate the optotype itself, not its stage — scaling the wrapper would
       scale the white panel behind it and read as the whole chart pulsing. */
    .optotype-stage.optotype-enter > svg { animation: optotypeEnter 0.19s ease-out both; }

    .direction-button.is-pressed {
      animation: keyPulse 0.22s ease;
      border-color: rgb(5 150 105);
      background: rgb(236 253 245);
      box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.22);
    }
    .dark .direction-button.is-pressed {
      border-color: rgb(5 150 105);
      background: rgba(6, 78, 59, 0.4);
      box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.28);
    }

    #results-section .reveal.is-revealed { animation: revealUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; }

    .acuity-feedback { margin-top: 1.5rem; min-height: 1.6rem; text-align: center; font-size: 1rem; font-weight: 700; }
    .acuity-feedback.good { color: rgb(4 120 87); }
    .acuity-feedback.bad { color: rgb(185 28 28); }

    /* Dial and duochrome are also fixed light-ground optical targets. */
    .dial-stage {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      border-radius: 1.5rem;
      background: #ffffff;
    }
    .dial-svg { width: 100%; max-width: 26rem; height: auto; }
    .dial-ray { cursor: pointer; }
    .dial-ray:focus-visible { outline: 3px solid rgb(5 150 105); outline-offset: 2px; border-radius: 0.5rem; }
    .dial-ray-line {
      stroke: #000000;
      transition: stroke-width 0.18s cubic-bezier(0.22, 1, 0.36, 1), stroke 0.18s ease;
    }
    .dial-ray:hover .dial-ray-line { stroke: rgb(5 150 105); stroke-width: 6; }
    .dial-ray.selected .dial-ray-line {
      stroke: rgb(5 150 105);
      stroke-width: 7;
      filter: drop-shadow(0 0 5px rgba(5, 150, 105, 0.75));
    }
    .dial-label {
      fill: rgb(82 82 91);
      font-size: 15px;
      font-weight: 700;
      font-family: ui-monospace, monospace;
      transition: fill 0.18s ease;
    }
    .dial-ray:hover .dial-label { fill: rgb(4 120 87); }
    .dial-ray.selected .dial-label { fill: rgb(4 120 87); }
    /* Decorative only — must never swallow a ray's pointer target. */
    .dial-hub { pointer-events: none; }

    /* Per-tier trial dots */
    .tier-dots { display: flex; align-items: center; gap: 0.5rem; min-height: 1.25rem; }
    .trial-dot {
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 999px;
      border: 2px solid rgb(212 212 216);
      background: transparent;
      transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .trial-dot.hit { border-color: rgb(5 150 105); background: rgb(5 150 105); animation: dotPop 0.24s cubic-bezier(0.22, 1, 0.36, 1); }
    .trial-dot.miss { border-color: rgb(220 38 38); background: rgb(220 38 38); animation: dotPop 0.24s cubic-bezier(0.22, 1, 0.36, 1); }
    .dark .trial-dot { border-color: rgb(63 63 70); }
    .dark .trial-dot.hit { border-color: rgb(16 185 129); background: rgb(16 185 129); }
    .dark .trial-dot.miss { border-color: rgb(248 113 113); background: rgb(248 113 113); }

    .duochrome-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .duochrome-grid { grid-template-columns: 1fr 1fr; } }
    .duochrome-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 2rem 1rem;
      border-radius: 1.5rem;
    }
    .duo-red { background: rgb(204 0 0); }
    .duo-green { background: rgb(0 153 51); }
    .duochrome-target { display: flex; align-items: center; justify-content: center; }
    .duochrome-caption {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.92);
    }
    .duo-choice.selected { box-shadow: 0 0 0 3px rgb(5 150 105); }

    /* Toggle state for "All lines look equal". An id selector is used so it
       outranks the Tailwind border utilities on the same element. */
    #dial-none.selected { border-color: rgb(5 150 105); background: rgb(236 253 245); color: rgb(4 120 87); }
    .dark #dial-none.selected { border-color: rgb(5 150 105); background: rgba(6, 78, 59, 0.4); color: rgb(110 231 183); }

    /* Calibration failure severe enough that no tier can be measured. The
       engine toggles this class, so it must exist here or the worst case
       renders identically to a mild one. */
    #resolution-warning.is-blocking { border-color: rgb(252 165 165); background: rgb(254 242 242); color: rgb(153 27 27); font-weight: 600; }
    .dark #resolution-warning.is-blocking { border-color: rgb(153 27 27); background: rgba(69, 10, 10, 0.45); color: rgb(252 165 165); }

    .result-badge { display: inline-flex; border-radius: 999px; border: 1px solid; padding: .55rem 1.1rem; font-size: .95rem; font-weight: 700; }
    .result-badge.neutral { color: rgb(82 82 91); background: rgb(244 244 245); border-color: rgb(228 228 231); }
    .result-badge.good { color: rgb(22 101 52); background: rgb(240 253 244); border-color: rgb(187 247 208); }
    .result-badge.moderate { color: rgb(146 64 14); background: rgb(255 247 237); border-color: rgb(254 215 170); }
    .result-badge.bad { color: rgb(153 27 27); background: rgb(254 242 242); border-color: rgb(254 202 202); }

    .score-card { border: 1px solid rgb(228 228 231); border-radius: 1.5rem; background: #fff; padding: 1.35rem; }
    .score-label { font-size: .9rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: rgb(113 113 122); }
    .acuity-fraction { margin-top: .75rem; font-size: 1.875rem; font-weight: 800; font-family: ui-monospace, monospace; letter-spacing: -.02em; }
    .score-status { margin-top: .5rem; color: rgb(4 120 87); font-size: .95rem; font-weight: 600; }
    .stat-card { display: flex; flex-direction: column; gap: .5rem; padding: 1.25rem; border: 1px solid rgb(228 228 231); border-radius: 1.25rem; background: #fff; }
    .stat-card span { font-size: .85rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: rgb(113 113 122); }
    .stat-card strong { font-size: 1.1rem; line-height: 1.35; }
    .stat-note { font-size: .95rem; line-height: 1.55; color: rgb(82 82 91); }

    .eyebrow { font-size: .875rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgb(4 120 87); }
    .section-title { font-size: 2rem; line-height: 1.15; font-weight: 800; letter-spacing: -.025em; color: rgb(24 24 27); }
    .guide-section { margin-top: 3.5rem; }

    .dark .stage-chip { background: rgb(9 9 11); border-color: rgb(39 39 42); color: rgb(161 161 170); }
    .dark .stage-chip.active { background: rgba(6, 78, 59, 0.5); border-color: rgb(6 95 70); color: rgb(110 231 183); }
    .dark .stage-chip.done { color: rgb(110 231 183); border-color: rgb(6 95 70); }
    .dark .calibration-stage { border-color: rgb(39 39 42); }
    .dark .distance-button { background: rgb(9 9 11); border-color: rgb(39 39 42); color: rgb(250 250 250); }
    .dark .distance-button.selected { background: rgba(6, 78, 59, 0.4); border-color: rgb(5 150 105); }
    .dark .distance-hint { color: rgb(161 161 170); }
    .dark .direction-button { background: rgb(9 9 11); border-color: rgb(39 39 42); color: rgb(250 250 250); }
    .dark .direction-button:hover { background: rgba(6, 78, 59, 0.4); border-color: rgb(5 150 105); }
    .dark .direction-center { background: rgb(24 24 27); color: rgb(113 113 122); }
    .dark .optotype-placeholder { color: rgb(161 161 170); }
    .dark .acuity-feedback.good { color: rgb(110 231 183); }
    .dark .acuity-feedback.bad { color: rgb(252 165 165); }
    .dark .result-badge.neutral { color: rgb(212 212 216); background: rgb(24 24 27); border-color: rgb(63 63 70); }
    .dark .result-badge.good { color: rgb(134 239 172); background: rgba(5, 46, 22, 0.55); border-color: rgb(22 101 52); }
    .dark .result-badge.moderate { color: rgb(252 211 77); background: rgba(69, 26, 3, 0.5); border-color: rgb(146 64 14); }
    .dark .result-badge.bad { color: rgb(153 27 27); background: rgba(69, 10, 10, 0.55); border-color: rgb(153 27 27); }
    .dark .score-card, .dark .stat-card { border-color: rgb(39 39 42); background: rgb(9 9 11); }
    .dark .score-status { color: rgb(110 231 183); }
    .dark .stat-note { color: rgb(161 161 170); }
    .dark .eyebrow { color: rgb(110 231 183); }
    .dark .section-title { color: rgb(250 250 250); }

    .print-only { display: none; }
    @media print {
      #main-content > header,
      #main-content > footer,
      #main-content > #assessment-page-content,
      #share-toast { display: none !important; }
      #main-content > #printable-report { display: block !important; }
      body { background: #fff !important; color: #000 !important; }
      @page { margin: 16mm; }
    }

    /* Motion is decorative here. It must never gate comprehension, and it must
       never obscure an optotype — so it is fully removable on request. */
    @media (prefers-reduced-motion: reduce) {
      .stage-enter,
      .optotype-stage.optotype-enter > svg,
      #results-section .reveal.is-revealed,
      .direction-button.is-pressed,
      .trial-dot.hit,
      .trial-dot.miss { animation: none !important; }
      .dial-ray-line,
      .dial-label,
      .trial-dot { transition: none !important; }
      .dial-ray.selected .dial-ray-line { filter: none; }
      .stage-enter { opacity: 1; transform: none; }
    }

    @media (max-width: 640px) {
      .section-title { font-size: 1.75rem; }
    }
  </style>

  <Footer />
