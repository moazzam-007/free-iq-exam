---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const alternates = {
  'en': 'https://freeiqexam.com/games/click-speed-test',
  'ru': 'https://freeiqexam.com/ru/games/click-speed-test',
  'id': 'https://freeiqexam.com/id/permainan/click-speed-test',
  'fi': 'https://freeiqexam.com/fi/permainan/click-speed-test'
};
const title = "CPS Test & Klikkausnopeustesti (Clicks Per Second) | FreeIQExam";
const description = "Testaa kuinka nopeasti pystyt klikkaamaan sekunnissa (CPS). Valitse 1s, 5s, 10s tai 60s aikatila ja analysoi klikkausnopeutta ilmaiseksi.";
const canonicalUrl = "https://freeiqexam.com/fi/permainan/click-speed-test";

const DURATIONS = [5, 10, 30];
const DEFAULT_DURATION = 10;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "CPS Klikkausnopeustesti (Clicks Per Second)",
    "url": "https://freeiqexam.com/fi/permainan/click-speed-test",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "description": "Ilmainen klikkausnopeustesti (CPS). Mittaa klikkauksia sekunnissa, huippupyrähdystä ja rytmin tasaisuutta 5, 10 tai 30 sekunnin kokeessa.",
    "inLanguage": "fi"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Etusivu",
        "item": "https://freeiqexam.com/fi"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Pelit",
        "item": "https://freeiqexam.com/fi/permainan/click-speed-test"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Klikkausnopeustesti",
        "item": "https://freeiqexam.com/fi/permainan/click-speed-test"
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="fi">
  <Header />

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Etusivu</a>
      <span class="mx-2">/</span>
      <a href="/games" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Pelit</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Klikkausnopeustesti</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-yellow mb-1.5">
          REAKTIONOPEUS JA NAPUTUSTESTI
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
            CPS Test &amp; Klikkausnopeustesti
          </h1>
          <button
            id="btn-how-to-play"
            type="button"
            class="min-h-[44px] px-3 py-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            aria-haspopup="dialog"
          >
            Kuinka pelataan
          </button>
        </div>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 mt-2 max-w-xl">
          Mittaa klikkausnopeutesi sekunnissa (CPS). Valitse aikatila ja napsauta painiketta niin nopeasti kuin pystyt.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <div class="pastel-hud pastel-hud-accent-yellow rounded-xl px-3.5 py-2 text-center min-w-[84px]">
          <div class="text-[10px] font-mono font-bold uppercase tracking-wider opacity-80">Aika jäljellä</div>
          <div id="hud-time" class="text-lg font-mono tabular-nums tracking-tight font-bold leading-tight">10.0s</div>
        </div>
        <div class="pastel-hud pastel-hud-accent-mint rounded-xl px-3.5 py-2 text-center min-w-[84px]">
          <div class="text-[10px] font-mono font-bold uppercase tracking-wider opacity-80">Klikkaukset</div>
          <div id="hud-clicks" class="text-lg font-mono tabular-nums tracking-tight font-bold leading-tight">0</div>
        </div>
        <div class="pastel-hud pastel-hud-accent-sky rounded-xl px-3.5 py-2 text-center min-w-[84px]">
          <div class="text-[10px] font-mono font-bold uppercase tracking-wider opacity-80">Klikkaukset sekunnissa (CPS)</div>
          <div id="hud-cps" class="text-lg font-mono tabular-nums tracking-tight font-bold leading-tight">0.0</div>
        </div>
      </div>
    </section>

    <!-- Duration selector -->
    <div class="mb-6 flex flex-wrap items-center justify-center gap-2.5" role="group" aria-label="Testin kesto">
      {DURATIONS.map((d) => (
        <button
          type="button"
          data-duration={d}
          class={`duration-chip pastel-chip min-h-[44px] ${d === DEFAULT_DURATION ? 'active' : ''}`}
          aria-pressed={d === DEFAULT_DURATION ? 'true' : 'false'}
        >
          {d} sekuntia
        </button>
      ))}
    </div>

    <!-- Arena -->
    <section class="mb-6" aria-label="Klikkausnopeustestin alue">
      <button
        id="cps-arena"
        type="button"
        class="game-pastel-arena relative w-full rounded-3xl flex flex-col items-center justify-center gap-3 px-6 py-12 sm:py-14 min-h-[260px] sm:min-h-[320px] select-none cursor-pointer transition-all duration-200 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950"
      >
        <!-- Layer: awaiting start -->
        <div id="arena-ready" class="flex flex-col items-center gap-3 text-center">
          <div class="pastel-icon pastel-icon-yellow w-16 h-16 rounded-2xl">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834.166l-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243l-1.59-1.59" />
            </svg>
          </div>
          <div class="text-xl sm:text-2xl font-heading font-bold text-zinc-950 dark:text-white">
            Klikkaa tästä aloittaaksesi
          </div>
          <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed max-w-sm">
            Ajastin käynnistyy ensimmäisestä klikkauksesta. Napsauta niin nopeasti kuin pystyt kunnes aika loppuu.
          </p>
        </div>

        <!-- Layer: running -->
        <div id="arena-running" class="hidden flex-col items-center gap-2 text-center">
          <div id="arena-click-count" class="text-6xl sm:text-7xl font-mono tabular-nums tracking-tight font-bold text-zinc-950 dark:text-white leading-none">
            0
          </div>
          <div class="text-xs font-mono font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
            Jatka klikkaamista
          </div>
        </div>

        <!-- Layer: finished / locked -->
        <div id="arena-done" class="hidden flex-col items-center gap-3 text-center">
          <div class="pastel-icon pastel-icon-cyan w-16 h-16 rounded-2xl">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-xl sm:text-2xl font-heading font-bold text-zinc-950 dark:text-white">
            Koe valmis
          </div>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Paina Uudelleen aloittaaksesi uuden kokeen.</p>
        </div>
      </button>
    </section>

    <!-- Controls -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      <button
        id="btn-start"
        type="button"
        class="pastel-play inline-flex items-center gap-2 min-h-[44px] px-6 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
      >
        <span id="btn-start-label">Aloita testi</span>
      </button>
      <button
        id="btn-reset"
        type="button"
        class="min-h-[44px] px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
      >
        Nollaa
      </button>
    </div>

    <!-- Results -->
    <section id="results-panel" class="hidden mb-12" aria-live="polite" aria-label="Testitulokset">
      <div class="game-pastel-arena rounded-3xl p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <div class="pastel-eyebrow pastel-eyebrow-mint mb-2">Tulos</div>
            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
              <span id="res-cps" class="tabular-nums">0.0</span>
              <span class="text-base sm:text-lg font-semibold text-zinc-500 dark:text-zinc-400">klikkausta sekunnissa</span>
            </h2>
          </div>
          <div id="res-tier" class="px-4 py-2 rounded-xl border text-sm font-bold text-center"></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-6">
          <div class="pastel-metric rounded-2xl p-4 text-center">
            <small class="block">Klikkauksia yhteensä</small>
            <strong id="res-total" class="text-2xl font-mono tabular-nums tracking-tight font-bold">0</strong>
          </div>
          <div class="pastel-metric rounded-2xl p-4 text-center">
            <small class="block">Huippu 1 s</small>
            <strong id="res-peak" class="text-2xl font-mono tabular-nums tracking-tight font-bold">0</strong>
          </div>
          <div class="pastel-metric rounded-2xl p-4 text-center">
            <small class="block">Mediaani-intervalli</small>
            <strong id="res-median" class="text-2xl font-mono tabular-nums tracking-tight font-bold">--</strong>
          </div>
          <div class="pastel-metric rounded-2xl p-4 text-center">
            <small class="block">Rytmin tasaisuus</small>
            <strong id="res-rhythm" class="text-2xl font-mono tabular-nums tracking-tight font-bold">--</strong>
          </div>
        </div>

        <p id="res-description" class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6"></p>

        <div class="pt-5 border-t border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4">
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Huipputulos: <strong id="res-best" class="text-zinc-700 dark:text-zinc-200">--</strong>
          </span>
          <div class="flex flex-wrap gap-3">
            <a
              href="/profile"
              class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
            >
              Profiili
            </a>
            <button
              id="btn-retake"
              type="button"
              class="pastel-play inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-200 active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Uudelleen
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational section -->
    <section class="border-t border-[var(--pastel-line)] dark:border-zinc-800 pt-12 pb-6">
      <div class="bg-white/90 dark:bg-zinc-900/60 border border-[var(--pastel-line)] dark:border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-[var(--pastel-card-shadow)] dark:shadow-none">
        <h2 class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-4">
          Mitä klikkausnopeustesti mittaa?
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed mb-4">
          Klikkaus sekunnissa (CPS) on yhdistelmä sormien motorisesta nopeudesta, syöttölaitteen viiveestä ja keskittymisestä, jota tarvitaan tasaisen rytmin ylläpitämiseen. Cattell-Horn-Carroll (CHC) -mallissa se kytkeytyy prosessointinopeuteen (Gs) — erityisesti havaintomotoriseen sujuvuuteen.
        </p>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed mb-4">
          Keskimääräinen hiiren käyttäjä yltää 5–7 CPS:iin. Yli 8 CPS:n lukemat vaativat yleensä tekniikan kuten butterfly- tai jitter-klikkauksen, jotka vaihtavat kestävyyden huippunopeuteen. Tämä testi raportoi molemmat: keskiarvon koko kokeen ajalta ja nopeimman yksittäisen sekunnin.
        </p>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed mb-6">
          <strong class="text-zinc-900 dark:text-zinc-100">Rytmin tasaisuus</strong> ilmoitetaan prosentteina klikkausvälien vaihtelun perusteella. Korkea luku tarkoittaa tasaista, metronomista rytmiä; matala taas pyrähtelevää tapaa, joka on tavallista lyhyissä kokeissa.
        </p>
        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/70 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-medium">
          Huomio: CPS-tulos riippuu vahvasti hiirestä, kosketusnäytöstä ja selaimen näytteenottotaajuudesta. Se kuvaa motorisen laitteen suorituskykyä tässä tehtävässä, ei yleistä älykkyyttä, eikä sitä pidä tulkita ÄO-mittauksena. Lopeta jos käsi kipeytyy.
        </div>
      </div>
    </section>
  </main>

  <!-- How to Play modal -->
  <div
    id="how-to-play-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="how-to-play-title"
  >
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl max-w-lg w-full p-6 sm:p-7 max-h-[85vh] overflow-y-auto">
      <div class="flex items-start justify-between gap-4 mb-4">
        <h2 id="how-to-play-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
          Kuinka pelataan
        </h2>
        <button
          id="btn-close-how-to-play"
          type="button"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-label="Sulje"
        >
          &times;
        </button>
      </div>
      <ol class="list-decimal list-inside space-y-3 text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
        <li>Valitse kokeen kesto: <strong class="text-zinc-900 dark:text-zinc-100">5, 10 tai 30 sekuntia</strong>. Pidemmät kokeet mittaavat kestävyyttä; lyhyet palkitsevat huippunopeuden.</li>
        <li>Paina <strong class="text-zinc-900 dark:text-zinc-100">Aloita testi</strong>, sitten klikkaa alustaa aloittaaksesi. Ajastin käynnistyy ensimmäisestä klikkauksesta, joten reaktioaikaa ei rankaista.</li>
        <li>Jatka klikkaamista niin nopeasti kuin pystyt kunnes aika loppuu. Voit käyttää hiirtä, kosketuslevyä, kosketusnäyttöä tai <kbd class="px-1.5 py-0.5 rounded border border-zinc-300 dark:border-zinc-600 font-mono text-xs">Välilyönti</kbd>-näppäintä.</li>
        <li>Tuloksesi pisteytetään automaattisesti ja tallennetaan <a href="/profile" class="text-blue-600 dark:text-blue-400 hover:underline">profiiliisi</a>.</li>
      </ol>
      <div class="mt-5 p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Vinkki: lepää kyynärvarsi pöydällä ja liikuta sormia. Koko käsivarren jännittäminen tuottaa nopean alun mutta jyrkän hiipumisen.
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { saveGameRecord, getPerformanceTier, getProfile } from '../../../utils/profileStore';

  type Phase = 'ready' | 'running' | 'done';

  let durationSeconds = 10;
  let phase: Phase = 'ready';
  let clickTimes: number[] = [];
  let trialStart = 0;
  let rafId = 0;
  let endTimerId = 0;

  const byId = (id: string) => document.getElementById(id);

  const arena = byId('cps-arena') as HTMLButtonElement | null;
  const arenaReady = byId('arena-ready');
  const arenaRunning = byId('arena-running');
  const arenaDone = byId('arena-done');
  const arenaClickCount = byId('arena-click-count');

  const hudTime = byId('hud-time');
  const hudClicks = byId('hud-clicks');
  const hudCps = byId('hud-cps');

  const btnStart = byId('btn-start') as HTMLButtonElement | null;
  const btnStartLabel = byId('btn-start-label');
  const btnReset = byId('btn-reset') as HTMLButtonElement | null;
  const btnRetake = byId('btn-retake') as HTMLButtonElement | null;
  const resultsPanel = byId('results-panel');

  const modal = byId('how-to-play-modal');

  function show(node: HTMLElement | null, visible: boolean) {
    if (!node) return;
    if (visible) {
      node.classList.remove('hidden');
      node.style.display = '';
    } else {
      node.classList.add('hidden');
    }
  }

  function showLayer(node: HTMLElement | null, visible: boolean) {
    if (!node) return;
    node.classList.toggle('hidden', !visible);
    node.classList.toggle('flex', visible);
  }

  function formatSeconds(ms: number) {
    return `${Math.max(0, ms / 1000).toFixed(1)}s`;
  }

  function setText(id: string, value: string) {
    const node = byId(id);
    if (node) node.textContent = value;
  }

  function median(values: number[]) {
    if (values.length === 0) return null;
    const sorted = [...values].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid];
  }

  function peakBurst(offsets: number[]) {
    let best = 0;
    let left = 0;
    for (let right = 0; right < offsets.length; right += 1) {
      while (offsets[right] - offsets[left] >= 1000) left += 1;
      best = Math.max(best, right - left + 1);
    }
    return best;
  }

  function setPhase(next: Phase) {
    phase = next;

    showLayer(arenaReady, next === 'ready');
    showLayer(arenaRunning, next === 'running');
    showLayer(arenaDone, next === 'done');

    if (btnStartLabel) {
      btnStartLabel.textContent = next === 'running' ? 'Testataan…' : next === 'done' ? 'Aloita uudelleen' : 'Aloita testi';
    }
    if (btnStart) btnStart.disabled = next === 'running';
    if (arena) arena.disabled = next === 'done';
  }

  function resetReadouts() {
    clickTimes = [];
    if (hudTime) hudTime.textContent = formatSeconds(durationSeconds * 1000);
    if (hudClicks) hudClicks.textContent = '0';
    if (hudCps) hudCps.textContent = '0.0';
    if (arenaClickCount) arenaClickCount.textContent = '0';
  }

  function armTrial() {
    window.clearTimeout(endTimerId);
    window.cancelAnimationFrame(rafId);
    resetReadouts();
    show(resultsPanel, false);
    setPhase('ready');
  }

  function tick() {
    if (phase !== 'running') return;
    const elapsed = performance.now() - trialStart;
    const remaining = Math.max(0, durationSeconds * 1000 - elapsed);

    if (hudTime) hudTime.textContent = formatSeconds(remaining);
    if (hudCps) {
      const cps = elapsed > 0 ? clickTimes.length / (elapsed / 1000) : 0;
      hudCps.textContent = cps.toFixed(1);
    }

    if (remaining > 0) {
      rafId = window.requestAnimationFrame(tick);
    }
  }

  function registerClick() {
    if (phase === 'ready') {
      trialStart = performance.now();
      clickTimes.push(0);
      setPhase('running');
      if (hudClicks) hudClicks.textContent = String(clickTimes.length);
      if (arenaClickCount) arenaClickCount.textContent = String(clickTimes.length);
      rafId = window.requestAnimationFrame(tick);
      endTimerId = window.setTimeout(finishTrial, durationSeconds * 1000);
      return;
    }

    if (phase !== 'running') return;

    const offset = performance.now() - trialStart;
    if (offset >= durationSeconds * 1000) return;

    clickTimes.push(offset);
    if (hudClicks) hudClicks.textContent = String(clickTimes.length);
    if (arenaClickCount) arenaClickCount.textContent = String(clickTimes.length);
    if (hudCps) {
      const cps = offset > 0 ? clickTimes.length / (offset / 1000) : 0;
      hudCps.textContent = cps.toFixed(1);
    }
  }

  function finishTrial() {
    window.cancelAnimationFrame(rafId);
    window.clearTimeout(endTimerId);
    setPhase('done');

    const total = clickTimes.length;
    const cps = total / durationSeconds;
    const peak = peakBurst(clickTimes);

    const intervals: number[] = [];
    for (let i = 1; i < clickTimes.length; i += 1) {
      intervals.push(clickTimes[i] - clickTimes[i - 1]);
    }
    const medianInterval = median(intervals);

    let rhythm: number | null = null;
    if (intervals.length >= 2) {
      const mean = intervals.reduce((sum, v) => sum + v, 0) / intervals.length;
      if (mean > 0) {
        const variance = intervals.reduce((sum, v) => sum + (v - mean) ** 2, 0) / intervals.length;
        const cv = Math.min(1, Math.sqrt(variance) / mean);
        rhythm = Math.round((1 - cv) * 100);
      }
    }

    const performanceScore = Math.max(0, Math.min(100, Math.round((cps / 10) * 100)));
    const tier = getPerformanceTier(performanceScore);

    setText('res-cps', cps.toFixed(2));
    setText('res-total', String(total));
    setText('res-peak', String(peak));
    setText('res-median', medianInterval === null ? '--' : `${Math.round(medianInterval)}ms`);
    setText('res-rhythm', rhythm === null ? '--' : `${rhythm}%`);

    const tierNode = byId('res-tier');
    if (tierNode) {
      tierNode.textContent = tier.tier;
      tierNode.className = `px-4 py-2 rounded-xl border text-sm font-bold text-center ${tier.badgeClass}`;
    }
    setText(
      'res-description',
      total === 0
        ? 'Yhtään klikkausta ei rekisteröity. Paina Uudelleen ja klikkaa alustaa heti ajastimen käynnistyttyä.'
        : `${tier.description} Nopein sekuntisi sisälsi ${peak} klikkausta.`
    );

    show(resultsPanel, true);

    if (total > 0) {
      try {
        saveGameRecord({
          gameId: 'click-speed-test',
          completedAt: new Date().toISOString(),
          durationSeconds,
          mode: 'standard',
          metrics: {
            performanceScore,
            accuracy: 1,
            trialsCompleted: total,
            correctCount: total,
            errorCount: 0,
            ...(medianInterval === null ? {} : { medianRT: Math.round(medianInterval) }),
            bestStreak: peak,
            maxLevel: durationSeconds,
          },
        });
      } catch (e) {
        console.warn('Could not save click speed record:', e);
      }
    }

    renderPersonalBest();

    if (resultsPanel) {
      resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function renderPersonalBest() {
    const node = byId('res-best');
    if (!node) return;
    try {
      const games = getProfile().games || [];
      let best = 0;
      games.forEach((session) => {
        if (session.gameId !== 'click-speed-test') return;
        const score = session.metrics?.performanceScore ?? 0;
        if (score > best) best = score;
      });
      node.textContent = best > 0 ? `${(best / 10).toFixed(2)} CPS` : '--';
    } catch {
      node.textContent = '--';
    }
  }

  function initDurationChips() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.duration-chip');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (phase === 'running') return;
        const value = parseInt(chip.getAttribute('data-duration') || '', 10);
        if (Number.isNaN(value)) return;
        durationSeconds = value;

        chips.forEach((other) => {
          const isActive = other === chip;
          other.classList.toggle('active', isActive);
          other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        armTrial();
      });
    });
  }

  function initModal() {
    const openBtn = byId('btn-how-to-play') as HTMLButtonElement | null;
    const closeBtn = byId('btn-close-how-to-play') as HTMLButtonElement | null;
    if (!modal) return;

    const open = () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      closeBtn?.focus();
    };
    const close = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      openBtn?.focus();
    };

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });
  }

  function initArena() {
    if (!arena) return;

    arena.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      registerClick();
    });

    arena.addEventListener('click', (event) => event.preventDefault());
    arena.addEventListener('contextmenu', (event) => event.preventDefault());

    arena.addEventListener('keydown', (event) => {
      if (event.key !== ' ' && event.key !== 'Enter') return;
      event.preventDefault();
      if (event.repeat) return;
      registerClick();
    });
  }

  function init() {
    resetReadouts();
    setPhase('ready');
    show(resultsPanel, false);
    renderPersonalBest();

    initDurationChips();
    initModal();
    initArena();

    btnStart?.addEventListener('click', () => {
      if (phase === 'running') return;
      armTrial();
      arena?.focus();
    });

    btnReset?.addEventListener('click', () => {
      armTrial();
    });

    btnRetake?.addEventListener('click', () => {
      armTrial();
      arena?.focus();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
