          if (diagDesc) diagDesc.textContent = 'Vastaustesi perusteella tässä selaimessa tehdyssä testissä ei näkynyt viitteitä puna-vihreän värinäön poikkeamasta. Tulos on suuntaa-antava eikä korvaa ammattilaisen tutkimusta.';
          diagTitle.className = 'text-2xl sm:text-3xl font-heading font-extrabold text-emerald-600 dark:text-emerald-400 mb-2';
        } else if (txt.includes('deuter') || txt.includes('protan') || txt.includes('variation') || txt.includes('color vision')) {
          // Generic deficiency mapping to safety-approved phrase
          if (!txt.includes('ei havaittu')) {
            diagTitle.textContent = 'Viitteitä puna-vihreän värinäön poikkeamasta';
            if (diagDesc) diagDesc.textContent = 'Vastauksissasi näkyi viitteitä puna-vihreän värinäön poikkeamasta tässä testissä. Tämä on suuntaa-antava havainto selaimessa – tarkempi arvio vaatii silmälääkärin tai optikon tutkimuksen.';
            diagTitle.className = 'text-2xl sm:text-3xl font-heading font-extrabold text-amber-500 dark:text-amber-400 mb-2';
          }
        } else if (txt.includes('viitteitä') || txt.includes('ei havaittu')) {
          // Already Finnish, keep
        }
      });
      observer.observe(diagTitle, { childList: true, characterData: true, subtree: true });
      // Also patch prompt texts to Finnish after mode switch
      const promptMain = document.getElementById('prompt-main-text');
      const promptSub = document.getElementById('prompt-sub-text');
      if (promptMain) {
        const mo = new MutationObserver(() => {
          const t = promptMain.textContent || '';
          if (t === 'Select the Number You See') promptMain.textContent = 'Mitä numeroa näet?';
          if (t === 'What shape do you see in the dots?') promptMain.textContent = 'Mitä kuviota näet pisteissä?';
          if (promptSub) {
            const s = promptSub.textContent || '';
            if (s.includes('Keyboard shortcuts')) promptSub.textContent = 'Näppäimet: [1-9], [N] En näe numeroa, [U] Epävarma';
            if (s.includes('Tap the matching')) promptSub.textContent = 'Napauta vastaavaa muotoa alta';
          }
          const badge = document.getElementById('plate-counter-badge');
          if (badge && badge.textContent.includes('PLATE')) {
            badge.textContent = badge.textContent.replace('PLATE','TAULU').replace('OF','/');
          }
        });
        mo.observe(promptMain, { childList: true, characterData: true, subtree: true });
      }
    })();
  </script>
</Layout>
