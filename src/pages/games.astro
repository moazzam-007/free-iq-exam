---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free Brain Training Games - 10 Cognitive Drills & Mind Games | FreeIQExam";
const description = "Train working memory, processing speed, spatial rotation, and deductive logic with 10 free science-inspired brain games online. Instant tracking with zero paywalls.";

const games = [
  {
    id: 'n-back',
    name: 'Dual N-Back Memory',
    route: '/games/n-back',
    pastelTag: 'pastel-tag-mint',
    pastelIcon: 'pastel-icon-mint',
    description: 'Track spatial positions and letters simultaneously N steps back.',
    skill: 'Working Memory (Gwm)',
    domain: 'working-memory',
    domains: ['working-memory'],
    unit: 'pts',
    mood: 'Calm + focused',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.5-7.5h15" />'
  },
  {
    id: 'rotation',
    name: '3D Rotation Challenge',
    route: '/games/rotation',
    pastelTag: 'pastel-tag-sky',
    pastelIcon: 'pastel-icon-sky',
    description: 'Mentally rotate 3D isometric cubes to verify matching viewpoints.',
    skill: 'Visual-Spatial Processing (Gv)',
    domain: 'visual-spatial',
    domains: ['visual-spatial'],
    unit: 'pts',
    mood: 'Cool + precise',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />'
  },
  {
    id: 'math-sprint',
    name: 'Speed Math Sprint',
    route: '/games/math-sprint',
    pastelTag: 'pastel-tag-yellow',
    pastelIcon: 'pastel-icon-yellow',
    description: 'Solve rapid arithmetic operations under strict 60-second time pressure.',
    skill: 'Quantitative Reasoning (Gq) & Speed (Gs)',
    domain: 'quantitative',
    domains: ['quantitative', 'processing-speed'],
    unit: 'pts',
    mood: 'Bright + energetic',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.75h14.5M12 4.75v14.5m4-4l-3-3m3 3l3-3m-14 3h6m-6 3h6" />'
  },
  {
    id: 'symbol-match',
    name: 'Symbol Match Blitz',
    route: '/games/symbol-match',
    pastelTag: 'pastel-tag-lav',
    pastelIcon: 'pastel-icon-lav',
    description: 'Rapid-fire geometric symbol-to-digit translation under time pressure.',
    skill: 'Perceptual Processing Speed (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'pts',
    mood: 'Soft + quick',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v8.25A2.25 2.25 0 006 16.5h2.25m8.25-8.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-7.5A2.25 2.25 0 018.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 00-2.25 2.25v6" />'
  },
  {
    id: 'syllogism',
    name: 'Syllogism Blitz',
    route: '/games/syllogism',
    pastelTag: 'pastel-tag-peach',
    pastelIcon: 'pastel-icon-peach',
    description: 'Determine logical validity of deductive premises before time expires.',
    skill: 'Deductive Logic & Fluid Reasoning (Gf)',
    domain: 'fluid-reasoning',
    domains: ['fluid-reasoning'],
    unit: 'pts',
    mood: 'Warm + thoughtful',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.508 1.333 1.508 2.316V18" />'
  },
  {
    id: 'stroop-clash',
    name: 'Stroop Color Clash',
    route: '/games/stroop-clash',
    pastelTag: 'pastel-tag-coral',
    pastelIcon: 'pastel-icon-coral',
    description: 'Select ink color while suppressing automated semantic word reading.',
    skill: 'Inhibitory Control & Speed (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'pts',
    mood: 'Bold + focused',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.804-2.803a3.75 3.75 0 015.304 0l2.196 2.196a3.75 3.75 0 010 5.304l-2.803 2.804" />'
  },
  {
    id: 'memory-matrix',
    name: 'Spatial Memory Matrix',
    route: '/games/memory-matrix',
    pastelTag: 'pastel-tag-cyan',
    pastelIcon: 'pastel-icon-cyan',
    description: 'Memorize briefly flashed spatial grid patterns and reconstruct them.',
    skill: 'Visual-Spatial Working Memory (Gwm)',
    domain: 'visual-spatial',
    domains: ['visual-spatial', 'working-memory'],
    unit: 'pts',
    mood: 'Fresh + visual',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />'
  },
  {
    id: 'digit-span',
    name: 'Digit Span Memory',
    route: '/games/digit-span',
    pastelTag: 'pastel-tag-lav',
    pastelIcon: 'pastel-icon-lav',
    description: 'Serial recall and mental reversal of numerical sequences.',
    skill: 'Acoustic & Serial Working Memory (Gwm)',
    domain: 'working-memory',
    domains: ['working-memory'],
    unit: 'pts',
    mood: 'Simple + calm',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />'
  },
  {
    id: 'flanker-test',
    name: 'Flanker Direction Blitz',
    route: '/games/flanker-test',
    pastelTag: 'pastel-tag-sky',
    pastelIcon: 'pastel-icon-sky',
    description: 'Suppress peripheral arrow noise and target the central arrow direction.',
    skill: 'Selective Attention & Speed (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'pts',
    mood: 'Clean + sharp',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />'
  },
  {
    id: 'sequence-rush',
    name: 'Sequence Rush',
    route: '/games/sequence-rush',
    pastelTag: 'pastel-tag-peach',
    pastelIcon: 'pastel-icon-peach',
    description: 'Deduce abstract mathematical and alphabetic sequence extrapolation rules.',
    skill: 'Inductive Series Completion (Gf)',
    domain: 'fluid-reasoning',
    domains: ['fluid-reasoning'],
    unit: 'pts',
    mood: 'Playful + clever',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3" />'
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cognitive Training Games",
    "url": "https://freeiqexam.com/games/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "10 free science-inspired cognitive mini-games for training working memory, processing speed, spatial rotation, math fluency, and deductive reasoning.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cognitive Games",
        "item": "https://freeiqexam.com/games/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can brain training games increase your IQ score?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Brain training games primarily improve task-specific operational fluency and narrow cognitive skills (known as 'near transfer'). While some research (such as Jaeggi et al., 2008 on Dual N-Back) investigated transfer to fluid intelligence, broader meta-analyses show that practicing mini-games enhances reaction time, working memory strategy, and processing efficiency rather than fundamentally increasing innate general intelligence (g factor)."
        }
      },
      {
        "@type": "Question",
        "name": "What cognitive domains do these games measure?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The 10 drills map directly to Cattell-Horn-Carroll (CHC) cognitive domains: Working Memory (Dual N-Back, Digit Span, Memory Matrix), Processing Speed (Symbol Match, Flanker Test, Stroop Clash), Visual-Spatial Ability (3D Rotation), Quantitative Fluency (Speed Math Sprint), and Fluid/Deductive Reasoning (Syllogism Blitz, Sequence Rush)."
        }
      },
      {
        "@type": "Question",
        "name": "How do cognitive mini-games differ from standardized IQ tests?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standardized IQ tests (like WAIS-IV or Cattell Culture Fair) are normative psychometric instruments administered under strict standardized conditions to measure composite cognitive capacity relative to a representative population. Cognitive mini-games are speeded, gamified training exercises designed for repeated practice, personal record tracking, and cognitive stimulation."
        }
      },
      {
        "@type": "Question",
        "name": "Are these brain training games completely free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. All 10 cognitive games on FreeIQExam are 100% free with no paywalls, subscriptions, account requirements, or hidden fees. Scores, personal bests, and analytics are computed locally in your browser."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />

  <div class="flex-1 games-pastel-wrap">
  <main class="games-pastel py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Cognitive Games</span>
    </nav>

    <!-- Hero Section — pastel light, dark monochrome -->
    <header class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div class="pastel-eyebrow pastel-eyebrow-mint mb-4">
        Brain Training Lab
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Cognitive Training Games
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Ten science-inspired drills targeting the core cognitive abilities assessed in formal IQ testing. Train your brain, track your personal records.
      </p>

      <!-- Stat Badges — pastel -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium">
        <span class="pastel-tag pastel-tag-mint !px-3.5 !py-1.5 !text-xs sm:!text-sm">
          <span class="w-2 h-2 rounded-full bg-[var(--pastel-mint-ink)] animate-pulse"></span>
          10 Games Available
        </span>
        <span class="pastel-tag pastel-tag-sky !px-3.5 !py-1.5 !text-xs sm:!text-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Free - No Account Required
        </span>
      </div>
    </header>

    <!-- Navigation Callout to Cognitive Profile — pastel light -->
    <aside class="mb-10 sm:mb-12 p-5 sm:p-6 rounded-3xl bg-white/90 dark:bg-zinc-900 border border-[var(--pastel-line)] dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-[var(--pastel-card-shadow)] dark:shadow-none" aria-label="Profile quick navigation">
      <div class="flex items-center gap-3.5">
        <div class="pastel-icon pastel-icon-lav w-10 h-10 rounded-2xl shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
            Personal Agility Dashboard
          </div>
          <p class="text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 mt-0.5">
            Track Your Agility Trends: View your complete session logs, rolling medians, and domain performance on <a href="/profile" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">My Cognitive Profile</a> &rarr;
          </p>
        </div>
      </div>
      <a
        href="/profile"
        class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm text-white bg-blue-600 hover:bg-blue-500 shadow-xs transition-all hover:scale-102 shrink-0"
      >
        <span>My Cognitive Profile</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </aside>

    <!-- Interactive Category Filter Tabs — pastel -->
    <div class="mb-8 max-w-4xl mx-auto" role="region" aria-label="Game category filters">
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5" id="category-filter-bar">
        <button
          type="button"
          data-filter="all"
          class="filter-tab pastel-chip active min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="true"
        >
          All (10)
        </button>
        <button
          type="button"
          data-filter="working-memory"
          class="filter-tab pastel-chip min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Working Memory (3)
        </button>
        <button
          type="button"
          data-filter="processing-speed"
          class="filter-tab pastel-chip min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Processing Speed (3)
        </button>
        <button
          type="button"
          data-filter="visual-spatial"
          class="filter-tab pastel-chip min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Visual-Spatial (2)
        </button>
        <button
          type="button"
          data-filter="fluid-reasoning"
          class="filter-tab pastel-chip min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Fluid Reasoning (3)
        </button>
        <button
          type="button"
          data-filter="quantitative"
          class="filter-tab pastel-chip min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Quantitative (1)
        </button>
      </div>
    </div>

    <!-- 10 Game Cards Grid — pastel playful hierarchy -->
    <section class="games-pastel-grid grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-16" id="games-grid" aria-label="Mini-Games Catalog">
      {games.map((game) => (
        <article
          class="game-card games-pastel-card group relative rounded-2xl p-6 sm:p-7 flex flex-col justify-between"
          data-domains={game.domains.join(' ')}
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3.5">
                <div class={`pastel-icon ${game.pastelIcon} w-12 h-12 rounded-xl shadow-sm`}>
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={game.icon} />
                </div>
                <div>
                  <h2 class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
                    {game.name}
                  </h2>
                  <p class="mt-1 text-xs sm:text-[13px] font-medium text-zinc-500 dark:text-zinc-400 leading-snug">
                    Cognitive Skill Trained: {game.skill}
                  </p>
                </div>
              </div>

              <!-- Best Score Pill — pastel -->
              <div class="text-right flex-shrink-0">
                <div id={`best-${game.id}`} class="pastel-tag !bg-white dark:!bg-zinc-800 !text-zinc-700 dark:!text-zinc-300 !border-[var(--pastel-line)] dark:!border-zinc-700 font-mono text-xs">
                  Best: --
                </div>
              </div>
            </div>

            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              {game.description}
            </p>
            <div class="flex gap-2 mb-2">
              <span class={`pastel-tag ${game.pastelTag} !text-[11px]`}>{game.mood}</span>
              <span class="pastel-tag !bg-white dark:!bg-zinc-800 !text-zinc-500 dark:!text-zinc-400 !border-zinc-200 dark:!border-zinc-700 text-[11px]">{game.domain}</span>
            </div>
          </div>

          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
              Targeted speed drill
            </span>
            <a
              href={game.route}
              class="pastel-play inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl font-semibold text-sm shadow-sm transition-all duration-150 hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              <span>Play Now</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </section>

    <!-- Educational Footer Section — pastel -->
    <section class="border-t border-[var(--pastel-line)] dark:border-zinc-800 pt-12 pb-6 max-w-4xl mx-auto">
      <div class="bg-white/90 dark:bg-zinc-900/60 border border-[var(--pastel-line)] dark:border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-[var(--pastel-card-shadow)] dark:shadow-none">
        <h2 class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-4">
          Why Cognitive Training Games?
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
          In the Cattell-Horn-Carroll (CHC) theory of cognitive capabilities, general intelligence is composed of distinct narrow and broad domains. Working memory capacity (Gwm), processing speed (Gs), visual-spatial rotation (Gv), and quantitative reasoning (Gq) act as the foundational processing machinery that supports fluid reasoning (Gf).
        </p>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          Speeded drills create focused mental tension that demands rapid working memory retrieval, inhibition of distractors, and mental rotation without perceptual drift. Regular practice helps sharpen attention control and operational response speed under calibrated time pressure.
        </p>
        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/70 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-medium">
          Note: Games measure speed and accuracy on specific cognitive tasks. They are performance tools, not IQ tests.
        </div>
      </div>
    </section>

    <!-- FAQ Section — pastel -->
    <section class="mt-12 bg-white/90 dark:bg-zinc-900 border border-[var(--pastel-line)] dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-[var(--pastel-card-shadow)] dark:shadow-none">
      <div class="max-w-3xl">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-6">
          Frequently Asked Questions About Cognitive Drills
        </h2>
        <div class="space-y-4">
          <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-zinc-50 dark:open:bg-zinc-800/40">
            <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
              <span>Can brain training games increase your IQ score?</span>
              <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
