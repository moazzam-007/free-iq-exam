---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Cognitive Training Games - 10 Free Science-Inspired Brain Drills | FreeIQExam";
const description = "Train working memory, processing speed, visual-spatial rotation, math fluency, deductive logic, and inhibitory control with 10 free science-inspired cognitive mini-games.";

const games = [
  {
    id: 'n-back',
    name: 'Dual N-Back Memory',
    route: '/games/n-back',
    tagColor: 'blue',
    badgeClass: 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-800',
    iconBg: 'bg-blue-600 dark:bg-blue-500 text-white',
    borderHover: 'hover:border-blue-500/50 dark:hover:border-blue-400/50',
    description: 'Track spatial positions and letters simultaneously N steps back.',
    skill: 'Working Memory (Gwm)',
    domain: 'working-memory',
    domains: ['working-memory'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.5-7.5h15" />'
  },
  {
    id: 'rotation',
    name: '3D Rotation Challenge',
    route: '/games/rotation',
    tagColor: 'indigo',
    badgeClass: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800',
    iconBg: 'bg-indigo-600 dark:bg-indigo-500 text-white',
    borderHover: 'hover:border-indigo-500/50 dark:hover:border-indigo-400/50',
    description: 'Mentally rotate 3D isometric cubes to verify matching viewpoints.',
    skill: 'Visual-Spatial Processing (Gv)',
    domain: 'visual-spatial',
    domains: ['visual-spatial'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />'
  },
  {
    id: 'math-sprint',
    name: 'Speed Math Sprint',
    route: '/games/math-sprint',
    tagColor: 'emerald',
    badgeClass: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
    iconBg: 'bg-emerald-600 dark:bg-emerald-500 text-white',
    borderHover: 'hover:border-emerald-500/50 dark:hover:border-emerald-400/50',
    description: 'Solve rapid arithmetic operations under strict 60-second time pressure.',
    skill: 'Quantitative Reasoning (Gq) & Speed (Gs)',
    domain: 'quantitative',
    domains: ['quantitative', 'processing-speed'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.75h14.5M12 4.75v14.5m4-4l-3-3m3 3l3-3m-14 3h6m-6 3h6" />'
  },
  {
    id: 'symbol-match',
    name: 'Symbol Match Blitz',
    route: '/games/symbol-match',
    tagColor: 'purple',
    badgeClass: 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200 dark:border-purple-800',
    iconBg: 'bg-purple-600 dark:bg-purple-500 text-white',
    borderHover: 'hover:border-purple-500/50 dark:hover:border-purple-400/50',
    description: 'Rapid visual scanning and symbol-digit association speed drill.',
    skill: 'Processing Speed (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />'
  },
  {
    id: 'syllogism',
    name: 'Syllogism Logic Drill',
    route: '/games/syllogism',
    tagColor: 'amber',
    badgeClass: 'bg-amber-50 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800',
    iconBg: 'bg-amber-700 dark:bg-amber-600 text-white',
    borderHover: 'hover:border-amber-500/50 dark:hover:border-amber-400/50',
    description: 'Verify logical validity of formal categorical syllogisms.',
    skill: 'Deductive Reasoning (Gf)',
    domain: 'fluid-reasoning',
    domains: ['fluid-reasoning'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.508 1.333 1.508 2.316V18" />'
  },
  {
    id: 'stroop-clash',
    name: 'Stroop Color Clash',
    route: '/games/stroop-clash',
    tagColor: 'rose',
    badgeClass: 'bg-rose-50 text-rose-700 dark:bg-rose-950/60 dark:text-rose-300 border-rose-200 dark:border-rose-800',
    iconBg: 'bg-rose-600 dark:bg-rose-500 text-white',
    borderHover: 'hover:border-rose-500/50 dark:hover:border-rose-400/50',
    description: 'Overcome cognitive interference by identifying font ink color instead of text.',
    skill: 'Inhibitory Control (Gf & Gs)',
    domain: 'fluid-reasoning',
    domains: ['fluid-reasoning'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072" />'
  },
  {
    id: 'memory-matrix',
    name: 'Memory Matrix Span',
    route: '/games/memory-matrix',
    tagColor: 'cyan',
    badgeClass: 'bg-cyan-50 text-cyan-700 dark:bg-cyan-950/60 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800',
    iconBg: 'bg-cyan-600 dark:bg-cyan-500 text-white',
    borderHover: 'hover:border-cyan-500/50 dark:hover:border-cyan-400/50',
    description: 'Recall dynamic spatial patterns across expanding matrix grid spans.',
    skill: 'Visuospatial Working Memory (Gwm & Gv)',
    domain: 'working-memory',
    domains: ['working-memory', 'visual-spatial'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />'
  },
  {
    id: 'digit-span',
    name: 'Digit Span Memory',
    route: '/games/digit-span',
    tagColor: 'teal',
    badgeClass: 'bg-teal-50 text-teal-700 dark:bg-teal-950/60 dark:text-teal-300 border-teal-200 dark:border-teal-800',
    iconBg: 'bg-teal-600 dark:bg-teal-500 text-white',
    borderHover: 'hover:border-teal-500/50 dark:hover:border-teal-400/50',
    description: 'Serial recall and mental reversal of numerical sequences.',
    skill: 'Acoustic & Serial Working Memory (Gwm)',
    domain: 'working-memory',
    domains: ['working-memory'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />'
  },
  {
    id: 'flanker-test',
    name: 'Flanker Direction Blitz',
    route: '/games/flanker-test',
    tagColor: 'violet',
    badgeClass: 'bg-violet-50 text-violet-700 dark:bg-violet-950/60 dark:text-violet-300 border-violet-200 dark:border-violet-800',
    iconBg: 'bg-violet-600 dark:bg-violet-500 text-white',
    borderHover: 'hover:border-violet-500/50 dark:hover:border-violet-400/50',
    description: 'Suppress peripheral arrow noise and target the central arrow direction.',
    skill: 'Selective Attention & Speed (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />'
  },
  {
    id: 'sequence-rush',
    name: 'Sequence Rush',
    route: '/games/sequence-rush',
    tagColor: 'orange',
    badgeClass: 'bg-orange-50 text-orange-700 dark:bg-orange-950/60 dark:text-orange-300 border-orange-200 dark:border-orange-800',
    iconBg: 'bg-orange-600 dark:bg-orange-500 text-white',
    borderHover: 'hover:border-orange-500/50 dark:hover:border-orange-400/50',
    description: 'Deduce abstract mathematical and alphabetic sequence extrapolation rules.',
    skill: 'Inductive Series Completion (Gf)',
    domain: 'fluid-reasoning',
    domains: ['fluid-reasoning'],
    unit: 'pts',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3" />'
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cognitive Training Games",
    "url": "https://freeiqexam.com/games",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "10 free science-inspired cognitive mini-games for training working memory, processing speed, spatial rotation, math fluency, and deductive reasoning.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cognitive Games",
        "item": "https://freeiqexam.com/games"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Cognitive Games</span>
    </nav>

    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/80 mb-4">
        Brain Training Lab
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Cognitive Training Games
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Ten science-inspired drills targeting the core cognitive abilities assessed in formal IQ testing. Train your brain, track your personal records.
      </p>

      <!-- Stat Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          10 Games Available
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          Free - No Account Required
        </span>
      </div>
    </header>

    <!-- Navigation Callout to Cognitive Profile -->
    <aside class="mb-10 sm:mb-12 p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-blue-50/80 via-indigo-50/60 to-purple-50/80 dark:from-blue-950/40 dark:via-indigo-950/30 dark:to-purple-950/40 border border-blue-200/80 dark:border-blue-900/50 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xs" aria-label="Profile quick navigation">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-2xl bg-blue-600 dark:bg-blue-500 text-white flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <div>
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
            Personal Agility Dashboard
          </div>
          <p class="text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 mt-0.5">
            Track Your Agility Trends: View your complete session logs, rolling medians, and domain performance on <a href="/profile" class="font-semibold text-blue-600 dark:text-blue-400 hover:underline">My Cognitive Profile</a> &rarr;
          </p>
        </div>
      </div>
      <a
        href="/profile"
        class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl font-semibold text-xs sm:text-sm text-white bg-blue-600 hover:bg-blue-500 shadow-xs transition-all hover:scale-102 shrink-0"
      >
        <span>My Cognitive Profile</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </aside>

    <!-- Interactive Category Filter Tabs -->
    <div class="mb-8 max-w-4xl mx-auto" role="region" aria-label="Game category filters">
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5" id="category-filter-bar">
        <button
          type="button"
          data-filter="all"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-blue-600 text-white shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="true"
        >
          All (10)
        </button>
        <button
          type="button"
          data-filter="working-memory"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Working Memory (3)
        </button>
        <button
          type="button"
          data-filter="processing-speed"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Processing Speed (3)
        </button>
        <button
          type="button"
          data-filter="visual-spatial"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Visual-Spatial (2)
        </button>
        <button
          type="button"
          data-filter="fluid-reasoning"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Fluid Reasoning (3)
        </button>
        <button
          type="button"
          data-filter="quantitative"
          class="filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          aria-pressed="false"
        >
          Quantitative (1)
        </button>
      </div>
    </div>

    <!-- 10 Game Cards Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mb-16" id="games-grid" aria-label="Mini-Games Catalog">
      {games.map((game) => (
        <article
          class={`game-card group relative bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm border border-zinc-200/90 dark:border-zinc-800 rounded-2xl p-6 sm:p-7 shadow-sm transition-all duration-200 ${game.borderHover} hover:shadow-md flex flex-col justify-between`}
          data-domains={game.domains.join(' ')}
        >
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3.5">
                <div class={`w-12 h-12 rounded-xl flex items-center justify-center shadow-sm flex-shrink-0 ${game.iconBg}`}>
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={game.icon} />
                </div>
                <div>
                  <h2 class="text-xl font-heading font-bold text-zinc-950 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {game.name}
                  </h2>
                  <span class={`inline-block mt-1 px-2.5 py-0.5 rounded-full text-xs font-medium border ${game.badgeClass}`}>
                    Cognitive Skill Trained: {game.skill}
                  </span>
                </div>
              </div>

              <!-- Best Score Pill -->
              <div class="text-right flex-shrink-0">
                <div id={`best-${game.id}`} class="px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/80 font-mono text-xs font-semibold text-zinc-700 dark:text-zinc-300">
                  Best: --
                </div>
              </div>
            </div>

            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              {game.description}
            </p>
          </div>

          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
              Targeted speed drill
            </span>
            <a
              href={game.route}
              class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-xl font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all duration-150 hover:scale-105 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              <span>Play Now</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </section>

    <!-- Educational Footer Section -->
    <section class="border-t border-zinc-200 dark:border-zinc-800 pt-12 pb-6 max-w-4xl mx-auto">
      <div class="bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 sm:p-8">
        <h2 class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-4">
          Why Cognitive Training Games?
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
          In the Cattell-Horn-Carroll (CHC) theory of cognitive capabilities, general intelligence is composed of distinct narrow and broad domains. Working memory capacity (Gwm), processing speed (Gs), visual-spatial rotation (Gv), and quantitative reasoning (Gq) act as the foundational processing machinery that supports fluid reasoning (Gf).
        </p>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          Speeded drills create focused mental tension that demands rapid working memory retrieval, inhibition of distractors, and mental rotation without perceptual drift. Regular practice helps sharpen attention control and operational response speed under calibrated time pressure.
        </p>
        <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/70 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-medium">
          Note: Games measure speed and accuracy on specific cognitive tasks. They are performance tools, not IQ tests.
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { getProfile } from '../utils/profileStore';

  // 1. Personal Best Score Hydration
  function hydratePersonalBests() {
    try {
      const profile = getProfile();
      const games = profile.games || [];

      // Calculate highest performanceScore per gameId from profile
      const bestFromProfile: Record<string, number> = {};
      games.forEach((session) => {
        const score = session.metrics?.performanceScore ?? 0;
        if (!bestFromProfile[session.gameId] || score > bestFromProfile[session.gameId]) {
          bestFromProfile[session.gameId] = score;
        }
      });

      // Legacy fallback keys
      const legacyKeyMap: Record<string, string> = {
        'n-back': 'fiq_game_nback_best',
        'rotation': 'fiq_game_rotation_best',
        'math-sprint': 'fiq_game_math_best',
        'symbol-match': 'fiq_game_symbol_best',
        'syllogism': 'fiq_game_syllogism_best',
      };

      const gameIds = [
        'n-back',
        'rotation',
        'math-sprint',
        'symbol-match',
        'syllogism',
        'stroop-clash',
        'memory-matrix',
        'digit-span',
        'flanker-test',
        'sequence-rush',
      ];

      gameIds.forEach((id) => {
        let best = bestFromProfile[id] || 0;
        if (!best && legacyKeyMap[id]) {
          const legacyVal = parseInt(localStorage.getItem(legacyKeyMap[id]) || '0', 10);
          if (!isNaN(legacyVal) && legacyVal > 0) {
            best = legacyVal;
          }
        }

        const el = document.getElementById(`best-${id}`);
        if (el && best > 0) {
          el.textContent = `Best: ${best} pts`;
          el.classList.remove('text-zinc-700', 'dark:text-zinc-300');
          el.classList.add('text-blue-600', 'dark:text-blue-400', 'font-bold');
        }
      });
    } catch (e) {
      console.warn('Failed to hydrate personal bests:', e);
    }
  }

  // 2. Interactive Category Filter Tabs
  function initFilterTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.game-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';

        // Update tab styles and aria-pressed
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          if (isActive) {
            t.className = 'filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-blue-600 text-white shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
          } else {
            t.className = 'filter-tab min-h-[44px] px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
          }
        });

        // Filter cards smoothly
        cards.forEach((card) => {
          const domains = (card.getAttribute('data-domains') || '').split(' ');
          const matches = filter === 'all' || domains.includes(filter);
          if (matches) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    hydratePersonalBests();
    initFilterTabs();
  });
</script>
