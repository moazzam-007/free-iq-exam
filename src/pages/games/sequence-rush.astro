---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Number Series Test Free - Inductive Sequence Rush Drill | FreeIQExam";
const description = "Take the speeded number series test online free. Measure fluid intelligence (Gf) and inductive logic across progressive numerical and alphanumeric patterns.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Sequence Rush Number Series Drill",
    "url": "https://freeiqexam.com/games/sequence-rush",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Speeded inductive number series drill challenging algorithmic pattern recognition and mathematical rule extrapolation."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cognitive Games",
        "item": "https://freeiqexam.com/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Sequence Rush",
        "item": "https://freeiqexam.com/games/sequence-rush"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href="/games" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Cognitive Games</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Sequence Rush</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-peach mb-1.5">
          Gf &bull; Fluid Reasoning
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
            Sequence Rush
          </h1>
          <button
            id="btn-how-to-play"
            type="button"
            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center p-2 rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 text-xs font-mono font-medium gap-1.5 cursor-pointer"
            aria-label="How to play instructions"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
            <span>How to Play</span>
          </button>
        </div>
      </div>

      <!-- Stat HUD (4 rounded cards) -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Item</div>
          <div id="hud-item" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 15</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Score</div>
          <div id="hud-score" class="font-bold text-indigo-600 dark:text-indigo-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Pace</div>
          <div id="hud-pace" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">-- s</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Best</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center min-h-[440px] justify-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-peach flex items-center justify-center mb-5 shadow-lg shadow-indigo-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Sequence Rush
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Deduce the underlying logical rule governing the sequence and select the missing item to replace the <span class="font-bold text-indigo-600 dark:text-indigo-400">[ ? ]</span> marker.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            15 inductive reasoning puzzles across arithmetic, alternating, recursive, and alphabetical rule families.
          </p>
        </div>

        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-heading font-bold text-base shadow-md transition-all duration-150 hover:scale-105 active:scale-95 flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <span>Start Session (Space)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content (inert while overlay active) -->
      <div id="game-arena-content" inert class="w-full flex flex-col items-center">
        <!-- Top Status & Pattern Family Badge -->
        <div class="w-full max-w-md flex items-center justify-between gap-4 mb-4 font-mono text-xs">
          <div id="family-badge" class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 font-semibold">
            Category: Arithmetic Series
          </div>
          <div id="timer-indicator" class="text-zinc-500 dark:text-zinc-400">
            Pace: <span id="item-timer" class="font-bold text-zinc-800 dark:text-zinc-200">0.0s</span>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="w-full max-w-md h-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full mb-6 overflow-hidden">
          <div id="series-progress" class="h-full bg-indigo-500 transition-all duration-150 w-0"></div>
        </div>

        <!-- Sequence Display Box -->
        <div class="w-full max-w-lg min-h-[140px] rounded-3xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80 flex flex-col items-center justify-center p-6 mb-6 shadow-inner">
          <div id="sequence-container" class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
            <!-- Rendered sequence pill cards inserted here -->
          </div>
          <div id="feedback-message" class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 mt-4 h-4">
            Identify the governing rule
          </div>
        </div>

        <!-- 2x2 Multiple Choice Options Grid -->
        <div id="options-grid" class="w-full max-w-lg grid grid-cols-2 gap-3 sm:gap-4 mb-3">
          <!-- 4 option buttons dynamically populated -->
        </div>

        <p class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500 mt-2 text-center">
          Keyboard hotkeys: Press 1, 2, 3, 4 or A, B, C, D to answer.
        </p>
      </div>
    </div>

    <!-- Accessible "How to Play" Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
        <button
          id="btn-close-how-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer"
          aria-label="Close instructions"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
          </div>
          <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
            How to Play: Sequence Rush
          </h2>
        </div>

        <div class="space-y-3 text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
          <p>
            <strong>1. Pattern Induction:</strong> Each puzzle features an ordered sequence of numbers or letters with a missing item marked by <code class="font-mono font-bold text-indigo-600 dark:text-indigo-400">[ ? ]</code>.
          </p>
          <p>
            <strong>2. Sequence Families:</strong>
            <br />- <em>Arithmetic & Polynomial:</em> Constant deltas (+5), scaling multipliers (*2), or square progressions (n^2).
            <br />- <em>Alternating Series:</em> Two interwoven patterns or escalating deltas (+1, +2, +3).
            <br />- <em>Recursive & Fibonacci:</em> Terms formed by combining prior elements.
            <br />- <em>Alphabetical Jumps:</em> Letter coordinate shifts (+2, +3 steps).
          </p>
          <p>
            <strong>3. Response:</strong> Click one of the 4 choices or press hotkeys <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">1-4</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">A-D</kbd>.
          </p>
          <p>
            <strong>4. Scoring:</strong> 15 items total. Accuracy accounts for 75 points; rapid deduction pace yields up to 25 speed bonus points.
          </p>
        </div>

        <button
          id="btn-confirm-how"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-sm transition-all duration-150 cursor-pointer"
        >
          Got it, Let's Play
        </button>
      </div>
    </div>

    <!-- Accessible End of Round Modal -->
    <div
      id="modal-end-round"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-end-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl text-center max-h-[90vh] overflow-y-auto">
        <!-- Close Button (X) -->
        <button
          id="btn-close-end-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer"
          aria-label="Close summary modal"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h2 id="modal-end-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Session Complete!
        </h2>
        <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-5">
          Fluid Reasoning & Series Completion Summary
        </p>

        <!-- Performance Score (0 - 100) -->
        <div class="mb-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
          <div class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
            Task Performance Score
          </div>
          <div id="modal-score" class="text-4xl sm:text-5xl font-extrabold text-indigo-600 dark:text-indigo-400 font-heading">
            0
          </div>
          <div class="mt-2.5 flex items-center justify-center gap-2">
            <span id="modal-tier-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700">
              Developing
            </span>
          </div>
          <p id="modal-tier-desc" class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 max-w-sm mx-auto">
            Performance reflects rule induction accuracy and deduction fluency.
          </p>
        </div>

        <!-- Paradigm Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Solved</div>
            <div id="modal-solved" class="font-bold text-base text-indigo-600 dark:text-indigo-400">0 / 15</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Accuracy</div>
            <div id="modal-acc" class="font-bold text-base text-zinc-900 dark:text-white">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Median Pace</div>
            <div id="modal-pace" class="font-bold text-base text-zinc-900 dark:text-white">0 ms</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Best Streak</div>
            <div id="modal-streak" class="font-bold text-base text-zinc-900 dark:text-white">0</div>
          </div>
        </div>

        <!-- Personal Best Alert -->
        <div id="modal-best-alert" class="hidden mb-5 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-semibold">
          New Personal Best Record!
        </div>

        <!-- Scientific Attribution Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-heading">Scientific Paradigm:</span>
          Based on Classical Inductive Series Completion paradigms (Spearman, 1923; Cattell, 1971). Assesses fluid intelligence (Gf), mathematical rule induction, and abstract pattern extrapolation.
        </div>

        <!-- Scoring Formula Breakdown Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed font-mono">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-sans">Scoring Formula:</span>
          Score = (Inductive Accuracy * 75) + Speed Deduction Bonus (up to 25 pts for median time &lt; 2s)
        </div>

        <!-- Practice Effects Disclaimer -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-5 text-[11px] text-zinc-500 dark:text-zinc-400 italic leading-relaxed">
          Performance scores reflect task-specific operational fluency and response speed under practice effects, not innate general intelligence (g). Repeated drills refine cognitive agility.
        </div>

        <div class="flex items-center gap-3">
          <button
            id="btn-modal-restart"
            type="button"
            class="flex-1 min-h-[44px] py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-sm transition-all duration-150 hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
          >
            Play Again
          </button>
          <a
            href="/games"
            class="px-5 min-h-[44px] flex items-center justify-center rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-colors"
          >
            Hub
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Guide & Cognitive Science Section (Crawler Visible) -->
    <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-peach mb-2">
          CHC Broad Ability: Fluid Reasoning (Gf) &amp; Quantitative Induction (Gq)
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          Number Series: Inductive Logic &amp; Pattern Extrapolation
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Number series completion is one of the classic psychometric subtests used to assess non-verbal fluid intelligence (Gf) and inductive reasoning. The test-taker must infer the implicit transformation rule governing a sequence of elements and deduce the missing successor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            1. Core Sequence Rules
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Series involve constant differences, geometric multipliers, alternating dual-interleaved progressions, Fibonacci recursive sums, and two-tier differences (differences between differences).
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            2. How to Play &amp; Scoring
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Examine the displayed sequence, determine the underlying rule, and select the correct option from the 4 choices within the per-item time limit. Build consecutive streaks for score bonuses.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            3. Psychometric Grounding
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Inductive series completion has been a core pillar of psychometrics since Charles Spearman (1904) and L.L. Thurstone's Primary Mental Abilities (1938), exhibiting exceptionally high correlation with general cognitive factor (<em>g</em>).
          </p>
        </div>
      </div>

      <!-- Psychometric Disclaimer Callout -->
      <div class="p-4 sm:p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs sm:text-sm text-amber-900 dark:text-amber-300 leading-relaxed">
        <strong>Important Psychometric Note:</strong> Sequence Rush evaluates inductive series speed and pattern induction under practice conditions. It does not provide an official clinical IQ score or replace a full psychometric assessment.
      </div>

      <!-- Cross Links -->
      <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
            Looking for a Full Inductive Reasoning Assessment?
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            Test your Fluid Reasoning, Visual-Spatial, Quantitative, and Verbal abilities with our 24-question test.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a href="/quantitative-reasoning-test" class="px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-300 transition-colors">Quantitative Subtest</a>
          <a href="/test" class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-colors shadow-xs">Full 20m Exam</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { saveGameRecord, getPerformanceTier } from '../../utils/profileStore';

  const STORAGE_KEY = 'fiq_game_sequencerush_best';
  const TOTAL_ITEMS = 15;

  interface SequencePuzzle {
    category: string;
    sequence: string[];
    correct: string;
    options: string[];
    rule: string;
  }

  // Pre-generated rich bank of 36 sequence puzzles across 4 families
  const PUZZLE_BANK: SequencePuzzle[] = [
    // Family 1: Arithmetic & Polynomial Progressions
    { category: 'Arithmetic (+5)', sequence: ['4', '9', '14', '19'], correct: '24', options: ['23', '24', '25', '29'], rule: 'Add 5 each step (+5)' },
    { category: 'Geometric (*2)', sequence: ['3', '6', '12', '24'], correct: '48', options: ['36', '46', '48', '52'], rule: 'Double the prior value (*2)' },
    { category: 'Quadratic (n^2)', sequence: ['1', '4', '9', '16', '25'], correct: '36', options: ['32', '35', '36', '49'], rule: 'Sequential square numbers (1^2, 2^2, 3^2...)' },
    { category: 'Arithmetic (+7)', sequence: ['5', '12', '19', '26'], correct: '33', options: ['31', '33', '35', '37'], rule: 'Add 7 each step (+7)' },
    { category: 'Geometric (/3)', sequence: ['81', '27', '9', '3'], correct: '1', options: ['0', '1', '2', '3'], rule: 'Divide by 3 each step (/3)' },
    { category: 'Escalating Delta', sequence: ['5', '11', '18', '26'], correct: '35', options: ['33', '34', '35', '36'], rule: 'Differences increase: +6, +7, +8, +9' },
    { category: 'Arithmetic (-6)', sequence: ['48', '42', '36', '30'], correct: '24', options: ['22', '24', '26', '28'], rule: 'Subtract 6 each step (-6)' },
    { category: 'Cube Numbers', sequence: ['1', '8', '27', '64'], correct: '125', options: ['100', '112', '125', '216'], rule: 'Sequential cubes (1^3, 2^3, 3^3, 4^3, 5^3)' },
    { category: 'Triangular Numbers', sequence: ['1', '3', '6', '10', '15'], correct: '21', options: ['18', '20', '21', '25'], rule: 'Add escalating integer (+2, +3, +4, +5, +6)' },

    // Family 2: Alternating & Interleaved Series
    { category: 'Interleaved Series', sequence: ['2', '10', '4', '12', '6'], correct: '14', options: ['10', '12', '14', '16'], rule: 'Two series interleaved: 2,4,6... and 10,12,14...' },
    { category: 'Decreasing Delta', sequence: ['20', '19', '17', '14', '10'], correct: '5', options: ['4', '5', '6', '7'], rule: 'Differences decrease: -1, -2, -3, -4, -5' },
    { category: 'Alternating Operations', sequence: ['3', '6', '9', '18', '21'], correct: '42', options: ['24', '36', '42', '45'], rule: 'Alternating (*2) and (+3): 3*2=6, 6+3=9, 9*2=18, 18+3=21, 21*2=42' },
    { category: 'Alternating Shift', sequence: ['50', '45', '48', '43', '46'], correct: '41', options: ['39', '40', '41', '44'], rule: 'Alternating -5 then +3' },
    { category: 'Decreasing Reduction', sequence: ['100', '90', '81', '73', '66'], correct: '60', options: ['58', '59', '60', '61'], rule: 'Differences: -10, -9, -8, -7, -6' },
    { category: 'Interleaved Powers', sequence: ['1', '10', '2', '20', '4', '40'], correct: '8', options: ['6', '8', '16', '50'], rule: 'Series 1 doubles (1,2,4,8); Series 2 scales (10,20,40)' },
    { category: 'Alternating Polarity', sequence: ['10', '14', '8', '16', '6'], correct: '18', options: ['14', '16', '18', '20'], rule: 'Alternating +/- deltas: +4, -6, +8, -10, +12' },
    { category: 'Step Mirroring', sequence: ['12', '24', '20', '40', '36'], correct: '72', options: ['64', '68', '72', '80'], rule: 'Pattern: *2, -4, *2, -4, *2' },
    { category: 'Double Step Interval', sequence: ['1', '5', '2', '6', '3', '7'], correct: '4', options: ['3', '4', '8', '9'], rule: 'Interleaved +1 series: 1, 2, 3, 4' },

    // Family 3: Fibonacci & Recursive Patterns
    { category: 'Fibonacci Series', sequence: ['1', '2', '3', '5', '8', '13'], correct: '21', options: ['18', '20', '21', '24'], rule: 'Sum of previous two numbers (8 + 13 = 21)' },
    { category: 'Offset Fibonacci', sequence: ['2', '3', '5', '8', '13', '21'], correct: '34', options: ['29', '32', '34', '36'], rule: 'Sum of previous two numbers (13 + 21 = 34)' },
    { category: 'Multiplicative Chain', sequence: ['2', '3', '6', '18'], correct: '108', options: ['72', '96', '108', '124'], rule: 'Product of previous two numbers (6 * 18 = 108)' },
    { category: 'Lucas Sequence', sequence: ['1', '3', '4', '7', '11', '18'], correct: '29', options: ['25', '27', '29', '31'], rule: 'Sum of previous two (11 + 18 = 29)' },
    { category: 'Additive Prior Pair', sequence: ['3', '4', '7', '11', '18'], correct: '29', options: ['26', '28', '29', '32'], rule: 'Sum of previous two (11 + 18 = 29)' },
    { category: 'Sum Plus One', sequence: ['1', '2', '4', '7', '12', '20'], correct: '33', options: ['29', '31', '33', '35'], rule: 'Sum of previous two plus 1: 12 + 20 + 1 = 33' },
    { category: 'Doubling Accumulator', sequence: ['2', '4', '8', '16', '32'], correct: '64', options: ['48', '56', '64', '72'], rule: 'Multiply by 2 each term' },
    { category: 'Difference Multiplier', sequence: ['1', '2', '5', '14', '41'], correct: '122', options: ['82', '108', '122', '135'], rule: 'Differences multiply by 3: +1, +3, +9, +27, +81' },
    { category: 'Recursive Sum Trio', sequence: ['1', '1', '2', '4', '7', '13'], correct: '24', options: ['20', '22', '24', '26'], rule: 'Sum of previous three numbers (4 + 7 + 13 = 24)' },

    // Family 4: Alphabetical Coordinate Jumps
    { category: 'Escalating Letters', sequence: ['A', 'C', 'F', 'J'], correct: 'O', options: ['M', 'N', 'O', 'P'], rule: 'Letter jumps scale: +2, +3, +4, +5 steps (J + 5 = O)' },
    { category: 'Letter Step (-2)', sequence: ['Z', 'X', 'V', 'T'], correct: 'R', options: ['P', 'Q', 'R', 'S'], rule: 'Step backward 2 alphabet letters each time' },
    { category: 'Letter Step (+3)', sequence: ['B', 'E', 'H', 'K'], correct: 'N', options: ['M', 'N', 'O', 'P'], rule: 'Step forward 3 letters (K + 3 = N)' },
    { category: 'Square Alphabet Pos', sequence: ['A', 'D', 'I', 'P'], correct: 'Y', options: ['U', 'V', 'W', 'Y'], rule: 'Alphabet square indices: 1(A), 4(D), 9(I), 16(P), 25(Y)' },
    { category: 'Letter Step (+3)', sequence: ['C', 'F', 'I', 'L'], correct: 'O', options: ['M', 'N', 'O', 'R'], rule: 'Step forward 3 letters (L + 3 = O)' },
    { category: 'Reverse Steps', sequence: ['Y', 'W', 'U', 'S'], correct: 'Q', options: ['P', 'Q', 'R', 'T'], rule: 'Step backward 2 letters (S - 2 = Q)' },
    { category: 'Fibonacci Letters', sequence: ['A', 'A', 'B', 'C', 'E', 'H'], correct: 'M', options: ['K', 'L', 'M', 'N'], rule: 'Alphabet positions follow Fibonacci: 1, 1, 2, 3, 5, 8, 13(M)' },
    { category: 'Alternating Letters', sequence: ['A', 'Z', 'B', 'Y', 'C'], correct: 'X', options: ['U', 'V', 'W', 'X'], rule: 'Alternating from start and end of alphabet' },
    { category: 'Skip Escalation', sequence: ['D', 'F', 'I', 'M'], correct: 'R', options: ['P', 'Q', 'R', 'S'], rule: 'Differences increase: +2, +3, +4, +5 steps (M + 5 = R)' },
  ];

  function selectRandom15(): SequencePuzzle[] {
    const shuffled = [...PUZZLE_BANK];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled.slice(0, TOTAL_ITEMS);
  }

  let sessionPuzzles: SequencePuzzle[] = [];
  let currentIndex = 0;
  let correctCount = 0;
  let errorCount = 0;
  let currentStreak = 0;
  let longestStreak = 0;
  let sessionStartTime = 0;
  let itemStartTime = 0;
  let isAwaitingAnswer = false;
  let isGameActive = false;

  const latencies: number[] = [];
  let timerInterval: number = 0;

  // Audio Context (pure Web Audio)
  let audioCtx: AudioContext | null = null;
  function playTone(freq: number, duration: number) {
    try {
      if (!audioCtx) {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) audioCtx = new AudioCtx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      if (audioCtx) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      }
    } catch {}
  }

  function calculateMedian(arr: number[]): number {
    if (arr.length === 0) return 0;
    const sorted = [...arr].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    return sorted.length % 2 !== 0
      ? sorted[mid]
      : Math.round((sorted[mid - 1] + sorted[mid]) / 2);
  }

  // DOM Elements
  const hudItem = document.getElementById('hud-item') as HTMLElement;
  const hudScore = document.getElementById('hud-score') as HTMLElement;
  const hudPace = document.getElementById('hud-pace') as HTMLElement;
  const hudBest = document.getElementById('hud-best') as HTMLElement;

  const startOverlay = document.getElementById('start-overlay') as HTMLElement;
  const btnStartGame = document.getElementById('btn-start-game') as HTMLButtonElement;
  const gameArenaContent = document.getElementById('game-arena-content') as HTMLElement;

  const familyBadge = document.getElementById('family-badge') as HTMLElement;
  const itemTimer = document.getElementById('item-timer') as HTMLElement;
  const seriesProgress = document.getElementById('series-progress') as HTMLElement;
  const sequenceContainer = document.getElementById('sequence-container') as HTMLElement;
  const feedbackMessage = document.getElementById('feedback-message') as HTMLElement;
  const optionsGrid = document.getElementById('options-grid') as HTMLElement;

  // Modal elements
  const btnHowToPlay = document.getElementById('btn-how-to-play') as HTMLButtonElement;
  const modalHowToPlay = document.getElementById('modal-how-to-play') as HTMLElement;
  const btnCloseHowModal = document.getElementById('btn-close-how-modal') as HTMLButtonElement;
  const btnConfirmHow = document.getElementById('btn-confirm-how') as HTMLButtonElement;

  const modalEndRound = document.getElementById('modal-end-round') as HTMLElement;
  const btnCloseEndModal = document.getElementById('btn-close-end-modal') as HTMLButtonElement;
  const modalScore = document.getElementById('modal-score') as HTMLElement;
  const modalTierBadge = document.getElementById('modal-tier-badge') as HTMLElement;
  const modalTierDesc = document.getElementById('modal-tier-desc') as HTMLElement;
  const modalSolved = document.getElementById('modal-solved') as HTMLElement;
  const modalAcc = document.getElementById('modal-acc') as HTMLElement;
  const modalPace = document.getElementById('modal-pace') as HTMLElement;
  const modalStreak = document.getElementById('modal-streak') as HTMLElement;
  const modalBestAlert = document.getElementById('modal-best-alert') as HTMLElement;
  const btnModalRestart = document.getElementById('btn-modal-restart') as HTMLButtonElement;

  function loadBestScore() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && hudBest) {
        hudBest.textContent = saved;
      }
    } catch {}
  }
  loadBestScore();

  function updateHUD() {
    hudItem.textContent = `${currentIndex} / ${TOTAL_ITEMS}`;
    seriesProgress.style.width = `${Math.round((currentIndex / TOTAL_ITEMS) * 100)}%`;

    const medianRT = calculateMedian(latencies);
    hudPace.textContent = medianRT > 0 ? `${(medianRT / 1000).toFixed(1)} s` : '-- s';

    const accuracyScore = Math.round((correctCount / TOTAL_ITEMS) * 75);
    const speedBonus = medianRT > 0 ? Math.max(0, Math.min(25, Math.round((9000 - medianRT) / 280))) : 0;
    hudScore.textContent = String(accuracyScore + speedBonus);
  }

  function renderCurrentPuzzle() {
    if (currentIndex >= TOTAL_ITEMS) {
      endGame();
      return;
    }

    isAwaitingAnswer = true;
    updateHUD();

    const puzzle = sessionPuzzles[currentIndex];
    familyBadge.textContent = `Category: ${puzzle.category}`;
    feedbackMessage.textContent = 'Identify the governing pattern and select the missing term:';

    // Render sequence pills + missing [ ? ] badge
    sequenceContainer.innerHTML = '';
    puzzle.sequence.forEach((val) => {
      const pill = document.createElement('div');
      pill.className = 'px-4 py-2.5 rounded-2xl bg-white dark:bg-zinc-700/80 border border-zinc-200 dark:border-zinc-600 font-mono font-bold text-lg sm:text-2xl text-zinc-900 dark:text-white shadow-xs';
      pill.textContent = val;
      sequenceContainer.appendChild(pill);
    });

    // The Missing term card [ ? ]
    const missingSlot = document.createElement('div');
    missingSlot.className = 'px-4 py-2.5 rounded-2xl bg-indigo-50 dark:bg-indigo-950/60 border-2 border-indigo-500 font-mono font-extrabold text-lg sm:text-2xl text-indigo-600 dark:text-indigo-400 shadow-sm animate-pulse';
    missingSlot.textContent = '?';
    sequenceContainer.appendChild(missingSlot);

    // Shuffle options for this item
    const shuffledOptions = [...puzzle.options];
    for (let i = shuffledOptions.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffledOptions[i], shuffledOptions[j]] = [shuffledOptions[j], shuffledOptions[i]];
    }

    const keyLabels = ['1 (A)', '2 (B)', '3 (C)', '4 (D)'];
    optionsGrid.innerHTML = '';

    shuffledOptions.forEach((opt, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'option-btn min-h-[52px] py-3 px-4 rounded-2xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-white font-mono font-bold text-base flex items-center justify-between transition-all duration-150 active:scale-98 cursor-pointer';
      btn.setAttribute('data-val', opt);

      btn.innerHTML = `
        <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 uppercase">${keyLabels[idx]}</span>
        <span class="text-lg font-mono font-extrabold text-zinc-950 dark:text-white">${opt}</span>
        <span class="w-4"></span>
      `;

      btn.addEventListener('click', () => handleSelectOption(opt, btn));
      optionsGrid.appendChild(btn);
    });

    itemStartTime = performance.now();
  }

  async function handleSelectOption(chosenVal: string, btnElement?: HTMLElement) {
    if (!isAwaitingAnswer || !isGameActive) return;
    isAwaitingAnswer = false;

    const latency = Math.round(performance.now() - itemStartTime);
    latencies.push(latency);

    const puzzle = sessionPuzzles[currentIndex];
    const isCorrect = chosenVal === puzzle.correct;

    if (btnElement) {
      if (isCorrect) {
        btnElement.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'border-zinc-200', 'dark:border-zinc-700');
        btnElement.classList.add('bg-emerald-500', 'border-emerald-600', 'text-white');
      } else {
        btnElement.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'border-zinc-200', 'dark:border-zinc-700');
        btnElement.classList.add('bg-rose-500', 'border-rose-600', 'text-white');
      }
    }

    if (isCorrect) {
      correctCount++;
      currentStreak++;
      longestStreak = Math.max(longestStreak, currentStreak);
      feedbackMessage.textContent = `Correct! ${puzzle.rule}`;
      playTone(660, 0.08);
      setTimeout(() => playTone(880, 0.12), 90);
    } else {
      errorCount++;
      currentStreak = 0;
      feedbackMessage.textContent = `Incorrect! Answer: ${puzzle.correct} (${puzzle.rule})`;
      playTone(280, 0.16);
    }

    currentIndex++;
    await new Promise((resolve) => setTimeout(resolve, 450));
    renderCurrentPuzzle();
  }

  function endGame() {
    isGameActive = false;
    clearInterval(timerInterval);
    const sessionDurationSec = Math.max(1, Math.round((Date.now() - sessionStartTime) / 1000));

    const accuracy = correctCount / TOTAL_ITEMS;
    const medianRT = calculateMedian(latencies);

    // Formula:
    // Accuracy accounts for 75 points
    const accuracyScore = Math.round((correctCount / TOTAL_ITEMS) * 75);
    // Speed bonus up to 25 pts for median RT < 2000ms
    const speedBonus = Math.max(0, Math.min(25, Math.round((9000 - medianRT) / 280)));
    const performanceScore = Math.min(100, Math.max(0, accuracyScore + speedBonus));

    // Save record to profileStore
    saveGameRecord({
      gameId: 'sequence-rush',
      durationSeconds: sessionDurationSec,
      mode: 'standard',
      metrics: {
        performanceScore,
        accuracy: Number(accuracy.toFixed(2)),
        trialsCompleted: TOTAL_ITEMS,
        correctCount,
        errorCount,
        medianRT: Math.round(medianRT),
        bestStreak: longestStreak,
      },
    });

    // Check personal best
    let isNewBest = false;
    try {
      const saved = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
      if (performanceScore > saved) {
        localStorage.setItem(STORAGE_KEY, String(performanceScore));
        isNewBest = true;
      }
    } catch {}
    loadBestScore();

    // Populate End Modal
    modalScore.textContent = String(performanceScore);
    const tierInfo = getPerformanceTier(performanceScore);
    modalTierBadge.textContent = tierInfo.tier;
    modalTierBadge.className = `inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${tierInfo.badgeClass}`;
    modalTierDesc.textContent = tierInfo.description;

    modalSolved.textContent = `${correctCount} / ${TOTAL_ITEMS}`;
    modalAcc.textContent = `${Math.round(accuracy * 100)}%`;
    modalPace.textContent = `${medianRT} ms`;
    modalStreak.textContent = String(longestStreak);

    if (isNewBest) {
      modalBestAlert.classList.remove('hidden');
    } else {
      modalBestAlert.classList.add('hidden');
    }

    modalEndRound.classList.remove('hidden');
  }

  function startGame() {
    isGameActive = true;
    sessionStartTime = Date.now();
    currentIndex = 0;
    correctCount = 0;
    errorCount = 0;
    currentStreak = 0;
    longestStreak = 0;
    latencies.length = 0;

    sessionPuzzles = selectRandom15();

    startOverlay.classList.add('hidden');
    gameArenaContent.removeAttribute('inert');
    modalEndRound.classList.add('hidden');

    clearInterval(timerInterval);
    timerInterval = window.setInterval(() => {
      if (isGameActive && isAwaitingAnswer) {
        const elapsed = (performance.now() - itemStartTime) / 1000;
        itemTimer.textContent = `${elapsed.toFixed(1)}s`;
      }
    }, 100);

    renderCurrentPuzzle();
  }

  btnStartGame.addEventListener('click', startGame);

  // Physical Keyboard Listeners (1-4, A-D, Space)
  window.addEventListener('keydown', (e) => {
    if (e.key === ' ' && !isGameActive && modalHowToPlay.classList.contains('hidden') && modalEndRound.classList.contains('hidden')) {
      e.preventDefault();
      startGame();
      return;
    }

    if (isGameActive && isAwaitingAnswer) {
      const optionButtons = document.querySelectorAll('.option-btn') as NodeListOf<HTMLButtonElement>;
      let targetIndex = -1;

      if (e.key === '1' || e.key === 'a' || e.key === 'A') targetIndex = 0;
      else if (e.key === '2' || e.key === 'b' || e.key === 'B') targetIndex = 1;
      else if (e.key === '3' || e.key === 'c' || e.key === 'C') targetIndex = 2;
      else if (e.key === '4' || e.key === 'd' || e.key === 'D') targetIndex = 3;

      if (targetIndex >= 0 && targetIndex < optionButtons.length) {
        e.preventDefault();
        const btn = optionButtons[targetIndex];
        const val = btn.getAttribute('data-val');
        if (val) handleSelectOption(val, btn);
      }
    }

    if (e.key === 'Escape') {
      if (!modalHowToPlay.classList.contains('hidden')) {
        modalHowToPlay.classList.add('hidden');
      }
      if (!modalEndRound.classList.contains('hidden')) {
        modalEndRound.classList.add('hidden');
      }
    }
  });

  // How to Play Modal Listeners
  btnHowToPlay.addEventListener('click', () => modalHowToPlay.classList.remove('hidden'));
  btnCloseHowModal.addEventListener('click', () => modalHowToPlay.classList.add('hidden'));
  btnConfirmHow.addEventListener('click', () => modalHowToPlay.classList.add('hidden'));

  // End Modal Listeners
  btnCloseEndModal.addEventListener('click', () => modalEndRound.classList.add('hidden'));
  btnModalRestart.addEventListener('click', () => {
    modalEndRound.classList.add('hidden');
    startGame();
  });
</script>
