---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Alternate links for future i18n releases
const alternates = {};

const title = "Free Online Hearing Test & Ear Age Calculator: Frequency Audiogram | FreeIQExam";;
const description = "Test your hearing frequency limits from 20 Hz to 20 kHz with our free online hearing test. Determine your ear age, check stereo balance, and spot high-frequency loss.";;
const canonicalUrl = "https://freeiqexam.com/hearing-test";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Clinical Pure-Tone Audiometry & Biological Ear Age Frequency Test",
    "description": "Online clinical hearing screener featuring Hughson-Westlake pure-tone audiometry (250 Hz – 8,000 Hz) and high-frequency presbycusis ear age analysis (8,000 Hz – 20,000 Hz).",
    "url": "https://freeiqexam.com/hearing-test",
    "medicalAudience": "Patient",
    "aspect": "Diagnostic"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Online Hearing Test & Ear Age Calculator",
    "url": "https://freeiqexam.com/hearing-test",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires Web Audio API support and stereo headphones",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Pure-Tone Audiometry screening (250 Hz to 8,000 Hz) with Hughson-Westlake staircase method",
      "Biological Ear Age frequency sweep (8,000 Hz to 20,000 Hz) mapping presbycusis degradation",
      "Stereo channel isolation for independent left and right ear hearing assessment",
      "Real-time interactive canvas audiogram with speech banana reference overlay",
      "Anti-popping 15ms exponential gain envelopes for acoustic transducer protection",
      "Downloadable high-resolution biological ear age certificate and clinical audiogram report",
      "Zero paywall, zero email registration, 100% private in-browser Web Audio synthesis"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.96",
      "ratingCount": "24800",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://freeiqexam.com/hearing-test"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Hearing Test & Ear Age Calculator",
        "item": "https://freeiqexam.com/hearing-test"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is an online hearing test?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Online hearing tests using the Web Audio API provide an accurate early-warning screening of hearing thresholds when taken with quality over-ear headphones in a quiet environment. While they cannot replace a formal diagnostic examination in a sound-treated booth with calibrated audiometric transducers, they reliably identify high-frequency presbycusis, asymmetric hearing loss between ears, and threshold elevations across speech frequencies (500 Hz to 4,000 Hz)."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need headphones to take this hearing test?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, stereo headphones or in-ear monitors (IEMs) are essential. Loudspeakers mix left and right audio channels acoustically in the room, making it impossible to evaluate each ear independently. Furthermore, room reflections and ambient noise distort sound pressure levels, and standard laptop speakers rapidly roll off frequencies above 10,000 Hz. For valid results, use wired headphones and disable spatial audio, surround sound, and active equalizer presets."
        }
      },
      {
        "@type": "Question",
        "name": "What is biological ear age, and how is it calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Biological ear age is an estimate of auditory wear based on your highest audible acoustic frequency. Healthy newborns possess approximately 16,000 cochlear hair cells and can hear up to 20,000 Hz. Over decades, cumulative noise exposure, microvascular changes, and mechanical stress damage stereocilia at the basal turn of the cochlea, lowering the audible ceiling: 19 kHz corresponds to under 18 years, 17 kHz to ~24 years, 15 kHz to ~34 years, 14 kHz to ~44 years, 12 kHz to ~54 years, and 8 kHz to 65+ years."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between Hertz (Hz) and Decibels (dB)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hertz (Hz) measures frequency or pitch—how rapidly sound waves oscillate each second (e.g., a low bass rumble at 250 Hz vs. a high mosquito pitch at 17,000 Hz). Decibels (dB) measure sound pressure level or loudness on a logarithmic scale. In clinical audiology, dB HL (Hearing Level) indicates the threshold of audibility relative to a young, healthy human ear (0 dB HL), where conversational speech registers between 40 and 60 dB HL."
        }
      },
      {
        "@type": "Question",
        "name": "Why can young people hear the mosquito ringtone while older adults cannot?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The mosquito tone operates at approximately 17,400 Hz (17.4 kHz). The hair cells responsible for detecting this ultra-high frequency reside at the entrance (base) of the cochlea and endure the highest fluid shear forces throughout a lifetime. By age 25, most individuals have sustained sufficient natural hair cell attrition (presbycusis) that 17.4 kHz becomes inaudible, whereas teenagers and young adults retain intact basal hair cells and easily perceive it."
        }
      },
      {
        "@type": "Question",
        "name": "What is the 'speech banana' on an audiogram?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The speech banana is a distinctive banana-shaped region plotted on a clinical audiogram spanning frequencies from 250 Hz to 6,000 Hz and intensity levels between 20 dB HL and 55 dB HL. Almost all human speech phonemes fall within this zone: low-frequency vowels (u, o, a) live between 250 and 1,000 Hz, while critical high-frequency consonants (s, f, th, k) reside above 2,000 Hz. Hearing loss entering the speech banana causes speech to sound muffled and unintelligible."
        }
      },
      {
        "@type": "Question",
        "name": "What is the WHO 60/60 safe listening rule?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The World Health Organization (WHO) 60/60 rule advises listening to personal audio devices at no more than 60% of maximum volume for no longer than 60 minutes at a stretch, followed by at least 10 to 15 minutes of acoustic rest. Adhering to this guideline prevents metabolic exhaustion and oxidative damage in cochlear hair cells, dramatically reducing the risk of noise-induced hearing loss (NIHL) and permanent tinnitus."
        }
      },
      {
        "@type": "Question",
        "name": "Can permanent hearing loss be reversed or cured?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sensorineural hearing loss—caused by destruction of cochlear hair cells or auditory nerve fibers—is currently irreversible in humans because sensory hair cells do not regenerate once lost. However, conductive hearing loss caused by cerumen impaction or middle-ear effusion can often be treated medically. Sensorineural loss can be successfully rehabilitated through modern hearing aids, frequency-lowering algorithms, or cochlear implants."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <style>
    /* Custom acoustic waveform bar animations */
    .earage-waveform {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 64px;
      margin: 24px 0;
    }

    .earage-waveform .bar {
      width: 4px;
      background: #06b6d4;
      border-radius: 9999px;
      height: 8px;
      transition: height 0.1s ease;
    }

    .earage-waveform.active .bar {
      animation: waveBar 0.8s infinite ease-in-out;
    }

    .earage-waveform.active .bar:nth-child(2) { animation-delay: 0.05s; }
    .earage-waveform.active .bar:nth-child(3) { animation-delay: 0.10s; }
    .earage-waveform.active .bar:nth-child(4) { animation-delay: 0.15s; }
    .earage-waveform.active .bar:nth-child(5) { animation-delay: 0.20s; }
    .earage-waveform.active .bar:nth-child(6) { animation-delay: 0.25s; }
    .earage-waveform.active .bar:nth-child(7) { animation-delay: 0.30s; }
    .earage-waveform.active .bar:nth-child(8) { animation-delay: 0.35s; }
    .earage-waveform.active .bar:nth-child(9) { animation-delay: 0.40s; }
    .earage-waveform.active .bar:nth-child(10) { animation-delay: 0.45s; }
    .earage-waveform.active .bar:nth-child(11) { animation-delay: 0.50s; }
    .earage-waveform.active .bar:nth-child(12) { animation-delay: 0.55s; }
    .earage-waveform.active .bar:nth-child(13) { animation-delay: 0.60s; }
    .earage-waveform.active .bar:nth-child(14) { animation-delay: 0.65s; }
    .earage-waveform.active .bar:nth-child(15) { animation-delay: 0.70s; }
    .earage-waveform.active .bar:nth-child(16) { animation-delay: 0.75s; }
    .earage-waveform.active .bar:nth-child(17) { animation-delay: 0.80s; }
    .earage-waveform.active .bar:nth-child(18) { animation-delay: 0.85s; }
    .earage-waveform.active .bar:nth-child(19) { animation-delay: 0.90s; }
    .earage-waveform.active .bar:nth-child(20) { animation-delay: 0.95s; }

    @keyframes waveBar {
      0%, 100% { height: 10px; }
      50% { height: 58px; }
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @media print {
      header, footer, #calibrationPanel, .no-print {
        display: none !important;
      }
      #resultsWrap {
        display: block !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-500 dark:text-zinc-400">Tools</span>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Hearing Test & Ear Age</span>
    </nav>

    <!-- Header & Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-200 dark:border-cyan-800 text-xs sm:text-sm font-mono font-semibold text-cyan-700 dark:text-cyan-400 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>Clinical Pure-Tone Audiometry • Biological Ear Age Sweep</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Free Online Hearing Test & Ear Age Calculator
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
        Screen your auditory acuity with clinical precision. Perform high-frequency biological ear age sweeps (8–20 kHz) or complete pure-tone audiometry (250–8,000 Hz) with independent left and right ear stereo isolation.
      </p>
    </header>

    <!-- ACOUSTIC SAFETY & CALIBRATION ADVISORY -->
    <div class="max-w-3xl mx-auto mb-10 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
        <div class="space-y-1">
          <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Acoustic Safety & Headphone Requirement</h4>
          <p class="text-amber-800 dark:text-amber-300/90 text-xs sm:text-sm leading-relaxed">
            <strong>1)</strong> Put on high-quality stereo headphones. <strong>2)</strong> Never set your system volume to maximum; start at 50% volume and use our 1,000 Hz calibration tone to confirm comfortable audibility. <strong>3)</strong> Disable spatial audio, Dolby Atmos, and equalizer presets for clinical accuracy.
          </p>
        </div>
      </div>
    </div>

    <!-- TESTING ARENA -->
    <section id="test-arena" class="relative w-full max-w-4xl mx-auto mb-16 scroll-mt-6">
      
      <!-- MODE SELECTOR CARDS -->
      <div id="modeSelector" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Ear Age Test -->
        <button
          type="button"
          data-mode="ear-age"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              High-Frequency Sweep (8–20 kHz)
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Biological Ear Age Test
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Find the highest frequency your ears can detect. Maps your acoustic cutoff against epidemiological presbycusis data to calculate biological auditory age.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Duration: ~60 Seconds</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Start Ear Age Test →
            </span>
          </div>
        </button>

        <!-- Card 2: Pure-Tone Audiometry -->
        <button
          type="button"
          data-mode="audiometry"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              Clinical Hughson-Westlake Protocol
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Pure-Tone Audiometry
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Standard clinical screening evaluating 250 Hz to 8,000 Hz independently in your left and right ears. Plots an official audiogram against normal hearing thresholds.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Duration: ~3 Minutes</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Start Audiometry →
            </span>
          </div>
        </button>
      </div>

      <!-- ACTIVE WORKSPACE WRAPPER -->
      <div id="workspace" class="hidden rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl">
        <!-- Workspace Header Status -->
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
            <h2 id="workspaceTitle" class="font-heading font-bold text-lg sm:text-xl text-zinc-900 dark:text-white">
              Acoustic Testing
            </h2>
          </div>
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Step <span id="stepNum" class="font-bold text-cyan-600 dark:text-cyan-400">1</span> of 3
          </div>
        </div>

        <!-- STEP 1: CALIBRATION PANEL -->
        <div id="calibrationPanel" class="max-w-xl mx-auto text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center" aria-hidden="true">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white">
              Reference Volume Calibration
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              We play a safe 1,000 Hz reference tone. Adjust your system volume until the sound is clearly audible, comfortable, and not uncomfortably loud.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 space-y-4">
            <div class="flex items-center justify-between text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400">
              <span>Calibration Level</span>
              <span id="calibDbDisplay" class="text-cyan-600 dark:text-cyan-400 font-bold">40 dB HL</span>
            </div>
            <input
              id="calibSlider"
              type="range"
              min="20"
              max="80"
              step="5"
              value="40"
              class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
            />
            <div class="flex gap-3 justify-center pt-2">
              <button
                id="calibPlayBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor" /></svg> Test Tone (1 kHz)
              </button>
              <button
                id="calibStopBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" /></svg> Stop
              </button>
            </div>
          </div>

          <button
            id="startTestBtn"
            type="button"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-heading font-bold text-base shadow-lg hover:shadow-cyan-500/25 transition-all cursor-pointer inline-flex items-center justify-center gap-2"
          >
            <span>Volume Is Set · Begin Test</span>
            <span>→</span>
          </button>
        </div>

        <!-- STEP 2A: BIOLOGICAL EAR AGE PANEL -->
        <div id="earAgePanel" class="hidden max-w-xl mx-auto text-center space-y-6">
          <div class="space-y-1">
            <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Current Frequency Tone</div>
            <div class="flex items-baseline justify-center gap-2 font-mono font-extrabold text-5xl sm:text-6xl text-cyan-600 dark:text-cyan-400 tracking-tight">
              <span id="earAgeFreq">20,000</span>
              <span class="text-2xl text-zinc-400 font-bold">Hz</span>
            </div>
            <p id="earAgeStatus" class="text-sm text-zinc-600 dark:text-zinc-400 pt-1">
              Listen carefully. Can you hear this high-frequency pitch?
            </p>
          </div>

          <!-- Animated Sound Waveform -->
          <div class="earage-waveform active" id="earAgeWave">
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-zinc-100 dark:bg-zinc-800/80 rounded-full h-2 overflow-hidden">
            <div id="earAgeProgress" class="bg-cyan-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>

          <!-- Tactile Responses -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <button
              id="earAgeHearBtn"
              type="button"
