---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "High IQ Societies Guide: Mensa, Intertel, Triple Nine & Cutoffs | FreeIQExam";;
const description = "Comprehensive directory of recognized high-IQ societies: Mensa (top 2%), Intertel (top 1%), Triple Nine Society (top 0.1%), and Prometheus. Review admission cutoffs and verified tests.";;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "High IQ Societies Guide: Mensa, Intertel, Triple Nine and Admission Cutoffs",
    "description": "In-depth psychometric analysis of international high-IQ societies, admission percentiles, accepted prior evidence tests, and preparation strategies.",
    "url": "https://freeiqexam.com/high-iq-societies/",
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam",
      "url": "https://freeiqexam.com/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "High IQ Societies",
        "item": "https://freeiqexam.com/high-iq-societies/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What IQ score is required to join Mensa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mensa membership requires scoring at or above the 98th percentile on an approved, supervised intelligence exam. On standard psychometric scales using a standard deviation of 15 (such as the WAIS-IV), this corresponds to an IQ score of 130 or higher. On scales using a standard deviation of 16 (Stanford-Binet), the threshold is 132, and on Cattell scales with SD 24, the threshold is 148."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between Mensa, Intertel, and Triple Nine Society?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The primary difference is the selectivity threshold: Mensa accepts the top 2 percent (98th percentile, IQ 130+ on SD 15); Intertel accepts the top 1 percent (99th percentile, IQ 135+ on SD 15); and the Triple Nine Society accepts the top 0.1 percent (99.9th percentile, IQ 146+ on SD 15)."
        }
      },
      {
        "@type": "Question",
        "name": "Can historical SAT or ACT test scores be used to join Mensa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, through prior evidence rules. American Mensa accepts qualifying scores on historical college entrance exams taken before specific dates, including the SAT taken before April 1995 (minimum 1250 verbal plus math, or 1300 before September 1974), the GRE taken before October 2001 (minimum 1250 combined), and the ACT taken before September 1989 (composite score of 29 or higher)."
        }
      },
      {
        "@type": "Question",
        "name": "What is the rarest and most selective high IQ society in the world?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Prometheus Society requires scoring at the 99.997th percentile (IQ 160 on SD 15, representing 1 in 30,000 individuals). Even more selective is the Mega Society, which requires the 99.9999th percentile (IQ 171 on SD 15, or roughly 1 in 1,000,000 individuals), though measuring at such extreme ceilings carries significant psychometric measurement challenges."
        }
      },
      {
        "@type": "Question",
        "name": "Can an online IQ test qualify someone for Mensa membership?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No unproctored online test qualifies directly for official high-IQ society membership. Formal admission requires either sitting for an in-person, proctored admissions battery administered by Mensa or a certified psychologist, or submitting verified transcripts from recognized clinical or academic standardized examinations."
        }
      },
      {
        "@type": "Question",
        "name": "Who has the highest IQ ever recorded in history?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Historical figures like child prodigy William James Sidis (speculated 250–300) and Marilyn vos Savant (recorded 228 on a childhood Binet-ratio scale) are commonly cited. Among living mathematicians, Terence Tao has estimated scores around 225-230. However, modern adult deviation IQ tests (WAIS-IV) possess a statistical ceiling of 160 (+4.00 standard deviations). Psychometricians consider scores above 160 to be statistical extrapolations rather than standardized experimental measures."
        }
      },
      {
        "@type": "Question",
        "name": "Are online celebrity and billionaire IQ scores (Elon Musk, Bill Gates) real?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Online claims that Elon Musk has an IQ of 155, Bill Gates 160, or Mark Zuckerberg 152 are speculative estimates derived from historical SAT/GRE scores or biographical achievements. Official clinical IQ scores are confidential educational and medical records protected by privacy laws, and none of these figures have ever published an official, proctored neuropsychological evaluation."
        }
      }
    ]
  }
];

const societies = [
  {
    name: "Mensa International",
    founded: "1946",
    percentile: "98th Percentile (Top 2%)",
    rarity: "1 in 50",
    sd15: "130",
    sd16: "132",
    sd24: "148",
    members: "~145,000 worldwide",
    focus: "Social exchange, special interest groups, and community for intellectual peers.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Intertel",
    founded: "1966",
    percentile: "99th Percentile (Top 1%)",
    rarity: "1 in 100",
    sd15: "135",
    sd16: "137",
    sd24: "156",
    members: "~1,700 worldwide",
    focus: "Intellectual camaraderie, global regional assemblies, and the journal Integra.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Colloquy Society",
    founded: "2000",
    percentile: "99.5th Percentile (Top 0.5%)",
    rarity: "1 in 200",
    sd15: "140",
    sd16: "143",
    sd24: "164",
    members: "~500 worldwide",
    focus: "Online philosophical dialogue, interdisciplinary arts, and scientific debate.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Triple Nine Society (TNS)",
    founded: "1978",
    percentile: "99.9th Percentile (Top 0.1%)",
    rarity: "1 in 1,000",
    sd15: "146",
    sd16: "149",
    sd24: "174",
    members: "~1,900 worldwide",
    focus: "Deep academic exchange, libertarian free expression, and the Vidya journal.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Prometheus Society",
    founded: "1982",
    percentile: "99.997th Percentile (Top 0.003%)",
    rarity: "1 in 33,333",
    sd15: "160",
    sd16: "164",
    sd24: "196",
    members: "~120 worldwide",
    focus: "High-ceiling psychometrics, theoretical philosophy, and gift of genius discourse.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  }
];

const priorEvidenceTests = [
  {
    exam: "SAT (Scholastic Assessment Test)",
    period: "Prior to April 1995",
    mensaCutoff: "1250 (Verbal + Math)",
    tnsCutoff: "1450 (prior to 1995)",
    notes: "Post-1995 recentered SAT exams are not accepted due to reduced general intelligence (g-factor) saturation."
  },
  {
    exam: "GRE (Graduate Record Exam)",
    period: "Prior to October 2001",
    mensaCutoff: "1250 (Verbal + Quantitative)",
    tnsCutoff: "1450 (prior to 2001)",
    notes: "The current GRE scoring scale (130-170) is no longer accepted for prior evidence entry."
  },
  {
    exam: "ACT Assessment",
    period: "Prior to September 1989",
    mensaCutoff: "Composite score of 29",
    tnsCutoff: "Composite score of 32",
    notes: "Post-1989 Enhanced ACT tests are not accepted because format changes altered statistical norms."
  },
  {
    exam: "Miller Analogies Test (MAT)",
    period: "All historical test periods",
    mensaCutoff: "Raw score 66 (pre-2004) / Scaled 422",
    tnsCutoff: "Raw score 85 (pre-2004) / Scaled 472",
    notes: "High correlation with verbal fluid reasoning and associative cognitive retrieval."
  },
  {
    exam: "WAIS-IV / WISC-V (Wechsler Batteries)",
    period: "Current clinical standard",
    mensaCutoff: "Full Scale IQ 130+",
    tnsCutoff: "Full Scale IQ 146+",
    notes: "Requires supervised administration and formal report signed by a licensed clinical psychologist."
  },
  {
    exam: "Stanford-Binet 5",
    period: "Current standard (SD 15)",
    mensaCutoff: "Composite IQ 130+",
    tnsCutoff: "Composite IQ 146+",
    notes: "Historical Stanford-Binet Form L-M utilized SD 16 (Mensa threshold was 132, TNS was 149)."
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/high-iq-societies" />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 -mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-white font-medium">High IQ Societies Guide</span>
    </nav>

    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>Membership Cutoffs &bull; Psychometric Admission Criteria</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        High-IQ Societies: Cutoffs, Admission Rules &amp; Qualifying Tests
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Explore international high-IQ societies from Mensa to Prometheus. Compare qualifying thresholds across standard deviation scales, accepted historical prior evidence, and psychometric screening methods.
      </p>
    </header>

    <!-- Interactive Society Eligibility Checker (Above the Fold) -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs max-w-2xl mx-auto w-full">
      <div class="text-center mb-6">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
          Interactive Evaluation Widget
        </span>
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Check High-IQ Society Eligibility
        </h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          Select an IQ score on the standard Wechsler scale (SD 15) to see which high-IQ societies you qualify for.
        </p>
      </div>

      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="society-score-input" class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white">
              Selected IQ Score (SD 15)
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Scale: 115 to 165+</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="society-score-slider"
              type="range"
              min="115"
              max="165"
              value="132"
              aria-label="IQ Score Slider"
              class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-blue-600 min-h-[44px]"
            />
            <input
              id="society-score-input"
              type="number"
              min="115"
              max="165"
              value="132"
              aria-label="IQ Score Input"
              class="w-16 px-2 py-1 text-center font-mono font-bold text-sm bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-lg text-zinc-950 dark:text-white focus:outline-none focus:border-blue-500"
            />
          </div>
        </div>

        <!-- Dynamic Society Status Output -->
        <div id="eligibility-results" role="status" aria-live="polite" class="p-5 rounded-2xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/80 space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-700/60 pb-3">
            <div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">Theoretical Percentile</div>
              <div id="display-percentile" class="font-heading font-extrabold text-xl text-zinc-900 dark:text-white">98.3th Percentile</div>
            </div>
            <div class="text-right">
              <div class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">Population Frequency</div>
              <div id="display-frequency" class="font-heading font-extrabold text-xl text-blue-600 dark:text-blue-400">1 in 59 people</div>
            </div>
          </div>

          <div>
            <div class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">
              Society Qualifications
            </div>
            <ul id="society-badges-list" class="space-y-2 text-xs font-medium">
              <!-- Rendered via JS -->
            </ul>
          </div>
        </div>

        <!-- Callout Action inside widget -->
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a
            href="/mensa-iq-test-practice"
            class="flex-1 text-center py-2.5 px-4 rounded-xl text-xs font-semibold bg-blue-600 text-white hover:bg-blue-500 transition-colors shadow-sm"
          >
            Mensa-Style Practice Drills
          </a>
          <a
            href="/test"
            class="flex-1 text-center py-2.5 px-4 rounded-xl text-xs font-semibold bg-zinc-900 dark:bg-zinc-800 text-white hover:bg-zinc-800 dark:hover:bg-zinc-700 border border-zinc-800 dark:border-zinc-700 transition-colors"
          >
            Take 24-Item Full Battery
          </a>
        </div>
      </div>
    </section>

    <!-- Master High-IQ Societies Comparison Table -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-zinc-200 dark:border-zinc-800 pb-3">
        <div>
          <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white">
            Major International High-IQ Societies Overview
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Cutoff thresholds across standard psychometric deviations (Wechsler SD 15, Stanford-Binet SD 16, and Cattell SD 24).
          </p>
        </div>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Updated for 2026</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[640px] text-left text-sm border-collapse">
          <thead class="sticky top-0 bg-zinc-50/95 dark:bg-zinc-900/95 backdrop-blur-sm z-10 text-zinc-600 dark:text-zinc-300 font-mono text-xs border-b border-zinc-200 dark:border-zinc-800">
            <tr>
              <th class="p-3.5 sm:p-4">Society Name</th>
              <th class="p-3.5 sm:p-4">Percentile Cutoff</th>
              <th class="p-3.5 sm:p-4">Rarity in Population</th>
              <th class="p-3.5 sm:p-4 text-center">IQ (SD 15)</th>
              <th class="p-3.5 sm:p-4 text-center">IQ (SD 16)</th>
              <th class="p-3.5 sm:p-4 text-center">Cattell (SD 24)</th>
              <th class="p-3.5 sm:p-4 hidden md:table-cell">Estimated Size</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/60 dark:divide-zinc-800/60 bg-white dark:bg-zinc-950/40">
            {societies.map((s) => (
              <tr class="hover:bg-zinc-50/60 dark:hover:bg-zinc-900/30 transition-colors">
                <td class="p-3.5 sm:p-4 font-semibold text-zinc-900 dark:text-white">
                  <div class="flex items-center gap-2">
                    <span>{s.name}</span>
                    <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${s.badgeClass}`}>
                      Est. {s.founded}
                    </span>
                  </div>
                  <div class="text-xs text-zinc-500 dark:text-zinc-400 font-normal mt-1 max-w-xs md:hidden">
                    {s.focus}
                  </div>
                </td>
                <td class="p-3.5 sm:p-4 font-medium text-zinc-700 dark:text-zinc-300 font-mono text-xs">
                  {s.percentile}
                </td>
                <td class="p-3.5 sm:p-4 text-zinc-600 dark:text-zinc-400 font-mono text-xs">
                  {s.rarity}
                </td>
                <td class="p-3.5 sm:p-4 text-center font-mono font-bold text-blue-600 dark:text-blue-400">
                  {s.sd15}
                </td>
                <td class="p-3.5 sm:p-4 text-center font-mono text-zinc-600 dark:text-zinc-400">
                  {s.sd16}
                </td>
                <td class="p-3.5 sm:p-4 text-center font-mono text-zinc-600 dark:text-zinc-400">
                  {s.sd24}
                </td>
                <td class="p-3.5 sm:p-4 hidden md:table-cell text-xs text-zinc-500 dark:text-zinc-400">
                  {s.members}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 italic">
        * Standard deviation scales determine the numerical score assigned to identical percentile ranks. An individual scoring at the 98th percentile holds an IQ of 130 on the Wechsler SD 15 scale, 132 on the Stanford-Binet SD 16 scale, and 148 on the Cattell Culture Fair SD 24 scale.
      </p>
    </section>

    <!-- Deep Editorial Pillar Section 1: Detailed Society Profiles -->
    <article class="prose prose-zinc dark:prose-invert max-w-none space-y-8 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm sm:text-base">
      <section class="space-y-4">
        <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white border-b border-zinc-200 dark:border-zinc-800 pb-2">
          Profiles of the Major High-IQ Societies
        </h2>
        <p>
          High-IQ societies are international membership associations formed to foster intellectual dialogue, publish multidisciplinary research journals, and provide social communities for individuals scoring at specific upper percentiles of standardized intelligence examinations. While Mensa is by far the largest and most well-known, specialized high-ceiling societies exist for scores reaching into the top fractions of one percent.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose my-6">
          <div class="p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white">Mensa International (Top 2%)</h3>
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">IQ 130+</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3">
              Founded in Oxford, England in 1946 by Roland Berrill and Dr. Lancelot Ware, Mensa was created to provide a society where race, nationality, religion, and social background were irrelevant. The sole entrance criterion is achieving a score at or above the 98th percentile on an approved intelligence test.
            </p>
            <ul class="text-xs space-y-1 text-zinc-500 dark:text-zinc-400 list-disc list-inside">
              <li>Global membership spanning over 100 countries</li>
              <li>Hundreds of Special Interest Groups (SIGs)</li>
              <li>Annual Gatherings and academic research foundation grants</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white">Intertel (Top 1%)</h3>
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">IQ 135+</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3">
              Established in 1966 by Ralph Daniel, Intertel requires a qualifying score at or above the 99th percentile (IQ 135 on SD 15). The organization maintains an active international network and publishes the bi-monthly journal Integra, focusing on cognitive psychology and scientific inquiry.
            </p>
            <ul class="text-xs space-y-1 text-zinc-500 dark:text-zinc-400 list-disc list-inside">
              <li>Selective 1 in 100 cutoff</li>
              <li>Close-knit regional chapters and annual general meetings</li>
              <li>Encourages research on giftedness and exceptional cognition</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white">Triple Nine Society (Top 0.1%)</h3>
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">IQ 146+</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3">
              Formed in 1978, the Triple Nine Society derives its name from its admission requirement: the 99.9th percentile (a cutoff of 146 on the SD 15 scale). Members represent roughly one out of every one thousand individuals in the general population.
            </p>
            <ul class="text-xs space-y-1 text-zinc-500 dark:text-zinc-400 list-disc list-inside">
              <li>Highly decentralized, democratic governance</li>
              <li>Publishes the journal Vidya featuring member essays and original papers</li>
              <li>Does not accept high-range home tests; relies on strict standardized norms</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white">Prometheus &amp; Mega Societies</h3>
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">IQ 160+ / 171+</span>
            </div>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3">
              The Prometheus Society (99.997th percentile, 1 in 30,000) and the Mega Society (99.9999th percentile, 1 in 1,000,000) represent the extreme outer tail of psychometric measurement. Standard clinical tests rarely differentiate reliably at this altitude due to limited sample sizes.
            </p>
            <ul class="text-xs space-y-1 text-zinc-500 dark:text-zinc-400 list-disc list-inside">
              <li>Experimental high-ceiling psychometric batteries</li>
              <li>Small membership cohorts (dozens of members worldwide)</li>
              <li>Subject to ongoing debate regarding ceiling reliability and measurement error</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Deep Editorial Pillar Section 2: Accepted Prior Evidence & Qualifying Tests -->
      <section class="space-y-4">
        <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white border-b border-zinc-200 dark:border-zinc-800 pb-2">
          Accepted Qualifying Tests &amp; Prior Evidence Guidelines
        </h2>
        <p>
          Many candidates qualify for high-IQ societies without taking an official in-person admissions test through a process known as <strong>Prior Evidence</strong>. High-IQ organizations recognize standardized examinations administered during school or university admissions, provided the test possessed sufficient psychometric general factor (g-factor) saturation and standardized national norms during the administration year.
        </p>

        <div class="overflow-x-auto rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 my-6 not-prose">
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-zinc-50 dark:bg-zinc-900/70 text-zinc-600 dark:text-zinc-300 font-mono text-xs border-b border-zinc-200 dark:border-zinc-800">
