---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Tentang Kami: Misi, Standar Psikometrik & Transparansi | FreeIQExam";
const description = "Pelajari mengapa FreeIQExam diciptakan: Menghapus paywall predator dan mengembalikan ketelitian ilmiah pada pengujian kognitif online gratis berbasis psikometri CHC dan IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Tentang FreeIQExam: Misi, Psikometri, dan Transparansi",
    "url": "https://freeiqexam.com/id/tentang-kami/",
    "description": "Pelajari misi FreeIQExam.com untuk menyediakan pengujian kognitif ilmiah, transparan, dan tanpa paywall berbasis psikometri modern CHC."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/id/",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "Platform psikometrik sumber terbuka yang mengutamakan privasi, menyediakan penilaian kognitif dan latihan otak berbasis penelitian tanpa pungutan biaya."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tentang Kami",
        "item": "https://freeiqexam.com/id/tentang-kami/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apakah benar-benar ada tes IQ gratis tanpa jebakan bayar atau syarat email?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. FreeIQExam menyediakan tes penyaringan kognitif yang sepenuhnya gratis dengan hasil instan. Tanpa paywall, tanpa permintaan kartu kredit, dan tanpa kewajiban pendaftaran email. Laporan skor lengkap dan rincian psikometrik Anda langsung ditampilkan setelah tes selesai."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa begitu banyak situs tes IQ online meminta bayaran setelah selesai mengerjakan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Banyak situs komersial menerapkan taktik pengalihan (bait-and-switch). Mereka mengiklankan ujian sebagai 'gratis' untuk menarik pengguna, memanfaatkan bias psikologis 'sunk-cost' setelah Anda menghabiskan 30 menit menjawab soal, lalu menuntut langganan berulang atau pembayaran untuk membuka hasil. FreeIQExam diciptakan khusus untuk melawan praktik manipulatif ini."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah FreeIQExam diakui sebagai platform tes IQ yang sah di forum independen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Komunitas pengujian kognitif independen secara rutin memperingatkan pengguna terhadap situs berbayar yang tidak jelas dan mencari platform pengujian yang transparan. FreeIQExam dibangun di atas prinsip psikometri terbuka menggunakan Teori Respons Butir 2PL (IRT) dan teori Cattell-Horn-Carroll (CHC), dengan pemrosesan data lokal di browser dan tanpa monetisasi tersembunyi."
        }
      },
      {
        "@type": "Question",
        "name": "Bisakah tes IQ online memberikan diagnosis klinis resmi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak ada tes online yang dapat memberikan diagnosis klinis resmi. Diagnosis IQ klinis formal memerlukan evaluasi tatap muka individual oleh psikolog klinis berlisensi menggunakan instrumen lengkap seperti WAIS-IV atau Stanford-Binet 5. FreeIQExam berfungsi sebagai alat penyaringan kognitif berbasis penelitian dan sarana edukasi mandiri."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/about" canonicalUrl="https://freeiqexam.com/id/tentang-kami" robots="noindex, follow">
  <Header currentPath="/id/tentang-kami" enPath="/about" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tentang Kami</span>
    </nav>
    
    <!-- Hero Header -->
    <header class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>MISI PSIKOMETRIK TERBUKA &bull; BEBAS PAYWALL</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Mengembalikan Integritas Ilmiah pada Pengujian Kognitif
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        FreeIQExam dibangun untuk mendemokratisasi akses terhadap asesmen penalaran kognitif berkualitas tinggi tanpa jebakan langganan atau pengumpulan data pribadi.
      </p>
    </header>

    <!-- Content Sections -->
    <section class="space-y-8 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm sm:text-base">
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs space-y-4">
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Mengapa FreeIQExam Dibuat
        </h2>
        <p>
          Internet dipenuhi dengan situs tes IQ palsu yang menjanjikan tes 'gratis', namun setelah pengguna menghabiskan 30 menit menjawab puluhan pertanyaan sulit, mereka disodori dinding pembayaran (paywall) wajib atau jebakan tagihan mingguan otomatis. Praktik semacam ini merusak kepercayaan publik terhadap ilmu psikometri.
        </p>
        <p>
          Kami mendirikan <strong>FreeIQExam</strong> dengan komitmen teguh: memberikan penilaian kemampuan kognitif yang sepenuhnya gratis, transparan, dan berbasis sains sejati, dengan evaluasi instan tanpa kewajiban memasukkan nomor kartu kredit maupun alamat email.
        </p>
      </div>
    </section>

    <!-- Core Pillars Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            Standar Psikometrik CHC &amp; IRT 2PL
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
            Platform kami mengadopsi taksonomi Cattell-Horn-Carroll (CHC) dan memodelkan tingkat kesulitan soal menggunakan Teori Respons Butir 2-Parameter Logistik (2PL IRT) dengan estimasi sifat laten Bayes EAP, bukan sekadar menjumlahkan jawaban benar.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            Privasi Mutlak di Sisi Klien
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
            Seluruh komputasi penskoran dieksekusi 100% di browser lokal Anda. Jawaban dan skor Anda tidak pernah dikirim atau disimpan di basis data pelacak pusat mana pun.
          </p>
        </div>
    </section>

    <!-- Psychometric Methodology Section -->
    <section class="p-6 sm:p-10 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Ketelitian Psikometrik: Cara FreeIQExam Menghitung Skor Anda
      </h2>
      <p>
        Kuis amatir tradisional hanya menghitung jawaban benar mentah dan mengalikan dengan faktor skala sembarang. Pendekatan naif ini gagal memperhitungkan bahwa memecahkan soal penalaran matriks yang sangat sulit memberikan informasi jauh lebih banyak tentang kapasitas kognitif laten daripada menjawab butir pemanasan sepele.
      </p>
      <p>
        FreeIQExam menerapkan pemodelan psikometrik kontemporer:
      </p>
      <ul class="list-disc pl-5 space-y-2">
        <li><strong>Kurva Karakteristik Butir (ICC):</strong> Setiap butir tes didefinisikan oleh parameter diskriminasi matematis (a) yang menentukan seberapa tajam ia memisahkan strata kognitif, dan parameter kesulitan (b) yang dikalibrasi pada distribusi skor-z normal standar (&mu; = 0, &sigma; = 1).</li>
        <li><strong>Estimasi Sifat EAP Bayesian:</strong> Parameter sifat laten kontinu (&theta;) Anda diestimasi via integrasi numerik pada distribusi prior Gauss, menghukum tebakan beruntung dan memberikan Kesalahan Baku Pengukuran (SEM) yang realistis.</li>
        <li><strong>Penskalaan Simpangan Baku (&sigma; = 15):</strong> Sifat laten &theta; dipetakan ke metrik IQ Wechsler standar (IQ = 100 + 15&theta;) dan dikonversi menjadi persentil populasi memakai fungsi distribusi normal kumulatif &Phi;(z).</li>
      </ul>
      <div class="mt-4 p-4 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-900 dark:text-blue-200">
        Untuk panduan matematis mendalam tentang kurva kalibrasi dan formula integrasi kami, jelajahi <a href="/id/metodologi" class="font-semibold underline">Whitepaper Sains &amp; Psikometrika</a> kami.
      </div>
    </section>

    <!-- Transparent Boundaries & Clinical Disclaimer -->
    <section class="p-6 sm:p-10 rounded-3xl bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-amber-950 dark:text-amber-200 leading-relaxed space-y-3">
      <h2 class="font-heading font-bold text-lg sm:text-xl text-amber-950 dark:text-amber-100">
        Lingkup Klinis &amp; Batasan Ilmiah
      </h2>
      <p>
        Kejujuran psikometrik menuntut batasan yang jelas. Meski asesmen kami direkayasa dengan ketelitian matematis dan psikometrik tinggi:
      </p>
      <ul class="list-disc pl-5 space-y-1.5">
        <li><strong>Alat Skrining, Bukan Diagnosis Klinis:</strong> FreeIQExam adalah instrumen penilaian mandiri edukatif dan skrining kognitif. Ini tidak menggantikan evaluasi komprehensif individual terawasi oleh neuropsikolog atau psikolog pendidikan berlisensi.</li>
        <li><strong>Fokus Non-Verbal:</strong> Ujian primer 20 menit kami mengevaluasi penalaran fluida non-verbal (Gf) dan induksi pola matriks abstrak, meminimalkan bias budaya dan linguistik. Ini tidak mengukur pengetahuan kosakata kristalisasi (Gc) atau memori kerja auditori, yang membutuhkan baterai multi-subtes seperti WAIS-IV.</li>
        <li><strong>Pendidikan Khusus &amp; Penerimaan Mensa:</strong> Mensa dan program berbakat sekolah membutuhkan ujian terawasi atau tes bukti terdahulu kualifikasi (seperti skor SAT/GRE historis atau ujian Stanford-Binet terawasi). Pelajari lebih lanjut di <a href="/id/latihan-tes-mensa" class="font-semibold underline">Panduan Latihan &amp; Kualifikasi Mensa</a> kami.</li>
      </ul>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="space-y-4">
      <div class="border-b border-zinc-200 dark:border-zinc-800 pb-4">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Pertanyaan yang Sering Diajukan (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Pertanyaan terpopuler seputar misi keterbukaan dan transparansi FreeIQExam.
        </p>
      </div>

      <div class="space-y-3">
        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Apakah benar-benar ada tes IQ gratis tanpa jebakan bayar atau syarat email?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Ya. FreeIQExam menyediakan tes penyaringan kognitif yang sepenuhnya gratis dengan hasil instan. Tanpa paywall, tanpa permintaan kartu kredit, dan tanpa kewajiban pendaftaran email. Laporan skor lengkap dan rincian psikometrik Anda langsung ditampilkan setelah tes selesai.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Mengapa begitu banyak situs tes IQ online meminta bayaran setelah selesai mengerjakan?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Banyak situs komersial menerapkan taktik pengalihan (bait-and-switch). Mereka mengiklankan ujian sebagai 'gratis' untuk menarik pengguna, memanfaatkan bias psikologis 'sunk-cost' setelah Anda menghabiskan 30 menit menjawab soal, lalu menuntut langganan berulang atau pembayaran untuk membuka hasil. FreeIQExam diciptakan khusus untuk melawan praktik manipulatif ini.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Apakah FreeIQExam diakui sebagai platform tes IQ yang sah di forum independen?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Komunitas pengujian kognitif independen secara rutin memperingatkan pengguna terhadap situs berbayar yang tidak jelas dan mencari platform pengujian yang transparan. FreeIQExam dibangun di atas prinsip psikometri terbuka menggunakan Teori Respons Butir 2PL (IRT) dan teori Cattell-Horn-Carroll (CHC), dengan pemrosesan data lokal di browser dan tanpa monetisasi tersembunyi.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Bisakah tes IQ online memberikan diagnosis klinis resmi?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Tidak ada tes online yang dapat memberikan diagnosis klinis resmi. Diagnosis IQ klinis formal memerlukan evaluasi tatap muka individual oleh psikolog klinis berlisensi menggunakan instrumen lengkap seperti WAIS-IV atau Stanford-Binet 5. FreeIQExam berfungsi sebagai alat penyaringan kognitif berbasis penelitian dan sarana edukasi mandiri.
          </p>
        </details>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="p-8 rounded-3xl bg-blue-600 text-white text-center space-y-4">
      <h2 class="font-heading font-extrabold text-2xl sm:text-3xl">
        Coba Tes IQ Gratis dan Transparan Sekarang
      </h2>
      <p class="max-w-xl mx-auto text-blue-100 text-sm sm:text-base">
        Ikuti tes IQ lengkap 24 soal kami dan dapatkan analisis kognitif mendalam seketika tanpa dipungut biaya apa pun.
      </p>
      <div class="pt-2">
        <a
          href="/id/tes"
          class="inline-flex items-center justify-center px-6 py-3 rounded-2xl bg-white text-blue-600 font-bold hover:bg-blue-50 transition-colors shadow-sm"
        >
          Mulai Tes IQ Gratis &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
