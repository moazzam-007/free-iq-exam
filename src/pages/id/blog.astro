---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Blog Sains Kognitif & Psikometri: Panduan & Penelitian | FreeIQExam";
const description = "Artikel penelitian otoritatif mengenai klasifikasi skor IQ, komunitas IQ tinggi, aturan matriks Carpenter, lintasan kognitif usia, dan pengukuran psikometrik.";

const featuredPost = {
  title: "Skala Klasifikasi IQ Komprehensif: WAIS-IV, Stanford-Binet 5, dan Kurva Lonceng",
  slug: "/id/skala-klasifikasi-iq",
  category: "Psikometri & Skala",
  categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
  readTime: "8 mnt baca",
  date: "September 2026",
  author: "Grup Riset Psikometri",
  excerpt: "Analisis komparatif mendalam mengenai klasifikasi inteligensi modern. Pelajari bagaimana skala Wechsler, Stanford-Binet, dan Woodcock-Johnson mendefinisikan kategori Sangat Unggul, Berbakat, dan Rata-rata pada distribusi normal standar."
};

const articles = [
  {
    title: "Perbandingan Komunitas IQ Tinggi Dunia: Mensa, Intertel, dan Triple Nine Society",
    slug: "/id/komunitas-iq-tinggi",
    category: "Komunitas IQ Tinggi",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "7 mnt baca",
    date: "September 2026",
    author: "Grup Riset Psikometri",
    excerpt: "Pelajari batas selektivitas, riwayat tes kualifikasi yang diterima (SAT, GRE, ACT), dan standar keanggotaan organisasi IQ tinggi paling bergengsi di dunia."
  },
  {
    title: "5 Aturan Carpenter: Menguak Rahasia Penalaran Matriks Abstrak & Matriks Raven",
    slug: "/id/tes-penalaran-matriks",
    category: "Latihan Kognitif",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "6 mnt baca",
    date: "September 2026",
    author: "Tim Evaluasi Kognitif",
    excerpt: "Kuasai hierarki aturan kognitif yang pertama kali didokumentasikan oleh Carpenter, Just, dan Shell (1990). Pelajari cara mengidentifikasi pembatalan Boolean XOR, progresi kuantitatif, dan distribusi pola."
  },
  {
    title: "Rata-rata IQ Berdasarkan Usia: Lintasan Kognitif Rentang Hidup & Efek Flynn",
    slug: "/id/rata-rata-iq-berdasarkan-usia",
    category: "Psikologi Perkembangan",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "7 mnt baca",
    date: "September 2026",
    author: "Grup Sains Perkembangan",
    excerpt: "Mengapa median populasi IQ selalu 100 di setiap usia? Telaah kurva penurunan kecerdasan fluida vs stabilitas kosakata kristalisasi serta pergeseran sekuler antargenerasi."
  },
  {
    title: "Persiapan Ujian Masuk Mensa: Latihan Bebas Budaya & Strategi Lolos",
    slug: "/id/latihan-tes-mensa",
    category: "Persiapan Tes",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "6 mnt baca",
    date: "September 2026",
    author: "Tim Persiapan Asesmen",
    excerpt: "Strategi praktis menghadapi Tes Penerimaan Mensa dengan pengawas. Pelajari bagaimana induksi matriks non-verbal dan penalaran spasial cepat dinilai di bawah batas waktu."
  },
  {
    title: "Memahami Kurva Lonceng IQ: Simpangan Baku, Kelangkaan & Persentil",
    slug: "/id/tabel-skor-iq",
    category: "Pengukuran Statistik",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "5 mnt baca",
    date: "September 2026",
    author: "Grup Riset Psikometri",
    excerpt: "Pahami pita distribusi Gauss, konversi simpangan baku (SD 15 vs SD 16 vs SD 24), dan arti sebenarnya dari skor IQ dalam konteks populasi umum."
  },
  {
    title: "Teori Respons Butir 2PL & Penskoran Bayes EAP: Whitepaper FreeIQExam",
    slug: "/id/metodologi",
    category: "Metodologi Teknis",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "12 mnt baca",
    date: "September 2026",
    author: "Tim Psikometri Inti",
    excerpt: "Dokumentasi matematis lengkap mengenai model IRT 2-Parameter Logistik, kuadratur Gauss-Hermite 81 titik, Interval Kredibilitas Posterior 95%, dan DOI Harvard Dataverse."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Sains Kognitif & Psikometri FreeIQExam",
  "description": description,
  "url": "https://freeiqexam.com/id/blog"
};
---

<Layout title={title} description={description} schema={schema} enPath="/blog">
  <Header currentPath="/id/blog" enPath="/blog" />

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Blog &amp; Artikel</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>SAINS KOGNITIF &bull; RISET PSIKOMETRI</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Artikel &amp; Panduan Riset Psikometrik
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Jelajahi analisis berbasis sains mengenai psikometri, klasifikasi kecerdasan, pemodelan Teori Respons Butir 2PL, dan strategi latihan penalaran kognitif.
      </p>
    </header>

    <!-- Featured Post -->
    <section class="mb-12">
      <div class="p-6 sm:p-10 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-4">
        <div class="flex items-center gap-3">
          <span class={`px-3 py-1 rounded-full text-xs font-mono font-medium border ${featuredPost.categoryColor}`}>
            {featuredPost.category}
          </span>
          <span class="text-xs font-mono text-zinc-400">{featuredPost.readTime}</span>
        </div>
        <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white">
          <a href={featuredPost.slug} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            {featuredPost.title}
          </a>
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          {featuredPost.excerpt}
        </p>
        <div class="pt-2 flex items-center justify-between">
          <span class="text-xs font-mono text-zinc-500">{featuredPost.author} &bull; {featuredPost.date}</span>
          <a href={featuredPost.slug} class="text-xs sm:text-sm font-bold text-blue-600 dark:text-blue-400 hover:underline">
            Baca Selengkapnya &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {articles.map((art) => (
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-4">
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono border ${art.categoryColor}`}>
                {art.category}
              </span>
              <span class="text-[11px] font-mono text-zinc-400">{art.readTime}</span>
            </div>
            <h3 class="font-heading font-bold text-base sm:text-lg text-zinc-950 dark:text-white leading-snug">
              <a href={art.slug} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                {art.title}
              </a>
            </h3>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {art.excerpt}
            </p>
          </div>
          <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
            <span class="text-zinc-400 font-mono text-[11px]">{art.date}</span>
            <a href={art.slug} class="font-bold text-blue-600 dark:text-blue-400 hover:underline">
              Baca &rarr;
            </a>
          </div>
        </div>
      ))}
    </section>
  </main>

  <Footer />
</Layout>
