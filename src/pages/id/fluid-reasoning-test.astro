---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Fluida Online Gratis: 16 Soal Matriks IQ (Gf) | FreeIQExam";
const description = "Ikuti tes Penalaran Fluida (Gf) gratis secara online. 16 soal matriks progresif dan induksi pola yang terkalibrasi Teori Respons Butir 2PL. Penilaian instan.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Penalaran Fluida (Gf)",
    "description": "Penilaian inteligensi fluida non-verbal khusus 16 soal yang mengukur induksi aturan abstrak, penyelesaian matriks, dan logika transformasi topologis.",
    "url": "https://freeiqexam.com/id/tes-penalaran-fluida/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Penalaran Fluida",
        "item": "https://freeiqexam.com/id/tes-penalaran-fluida/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/fluid-reasoning-test" canonicalUrl="https://freeiqexam.com/id/tes-penalaran-fluida" robots="noindex, follow">
  <Header currentPath="/id/tes-penalaran-fluida" enPath="/fluid-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Fluida</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gf <span aria-hidden="true">&bull;</span> BEBAS BIAS BUDAYA</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Penalaran Fluida (Gf)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kapasitas pemecahan masalah baru, induksi aturan matriks abstrak, dan logika topologis Anda. Pilih antara tes terstandardisasi 15 menit atau latihan tanpa batas waktu dengan penjelasan langkah demi langkah.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Matriks Progresif</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Pengatur Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Stimulus Bebas Bahasa</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="fluid"
      domainCode="Gf"
      domainTitle="Penalaran Fluida"
      domainSubtitle="Induksi Aturan Matriks Abstrak & Logika Topologis"
      domainDescription="Penalaran Fluida (Gf) mencerminkan kapasitas untuk bernalar dan menyelesaikan masalah baru secara independen dari pendidikan formal. Dalam penelitian psikometri, Gf menunjukkan korelasi tertinggi dengan faktor umum kecerdasan (faktor g)."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />
  </main>

  <Footer />
</Layout>
