    pastelIcon: 'pastel-icon-lav',
    description: 'Penerjemahan simbol geometris ke angka secara cepat di bawah batas waktu ketat.',
    skill: 'Kecepatan Pemrosesan Persepsi (Gs)',
    domain: 'processing-speed',
    domains: ['processing-speed'],
    unit: 'poin',
    mood: 'Cepat & tanggap',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v8.25A2.25 2.25 0 006 16.5h2.25m8.25-8.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-7.5A2.25 2.25 0 018.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 00-2.25 2.25v6" />'
