  },
  {
    id: 'digit-span',
    name: 'Rentang Digit Memori',
    route: '/id/permainan/digit-span',
    pastelTag: 'pastel-tag-lav',
    pastelIcon: 'pastel-icon-lav',
    description: 'Ingat urutan angka berurutan secara maju maupun pembalikan mental mundur.',
    skill: 'Memori Kerja Serial & Akustik (Gwm)',
