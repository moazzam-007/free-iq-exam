---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Permainan Latihan Otak Gratis: 10 Game Asah Otak Kognitif | FreeIQExam";
const description = "Latih memori kerja, kecepatan pemrosesan, rotasi spasial, kelancaran matematika, dan logika deduktif dengan 10 permainan otak gratis berbasis sains kognitif.";

const games = [
  {
    id: 'n-back',
    name: 'Memori Dual N-Back',
    route: '/id/permainan/n-back',
    pastelTag: 'pastel-tag-mint',
    pastelIcon: 'pastel-icon-mint',
    description: 'Lacak posisi spasial dan huruf vokal/konsonan secara simultan N langkah ke belakang.',
    skill: 'Memori Kerja (Gwm)',
    domain: 'working-memory',
    domains: ['working-memory'],
    unit: 'poin',
    mood: 'Tenang & fokus',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.5-7.5h15" />'
  },
  {
    id: 'rotation',
    name: 'Tantangan Rotasi Mental 3D',
    route: '/id/permainan/rotasi-mental',
