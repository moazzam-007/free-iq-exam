---
import Layout from '../../../components/id/LayoutId.astro';
import Header from '../../../components/id/HeaderId.astro';
import Footer from '../../../components/id/FooterId.astro';

const title = "Math Sprint 60 Detik - Latihan Kecepatan Aritmatika Mental | FreeIQExam";
const description = "Uji kecepatan matematika mental dan kalkulasi cepat online gratis dalam 60 detik. Asah kelancaran numerik dan kecepatan pemrosesan kuantitatif (Gq/Gs).";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Speed Math Sprint Cognitive Drill",
    "url": "https://freeiqexam.com/id/permainan/math-sprint",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Latihan aritmatika mental cepat yang mengukur retrieval fakta kuantitatif dan kecepatan pemrosesan di bawah batasan waktu."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan Kognitif",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Math Sprint",
        "item": "https://freeiqexam.com/id/permainan/math-sprint"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/games/math-sprint">
  <Header currentPath="/id/permainan/math-sprint" enPath="/games/math-sprint" />

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <a href="/id/permainan" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Permainan Kognitif</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Speed Math</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-yellow mb-1.5">
          Gq &amp; Gs &bull; Kecepatan Kuantitatif
        </div>
        <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
          Speed Math Sprint
        </h1>
      </div>

      <!-- Stat HUD + Help Button -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <button
          id="btn-how-to-play"
          type="button"
          aria-label="Petunjuk cara bermain"
          class="min-h-[44px] px-3 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/90 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-sans font-semibold text-xs sm:text-sm flex items-center gap-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
        >
          <span class="font-bold font-mono text-emerald-600 dark:text-emerald-400">(?)</span>
          <span>Cara Bermain</span>
        </button>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Tingkat</div>
          <div id="hud-level" class="font-bold text-emerald-600 dark:text-emerald-400 text-sm sm:text-base">Tingkat 1</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Runtunan</div>
          <div id="hud-streak" class="font-bold text-amber-500 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Skor</div>
          <div id="hud-score" class="font-bold text-zinc-800 dark:text-zinc-100 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Terbaik</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-yellow flex items-center justify-center mb-5 shadow-lg shadow-emerald-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.75h14.5M12 4.75v14.5m4-4l-3-3m3 3l3-3m-14 3h6m-6 3h6" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Sprint Matematika 60 Detik
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Pecahkan sebanyak mungkin persamaan matematika aritmatika sebelum penghitung waktu 60 detik habis.
          </p>
          <p>
            Tingkat kesulitan meningkat melalui 4 tingkat seiring Anda membangun runtunan: angka satuan, dua digit, operasi campuran, dan perkalian/pembagian mental.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            Penilaian: +10 poin benar, -3 poin salah. Bonus runtunan setiap 5 jawaban benar beruntun!
          </p>
        </div>
        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-bold text-base shadow-md transition-all duration-150 hover:scale-105 active:scale-95 flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
        >
          <span>Mulai Sprint (Spasi)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content -->
      <div id="game-arena-content" class="w-full flex flex-col items-center">
        <!-- 60-Second Countdown Header -->
        <div class="w-full max-w-lg mb-6">
          <div class="flex items-center justify-between text-xs font-mono font-semibold mb-2">
            <span class="text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Sisa Waktu</span>
            <span id="sprint-timer-text" class="text-lg font-bold text-emerald-600 dark:text-emerald-400">60.0s</span>
          </div>
          <div class="w-full h-3 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden border border-zinc-200 dark:border-zinc-700/60">
            <div id="sprint-progress-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-100 ease-linear" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Problem Card -->
        <div class="w-full max-w-lg p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/80 shadow-inner flex flex-col items-center justify-center mb-8 relative">
          <div id="streak-bonus-badge" class="hidden absolute top-3 right-4 px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-700 animate-bounce">
            Runtunan 5x!
          </div>
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-widest mb-2">Tantangan Aritmatika</div>
          <div id="equation-text" class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight text-center">
            -- + -- = ?
          </div>
        </div>

        <!-- 4 Multiple Choice Answer Buttons -->
        <div class="w-full max-w-lg grid grid-cols-2 gap-3 sm:gap-4 mb-4">
          <button
            id="btn-opt-0"
            type="button"
            data-index="0"
            class="min-h-[64px] p-4 rounded-2xl bg-white dark:bg-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border-2 border-zinc-200 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm transition-all duration-100 hover:scale-102 active:scale-98 flex items-center justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span class="w-7 h-7 rounded-xl bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-mono font-bold text-xs flex items-center justify-center">1</span>
            <span id="opt-text-0" class="font-heading font-extrabold text-xl sm:text-2xl text-zinc-900 dark:text-white">-</span>
            <span class="w-7"></span>
          </button>

          <button
            id="btn-opt-1"
            type="button"
            data-index="1"
            class="min-h-[64px] p-4 rounded-2xl bg-white dark:bg-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border-2 border-zinc-200 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm transition-all duration-100 hover:scale-102 active:scale-98 flex items-center justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span class="w-7 h-7 rounded-xl bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-mono font-bold text-xs flex items-center justify-center">2</span>
            <span id="opt-text-1" class="font-heading font-extrabold text-xl sm:text-2xl text-zinc-900 dark:text-white">-</span>
            <span class="w-7"></span>
          </button>

          <button
            id="btn-opt-2"
            type="button"
            data-index="2"
            class="min-h-[64px] p-4 rounded-2xl bg-white dark:bg-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border-2 border-zinc-200 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm transition-all duration-100 hover:scale-102 active:scale-98 flex items-center justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span class="w-7 h-7 rounded-xl bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-mono font-bold text-xs flex items-center justify-center">3</span>
            <span id="opt-text-2" class="font-heading font-extrabold text-xl sm:text-2xl text-zinc-900 dark:text-white">-</span>
            <span class="w-7"></span>
          </button>

          <button
            id="btn-opt-3"
            type="button"
            data-index="3"
            class="min-h-[64px] p-4 rounded-2xl bg-white dark:bg-zinc-800 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 border-2 border-zinc-200 dark:border-zinc-700 hover:border-emerald-500 dark:hover:border-emerald-500 shadow-sm transition-all duration-100 hover:scale-102 active:scale-98 flex items-center justify-between focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span class="w-7 h-7 rounded-xl bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-mono font-bold text-xs flex items-center justify-center">4</span>
            <span id="opt-text-3" class="font-heading font-extrabold text-xl sm:text-2xl text-zinc-900 dark:text-white">-</span>
            <span class="w-7"></span>
          </button>
        </div>

        <!-- Feedback Toast -->
        <div id="feedback-toast" role="status" aria-live="polite" class="h-6 mt-2 text-xs font-mono font-semibold transition-opacity opacity-0 text-zinc-500">
          Status
        </div>
      </div>
    </div>

    <!-- How to Play Instructions Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4"
    >
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-left relative max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-how-modal"
          type="button"
          aria-label="Tutup dialog petunjuk"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.75 6.75h14.5M12 4.75v14.5m4-4l-3-3m3 3l3-3m-14 3h6m-6 3h6" />
            </svg>
          </div>
          <div>
            <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
              Cara Bermain Math Sprint
            </h2>
            <p class="text-xs text-emerald-600 dark:text-emerald-400 font-medium">Kecepatan Kuantitatif &amp; Aritmatika (Gq/Gs)</p>
          </div>
        </div>

        <div class="space-y-4 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Mekanisme Permainan</h4>
            <p>1. Selesaikan sebanyak mungkin persamaan aritmatika dalam batas waktu 60 detik.</p>
            <p>2. Pilih jawaban yang benar dari 4 opsi yang tersedia secepat mungkin.</p>
            <p>3. Setiap jawaban benar memberi +10 poin. Setiap 5 jawaban benar beruntun memberi bonus runtunan.</p>
            <p>4. Kesulitan meningkat secara adaptif melalui 4 tingkat operasi.</p>
          </div>

          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Kontrol Keyboard</h4>
            <ul class="space-y-1 text-xs font-mono">
              <li>&bull; <span class="font-bold text-zinc-900 dark:text-white">[Spasi]</span> : Mulai sprint / Mulai ulang</li>
              <li>&bull; <span class="font-bold text-emerald-600 dark:text-emerald-400">[1, 2, 3, 4]</span> : Pilih opsi jawaban 1 hingga 4</li>
              <li>&bull; <span class="font-bold text-zinc-900 dark:text-white">[Escape]</span> : Tutup dialog</li>
            </ul>
          </div>

          <div class="p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/60 text-xs">
            <span class="font-bold text-emerald-950 dark:text-emerald-200">Landasan Ilmiah:</span>
            <span class="text-emerald-900 dark:text-emerald-300 ml-1">Kelancaran Aritmatika Mental &amp; Kecepatan Akses Kuantitatif (Gq/Gs; Taksonomi CHC).</span>
          </div>
        </div>

        <button
          id="btn-close-how-got-it"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-bold text-sm shadow-md transition-all duration-150 hover:scale-101 active:scale-99 flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
        >
          <span>Mengerti, Mulai Latihan</span>
        </button>
      </div>
    </div>

    <!-- End of Round Performance Modal -->
    <div id="modal-end-round" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-center relative max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-end-modal"
          type="button"
          aria-label="Tutup ringkasan modal"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <h2 id="modal-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Sprint Selesai!
        </h2>
        <p class="text-sm font-medium text-emerald-600 dark:text-emerald-400 mb-4">
          Evaluasi Kelancaran Kuantitatif
        </p>

        <!-- Standardized 0-100 Task Performance Score -->
        <div class="mb-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-800">
          <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            Skor Performa Tugas
          </div>
          <div class="flex items-baseline justify-center gap-1.5 my-1">
            <span id="modal-perf-score" class="text-4xl sm:text-5xl font-extrabold font-heading text-zinc-950 dark:text-white">0</span>
            <span class="text-sm font-mono text-zinc-400">/ 100</span>
          </div>
          <div id="modal-tier-badge" class="mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border">
            <span id="modal-tier-name">Fondasi Solid</span>
          </div>
          <p id="modal-tier-desc" class="mt-2 text-xs text-zinc-600 dark:text-zinc-400 max-w-sm mx-auto leading-relaxed"></p>
        </div>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Soal Terjawab</div>
            <div id="modal-attempted" class="font-bold text-base text-zinc-900 dark:text-white">0</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Akurasi</div>
            <div id="modal-acc" class="font-bold text-base text-emerald-600 dark:text-emerald-400">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Kecepatan Rata-rata</div>
            <div id="modal-pace" class="font-bold text-base text-indigo-600 dark:text-indigo-400">0.0s</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Runtunan Terbaik</div>
            <div id="modal-streak" class="font-bold text-base text-amber-500">0</div>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 text-left mb-4">
          <div class="text-[11px] font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider font-mono mb-1">
            Landasan Ilmiah
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Kelancaran Aritmatika Mental (Gq/Gs; Cattell-Horn-Carroll).
          </p>
        </div>

        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 italic mb-5 leading-normal">
          Catatan Efek Latihan: Skor performa mencerminkan kelancaran operasional spesifik tugas dan kecepatan respons di bawah efek latihan, bukan kecerdasan umum bawaan (g). Latihan berulang mengasah ketangkasan kognitif.
        </p>

        <div id="modal-best-alert" class="hidden mb-5 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-semibold">
          Rekor Pribadi Terbaik Baru!
        </div>

        <div class="flex items-center gap-3">
          <button
            id="btn-modal-restart"
            type="button"
            class="flex-1 min-h-[44px] py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-sm transition-all duration-150 hover:scale-102 active:scale-98 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            Main Lagi
          </button>
          <a
            href="/id/permainan"
            class="min-h-[44px] px-5 py-3 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-colors flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          >
            Pusat Permainan
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Guide & Cognitive Science Section -->
    <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-yellow mb-2">
          CHC Broad Ability: Kemampuan Kuantitatif &amp; Kecepatan (Gq/Gs)
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          Math Sprint: Kelancaran Numerik &amp; Efisiensi Kognitif Kuantitatif
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Kelancaran matematika mental mencerminkan integrasi antara pengetahuan kuantitatif kristalisasi (Gq) dan kecepatan pemrosesan saraf (Gs). Kemampuan melakukan manipulasi numerik cepat tanpa beban kognitif berlebih merupakan fondasi penting dalam pemecahan masalah analitis tingkat tinggi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            1. Cara Bermain &amp; Kontrol
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Selesaikan persamaan secepat mungkin sebelum waktu 60 detik habis. Gunakan tombol angka <strong>[1, 2, 3, 4]</strong> pada keyboard atau klik opsi jawaban.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            2. Penilaian &amp; Runtunan Bonus
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Setiap jawaban benar memberi +10 poin, sementara kesalahan mengurangi 3 poin. Membangun runtunan beruntun akan memicu bonus pengganda skor.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            3. Landasan Ilmiah Kuantitatif
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Berakar pada model taksonomi CHC untuk pengetahuan kuantitatif (Gq) dan kecepatan pemrosesan (Gs), tugas ini melatih efisiensi retrieval memori semantik numerik.
          </p>
        </div>
      </div>

      <!-- Psychometric Disclaimer Callout -->
      <div class="p-4 sm:p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs sm:text-sm text-amber-900 dark:text-amber-300 leading-relaxed">
        <strong>Catatan Psikometrik Penting:</strong> Performa Math Sprint mencerminkan kelancaran perhitungan aritmatika dan kecepatan waktu reaksi. Latihan ini tidak mengukur kecerdasan umum bawaan (<em>g</em>) atau menggantikan asesmen psikometrik formal.
      </div>

      <!-- Cross Links -->
      <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
            Ingin Evaluasi Kognitif Menyeluruh?
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            Uji kemampuan Penalaran Fluida, Visual-Spasial, Kuantitatif, dan Verbal Anda dengan asesmen 24 soal terstandar kami.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a href="/id/tes-singkat" class="px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-300 transition-colors">Tes Singkat 10m</a>
          <a href="/id/tes" class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-colors shadow-xs">Ujian Lengkap 20m</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { saveGameRecord } from '../../../utils/profileStore';

  function getLocalizedTier(score: number) {
    if (score >= 90) {
      return {
        tier: 'Tingkat Ahli (Master)',
        description: 'Trade-off kecepatan-akurasi hampir optimal; penguasaan strategi tugas dan kelancaran kognitif tingkat tinggi.',
        badgeClass: 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200 dark:border-purple-800',
      };
    }
    if (score >= 75) {
      return {
        tier: 'Tingkat Mahir (Advanced)',
        description: 'Throughput informasi tinggi; resolusi konflik cepat dan minim distractor drift.',
        badgeClass: 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-800',
      };
    }
    if (score >= 60) {
      return {
        tier: 'Fondasi Solid (Solid Baseline)',
        description: 'Akurasi konsisten; fokus perhatian stabil dengan sedikit kesalahan acak.',
        badgeClass: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
      };
    }
    if (score >= 40) {
      return {
        tier: 'Berkembang (Developing)',
        description: 'Akurasi respons stabil; ritme operasional dasar di bawah batasan waktu.',
        badgeClass: 'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800',
      };
    }
    return {
      tier: 'Tahap Awal (Getting Started)',
      description: 'Refleks operasional mulai terbangun; pembiasaan dengan aturan dan ritme respons.',
      badgeClass: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700',
    };
  }

  (function() {
    var TOTAL_SECONDS = 60;
    var STORAGE_KEY = 'fiq_game_math_best';
    var STORAGE_KEY_V2 = 'fiq_game_mathsprint_best';

    var isRunning = false;
    var startTime = 0;
    var remainingMs = TOTAL_SECONDS * 1000;
    var score = 0;
    var streak = 0;
    var longestStreak = 0;
    var correctCount = 0;
    var wrongCount = 0;
    var responseTimes: number[] = [];
    var timerAnimFrame: any = null;
    var currentProblem: any = null;

    var hudLevel = document.getElementById('hud-level')!;
    var hudStreak = document.getElementById('hud-streak')!;
    var hudScore = document.getElementById('hud-score')!;
    var hudBest = document.getElementById('hud-best')!;
    var btnHowToPlay = document.getElementById('btn-how-to-play')!;
    var modalHowToPlay = document.getElementById('modal-how-to-play')!;
    var btnCloseHowModal = document.getElementById('btn-close-how-modal')!;
    var btnCloseHowGotIt = document.getElementById('btn-close-how-got-it')!;

    var startOverlay = document.getElementById('start-overlay')!;
    var btnStartGame = document.getElementById('btn-start-game')!;
    var gameArenaContent = document.getElementById('game-arena-content')!;
    var sprintTimerText = document.getElementById('sprint-timer-text')!;
    var sprintProgressBar = document.getElementById('sprint-progress-bar')!;
    var equationText = document.getElementById('equation-text')!;
    var streakBonusBadge = document.getElementById('streak-bonus-badge')!;
    var feedbackToast = document.getElementById('feedback-toast');

    if (gameArenaContent) {
      gameArenaContent.setAttribute('inert', '');
    }

    var optButtons = [
      document.getElementById('btn-opt-0')!,
      document.getElementById('btn-opt-1')!,
      document.getElementById('btn-opt-2')!,
      document.getElementById('btn-opt-3')!
    ];
    var optTexts = [
      document.getElementById('opt-text-0')!,
      document.getElementById('opt-text-1')!,
      document.getElementById('opt-text-2')!,
      document.getElementById('opt-text-3')!
    ];

    var modalEndRound = document.getElementById('modal-end-round')!;
    var btnCloseEndModal = document.getElementById('btn-close-end-modal')!;
    var modalPerfScore = document.getElementById('modal-perf-score')!;
    var modalTierBadge = document.getElementById('modal-tier-badge')!;
    var modalTierName = document.getElementById('modal-tier-name')!;
    var modalTierDesc = document.getElementById('modal-tier-desc')!;
    var modalAcc = document.getElementById('modal-acc')!;
    var modalAttempted = document.getElementById('modal-attempted')!;
    var modalPace = document.getElementById('modal-pace')!;
    var modalStreak = document.getElementById('modal-streak')!;
    var modalBestAlert = document.getElementById('modal-best-alert')!;
    var btnModalRestart = document.getElementById('btn-modal-restart')!;

    function calculateMedian(arr: number[]): number {
      if (!arr || arr.length === 0) return 0;
      var sorted = arr.slice().sort(function(a, b) { return a - b; });
      var mid = Math.floor(sorted.length / 2);
      return sorted.length % 2 !== 0 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    }

    function loadBestScore() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY_V2) || localStorage.getItem(STORAGE_KEY);
        if (saved) {
          hudBest.textContent = saved;
        }
      } catch (e) {}
    }
    loadBestScore();

    function getTier() {
      if (correctCount < 10) return 1;
      if (correctCount < 20) return 2;
      if (correctCount < 30) return 3;
      return 4;
    }

    function updateHud() {
      var tier = getTier();
      hudLevel.textContent = 'Tingkat ' + tier;
      hudStreak.textContent = streak.toString();
      hudScore.textContent = score.toString();
    }

    function showFeedback(text: string, isPositive: boolean) {
      if (!feedbackToast) return;
      feedbackToast.textContent = (isPositive ? '✓ ' : '✗ ') + text;
      feedbackToast.className = 'h-6 mt-2 text-xs font-mono font-semibold transition-opacity ' +
        (isPositive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400');
      feedbackToast.style.opacity = '1';
      setTimeout(function() {
        if (feedbackToast) feedbackToast.style.opacity = '0';
      }, 500);
    }

    function generateProblem() {
      var tier = getTier();
      var expr = '';
      var ans = 0;

      if (tier === 1) {
        var op = Math.random() < 0.5 ? '+' : '-';
        if (op === '+') {
          var a = Math.floor(Math.random() * 8) + 2;
          var b = Math.floor(Math.random() * 8) + 2;
          expr = a + ' + ' + b;
          ans = a + b;
        } else {
          var b = Math.floor(Math.random() * 8) + 2;
          var res = Math.floor(Math.random() * 8) + 1;
          var a = b + res;
          expr = a + ' - ' + b;
          ans = res;
        }
      } else if (tier === 2) {
        var roll = Math.random();
        if (roll < 0.4) {
          var a = Math.floor(Math.random() * 70) + 15;
          var b = Math.floor(Math.random() * 8) + 2;
          expr = a + ' + ' + b;
          ans = a + b;
        } else if (roll < 0.7) {
          var a = Math.floor(Math.random() * 70) + 20;
          var b = Math.floor(Math.random() * 8) + 2;
          expr = a + ' - ' + b;
          ans = a - b;
        } else {
          var a = Math.floor(Math.random() * 7) + 3;
          var b = Math.floor(Math.random() * 8) + 2;
          expr = a + ' × ' + b;
          ans = a * b;
        }
      } else if (tier === 3) {
        var roll = Math.random();
        if (roll < 0.4) {
          var a = Math.floor(Math.random() * 15) + 11;
          var b = Math.floor(Math.random() * 6) + 3;
          expr = a + ' × ' + b;
          ans = a * b;
        } else if (roll < 0.7) {
          var a = Math.floor(Math.random() * 6) + 3;
          var b = Math.floor(Math.random() * 5) + 2;
          var c = Math.floor(Math.random() * 5) + 2;
          expr = a + ' × (' + b + ' + ' + c + ')';
          ans = a * (b + c);
        } else {
          var a = Math.floor(Math.random() * 50) + 30;
          var b = Math.floor(Math.random() * 25) + 15;
          expr = a + ' - ' + b;
          ans = a - b;
        }
      } else {
        var roll = Math.random();
        if (roll < 0.4) {
          var b = Math.floor(Math.random() * 9) + 4;
          var ansVal = Math.floor(Math.random() * 12) + 3;
          var a = b * ansVal;
          expr = a + ' ÷ ' + b;
          ans = ansVal;
        } else if (roll < 0.7) {
          var a = Math.floor(Math.random() * 8) + 11;
          expr = a + '²';
          ans = a * a;
        } else {
          var a = Math.floor(Math.random() * 18) + 12;
          var b = Math.floor(Math.random() * 18) + 12;
          expr = a + ' + ' + b;
          ans = a + b;
        }
      }

      var choices = [ans];
      while (choices.length < 4) {
        var delta = Math.floor(Math.random() * 7) + 1;
        if (Math.random() < 0.5) delta = -delta;
        var fake = ans + delta;
        if (fake >= 0 && choices.indexOf(fake) === -1) {
          choices.push(fake);
        }
      }

      for (var i = choices.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = choices[i];
        choices[i] = choices[j];
        choices[j] = temp;
      }

      currentProblem = {
        expr: expr,
        ans: ans,
        choices: choices,
        startTime: performance.now()
      };

      equationText.textContent = expr + ' = ?';
      for (var k = 0; k < 4; k++) {
        optTexts[k].textContent = choices[k].toString();
      }
    }

    function handleAnswer(index: number) {
      if (!isRunning || !currentProblem) return;

      var chosen = currentProblem.choices[index];
      var isCorrect = chosen === currentProblem.ans;
      var rt = Math.round(performance.now() - currentProblem.startTime);
      responseTimes.push(rt);

      if (isCorrect) {
        correctCount++;
        streak++;
        if (streak > longestStreak) longestStreak = streak;

        var gained = 10;
        if (streak % 5 === 0) {
          gained += 15;
          if (streakBonusBadge) {
            streakBonusBadge.textContent = 'Runtunan ' + streak + 'x!';
            streakBonusBadge.classList.remove('hidden');
            setTimeout(function() {
              if (streakBonusBadge) streakBonusBadge.classList.add('hidden');
            }, 1000);
          }
        }
        score += gained;
        showFeedback('+' + gained + ' Benar!', true);
      } else {
        wrongCount++;
        streak = 0;
        score = Math.max(0, score - 3);
        showFeedback('-3 Kurang Tepat!', false);
      }

      updateHud();
      generateProblem();
    }

    function updateTimer() {
      if (!isRunning) return;

      var elapsed = performance.now() - startTime;
      remainingMs = Math.max(0, TOTAL_SECONDS * 1000 - elapsed);
      var sec = (remainingMs / 1000).toFixed(1);

      if (sprintTimerText) sprintTimerText.textContent = sec + 's';
      if (sprintProgressBar) {
        var pct = (remainingMs / (TOTAL_SECONDS * 1000)) * 100;
        sprintProgressBar.style.width = pct + '%';
      }

      if (remainingMs <= 0) {
        finishSprint();
      } else {
        timerAnimFrame = requestAnimationFrame(updateTimer);
      }
    }

    function startSprint() {
      if (isRunning) return;
      isRunning = true;
      score = 0;
      streak = 0;
      longestStreak = 0;
      correctCount = 0;
      wrongCount = 0;
      responseTimes = [];
      remainingMs = TOTAL_SECONDS * 1000;
      startTime = performance.now();

      updateHud();

      startOverlay.classList.add('hidden');
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
      if (modalHowToPlay) {
        modalHowToPlay.classList.add('hidden');
        modalHowToPlay.classList.remove('flex');
      }
      if (gameArenaContent) gameArenaContent.removeAttribute('inert');

      generateProblem();
      timerAnimFrame = requestAnimationFrame(updateTimer);
    }

    function finishSprint() {
      isRunning = false;
      cancelAnimationFrame(timerAnimFrame);
      if (gameArenaContent) gameArenaContent.setAttribute('inert', '');

      var totalAttempted = correctCount + wrongCount;
      var accuracyDecimal = totalAttempted > 0 ? correctCount / totalAttempted : 0;
      var accuracyPct = Math.round(accuracyDecimal * 100);
      var medianPaceMs = calculateMedian(responseTimes);
      var medianPaceSec = (medianPaceMs / 1000).toFixed(1);

      var performanceScore = Math.min(100, Math.max(0, Math.round(score / 3.5)));
      var durationSec = TOTAL_SECONDS;

      try {
        saveGameRecord({
          gameId: 'math-sprint',
          durationSeconds: durationSec,
          mode: 'standard',
          metrics: {
            performanceScore: performanceScore,
            accuracy: parseFloat(accuracyDecimal.toFixed(4)),
            trialsCompleted: totalAttempted,
            correctCount: correctCount,
            errorCount: wrongCount,
            medianRT: medianPaceMs,
            bestStreak: longestStreak,
          },
        });
      } catch (err) {
        console.error('Failed to save game record:', err);
      }

      var savedBest = 0;
      try {
        savedBest = parseInt(localStorage.getItem(STORAGE_KEY_V2) || localStorage.getItem(STORAGE_KEY) || '0', 10);
      } catch (e) {}

      var isNewBest = performanceScore > savedBest;
      if (isNewBest) {
        try {
          localStorage.setItem(STORAGE_KEY_V2, performanceScore.toString());
          localStorage.setItem(STORAGE_KEY, performanceScore.toString());
        } catch (e) {}
        loadBestScore();
      }

      modalPerfScore.textContent = performanceScore.toString();

      var tier = getLocalizedTier(performanceScore);
      modalTierBadge.className = 'mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ' + tier.badgeClass;
      modalTierName.textContent = tier.tier;
      modalTierDesc.textContent = tier.description;

      modalAttempted.textContent = totalAttempted.toString();
      modalAcc.textContent = accuracyPct + '%';
      modalPace.textContent = medianPaceSec + 's';
      modalStreak.textContent = longestStreak.toString();

      if (isNewBest && performanceScore > 0) {
        modalBestAlert.classList.remove('hidden');
      } else {
        modalBestAlert.classList.add('hidden');
      }

      modalEndRound.classList.remove('hidden');
      modalEndRound.classList.add('flex');
    }

    btnStartGame.addEventListener('click', startSprint);
    btnModalRestart.addEventListener('click', startSprint);

    optButtons.forEach(function(btn, idx) {
      btn.addEventListener('click', function() {
        handleAnswer(idx);
      });
    });

    btnHowToPlay.addEventListener('click', function() {
      modalHowToPlay.classList.remove('hidden');
      modalHowToPlay.classList.add('flex');
    });

    btnCloseHowModal.addEventListener('click', function() {
      modalHowToPlay.classList.add('hidden');
      modalHowToPlay.classList.remove('flex');
    });

    btnCloseHowGotIt.addEventListener('click', function() {
      modalHowToPlay.classList.add('hidden');
      modalHowToPlay.classList.remove('flex');
    });

    btnCloseEndModal.addEventListener('click', function() {
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
      startOverlay.classList.remove('hidden');
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === ' ' || e.code === 'Space') {
        if (!isRunning) {
          e.preventDefault();
          startSprint();
        }
      } else if (isRunning && (e.key === '1' || e.key === '2' || e.key === '3' || e.key === '4')) {
        e.preventDefault();
        var idx = parseInt(e.key, 10) - 1;
        handleAnswer(idx);
      } else if (e.key === 'Escape') {
        if (modalHowToPlay && !modalHowToPlay.classList.contains('hidden')) {
          modalHowToPlay.classList.add('hidden');
          modalHowToPlay.classList.remove('flex');
        }
        if (modalEndRound && !modalEndRound.classList.contains('hidden')) {
          modalEndRound.classList.add('hidden');
          modalEndRound.classList.remove('flex');
          startOverlay.classList.remove('hidden');
        }
      }
    });
  })();
</script>
