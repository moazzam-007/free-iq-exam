        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            3. Landasan Neurosains
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Pertama kali dipublikasikan oleh J. Ridley Stroop (1935, <em>Journal of Experimental Psychology</em>), efek ini melibatkan aktivasi anterior cingulate cortex (ACC) dan dorsolateral prefrontal cortex (DLPFC).
          </p>
        </div>
      </div>

      <!-- Psychometric Disclaimer Callout -->
      <div class="p-4 sm:p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs sm:text-sm text-amber-900 dark:text-amber-300 leading-relaxed">
        <strong>Catatan Psikometrik Penting:</strong> Skor Stroop Clash mengukur kecepatan reaksi, resolusi konflik persepsi, dan atensi selektif di bawah efek latihan. Skor ini tidak mewakili kecerdasan umum bawaan (<em>g</em>) atau menggantikan asesmen IQ formal.
      </div>

      <!-- Cross Links -->
      <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
            Ingin Evaluasi Kognitif Menyeluruh?
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            Uji kemampuan Penalaran Fluida, Visual-Spasial, Kuantitatif, dan Verbal Anda dengan asesmen 24 soal terstandar kami.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a href="/id/tes-singkat" class="px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-300 transition-colors">Tes Singkat 10m</a>
          <a href="/id/tes" class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-colors shadow-xs">Ujian Lengkap 20m</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { saveGameRecord } from '../../../utils/profileStore';

  function getLocalizedTier(score: number) {
    if (score >= 90) {
      return {
        tier: 'Tingkat Ahli (Master)',
        description: 'Trade-off kecepatan-akurasi hampir optimal; penguasaan strategi tugas dan kelancaran kognitif tingkat tinggi.',
        badgeClass: 'bg-purple-50 text-purple-700 dark:bg-purple-950/60 dark:text-purple-300 border-purple-200 dark:border-purple-800',
      };
    }
    if (score >= 75) {
      return {
        tier: 'Tingkat Mahir (Advanced)',
        description: 'Throughput informasi tinggi; resolusi konflik cepat dan minim distractor drift.',
        badgeClass: 'bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border-blue-200 dark:border-blue-800',
      };
    }
    if (score >= 60) {
      return {
        tier: 'Fondasi Solid (Solid Baseline)',
        description: 'Akurasi konsisten; fokus perhatian stabil dengan sedikit kesalahan acak.',
        badgeClass: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800',
      };
    }
    if (score >= 40) {
      return {
        tier: 'Berkembang (Developing)',
        description: 'Akurasi respons stabil; ritme operasional dasar di bawah batasan waktu.',
        badgeClass: 'bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-800',
      };
    }
    return {
      tier: 'Tahap Awal (Getting Started)',
      description: 'Refleks operasional mulai terbangun; pembiasaan dengan aturan dan ritme respons.',
      badgeClass: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700',
    };
  }

  interface ColorItem {
    name: string;
    label: string;
    textClass: string;
  }

  interface TrialStimulus {
    word: string;
    inkName: string;
    inkClass: string;
    isCongruent: boolean;
  }

  const COLORS: ColorItem[] = [
    { name: 'red', label: 'MERAH', textClass: 'text-red-600 dark:text-red-400' },
    { name: 'blue', label: 'BIRU', textClass: 'text-blue-600 dark:text-blue-400' },
    { name: 'green', label: 'HIJAU', textClass: 'text-emerald-600 dark:text-emerald-400' },
    { name: 'yellow', label: 'KUNING', textClass: 'text-amber-500 dark:text-amber-400' },
  ];

  const TOTAL_TRIALS = 25;
  const CONGRUENT_COUNT = 10;
  const INCONGRUENT_COUNT = 15;
  const STORAGE_KEY = 'fiq_game_stroopclash_best';

  let currentTrialIndex = 0;
  let trialDeck: TrialStimulus[] = [];
  let isRunning = false;
  let isAcceptingInput = false;
  let trialStartTime = 0;
  let sessionStartTime = 0;

  let correctCount = 0;
  let errorCount = 0;
  let currentStreak = 0;
  let longestStreak = 0;

  let allRTs: number[] = [];
  let congruentRTs: number[] = [];
  let incongruentRTs: number[] = [];

  const hudTrial = document.getElementById('hud-trial') as HTMLElement;
  const hudScore = document.getElementById('hud-score') as HTMLElement;
  const hudSpeed = document.getElementById('hud-speed') as HTMLElement;
  const hudBest = document.getElementById('hud-best') as HTMLElement;

  const startOverlay = document.getElementById('start-overlay') as HTMLElement;
  const btnStartGame = document.getElementById('btn-start-game') as HTMLButtonElement;
  const gameArenaContent = document.getElementById('game-arena-content') as HTMLElement;

  const trialCounterText = document.getElementById('trial-counter-text') as HTMLElement;
  const trialProgressBar = document.getElementById('trial-progress-bar') as HTMLElement;
  const stimulusFixation = document.getElementById('stimulus-fixation') as HTMLElement;
  const stimulusWord = document.getElementById('stimulus-word') as HTMLElement;
  const feedbackToast = document.getElementById('feedback-toast') as HTMLElement;

  const btnHowToPlay = document.getElementById('btn-how-to-play') as HTMLButtonElement;
  const modalHowToPlay = document.getElementById('modal-how-to-play') as HTMLElement;
  const btnCloseHowModal = document.getElementById('btn-close-how-modal') as HTMLButtonElement;
  const btnConfirmHow = document.getElementById('btn-confirm-how') as HTMLButtonElement;

  const modalEndRound = document.getElementById('modal-end-round') as HTMLElement;
  const btnCloseEndModal = document.getElementById('btn-close-end-modal') as HTMLButtonElement;
  const modalScore = document.getElementById('modal-score') as HTMLElement;
  const modalTierBadge = document.getElementById('modal-tier-badge') as HTMLElement;
  const modalTierName = document.getElementById('modal-tier-name') as HTMLElement;
  const modalTierDesc = document.getElementById('modal-tier-desc') as HTMLElement;
  const modalAcc = document.getElementById('modal-acc') as HTMLElement;
  const modalRt = document.getElementById('modal-rt') as HTMLElement;
  const modalCost = document.getElementById('modal-cost') as HTMLElement;
  const modalStreak = document.getElementById('modal-streak') as HTMLElement;
  const btnPlayAgain = document.getElementById('btn-play-again') as HTMLButtonElement;

  const btnRed = document.getElementById('btn-color-red') as HTMLButtonElement;
  const btnBlue = document.getElementById('btn-color-blue') as HTMLButtonElement;
  const btnGreen = document.getElementById('btn-color-green') as HTMLButtonElement;
  const btnYellow = document.getElementById('btn-color-yellow') as HTMLButtonElement;

  if (gameArenaContent) gameArenaContent.setAttribute('inert', '');

  function loadBestScore() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && hudBest) {
        hudBest.textContent = saved;
      }
    } catch {}
  }
  loadBestScore();

  function buildTrialDeck() {
    trialDeck = [];
    for (let i = 0; i < CONGRUENT_COUNT; i++) {
      const color = COLORS[Math.floor(Math.random() * COLORS.length)];
      trialDeck.push({
        word: color.label,
        inkName: color.name,
        inkClass: color.textClass,
        isCongruent: true,
      });
    }

    for (let i = 0; i < INCONGRUENT_COUNT; i++) {
      const wordColor = COLORS[Math.floor(Math.random() * COLORS.length)];
      let inkColor = COLORS[Math.floor(Math.random() * COLORS.length)];
      while (inkColor.name === wordColor.name) {
        inkColor = COLORS[Math.floor(Math.random() * COLORS.length)];
      }
      trialDeck.push({
        word: wordColor.label,
        inkName: inkColor.name,
        inkClass: inkColor.textClass,
        isCongruent: false,
      });
    }

    for (let i = trialDeck.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [trialDeck[i], trialDeck[j]] = [trialDeck[j], trialDeck[i]];
    }
  }

  function calculateMedian(arr: number[]): number {
    if (arr.length === 0) return 0;
    const sorted = [...arr].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    return sorted.length % 2 !== 0 ? sorted[mid] : Math.round((sorted[mid - 1] + sorted[mid]) / 2);
  }

  function showToast(text: string, isPositive: boolean) {
    if (!feedbackToast) return;
    feedbackToast.textContent = (isPositive ? '✓ ' : '✗ ') + text;
    feedbackToast.className =
      'h-6 mt-1 text-xs font-mono font-semibold transition-opacity duration-150 ' +
      (isPositive ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400');
    feedbackToast.style.opacity = '1';
    setTimeout(() => {
      if (feedbackToast) feedbackToast.style.opacity = '0';
    }, 400);
  }

  function startNextTrial() {
    if (currentTrialIndex >= TOTAL_TRIALS) {
      endGameSession();
      return;
    }

    isAcceptingInput = false;
    const trial = trialDeck[currentTrialIndex];

    if (trialCounterText) trialCounterText.textContent = `Percobaan ${currentTrialIndex + 1} dari ${TOTAL_TRIALS}`;
    if (trialProgressBar) {
      const pct = Math.round(((currentTrialIndex + 1) / TOTAL_TRIALS) * 100);
      trialProgressBar.style.width = `${pct}%`;
    }
    if (hudTrial) hudTrial.textContent = `${currentTrialIndex + 1} / ${TOTAL_TRIALS}`;

    if (stimulusWord) stimulusWord.classList.add('hidden');
    if (stimulusFixation) stimulusFixation.classList.remove('hidden');

    setTimeout(() => {
      if (!isRunning) return;
      if (stimulusFixation) stimulusFixation.classList.add('hidden');
      if (stimulusWord) {
        stimulusWord.textContent = trial.word;
        stimulusWord.className = `text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-wider transition-all select-none font-heading ${trial.inkClass}`;
        stimulusWord.classList.remove('hidden');
      }
      trialStartTime = performance.now();
      isAcceptingInput = true;
    }, 250);
  }

  function handleColorResponse(chosenColorName: string) {
    if (!isRunning || !isAcceptingInput) return;
    isAcceptingInput = false;

    const responseRT = Math.round(performance.now() - trialStartTime);
    const trial = trialDeck[currentTrialIndex];
    const isCorrect = chosenColorName === trial.inkName;

    allRTs.push(responseRT);
    if (trial.isCongruent) {
      congruentRTs.push(responseRT);
    } else {
      incongruentRTs.push(responseRT);
    }

    if (isCorrect) {
      correctCount++;
      currentStreak++;
      if (currentStreak > longestStreak) longestStreak = currentStreak;
      showToast(`+10 Tepat! (${responseRT}ms)`, true);
    } else {
      errorCount++;
      currentStreak = 0;
      showToast(`-5 Kurang Tepat! (${responseRT}ms)`, false);
    }

    if (hudScore) {
      const runningScore = Math.max(0, correctCount * 10 - errorCount * 5);
      hudScore.textContent = runningScore.toString();
    }
    if (hudSpeed) {
      const currentMedian = calculateMedian(allRTs);
      hudSpeed.textContent = `${currentMedian}ms`;
    }

    currentTrialIndex++;
    setTimeout(() => {
      if (isRunning) startNextTrial();
    }, 350);
  }

  function startSession() {
    if (isRunning) return;
    isRunning = true;
    currentTrialIndex = 0;
    correctCount = 0;
    errorCount = 0;
    currentStreak = 0;
    longestStreak = 0;
    allRTs = [];
    congruentRTs = [];
    incongruentRTs = [];
    sessionStartTime = performance.now();

    buildTrialDeck();

    if (startOverlay) startOverlay.classList.add('hidden');
    if (modalEndRound) {
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
    }
    if (modalHowToPlay) {
      modalHowToPlay.classList.add('hidden');
      modalHowToPlay.classList.remove('flex');
    }
    if (gameArenaContent) gameArenaContent.removeAttribute('inert');

    if (hudTrial) hudTrial.textContent = `1 / ${TOTAL_TRIALS}`;
    if (hudScore) hudScore.textContent = '0';
    if (hudSpeed) hudSpeed.textContent = '0ms';

    startNextTrial();
  }

  function endGameSession() {
    isRunning = false;
    isAcceptingInput = false;
    if (gameArenaContent) gameArenaContent.setAttribute('inert', '');

    const durationSec = Math.max(1, Math.round((performance.now() - sessionStartTime) / 1000));
    const accuracyDecimal = correctCount / TOTAL_TRIALS;
    const accuracyPct = Math.round(accuracyDecimal * 100);

    const medianRT = calculateMedian(allRTs);
    const medianCongruent = calculateMedian(congruentRTs);
    const medianIncongruent = calculateMedian(incongruentRTs);
    const interferenceCost = Math.max(0, medianIncongruent - medianCongruent);

    let speedScore = 0;
    if (medianRT > 0) {
      speedScore = Math.max(0, Math.min(1, (1100 - medianRT) / 600));
    }

    const accuracyWeight = 0.50;
    const speedWeight = 0.35;
    const conflictWeight = 0.15;
    const conflictScore = Math.max(0, Math.min(1, (300 - interferenceCost) / 250));

    const compositeScore = Math.round(
      (accuracyDecimal * accuracyWeight + speedScore * speedWeight + conflictScore * conflictWeight) * 100
    );
    const finalScore = Math.max(5, Math.min(100, compositeScore));

    try {
      saveGameRecord({
        gameId: 'stroop-clash',
        durationSeconds: durationSec,
        mode: 'standard',
        metrics: {
          performanceScore: finalScore,
          accuracy: parseFloat(accuracyDecimal.toFixed(4)),
          trialsCompleted: TOTAL_TRIALS,
          correctCount,
          errorCount,
          medianRT,
          bestStreak: longestStreak,
          interferenceCostMs: interferenceCost,
        },
      });
    } catch (err) {
      console.error('Failed to save game record:', err);
    }

    try {
      const saved = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
      if (finalScore > saved) {
        localStorage.setItem(STORAGE_KEY, finalScore.toString());
        loadBestScore();
      }
    } catch {}

    if (modalScore) modalScore.textContent = finalScore.toString();
    if (modalAcc) modalAcc.textContent = `${accuracyPct}%`;
    if (modalRt) modalRt.textContent = `${medianRT}ms`;
    if (modalCost) modalCost.textContent = `${interferenceCost}ms`;
    if (modalStreak) modalStreak.textContent = longestStreak.toString();

    const tier = getLocalizedTier(finalScore);
    if (modalTierBadge) {
      modalTierBadge.className = `mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${tier.badgeClass}`;
    }
    if (modalTierName) modalTierName.textContent = tier.tier;
    if (modalTierDesc) modalTierDesc.textContent = tier.description;

    if (modalEndRound) {
      modalEndRound.classList.remove('hidden');
      modalEndRound.classList.add('flex');
    }
  }

  btnStartGame?.addEventListener('click', startSession);
  btnPlayAgain?.addEventListener('click', startSession);

  btnRed?.addEventListener('click', () => handleColorResponse('red'));
  btnBlue?.addEventListener('click', () => handleColorResponse('blue'));
  btnGreen?.addEventListener('click', () => handleColorResponse('green'));
  btnYellow?.addEventListener('click', () => handleColorResponse('yellow'));

  btnHowToPlay?.addEventListener('click', () => {
    modalHowToPlay?.classList.remove('hidden');
    modalHowToPlay?.classList.add('flex');
  });
  btnCloseHowModal?.addEventListener('click', () => {
    modalHowToPlay?.classList.add('hidden');
    modalHowToPlay?.classList.remove('flex');
  });
  btnConfirmHow?.addEventListener('click', () => {
    modalHowToPlay?.classList.add('hidden');
    modalHowToPlay?.classList.remove('flex');
  });

  btnCloseEndModal?.addEventListener('click', () => {
    modalEndRound?.classList.add('hidden');
    modalEndRound?.classList.remove('flex');
    startOverlay?.classList.remove('hidden');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === ' ' || e.code === 'Space') {
      if (!isRunning) {
        e.preventDefault();
        startSession();
      }
    } else if (isRunning && isAcceptingInput) {
      const k = e.key.toLowerCase();
      if (k === '1' || k === 'r' || k === 'm') {
        e.preventDefault();
        handleColorResponse('red');
      } else if (k === '2' || k === 'b') {
        e.preventDefault();
        handleColorResponse('blue');
      } else if (k === '3' || k === 'g' || k === 'h') {
        e.preventDefault();
        handleColorResponse('green');
      } else if (k === '4' || k === 'y' || k === 'k') {
        e.preventDefault();
        handleColorResponse('yellow');
      }
    } else if (e.key === 'Escape') {
      if (modalHowToPlay && !modalHowToPlay.classList.contains('hidden')) {
        modalHowToPlay.classList.add('hidden');
        modalHowToPlay.classList.remove('flex');
      }
      if (modalEndRound && !modalEndRound.classList.contains('hidden')) {
        modalEndRound.classList.add('hidden');
        modalEndRound.classList.remove('flex');
        startOverlay?.classList.remove('hidden');
      }
    }
  });
</script>
