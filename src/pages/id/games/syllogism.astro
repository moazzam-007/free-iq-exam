---
import LayoutId from '../../../components/id/LayoutId.astro';
import HeaderId from '../../../components/id/HeaderId.astro';
import FooterId from '../../../components/id/FooterId.astro';

const title = "Tes Penalaran Deduktif Online Gratis - Logika Silogisme Cepat | FreeIQExam";
const description = "Uji kecepatan penalaran deduktif formal online gratis. Evaluasi silogisme kategoris dan validitas logika di bawah batas waktu berdasarkan Aristoteles & Johnson-Laird.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Silogisme Kilat - Uji Kecepatan Logika Deduktif",
    "url": "https://freeiqexam.com/id/permainan/silogisme",
    "description": "Uji kecepatan penalaran deduktif formal online gratis. Evaluasi silogisme kategoris dan validitas logika di bawah batas waktu berdasarkan Aristoteles & Johnson-Laird.",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan Kognitif",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Silogisme Kilat",
        "item": "https://freeiqexam.com/id/permainan/silogisme"
      }
    ]
  }
];
---

<LayoutId title={title} description={description} schema={jsonLd} enPath="/games/syllogism" canonicalUrl="https://freeiqexam.com/id/permainan/silogisme" robots="noindex, follow">
  <HeaderId enPath="/games/syllogism" />

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <a href="/id/permainan" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Permainan Kognitif</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Silogisme Kilat</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-peach mb-1.5">
          Gc &amp; Gf &bull; Logika Deduktif
        </div>
        <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
          Silogisme Kilat
        </h1>
      </div>

      <!-- Stat HUD + Help Button -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <button
          id="btn-how-to-play"
          type="button"
          aria-label="Petunjuk cara bermain"
          class="min-h-[44px] px-3 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/90 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-sans font-semibold text-xs sm:text-sm flex items-center gap-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <span class="font-bold font-mono text-amber-600 dark:text-amber-400">(?)</span>
          <span>Cara Bermain</span>
        </button>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Soal</div>
          <div id="hud-item" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 15</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Skor</div>
          <div id="hud-score" class="font-bold text-amber-600 dark:text-amber-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Waktu Rata-rata</div>
          <div id="hud-avg-time" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0.0s</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Terbaik</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-peach flex items-center justify-center mb-5 shadow-lg shadow-amber-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.508 1.333 1.508 2.316V18" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Latihan Logika Silogisme
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Anda akan diberikan dua premis dasar dan satu usulan kesimpulan.
          </p>
          <p>
            Tentukan apakah kesimpulan tersebut <strong>Valid</strong> (secara mutlak harus benar mengikuti premis) atau <strong>Tidak Valid</strong> (tidak dapat dibuktikan atau mengandung kekeliruan logika).
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            15 silogisme, batas waktu 15 detik per soal. &lt;5s = +20 poin, &lt;10s = +15 poin, &lt;15s = +10 poin. Salah = -5 poin.
          </p>
        </div>
        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-amber-600 hover:bg-amber-500 text-white font-heading font-bold text-base shadow-md transition-all duration-150 hover:scale-105 active:scale-95 flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <span>Mulai Latihan Logika (Spasi)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content -->
      <div id="game-arena-content" class="w-full flex flex-col items-center">
        <!-- Per-Item Countdown Bar -->
        <div class="w-full max-w-xl mb-6">
          <div class="flex items-center justify-between text-xs font-mono font-semibold mb-2">
            <span class="text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Pengatur Waktu Soal</span>
            <span id="trial-timer-text" class="text-sm font-bold text-amber-600 dark:text-amber-400">15.0s</span>
          </div>
          <div class="w-full h-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden border border-zinc-200 dark:border-zinc-700/60">
            <div id="trial-progress-bar" class="h-full bg-amber-500 rounded-full transition-all duration-75 ease-linear" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Syllogism Premises Card -->
        <div class="w-full max-w-xl p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/80 shadow-inner mb-8">
          <div class="space-y-4">
            <!-- Premise 1 -->
            <div class="flex items-start gap-3">
              <span class="px-2.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 font-mono font-bold text-xs shrink-0 mt-0.5">P1</span>
              <p id="premise-1-text" class="text-sm sm:text-base text-zinc-800 dark:text-zinc-200 font-medium leading-relaxed">
                Memuat Premis 1...
              </p>
            </div>

            <!-- Premise 2 -->
            <div class="flex items-start gap-3">
              <span class="px-2.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 font-mono font-bold text-xs shrink-0 mt-0.5">P2</span>
              <p id="premise-2-text" class="text-sm sm:text-base text-zinc-800 dark:text-zinc-200 font-medium leading-relaxed">
                Memuat Premis 2...
              </p>
            </div>

            <!-- Divider with Conclusion Tag -->
            <div class="pt-4 mt-2 border-t border-zinc-200 dark:border-zinc-700/60 flex items-start gap-3">
              <span class="px-2.5 py-1 rounded-lg bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 font-mono font-bold text-xs shrink-0 mt-0.5">K</span>
              <p id="conclusion-text" class="text-base sm:text-lg text-zinc-950 dark:text-white font-heading font-bold leading-relaxed">
                Memuat Kesimpulan...
              </p>
            </div>
          </div>
        </div>

        <!-- Action Response Buttons -->
        <div class="w-full max-w-xl grid grid-cols-2 gap-4">
          <button
            id="btn-valid"
            type="button"
            class="min-h-[56px] py-4 px-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border-2 border-emerald-500 hover:border-emerald-600 dark:hover:border-emerald-400 text-emerald-700 dark:text-emerald-300 font-heading font-bold text-sm sm:text-base transition-all duration-100 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 active:scale-95 flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span>VALID</span>
            <span class="text-xs font-mono font-normal opacity-75 mt-0.5">Tombol [ V ]</span>
          </button>

          <button
            id="btn-invalid"
            type="button"
            class="min-h-[56px] py-4 px-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border-2 border-rose-500 hover:border-rose-600 dark:hover:border-rose-400 text-rose-700 dark:text-rose-300 font-heading font-bold text-sm sm:text-base transition-all duration-100 hover:bg-rose-100 dark:hover:bg-rose-900/50 active:scale-95 flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-600 cursor-pointer"
          >
            <span>TIDAK VALID</span>
            <span class="text-xs font-mono font-normal opacity-75 mt-0.5">Tombol [ I ]</span>
          </button>
        </div>
      </div>
    </div>

    <!-- How to Play Instructions Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4"
    >
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-left relative max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-how-modal"
          type="button"
          aria-label="Tutup petunjuk cara bermain"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
          </div>
          <div>
            <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
              Cara Bermain Silogisme Kilat
            </h2>
            <p class="text-xs text-amber-600 dark:text-amber-400 font-medium">Aktivitas Penalaran Fluida (Gf)</p>
          </div>
        </div>

        <div class="space-y-4 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Mekanika Permainan</h4>
            <p>1. Di setiap soal, Anda disajikan dua premis (P1 dan P2) dan satu kesimpulan usulan (K).</p>
            <p>2. Evaluasi logika deduktif secara ketat: Apakah kesimpulan tersebut <strong>pasti benar</strong> jika kedua premis dianggap benar?</p>
            <p>3. Tekan <strong>VALID [V]</strong> jika argumen tersebut logis sesuai aturan deduksi formal.</p>
            <p>4. Tekan <strong>TIDAK VALID [I]</strong> jika argumen mengandung kekeliruan formal (misal term tengah tidak terdistribusi, illicit major/minor).</p>
            <p>5. Selesaikan 15 soal dengan batas waktu 15 detik per soal. Deduksi yang lebih cepat memperoleh bonus skor yang lebih tinggi.</p>
          </div>

          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Kontrol Keyboard</h4>
            <ul class="space-y-1 text-xs font-mono">
              <li>• <span class="font-bold text-zinc-900 dark:text-white">[Spasi]</span> : Mulai latihan / Ulangi</li>
              <li>• <span class="font-bold text-emerald-600 dark:text-emerald-400">[V]</span> : Argumen VALID secara deduktif</li>
              <li>• <span class="font-bold text-rose-600 dark:text-rose-400">[I]</span> : Argumen TIDAK VALID secara deduktif</li>
              <li>• <span class="font-bold text-zinc-900 dark:text-white">[Escape]</span> : Tutup dialog</li>
            </ul>
          </div>

          <div class="p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-xs">
            <span class="font-bold text-amber-950 dark:text-amber-200">Fondasi Ilmiah:</span>
            <span class="text-amber-900 dark:text-amber-300 ml-1">Paradigma Penalaran Deduktif Silogistis Aristotelian. Melibatkan evaluasi validitas formal, integrasi premis memori kerja, dan penalaran logika fluida (Gf).</span>
          </div>
        </div>

        <button
          id="btn-close-how-got-it"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-heading font-bold text-sm shadow-md transition-all duration-150 hover:scale-101 active:scale-99 flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <span>Paham, Mulai Bermain</span>
        </button>
      </div>
    </div>

    <!-- End of Round Modal -->
    <div id="modal-end-round" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-center relative max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-end-modal"
          type="button"
          aria-label="Tutup ringkasan sesi"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-600 dark:bg-amber-950/60 dark:text-amber-400 flex items-center justify-center mx-auto mb-3">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.493 1.508 1.333 1.508 2.316V18" />
          </svg>
        </div>

        <h2 id="modal-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Latihan Logika Selesai!
        </h2>
        <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-4">
          Ringkasan Kinerja Penalaran Deduktif
        </p>

        <!-- Standardized 0-100 Task Performance Score -->
        <div class="mb-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-800">
          <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            Skor Kinerja Tugas
          </div>
          <div class="flex items-baseline justify-center gap-1.5 my-1">
            <span id="modal-perf-score" class="text-4xl sm:text-5xl font-extrabold font-heading text-zinc-950 dark:text-white">0</span>
            <span class="text-sm font-mono text-zinc-400">/ 100</span>
          </div>
          <div id="modal-tier-badge" class="mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border">
            <span id="modal-tier-name">Fondasi Kuat</span>
          </div>
          <p id="modal-tier-desc" class="mt-2 text-xs text-zinc-600 dark:text-zinc-400 max-w-sm mx-auto leading-relaxed"></p>
        </div>

        <!-- Paradigm-Specific Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Akurasi</div>
            <div id="modal-acc" class="font-bold text-base text-emerald-600 dark:text-emerald-400">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Median RT</div>
            <div id="modal-speed" class="font-bold text-base text-amber-600 dark:text-amber-400">0.0s</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Rincian</div>
            <div id="modal-breakdown" class="font-bold text-base text-zinc-900 dark:text-white">0 V / 0 S</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Runtutan Terbaik</div>
            <div id="modal-streak" class="font-bold text-base text-amber-500">0</div>
          </div>
        </div>

        <!-- Transparent Scoring Formula Card -->
        <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 text-left mb-4">
          <div class="text-[11px] font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider font-mono mb-1">
            Rincian Penilaian
          </div>
          <p class="text-xs font-mono text-amber-600 dark:text-amber-400 font-semibold mb-1">
            Skor = (Akurasi Deduksi * 75) + Bonus Kecepatan Deduksi (hingga 25 poin)
          </p>
