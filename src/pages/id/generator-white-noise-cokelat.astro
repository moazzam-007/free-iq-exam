---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
const title = 'Generator White Noise dan Brown Noise | FreeIQExam';
const description = 'Buat brown noise, pink noise, white noise, binaural beats, dan suara ambient secara lokal di browser.';
const canonicalUrl = 'https://freeiqexam.com/id/generator-white-noise-cokelat';
---
<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/brown-noise">
  <Header currentPath="/id/generator-white-noise-cokelat" enPath="/brown-noise" />
  <main class="flex-1 bg-white px-4 py-10 text-zinc-950 dark:bg-black dark:text-white sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><header class="mb-8 text-center"><span class="fx-tag">Audio dan tidur</span><h1 class="mt-5 text-4xl font-extrabold tracking-[-0.025em] sm:text-5xl">Generator Brown Noise</h1><p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">Atur suara brown, pink, dan white noise serta ambience untuk fokus, relaksasi, atau tidur.</p></header><section class="rounded-3xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-950 sm:p-8"><canvas id="visualizerCanvas" class="h-[200px] w-full rounded-2xl bg-zinc-900"></canvas><div class="mt-6 flex flex-wrap gap-3"><button id="masterPlayBtn" type="button" class="min-h-[44px] rounded-full bg-[#0066cc] px-6 py-3 font-semibold text-white dark:bg-[#2997ff]"><span id="masterPlayText">Mulai suara</span></button><label class="flex min-h-[44px] items-center gap-3">Volume<input id="masterVolumeSlider" type="range" min="0" max="1" step="0.01" value="0.5" /></label></div><div class="mt-6 grid gap-4 sm:grid-cols-2"><label>Brown noise<input id="noiseVolSlider" type="range" min="0" max="1" step="0.01" value="0.5" class="mt-2 w-full" /></label><label>Binaural beats<input id="binauralVolSlider" type="range" min="0" max="1" step="0.01" value="0" class="mt-2 w-full" /></label><label>Hujan<input id="rainVolSlider" type="range" min="0" max="1" step="0.01" value="0" class="mt-2 w-full" /></label><label>Ombak<input id="oceanVolSlider" type="range" min="0" max="1" step="0.01" value="0" class="mt-2 w-full" /></label></div><div class="hidden"><button id="floatingPlayBtn" type="button"></button><span id="masterPlayIcon"></span><span id="floatingBar"></span><span id="timerCountdownDisplay"></span><input id="thunderVolSlider" value="0" /><input id="fanVolSlider" value="0" /></div></section></div></main><Footer /><script src="../../scripts/tools/brown-noise-engine.js"></script>
</Layout>
