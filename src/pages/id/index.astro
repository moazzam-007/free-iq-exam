          return '<div class="p-5 sm:p-6 bg-white dark:bg-black rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 w-full max-w-[280px] sm:max-w-[320px] aspect-square flex flex-col justify-center shadow-sm">' +
            '<div class="space-y-2.5 text-xs sm:text-sm font-sans">' +
              '<div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200">' +
                '<span class="font-mono font-bold text-blue-600 dark:text-blue-400">P1:</span> All matrix puzzles require spatial reasoning.' +
              '</div>' +
              '<div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200">' +
                '<span class="font-mono font-bold text-blue-600 dark:text-blue-400">P2:</span> Some cognitive screening tasks are matrix puzzles.' +
              '</div>' +
              '<div class="p-2.5 rounded-xl bg-blue-50/60 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/80 text-blue-950 dark:text-blue-200 font-semibold">' +
                '<span class="font-mono font-bold text-blue-600 dark:text-blue-400">C:</span> Some cognitive screening tasks require spatial reasoning.' +
              '</div>' +
            '</div>' +
          '</div>';
        },
        options: [
          { label: 'A', content: '<span class="font-medium text-xs sm:text-sm text-zinc-900 dark:text-white">Valid Secara Logis (Benar)</span>', isCorrect: true },
          { label: 'B', content: '<span class="font-medium text-xs sm:text-sm text-zinc-900 dark:text-white">Tidak Valid Secara Logis (Salah)</span>', isCorrect: false },
          { label: 'C', content: '<span class="font-medium text-xs sm:text-sm text-zinc-900 dark:text-white">Indeterminate (Uncertain)</span>', isCorrect: false }
        ],
        rule: 'Silogisme kategoris Aristoteles yang valid (Mood Darii: Semua M adalah P; Sebagian S adalah M; maka Sebagian S adalah P). Setiap tugas kognitif berupa puzzle matriks pasti mewarisi sifat spasial.',
        hint: 'Apakah subset tugas pada Premis 2 pasti mewarisi aturan universal pada Premis 1?'
      },
      {
        id: 5,
        domainBadge: 'Penalaran Fluida (Gf)',
        subtypeText: 'Aturan Superposisi XOR Boolean',
        promptText: 'Pada setiap baris, Kolom 3 dibentuk dengan menggabungkan Kolom 1 dan 2 memakai aturan pembatalan XOR. Pilih ubin yang benar:',
        renderStimulus: function() {
          return '<div class="grid grid-cols-3 gap-2 sm:gap-3 p-3 sm:p-4 bg-white dark:bg-black rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 w-full max-w-[280px] sm:max-w-[320px] aspect-square shadow-sm">' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/><line x1="6" y1="20" x2="34" y2="20"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="6" y1="20" x2="34" y2="20"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="6" y1="20" x2="34" y2="20"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/><line x1="6" y1="20" x2="34" y2="20"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/></svg></div>' +
            '<div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 p-2"><svg viewBox="0 0 40 40" class="w-8 h-8 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/><line x1="8" y1="8" x2="32" y2="32"/></svg></div>' +
            '<div class="bg-blue-50/70 dark:bg-blue-950/40 rounded-xl flex items-center justify-center border-2 border-dashed border-blue-500 animate-pulse"><span class="font-heading font-black text-3xl text-blue-600 dark:text-blue-400">?</span></div>' +
          '</div>';
        },
        options: [
          { label: 'A', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="8" x2="32" y2="32"/></svg></div>', isCorrect: true },
          { label: 'B', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/></svg></div>', isCorrect: false },
          { label: 'C', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="8" y1="32" x2="32" y2="8"/><line x1="8" y1="8" x2="32" y2="32"/></svg></div>', isCorrect: false },
          { label: 'D', content: '<div class="h-8 flex items-center justify-center"><svg viewBox="0 0 40 40" class="w-7 h-7 stroke-blue-600" stroke-width="3" stroke-linecap="round"><line x1="20" y1="6" x2="20" y2="34"/><line x1="6" y1="20" x2="34" y2="20"/></svg></div>', isCorrect: false }
        ],
        rule: 'Superposisi Exclusive OR (XOR): Segmen identik yang muncul di KEDUA kolom saling membatalkan, sementara segmen unik tetap. Pada Baris 3, garis miring / saling membatalkan, menyisakan hanya backslash \\.',
        hint: 'Perhatikan garis identik pada Kolom 1 dan Kolom 2 menghilang pada Kolom 3.'
      }
    ];

    var currentSampleIdx = 0;
    var userResponses = {}; // index -> { optionLabel, isCorrect }

    // Elements
    var domainBadge = document.getElementById('sample-domain-badge');
    var subtypeText = document.getElementById('sample-subtype-text');
    var counterText = document.getElementById('sample-counter-text');
    var promptText = document.getElementById('sample-prompt-text');
    var stimulusBox = document.getElementById('sample-stimulus-box');
    var optionsContainer = document.getElementById('sample-options-container');
    var feedbackBox = document.getElementById('demo-feedback');
    var btnAdvance = document.getElementById('btn-sample-advance');
    var btnAdvanceText = document.getElementById('btn-sample-advance-text');
    var btnPrev = document.getElementById('btn-sample-prev');
    var btnNext = document.getElementById('btn-sample-next');
    var completionBanner = document.getElementById('sample-completion-banner');

    function updateStepperUI() {
      for (var i = 0; i < SAMPLE_ITEMS.length; i++) {
        var dot = document.getElementById('step-dot-' + i);
        if (!dot) continue;
        if (i === currentSampleIdx) {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        } else if (userResponses[i]) {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 hover:bg-emerald-100 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        } else {
          dot.className = 'sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600';
        }
      }

      if (btnPrev) btnPrev.disabled = currentSampleIdx === 0;
      if (btnNext) btnNext.disabled = currentSampleIdx === SAMPLE_ITEMS.length - 1;
    }

    function renderActiveQuestion() {
      var item = SAMPLE_ITEMS[currentSampleIdx];
      if (!item) return;

      if (domainBadge) domainBadge.textContent = item.domainBadge;
      if (subtypeText) subtypeText.textContent = item.subtypeText;
      if (counterText) counterText.textContent = 'Soal ' + (currentSampleIdx + 1) + ' dari ' + SAMPLE_ITEMS.length;
      if (promptText) promptText.textContent = item.promptText;

      if (stimulusBox) {
        stimulusBox.innerHTML = item.renderStimulus();
      }

      if (optionsContainer) {
        optionsContainer.innerHTML = '';
        var answered = userResponses[currentSampleIdx];

        item.options.forEach(function(opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-option', opt.label);
          btn.setAttribute('data-correct', String(opt.isCorrect));
          btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-1.5 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer';

          // Apply state if already answered
          if (answered) {
            if (answered.optionLabel === opt.label) {
              if (opt.isCorrect) {
                btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-50/70 dark:bg-emerald-950/40 flex flex-col items-center justify-center gap-1.5 transition-all';
              } else {
                btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl border-2 border-rose-500 bg-rose-50/70 dark:bg-rose-950/40 flex flex-col items-center justify-center gap-1.5 transition-all';
              }
            } else if (opt.isCorrect && !answered.isCorrect) {
              btn.className = 'option-btn min-h-[52px] p-3 sm:p-4 rounded-2xl border-2 border-dashed border-emerald-500 bg-emerald-50/30 dark:bg-emerald-950/20 flex flex-col items-center justify-center gap-1.5 transition-all';
            }
          }

          var labelSpan = '<span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">' + opt.label + '</span>';
          btn.innerHTML = labelSpan + opt.content;

          btn.addEventListener('click', function() {
            handleOptionSelect(opt.label, opt.isCorrect, item);
          });

          optionsContainer.appendChild(btn);
        });
      }

      // Restore feedback box state
      if (feedbackBox) {
        var answeredState = userResponses[currentSampleIdx];
        if (answeredState) {
          renderFeedback(answeredState.optionLabel, answeredState.isCorrect, item);
        } else {
          feedbackBox.textContent = 'Select an option above to verify your solution.';
          feedbackBox.className = 'mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all';
          if (btnAdvance) btnAdvance.classList.add('hidden');
        }
      }

      updateStepperUI();
    }

    function renderFeedback(label, isCorrect, item) {
      if (!feedbackBox) return;
      feedbackBox.classList.remove('animate-fade-in');
      void feedbackBox.offsetWidth;

      if (isCorrect) {
        feedbackBox.innerHTML = '<div class="text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400 mb-1">Benar! Opsi ' + label + ' adalah solusi tepat.</div>' +
          '<div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">' + item.rule + '</div>';
        feedbackBox.className = 'mt-5 p-4 sm:p-5 rounded-2xl bg-emerald-50/60 dark:bg-emerald-950/30 border border-emerald-300 dark:border-emerald-800 text-center animate-fade-in transition-all';
      } else {
        feedbackBox.innerHTML = '<div class="text-sm sm:text-base font-bold text-rose-600 dark:text-rose-400 mb-1">Opsi ' + label + ' kurang tepat.</div>' +
          '<div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">' + item.hint + '</div>' +
          '<div class="mt-2 text-xs text-zinc-500 dark:text-zinc-400 font-mono">' + item.rule + '</div>';
        feedbackBox.className = 'mt-5 p-4 sm:p-5 rounded-2xl bg-rose-50/60 dark:bg-rose-950/30 border border-rose-300 dark:border-rose-800 text-center animate-fade-in transition-all';
      }

      // Show advance action button
      if (btnAdvance) {
        btnAdvance.classList.remove('hidden');
        btnAdvance.classList.add('flex');
        if (btnAdvanceText) {
          if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
            btnAdvanceText.textContent = 'Contoh Berikutnya (' + (currentSampleIdx + 2) + '/5)';
          } else {
            btnAdvanceText.textContent = 'Jelajah Selesai - Ikuti Tes Lengkap';
          }
        }
      }
    }

    function handleOptionSelect(label, isCorrect, item) {
      userResponses[currentSampleIdx] = { optionLabel: label, isCorrect: isCorrect };
      renderActiveQuestion();

      // Check if all 5 answered
      var answeredCount = Object.keys(userResponses).length;
      if (answeredCount >= SAMPLE_ITEMS.length && completionBanner) {
        completionBanner.classList.remove('hidden');
        completionBanner.classList.add('flex');
      }
    }

    // Step button event listeners
    for (var s = 0; s < SAMPLE_ITEMS.length; s++) {
      (function(idx) {
        var dot = document.getElementById('step-dot-' + idx);
        if (dot) {
          dot.addEventListener('click', function() {
            currentSampleIdx = idx;
            renderActiveQuestion();
          });
        }
      })(s);
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        if (currentSampleIdx > 0) {
          currentSampleIdx--;
          renderActiveQuestion();
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
          currentSampleIdx++;
          renderActiveQuestion();
        }
      });
    }

    if (btnAdvance) {
      btnAdvance.addEventListener('click', function() {
        if (currentSampleIdx < SAMPLE_ITEMS.length - 1) {
          currentSampleIdx++;
          renderActiveQuestion();
        } else {
          window.location.href = '/test';
        }
      });
    }

    // Initial render
    renderActiveQuestion();
  })();

  // Scroll Reveal Observer for Homepage Sections
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var revealEls = document.querySelectorAll('.reveal-on-scroll');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    revealEls.forEach(function(el) { observer.observe(el); });
  } else {
    var allEls = document.querySelectorAll('.reveal-on-scroll');
    for (var e = 0; e < allEls.length; e++) {
      allEls[e].classList.add('revealed');
    }
  }
</script>