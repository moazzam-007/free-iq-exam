---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Tes IQ Gratis Online: Hasil Langsung & Tanpa Email | FreeIQExam";
const description = "Ikuti tes IQ gratis online dengan hasil langsung. Kerjakan soal penalaran kognitif di browser, lihat skor IQ dan persentil, tanpa daftar, tanpa email, tanpa pembayaran atau kartu kredit.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FreeIQExam Indonesia",
    "url": "https://freeiqexam.com/id",
    "description": "Platform asesmen kognitif berbasis sains psikometri modern tanpa paywall dan hasil langsung keluar."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/id",
    "logo": "https://freeiqexam.com/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "Platform psikometri terbuka berorientasi privasi yang menyediakan asesmen kognitif berbasis riset tanpa biaya."
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Asesmen Kognitif FreeIQExam",
    "url": "https://freeiqexam.com/id",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Tes kognitif 24 butir soal terstandarisasi berbasis Teori Respons Butir 2PL (IRT). Estimasi skor skala IQ instan beserta peringkat persentil populasi.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": "Tes IQ 24 soal 4 domain CHC, penilaian 2PL IRT, hasil instan tanpa paywall, tanpa perlu email"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apakah tes IQ ini gratis dan hasilnya langsung keluar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Anda dapat mengerjakan tes IQ gratis online langsung di browser. Setelah selesai, halaman hasil menampilkan estimasi skor IQ, persentil populasi, dan ringkasan performa tanpa meminta kartu kredit atau pembayaran."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah ada tes IQ online gratis tanpa daftar atau email?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Tes dapat dimulai tanpa membuat akun dan tanpa memasukkan alamat email. Fokus utama kami adalah memberi Anda cara sederhana untuk mengerjakan tes IQ online tanpa langkah pendaftaran yang tidak diperlukan."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara mengetahui IQ sendiri secara online?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pilih Tes Lengkap untuk 24 soal atau Skrining Cepat untuk 12 soal, baca petunjuk, lalu jawab setiap soal sebaik mungkin. Setelah dikirim, sistem menampilkan estimasi skor IQ dan persentil sehingga Anda dapat melihat posisi skor pada distribusi standar."
        }
      },
      {
        "@type": "Question",
        "name": "Apa saja yang termasuk dalam soal tes IQ ini?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bank soal mencakup penalaran fluida, pemrosesan visual-spasial, penalaran kuantitatif, dan pemahaman verbal. Contohnya meliputi pola matriks, rotasi objek, deret angka, dan hubungan verbal."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah tes IQ ini sama dengan tes IQ resmi dari psikolog?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak. FreeIQExam ditujukan untuk skrining dan evaluasi diri edukatif. Hasilnya tidak menggantikan asesmen klinis atau pemeriksaan psikologis berpengawas seperti baterai klinis yang diberikan oleh psikolog berlisensi."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa lama waktu yang dibutuhkan untuk tes IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tes lengkap memiliki batas waktu 20 menit untuk 24 soal, sedangkan skrining cepat menggunakan 12 soal dengan batas waktu 10 menit."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah latihan dapat membantu performa pada tes IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Latihan dapat membantu Anda lebih terbiasa dengan pola, strategi, dan ritme pengerjaan. Peningkatan skor pada tes latihan tidak otomatis berarti perubahan kemampuan intelektual dasar, sehingga hasil sebaiknya dibaca sebagai estimasi performa pada instrumen tertentu."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- Shared Global Navigation Header -->
  <Header currentPath="/id" enPath="/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">
    <!-- HERO SECTION (Pure White Background + Monumental Apple Scale) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center reveal-on-scroll">
        <!-- Vercel-Style Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 shadow-2xs mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span class="hidden sm:inline">ASESMEN 4 DOMAIN CHC: FLUIDA, SPASIAL, KUANTITATIF, VERBAL</span>
          <span class="sm:hidden">ASESMEN 4 DOMAIN CHC</span>
        </div>

        <!-- Monumental Display H1 (Apple Monochrome Typography) -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Tes IQ Gratis Online.<br />
          <span class="text-blue-600 dark:text-blue-500">
            Hasil Langsung Keluar.
          </span>
        </h1>

        <!-- High-Legibility Subtitle -->
        <p class="text-lg sm:text-2xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-normal">
          Cari tahu kemampuan penalaran Anda melalui tes IQ online dengan soal logika, pola, angka, visual, dan verbal. Lihat estimasi skor IQ dan persentil setelah selesai, <strong class="text-zinc-950 dark:text-white font-semibold">gratis, tanpa daftar, tanpa email, tanpa pembayaran.</strong>
        </p>

        <!-- Large Tactile Action Buttons - Dual Track -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
          <a 
            href="/id/tes" 
            class="w-full sm:w-auto px-9 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3"
          >
            <span>Tes Lengkap (20 Mnt)</span>
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a 
            href="/id/tes-singkat" 
            class="w-full sm:w-auto px-8 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Skrining Cepat (10 Mnt)</span>
          </a>
        </div>

        <!-- Clean 4-Bullet Trust Strip -->
        <div class="flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-sm sm:text-base font-medium text-zinc-600 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Hasil Langsung Keluar</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Tanpa Butuh Email</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Skor Rerata 100, SD 15</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>100% Gratis Tanpa Paywall</span>
          </div>
        </div>

        <!-- Transparent Scope Disclosure -->
        <div class="mt-8 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 text-xs font-medium text-zinc-700 dark:text-zinc-300">
          <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400"></span>
          <span>Mengevaluasi Penalaran Fluida (Gf) &amp; Pemrosesan Visual (Gv)</span>
        </div>
      </div>
    </section>

    <!-- Value Propositions Section -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
          <h2 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">Tes IQ gratis dengan hasil langsung</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Kerjakan soal langsung di browser dan lihat estimasi skor serta persentil setelah tes selesai. Tidak perlu menunggu email atau membuka pembayaran.
          </p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
          <h2 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">Soal tes IQ dari beberapa jenis</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Latihan mencakup pola matriks, logika, angka, visual-spasial, dan pemahaman verbal sehingga Anda tidak hanya bergantung pada satu tipe soal.
          </p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
          <h2 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">Tanpa daftar dan tanpa email</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mulai tes tanpa membuat akun. Hasil ditampilkan setelah pengerjaan sehingga alurnya tetap sederhana dari soal sampai laporan.
          </p>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE 5-ITEM COGNITIVE SAMPLE -->
    <section id="demo-puzzle" class="py-14 sm:py-18 bg-zinc-50 dark:bg-zinc-950/60 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 reveal-on-scroll">
        <!-- Section Header -->
        <div class="text-center mb-8 sm:mb-10">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
            Contoh Soal Interaktif
          </div>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-zinc-950 dark:text-white mt-1 tracking-tight">
            Uji Penalaran Kognitif Anda
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl mx-auto">
            Rasakan 5 contoh soal terkalibrasi di seluruh domain kecerdasan Fluida, Spasial, Kuantitatif, dan Verbal.
          </p>

          <!-- Stepper Navigation Pills -->
          <div class="flex items-center justify-center gap-2 sm:gap-3 mt-6" aria-label="Sample questions stepper">
            <button
              type="button"
              id="step-dot-0"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-bold transition-all bg-blue-600 text-white shadow-xs cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 1"
            >
              1. Matriks
            </button>
            <button
              type="button"
              id="step-dot-1"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 2"
            >
              2. 3D Cube
            </button>
            <button
              type="button"
              id="step-dot-2"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 3"
            >
              3. Series
            </button>
            <button
              type="button"
              id="step-dot-3"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 4"
            >
              4. Logika
            </button>
            <button
              type="button"
              id="step-dot-4"
              class="sample-step-btn min-h-[44px] min-w-[44px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-mono font-semibold transition-all bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
              aria-label="Jump to sample question 5"
            >
              5. XOR Rule
            </button>
          </div>
        </div>

        <!-- Elevated Question Card Container -->
        <div class="bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.08)] overflow-hidden">
          <!-- Card Header Bar -->
          <div class="px-6 sm:px-8 py-4 sm:py-5 border-b border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 bg-zinc-50/60 dark:bg-zinc-900/80">
            <div class="flex items-center gap-3">
              <span id="sample-domain-badge" class="font-mono font-bold text-xs px-3 py-1 rounded-md bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                Penalaran Fluida (Gf)
              </span>
              <span id="sample-subtype-text" class="text-xs sm:text-sm font-medium text-zinc-600 dark:text-zinc-400">
                Shape &amp; Count Progression
              </span>
            </div>

            <!-- Stepper Controls -->
            <div class="flex items-center gap-2">
              <span id="sample-counter-text" class="text-xs font-mono font-semibold text-zinc-500 mr-2">
                Item 1 of 5
              </span>
              <button
                type="button"
                id="btn-sample-prev"
                class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-label="Previous sample question"
                disabled
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                type="button"
                id="btn-sample-next"
                class="min-h-[44px] min-w-[44px] p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-label="Next sample question"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Question Viewport + Interactive Choices Area -->
          <div id="sample-card-body" class="p-5 sm:p-8 md:p-10 flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12 min-h-[380px]">
            <!-- Dynamic Stimulus Container -->
            <div id="sample-stimulus-box" class="flex flex-col items-center justify-center w-full lg:w-auto shrink-0">
              <!-- Dynamically populated via script -->
            </div>

            <!-- Answer Options & Feedback Container -->
            <div class="w-full lg:w-1/2 flex flex-col justify-center">
              <div id="sample-prompt-text" class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-white mb-4 text-center lg:text-left leading-snug">
                Which tile logically completes the matrix pattern?
              </div>

              <!-- Options Grid Container -->
              <div id="sample-options-container" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
                <!-- Dynamically populated via script -->
              </div>

              <!-- Real-Time Feedback Container -->
              <div id="demo-feedback" class="mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all">
                Select an option above to verify your solution.
              </div>

              <!-- Dynamic Action Row (Next Question or Bridge to Test) -->
              <div id="sample-action-row" class="mt-4 flex flex-col sm:flex-row items-center gap-3">
                <button
                  type="button"
                  id="btn-sample-advance"
                  class="hidden w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm sm:text-base shadow-sm transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer items-center justify-center gap-2"
                >
                  <span id="btn-sample-advance-text">Next Contoh Soal</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- All 5 Completed Banner (Appears after solving all items) -->
          <div id="sample-completion-banner" class="hidden p-6 sm:p-8 bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800 text-center flex-col items-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs font-mono font-semibold text-emerald-700 dark:text-emerald-300 mb-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              5 of 5 Samples Explored
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Ready for Your Comprehensive Assessment?
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-lg mb-6 leading-relaxed">
              These sample items represent the 4 broad CHC cognitive domains. Start the standardized 24-question assessment to receive your psychometric IQ score estimate and percentile ranking.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full max-w-md">
              <a
                href="/id/tes"
                class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-md transition-all hover:scale-[1.01] active:scale-[0.99] text-center"
              >
                Full Assessment (20 Min) &rarr;
              </a>
              <a
