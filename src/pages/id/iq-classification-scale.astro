  <Footer />

  <script is:inline>
    function calculatePercentile(iq) {
      const z = (iq - 100) / 15;
      const t = 1.0 / (1.0 + 0.2316419 * Math.abs(z));
      const d = 0.3989423 * Math.exp(-z * z / 2.0);
      let p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
      if (z > 0) p = 1.0 - p;
      return p * 100;
    }

    function getClassification(iq) {
      if (iq >= 130) return { label: "Sangat Unggul / Berbakat (Sangat Superior)", rarity: "1 dari " + Math.round(100 / (100 - calculatePercentile(iq))) + " orang" };
      if (iq >= 120) return { label: "Unggul (Superior)", rarity: "1 dari " + Math.round(100 / (100 - calculatePercentile(iq))) + " orang" };
      if (iq >= 110) return { label: "Rata-rata Tinggi", rarity: "1 dari " + (100 / (100 - calculatePercentile(iq))).toFixed(1) + " orang" };
      if (iq >= 90) return { label: "Rata-rata (Normal)", rarity: "1 dari 2 orang" };
      if (iq >= 80) return { label: "Rata-rata Rendah", rarity: "1 dari " + (100 / calculatePercentile(iq)).toFixed(1) + " orang" };
      if (iq >= 70) return { label: "Garis Batas (Borderline)", rarity: "1 dari " + Math.round(100 / calculatePercentile(iq)) + " orang" };
      return { label: "Sangat Rendah (Extremely Low)", rarity: "1 dari " + Math.round(100 / calculatePercentile(iq)) + " orang" };
    }

    const input = document.getElementById('iq-input');
    const resClass = document.getElementById('res-classification');
    const resPct = document.getElementById('res-percentile');
    const resRarity = document.getElementById('res-rarity');

    function update() {
      let val = parseInt(input.value, 10);
      if (isNaN(val)) return;
      if (val < 40) val = 40;
      if (val > 160) val = 160;

      const pct = calculatePercentile(val);
      const info = getClassification(val);

      resClass.textContent = info.label;
      resPct.textContent = "Persentil ke-" + pct.toFixed(1).replace('.', ',');
      resRarity.textContent = info.rarity;
    }

    if (input) {
      input.addEventListener('input', update);
      update();
    }
  </script>
