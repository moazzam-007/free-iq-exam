---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Tabel Tingkat IQ: Skor, Persentil & Klasifikasi IQ | FreeIQExam";
const description = "Gunakan tabel tingkat IQ untuk melihat arti skor, persentil, simpangan baku, dan klasifikasi pada skala dengan rerata 100 dan SD 15.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Tabel Skor IQ: Distribusi Normal, Persentil, dan Klasifikasi Kognitif",
    "description": "Tabel skor IQ komprehensif dengan kurva lonceng distribusi normal Gauss, rentang simpangan baku, persentil ekuivalen, dan klasifikasi kognitif dari 70 hingga 145+.",
    "url": "https://freeiqexam.com/id/tabel-skor-iq/",
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam",
      "url": "https://freeiqexam.com/id/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tabel Skor IQ",
        "item": "https://freeiqexam.com/id/tabel-skor-iq/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Berapa skor IQ yang dianggap bagus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor IQ antara 90 dan 109 adalah rata-rata statistik populasi. Skor 115 atau lebih tinggi (satu simpangan baku di atas rata-rata) menempatkan Anda di 16% teratas populasi, diklasifikasikan sebagai Rata-rata Tinggi atau Cerdas. Skor 120 hingga 129 diklasifikasikan sebagai Unggul (Superior, 9% hingga 2,5% teratas), dan skor 130 ke atas mewakili kecerdasan Sangat Unggul atau Berbakat (2,27% teratas)."
        }
      },
      {
        "@type": "Question",
        "name": "Apa arti skor IQ 115?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor IQ 115 tepat berada satu simpangan baku (SD 15) di atas nilai rata-rata populasi 100. Skor ini setara dengan persentil ke-84,1, yang berarti performa Anda sama dengan atau lebih tinggi dari sekitar 84 dari 100 orang pada populasi umum."
        }
      },
      {
        "@type": "Question",
        "name": "Apa arti skor IQ 120 atau 125?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor IQ 120 setara dengan persentil ke-90,9 (9,1% teratas), sedangkan skor IQ 125 setara dengan persentil ke-95,2 (4,8% teratas). Keduanya masuk ke dalam klasifikasi kognitif 'Unggul' (Superior) pada skala Wechsler WAIS-IV, mencerminkan pemecahan masalah tingkat lanjut, abstraksi cepat, dan kapasitas analitis yang kuat."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa persentase populasi yang memiliki skor IQ di atas 130?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pada skala kecerdasan standar dengan simpangan baku 15 (seperti WAIS-IV), skor IQ 130 tepat berada dua simpangan baku di atas rata-rata. Secara matematis, sekitar 2,27% dari populasi manusia memperoleh skor pada atau di atas 130. Ini merupakan ambang batas standar untuk kualifikasi keanggotaan Mensa."
        }
      },
      {
        "@type": "Question",
        "name": "Apa perbedaan antara SD 15, SD 16, dan SD 24 pada tabel skor IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skala psikometrik yang berbeda menggunakan simpangan baku (SD) yang berbeda. Skala Wechsler menggunakan SD 15 (di mana 130 adalah persentil ke-98). Skala Stanford-Binet Form L-M secara historis menggunakan SD 16 (di mana 132 adalah persentil ke-98). Tes Cattell Culture Fair menggunakan SD 24 (di mana 148 adalah persentil ke-98). Meskipun angka skor mentahnya berbeda, semuanya menggambarkan peringkat persentil dan jarak relatif yang persis sama dari rata-rata populasi."
        }
      },
      {
        "@type": "Question",
        "name": "Bisakah skor IQ seseorang berubah seiring berjalannya waktu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor tes IQ orang dewasa menunjukkan stabilitas tes-ulang yang tinggi (korelasi r = 0,80 hingga 0,90 selama bertahun-tahun). Namun, skor dapat berfluktuasi dalam batas kesalahan standar pengukuran (biasanya ±3 hingga 5 poin) akibat kecemasan ujian, kelelahan fisik, kesehatan, atau efek latihan. Antargenerasi, performa mentah juga bergeser akibat efek Flynn, sehingga butuh restandardisasi berkala."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa skor IQ rata-rata seorang dokter?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Studi psikometrik dan data kognitif okupasional (seperti Wisconsin Longitudinal Study dan analisis normatif Wonderlic) menemukan bahwa dokter medis, dokter spesialis, dan ahli bedah memiliki rata-rata IQ antara 120 dan 125. Rentang skor ini menempatkan profesional medis dalam klasifikasi Unggul (Superior), sekitar persentil ke-91 hingga ke-95 populasi umum."
        }
      },
      {
        "@type": "Question",
        "name": "Apa yang dimaksud tabel tingkat IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tabel tingkat IQ adalah cara ringkas untuk melihat hubungan antara skor terstandardisasi, simpangan baku, persentil, dan klasifikasi. Skor yang sama dapat diberi label berbeda bila instrumennya menggunakan norma atau simpangan baku yang berbeda."
        }
      },
      {
        "@type": "Question",
        "name": "IQ normal berapa pada skala dengan rerata 100?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pada skala dengan rerata 100 dan SD 15, area 90-109 berada di sekitar rentang rata-rata statistik. Periksa tabel lengkap dan persentilnya sebelum menyimpulkan arti suatu skor."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/iq-score-chart">
  <Header currentPath="/id/tabel-skor-iq" enPath="/iq-score-chart" />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    
    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>Distribusi Normal &bull; Simpangan Baku 15</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Tabel Tingkat IQ: Skor, Persentil &amp; Klasifikasi
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Lihat bagaimana nilai IQ dipetakan ke persentil dan rentang klasifikasi. Tabel ini membantu menjawab pertanyaan seperti “IQ normal berapa?” dan “berapa persentil untuk skor IQ tertentu?”.
      </p>
    </header>

    <!-- Interactive SVG Normal Distribution Bell Curve -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-6">
        <div>
          <h2 id="bell-curve" class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
            Kurva Lonceng Distribusi Normal Gauss
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Metrik simpangan baku (&mu; = 100, &sigma; = 15). 68,2% populasi berada pada rentang skor 85 hingga 115.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300">
          Model Distribusi Gauss
        </span>
      </div>

      <div class="w-full overflow-x-auto pb-4">
        <div class="min-w-[600px] max-w-3xl mx-auto">
          <svg viewBox="0 0 600 250" class="w-full h-auto select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="chartZone68" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.05" />
              </linearGradient>
              <linearGradient id="chartZone95" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.25" />
                <stop offset="100%" stop-color="#6366f1" stop-opacity="0.03" />
              </linearGradient>
              <linearGradient id="chartZone99" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#a855f7" stop-opacity="0.15" />
                <stop offset="100%" stop-color="#a855f7" stop-opacity="0.01" />
              </linearGradient>
            </defs>

            <!-- Horizontal Baseline -->
            <line x1="50" y1="190" x2="550" y2="190" stroke="#d4d4d8" class="dark:stroke-zinc-700" stroke-width="2" />

            <!-- SD 15 Shaded Zones -->
            <!-- 99.7% Zone (-3 SD to +3 SD: 55 to 145) -->
            <path d="M 50 190 Q 200 185, 300 45 Q 400 185, 550 190 Z" fill="url(#chartZone99)" />

            <!-- 95.4% Zone (-2 SD to +2 SD: 70 to 130) -->
            <path d="M 133.3 190 Q 200 180, 300 45 Q 400 180, 466.6 190 Z" fill="url(#chartZone95)" />

            <!-- 68.2% Zone (-1 SD to +1 SD: 85 to 115) -->
            <path d="M 216.6 190 Q 250 120, 300 45 Q 350 120, 383.3 190 Z" fill="url(#chartZone68)" />

            <!-- Smooth Bell Curve Line -->
            <path d="M 50 190 C 130 190, 200 185, 250 120 C 275 80, 290 45, 300 45 C 310 45, 325 80, 350 120 C 400 185, 470 190, 550 190" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />

            <!-- Vertical SD Boundaries -->
            <line x1="216.6" y1="120" x2="216.6" y2="190" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="3 3" />
            <line x1="383.3" y1="120" x2="383.3" y2="190" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="3 3" />
            <line x1="133.3" y1="165" x2="133.3" y2="190" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="3 3" />
            <line x1="466.6" y1="165" x2="466.6" y2="190" stroke="#6366f1" stroke-width="1.5" stroke-dasharray="3 3" />
            <line x1="300" y1="45" x2="300" y2="190" stroke="#18181b" class="dark:stroke-zinc-400" stroke-width="2" />

            <!-- SD Percentage Badges -->
            <rect x="272" y="105" width="56" height="20" rx="10" fill="#2563eb" />
            <text x="300" y="119" font-family="monospace" font-size="11" font-weight="bold" fill="#ffffff" text-anchor="middle">68.2%</text>

            <rect x="400" y="145" width="50" height="18" rx="9" fill="#4f46e5" />
            <text x="425" y="158" font-family="monospace" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">13.6%</text>

            <rect x="150" y="145" width="50" height="18" rx="9" fill="#4f46e5" />
            <text x="175" y="158" font-family="monospace" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">13.6%</text>

            <!-- Ticks & Score Numbers -->
            <text x="50" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">55</text>
            <text x="50" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">-3 SD</text>

            <text x="133.3" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">70</text>
            <text x="133.3" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">-2 SD</text>

            <text x="216.6" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">85</text>
            <text x="216.6" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">-1 SD</text>

            <text x="300" y="210" font-family="monospace" font-size="12" font-weight="bold" fill="#2563eb" text-anchor="middle">100</text>
            <text x="300" y="225" font-family="sans-serif" font-size="9" font-weight="bold" fill="#2563eb" text-anchor="middle">Rerata</text>

            <text x="383.3" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">115</text>
            <text x="383.3" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">+1 SD</text>

            <text x="466.6" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">130</text>
            <text x="466.6" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">+2 SD</text>

            <text x="550" y="210" font-family="monospace" font-size="11" fill="#71717a" text-anchor="middle">145</text>
            <text x="550" y="225" font-family="sans-serif" font-size="9" fill="#a1a1aa" text-anchor="middle">+3 SD</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- Comprehensive Classification Table -->
    <section>
      <div class="mb-4">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Tabel Klasifikasi IQ Simpangan Terstandardisasi (SD 15)
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Distribusi populasi teoretis berdasarkan skala pengukuran kecerdasan Wechsler.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[560px] text-left text-xs sm:text-sm">
          <thead class="sticky top-0 bg-zinc-100/95 dark:bg-zinc-900/95 backdrop-blur-sm z-10 border-b border-zinc-200 dark:border-zinc-800 font-mono uppercase text-zinc-600 dark:text-zinc-400 text-[11px]">
            <tr>
              <th class="py-3.5 px-4">Rentang Skor</th>
              <th class="py-3.5 px-4">Rentang Persentil</th>
              <th class="py-3.5 px-4">Klasifikasi Klinis</th>
              <th class="py-3.5 px-4">Porsi Populasi</th>
              <th class="py-3.5 px-4">Rasio Kelangkaan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/80 dark:divide-zinc-800 bg-white dark:bg-black font-mono">
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">145+</td>
              <td class="py-3.5 px-4">99,87% hingga 99,99%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Sangat Unggul Luar Biasa</td>
              <td class="py-3.5 px-4">0,13%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 740</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">130 hingga 144</td>
              <td class="py-3.5 px-4">97,72% hingga 99,86%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Sangat Unggul / Berbakat</td>
              <td class="py-3.5 px-4">2,14%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 44</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">120 hingga 129</td>
              <td class="py-3.5 px-4">90,88% hingga 97,71%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Unggul (Superior)</td>
              <td class="py-3.5 px-4">6,83%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 15</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">110 hingga 119</td>
              <td class="py-3.5 px-4">74,75% hingga 90,87%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Rata-rata Tinggi</td>
              <td class="py-3.5 px-4">16,12%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 6,2</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40 bg-zinc-50/50 dark:bg-zinc-900/20">
              <td class="py-3.5 px-4 font-bold text-blue-600 dark:text-blue-400">90 hingga 109</td>
              <td class="py-3.5 px-4">25,25% hingga 74,74%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-950 dark:text-white">Rata-rata (Normal)</td>
              <td class="py-3.5 px-4 font-bold">49,49%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 2</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">80 hingga 89</td>
              <td class="py-3.5 px-4">9,13% hingga 25,24%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Rata-rata Rendah</td>
              <td class="py-3.5 px-4">16,12%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 6,2</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">70 hingga 79</td>
              <td class="py-3.5 px-4">2,28% hingga 9,12%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Garis Batas (Borderline)</td>
              <td class="py-3.5 px-4">6,84%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 15</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">Di bawah 70</td>
              <td class="py-3.5 px-4">Di bawah 2,27%</td>
              <td class="py-3.5 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Sangat Rendah (Extremely Low)</td>
              <td class="py-3.5 px-4">2,27%</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 44</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Cross-Scale Comparison Table -->
    <section>
      <div class="mb-4">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Tabel Konversi Silang Antara Berbagai Skala IQ
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Bandingkan skor numerik ekuivalen pada instrumen Wechsler (SD 15), Stanford-Binet (SD 16), dan Cattell Culture Fair (SD 24).
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[500px] text-left text-xs sm:text-sm">
          <thead class="bg-zinc-100/95 dark:bg-zinc-900/95 border-b border-zinc-200 dark:border-zinc-800 font-mono uppercase text-zinc-600 dark:text-zinc-400 text-[11px]">
            <tr>
              <th class="py-3.5 px-4">Peringkat Persentil</th>
              <th class="py-3.5 px-4">Wechsler (SD 15)</th>
              <th class="py-3.5 px-4">Stanford-Binet (SD 16)</th>
              <th class="py-3.5 px-4">Cattell (SD 24)</th>
              <th class="py-3.5 px-4">Kelangkaan Populasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/80 dark:divide-zinc-800 bg-white dark:bg-black font-mono">
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">Persentil ke-99,9</td>
              <td class="py-3.5 px-4">146</td>
              <td class="py-3.5 px-4">149</td>
              <td class="py-3.5 px-4">174</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 1.000</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">Persentil ke-98,0 (Mensa)</td>
              <td class="py-3.5 px-4 font-bold text-blue-600 dark:text-blue-400">130</td>
              <td class="py-3.5 px-4">132</td>
              <td class="py-3.5 px-4">148</td>
              <td class="py-3.5 px-4 text-zinc-500">1 dari 50</td>
            </tr>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/40">
              <td class="py-3.5 px-4 font-bold text-zinc-950 dark:text-white">Persentil ke-90,0</td>
