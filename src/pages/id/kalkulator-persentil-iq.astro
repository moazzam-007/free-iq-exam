  <script is:inline>
    function normalCDF(z) {
      const t = 1.0 / (1.0 + 0.2316419 * Math.abs(z));
      const d = 0.3989423 * Math.exp(-z * z / 2.0);
      let p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
      if (z > 0) p = 1.0 - p;
      return p;
    }

    function inverseNormalCDF(p) {
      if (p <= 0 || p >= 1) return 0;
      const a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02, 1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00];
      const b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02, 6.680131188771972e+01, -1.328068155288572e+01];
      const c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00, -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00];
      const d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00];

      const pLow = 0.02425;
      const pHigh = 1 - pLow;
      let q, r;

      if (p < pLow) {
        q = Math.sqrt(-2 * Math.log(p));
        return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
      }
      if (p <= pHigh) {
        q = p - 0.5;
        r = q * q;
        return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);
      }
      q = Math.sqrt(-2 * Math.log(1 - p));
      return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);
    }

    function getIQClassification(iq) {
      if (iq >= 130) return "Sangat Unggul / Berbakat (Sangat Superior)";
      if (iq >= 120) return "Unggul (Superior)";
      if (iq >= 110) return "Rata-rata Tinggi";
      if (iq >= 90) return "Rata-rata (Normal)";
      if (iq >= 80) return "Rata-rata Rendah";
      if (iq >= 70) return "Garis Batas (Borderline)";
      return "Sangat Rendah (Extremely Low)";
    }

    // Tab Switching
    const tabIqToPct = document.getElementById('tab-iq-to-pct');
    const tabPctToIq = document.getElementById('tab-pct-to-iq');
    const panelIqToPct = document.getElementById('panel-iq-to-pct');
    const panelPctToIq = document.getElementById('panel-pct-to-iq');

    tabIqToPct.addEventListener('click', () => {
      tabIqToPct.className = "flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white dark:bg-zinc-900 text-zinc-950 dark:text-white shadow-xs";
      tabPctToIq.className = "flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white";
      panelIqToPct.classList.remove('hidden');
      panelPctToIq.classList.add('hidden');
    });

    tabPctToIq.addEventListener('click', () => {
      tabPctToIq.className = "flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white dark:bg-zinc-900 text-zinc-950 dark:text-white shadow-xs";
      tabIqToPct.className = "flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white";
      panelPctToIq.classList.remove('hidden');
      panelIqToPct.classList.add('hidden');
    });

    // Mode 1: IQ -> Percentile
    const iqInput = document.getElementById('iq-input');
    const iqSlider = document.getElementById('iq-slider');
    const outPct = document.getElementById('out-pct');
    const outZ = document.getElementById('out-z');
    const outRarity = document.getElementById('out-rarity');
    const outClass = document.getElementById('out-class');

    function updateFromIQ(val) {
      const z = (val - 100) / 15;
      const pct = (1 - normalCDF(z)) * 100;
      const zStr = (z >= 0 ? "+" : "") + z.toFixed(2).replace('.', ',');
      const pctStr = pct.toFixed(2).replace('.', ',') + "%";
      
      let rarityStr = "1 dari 2";
      if (pct > 50) {
        const r = Math.round(100 / (100 - pct));
        rarityStr = "1 dari " + r.toLocaleString('id-ID');
      } else if (pct < 50) {
        const r = Math.round(100 / pct);
        rarityStr = "1 dari " + r.toLocaleString('id-ID');
      }

      outPct.textContent = pctStr;
      outZ.textContent = zStr;
      outRarity.textContent = rarityStr;
      outClass.textContent = getIQClassification(val);
    }

    iqInput.addEventListener('input', (e) => {
      let val = parseInt(e.target.value, 10);
      if (isNaN(val)) return;
      if (val < 55) val = 55;
      if (val > 160) val = 160;
      iqSlider.value = val;
      updateFromIQ(val);
    });

    iqSlider.addEventListener('input', (e) => {
      iqInput.value = e.target.value;
      updateFromIQ(parseInt(e.target.value, 10));
    });

    // Mode 2: Percentile -> IQ
    const pctInput = document.getElementById('pct-input');
    const pctSlider = document.getElementById('pct-slider');
    const outIqVal = document.getElementById('out-iq-val');
    const outIqZ = document.getElementById('out-iq-z');
    const outIqRarity = document.getElementById('out-iq-rarity');
    const outIqClass = document.getElementById('out-iq-class');

    function updateFromPct(pctVal) {
      const p = pctVal / 100;
      const z = inverseNormalCDF(p);
      const iq = Math.round(100 + 15 * z);
      const zStr = (z >= 0 ? "+" : "") + z.toFixed(2).replace('.', ',');

      let rarityStr = "1 dari 2";
      if (pctVal > 50) {
        const r = Math.round(100 / (100 - pctVal));
        rarityStr = "1 dari " + r.toLocaleString('id-ID');
      } else if (pctVal < 50) {
        const r = Math.round(100 / pctVal);
        rarityStr = "1 dari " + r.toLocaleString('id-ID');
      }

      outIqVal.textContent = iq;
      outIqZ.textContent = zStr;
      outIqRarity.textContent = rarityStr;
      outIqClass.textContent = getIQClassification(iq);
    }

    pctInput.addEventListener('input', (e) => {
      let val = parseFloat(e.target.value);
      if (isNaN(val)) return;
      if (val < 0.01) val = 0.01;
      if (val > 99.99) val = 99.99;
      pctSlider.value = Math.round(val * 10);
      updateFromPct(val);
    });

    pctSlider.addEventListener('input', (e) => {
      const val = (e.target.value / 10).toFixed(1);
      pctInput.value = val;
      updateFromPct(parseFloat(val));
    });

    // Initial update
    updateFromIQ(120);
    updateFromPct(98.0);
  </script>
