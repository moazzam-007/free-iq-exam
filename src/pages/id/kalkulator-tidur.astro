---
import LayoutId from '../../components/id/LayoutId.astro';
import HeaderId from '../../components/id/HeaderId.astro';
import FooterId from '../../components/id/FooterId.astro';

// Tautan alternatif multibahasa
const alternates = {
  en: "https://freeiqexam.com/sleep-calculator",
  id: "https://freeiqexam.com/id/kalkulator-tidur"
};

const title = "Kalkulator Tidur Gratis | Jam Tidur Optimal, Siklus Tidur & Tes Kronotipe";
const description = "Hitung waktu tidur dan bangun optimal Anda berdasarkan siklus tidur ultradian 90 menit alami. Dilengkapi asesmen kronotipe Munich (MCTQ) dan pelacak waktu paruh kafein. 100% gratis.";
const canonicalUrl = "https://freeiqexam.com/id/kalkulator-tidur";

const faqItems = [
  {
    q: "Bagaimana cara kerja kalkulator tidur ini?",
    a: "Kalkulator ini bekerja menghitung mundur dari siklus ultradian 90 menit, yaitu rata-rata durasi satu putaran lengkap melalui tidur ringan (N1/N2), tidur lelap gelombang lambat (N3), dan tidur REM. Jika Anda memasukkan jam bangun yang diinginkan, kalkulator akan mengurangi 90 menit per siklus ditambah toleransi latensi jatuh tertidur selama 14 menit untuk memberi opsi jam tidur 6, 5, 4, atau 3 siklus. Toleransi 14 menit ini sangat krusial: jam tidur adalah saat Anda merebahkan diri di ranjang, bukan saat Anda langsung terlelap."
  },
  {
    q: "Berapa jam tidur yang sebenarnya dibutuhkan oleh orang dewasa?",
    a: "Konsensus ilmiah dari American Academy of Sleep Medicine (AASM) dan Sleep Research Society merekomendasikan 7 jam atau lebih per malam untuk orang dewasa usia 18 hingga 60 tahun. Angka 7 jam adalah batas bawah, bukan target ideal-kebanyakan orang dewasa berfungsi optimal pada rentang 7 hingga 9 jam. Kalkulator ini menetapkan 5 siklus (7,5 jam) sebagai standar dasar yang direkomendasikan dan 4 siklus (6 jam) sebagai batas minimum fungsional jangka pendek."
  },
  {
    q: "Apa itu siklus tidur dan apakah durasinya benar-benar tepat 90 menit?",
    a: "Siklus tidur adalah satu progresi penuh melalui fase non-REM (N1, N2, N3) yang diikuti oleh fase REM sebelum pola berulang kembali. Durasi 90 menit adalah rata-rata populasi, bukan konstanta mutlak. Siklus ultradian individu berkisar antara 70 hingga 120 menit, dan siklus dalam satu malam tidak sama panjang-siklus pertama biasanya terpendek (70-80 menit) dan siklus terakhir adalah yang terpanjang (100-120 menit)."
  },
  {
    q: "Haruskah saya menghitung dari saat naik ke ranjang atau saat terlelap?",
    a: "Dihitung dari saat Anda benar-benar tertidur. Orang dewasa sehat membutuhkan rata-rata sekitar 14 menit untuk beralih dari kondisi terjaga hingga terlelap (latensi tidur). Kalkulator ini otomatis memasukkan latensi 14 menit ke dalam setiap hasil jadwal yang ditampilkan."
  },
  {
    q: "Apa itu kronotipe dan bagaimana tipe saya dihitung?",
    a: "Kronotipe adalah preferensi biologis internal tubuh Anda terhadap pengaturan waktu tidur dan bangun yang dikendalikan oleh jam sirkadian. Alat ini menggunakan Munich ChronoType Questionnaire (MCTQ). Anda memasukkan jadwal tidur hari kerja dan hari libur; algoritma menghitung titik tengah tidur hari libur (MSF), lalu mengoreksinya terhadap utang tidur mingguan untuk menghasilkan skor MSFsc yang mengklasifikasikan Anda sebagai Singa (pagi), Beruang (menengah), atau Serigala (malam)."
  },
  {
    q: "Berapa lama kafein bertahan di dalam tubuh?",
    a: "Kafein memiliki waktu paruh eliminasi (half-life) rata-rata sekitar 5,7 jam pada orang dewasa sehat (rentang 3–7 jam). Artinya setiap 5,7 jam, tubuh hanya membuang setengah dari sisa kafein yang beredar: 200 mg kopi menjadi 100 mg setelah 5,7 jam, 50 mg setelah 11,4 jam, dan masih tersisa 25 mg setelah 17 jam."
  },
  {
    q: "Dapatkah kita 'membayar lunas' utang tidur yang menumpuk di akhir pekan?",
    a: "Hanya sebagian, dan jauh lebih lambat daripada yang diperkirakan kebanyakan orang. Utang tidur nyata terakumulasi, namun kapasitas pemulihan biologis tubuh memiliki batas (homeostatic rebound ceiling). Menghabiskan 4 jam ekstra di ranjang pada hari Minggu tidak serta-merta mengembalikan fungsi otak yang hilang selama 5 hari kurang tidur, dan justru dapat memicu jet lag sosial."
  },
  {
    q: "Apakah kalkulator tidur ini akurat secara medis?",
    a: "Kalkulator ini menggunakan model aritmatika berbasis data rata-rata populasi yang sahih dalam literatur sains tidur (siklus 90 menit, latensi 14 menit, kinetika eliminasi kafein 5,7 jam). Ini bukan alat diagnostik medis. Jika Anda mengalami insomnia kronis, dengkuran keras disertai henti napas (sleep apnea), atau kantuk ekstrem di siang hari, konsultasikan dengan dokter spesialis tidur."
  }
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Pengoptimal Siklus Tidur & Kronotipe",
    "url": "https://freeiqexam.com/id/kalkulator-tidur",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Memerlukan JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Penjadwalan tidur 3 mode: bangun pada jam tertentu, tidur sekarang, dan rencana jam tidur",
      "Pemodelan siklus ultradian 90 menit dengan kompensasi latensi tidur 14 menit",
      "Klasifikasi tingkatan siklus dari Tidur Restoratif Optimal hingga Risiko Deprivasi Tidur",
      "Asesmen Munich ChronoType Questionnaire (MCTQ) komputasi MSFsc ilmiah",
      "Klasifikasi kronotipe Singa, Beruang, dan Serigala dengan kuantifikasi jet lag sosial",
      "Kurva peluruhan eliminasi kafein kinetika orde pertama 5,7 jam",
      "Roda jam sirkadian 24 jam interaktif dengan penanda sekresi melatonin alami",
      "Buku kas utang tidur 7 malam dengan protokol pemulihan 3 malam terstruktur",
      "100% gratis, tanpa pendaftaran, seluruh komputasi berjalan lokal di peramban Anda"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Alat & Tes",
        "item": "https://freeiqexam.com/id/tes"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Kalkulator Tidur",
        "item": "https://freeiqexam.com/id/kalkulator-tidur"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  }
];
---

<LayoutId
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schemas}
>
  <HeaderId />

  <main class="sleep-page relative overflow-hidden">
    <div class="sleep-hero-glow" aria-hidden="true"></div>

    <!-- ===================================================== HERO ======= -->
    <section class="hero relative z-10">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/id">Beranda</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/id/tes">Alat &amp; Tes</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Kalkulator Tidur</li>
        </ol>
      </nav>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800/80 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 font-mono text-[13px] sm:text-sm font-semibold uppercase tracking-wider mb-4 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
        <span>SAINS SIRKADIAN · SIKLUS ULTRADIAN 90 MENIT</span>
      </div>
      <h1>Kalkulator Tidur</h1>
      <p class="lede">
        Tentukan jam tidur ideal agar Anda bangun tepat di akhir siklus tidur alami, bukan di tengah-tengah tidur lelap. Dilengkapi tiga mode jadwal, asesmen Munich ChronoType, kurva eliminasi kafein, dan kalkulator pelunasan utang tidur-semuanya dihitung secara lokal tanpa pengiriman data ke server.
      </p>

      <ul class="hero-stats">
        <li><strong>90 mnt</strong><span>siklus ultradian</span></li>
        <li><strong>14 mnt</strong><span>latensi terlelap</span></li>
        <li><strong>5,7 jam</strong><span>waktu paruh kafein</span></li>
        <li><strong>0</strong><span>data diunggah</span></li>
      </ul>
    </section>

    <!-- ================================================ SCHEDULER ======= -->
    <section class="panel" aria-labelledby="scheduler-title">
      <header class="panel-head">
        <h2 id="scheduler-title">Penjadwal Siklus Tidur</h2>
        <p>
          Pilih mode perhitungan. Setiap hasil otomatis menyertakan kompensasi latensi 14 menit, sehingga jam yang tertera adalah waktu untuk naik ke tempat tidur.
        </p>
      </header>

      <div class="mode-tabs" role="tablist" aria-label="Mode penjadwalan">
        <button
          type="button"
          role="tab"
          class="mode-tab is-active"
          data-sleep-mode="wake"
          aria-selected="true"
        >Saya harus bangun jam…</button>
        <button
          type="button"
          role="tab"
          class="mode-tab"
          data-sleep-mode="now"
          aria-selected="false"
        >Saya ingin tidur sekarang</button>
        <button
          type="button"
          role="tab"
          class="mode-tab"
          data-sleep-mode="bedtime"
          aria-selected="false"
        >Rencana jam tidur saya…</button>
      </div>

      <div class="mode-panel" data-mode-panel="wake">
        <label class="field" for="wake-time">
          <span class="field-label">Target jam bangun</span>
          <input type="time" id="wake-time" value="07:00" step="60" />
        </label>
        <p class="results-summary" id="wake-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="wake-results"></div>
      </div>

      <div class="mode-panel" data-mode-panel="now" hidden>
        <p class="mode-note">
          Menggunakan jam internal perangkat Anda. Waktu diperbarui setiap menit saat tab ini aktif.
        </p>
        <p class="results-summary" id="now-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="now-results"></div>
      </div>

      <div class="mode-panel" data-mode-panel="bedtime" hidden>
        <label class="field" for="bedtime-input">
          <span class="field-label">Waktu Anda naik ke tempat tidur</span>
          <input type="time" id="bedtime-input" value="23:00" step="60" />
        </label>
        <p class="results-summary" id="bedtime-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="bedtime-results"></div>
      </div>

      <div class="tier-legend">
        <span class="tier-chip tone-optimal">Optimal · 6 siklus</span>
        <span class="tier-chip tone-baseline">Standar · 5 siklus</span>
        <span class="tier-chip tone-minimum">Minimum · 4 siklus</span>
        <span class="tier-chip tone-deficit">Defisit · ≤ 3 siklus</span>
      </div>
    </section>

    <!-- ============================================ CLOCK + HYPNOGRAM === -->
    <section class="split" aria-labelledby="wheel-title">
      <div class="panel">
        <header class="panel-head">
          <h2 id="wheel-title">Roda Sirkadian 24 Jam</h2>
          <p>
            Tengah malam di bagian atas, tengah hari di bawah, berputar searah jarum jam. Menampilkan jendela tidur, estimasi pelepasan melatonin, batas konsumsi kafein, dan puncak kronotipe Anda.
          </p>
        </header>

        <svg
          id="clock-wheel"
          class="wheel"
          viewBox="0 0 260 260"
          role="img"
          aria-label="Roda jam sirkadian menampilkan jendela tidur dan penanda biologis"
        ></svg>

        <ul class="wheel-legend">
          <li><i class="swatch swatch-sleep"></i>Jendela tidur</li>
          <li><i class="swatch swatch-melatonin"></i>Pelepasan melatonin</li>
          <li><i class="swatch swatch-caffeine"></i>Batas akhir kafein</li>
          <li><i class="swatch swatch-peak"></i>Puncak fokus biologis</li>
        </ul>
      </div>

      <div class="panel">
        <header class="panel-head">
          <h2>Arsitektur Fase Tidur Malam</h2>
          <p>
            Arsitektur fase rata-rata populasi untuk 6 siklus tidur. Tidur gelombang lambat mendominasi awal malam; fase REM mendominasi siklus-siklus menjelang pagi.
          </p>
        </header>

        <svg
          id="hypnogram"
          class="hypnogram"
          viewBox="0 0 720 200"
          role="img"
          aria-label="Hipnogram arsitektur tahapan tidur sepanjang malam"
        ></svg>

        <dl class="hypo-totals">
          <div><dt>Total tidur</dt><dd id="hypo-total">-</dd></div>
          <div><dt>Lelap (N3)</dt><dd id="hypo-sws">-</dd></div>
          <div><dt>Fase REM</dt><dd id="hypo-rem">-</dd></div>
          <div><dt>Ringan (N1+N2)</dt><dd id="hypo-light">-</dd></div>
        </dl>

        <p class="caveat">
          Ini adalah pemodelan statistik populasi. Pola fisiologis aktual Anda dapat berbeda dan mengalami perubahan seiring pertambahan usia.
        </p>
      </div>
    </section>

    <!-- ================================================ CHRONOTYPE ====== -->
    <section class="panel" aria-labelledby="chrono-title">
      <header class="panel-head">
        <h2 id="chrono-title">Asesmen Munich ChronoType (MCTQ)</h2>
        <p>
          MCTQ adalah instrumen standar emas dalam penelitian kronobiologi. Algoritma membandingkan jam tidur hari kerja dan hari libur untuk menemukan titik tengah biologis sejati (MSFsc).
        </p>
      </header>

      <div class="mctq-grid">
        <fieldset class="mctq-group">
          <legend>Hari Kerja</legend>
          <label class="field" for="mctq-workday-sleep">
            <span class="field-label">Jam mulai tidur</span>
            <input type="time" id="mctq-workday-sleep" value="23:30" step="60" />
          </label>
          <label class="field" for="mctq-workday-wake">
            <span class="field-label">Jam bangun pagi</span>
            <input type="time" id="mctq-workday-wake" value="07:00" step="60" />
          </label>
        </fieldset>

        <fieldset class="mctq-group">
          <legend>Hari Libur</legend>
          <label class="field" for="mctq-freeday-sleep">
            <span class="field-label">Jam mulai tidur</span>
            <input type="time" id="mctq-freeday-sleep" value="01:00" step="60" />
          </label>
          <label class="field" for="mctq-freeday-wake">
            <span class="field-label">Jam bangun pagi</span>
            <input type="time" id="mctq-freeday-wake" value="09:00" step="60" />
          </label>
        </fieldset>

        <fieldset class="mctq-group">
          <legend>Kualitas Tidur</legend>
          <label class="field" for="mctq-fragmentation">
            <span class="field-label">Seberapa sering Anda terbangun di malam hari?</span>
            <select id="mctq-fragmentation">
              <option value="never">Jarang atau tidak pernah</option>
              <option value="sometimes" selected>Kadang-kadang</option>
              <option value="often">Sering - hampir setiap malam</option>
            </select>
          </label>
          <p class="field-hint">
            Digunakan untuk mendeteksi potensi hamparan Lumba-lumba (tidur terfragmentasi).
          </p>
        </fieldset>
      </div>

      <p class="field-error" id="chrono-error" hidden></p>

      <article class="chrono-card" id="chrono-result" hidden>
        <header class="chrono-head">
          <div>
            <p class="chrono-kicker">Kronotipe Biologis Anda</p>
            <h3 id="chrono-name">-</h3>
            <p class="chrono-alias" id="chrono-alias">-</p>
          </div>
          <div class="chrono-msfsc">
            <span class="chrono-msfsc-label">MSFsc</span>
            <strong id="chrono-msfsc">-</strong>
          </div>
        </header>

        <p class="chrono-summary" id="chrono-summary">-</p>

        <p class="chrono-disclosure" id="chrono-overlay-note" hidden></p>

        <div class="chrono-windows">
          <div class="window-card">
            <span class="window-label">Puncak Kewaspadaan</span>
            <strong id="chrono-peak">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Puncak Sekunder</span>
            <strong id="chrono-secondary">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Titik Terendah Energi</span>
            <strong id="chrono-trough">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Mulai Melatonin</span>
            <strong id="chrono-melatonin-onset">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Batas Akhir Kafein</span>
            <strong id="chrono-caffeine-cutoff">-</strong>
          </div>
        </div>

        <div class="chrono-notes">
          <p><strong>Rekomendasi Jadwal:</strong> <span id="chrono-advice">-</span></p>
          <p><strong>Kerentanan Biologis:</strong> <span id="chrono-friction">-</span></p>
        </div>

        <details class="chrono-math">
          <summary>Tampilkan rincian perhitungan matematis (MCTQ)</summary>
          <dl class="math-list">
            <div><dt>Durasi tidur hari kerja</dt><dd id="chrono-sdweek">-</dd></div>
            <div><dt>Durasi tidur hari libur</dt><dd id="chrono-sdfree">-</dd></div>
            <div><dt>Titik tengah hari kerja (MSW)</dt><dd id="chrono-msw">-</dd></div>
            <div><dt>Titik tengah hari libur (MSF)</dt><dd id="chrono-msf">-</dd></div>
            <div><dt>Koreksi utang tidur</dt><dd id="chrono-correction">-</dd></div>
            <div><dt>Titik tengah terkoreksi (MSFsc)</dt><dd id="chrono-msfsc-echo">-</dd></div>
            <div><dt>Rata-rata durasi tidur</dt><dd id="chrono-average">-</dd></div>
            <div><dt>Jet lag sosial</dt><dd id="chrono-social-jetlag">-</dd></div>
          </dl>
          <p class="math-note">
            MSFsc = MSF − (SD<sub>free</sub> − SD<sub>work</sub>) ÷ 2, hanya diterapkan jika durasi tidur hari libur lebih panjang dari hari kerja untuk mencegah salah klasifikasi utang tidur sebagai tipe malam.
          </p>
        </details>
      </article>
    </section>

    <!-- ================================================== CAFFEINE ====== -->
    <section class="panel" aria-labelledby="caffeine-title">
      <header class="panel-head">
        <h2 id="caffeine-title">Pelacak Waktu Paruh &amp; Eliminasi Kafein</h2>
        <p>
          Kafein dieliminasi melalui kinetika orde pertama dengan rata-rata waktu paruh 5,7 jam. Geser panel untuk melihat konsentrasi kafein yang masih aktif di otak saat Anda tidur.
        </p>
      </header>

      <div class="caffeine-controls">
        <label class="field" for="caffeine-dose">
          <span class="field-label">
            Dosis: <output id="caffeine-dose-value">200 mg</output>
          </span>
          <input
            type="range"
            id="caffeine-dose"
            min="0"
            max="600"
            step="10"
            value="200"
          />
          <span class="field-hint">
            Kopi seduh 250 ml ≈ 95 mg; espresso ganda ≈ 125 mg; kaleng cola 330 ml ≈ 34 mg.
          </span>
        </label>

        <label class="field" for="caffeine-time">
          <span class="field-label">Waktu dikonsumsi</span>
          <input type="time" id="caffeine-time" value="14:00" step="60" />
        </label>

        <label class="field" for="caffeine-bedtime">
          <span class="field-label">Jam tidur yang direncanakan</span>
          <input type="time" id="caffeine-bedtime" value="23:00" step="60" />
        </label>
      </div>

      <div class="caffeine-readouts">
        <div class="readout">
          <span class="readout-label">Sisa saat jam tidur</span>
          <strong id="caffeine-remaining">-</strong>
        </div>
        <div class="readout">
          <span class="readout-label">Rentang waktu ke jam tidur</span>
          <strong id="caffeine-hours">-</strong>
        </div>
        <div class="readout">
          <span class="readout-label">Persentase sisa dosis</span>
          <strong id="caffeine-fraction">-</strong>
        </div>
        <div class="readout">
          <span class="readout-label">Batas aman konsumsi</span>
          <strong id="caffeine-cutoff">-</strong>
        </div>
      </div>

      <svg
        id="caffeine-curve"
        class="curve"
        viewBox="0 0 640 220"
        role="img"
        aria-label="Kurva peluruhan konsentrasi plasma kafein selama 24 jam"
      ></svg>

      <div class="verdict" id="caffeine-verdict" data-tone="optimal">
        <p id="caffeine-verdict-text">-</p>
      </div>

      <h3 class="sub-head">Tonggak Waktu Paruh (Half-Life)</h3>
      <ul class="milestones" id="caffeine-milestones"></ul>
    </section>

    <!-- ====================================================== DEBT ======= -->
    <section class="panel" aria-labelledby="debt-title">
      <header class="panel-head">
        <h2 id="debt-title">Kalkulator Utang Tidur &amp; Pemulihan</h2>
        <p>
          Catat jam tidur Anda selama 7 malam terakhir. Sistem akan membandingkannya dengan acuan standar 8 jam dan menyusun protokol pemulihan realistis selama 3 malam.
        </p>
      </header>

      <div class="debt-grid">
        <label class="debt-field"><span>Malam 1</span>
          <input type="number" data-debt-night min="0" max="16" step="0.5" value="7" /></label>
        <label class="debt-field"><span>Malam 2</span>
          <input type="number" data-debt-night min="0" max="16" step="0.5" value="7" /></label>
        <label class="debt-field"><span>Malam 3</span>
          <input type="number" data-debt-night min="0" max="16" step="0.5" value="7" /></label>
        <label class="debt-field"><span>Malam 4</span>
