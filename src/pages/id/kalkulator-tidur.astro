  .sleep-page .hypo-trace {
    fill: none;
    stroke: var(--action);
    stroke-width: 1.75;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .sleep-page .hypo-cycle-tick {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .sleep-page .hypo-axis {
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    fill: var(--ink-faint);
