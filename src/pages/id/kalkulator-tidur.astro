  .sleep-page .chrono-card[data-tone="intermediate"] { border-color: rgba(0, 102, 204, 0.32); }
  .sleep-page .chrono-card[data-tone="late"] { border-color: rgba(41, 151, 255, 0.36); }
  .sleep-page .chrono-card[data-tone="fragmented"] { border-color: rgba(244, 63, 94, 0.32); }

  .sleep-page .chrono-head {
