    gap: 0.875rem;
  }

  .sleep-page .cycle-grid:empty {
    display: none;
  }

  .sleep-page .cycle-card {
    display: flex;
    flex-direction: column;
    padding: 1.125rem;
    background: var(--elev2);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1), border-color 0.15s, box-shadow 0.15s;
    animation: cycleIn 0.32s ease both;
  }

  .sleep-page .cycle-card:hover {
    transform: translateY(-2px);
    border-color: var(--action);
  }

  .sleep-page .cycle-card:nth-child(2) { animation-delay: 0.05s; }
  .sleep-page .cycle-card:nth-child(3) { animation-delay: 0.1s; }
  .sleep-page .cycle-card:nth-child(4) { animation-delay: 0.15s; }

  @keyframes cycleIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sleep-page .cycle-card { animation: none; }
  }

  .sleep-page .cycle-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.875rem;
  }

  .sleep-page .cycle-count {
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .sleep-page .cycle-tier {
    padding: 0.2rem 0.55rem;
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .sleep-page .cycle-card[data-tone="optimal"] .cycle-tier {
    color: var(--good);
    background: rgba(16, 185, 129, 0.12);
  }

  .sleep-page .cycle-card[data-tone="baseline"] .cycle-tier {
    color: var(--sky);
    background: rgba(56, 189, 248, 0.12);
  }

  .sleep-page .cycle-card[data-tone="minimum"] .cycle-tier {
    color: var(--warn);
    background: rgba(245, 158, 11, 0.12);
  }

  .sleep-page .cycle-card[data-tone="deficit"] .cycle-tier {
    color: var(--bad);
    background: rgba(244, 63, 94, 0.12);
  }

  .sleep-page .cycle-card[data-tone="optimal"] { border-color: rgba(16, 185, 129, 0.28); }
  .sleep-page .cycle-card[data-tone="minimum"] { border-color: rgba(245, 158, 11, 0.28); }
  .sleep-page .cycle-card[data-tone="deficit"] { border-color: rgba(244, 63, 94, 0.32); }

  .sleep-page .cycle-primary {
    margin: 0;
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .sleep-page .cycle-primary-label {
    margin: 0.25rem 0 0.875rem;
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .sleep-page .cycle-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0 0 0.875rem;
    padding: 0.875rem 0 0;
