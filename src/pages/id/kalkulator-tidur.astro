  .sleep-page .swatch-sleep { background: var(--action); }
  .sleep-page .swatch-melatonin { background: var(--sky); }
  .sleep-page .swatch-caffeine { background: var(--warn); }
  .sleep-page .swatch-peak { background: var(--good); }

  /* ====================================================== hypnogram ==== */
  .sleep-page .hypnogram {
    display: block;
    width: 100%;
    height: auto;
