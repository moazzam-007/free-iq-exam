  }

  .sleep-page .cycle-note {
    margin: auto 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-faint);
  }

  .sleep-page .cycle-alert {
    margin: 0.625rem 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--bad);
  }

  /* ==================================================== tier legend ==== */
  .sleep-page .tier-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
  }

  .sleep-page .tier-chip {
    padding: 0.375rem 0.75rem;
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    border-radius: 999px;
  }

  .sleep-page .tier-chip.tone-optimal {
    color: var(--good);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.28);
  }

  .sleep-page .tier-chip.tone-baseline {
    color: var(--sky);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.28);
  }

  .sleep-page .tier-chip.tone-minimum {
    color: var(--warn);
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.28);
  }

  .sleep-page .tier-chip.tone-deficit {
    color: var(--bad);
    background: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.28);
  }

  /* ===================================================== clock wheel === */
  .sleep-page .wheel {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin: 0 auto 1.25rem;
  }

  .sleep-page .wheel-ring {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .sleep-page .wheel-tick {
    stroke: var(--line);
    stroke-width: 1;
  }

  .sleep-page .wheel-tick.is-major {
    stroke: var(--ink-faint);
    stroke-width: 1.5;
  }

  .sleep-page .wheel-hour {
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    fill: var(--ink-faint);
  }

  .sleep-page .wheel-sleep-arc {
    fill: none;
    stroke: var(--action);
    stroke-width: 14;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .sleep-page .wheel-peak-arc {
    fill: none;
    stroke: var(--good);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .sleep-page .wheel-node.is-bed { fill: var(--action); }
  .sleep-page .wheel-node.is-wake { fill: var(--sky); }
  .sleep-page .wheel-node.is-melatonin { fill: var(--sky); }
  .sleep-page .wheel-node.is-caffeine { fill: var(--warn); }

  .sleep-page .wheel-hand {
