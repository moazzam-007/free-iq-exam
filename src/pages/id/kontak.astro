---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Hubungi Kami: Dukungan & Pertanyaan Psikometrik | FreeIQExam";
const description = "Hubungi tim FreeIQExam untuk dukungan teknis, pertanyaan psikometri, laporan kendala, atau saran pengembangan. Kami merespons dalam 24-48 jam kerja.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Hubungi FreeIQExam",
    "url": "https://freeiqexam.com/id/kontak/",
    "description": "Hubungi tim FreeIQExam untuk dukungan teknis, pertanyaan psikometrik, laporan bug, atau umpan balik."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Kontak",
        "item": "https://freeiqexam.com/id/kontak/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/contact">
  <Header currentPath="/id/kontak" enPath="/contact" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Kontak</span>
    </nav>
    
    <!-- Hero Header -->
    <header class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>DUKUNGAN LANGSUNG &bull; SALURAN SARAN</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Hubungi Tim Kami
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Punya pertanyaan seputar penskoran psikometri, laporan butir soal, atau kemitraan edukasi? Kami siap membantu Anda.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Contact Info Card -->
      <div class="md:col-span-1 space-y-6">
        <div class="p-6 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
          <span class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-1">
            Pertanyaan Resmi
          </span>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Email Dukungan
          </h3>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">
            Komunikasi email langsung untuk bantuan umum, editorial, dan saran.
          </p>
          <div class="flex items-center gap-2">
            <a href="mailto:support@freeiqexam.com" class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
              support@freeiqexam.com
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="p-1 rounded-md bg-zinc-200 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-300 dark:hover:bg-zinc-700 text-[10px] font-mono"
              title="Salin Email"
            >
              Salin
            </button>
          </div>
        </div>

        <div class="p-6 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
          <span class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider block mb-1">
            Waktu Respons
          </span>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Kebijakan Layanan
          </h3>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Kami meninjau setiap pesan masuk dalam 24 hingga 48 jam kerja. Untuk permintaan privasi data, mohon jelaskan secara rinci.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form Card -->
      <div class="md:col-span-2 p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs">
        <h2 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-4">
          Kirim Pesan
        </h2>

        <form id="contact-form" action="mailto:support@freeiqexam.com" method="post" enctype="text/plain" class="space-y-4">
          <div>
            <label for="contact-name" class="block text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Nama Anda
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Nama lengkap atau inisial"
              class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Alamat Email Anda
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="nama@email.com"
              class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Topik Pesan
            </label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            >
              <option value="general">Pertanyaan Umum</option>
              <option value="psychometrics">Pertanyaan Metodologi &amp; Penskoran</option>
              <option value="bug">Laporan Kendala / Bug</option>
              <option value="feedback">Saran Pengembangan</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Isi Pesan
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Tuliskan pertanyaan atau masukan Anda di sini..."
              class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-sm text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl bg-blue-600 text-white font-bold text-sm hover:bg-blue-500 transition-colors shadow-sm"
          >
            Kirim Pesan Sekarang &rarr;
          </button>
        </form>
      </div>
    </div>
  </main>

  <Footer />

  <script is:inline>
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('support@freeiqexam.com').then(() => {
          copyBtn.textContent = 'Tersalin!';
          setTimeout(() => {
            copyBtn.textContent = 'Salin';
          }, 2000);
        });
      });
    }
  </script>
</Layout>
