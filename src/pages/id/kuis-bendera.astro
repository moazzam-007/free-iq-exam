---
import LayoutId from '../../components/id/LayoutId.astro';
import HeaderId from '../../components/id/HeaderId.astro';
import FooterId from '../../components/id/FooterId.astro';

// Tautan alternatif multibahasa
const alternates = {
  en: "https://freeiqexam.com/flag-quiz",
  id: "https://freeiqexam.com/id/kuis-bendera"
};

const title = "Kuis Bendera Dunia: Tebak 195 Bendera Negara & Memori Visual | FreeIQExam";
const description = "Uji daya ingat visual dan pengetahuan geografi Anda dengan kuis 195 bendera negara berdaulat. Mode sprint 20 soal, survival, dan tantangan sulit.";
const canonicalUrl = "https://freeiqexam.com/id/kuis-bendera";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Kuis Bendera Dunia & Arena Memori Geografis",
    "url": "https://freeiqexam.com/id/kuis-bendera",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "browserRequirements": "Memerlukan dukungan JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Basis Data Bendera 195+ Negara Berdaulat Anggota PBB",
      "4 Mode Kognitif: Sprint Waktu 20 Ronde, Survival Sudden Death, Tebak Terbalik (Nama → Bendera), dan Mode Sulit Veksilologi",
      "Filter Geografis Benua (Seluruh Dunia, Eropa, Asia, Amerika, Afrika, Oseania)",
      "Pelacakan Kecepatan Reaksi & Latensi Respons Milidetik",
      "Pengali Poin Kombo Beruntun Adaptif dengan Sintesis Audio Web",
      "Rincian Penguasaan Geografis Regional & Layar Evaluasi Kesalahan",
      "Rendering Vektor Bendera Sisi Klien 100% Gratis & Privat"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan Asah Otak",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Kuis Bendera Dunia",
        "item": "https://freeiqexam.com/id/kuis-bendera"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Bagaimana Kuis Memori Bendera menghitung skor kognitif dan peringkat persentil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor akhir Anda menggabungkan akurasi murni, latensi kecepatan respons milidetik, dan pengali kombo beruntun. Jawaban benar yang cepat dan berurutan memberikan poin maksimum (hingga 100.000), membandingkan kecepatan pengambilan visual Anda terhadap persentil psikometrik global."
        }
      },
      {
        "@type": "Question",
        "name": "Apa perbedaan antara Mode Sprint, Mode Survival, dan Mode Sulit Veksilologi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mode Sprint menguji akurasi Anda dalam 20 bendera acak. Mode Survival adalah tantangan ketahanan sudden-death di mana satu kesalahan langsung mengakhiri sesi. Mode Sulit Veksilologi secara khusus mempertemukan pasangan bendera yang terkenal identik (seperti Monako vs. Indonesia atau Chad vs. Rumania)."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa beberapa bendera negara tampak hampir identik (misalnya Chad dan Rumania, Monako dan Indonesia)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Chad dan Rumania memiliki triwarna vertikal biru-kuning-merah yang identik karena perkembangan sejarah yang independen. Monako dan Indonesia sama-sama menggunakan dwiwarna horizontal merah-putih, hanya berbeda pada proporsi fisik (Monako 4:5 vs. Indonesia 2:3) dan asal-usul heraldik."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana latihan mengenali bendera meningkatkan memori visual kognitif?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pengenalan bendera mengaktifkan Teori Pengkodean Ganda Paivio (Dual-Coding Theory) dengan menghubungkan pengetahuan geografis semantik (ibu kota, nama negara, benua) dengan pola warna visual-spasial dan geometri heraldik, memperkuat jalur pengambilan sinaptik otak."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa banyak bendera negara berdaulat yang termasuk dalam tolok ukur ini?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mesin kuis mencakup seluruh 195+ negara berdaulat yang diakui secara universal di seluruh Eropa, Asia, Afrika, Amerika, dan Oseania, lengkap dengan ibu kota terverifikasi dan metadata regional."
        }
      },
      {
        "@type": "Question",
        "name": "Apa standar 5 aturan North American Vexillological Association (NAVA)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "NAVA merumuskan lima prinsip desain bendera universal: (1) Buat cukup sederhana agar dapat digambar anak-anak dari ingatan, (2) Gunakan simbolisme yang bermakna, (3) Batasi 2–3 warna dasar berpenampilan kontras, (4) Hindari tulisan atau lambang negara yang rumit, dan (5) Tampilkan ciri khas tersendiri atau tunjukkan hubungan warisan regional yang jelas."
        }
      },
      {
        "@type": "Question",
        "name": "Dapatkah saya menggunakan kuis bendera ini untuk persiapan olimpiade geografi atau lomba akademis?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Arena ini menyediakan filter benua dan mode tebak terbalik (mengidentifikasi bendera dari nama negara), menjadikannya alat pelatihan komprehensif untuk Olimpiade Sains Geografi, delegasi Model UN, dan peneliti veksilologi."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah data skor atau sesi permainan saya disimpan di server?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak. Seluruh mesin kuis, algoritma penilaian, dan sintesis Web Audio berjalan 100% secara lokal di peramban web Anda. Tidak ada data pribadi atau rekaman kuis yang dikirim ke server jarak jauh mana pun."
        }
      }
    ]
  }
];
---

<LayoutId title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema}>
  <HeaderId />

  <main class="min-h-screen bg-white dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    
    <!-- Hero Header -->
    <section class="relative pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center overflow-hidden">
      <!-- Ambient Background Glow (Candidate 2 Single Masked Radial Wash) -->
      <div class="flag-hero-glow" aria-hidden="true"></div>

      <!-- Navigation Breadcrumb -->
      <nav class="flex items-center justify-center gap-2 text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
        <a href="/id" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Beranda</a>
        <span>/</span>
        <a href="/id/permainan" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Permainan Asah Otak</a>
        <span>/</span>
        <span class="text-zinc-800 dark:text-zinc-200 font-semibold">Kuis Bendera Dunia</span>
      </nav>

      <!-- Badge Pill -->
      <div class="relative inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-[#0066cc] dark:text-[#2997ff] text-[13px] font-mono font-bold tracking-wide uppercase mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        Tolok Ukur Geografi Spasial &amp; Memori Visual
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.025em] leading-[1.08] text-zinc-950 dark:text-white mb-4">
        Kuis Bendera Dunia: <span class="text-[#0066cc] dark:text-[#2997ff]">Arena Memori Geografis 195 Negara</span>
      </h1>

      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-[1.62] mb-6">
        Uji rekognisi pola visual dan daya ingat geografis Anda di 195+ negara berdaulat. Ukur latensi respons milidetik, kuasai pasangan bendera yang menipu, dan tolok ukur peringkat persentil global Anda.
      </p>

      <!-- Feature Chips -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-[13px] font-mono text-zinc-600 dark:text-zinc-400">
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">195+</span> Negara Berdaulat
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">4</span> Mode Kognitif
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">ms</span> Pelacakan Latensi
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/80 shadow-sm flex items-center gap-1.5">
          <span class="text-[#0066cc] dark:text-[#2997ff] font-bold">100%</span> Privat &amp; Gratis
        </span>
      </div>
    </section>

    <!-- Interactive Flag Quiz Arena -->
    <style>
      .flag-hero-glow { position: absolute; inset-inline: 0; top: 0; height: 24rem; pointer-events: none; background: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.10) 0%, rgba(0, 102, 204, 0.03) 45%, transparent 70%); mask-image: linear-gradient(to bottom, black 55%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%); }
      :global(.dark) .flag-hero-glow { background: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%); }
      .flag-mode-btn { min-height: 44px; }
      .flag-mode-btn:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
      #flagOptionsGrid button { min-height: 44px; }
      #flagOptionsGrid button:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
      #flagContinentSelect { min-height: 44px; }
      @media (prefers-reduced-motion: reduce) { .flag-hero-glow { display: none; } }
    </style>

    <section class="px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto mb-16">
      <div class="relative rounded-3xl bg-zinc-900/90 dark:bg-zinc-950/80 border border-zinc-800/90 shadow-2xl p-6 sm:p-8 backdrop-blur-xl transition-all">

        <!-- 1. START / CONFIGURATION CARD -->
        <div id="flagStartCard" class="space-y-6">
          
          <div class="text-center space-y-2">
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Konfigurasi Sesi Arena Anda</h2>
            <p class="text-[13px] sm:text-sm text-zinc-400">Pilih mode latihan kognitif dan cakupan wilayah geografis yang Anda inginkan.</p>
          </div>

          <!-- Mode Selector Grid -->
          <div class="space-y-2">
            <label class="block text-[13px] font-mono uppercase tracking-wider text-zinc-400">Pilih Mode Permainan</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <button type="button" data-mode="sprint" class="flag-mode-btn active p-3.5 rounded-2xl bg-zinc-900/80 border border-blue-500/40 bg-blue-500/10 text-blue-400 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Sprint 20 Soal</span>
                  <span class="text-[13px] font-mono opacity-80">Standar</span>
                </div>
                <p class="text-[13px] text-zinc-400 leading-tight">Tolok ukur kognitif terstandarisasi 20 ronde mengukur akurasi dan kecepatan reaksi.</p>
              </button>

              <button type="button" data-mode="survival" class="flag-mode-btn p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-zinc-300 hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Survival Tanpa Henti</span>
                  <span class="text-[13px] font-mono text-rose-400">Sudden Death</span>
                </div>
                <p class="text-[13px] text-zinc-400 leading-tight">Tantangan kombo tanpa akhir. Satu kesalahan langsung mengakhiri sesi. Pengali poin meningkat.</p>
              </button>

              <button type="button" data-mode="reverse" class="flag-mode-btn p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-zinc-300 hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Tebak Terbalik</span>
                  <span class="text-[13px] font-mono text-cyan-400">Nama → Bendera</span>
                </div>
                <p class="text-[13px] text-zinc-400 leading-tight">Diberikan nama negara dan ibu kota, temukan bendera yang tepat di antara 4 pilihan visual.</p>
              </button>

              <button type="button" data-mode="hard" class="flag-mode-btn p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-800 text-zinc-300 hover:border-zinc-700 text-left transition-all cursor-pointer">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm">Mode Sulit Veksilologi</span>
                  <span class="text-[13px] font-mono text-amber-400">Detail Mikro</span>
                </div>
                <p class="text-[13px] text-zinc-400 leading-tight">Sengaja mengadu pasangan bendera identik (Monako vs Indonesia, Chad vs Rumania, Irlandia vs Pantai Gading).</p>
              </button>
            </div>
          </div>

          <!-- Continent Filter -->
          <div class="space-y-2">
            <label for="flagContinentSelect" class="block text-[13px] font-mono uppercase tracking-wider text-zinc-400">Filter Geografis</label>
            <div class="relative">
              <select id="flagContinentSelect" class="w-full p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800 text-sm font-semibold text-white focus:outline-none focus:border-blue-500 transition-colors appearance-none cursor-pointer">
                <option value="all">🌍 Seluruh Negara Berdaulat (195+ Negara)</option>
                <option value="Europe">🏰 Eropa (44 Negara)</option>
                <option value="Asia">⛩️ Asia (49 Negara)</option>
                <option value="Americas">🌎 Amerika (35 Negara)</option>
                <option value="Africa">🦁 Afrika (54 Negara)</option>
                <option value="Oceania">🏝️ Oseania (14 Negara)</option>
              </select>
              <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-zinc-400 text-[13px]">▼</div>
            </div>
          </div>

          <!-- Start Action Button -->
          <button id="startFlagQuizBtn" type="button" class="w-full py-4 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-base tracking-wide uppercase transition-all shadow-lg shadow-blue-600/20 active:scale-[0.97] cursor-pointer">
            Mulai Arena Memori Geografis
          </button>
        </div>

        <!-- 2. LIVE GAMEPLAY ARENA CARD (Hidden by default) -->
        <div id="flagArenaCard" class="hidden space-y-6">
          
          <!-- Arena Header: Stats & Progress -->
          <div class="flex items-center justify-between border-b border-zinc-800/80 pb-4">
            <div class="space-y-0.5">
              <span id="flagQuizProgress" class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider">Pertanyaan 1 / 20</span>
              <div class="flex items-center gap-2">
                <span class="text-[13px] font-bold text-zinc-300">Skor:</span>
                <span id="flagLiveScore" class="text-base font-extrabold font-mono text-white">0</span>
              </div>
            </div>

            <!-- Streak Combo Badge -->
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-900 border border-zinc-800">
              <span class="text-[13px] text-zinc-400 font-sans">Kombo:</span>
              <span id="flagLiveStreak" class="text-sm font-extrabold font-mono text-white">0x</span>
            </div>
          </div>

          <!-- Target Presentation (Flag or Reverse Question) -->
          <div class="flex flex-col items-center justify-center py-4 space-y-4">
            <!-- Normal Mode Flag Image -->
            <div class="relative p-2 rounded-2xl bg-zinc-900 border border-zinc-800 shadow-xl overflow-hidden max-w-sm w-full flex items-center justify-center min-h-[160px]">
              <img id="flagTargetImage" src="" alt="Target Bendera" class="max-h-40 w-auto rounded-lg shadow object-contain transition-transform duration-200" />
            </div>

            <!-- Reverse Mode Country Title (Hidden during normal mode) -->
            <h3 id="flagCountryTitle" class="hidden text-xl sm:text-2xl font-extrabold text-white text-center tracking-tight"></h3>
          </div>

          <!-- Multiple Choice Options Grid -->
          <div id="flagOptionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Dynamically populated 4 options -->
          </div>

        </div>

        <!-- 3. DETAILED RESULTS SCORECARD (Hidden by default) -->
        <div id="flagResultsCard" class="hidden space-y-8">
          
          <!-- Hero Score Banner -->
          <div class="text-center space-y-2 p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800">
            <span class="text-[13px] font-mono uppercase tracking-widest text-[#0066cc] dark:text-[#2997ff]">Sesi Arena Selesai</span>
            <div id="resFlagScore" class="text-4xl sm:text-6xl font-black font-mono text-white">
              0
            </div>
            <div class="flex items-center justify-center gap-2 pt-1">
              <span id="resFlagTier" class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 font-extrabold text-[13px] tracking-wide">
                Grandmaster Veksilologi
              </span>
              <span id="resFlagPercentile" class="text-[13px] font-mono text-zinc-400">
                Persentil 1% Teratas
              </span>
            </div>
            <p id="resFlagDesc" class="text-[13px] sm:text-sm text-zinc-400 max-w-md mx-auto pt-2 leading-relaxed"></p>
          </div>

          <!-- Core Metric Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
            <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800 space-y-0.5">
              <span class="text-[13px] font-mono text-zinc-400 uppercase">Akurasi</span>
              <div id="resFlagAccuracy" class="text-lg sm:text-xl font-bold font-mono text-white">0%</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800 space-y-0.5">
              <span class="text-[13px] font-mono text-zinc-400 uppercase">Rata-rata Reaksi</span>
              <div id="resFlagReaction" class="text-lg sm:text-xl font-bold font-mono text-[#2997ff]">0ms</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800 space-y-0.5">
              <span class="text-[13px] font-mono text-zinc-400 uppercase">Benar</span>
              <div id="resFlagCorrect" class="text-lg sm:text-xl font-bold font-mono text-white">0 / 0</div>
            </div>
            <div class="p-3.5 rounded-2xl bg-zinc-900 border border-zinc-800 space-y-0.5">
              <span class="text-[13px] font-mono text-zinc-400 uppercase">Maks Kombo</span>
              <div id="resFlagMaxStreak" class="text-lg sm:text-xl font-bold font-mono text-white">0x</div>
            </div>
          </div>

          <!-- Regional Mastery Breakdown -->
          <div class="space-y-3">
            <h4 class="text-[13px] font-mono uppercase tracking-wider text-zinc-400">Rincian Penguasaan Kontinental</h4>
            <div id="resFlagRegionsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- Dynamically populated progress bars -->
            </div>
          </div>

          <!-- Missed Flags Review Section -->
          <div id="resFlagMissedWrap" class="hidden space-y-3">
            <h4 class="text-[13px] font-mono uppercase tracking-wider text-rose-400">Evaluasi Bendera yang Salah</h4>
            <div id="resFlagMissedList" class="space-y-2 max-h-60 overflow-y-auto pr-1">
              <!-- Dynamically populated missed flag rows -->
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-3 pt-2">
            <button id="retakeFlagQuizBtn" type="button" class="flex-1 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-sm uppercase tracking-wider transition-all shadow-md active:scale-[0.97] cursor-pointer">
              Ulangi Tantangan Arena
            </button>
            <a href="/id/permainan" class="py-3.5 px-6 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-center text-sm font-bold text-zinc-300 transition-colors">
              Semua Permainan Otak
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- Comprehensive 2,000+ Word Authoritative Guide & Educational Text in Indonesian -->
    <article class="px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto pb-24 text-zinc-700 dark:text-zinc-300 leading-relaxed space-y-12">
      
      <!-- Section 1 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white tracking-tight border-b border-zinc-200 dark:border-zinc-800 pb-3">
          1. Sains Kognitif Memori Geografis &amp; Daya Ingat Visual
        </h2>
        <p>
          Memori visual manusia adalah salah satu subsistem kognitif paling kuat dan telah terasah secara evolusioner di dalam otak manusia. Berbeda dengan deretan alfanumerik yang abstrak, geometri visual, kontras warna, dan orientasi spasial diproses secara simultan di seluruh korteks visual primer (area V1 hingga V4) dan dikodekan langsung ke dalam <em>ventral stream</em>-jalur saraf yang bertanggung jawab untuk identifikasi objek dan kategorisasi semantik.
        </p>
        <p>
          Dalam psikologi kognitif, proses mengenali dan mengidentifikasi bendera negara berdaulat menjadi contoh nyata dari <strong>Teori Pengkodean Ganda Paivio (Paivio’s Dual-Coding Theory)</strong>. Menurut teori ini, informasi dikodekan ke dalam memori jangka panjang manusia melalui dua saluran terpisah namun saling terhubung erat:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
          <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 space-y-2">
            <span class="text-[13px] font-mono font-bold text-blue-500 uppercase tracking-wider">Saluran Visual-Spasial (Gambar)</span>
            <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Mengodekan bentuk geometris, kombinasi warna, kanton, lambang heraldik, dan rasio proporsi ke dalam memori kerja visual-spasial langsung.</p>
          </div>
          <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 space-y-2">
            <span class="text-[13px] font-mono font-bold text-cyan-500 uppercase tracking-wider">Saluran Verbal-Semantik (Bahasa)</span>
            <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Mengodekan nama negara, ibu kota nasional, afiliasi benua, perjanjian geopolitik, dan asal-usul sejarah ke dalam jaringan memori semantik.</p>
          </div>
        </div>
        <p>
          Saat Anda berlatih di Arena Memori Geografis kami, kedua jalur saraf ini teraktivasi secara paralel. Dengan mengaitkan gambar visual bendera nasional dengan tata nama geografis dan ibu kotanya, Anda membangun jejak memori asosiatif (engram) yang kokoh, sehingga sangat tahan terhadap interferensi retroaktif dan pemburukan kognitif alami.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white tracking-tight border-b border-zinc-200 dark:border-zinc-800 pb-3">
          2. Prinsip Veksilologi: 5 Aturan Universal Desain Bendera
        </h2>
        <p>
          Veksilologi-studi ilmiah tentang sejarah, simbolisme, dan penggunaan bendera-diresmikan pada tahun 1957 oleh akademisi Amerika Serikat, Dr. Whitney Smith. Pada tahun 2006, North American Vexillological Association (NAVA), bekerja sama dengan The Flag Institute, menerbitkan panduan definitif <em>"Good Flag, Bad Flag"</em> yang ditulis oleh Ted Kaye. Standar ini merumuskan lima prinsip mendasar yang mendefinisikan efektivitas ikonografi nasional:
        </p>

        <div class="space-y-3 my-4">
          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-blue-500">01</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Buat Sangat Sederhana (Keep It Simple)</h3>
              <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Bendera nasional harus cukup sederhana agar seorang anak dapat menggambarnya dari ingatan. Contoh terbaik meliputi bendera minimalis Hinomaru Jepang (cakram matahari merah pada latar putih) dan bendera Swiss (salib putih pada latar merah).</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-blue-500">02</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Gunakan Simbolisme yang Bermakna</h3>
              <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Setiap warna, elemen, atau garis harus mewakili sejarah bangsa, nilai budaya, atau bentang alam geografis (misalnya trisula Barbados yang menandakan kemerdekaan dari penjajahan, dikelilingi oleh birunya perairan Karibia).</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-blue-500">03</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Batasi Hanya 2–3 Warna Dasar</h3>
              <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Pilih warna primer dan sekunder standar yang kontras tinggi: merah, biru, hijau, kuning, putih, dan hitam. Hindari gradasi warna buram yang sulit dibedakan dari kejauhan atau pada layar digital ponsel.</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-blue-500">04</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Tanpa Tulisan Huruf atau Lambang Rumit</h3>
              <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Menuliskan teks atau menempelkan segel lambang negara yang rumit pada bendera bertentangan dengan tujuan sinyal visual cepat. Jika bendera memerlukan tulisan namanya agar dikenali, maka simbolisme visualnya dianggap gagal.</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex gap-4">
            <span class="text-lg font-black font-mono text-blue-500">05</span>
            <div>
              <h3 class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Tampilkan Ciri Khas atau Tunjukkan Hubungan Warisan yang Jelas</h3>
              <p class="text-[13px] text-zinc-600 dark:text-zinc-400">Bendera harus menghindari duplikasi yang membingungkan kecuali jika sengaja menunjukkan solidaritas regional (seperti keluarga salib Nordik Skandinavia atau federasi biru-putih-biru Amerika Tengah).</p>
            </div>
          </div>
        </div>
      </section>

