---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Pusat Latihan Kognitif: Soal Latihan Tes IQ & Solusi Bertahap | FreeIQExam";
const description = "Kuasai soal tes IQ dan penalaran kognitif dengan latihan mandiri tanpa batas waktu. Solusi langkah-demi-langkah untuk 5 aturan matriks Carpenter, rotasi 3D, deret angka, dan silogisme.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pusat Latihan Kognitif",
    "url": "https://freeiqexam.com/id/latihan/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Platform latihan kognitif interaktif tanpa batas waktu disertai penjelasan solusi bertahap di 4 domain kecerdasan CHC.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Pusat Latihan",
        "item": "https://freeiqexam.com/id/latihan/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apa perbedaan antara tes terwaktu dan latihan tanpa batas waktu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Asesmen terwaktu mensimulasikan lingkungan tes terstandarisasi di bawah batas waktu 15-20 menit untuk mengukur kecepatan performa. Latihan tanpa batas waktu memberikan penjelasan solusi langkah-demi-langkah langsung setelah setiap soal sehingga Anda dapat mempelajari aturan transformasi secara mandiri."
        }
      },
      {
        "@type": "Question",
        "name": "Apa saja 5 aturan Carpenter untuk penalaran matriks?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Carpenter, Just, dan Shell (1990) mengidentifikasi 5 algoritma transformasi utama dalam matriks progresif: konstanta dalam baris, progresi kuantitatif, distribusi tiga nilai, distribusi dua nilai (pembatalan Boolean XOR), dan gerakan rotasi spasial."
        }
      },
      {
        "@type": "Question",
        "name": "Bisakah berlatih soal kognitif meningkatkan skor tes IQ resmi saya?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Latihan meningkatkan keakraban terhadap format tes, mengurangi kecemasan ujian, dan membangun skema rekognisi pola yang lebih cepat. Mengeliminasi kesalahan prosedural dan jebakan opsi pengecoh umumnya memberikan peningkatan performa terukur sebesar 5 hingga 10 poin."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah komunitas IQ tinggi menguji tipe soal yang serupa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Komunitas IQ tinggi seperti Mensa, Intertel, dan Triple Nine memanfaatkan instrumen standar (seperti WAIS-IV, Stanford-Binet, Cattell Culture Fair, dan Raven's APM) yang banyak menguji induksi matriks, rotasi mental spasial, deret numerik, dan analogi verbal."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/practice">
  <Header currentPath="/id/latihan" enPath="/practice" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-14 max-w-6xl">
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>PUSAT LATIHAN KOGNITIF &bull; LATIHAN TANPA BATAS WAKTU</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Latih Kemampuan Kognitif Anda Berdasarkan Domain
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Tingkatkan kecepatan penalaran deduktif, rotasi mental spasial, dan logika analitis Anda. Pilih latihan tanpa batas waktu dengan solusi bertahap atau ikuti tes domain terstandardisasi 15 menit.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">4 Domain Kognitif CHC</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Penjelasan Solusi Langkah demi Langkah</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">100% Gratis Tanpa Batas</span>
      </div>
    </header>

    <!-- 4 Domains Practice Cards Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Domain 1: Matrix Reasoning (Gf) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800 text-xs font-mono">
            <span>Penalaran Fluida (Gf)</span>
          </div>
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
            Penalaran Matriks &amp; Induksi Pola
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Pelajari 5 aturan transformasi Carpenter dalam matriks progresif 3x3, termasuk pembatalan Boolean XOR, deret rotasi, dan pergantian bentuk perimetris.
          </p>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a href="/id/tes-penalaran-matriks" class="flex-1 py-3 px-4 rounded-xl bg-blue-600 text-white font-bold text-xs sm:text-sm text-center hover:bg-blue-500 transition-colors">
            Tes Matriks 20 Soal &rarr;
          </a>
        </div>
      </div>

      <!-- Domain 2: Visual-Spatial Processing (Gv) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-50 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300 border border-sky-200 dark:border-sky-800 text-xs font-mono">
            <span>Pemrosesan Visual-Spasial (Gv)</span>
          </div>
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
            Rotasi Spasial 3D &amp; Jaring Lipatan
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Latih manipulasi mental objek isometrik 3D, uji kiralitas enantiomer pada kubus terputar, dan sintesis jaring permukaan 2D menjadi bentuk 3D utuh.
          </p>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a href="/id/tes-spasial" class="flex-1 py-3 px-4 rounded-xl bg-sky-600 text-white font-bold text-xs sm:text-sm text-center hover:bg-sky-500 transition-colors">
            Tes Spasial 20 Soal &rarr;
          </a>
        </div>
      </div>

      <!-- Domain 3: Quantitative Reasoning (Gq) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800 text-xs font-mono">
            <span>Penalaran Kuantitatif (Gq)</span>
          </div>
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
            Deret Angka &amp; Struktur Relasional
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Identifikasi pola deret bilangan bertingkat, relasi rasio aljabar, dan algoritma induktif numerik yang tersembunyi.
          </p>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a href="/id/tes-kuantitatif" class="flex-1 py-3 px-4 rounded-xl bg-amber-600 text-white font-bold text-xs sm:text-sm text-center hover:bg-amber-500 transition-colors">
            Tes Kuantitatif 20 Soal &rarr;
          </a>
        </div>
      </div>

      <!-- Domain 4: Verbal Logic (Gc) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-xs font-mono">
            <span>Pemahaman Verbal &amp; Logika (Gc)</span>
          </div>
          <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
            Silogisme Deduktif &amp; Analogi Kata
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Uji validitas kesimpulan logis formal Aristotelian dan telaah hierarki semantik abstrak dalam hubungan analogi verbal.
          </p>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a href="/id/tes-verbal" class="flex-1 py-3 px-4 rounded-xl bg-emerald-600 text-white font-bold text-xs sm:text-sm text-center hover:bg-emerald-500 transition-colors">
            Tes Verbal 20 Soal &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Dual Full Track Callouts -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-900 border border-zinc-800 text-white">
      <div class="max-w-3xl mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 uppercase tracking-wider mb-3">
          EVALUASI MULTI-DOMAIN KOMPREHENSIF
        </span>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white">
          Siap untuk Skor Komposit Tersertifikasi?
        </h2>
        <p class="text-sm sm:text-base text-zinc-400 mt-2 leading-relaxed">
          Latihan domain mengisolasi kemampuan tertentu, tetapi skor IQ klinis membutuhkan sampling komposit di keempat faktor CHC untuk menghitung estimasi faktor umum (g) yang akurat.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Quick Screener -->
        <div class="p-6 rounded-2xl bg-zinc-800/60 border border-zinc-700/60 backdrop-blur-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-400 font-semibold mb-1 uppercase tracking-wider">Opsi A</div>
            <h3 class="font-heading font-bold text-xl text-white mb-2">
              Skrining Cepat 10 Menit
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
              12 soal (3 dari masing-masing 4 domain). Asesmen cepat dan ramping yang memberikan skor IQ sementara dan peringkat persentil segera.
            </p>
          </div>
          <a
            href="/id/tes-singkat"
            class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-zinc-950 bg-white hover:bg-zinc-100 transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Mulai Skrining Cepat (10 mnt)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Full Assessment -->
        <div class="p-6 rounded-2xl bg-zinc-800/90 border border-zinc-700 backdrop-blur-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-blue-400 font-semibold mb-1 uppercase tracking-wider">Opsi B (Disarankan)</div>
            <h3 class="font-heading font-bold text-xl text-white mb-2">
              Asesmen Komprehensif 20 Menit
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
              24 soal (6 per domain). Presisi psikometrik tinggi, interval kredibel posterior 95%, sertifikat resolusi tinggi yang dapat diunduh, dan akordeon tinjauan lengkap.
            </p>
          </div>
          <a
            href="/id/tes"
            class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Mulai Asesmen Lengkap (20 mnt)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Educational Guide Section -->
    <section class="space-y-8">
      <div>
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-2">
          Masterclass Pemecahan Masalah Kognitif
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Kuasai prinsip formal yang dipakai ilmuwan kognitif dan psikometriawan untuk menyusun butir tes sulit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1. Carpenter's Matrix Rules -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold flex items-center justify-center mb-4">
            1
          </div>
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            5 Aturan Matriks Carpenter
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            Dalam makalah Cognitive Psychology 1990, Carpenter, Just, dan Shell mengidentifikasi 5 aturan transformasi universal pada puzzle matriks:
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300">
            <li>&bull; <strong>Konstan dalam baris:</strong> Bentuk tidak berubah secara horizontal.</li>
            <li>&bull; <strong>Progresi kuantitatif:</strong> Jumlah titik bertambah (+1, +2).</li>
            <li>&bull; <strong>Distribusi 3 nilai:</strong> Permutasi bujur sangkar Latin.</li>
            <li>&bull; <strong>Distribusi 2 nilai:</strong> Pembatalan XOR segmen tumpang tindih.</li>
            <li>&bull; <strong>Gerakan &amp; rotasi:</strong> Progresi langkah 45 atau 90 derajat searah jarum jam.</li>
          </ul>
        </div>

        <!-- 2. Mentally Unrolling 3D Cube Nets -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold flex items-center justify-center mb-4">
            2
          </div>
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            Membuka Jaring Kubus 3D secara Mental
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            Untuk mengeliminasi proyeksi kubus 3D yang salah dengan cepat tanpa disorientasi:
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300">
            <li>&bull; <strong>Invariansi Sisi Berlawanan:</strong> Sisi yang dipisahkan satu kotak pada jaring akan berlawanan pada kubus 3D. Jika keduanya terlihat pada opsi, eliminasi seketika.</li>
            <li>&bull; <strong>Aturan Verteks T-Junction:</strong> Sudut-sudut yang bertemu pada jahitan 3 arah akan bersentuhan pada benda jadi.</li>
            <li>&bull; <strong>Kiralitas &amp; Kidal:</strong> Periksa apakah panah atau garis diagonal berputar searah atau berlawanan jarum jam relatif terhadap tetangganya.</li>
          </ul>
        </div>

        <!-- 3. Diagramming Formal Syllogisms -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold flex items-center justify-center mb-4">
            3
          </div>
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            Menggambarkan Silogisme Formal
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            Logika Aristoteles formal menuntut penurunan kesimpulan dengan keniscayaan deduktif 100%:
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300">
            <li>&bull; <strong>Afirmatif Universal:</strong> "Semua A adalah B" berarti himpunan A sepenuhnya tertutup dalam himpunan B.</li>
            <li>&bull; <strong>Afirmatif Partikular:</strong> "Sebagian A adalah B" berarti irisan himpunan A dan B tidak kosong.</li>
            <li>&bull; <strong>Aturan Premis Negatif:</strong> Jika satu premis negatif, kesimpulan valid juga harus negatif. Dua premis negatif tidak menghasilkan deduksi silogistik valid.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="space-y-4">
      <div class="border-b border-zinc-200 dark:border-zinc-800 pb-4">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Pertanyaan yang Sering Diajukan (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Pertanyaan mengenai efektivitas latihan kognitif dan aturan transformasi matriks.
        </p>
      </div>

      <div class="space-y-3">
        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Apa perbedaan antara tes terwaktu dan latihan tanpa batas waktu?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Asesmen terwaktu mensimulasikan lingkungan tes terstandarisasi di bawah batas waktu 15-20 menit untuk mengukur kecepatan performa. Latihan tanpa batas waktu memberikan penjelasan solusi langkah-demi-langkah langsung setelah setiap soal sehingga Anda dapat mempelajari aturan transformasi secara mandiri.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Apa saja 5 aturan Carpenter untuk penalaran matriks?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Carpenter, Just, dan Shell (1990) mengidentifikasi 5 algoritma transformasi utama dalam matriks progresif: konstanta dalam baris, progresi kuantitatif, distribusi tiga nilai, distribusi dua nilai (pembatalan Boolean XOR), dan gerakan rotasi spasial.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Bisakah berlatih soal kognitif meningkatkan skor tes IQ resmi saya?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Latihan meningkatkan keakraban terhadap format tes, mengurangi kecemasan ujian, dan membangun skema rekognisi pola yang lebih cepat. Mengeliminasi kesalahan prosedural dan jebakan opsi pengecoh umumnya memberikan peningkatan performa terukur sebesar 5 hingga 10 poin.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800">
          <summary class="flex items-center justify-between font-semibold text-zinc-900 dark:text-white cursor-pointer list-none text-sm sm:text-base">
            <span>Apakah komunitas IQ tinggi menguji tipe soal yang serupa?</span>
            <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
