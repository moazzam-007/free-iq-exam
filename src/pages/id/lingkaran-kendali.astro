---
import LayoutId from '../../components/id/LayoutId.astro';
import HeaderId from '../../components/id/HeaderId.astro';
import FooterId from '../../components/id/FooterId.astro';

const title = 'Lingkaran Kendali dan Kejernihan Mental | FreeIQExam';
const description = 'Pisahkan hal yang dapat dikendalikan, dipengaruhi, dan hanya menjadi perhatian melalui latihan refleksi Stoik privat.';
const canonicalUrl = 'https://freeiqexam.com/id/lingkaran-kendali';

const faqItems = [
  {
    q: "Apa itu lingkaran kendali dalam filsafat Stoik?",
    a: "Lingkaran kendali adalah singkatan visual modern untuk dikotomi kendali Stoik yang pertama dinyatakan Epiktetus dalam Enchiridion: sebagian hal terserah kita — penilaian, intensi, pilihan, dan perilaku — dan sebagian lainnya tidak, seperti reputasi, properti, opini orang lain, dan peristiwa eksternal. Latihan ini meminta Anda memilah tiap kekhawatiran ke agensi langsung (Kendali), dampak tak langsung (Pengaruh), atau nol agensi (Perhatian), lalu menginvestasikan usaha hanya di mana kepemilikan nyata."
  },
  {
    q: "Apa beda dikotomi dan trikotomi kendali?",
    a: "Epiktetus membuka dengan biner ketat: apa yang bergantung pada kita versus yang tidak. Guru modern William B. Irvine mempopulerkan trikotomi praktis yang menambah zona tengah kendali parsial untuk kasus campuran — pertandingan tenis, wawancara kerja, perbincangan sulit — di mana persiapan sungguh penting tetapi tak dapat menjamin hasil. Cincin tengah mencegah dua galat paling umum: mengklaim tanggung jawab atas keberuntungan, dan menelantarkan daya ungkit yang sebenarnya dimiliki."
  },
  {
    q: "Apa isi tiap cincin? Contoh konkret?",
    a: "Kendali memuat agensi langsung: persiapan, usaha, kebiasaan harian, rutinitas tidur, pilihan belanja, batasan, pembicaraan diri, dan cara merespons setelah informasi baru. Pengaruh memuat dampak tak langsung: membujuk kolega, mengajak bicara jujur, menegosiasi tagihan, mengajar, atau merapikan lingkungan. Perhatian memuat nol agensi: masa lalu, vonis orang lain, inflasi dan pasar, cuaca dan lalu lintas, risiko genetik dan fakta penuaan, serta hasil final. Uji bermanfaat adalah pertanyaan perintah: bisakah Anda menjamin ini dengan berusaha lebih keras? Jika tidak, ia tidak tinggal di cincin dalam."
  },
  {
    q: "Apakah fokus pada yang dikendalikan berarti pasif atau menyerah?",
    a: "Tidak — penerimaan bukan pasivitas. Stoikisme meminta Anda berhenti menuntut hasil terjamin, bukan berhenti bertindak. Marcus Aurelius membingkai rintangan sebagai bahan baku: halangan bagi tindakan memajukan tindakan. Reframe tiap Perhatian di alat ini diakhiri pertanyaan yang sama: bagaimana cara mengubah perhatian ini menjadi satu titik kendali yang dapat ditindaklanjuti dalam dua puluh menit ke depan?"
  },
  {
    q: "Bagaimana sortir lingkaran-kendali mengurangi kecemasan? Apa kata riset CBT?",
    a: "Kecemasan menggelembung saat otak memperlakukan tiap hasil tak pasti sebagai darurat. Penyortiran mengeksternalisasi loop itu: menamai kekhawatiran, memisahkan peristiwa dari penilaian, dan menemukan satu tuas memulihkan kendali persepsian, yang diriset lokus kendali (Rotter, 1966) kaitkan dengan distres lebih rendah. CBT memakai mekanisme sama — restrukturisasi kognitif, dekatastrofisasi, coping berfokus-masalah. Albert Ellis, pendiri REBT, secara eksplisit memuji pengaruh Stoik."
  },
  {
    q: "Bisakah alat ini membantu burnout kerja, konflik relasi, cemas finansial, atau khawatir kesehatan?",
    a: "Itulah tepat empat preset bawaan observatorium. Kewalahan kerja memisahkan output dan prioritas Anda (Kendali) serta pertanyaan klarifikasi (Pengaruh) dari suasana hati bos dan penilaian final (Perhatian). Cemas relasi memisahkan integritas, mendengar, dan batasan Anda dari validasi mereka. Ketakutan finansial memisahkan anggaran dan skill dari inflasi dan pasar. Khawatir kesehatan memisahkan gerak, nutrisi, tidur, dan cek-up dari risiko genetik dan penuaan."
  },
  {
    q: "Apakah ini tes klinis? Bisakah mendiagnosis kecemasan atau depresi?",
    a: "Tidak. Indeks Agensi di halaman ini adalah visualisasi reflektif — bukan pengukuran klinis, diagnosis, atau rekomendasi pengobatan. Filsafat Stoik adalah kerangka etis, dan CBT adalah psikoterapi terstruktur dengan standar bukti dan supervisi klinis sendiri. Jika mengalami kecemasan, depresi, panik berkepanjangan, atau masalah keamanan apa pun, hubungi profesional berlisensi atau layanan krisis lokal."
  },
  {
    q: "Apakah data saya privat? Bisakah menyimpan atau mencetak rencana kejernihan Stoik?",
    a: "Ya keduanya. Seluruh mesin triase berjalan lokal di browser: kekhawatiran, klasifikasi, reframe, dan mikro-komitmen tersimpan hanya di localStorage perangkat dengan kunci coc_items_v1 dan tidak pernah dikirim ke server mana pun. Gunakan Salin Ringkasan, Unduh Rencana (.txt), atau Cetak Kartu Kejernihan. Atur Ulang Observatorium menghapus penyimpanan lokal seketika."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Lingkaran Kendali dan Kejernihan Mental",
    "url": "https://freeiqexam.com/id/lingkaran-kendali",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://freeiqexam.com/id/" },
      { "@type": "ListItem", "position": 2, "name": "Lingkaran Kendali", "item": "https://freeiqexam.com/id/lingkaran-kendali/" }
    ]
  }
];
---

<LayoutId
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  enPath="/circle-of-control"
>
  <HeaderId currentPath="/id/lingkaran-kendali" enPath="/circle-of-control" />

  <main class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Observatorium Kejernihan Mental Stoik · Dikotomi Kendali</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Lingkaran Kendali
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        “Sebagian hal berada dalam kendali kita dan sebagian lainnya tidak.” Pilah isi pikiran ke dalam yang Anda kuasai, yang dapat Anda bentuk, dan yang harus Anda lepaskan — lalu pulang dengan satu tindakan bajik. Gratis, privat, tanpa daftar.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16" aria-label="Interactive circle of control observatory">

      <!-- Quick-Add Triage Deck -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-8 mb-8 shadow-xl">
        <label for="worryInput" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
          <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>Sebutkan satu kekhawatiran, tekanan, atau situasi</span>
        </label>
        <form id="worryForm" class="flex flex-col gap-3">
          <input
            type="text"
            id="worryInput"
            maxlength="120"
            autocomplete="off"
            placeholder="e.g. What my manager thinks of me…"
            class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-3 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <button
              type="button"
              id="btnAddKendali"
              class="min-h-[44px] py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-emerald-600/20 transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg> Milikku untuk Dikendalikan
            </button>
            <button
              type="button"
              id="btnAddPengaruh"
              class="min-h-[44px] py-2.5 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs sm:text-sm shadow-lg shadow-cyan-600/20 transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg> Dapat Kupengaruhi
            </button>
            <button
              type="button"
              id="btnAddPerhatian"
              class="min-h-[44px] py-2.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:border-rose-400 font-bold text-xs sm:text-sm transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg> Di Luar Kendali
            </button>
          </div>
        </form>

        <!-- Starter chips -->
        <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800/80">
          <p class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Ketuk pemicu untuk menambah instan:</p>
          <div id="starterChips" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <!-- Four 1-Click Preset Scenarios -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
        <button
          type="button"
          data-preset="work"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 transition-all hover:-translate-y-0.5 cursor-pointer group"
        >
          <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">Kewalahan Kerja</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Tenggat · suasana bos · output</span>
        </button>
        <button
          type="button"
          data-preset="relationship"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500 transition-all hover:-translate-y-0.5 cursor-pointer group"
        >
          <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400 group-hover:text-cyan-600 dark:group-hover:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">Relasi & Sosial</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Validasi · integritas · perbincangan</span>
        </button>
        <button
          type="button"
          data-preset="financial"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-amber-500 transition-all hover:-translate-y-0.5 cursor-pointer group"
        >
          <svg class="w-6 h-6 text-amber-600 dark:text-amber-400 group-hover:text-amber-600 dark:group-hover:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7" /><polyline points="16 17 22 17 22 11" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-amber-600 dark:group-hover:text-amber-400">Ketidakpastian Finansial</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Inflasi · pasar · anggaran</span>
        </button>
        <button
          type="button"
          data-preset="health"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-rose-400 transition-all hover:-translate-y-0.5 cursor-pointer group"
        >
          <svg class="w-6 h-6 text-rose-500 group-hover:text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-rose-500">Kesehatan & Kesejahteraan</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Kebiasaan · gen · penuaan</span>
        </button>
      </div>

      <!-- Concentric Arena -->
      <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-4 sm:p-8 mb-8 shadow-2xl relative overflow-hidden">

        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 relative">
          <div>
            <h2 class="text-base sm:text-lg font-extrabold">Observatorium Konsentris</h2>
            <p id="countText" class="text-xs font-mono text-zinc-400" aria-live="polite">0 refleksi di observatorium</p>
          </div>
          <div class="flex items-center gap-2 text-[11px] font-mono">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>Kendali</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>Pengaruh</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>Perhatian</span>
          </div>
        </div>

        <div
          id="cocArena"
          class="coc-arena"
          role="application"
          aria-label="Interactive concentric circles. Drag reflections onto a ring, or use the C, I, O buttons on each card."
        >
          <svg viewBox="0 0 100 100" class="coc-rings" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs>
              <radialGradient id="cocPerhatianGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#fb7185" stop-opacity="0.02"></stop>
                <stop offset="100%" stop-color="#fb7185" stop-opacity="0.10"></stop>
              </radialGradient>
              <radialGradient id="cocPengaruhGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.03"></stop>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.12"></stop>
              </radialGradient>
              <radialGradient id="cocKendaliGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.06"></stop>
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.20"></stop>
              </radialGradient>
              <filter id="cocGlow" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="1.2" result="blur"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="blur"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>
            <!-- Outer: Perhatian -->
            <circle id="ringPerhatian" cx="50" cy="50" r="47" class="coc-ring coc-ring-concern" filter="url(#cocGlow)"></circle>
            <!-- Middle: Pengaruh -->
            <circle id="ringPengaruh" cx="50" cy="50" r="34" class="coc-ring coc-ring-influence" filter="url(#cocGlow)"></circle>
            <!-- Inner: Kendali -->
            <circle id="ringKendali" cx="50" cy="50" r="20" class="coc-ring coc-ring-control" filter="url(#cocGlow)"></circle>
            <circle cx="50" cy="50" r="2.2" class="coc-core"></circle>
            <text x="50" y="49.2" text-anchor="middle" class="coc-svg-title">KENDALI</text>
            <text x="50" y="52.6" text-anchor="middle" class="coc-svg-sub">pilihan · usaha · respons</text>
            <text x="50" y="24" text-anchor="middle" class="coc-svg-zone">PENGARUH</text>
            <text x="50" y="6.5" text-anchor="middle" class="coc-svg-zone coc-svg-zone-outer">PERHATIAN — LEPASKAN</text>
          </svg>
          <div id="cocCards" class="coc-cards"></div>
          <div id="cocEmpty" class="coc-empty">
            <strong>Buat yang tak terlihat menjadi terlihat.</strong>
            <span>Tambahkan kekhawatiran di atas — atau muat preset 1-klik — lalu seret tiap kartu ke cincin tempat daya ungkit sejatinya berada.</span>
          </div>
        </div>
        <p class="text-[11px] font-mono text-zinc-500 mt-3 relative">Kiat: posisi jatuh mengklasifikasi otomatis menurut radius · dalam = Kendali, tengah = Pengaruh, luar = Perhatian. Kartu melayang lembut; arahkan untuk menjeda dan bertindak.</p>

        <!-- Live ratio scorecards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5 relative" aria-live="polite">
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Indeks Agensi</span>
            <span id="statAgency" class="text-3xl font-black font-mono text-emerald-400">—</span>
            <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden mt-2">
              <div id="agencyBar" class="coc-bar-fill" style="width: 0%;"></div>
            </div>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-emerald-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Kendali</span>
            <span id="statKendali" class="text-3xl font-black font-mono text-emerald-400">0</span>
            <span id="ringCountKendali" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-cyan-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Pengaruh</span>
            <span id="statPengaruh" class="text-3xl font-black font-mono text-cyan-300">0</span>
            <span id="ringCountPengaruh" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-rose-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Perhatian</span>
            <span id="statPerhatian" class="text-3xl font-black font-mono text-rose-300">0</span>
            <span id="ringCountPerhatian" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
        </div>
        <p id="agencyDiagnostic" class="text-xs text-zinc-400 mt-3 relative">Tambahkan beberapa situasi untuk menghasilkan diagnostik agensi Anda.</p>
      </div>

      <!-- Stoic Action Plan -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-zinc-950 dark:text-white">Rencana Aksi Stoik Anda</h2>
            <p id="planIntro" class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Klasifikasikan situasi pertama untuk menghasilkan rencana aksi Stoik personal.</p>
