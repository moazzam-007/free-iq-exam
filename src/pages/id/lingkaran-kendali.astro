---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
const title = 'Lingkaran Kendali dan Kejernihan Mental | FreeIQExam';
const description = 'Pisahkan hal yang dapat dikendalikan, dipengaruhi, dan hanya menjadi perhatian melalui latihan refleksi Stoik privat.';
const canonicalUrl = 'https://freeiqexam.com/id/lingkaran-kendali';
---
<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/circle-of-control"><Header currentPath="/id/lingkaran-kendali" enPath="/circle-of-control" /><main class="flex-1 bg-white px-4 py-10 text-zinc-950 dark:bg-black dark:text-white sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><header class="mb-8 text-center"><span class="fx-tag">Refleksi Stoik</span><h1 class="mt-5 text-4xl font-extrabold tracking-[-0.025em] sm:text-5xl">Lingkaran Kendali</h1><p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">Tuliskan situasi yang membebani pikiran, lalu tempatkan pada Kendali, Pengaruh, atau Perhatian.</p></header><section class="rounded-3xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-950 sm:p-8"><form id="worryForm" class="flex gap-3"><input id="worryInput" class="min-h-[44px] flex-1 rounded-xl border border-zinc-300 bg-white px-4 dark:border-zinc-700 dark:bg-zinc-900" placeholder="Apa yang sedang Anda pikirkan?" /><button id="btnAddControl" type="button" class="min-h-[44px] rounded-xl bg-[#0066cc] px-4 font-semibold text-white dark:bg-[#2997ff]">Tambah</button></form><div id="cocCards" class="mt-6 space-y-3"></div><p id="cocEmpty" class="mt-6 text-zinc-500">Belum ada refleksi.</p><p id="countText" class="mt-4 font-mono text-[13px] text-zinc-500">0 refleksi</p><div class="mt-6 grid grid-cols-3 gap-3 text-center"><span id="statAgency" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">-</span><span id="statControl" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">0</span><span id="statConcern" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">0</span></div><p id="agencyDiagnostic" class="mt-5 text-zinc-600 dark:text-zinc-300">Tambahkan situasi untuk melihat ringkasan.</p><div class="hidden"><button id="btnAddInfluence" type="button"></button><button id="btnAddConcern" type="button"></button><div id="starterChips"></div><div id="cocArena"></div><div id="agencyBar"></div><span id="statInfluence"></span><span id="ringCountControl"></span><span id="ringCountInfluence"></span><span id="ringCountConcern"></span><div id="planFocusList"></div><div id="planInfluenceList"></div><div id="planReleaseList"></div><span id="planIntro"></span><span id="planQuoteText"></span><span id="planQuoteAuthor"></span><input id="commitInput" /><button id="btnSaveCommit" type="button"></button><button id="btnCopyPlan" type="button"></button><button id="btnDownloadPlan" type="button"></button><button id="btnPrintPlan" type="button"></button><button id="btnResetArena" type="button"></button><select id="reframeSelect"></select><button id="btnBuildReframe" type="button"></button></div></section></div></main><Footer /><script src="../../scripts/tools/circle-of-control-engine.js"></script></Layout>
