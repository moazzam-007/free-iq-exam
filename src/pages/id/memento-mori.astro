---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
const title = 'Memento Mori: Kalender Hidup dalam Minggu | FreeIQExam';
const description = 'Visualisasikan perjalanan hidup dalam minggu dan lihat estimasi harapan hidup secara privat di browser.';
const canonicalUrl = 'https://freeiqexam.com/id/memento-mori';
---
<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/memento-mori"><Header currentPath="/id/memento-mori" enPath="/memento-mori" /><main class="flex-1 bg-white px-4 py-10 text-zinc-950 dark:bg-black dark:text-white sm:px-6 lg:px-8"><div class="mx-auto max-w-5xl"><header class="mb-8 text-center"><span class="fx-tag">Perspektif waktu</span><h1 class="mt-5 text-4xl font-extrabold tracking-[-0.025em] sm:text-5xl">Memento Mori</h1><p class="mx-auto mt-4 max-w-2xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">Lihat hidup sebagai kumpulan minggu yang terbatas dan gunakan perspektif itu untuk memilih tindakan yang berarti.</p></header><section class="rounded-3xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-950 sm:p-8"><label>Tanggal lahir<input id="mementoDob" type="date" class="mt-2 min-h-[44px] rounded-xl border border-zinc-300 bg-white px-3 dark:border-zinc-700 dark:bg-zinc-900" /></label><div class="mt-8 grid gap-4 sm:grid-cols-4"><span id="statLivedWeeks" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">-</span><span id="statRemainingWeeks" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">-</span><span id="statPercentSpent" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">-</span><span id="statLifeExpectancy" class="rounded-xl bg-white p-4 font-mono text-2xl dark:bg-zinc-900">-</span></div><div id="lifeProgressBar" class="mt-6 h-3 rounded-full bg-[#0066cc] dark:bg-[#2997ff]" style="width:0%"></div><div id="lifeGridContainer" class="mt-8 overflow-x-auto"></div><div class="hidden"><input id="modExercise" type="checkbox" checked /><input id="modSleep" type="checkbox" checked /><input id="modDiet" type="checkbox" checked /><input id="modSmoking" type="checkbox" /><input id="modStress" type="checkbox" /><button id="downloadMementoPosterBtn" type="button"></button><button id="nextQuoteBtn" type="button"></button><span id="stoicQuoteText"></span><span id="stoicQuoteAuthor"></span><span id="stoicQuoteSource"></span><span id="statAgeYears"></span><span id="statRemainingDays"></span><span id="statRemainingHours"></span><span id="statRemainingHeartbeats"></span><div id="gridTooltip"></div></div></section></div></main><Footer /><script src="../../scripts/tools/memento-engine.js"></script></Layout>
