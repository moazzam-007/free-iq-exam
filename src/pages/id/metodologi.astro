---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Metodologi Psikometrik & Whitepaper Teori Respons Butir 2PL | FreeIQExam";
const description = "Dokumentasi teknis lengkap model matematika 2-Parameter Logistic IRT, estimasi Bayesian EAP, dan standardisasi kurva normal FreeIQExam.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Fondasi Psikometrik dan Metodologi Penilaian Teori Respons Butir 2-Parameter Logistik",
    "description": "Dokumen teknis psikometrik komprehensif mengenai mesin Teori Respons Butir 2-Parameter Logistik (2PL IRT), kuadratur Bayes Expected A Posteriori (EAP), validitas konstruk Cattell-Horn-Carroll, dan peta jalan kalibrasi empiris FreeIQExam.",
    "proficiencyLevel": "Expert",
    "inLanguage": "id",
    "url": "https://freeiqexam.com/id/metodologi",
    "author": {
      "@type": "Organization",
      "name": "Komite Psikometri FreeIQExam",
      "url": "https://freeiqexam.com/id/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam.com",
      "url": "https://freeiqexam.com/id/"
    },
    "about": [
      { "@type": "Thing", "name": "Item Response Theory" },
      { "@type": "Thing", "name": "Psikometri" },
      { "@type": "Thing", "name": "Teori Cattell-Horn-Carroll" },
      { "@type": "Thing", "name": "Estimasi Bayesian Expected A Posteriori" }
    ],
    "citation": [
      "https://doi.org/10.1016/j.intell.2014.01.004",
      "https://doi.org/10.7910/DVN/PDI7Y1",
      "https://doi.org/10.1007/BF02293801",
      "https://doi.org/10.3758/BRM.42.2.525"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Metodologi Psikometrik",
        "item": "https://freeiqexam.com/id/metodologi"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apa perbedaan antara Teori Respons Butir (IRT) 2PL dan Teori Tes Klasik (CTT)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dalam Teori Tes Klasik (CTT), penilaian bergantung pada persentase skor mentah (menjumlahkan jawaban benar), memperlakukan setiap soal seolah memiliki tingkat kesulitan dan bobot diagnostik yang sama. Sebaliknya, Teori Respons Butir 2-Parameter Logistik (2PL IRT) memodelkan setiap butir soal secara matematis dengan dua parameter terpisah: tingkat kesulitan (b) dan daya diskriminasi (a). Hal ini memastikan bahwa menjawab benar soal matriks yang sulit dan berdaya beda tinggi memberikan bukti kemampuan laten (theta) yang jauh lebih kuat daripada menyelesaikan soal pembuka yang mendasar."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa FreeIQExam menggunakan estimasi Bayes EAP daripada Estimasi Kemungkinan Maksimum (MLE)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Estimasi Kemungkinan Maksimum (Maximum Likelihood Estimation / MLE) gagal atau menghasilkan nilai tak hingga saat peserta memperoleh skor 0% (semua salah) atau 100% (semua benar). Estimasi Bayesian Expected A Posteriori (EAP) mengatasi masalah ini dengan mengintegrasikan fungsi kemungkinan di atas distribusi prior normal standar (N(0, 1)). Ini menghasilkan estimasi theta yang stabil, berhingga, tidak bias, serta nilai kesalahan standar (SEM) yang teratur di seluruh spektrum distribusi."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana tes matriks non-verbal dibandingkan dengan baterai klinis komprehensif seperti WAIS-IV?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Baterai klinis komprehensif seperti WAIS-IV atau SB5 mengevaluasi Full Scale IQ (FSIQ) di berbagai domain luas CHC, termasuk Pemahaman Verbal (Gc), Memori Kerja (Gwm), dan Kecepatan Pemrosesan (Gs). FreeIQExam mengisolasi Penalaran Fluida non-verbal (Gf) dan Pemrosesan Visual-Spasial (Gv) menggunakan penalaran matriks progresif, deret topologis, dan pola lipatan mental. Meskipun bebas dari bias budaya dan bahasa, platform ini adalah alat penyaringan kognitif edukatif, bukan diagnosis medis atau evaluasi neuropsikologis resmi."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana ADHD atau neurodivergensi memengaruhi performa pada penilaian kognitif ini?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kondisi seperti ADHD terutama memengaruhi fungsi eksekutif, kontrol perhatian berkelanjutan, dan memori kerja sementara daripada penalaran fluida mendasar (Gf). Karena FreeIQExam memiliki batas waktu, peserta yang mengalami kendala fokus atau impulsivitas dalam memilih opsi pengecoh dapat mengalami penurunan skor yang mencerminkan eksekusi tes daripada potensi analitis laten. Pengujian di lingkungan bebas distraksi membantu memastikan hasil mencerminkan kapasitas induksi pola sebenarnya."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa IQ simpangan distandardisasi dengan nilai rata-rata 100 dan simpangan baku 15?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Psikometri modern meninggalkan rasio usia mental dan beralih ke metrik Deviation IQ yang dirumuskan oleh David Wechsler. Dengan mentransformasikan estimasi sifat laten (theta) menggunakan rumus IQ = 100 + 15 * theta, skor berkorespondensi langsung dengan persentil populasi Gauss. Skor 100 mewakili median populasi persis (persentil 50), sementara skor 115 (+1 SD), 130 (+2 SD), dan 145 (+3 SD) masing-masing mewakili persentil ke-84,1, 97,7, dan 99,87."
        }
      },
      {
        "@type": "Question",
        "name": "Apa itu teori respons butir IRT?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Teori Respons Butir (IRT) adalah keluarga model psikometri yang menghubungkan karakteristik butir dengan peluang peserta memberikan respons tertentu pada tingkat kemampuan laten. Model 2PL menggunakan parameter kesulitan dan daya diskriminasi untuk menjelaskan perbedaan informatif antarsoal."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana metode penilaian tes IQ berbeda dari persentase jawaban benar?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Persentase jawaban benar hanya menghitung proporsi respons yang benar. Pendekatan IRT mencoba menggunakan informasi tentang karakteristik setiap butir sehingga dua peserta dengan jumlah jawaban benar yang sama dapat memperoleh estimasi kemampuan yang berbeda bila pola respons dan tingkat kesulitan soalnya berbeda."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/methodology">
  <Header currentPath="/id/metodologi" enPath="/methodology" />

  <main class="flex-1 py-10 md:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full space-y-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Metodologi Psikometrik</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4 border-b border-zinc-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium tracking-wider uppercase bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
        Dokumen Teknis Psikometrik (Whitepaper)
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight">
        Metodologi Psikometrik &amp; Mesin Penilaian 2PL IRT
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-4xl">
        Ulasan psikometrik komprehensif mengenai model Teori Respons Butir 2-Parameter Logistik (2PL IRT) FreeIQExam, estimasi sifat laten Bayesian Expected A Posteriori (EAP), validitas konstruk Cattell-Horn-Carroll (CHC), dan peta jalan kalibrasi empiris terbuka.
      </p>

      <!-- Meta Pill Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 text-xs font-mono">
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Edisi Dokumen</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Whitepaper v2.4 (2026)</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Kerangka Konstruk</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">CHC Stratum II</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Mesin Penilaian</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">2PL IRT + Bayesian EAP</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Metrik Standar</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Rerata = 100, SD = 15</span>
        </div>
      </div>
    </header>

    <!-- Quick Table of Contents -->
    <nav class="p-5 rounded-2xl bg-zinc-50/80 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm">
      <span class="font-heading font-bold text-zinc-950 dark:text-white uppercase tracking-wider text-xs block mb-3">
        Daftar Isi Whitepaper
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-zinc-600 dark:text-zinc-300">
        <a href="#section-1-chc" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">01.</span> Ringkasan Eksekutif &amp; Kerangka Kerja Konstruk CHC
        </a>
        <a href="#section-2-2pl" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">02.</span> Formulasi Matematis 2PL IRT &amp; Kurva Karakteristik Butir (ICC)
        </a>
        <a href="#section-3-eap" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">03.</span> Mesin Estimasi Bayesian Expected A Posteriori (EAP)
        </a>
        <a href="#section-4-standardization" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">04.</span> Standardisasi Skala vs. Norma Populasi Klinis
        </a>
        <a href="#section-5-subdomains" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">05.</span> Rasionalitas Pelaporan Sub-Domain Kognitif
        </a>
        <a href="#section-6-roadmap" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">06.</span> Peta Jalan Kalibrasi Sains Terbuka (N=500, N=1000)
        </a>
        <a href="#section-7-citations" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5 sm:col-span-2">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">07.</span> Sitasi Jurnal Ilmiah Peer-Reviewed &amp; DOI Dataverse
        </a>
      </div>
    </nav>

    <!-- Section 1: Executive Summary & Theoretical Foundations (CHC) -->
    <section id="section-1-chc" class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-6">
      <div>
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-2">
          Bagian 01
        </span>
        <h2 id="chc-framework" class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          Ringkasan Eksekutif &amp; Fondasi Teoretis (Kerangka CHC)
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Sains psikometri kontemporer mendasarkan asesmen kemampuan kognitif manusia pada model tiga strata Cattell-Horn-Carroll (CHC). Di bawah teori CHC, kemampuan kecerdasan umum (Stratum III g) tersusun dari domain kognitif luas yang berbeda (Stratum II), yang masing-masing didukung oleh kemampuan operasional spesifik yang sempit (Stratum I).
        </p>
      </div>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        FreeIQExam mengisolasi empat domain luas Stratum II utama yang menunjukkan korelasi empiris terkuat terhadap kecerdasan umum seraya meminimalkan bias kultural dan hambatan linguistik:
      </p>

      <!-- 4 Core Domains Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              1. Penalaran Fluida (Gf)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Kapasitas untuk mengekstrak aturan abstrak, memecahkan masalah non-verbal baru, dan menerapkan operasi logis dalam situasi asing. Diukur melalui penalaran matriks 3x3 induktif, transformasi Boolean XOR topologis, dan kelengkapan deret figural.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Bank Induk: 27 Butir Soal Terkalibrasi
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              2. Pemrosesan Visual-Spasial (Gv)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Kemampuan untuk mengamati, menyimpan, mengingat kembali, dan memutar secara mental pola visual serta objek 3D dalam ruang imajinasi. Diukur melalui rotasi kubus 3D kaku, sintesis jaring lipatan 2D-ke-3D, dan proyeksi ortografis.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Bank Induk: 25 Butir Soal Terkalibrasi
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              3. Penalaran Kuantitatif (Gq)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Kemampuan memahami properti kuantitatif, mengidentifikasi hubungan matematis bersarang, dan memecahkan struktur relasional numerik. Diukur melalui progresi induktif bertingkat dan penalaran aljabar proporsional.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Bank Induk: 24 Butir Soal Terkalibrasi
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              4. Pemahaman Verbal (Gc)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Keluasan dan kedalaman pengetahuan yang diperoleh dalam sistem linguistik, analogi leksikal relasional abstrak, hierarki semantik, dan silogisme logika deduktif kategoris formal.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Bank Induk: 24 Butir Soal Terkalibrasi
          </span>
        </div>
      </div>

      <!-- Master Bank Composition Table -->
      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800">
        <h4 class="font-heading font-bold text-sm text-zinc-950 dark:text-white uppercase tracking-wider mb-3">
          Arsitektur 100 Butir Soal Bank Pengembangan Induk
        </h4>
        <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
          <table class="w-full min-w-[560px] text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 font-mono">
                <th class="pb-2">Domain Luas CHC</th>
                <th class="pb-2">Jumlah Soal Bank Induk</th>
                <th class="pb-2">Alokasi Ujian Lengkap</th>
                <th class="pb-2">Ujian Khusus Domain</th>
                <th class="pb-2">Rentang Kesulitan (b_i)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200/70 dark:divide-zinc-800/70 font-mono">
              <tr>
                <td class="py-2.5 font-sans font-semibold text-zinc-900 dark:text-zinc-100">Penalaran Fluida (Gf)</td>
                <td class="py-2.5">27 soal</td>
                <td class="py-2.5">6 soal (25%)</td>
                <td class="py-2.5">20 soal</td>
                <td class="py-2.5">-2,10 hingga +2,55</td>
              </tr>
              <tr>
                <td class="py-2.5 font-sans font-semibold text-zinc-900 dark:text-zinc-100">Visual-Spasial (Gv)</td>
                <td class="py-2.5">25 soal</td>
                <td class="py-2.5">6 soal (25%)</td>
                <td class="py-2.5">20 soal</td>
                <td class="py-2.5">-1,90 hingga +2,40</td>
              </tr>
              <tr>
                <td class="py-2.5 font-sans font-semibold text-zinc-900 dark:text-zinc-100">Penalaran Kuantitatif (Gq)</td>
                <td class="py-2.5">24 soal</td>
                <td class="py-2.5">6 soal (25%)</td>
                <td class="py-2.5">20 soal</td>
                <td class="py-2.5">-1,80 hingga +2,50</td>
              </tr>
              <tr>
                <td class="py-2.5 font-sans font-semibold text-zinc-900 dark:text-zinc-100">Pemahaman Verbal (Gc)</td>
                <td class="py-2.5">24 soal</td>
                <td class="py-2.5">6 soal (25%)</td>
                <td class="py-2.5">20 soal</td>
                <td class="py-2.5">-2,00 hingga +2,35</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Section 2: Mathematical Formulation of 2PL IRT Model -->
    <section id="section-2-2pl" class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-6">
      <div>
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-2">
          Bagian 02
        </span>
        <h2 id="2pl-irt" class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          Formulasi Matematis Model Teori Respons Butir 2-Parameter Logistik (2PL)
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Teori Tes Klasik (CTT) memperlakukan setiap soal ujian secara seragam, memberikan skor kemampuan berdasarkan penjumlahan sederhana dari jawaban benar. Ini menghasilkan ketergantungan sampel yang parah: skor mentah tidak dapat membedakan apakah seorang peserta berhasil menyelesaikan soal sepele atau soal komposit yang luar biasa sulit. FreeIQExam mengatasi keterbatasan ini dengan mengimplementasikan model 2-Parameter Logistic (2PL) Item Response Theory.
        </p>
      </div>

      <!-- Formula Block -->
      <div class="p-5 sm:p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 space-y-3">
        <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Persamaan Standar Model 2PL IRT</div>
        <div class="font-mono text-base sm:text-lg text-blue-600 dark:text-blue-400 font-bold overflow-x-auto py-1">
          P_i(&theta;) = 1 / [ 1 + exp( -1.702 &times; a_i &times; (&theta; - b_i) ) ]
        </div>
        <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-1.5 pt-2">
          <p>Keterangan variabel:</p>
          <ul class="list-disc list-inside space-y-1 pl-1">
            <li><strong>&theta; (Theta):</strong> Sifat laten kognitif peserta ujian, terdistribusi di sepanjang kontinum normal standar N(0, 1).</li>
            <li><strong>a_i (Daya Diskriminasi):</strong> Kemiringan Kurva Karakteristik Butir (ICC) pada titik belok, mengkarakterisasi seberapa tajam soal tersebut membedakan antara peserta di atas versus di bawah ambang batas kemampuan.</li>
            <li><strong>b_i (Tingkat Kesulitan):</strong> Tingkat kemampuan laten di mana probabilitas respons yang benar tepat 50% (P_i(&theta;) = 0,50).</li>
            <li><strong>D = 1,702:</strong> Konstanta penskalaan ogive normal yang memastikan kesesuaian matematis antara metrik logistik dan fungsi distribusi normal kumulatif &Phi;(z).</li>
          </ul>
        </div>
