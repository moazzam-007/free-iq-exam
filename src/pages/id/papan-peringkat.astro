---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Papan Peringkat Kognitif Global: Tolok Ukur Skor Komunitas | FreeIQExam";
const description = "Lihat distribusi skor ilustratif komunitas dan tolok ukur kognitif global lintas domain penalaran matriks, memori kerja, dan kecepatan pemrosesan.";

const topScorers = [
  { rank: 1, flag: "🇺🇸", country: "Amerika Serikat", name: "Alex_V.", score: 146, percentile: "Persentil ke-99,9", domain: "Penalaran Fluida (FRI: 148)", hash: "v8f9-2a1c" },
  { rank: 2, flag: "🇯🇵", country: "Jepang", name: "Hana_K.", score: 142, percentile: "Persentil ke-99,7", domain: "Visual-Spasial (VSI: 145)", hash: "k4m2-9d3e" },
  { rank: 3, flag: "🇩🇪", country: "Jerman", name: "Marcus_S.", score: 138, percentile: "Persentil ke-99,4", domain: "Kuantitatif (QRI: 141)", hash: "s7x1-0p8b" },
  { rank: 4, flag: "🇨🇦", country: "Kanada", name: "Elena_R.", score: 135, percentile: "Persentil ke-99,0", domain: "Logika Verbal (VCI: 137)", hash: "r3c8-5w2y" },
  { rank: 5, flag: "🇬🇧", country: "Inggris Raya", name: "David_L.", score: 132, percentile: "Persentil ke-98,3", domain: "Penalaran Fluida (FRI: 134)", hash: "l9b6-4h7q" },
  { rank: 6, flag: "🇦🇺", country: "Australia", name: "Sarah_M.", score: 131, percentile: "Persentil ke-98,1", domain: "Kuantitatif (QRI: 133)", hash: "m2t5-8n1z" },
  { rank: 7, flag: "🇰🇷", country: "Korea Selatan", name: "Kenji_T.", score: 130, percentile: "Persentil ke-97,7", domain: "Visual-Spasial (VSI: 132)", hash: "t6v4-1k9x" },
  { rank: 8, flag: "🇮🇳", country: "India", name: "Priya_N.", score: 129, percentile: "Persentil ke-97,3", domain: "Penalaran Fluida (FRI: 131)", hash: "n5p7-3m8f" },
  { rank: 9, flag: "🇫🇷", country: "Prancis", name: "Lukas_B.", score: 128, percentile: "Persentil ke-96,9", domain: "Logika Verbal (VCI: 130)", hash: "b8q3-7r4d" },
  { rank: 10, flag: "🇳🇱", country: "Belanda", name: "Chloe_D.", score: 127, percentile: "Persentil ke-96,4", domain: "Visual-Spasial (VSI: 129)", hash: "d1w9-6v5s" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Papan Peringkat Kognitif Global",
    "description": description,
    "url": "https://freeiqexam.com/id/papan-peringkat"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Papan Peringkat",
        "item": "https://freeiqexam.com/id/papan-peringkat"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/leaderboard">
  <Header currentPath="/id/papan-peringkat" enPath="/leaderboard" />

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Papan Peringkat</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-500" aria-hidden="true"></span>
        <span>TOLOK UKUR KOGNITIF GLOBAL &bull; KOHORT ILUSTRATIF</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Tolok Ukur Kognitif Global &amp; Papan Peringkat Komunitas
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Tolok ukur sampel persentil yang dikalibrasi terhadap distribusi normatif Teori Respons Butir 2PL terstandarisasi pada populasi referensi internasional. Peringkat bersifat sepenuhnya anonim.
      </p>
    </header>

    <!-- Main Leaderboard Card -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="rounded-3xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 shadow-sm bg-white dark:bg-zinc-900">
        <!-- Card Header Banner -->
        <div class="px-6 sm:px-8 py-5 bg-zinc-900 border-b border-zinc-800 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-400 block mb-1">
              Skala Terstandarisasi (Rerata 100, SD 15)
            </span>
            <h2 class="text-lg sm:text-xl font-heading font-bold text-white">
              Sampel Tolok Ukur Persentil Kohort
            </h2>
          </div>
          <span class="px-3.5 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 shrink-0">
            Papan Peringkat Komunitas: Tahap Pengembangan
          </span>
        </div>

        <!-- Table container with responsive scroll -->
        <div class="overflow-x-auto">
          <div class="min-w-[500px]">
            <!-- Table Header -->
            <div class="grid grid-cols-[48px_1fr_90px_100px_1fr] gap-3 px-6 py-3.5 border-b border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider bg-zinc-50/70 dark:bg-zinc-900/80">
              <span>Peringkat</span>
              <span>Kohort Referensi</span>
              <span class="text-right">Skor IQ</span>
              <span class="text-right">Persentil</span>
              <span class="hidden sm:block">Domain Terkuat</span>
            </div>

            <!-- Scorer Rows -->
            <div class="divide-y divide-zinc-200/70 dark:divide-zinc-800/70 font-mono text-xs sm:text-sm">
              {topScorers.map((s) => (
                <div class="grid grid-cols-[48px_1fr_90px_100px_1fr] gap-3 px-6 py-3.5 items-center hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors">
                  <span class="font-bold text-zinc-900 dark:text-zinc-100">#{s.rank}</span>
                  <div class="flex items-center gap-2 font-sans font-medium text-zinc-900 dark:text-zinc-100 truncate">
                    <span>{s.flag}</span>
                    <span class="truncate">{s.name}</span>
                    <span class="text-[10px] text-zinc-400 font-mono hidden md:inline">({s.country})</span>
                  </div>
                  <span class="text-right font-bold text-blue-600 dark:text-blue-400">{s.score}</span>
                  <span class="text-right text-zinc-600 dark:text-zinc-400">{s.percentile}</span>
                  <span class="hidden sm:block text-zinc-500 dark:text-zinc-400 font-sans text-xs truncate">{s.domain}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Banner -->
      <div class="mt-6 p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white text-center sm:text-left">
            Ukur Performa Kognitif Anda
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 text-center sm:text-left">
            Selesaikan asesmen 20 menit untuk mengukur kemampuan laten terhadap tolok ukur populasi normatif ini. Sinkronisasi peringkat komunitas global dalam pengembangan.
          </p>
        </div>
        <a
          href="/id/tes"
          class="shrink-0 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all hover:scale-105 active:scale-[0.97] whitespace-nowrap"
        >
          Ikuti Asesmen Sekarang
        </a>
      </div>
    </section>

    <!-- How Qualification Works -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          Cara Kerja Perbandingan Tolok Ukur
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          Algoritma Teori Respons Butir 2PL kami mengevaluasi kemampuan laten individual (&theta;) Anda terhadap kohort populasi standar di keempat domain kognitif CHC.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            1
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Selesaikan Asesmen Lengkap
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Kerjakan evaluasi standar 24 soal mencakup penalaran Fluida, Spasial, Kuantitatif, dan Verbal dengan hitung mundur 20 menit.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            2
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Estimasi Sifat Laten (&theta;)
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Dapatkan skor kemampuan Bayesian EAP dan padanan IQ standar yang dipetakan ke populasi acuan normatif standar.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            3
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Bandingkan Persentil Kohort
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Tinjau estimasi sifat laten dan kekuatan domain langsung pada laporan Hasil Anda. Pengiriman skor komunitas global dan peringkat terverifikasi sedang dalam pengembangan aktif.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto">
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80">
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-4">
          Metodologi Tolok Ukur &amp; Referensi Kohort
        </h2>
        <div class="space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          <p>
            <strong>Apakah skor ini diagnosis klinis?</strong> Tidak. Peringkat tolok ukur ilustratif ini mewakili kohort acuan standar yang dikalibrasi via model IRT 2PL tanpa pengawasan kami. Ini adalah tolok ukur kognitif edukatif, bukan instrumen diagnostik klinis atau pengganti evaluasi psikologis terawasi seperti WAIS-IV.
          </p>
          <p>
            <strong>Bagaimana skor kohort acuan ditentukan?</strong> Skor tolok ukur ilustratif mewakili parameter distribusi normal standar (&mu; = 100, &sigma; = 15) yang dipetakan pada level kemampuan laten (&theta;) dan vektor presisi sub-domain.
          </p>
          <p>
            <strong>Kapan peringkat komunitas langsung diluncurkan?</strong> Pengiriman skor komunitas langsung dan kohort musiman terverifikasi sedang dalam pengembangan aktif dan akan diluncurkan pada rilis mendatang.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
