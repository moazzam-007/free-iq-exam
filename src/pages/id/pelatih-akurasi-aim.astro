---
import LayoutId from '../../components/id/LayoutId.astro';
import HeaderId from '../../components/id/HeaderId.astro';
import FooterId from '../../components/id/FooterId.astro';

const title = "Aim Trainer Online: Latihan Akurasi Mouse & Refleks FPS | FreeIQExam";
const description = "Tingkatkan presisi bidikan mouse, waktu reaksi, dan memori otot target bergerak untuk permainan FPS langsung di browser tanpa unduhan.";
const canonicalUrl = "https://freeiqexam.com/id/pelatih-akurasi-aim";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pelatih Akurasi Aim FPS FreeIQExam",
    "url": "https://freeiqexam.com/id/pelatih-akurasi-aim",
    "applicationCategory": "GameApplication",
    "operatingSystem": "All",
    "browserRequirements": "Membutuhkan dukungan JavaScript dan HTML5 Canvas",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Tiga Disiplin Latihan: Gridshot (Flicking), Tracking Halus, dan Mikro-Target Presisi",
      "Rendering HTML5 Canvas 60FPS+ berperforma tinggi dengan hitbox sub-piksel dan fisika partikel",
      "Kombinasi nada hit Web Audio API dengan skala pitch dan umpan balik akustik miss",
      "Metrik Kinematik real-time: Skor Keseluruhan, TPS (Target/Detik), Akurasi Mentah %, dan Jeda Reaksi (ms)",
      "Konverter sensitivitas eDPI dalam game untuk Valorant, CS2 / Counter-Strike, Overwatch 2, Apex Legends, dan R6 Siege",
      "Gaya crosshair kustom (Crosshair, Titik, Lingkaran-Titik) dan warna neon visibilitas tinggi",
      "Sertifikat scorecard esports resolusi tinggi yang dapat diunduh (1200x675 PNG)",
      "Nol unduhan, nol pendaftaran, eksekusi berbasis browser 100% privat"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.97",
      "ratingCount": "48900",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Pelatih Akurasi Aim",
        "item": "https://freeiqexam.com/id/pelatih-akurasi-aim"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apa itu pelatih aim FPS dan bagaimana cara meningkatkan akurasi mouse?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pelatih aim FPS adalah lingkungan perangkat lunak khusus untuk mengisolasi dan melatih mekanik motorik inti membidik: akuisisi target (flicking), tracking target dinamis, dan presisi mikro-koreksi. Dengan menghilangkan distraksi dalam game (pola recoil, abilities, fisika gerakan), pelatih aim memungkinkan ratusan repetisi kepadatan tinggi per menit, mempercepat pembelajaran motorik serebelar dan mielinasi jalur saraf."
        }
      },
      {
        "@type": "Question",
        "name": "Apa itu eDPI dan bagaimana cara menghitungnya lintas game?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "eDPI (effective Dots Per Inch) merepresentasikan sensitivitas mouse sejati dengan mengalikan DPI perangkat keras mouse dengan nilai sensitivitas dalam game (eDPI = DPI x Sens Dalam Game). Karena mesin game berbeda memakai konstanta yaw berbeda (mis. mesin CS2/Source memakai yaw 0,022 sementara Valorant memakai yaw 0,07), sensitivitas 1,0 di Valorant setara 3,1818 di CS2. Gunakan konverter sensitivitas bawaan untuk menjaga jarak rotasi 360 derajat identik di semua game."
        }
      },
      {
        "@type": "Question",
        "name": "Haruskah membidik dengan lengan, pergelangan, atau ujung jari?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Atlet esports top memakai teknik aim hibrida: 1) Aim lengan (poros siku) menangani rotasi sapuan besar (belokan 90 derajat hingga 180 derajat) pada sensitivitas rendah, 2) Aim pergelangan (poros karpal) mengeksekusi flick sedang dan tracking pada layar monitor, dan 3) Mikro-adjumen ujung jari menyempurnakan keselarasan headshot 5-15 piksel terakhir dan kontrol recoil vertikal. Hanya mengandalkan pergelangan pada sensitivitas tinggi meningkatkan risiko sindrom carpal tunnel dan menurunkan presisi jarak jauh."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah laju penyegaran monitor lebih tinggi (144Hz, 240Hz, 360Hz) meningkatkan aim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Monitor 240Hz menyegarkan bingkai layar tiap 4,16ms dibanding 16,67ms pada layar 60Hz standar. Pengurangan 12,5ms pada latensi gerak-ke-foton ini merender lintasan target dengan motion blur dan ghosting temporal jauh lebih kecil, memungkinkan sistem sakadik okular menghitung koordinat intersepsi target dengan fidelitas statistik lebih tinggi."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa skor bagus pada Gridshot (Flicking)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pada tolok ukur Gridshot 30 detik standar: Skor di bawah 40.000 (kurang dari 2,0 target/detik) setara tier Novice/Bronze; 50.000 hingga 70.000 (2,5-3,2 target/detik dengan akurasi 85%+) merepresentasikan peringkat kompetitif rata-rata hingga menengah (Gold/Platinum); 80.000 hingga 95.000 merepresentasikan tier elit Master/Grandmaster; dan skor melebihi 100.000 (4,5+ target/detik dengan akurasi 95%+) mencerminkan kecepatan flick level esports profesional."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana laju polling mouse (1000Hz vs 4000Hz vs 8000Hz) memengaruhi akurasi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Polling 1000Hz standar melaporkan koordinat mouse tiap 1,0ms. Sensor polling tinggi pada 4000Hz (0,25ms) dan 8000Hz (0,125ms) mengurangi latensi input sensor-ke-CPU dan micro-stutter, menghasilkan kurva mikro-tracking lebih halus pada monitor refresh tinggi (240Hz+). Namun, 8000Hz membutuhkan performa thread CPU substansial untuk mencegah frame drop pada game 3D berat."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa akurasi lebih penting daripada kecepatan flick mentah saat latihan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Riset pembelajaran motorik menunjukkan gerakan cepat tak akurat memperkuat jalur saraf yang salah dan memicu kebiasaan overshoot. Dengan sengaja berlatih pada ritme di mana Anda menjaga akurasi 90% hingga 95%, korteks motorik membangun lintasan kinematik presisi. Kecepatan muncul alami sebagai hasil samping efisiensi gerakan dan latensi koreksi yang berkurang."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah berat mouse dan friksi mousepad memengaruhi aim presisi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mouse ultraringan (sub-60 gram) meminimalkan inersia kinetik, memungkinkan akselerasi awal lebih cepat dan daya henti seketika tanpa ketegangan otot. Mousepad friksi statis rendah (permukaan hibrida atau kaca) memfasilitasi mikro-adjumen tanpa usaha untuk presisi level piksel, sementara pad kain kontrol menawarkan friksi dinamis lebih tinggi untuk tracking stabil."
        }
      }
    ]
  }
];
---

<LayoutId
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  enPath="/aim-trainer"
>
  <HeaderId currentPath="/id/pelatih-akurasi-aim" enPath="/aim-trainer" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span>Pelatih Aim FPS & Tolok Ukur Akurasi Mouse</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Pelatih Aim FPS Online Gratis
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        Asah presisi flicking, tracking dinamis, dan refleks mikro-target dengan mesin kanvas 60FPS terakselerasi perangkat keras kami. Kalibrasi crosshair, konversi sensitivitas eDPI lintas game, dan tolok ukur kinematika reaksi Anda.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- Control Bar / Settings -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-4 sm:p-6 mb-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          
          <!-- Mode Selector -->
          <div class="flex items-center gap-1.5 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs font-medium">
            <button
              type="button"
              class="aim-mode-btn active px-3.5 py-2 rounded-xl transition-all duration-150 bg-rose-500/10 text-rose-500 border border-rose-500/40 font-semibold cursor-pointer inline-flex items-center gap-1.5"
              data-mode="gridshot"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
              <span>Gridshot (Flick)</span>
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer inline-flex items-center gap-1.5"
              data-mode="tracking"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /></svg>
              <span>Tracking Halus</span>
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer inline-flex items-center gap-1.5"
              data-mode="precision"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
              <span>Mikro Presisi</span>
            </button>
          </div>

          <!-- Duration & Crosshair Settings -->
          <div class="flex flex-wrap items-center gap-3">
            
            <!-- Duration -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                class="aim-time-btn active px-3 py-1.5 rounded-xl transition-all duration-150 text-rose-500 font-bold cursor-pointer"
                data-time="30"
              >
                30s
              </button>
              <button
                type="button"
                class="aim-time-btn px-3 py-1.5 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-time="60"
              >
                60s
              </button>
            </div>

            <!-- Crosshair Style -->
            <div class="flex items-center gap-2 text-xs">
              <label for="crosshairStyleSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Bidikan:</label>
              <select
                id="crosshairStyleSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-xs rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-rose-500 cursor-pointer"
              >
                <option value="crosshair">Crosshair</option>
                <option value="dot">Titik</option>
                <option value="circle">Lingkaran + Titik</option>
              </select>
            </div>

            <!-- Crosshair Color -->
            <div class="flex items-center gap-2 text-xs">
              <label for="crosshairColorSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Warna:</label>
              <select
                id="crosshairColorSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-xs rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-rose-500 cursor-pointer"
              >
                <option value="#22c55e">Hijau Neon</option>
                <option value="#06b6d4">Sian</option>
                <option value="#f43f5e" selected>Merah Mawar</option>
                <option value="#ffffff">Putih Murni</option>
                <option value="#eab308">Emas Amber</option>
              </select>
            </div>

          </div>
        </div>
      </div>

      <!-- Interactive Game Arena Container -->
      <div id="arenaContainer" class="relative bg-zinc-950 rounded-3xl p-3 sm:p-4 border border-zinc-800 shadow-2xl overflow-hidden select-none">
        
        <!-- Live HUD Bar -->
        <div class="flex items-center justify-between px-3 py-2 mb-3 bg-zinc-900/90 backdrop-blur-md rounded-2xl border border-zinc-800/80 text-zinc-100 text-xs sm:text-sm font-mono">
          <div class="flex items-center gap-4 sm:gap-8">
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Sisa Waktu</span>
              <span id="hudAimTimer" class="font-bold text-base sm:text-lg text-rose-400">30s</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Skor</span>
              <span id="hudAimScore" class="font-bold text-base sm:text-lg text-white">0</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Target Kena</span>
              <span id="hudAimHits" class="font-bold text-base sm:text-lg text-emerald-400">0</span>
            </div>
          </div>

          <div class="flex items-center gap-4 sm:gap-6 text-right">
            <div>
              <span class="text-zinc-500 text-[11px] uppercase tracking-wider block font-sans">Akurasi</span>
              <span id="hudAimAcc" class="font-bold text-base sm:text-lg text-cyan-400">100%</span>
            </div>
            <div class="hidden sm:block text-zinc-500 text-xs font-sans">
              <span class="kbd px-1.5 py-0.5 rounded bg-zinc-800 text-[11px] text-zinc-400 border border-zinc-700">ESC</span> Ulangi
            </div>
          </div>
        </div>

        <!-- Canvas Game Surface -->
        <div class="relative w-full h-[420px] sm:h-[540px] rounded-2xl overflow-hidden bg-[#0a0a0f] border border-zinc-800/60 flex items-center justify-center">
          <canvas id="aimCanvas" class="w-full h-full cursor-none touch-none block"></canvas>

          <!-- Start Game Overlay -->
          <div
            id="startOverlay"
            class="absolute inset-0 bg-zinc-950/85 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-all duration-200 z-10"
          >
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-rose-500/10 border-2 border-rose-500/40 flex items-center justify-center mb-5 text-rose-500 animate-pulse">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="3"></circle>
                <path stroke-linecap="round" d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
              </svg>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-2 tracking-tight">
              Klik di Mana Saja untuk Mulai Latihan
            </h2>
            <p class="text-sm text-zinc-400 max-w-md mb-6">
              Rilekskan pergelangan dan fokus pada irama stabil. Eliminasi target secepat dan seakurat mungkin.
            </p>

            <div class="inline-flex items-center gap-2 px-6 py-3 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold text-sm shadow-sm transition-all duration-200 active:scale-[0.97] cursor-pointer">
              <span>Mulai Sesi Aim</span>
              <span>→</span>
            </div>

            <div class="mt-8 flex items-center gap-4 text-xs text-zinc-500">
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>Fisika 60FPS</span>
              <span>•</span>
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>Umpan Balik Audio Web</span>
              <span>•</span>
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>Crosshair Kustom</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Results Scorecard Container (Hidden by default) -->
      <div id="resultsWrap" class="hidden mt-8 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-xl transition-all duration-300">
        
        <!-- Score Header & Tier Badge -->
        <div class="text-center pb-8 border-b border-zinc-200 dark:border-zinc-800/80">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/30 text-xs font-semibold uppercase tracking-wider mb-3">
            <span>Sesi Selesai</span>
          </div>

          <div class="text-5xl sm:text-7xl font-black text-zinc-950 dark:text-white font-mono tracking-tight mb-2">
            <span id="resAimScore">0</span>
            <span class="text-base sm:text-xl font-sans font-normal text-zinc-500">poin</span>
          </div>

          <div class="flex items-center justify-center gap-3 mb-3">
            <span id="resAimTier" class="px-3.5 py-1 rounded-xl bg-zinc-900 text-rose-400 border border-rose-500/30 text-sm font-bold tracking-wide">
              Tier Diamond
            </span>
            <span id="resAimPercentile" class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
              Top 12% Global
            </span>
          </div>

          <p id="resAimDesc" class="text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
            Kecepatan akuisisi target tinggi dengan stabilitas flick solid dan overshoot minimal.
          </p>
        </div>

        <!-- Kinematic Performance Metric Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 py-8 border-b border-zinc-200 dark:border-zinc-800/80">
          
          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Akurasi</span>
            <span id="resAimAcc" class="text-2xl sm:text-3xl font-black font-mono text-cyan-500">0%</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Kena vs Meleset</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Target / Detik</span>
            <span id="resAimTps" class="text-2xl sm:text-3xl font-black font-mono text-emerald-500">0.00</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Laju Throughput</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Jeda Reaksi</span>
            <span id="resAimReaction" class="text-2xl sm:text-3xl font-black font-mono text-rose-500">0ms</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Rerata Waktu Kena</span>
          </div>

          <div class="bg-white dark:bg-zinc-900/60 p-4 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 text-center">
            <span class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Total Kena</span>
            <span id="resAimHits" class="text-2xl sm:text-3xl font-black font-mono text-indigo-500">0</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Target Terkonfirmasi</span>
          </div>

