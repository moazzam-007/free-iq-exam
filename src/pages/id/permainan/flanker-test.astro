---
import LayoutId from '../../../components/id/LayoutId.astro';
import HeaderId from '../../../components/id/HeaderId.astro';
import FooterId from '../../../components/id/FooterId.astro';

const title = "Tes Flanker Online Gratis - Perhatian Selektif & Inhibisi Respon | FreeIQExam";
const description = "Ikuti tes Eriksen Flanker online gratis. Ukur kecepatan pemrosesan visual, perhatian selektif, dan kontrol inhibisi konflik berdasarkan Eriksen & Eriksen (1974).";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Tes Flanker Eriksen Respons Cepat",
    "url": "https://freeiqexam.com/id/permainan/tes-flanker",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Tugas Eriksen Flanker terstandarisasi untuk mengukur perhatian selektif visual, kecepatan pemrosesan, dan inhibisi interferensi distraktor tepi."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan Kognitif",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Tes Flanker",
        "item": "https://freeiqexam.com/id/permainan/tes-flanker"
      }
    ]
  }
];
---

<LayoutId title={title} description={description} schema={schema} enPath="/games/flanker-test" canonicalUrl="https://freeiqexam.com/id/permainan/tes-flanker" robots="noindex, follow">
  <HeaderId enPath="/games/flanker-test" />

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <a href="/id/permainan" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Permainan Kognitif</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Flanker Respons Cepat</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-sky mb-1.5">
          Gs &bull; Kecepatan Pemrosesan
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
            Tes Flanker Respons Cepat
          </h1>
          <button
            id="btn-how-to-play"
            type="button"
            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center p-2 rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 text-xs font-mono font-medium gap-1.5 cursor-pointer"
            aria-label="Petunjuk cara bermain"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
            <span>Cara Bermain</span>
          </button>
        </div>
      </div>

      <!-- Stat HUD (4 rounded cards) -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Percobaan</div>
          <div id="hud-trial" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 30</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Skor</div>
          <div id="hud-score" class="font-bold text-amber-600 dark:text-amber-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Median RT</div>
          <div id="hud-rt" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">-- ms</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Terbaik</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center min-h-[440px] justify-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-sky flex items-center justify-center mb-5 shadow-lg shadow-amber-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Tes Flanker Respons Cepat
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Barisan 5 simbol akan muncul. Tentukan arah <strong>PANAH TENGAH</strong> secepat mungkin.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            Abaikan panah pengalih di sampingnya yang menunjuk ke arah berlawanan. Terdiri dari 30 percobaan cepat.
          </p>
        </div>

        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-amber-600 hover:bg-amber-500 text-white font-heading font-bold text-base shadow-md transition-all duration-150 hover:scale-105 active:scale-[0.97] flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 cursor-pointer"
        >
          <span>Mulai Sesi (Spasi)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content -->
      <div id="game-arena-content" inert class="w-full flex flex-col items-center">
        <!-- Progress bar -->
        <div class="w-full max-w-md h-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full mb-6 overflow-hidden">
          <div id="trial-progress" class="h-full bg-amber-500 transition-all duration-150 w-0"></div>
        </div>

        <!-- Stimulus Display Box -->
        <div class="w-full max-w-md h-40 sm:h-48 rounded-3xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80 flex flex-col items-center justify-center p-6 mb-8 shadow-inner relative">
          <!-- Stimulus Row -->
          <div id="stimulus-row" class="flex items-center justify-center gap-2 sm:gap-4 select-none">
            <span class="text-4xl sm:text-5xl font-mono text-zinc-400 dark:text-zinc-500">+</span>
          </div>
          <div id="feedback-cue" class="absolute bottom-3 text-xs font-mono font-medium text-zinc-400">
            Fokus pada panah tengah
          </div>
        </div>

        <!-- Response Action Controls -->
        <div class="w-full max-w-md grid grid-cols-2 gap-4">
          <button
            id="btn-action-left"
            type="button"
            class="min-h-[56px] py-4 px-6 rounded-2xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-950 dark:text-white font-heading font-bold text-lg flex items-center justify-center gap-3 transition-all duration-150 active:scale-[0.97] shadow-sm border border-zinc-200 dark:border-zinc-700 cursor-pointer"
          >
            <span class="text-2xl font-mono font-black">&larr;</span>
            <div class="text-left leading-tight">
              <div>KIRI</div>
              <div class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 font-normal">Tombol: &larr; atau A</div>
            </div>
          </button>

          <button
            id="btn-action-right"
            type="button"
            class="min-h-[56px] py-4 px-6 rounded-2xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-950 dark:text-white font-heading font-bold text-lg flex items-center justify-center gap-3 transition-all duration-150 active:scale-[0.97] shadow-sm border border-zinc-200 dark:border-zinc-700 cursor-pointer"
          >
            <div class="text-right leading-tight">
              <div>KANAN</div>
              <div class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 font-normal">Tombol: &rarr; atau D</div>
            </div>
            <span class="text-2xl font-mono font-black">&rarr;</span>
          </button>
        </div>

        <p class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500 mt-4 text-center">
          Respons secepat dan seakurat mungkin. Abaikan simbol-simbol pengalih di sampingnya.
        </p>
      </div>
    </div>

    <!-- Accessible "How to Play" Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
        <button
          id="btn-close-how-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
          aria-label="Tutup petunjuk"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
          </div>
          <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
            Cara Bermain: Tes Flanker Respons Cepat
          </h2>
        </div>

        <div class="space-y-3 text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
          <p>
            <strong>1. Identifikasi Target:</strong> Pada setiap percobaan, barisan 5 simbol muncul di layar. Fokuskan perhatian secara eksklusif pada panah di posisi <strong>TENGAH</strong>.
          </p>
          <p>
            <strong>2. Kondisi Percobaan:</strong>
            <br />- <em>Kongruen (Congruent):</em> Seluruh panah menunjuk ke arah yang sama (<code class="font-mono">&larr; &larr; &larr; &larr; &larr;</code> atau <code class="font-mono">&rarr; &rarr; &rarr; &rarr; &rarr;</code>).
            <br />- <em>Inkongruen (Incongruent):</em> Panah pengalih menunjuk ke arah berlawanan (<code class="font-mono">&rarr; &rarr; &larr; &rarr; &rarr;</code> atau <code class="font-mono">&larr; &larr; &rarr; &larr; &larr;</code>).
            <br />- <em>Netral (Neutral):</em> Simbol pengalih berupa garis strip (<code class="font-mono">- - &larr; - -</code> atau <code class="font-mono">- - &rarr; - -</code>).
          </p>
          <p>
            <strong>3. Kontrol:</strong> Tekan <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">Panah Kiri</kbd> atau <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">A</kbd> untuk Kiri, dan <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">Panah Kanan</kbd> atau <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">D</kbd> untuk Kanan.
          </p>
          <p>
            <strong>4. Penilaian:</strong> Akurasi tinggi, waktu reaksi di bawah 400 ms, dan minimnya perlambatan akibat konflik menghasilkan skor performa tertinggi.
          </p>
        </div>

        <button
          id="btn-confirm-how"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm shadow-sm transition-all duration-150 cursor-pointer"
        >
          Paham, Mulai Bermain
        </button>
      </div>
    </div>

    <!-- Accessible End of Round Modal -->
    <div
      id="modal-end-round"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-end-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl text-center max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-end-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
          aria-label="Tutup ringkasan sesi"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h2 id="modal-end-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Sesi Selesai!
        </h2>
        <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-5">
          Ringkasan Perhatian Selektif &amp; Kecepatan Pemrosesan
        </p>

        <!-- Performance Score (0 - 100) -->
        <div class="mb-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
          <div class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
            Skor Kinerja Tugas
          </div>
          <div id="modal-score" class="text-4xl sm:text-5xl font-extrabold text-amber-600 dark:text-amber-400 font-heading">
            0
          </div>
          <div class="mt-2.5 flex items-center justify-center gap-2">
            <span id="modal-tier-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700">
              Berkembang
            </span>
          </div>
          <p id="modal-tier-desc" class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 max-w-sm mx-auto">
            Performa mencerminkan penyelesaian konflik visual dan kecepatan pemrosesan respon.
          </p>
        </div>

        <!-- Paradigm Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Akurasi</div>
            <div id="modal-acc" class="font-bold text-base text-zinc-900 dark:text-white">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Median RT</div>
            <div id="modal-rt" class="font-bold text-base text-amber-600 dark:text-amber-400">0 ms</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Biaya Konflik</div>
            <div id="modal-conflict" class="font-bold text-base text-zinc-900 dark:text-white">0 ms</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Runtutan Terbaik</div>
            <div id="modal-streak" class="font-bold text-base text-zinc-900 dark:text-white">0</div>
          </div>
        </div>

        <!-- RT Breakdown -->
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-5 flex items-center justify-between text-xs font-mono px-4">
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 text-[10px] block">RT KONGRUEN</span>
            <span id="modal-congruent-rt" class="font-bold text-zinc-900 dark:text-white">0 ms</span>
          </div>
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 text-[10px] block">RT INKONGRUEN</span>
            <span id="modal-incongruent-rt" class="font-bold text-zinc-900 dark:text-white">0 ms</span>
          </div>
        </div>

        <!-- Personal Best Alert -->
        <div id="modal-best-alert" class="hidden mb-5 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-semibold">
          Rekor Pribadi Baru Tercapai!
        </div>

        <!-- Scientific Attribution Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-heading">Fondasi Ilmiah:</span>
          Berdasarkan Tugas Flanker Eriksen (Eriksen &amp; Eriksen, 1974). Mengukur perhatian selektif visuospasial, penyelesaian konflik eksekutif, dan penekanan distraksi perifer.
        </div>

        <!-- Scoring Formula Breakdown Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed font-mono">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-sans">Formula Penilaian:</span>
          Skor = (Akurasi * 50) + Komponen Kecepatan (hingga 40 poin untuk RT &lt; 400 ms) + Bonus Ketahanan Flanker (hingga 10 poin untuk latensi konflik rendah)
        </div>

        <!-- Practice Effects Disclaimer -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-5 text-[11px] text-zinc-500 dark:text-zinc-400 italic leading-relaxed">
          Skor kinerja mencerminkan kefasihan operasional tugas dan kecepatan respons di bawah efek latihan, bukan kecerdasan umum bawaan (g). Latihan berulang mengasah ketangkasan kognitif.
        </div>

        <div class="flex items-center gap-3">
          <button
            id="btn-modal-restart"
            type="button"
            class="flex-1 min-h-[44px] py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm shadow-sm transition-all duration-150 hover:scale-[1.01] active:scale-[0.98] cursor-pointer"
          >
            Main Lagi
          </button>
          <a
            href="/id/permainan"
            class="px-5 min-h-[44px] flex items-center justify-center rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-colors"
          >
            Pusat Permainan
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Guide & Cognitive Science Section -->
    <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-sky mb-2">
          Kemampuan Luas CHC: Kecepatan Pemrosesan (Gs) &amp; Kontrol Perhatian (Gf)
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          Tugas Eriksen Flanker: Perhatian Selektif &amp; Kompetisi Respon
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Tugas Eriksen Flanker menilai kapasitas sistem visual manusia dalam meredam distraksi visual di sekitar fokus perhatian langsung. Ketika simbol pengalih di samping target mengindikasikan aksi motorik yang berlawanan dari target tengah, terjadi kompetisi respon kognitif yang memperlambat eksekusi dan meningkatkan potensi kesalahan.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            1. Cara Bermain &amp; Kontrol
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Barisan 5 panah akan muncul (contoh: &lt;&lt;&gt;&lt;&lt;). Fokuskan mata hanya pada <strong>panah tengah</strong> dan abaikan panah pengalih. Tekan <strong>[&larr;] / [A]</strong> untuk Kiri atau <strong>[&rarr;] / [D]</strong> untuk Kanan.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            2. Kongruensi &amp; Efek Flanker
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Percobaan dibagi antara kongruen (semua panah searah) dan inkongruen (panah samping berlawanan). Biaya interferensi Anda diukur dari selisih waktu reaksi pada percobaan inkongruen dibandingkan kongruen.
