  </main>

  <FooterId />
</LayoutId>

<script>
  import { saveGameRecord, getPerformanceTier } from '../../../utils/profileStore';

  const STORAGE_KEY = 'fiq_game_flankertest_best';
  const TOTAL_TRIALS = 30;

  type FlankerCondition = 'congruent' | 'incongruent' | 'neutral';
  type TargetDirection = 'left' | 'right';

  interface TrialSpec {
    condition: FlankerCondition;
    target: TargetDirection;
    symbols: string[];
  }

  function generateTrialList(): TrialSpec[] {
    const list: TrialSpec[] = [];

    // 12 congruent
    for (let i = 0; i < 12; i++) {
      const target: TargetDirection = i % 2 === 0 ? 'left' : 'right';
      const arrow = target === 'left' ? '←' : '→';
      list.push({
        condition: 'congruent',
        target,
        symbols: [arrow, arrow, arrow, arrow, arrow],
      });
    }

    // 12 incongruent
    for (let i = 0; i < 12; i++) {
      const target: TargetDirection = i % 2 === 0 ? 'left' : 'right';
      const targetArrow = target === 'left' ? '←' : '→';
      const flankerArrow = target === 'left' ? '→' : '←';
      list.push({
        condition: 'incongruent',
        target,
        symbols: [flankerArrow, flankerArrow, targetArrow, flankerArrow, flankerArrow],
      });
    }

    // 6 neutral
    for (let i = 0; i < 6; i++) {
      const target: TargetDirection = i % 2 === 0 ? 'left' : 'right';
      const targetArrow = target === 'left' ? '←' : '→';
      list.push({
        condition: 'neutral',
        target,
        symbols: ['-', '-', targetArrow, '-', '-'],
      });
    }

    for (let i = list.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [list[i], list[j]] = [list[j], list[i]];
    }

    return list;
  }

  let trials: TrialSpec[] = [];
  let currentTrialIndex = 0;
  let trialStartTime = 0;
  let sessionStartTime = 0;
  let isAwaitingResponse = false;
  let isGameActive = false;

  let correctCount = 0;
  let errorCount = 0;
  let currentStreak = 0;
  let longestStreak = 0;

  const latencies: number[] = [];
  const congruentRTs: number[] = [];
  const incongruentRTs: number[] = [];

  let audioCtx: AudioContext | null = null;
  function playTone(freq: number, duration: number) {
    try {
      if (!audioCtx) {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) audioCtx = new AudioCtx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      if (audioCtx) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      }
    } catch {}
  }

  function calculateMedian(arr: number[]): number {
    if (arr.length === 0) return 0;
    const sorted = [...arr].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    return sorted.length % 2 !== 0
      ? sorted[mid]
      : Math.round((sorted[mid - 1] + sorted[mid]) / 2);
  }

  const hudTrial = document.getElementById('hud-trial') as HTMLElement;
  const hudScore = document.getElementById('hud-score') as HTMLElement;
  const hudRT = document.getElementById('hud-rt') as HTMLElement;
  const hudBest = document.getElementById('hud-best') as HTMLElement;

  const startOverlay = document.getElementById('start-overlay') as HTMLElement;
  const btnStartGame = document.getElementById('btn-start-game') as HTMLButtonElement;
  const gameArenaContent = document.getElementById('game-arena-content') as HTMLElement;

  const trialProgress = document.getElementById('trial-progress') as HTMLElement;
  const stimulusRow = document.getElementById('stimulus-row') as HTMLElement;
  const feedbackCue = document.getElementById('feedback-cue') as HTMLElement;

  const btnActionLeft = document.getElementById('btn-action-left') as HTMLButtonElement;
  const btnActionRight = document.getElementById('btn-action-right') as HTMLButtonElement;

  const btnHowToPlay = document.getElementById('btn-how-to-play') as HTMLButtonElement;
  const modalHowToPlay = document.getElementById('modal-how-to-play') as HTMLElement;
  const btnCloseHowModal = document.getElementById('btn-close-how-modal') as HTMLButtonElement;
  const btnConfirmHow = document.getElementById('btn-confirm-how') as HTMLButtonElement;

  const modalEndRound = document.getElementById('modal-end-round') as HTMLElement;
  const btnCloseEndModal = document.getElementById('btn-close-end-modal') as HTMLButtonElement;
  const modalScore = document.getElementById('modal-score') as HTMLElement;
  const modalTierBadge = document.getElementById('modal-tier-badge') as HTMLElement;
  const modalTierDesc = document.getElementById('modal-tier-desc') as HTMLElement;
  const modalAcc = document.getElementById('modal-acc') as HTMLElement;
  const modalRT = document.getElementById('modal-rt') as HTMLElement;
  const modalConflict = document.getElementById('modal-conflict') as HTMLElement;
  const modalStreak = document.getElementById('modal-streak') as HTMLElement;
  const modalCongruentRT = document.getElementById('modal-congruent-rt') as HTMLElement;
  const modalIncongruentRT = document.getElementById('modal-incongruent-rt') as HTMLElement;
  const modalBestAlert = document.getElementById('modal-best-alert') as HTMLElement;
  const btnModalRestart = document.getElementById('btn-modal-restart') as HTMLButtonElement;

  function loadBestScore() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && hudBest) {
        hudBest.textContent = saved;
      }
    } catch {}
  }
  loadBestScore();

  function updateHUD() {
    hudTrial.textContent = `${currentTrialIndex} / ${TOTAL_TRIALS}`;
    trialProgress.style.width = `${Math.round((currentTrialIndex / TOTAL_TRIALS) * 100)}%`;

    const medianRT = calculateMedian(latencies);
    hudRT.textContent = medianRT > 0 ? `${medianRT} ms` : '-- ms';

    const accuracyScore = Math.round((correctCount / TOTAL_TRIALS) * 50);
    const speedScore = medianRT > 0 ? Math.max(0, Math.min(40, Math.round((900 - medianRT) / 12.5))) : 0;
    hudScore.textContent = String(accuracyScore + speedScore);
  }

  async function presentNextTrial() {
    if (currentTrialIndex >= TOTAL_TRIALS) {
      endGame();
      return;
    }

    isAwaitingResponse = false;
    updateHUD();

    stimulusRow.innerHTML = '<span class="text-4xl sm:text-5xl font-mono text-zinc-400 dark:text-zinc-500 font-bold animate-pulse">+</span>';
    feedbackCue.textContent = 'Fokus pada panah tengah';

    const jitter = 350 + Math.floor(Math.random() * 150);
    await new Promise((resolve) => setTimeout(resolve, jitter));
    if (!isGameActive) return;

    const trial = trials[currentTrialIndex];

    stimulusRow.innerHTML = '';
    trial.symbols.forEach((sym, idx) => {
      const span = document.createElement('span');
      if (idx === 2) {
        span.className = 'text-5xl sm:text-6xl font-mono font-black text-zinc-950 dark:text-white px-2 py-1 rounded-xl bg-amber-100/70 dark:bg-amber-950/60 border-2 border-amber-500 shadow-sm transition-transform scale-110';
      } else {
        span.className = 'text-4xl sm:text-5xl font-mono font-bold text-zinc-500 dark:text-zinc-400 px-1';
      }
      span.textContent = sym;
      stimulusRow.appendChild(span);
    });

    feedbackCue.textContent = 'Tentukan arah panah tengah';
    trialStartTime = performance.now();
    isAwaitingResponse = true;
  }

  function handleResponse(choice: TargetDirection) {
    if (!isAwaitingResponse || !isGameActive) return;
    isAwaitingResponse = false;

    const latency = Math.round(performance.now() - trialStartTime);
    const trial = trials[currentTrialIndex];
    const isCorrect = choice === trial.target;

    latencies.push(latency);
    if (isCorrect) {
      correctCount++;
      currentStreak++;
      longestStreak = Math.max(longestStreak, currentStreak);
      playTone(660, 0.08);

      if (trial.condition === 'congruent') {
        congruentRTs.push(latency);
      } else if (trial.condition === 'incongruent') {
        incongruentRTs.push(latency);
      }
    } else {
      errorCount++;
      currentStreak = 0;
      playTone(260, 0.12);
    }

    currentTrialIndex++;
    presentNextTrial();
  }

  function endGame() {
    isGameActive = false;
    const sessionDurationSec = Math.max(1, Math.round((Date.now() - sessionStartTime) / 1000));

    const medianRT = calculateMedian(latencies);
    const congruentMedianRT = calculateMedian(congruentRTs);
    const incongruentMedianRT = calculateMedian(incongruentRTs);

    const interferenceCostMs = incongruentMedianRT > 0 && congruentMedianRT > 0
      ? Math.max(0, Math.round(incongruentMedianRT - congruentMedianRT))
      : 0;

    const accuracyScore = Math.round((correctCount / TOTAL_TRIALS) * 50);
    const speedScore = Math.max(0, Math.min(40, Math.round((900 - medianRT) / 12.5)));
    const conflictBonus = Math.max(0, Math.min(10, Math.round((150 - interferenceCostMs) / 15)));
    const performanceScore = Math.min(100, Math.max(0, accuracyScore + speedScore + conflictBonus));

    saveGameRecord({
      gameId: 'flanker-test',
      durationSeconds: sessionDurationSec,
      mode: 'standard',
      metrics: {
        performanceScore,
        accuracy: Number((correctCount / TOTAL_TRIALS).toFixed(2)),
        trialsCompleted: TOTAL_TRIALS,
        correctCount,
        errorCount,
        medianRT: Math.round(medianRT),
        interferenceCostMs: Math.round(interferenceCostMs),
        bestStreak: longestStreak,
      },
    });

    let isNewBest = false;
    try {
      const saved = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
      if (performanceScore > saved) {
        localStorage.setItem(STORAGE_KEY, String(performanceScore));
        isNewBest = true;
      }
    } catch {}
    loadBestScore();

    modalScore.textContent = String(performanceScore);
    const tierInfo = getPerformanceTier(performanceScore);
    modalTierBadge.textContent = tierInfo.tier;
    modalTierBadge.className = `inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${tierInfo.badgeClass}`;
    modalTierDesc.textContent = tierInfo.description;

    modalAcc.textContent = `${Math.round((correctCount / TOTAL_TRIALS) * 100)}%`;
    modalRT.textContent = `${medianRT} ms`;
    modalConflict.textContent = `${interferenceCostMs} ms`;
    modalStreak.textContent = String(longestStreak);

    modalCongruentRT.textContent = congruentMedianRT > 0 ? `${congruentMedianRT} ms` : '-- ms';
    modalIncongruentRT.textContent = incongruentMedianRT > 0 ? `${incongruentMedianRT} ms` : '-- ms';

    if (isNewBest) {
      modalBestAlert.classList.remove('hidden');
    } else {
      modalBestAlert.classList.add('hidden');
    }

    modalEndRound.classList.remove('hidden');
  }

  function startGame() {
    isGameActive = true;
    sessionStartTime = Date.now();
    currentTrialIndex = 0;
    correctCount = 0;
    errorCount = 0;
    currentStreak = 0;
    longestStreak = 0;
    latencies.length = 0;
    congruentRTs.length = 0;
    incongruentRTs.length = 0;

    trials = generateTrialList();

    startOverlay.classList.add('hidden');
    gameArenaContent.removeAttribute('inert');
    modalEndRound.classList.add('hidden');

    presentNextTrial();
  }

  btnStartGame.addEventListener('click', startGame);

  btnActionLeft.addEventListener('click', () => handleResponse('left'));
  btnActionRight.addEventListener('click', () => handleResponse('right'));

  window.addEventListener('keydown', (e) => {
    if (e.key === ' ' && !isGameActive && modalHowToPlay.classList.contains('hidden') && modalEndRound.classList.contains('hidden')) {
      e.preventDefault();
      startGame();
      return;
    }

    if (isGameActive && isAwaitingResponse) {
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
        e.preventDefault();
        handleResponse('left');
      } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
        e.preventDefault();
        handleResponse('right');
      }
    }

    if (e.key === 'Escape') {
      if (!modalHowToPlay.classList.contains('hidden')) {
        modalHowToPlay.classList.add('hidden');
      }
      if (!modalEndRound.classList.contains('hidden')) {
        modalEndRound.classList.add('hidden');
      }
    }
  });

  btnHowToPlay.addEventListener('click', () => modalHowToPlay.classList.remove('hidden'));
  btnCloseHowModal.addEventListener('click', () => modalHowToPlay.classList.add('hidden'));
  btnConfirmHow.addEventListener('click', () => modalHowToPlay.classList.add('hidden'));

  btnCloseEndModal.addEventListener('click', () => modalEndRound.classList.add('hidden'));
  btnModalRestart.addEventListener('click', () => {
    modalEndRound.classList.add('hidden');
    startGame();
  });
</script>
