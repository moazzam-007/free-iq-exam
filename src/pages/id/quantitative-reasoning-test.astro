---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Kuantitatif Online Gratis: 16 Soal Deret Angka (Gq) | FreeIQExam";
const description = "Uji kemampuan penalaran kuantitatif (Gq) dan induksi matematika Anda. 16 soal deret bilangan bertingkat dan pola relasional aljabar terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Penalaran Kuantitatif (Gq)",
    "description": "Penilaian kuantitatif 16 soal yang mengukur induksi deret matematika, pengenalan pola relasional, dan kecepatan deduksi numerik.",
    "url": "https://freeiqexam.com/id/tes-kuantitatif/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Kuantitatif",
        "item": "https://freeiqexam.com/id/tes-kuantitatif/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/quantitative-reasoning-test" canonicalUrl="https://freeiqexam.com/id/tes-kuantitatif" robots="noindex, follow">
  <Header currentPath="/id/tes-kuantitatif" enPath="/quantitative-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Kuantitatif</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gq <span aria-hidden="true">&bull;</span> POLA MATEMATIKA INDUKTIF</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Penalaran Kuantitatif (Gq)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan Anda dalam menemukan pola relasional numerik tersembunyi, menyelesaikan deret bertingkat, dan memahami logika aljabar proporsional.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Deret &amp; Pola Numerik</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Struktur Relasional Induktif</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="quantitative"
      domainCode="Gq"
      domainTitle="Penalaran Kuantitatif"
      domainSubtitle="Induksi Deret Angka & Struktur Relasional"
      domainDescription="Penalaran Kuantitatif (Gq) mengukur kemampuan untuk bernalar secara induktif dan deduktif menggunakan konsep matematis serta mengenali relasi numerik bersarang."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-amber-600 to-orange-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Psikometrika Pengetahuan Kuantitatif (Gq)
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          Dalam model Cattell-Horn-Carroll, Gq merepresentasikan domain kognitif luas yang berbeda dari penalaran fluida (Gf) maupun inteligensi kristalisasi (Gc). Meski memakai simbol matematika, asesmen kuantitatif berkualitas tidak menguji kalkulus lanjut atau hafalan; melainkan mengukur kapasitas menyimpulkan fungsi matematika tersembunyi dan relasi rekursif.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Selisih Orde Tinggi
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Deret di mana selisih antar angka bersebelahan tidak konstan, tetapi selisih kedua (delta dari delta) membentuk progresi aritmetika atau geometris yang dikenali.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Deret Ganda Berselang
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Dua deret matematika berbeda bergantian pada posisi ganjil dan genap (mis. suku ganjil dikali 2, suku genap dikurangi 3).
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Logika Relasional Multi-Langkah
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Deduksi kata proporsional yang menuntut konversi laju, rasio relatif, dan kondisi variabel terbatas tanpa tebakan brutal.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Metode Taktis untuk Memecahkan Deret Angka
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Hitung Selisih Pertama dan Kedua:</strong> Hitung selisih eksak antar angka berurutan. Jika selisih pertama tak menunjukkan aturan jelas, periksa selisih dari selisih tersebut.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Periksa Pertumbuhan Eksponensial atau Pangkat:</strong> Jika angka naik cepat, uji bilangan kuadrat (n^2), kubik (n^3), atau pengali (x * 2 + 1, x * 3 - 2).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Uji Pola Bergantian Berselang:</strong> Jika angka naik-turun tak terduga, pisahkan deret menjadi dua alur (indeks 1, 3, 5 vs 2, 4, 6).</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Jelajahi Baterai Kognitif Khusus Lainnya
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/id/tes-penalaran-fluida"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Penalaran Fluida (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Induksi Matriks &rarr;</div>
          </a>
          <a
            href="/id/tes-spasial"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Visual-Spasial (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Rotasi Mental 3D &rarr;</div>
          </a>
          <a
            href="/id/tes-verbal"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Pemahaman Verbal (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Silogisme Deduktif &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
