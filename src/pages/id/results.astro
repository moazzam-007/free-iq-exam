---
import Layout from '../../components/id/LayoutId.astro';

const title = "Hasil Tes IQ: Skor, Persentil & Arti Nilai IQ | FreeIQExam";
const description = "Lihat hasil tes IQ berupa estimasi skor, persentil, kelangkaan populasi, dan uraian kemampuan kognitif. Pelajari arti nilai IQ normal, cara membaca skor, dan batas interpretasinya.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Berapa tingkat IQ yang dianggap normal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pada skala dengan rerata 100 dan SD 15, rentang 90-109 biasanya berada di area rata-rata statistik. Interpretasi tetap bergantung pada instrumen dan norma yang digunakan."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana membaca skor dan persentil hasil tes IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Skor IQ menunjukkan posisi pada skala standar, sedangkan persentil menunjukkan posisi relatif pada distribusi populasi. Gunakan keduanya bersama-sama untuk memahami hasil, bukan menganggap skor sebagai persentase nilai ujian."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/results">
  <!-- Print-Only Official Document Header -->
  <div class="hidden print:block mb-8 pb-4 border-b-2 border-zinc-900">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-2xl font-bold font-heading text-zinc-950 block">FreeIQExam.com</span>
        <p class="text-xs text-zinc-500 font-mono">Laporan Asesmen Kognitif Multi-Domain Terstandarisasi (SD 15, 4 Domain CHC)</p>
      </div>
      <div class="text-right text-xs font-mono text-zinc-500">
        <p id="print-date">Diterbitkan: 2026</p>
        <p>Model: Teori Respons Butir 2PL (IRT)</p>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header (Screen Only) -->
  <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200 print:hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
      <a href="/id" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
          </svg>
        </div>
        <span class="font-heading font-bold text-lg tracking-tight text-zinc-950 dark:text-white">
          FreeIQ<span class="text-blue-600 dark:text-blue-400">Exam</span>
        </span>
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/id/tes-singkat"
          id="btn-quick-test-top"
          class="hidden sm:inline-flex px-4 py-2 rounded-full text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          Tes Singkat (10 mnt)
        </a>
        <a
          href="/id/tes"
          id="btn-retake-top"
          class="px-3.5 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          <span class="hidden sm:inline">Ulangi Tes Lengkap</span>
          <span class="sm:hidden">Ulangi</span>
        </a>
        <button
          id="btn-print"
          type="button"
          class="px-3 sm:px-5 py-2 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Simpan PDF</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Demo Notice Banner -->
  <div id="demo-banner" class="hidden max-w-5xl mx-auto px-4 sm:px-6 pt-6 print:hidden">
    <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-amber-200 dark:bg-amber-900 flex items-center justify-center text-amber-800 dark:text-amber-200 shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <p class="text-xs sm:text-sm text-amber-900 dark:text-amber-200 font-medium">
          <strong>Laporan Demo:</strong> Menampilkan contoh laporan skor. Ikuti tes resmi untuk mendapatkan estimasi psikometri pribadi Anda.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/id/tes-singkat" class="px-4 py-2 rounded-full text-xs font-semibold text-white bg-zinc-700 hover:bg-zinc-600 whitespace-nowrap shadow-xs">Tes Singkat (10 mnt)</a>
        <a href="/id/tes" class="px-4 py-2 rounded-full text-xs font-semibold text-white bg-amber-600 hover:bg-amber-500 whitespace-nowrap shadow-xs">Tes Lengkap (20 mnt)</a>
      </div>
    </div>
  </div>

  <!-- Test Type Badge -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-4 print:hidden">
    <span id="test-type-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 uppercase tracking-wider"></span>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <h1 class="sr-only">Laporan Hasil Skor Asesmen Kognitif Terstandarisasi</h1>

    <!-- Hero Score Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs text-center relative overflow-hidden">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-gradient-to-tr from-blue-500/10 via-indigo-500/10 to-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-600 dark:text-zinc-300 mb-6 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>ESTIMASI SKOR IQ TERSTANDARISASI (SD 15, MODEL CHC)</span>
        </div>

        <div class="flex items-baseline justify-center gap-2 my-2">
          <span id="score-display" class="font-heading font-extrabold text-6xl sm:text-7xl lg:text-8xl tracking-tight text-zinc-950 dark:text-white leading-none min-h-[1em]" aria-busy="true">
            &mdash;
          </span>
          <span class="text-xl sm:text-2xl font-mono text-zinc-500 dark:text-zinc-400 font-semibold">IQ</span>
        </div>

        <div class="mt-3 mb-2">
          <span id="classification-badge" class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
            Menghitung...
          </span>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-md mx-auto mb-6 text-center leading-relaxed">
          Skala psikometri terstandarisasi dengan <strong>Rerata Populasi 100 IQ</strong> dan simpangan baku &sigma; = 15. Rentang skala klinis berkisar dari 40 hingga 160+; ini adalah distribusi kognitif relatif, bukan nilai persentase dari 100.
        </p>

        <div class="w-full max-w-lg p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 shadow-2xs">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
            <span class="font-mono font-medium">
              95% Interval Kredibel Posterior:
              <strong id="ci-display" class="text-zinc-950 dark:text-white font-bold ml-1">&mdash;</strong>
            </span>
            <span class="text-zinc-500 dark:text-zinc-400 font-mono text-xs">
              SEM: &plusmn;<span id="sem-display">&mdash;</span> poin
            </span>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 text-left mt-2 border-t border-zinc-100 dark:border-zinc-800/80 pt-2 leading-relaxed">
            Interval estimasi Bayesian EAP memperhitungkan varians pengukuran dan parameter diskriminasi butir soal.
          </p>
        </div>

        <!-- Percentile / Rarity / Theta Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full max-w-2xl mt-6">
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Peringkat Persentil</span>
            <span id="percentile-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span id="percentile-subtext" class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">Menghitung persentil...</span>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Kelangkaan Populasi</span>
            <span id="rarity-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">Frekuensi populasi umum</span>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Kemampuan Laten (&theta;)</span>
            <span id="theta-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">Metrik distribusi normal baku</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational Guide: IQ Scale vs. Percentile vs. Percentage -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs print:break-inside-avoid">
      <div class="flex items-center gap-2 mb-4">
        <span class="p-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-900/60">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <h2 class="font-heading text-base sm:text-lg font-bold text-zinc-950 dark:text-white">
          Memahami Skor Anda: Skala IQ vs. Persentil vs. Persentase
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-1">1. Skala IQ (Rerata = 100)</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Bukan Nilai dari 100</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Berbeda dari ujian sekolah, tes IQ <strong>tidak dinilai berdasarkan skala persentase 0-100</strong>. Angka <strong>100 merepresentasikan titik tengah (rata-rata) populasi global</strong>. Kurva lonceng klinis terbentang dari 40 hingga 160+. Skor antara <strong>90 dan 109</strong> mencerminkan kemampuan kognitif dewasa rata-rata normal.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Titik Acuan: 100 IQ = Persentil ke-50
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1">2. Peringkat Persentil (Titik Tengah = 50%)</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Peringkat Relatif Manusia</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Peringkat persentil menunjukkan persentase populasi manusia yang memperoleh skor lebih rendah dari Anda. <strong>Persentil 50% adalah median global</strong>. Dengan persentil Anda <strong id="guide-dynamic-pct">50.0%</strong>, performa kognitif Anda melampaui sekitar <strong id="guide-dynamic-count">50</strong> dari setiap 100 orang di seluruh dunia.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Rumus: &Phi;(Z) pada kurva normal populasi
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider mb-1">3. Kurva Lonceng Normal Gauss</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Distribusi Normal Baku (SD = 15)</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Lebih dari <strong>68% populasi manusia</strong> berada pada rentang 85 hingga 115 IQ (dalam rentang &plusmn;1 simpangan baku). Skor di atas 130 mewakili 2,2% teratas (ambang Mensa), sedangkan skor di bawah 70 menunjukkan divergensi klinis.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Distribusi: &mu; = 100, &sigma; = 15
          </div>
        </div>
      </div>

      <!-- Stable Educational Interpretation Guide -->
      <div class="mt-6 p-5 sm:p-6 rounded-2xl bg-zinc-50/70 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Bagaimana membaca tingkat kecerdasan IQ?
        </h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Nilai IQ adalah skor terstandardisasi, bukan nilai ujian sekolah dari 0 sampai 100. Pada skala dengan rerata 100 dan simpangan baku 15, skor sekitar 90-109 berada di rentang rata-rata. Persentil memberi konteks tambahan dengan menunjukkan posisi relatif terhadap distribusi yang digunakan untuk standardisasi.
        </p>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3">
          Pertanyaan seperti “IQ normal berapa?” sebaiknya dijawab dengan melihat skala, usia saat norma dibuat, jenis instrumen, dan tujuan pengukuran. Karena itu, satu angka tidak cukup untuk menggambarkan seluruh kemampuan kognitif seseorang.
        </p>
        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3">
          Pertanyaan “berapa rata-rata IQ orang Indonesia?” juga perlu dibaca hati-hati. Halaman hasil ini menggunakan skala terstandardisasi dengan titik tengah 100; itu tidak berarti halaman ini menetapkan satu angka khusus sebagai rata-rata nasional Indonesia. Estimasi antarpenelitian dapat berbeda karena sampel, norma, dan instrumen yang digunakan.
        </p>
      </div>
    </section>

    <!-- Certificate Generator Card -->
    <section id="certificate-section" class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs print:hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
            <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            SERTIFIKAT RESMI
          </div>
          <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
            Klaim Sertifikat Resmi Anda
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Buat sertifikat resolusi tinggi hasil asesmen kemampuan kognitif Anda. Masukkan nama lengkap Anda seperti yang ingin ditampilkan pada sertifikat.
          </p>
        </div>
        <div class="shrink-0 w-12 h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        </div>
      </div>

      <!-- Name input + generate -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <label for="cert-name-input" class="sr-only">Nama lengkap untuk sertifikat</label>
        <input
          id="cert-name-input"
          type="text"
          placeholder="Nama Lengkap (seperti yang akan tercantum di sertifikat)"
          aria-label="Nama lengkap untuk sertifikat"
          maxlength="60"
          class="flex-1 px-4 py-3 min-h-[44px] rounded-2xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors"
        />
        <button
          id="btn-generate-cert"
          type="button"
          class="min-h-[44px] px-6 py-3 rounded-2xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all flex items-center justify-center gap-2 whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer"
        >
