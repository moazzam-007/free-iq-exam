    // --- SubType label formatter ---
    function formatSubType(subType: string): string {
      const map: Record<string, string> = {
        matrix_reasoning:                 'Penalaran Matriks',
        topological_series:               'Seri Pola Topologi',
        cube_rotation:                    'Rotasi Kubus 3D',
