---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Spasial Online Gratis: 16 Soal Rotasi 3D (Gv) | FreeIQExam";
const description = "Uji kemampuan visual-spasial (Gv) Anda secara online. 16 soal rotasi mental 3D, sintesis pola lipatan kubus, dan proyeksi ortografis terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Visual-Spasial (Gv)",
    "description": "Penilaian visual-spasial 16 soal yang mengukur rotasi mental 3D, sintesis jaring permukaan lipatan, dan proyeksi isometrik.",
    "url": "https://freeiqexam.com/id/tes-spasial/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Spasial",
        "item": "https://freeiqexam.com/id/tes-spasial/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/spatial-reasoning-test" canonicalUrl="https://freeiqexam.com/id/tes-spasial" robots="noindex, follow">
  <Header currentPath="/id/tes-spasial" enPath="/spatial-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Spasial</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gv <span aria-hidden="true">&bull;</span> MANIPULASI OBJEK 3D</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Pemrosesan Visual-Spasial (Gv)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan Anda dalam memanipulasi, memutar secara mental, dan membayangkan transformasi bentuk 2D ke 3D di bawah kerangka kerja Teori Respons Butir 2PL.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Rotasi Spasial 3D</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Sintesis Lipatan Jaring</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="spatial"
      domainCode="Gv"
      domainTitle="Pemrosesan Visual-Spasial"
      domainSubtitle="Rotasi Mental 3D & Sintesis Jaring Lipatan"
      domainDescription="Pemrosesan Visual-Spasial (Gv) mengukur kemampuan menghasilkan, menyimpan, mengingat kembali, dan mengubah representasi visual objek secara mental dalam ruang tiga dimensi."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-sky-600 to-blue-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />
  </main>

  <Footer />
</Layout>
