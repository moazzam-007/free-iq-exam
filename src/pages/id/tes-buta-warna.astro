      <!-- SECTION 1: THE CLINICAL SCIENCE OF COLOR VISION -->
      <article class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 font-mono text-[13px] sm:text-sm uppercase font-semibold">
