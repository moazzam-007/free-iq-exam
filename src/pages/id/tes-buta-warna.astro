---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const alternates = {};

const title = "Tes Buta Warna Online: Pemeriksaan Ishihara 22 Pelat Gratis | FreeIQExam";
const description = "Skrining penglihatan warna mandiri online dengan 22 pelat pseudoisokromatik Ishihara. Deteksi defisiensi merah-hijau protanopia dan deuteranopia secara instan.";
const canonicalUrl = "https://freeiqexam.com/id/tes-buta-warna";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Tes Buta Warna Ishihara Online",
    "description": "Skrining gaya Ishihara 22 pelat untuk defisiensi penglihatan warna merah-hijau (Deuteranopia, Protanopia).",
    "url": canonicalUrl,
    "medicalAudience": "Patient",
    "aspect": "Screening"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Tes Buta Warna Online FreeIQExam",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Memerlukan dukungan JavaScript dan HTML5 Canvas/SVG",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Skrining Penglihatan Warna 22 Pelat Gaya Ishihara",
      "Skrining untuk Deuteranopia dan Protanopia (Defisiensi Merah-Hijau)",
      "Simulator Defisiensi Penglihatan Warna Interaktif",
      "Mode Anak & Simbol Geometri untuk pengujian pediatrik",
      "Persentase Sensitivitas Sel Kerucut L, M, dan S",
      "Laporan skrining instan tanpa syarat pendaftaran atau email"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Alat",
        "item": "https://freeiqexam.com/id/tes"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Tes Buta Warna",
        "item": canonicalUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Apa nama tes buta warna klinis yang umum digunakan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tes buta warna klinis yang paling terkenal adalah Tes Ishihara, dinamai sesuai penemunya Dr. Shinobu Ishihara (dokter mata asal Jepang) pada tahun 1917. Instrumen diagnostik lainnya mencakup Tes Farnsworth D-15 / 100-Hue, Anomaloskop Nagel (baku emas diagnostik kuantitatif), tes HRR (Hardy-Rand-Rittler), dan tes lentera penerbangan seperti Farnsworth Lantern (Falant)."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara melakukan tes buta warna di rumah?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Untuk melakukan skrining mandiri di rumah: 1) Atur kecerahan layar antara 80% hingga 100%, 2) Matikan fitur filter cahaya biru seperti Night Shift, TrueTone, f.lux, atau pelindung layar kuning, 3) Posisikan mata sejauh rentang lengan (~50–75 cm) dari layar, dan 4) Jawab ke-22 pelat Ishihara secara spontan tanpa menebak. Tes ini mengevaluasi sumbu kebingungan warna merah-hijau secara instan."
        }
      },
      {
        "@type": "Question",
        "name": "Apa itu pelat buta warna terbalik (reverse color blind test)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pelat buta warna terbalik (reverse plate) menggunakan titik-titik pseudo-isokromatik yang dirancang khusus sehingga individu dengan penglihatan normal hanya melihat pola acak, sementara individu dengan buta warna merah-hijau dapat membaca angka tersembunyi dengan jelas. Hal ini terjadi karena mata buta warna tidak terdistraksi oleh kamuflase warna dan mendeteksi kontur perbedaan terang-gelap (luminansi) yang terlewatkan oleh trikromat normal."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara menguji buta warna pada anak-anak kecil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pelat Ishihara standar mengharuskan membaca angka Arab, yang belum tentu dikuasai balita atau anak prasekolah. Untuk pengujian pediatrik, gunakan mode simbol anak yang menggunakan bentuk geometris sederhana (Lingkaran, Persegi, Segitiga, Bintang). Anak cukup menunjuk bentuk yang dilihat, memungkinkan skrining akurat sejak usia 3 hingga 4 tahun."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah tes buta warna Ishihara bisa dicurangi atau diakali?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tes buta warna klinis tidak dapat dicurangi karena responsnya bergantung pada fotopigmen biologis sel kerucut retina. Ujian dinas resmi (seperti penerbangan, maritim, dan militer) menggunakan urutan pelat acak atau alat lentera mekanis di mana hafalan tidak berguna. Kacamata pengoreksi warna (seperti EnChroma) secara ketat dilarang dalam tes sertifikasi resmi."
        }
      },
      {
        "@type": "Question",
        "name": "Apa perbedaan antara kacamata buta warna EnChroma dan Pilestone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EnChroma dan Pilestone adalah produsen kacamata filter optik khusus buta warna. Kacamata ini menggunakan lapisan optik multi-notch yang menyaring panjang gelombang cahaya yang tumpang tindih antara reseptor merah dan hijau, sehingga meningkatkan kontras warna bagi trikromat anomali (Deuteranomali dan Protanomali). Namun kacamata ini tidak menyembuhkan buta warna dan tidak bekerja pada dikromat total yang kehilangan fotopigmen kerucut sepenuhnya."
        }
      },
      {
        "@type": "Question",
        "name": "Apa yang sebenarnya dilihat oleh orang buta warna merah-hijau?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Orang dengan buta warna merah-hijau tidak melihat dunia dalam hitam-putih. Sebaliknya, warna merah, hijau, oranye, dan cokelat tampak sebagai variasi warna kuning, khaki, zaitun, dan abu-abu. Bagi protanopia (buta merah), warna merah tampak jauh lebih redup atau hampir hitam. Bagi deuteranopia (buta hijau), warna hijau dan merah memiliki kecerahan normal tetapi dengan corak warna kecokelatan yang serupa."
        }
      },
      {
        "@type": "Question",
        "name": "Bisakah seseorang menjadi pilot maskapai penerbangan komersial jika buta warna?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bisa dengan syarat khusus. Otoritas penerbangan sipil internasional (seperti FAA atau Kemenhub RI) mensyaratkan sertifikat medis Kelas 1. Jika gagal pada pelat Ishihara standar, kandidat dapat mengajukan tes operasional alternatif (Operational Color Vision Test / OCVT), termasuk tes sinyal pistol cahaya menara kontrol dan uji terbang medis untuk memperoleh dispensasi (Letter of Evidence)."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <!-- CVD SVG Simulation Filter Matrices (Hidden in DOM, referenced by CSS) -->
  <svg class="hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="deutan-filter">
      <feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0" />
    </filter>
    <filter id="protan-filter">
      <feColorMatrix type="matrix" values="0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0" />
    </filter>
    <filter id="tritan-filter">
      <feColorMatrix type="matrix" values="0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0" />
    </filter>
  </svg>

  <style>
    .plate-container {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    @keyframes pilestonePop {
      0% { transform: scale(1); }
      30% { transform: scale(0.96); opacity: 0.9; }
      70% { transform: scale(1.02); opacity: 0.98; }
      100% { transform: scale(1); opacity: 1; }
    }

    .pilestone-transition {
      animation: pilestonePop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .timeline-dot {
      transition: all 0.25s ease;
    }

    .plate-dot {
      vector-effect: non-scaling-stroke;
      shape-rendering: geometricPrecision;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    /* Simulation filters */
    .filter-normal { filter: none; }
    .filter-deutan { filter: url('#deutan-filter'); }
    .filter-protan { filter: url('#protan-filter'); }
    .filter-tritan { filter: url('#tritan-filter'); }
    .filter-achroma { filter: grayscale(100%); }

    .cb-hero-glow { position: absolute; inset-inline: -1rem; top: -2rem; height: 24rem; pointer-events: none; background: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.10) 0%, rgba(0, 102, 204, 0.03) 45%, transparent 70%); mask-image: linear-gradient(to bottom, black 55%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%); }
    :global(.dark) .cb-hero-glow { background: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%); }
    #test-card .key-btn:active, #test-card .shape-btn:active, .sim-filter-btn:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
    @media (prefers-reduced-motion: reduce) { .cb-hero-glow { display: none; } }

    @media print {
      header, footer, #calibration-banner, #keypad-numbers, #keypad-kids, .mode-toggle-container, #btn-restart-link, .no-print {
        display: none !important;
      }
      #results-view {
        display: flex !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Beranda</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <a href="/id/tes" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Alat</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Buta Warna</span>
    </nav>

    <!-- Page Header & Eyebrow -->
    <header class="relative text-center max-w-3xl mx-auto mb-10">
      <div class="cb-hero-glow" aria-hidden="true"></div>
      <div class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Skrining 22 Pelat Ishihara • Evaluasi Penglihatan Warna</span>
      </div>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4">
        Tes Buta Warna Online
      </h1>
      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto">
        Evaluasi persepsi warna Anda dengan matriks <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">22 pelat Ishihara autentik</strong>. Titik-titik beresolusi tinggi mendeteksi <strong class="text-emerald-600 dark:text-emerald-400 font-bold">Deuteranopia</strong> dan <strong class="text-rose-600 dark:text-rose-400 font-bold">Protanopia</strong> (defisiensi merah-hijau) secara gratis dan privat.
      </p>
    </header>

    <!-- PRE-TEST DISPLAY CALIBRATION ADVISORY -->
    <div id="calibration-banner" class="max-w-3xl mx-auto mb-8 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl shrink-0">⚠️</span>
          <div class="space-y-1">
            <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Kalibrasi Layar Sebelum Tes</h4>
            <p class="text-amber-800 dark:text-amber-300/90 text-sm leading-relaxed">
              Demi akurasi pengujian: <strong>1)</strong> Atur kecerahan layar antara 80%–100%, <strong>2)</strong> Matikan Night Shift, TrueTone, f.lux, atau filter layar kuning, dan <strong>3)</strong> Jaga jarak pandang rentang lengan (~50–75 cm).
            </p>
          </div>
        </div>
        <button id="btn-dismiss-calibration" type="button" class="text-amber-600 dark:text-amber-400 hover:text-amber-950 dark:hover:text-white p-1 cursor-pointer text-lg" aria-label="Tutup saran kalibrasi">✕</button>
      </div>
    </div>

    <!-- TEST MODE TOGGLE (STANDARD NUMBERS VS KIDS SHAPES) -->
    <div class="mode-toggle-container max-w-md mx-auto mb-8 flex items-center justify-center p-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs font-medium text-[13px] sm:text-sm">
      <button id="mode-btn-numbers" type="button" class="flex-1 min-h-[44px] py-3 px-4 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-bold shadow-sm transition-all active:scale-[0.97] flex items-center justify-center gap-2 cursor-pointer">
        <span>🔢</span><span>Angka Standar (22 Pelat)</span>
      </button>
      <button id="mode-btn-kids" type="button" class="flex-1 min-h-[44px] py-3 px-4 rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all active:scale-[0.97] flex items-center justify-center gap-2 cursor-pointer">
        <span>⭐</span><span>Mode Anak &amp; Simbol</span>
      </button>
    </div>

    <!-- INTERACTIVE TEST ARENA CARD -->
    <div class="relative w-full max-w-4xl mx-auto">
      <div id="test-card" class="plate-container w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl flex flex-col items-center">
        
        <!-- Header Bar with Brand & Plate Progress -->
        <div class="w-full flex items-center justify-between pb-4 mb-6 text-[13px] sm:text-sm font-mono border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <span class="font-heading font-extrabold tracking-wider uppercase text-zinc-900 dark:text-zinc-100 text-[13px] sm:text-sm">
              FREE<span class="text-blue-600 dark:text-blue-500">IQ</span>EXAM <span class="text-zinc-400 dark:text-zinc-500 font-normal">ISHIHARA</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span id="plate-counter-badge" class="px-3 py-1 rounded-full text-[13px] font-mono font-bold bg-zinc-100 dark:bg-zinc-800 text-blue-600 dark:text-blue-400 border border-zinc-200 dark:border-zinc-700">
              PELAT 1 DARI 22
            </span>
          </div>
        </div>

        <!-- 22-Plate Connected Timeline Progress Bar -->
        <div class="w-full mb-8 px-1 sm:px-4">
          <div id="timeline-chain" class="relative flex items-center justify-between w-full h-8">
            <div class="absolute left-2 right-2 top-1/2 -translate-y-1/2 h-[2px] bg-zinc-200 dark:bg-zinc-800 z-0"></div>
            <div id="timeline-dots" class="relative z-10 flex items-center justify-between w-full"></div>
          </div>
        </div>

        <!-- ACTIVE TESTING ARENA (SIDE-BY-SIDE ON DESKTOP, STACKED ON MOBILE) -->
        <div id="active-test-view" class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-14 my-2">
          
          <!-- High-DPI Procedural 764-Circle Ishihara SVG Stage -->
          <div id="plate-stage" class="relative w-[300px] sm:w-[380px] lg:w-[440px] aspect-square rounded-full bg-zinc-100 dark:bg-[#18181c] p-2 shadow-2xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center shrink-0">
            <svg id="plate-svg" class="w-full h-full rounded-full block cursor-pointer select-none" viewBox="0 0 666 666" role="img" aria-label="Pelat tes buta warna Ishihara autentik" xmlns="http://www.w3.org/2000/svg">
              <circle cx="333" cy="333" r="328" fill="#121215"></circle>
              <g id="plate-dots"></g>
            </svg>
          </div>

          <!-- Keypad & Touch Controls Column -->
          <div class="flex flex-col items-center justify-center w-full max-w-[300px]">
            <!-- Instruction Prompt -->
            <div class="text-center mb-5">
              <p id="prompt-main-text" class="text-[13px] sm:text-sm font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-300 font-semibold mb-1">Pilih Angka yang Anda Lihat</p>
              <p id="prompt-sub-text" class="text-[13px] text-zinc-400 dark:text-zinc-500">Papan ketik: [1-9], [N] Tidak Ada, [U] Ragu</p>
            </div>

            <!-- NUMBERS MODE KEYPAD (1-9, NOTHING, NOT SURE) -->
            <div id="keypad-numbers" class="w-full flex flex-col items-center">
              <div class="grid grid-cols-3 gap-3 w-full mb-3">
                <button type="button" data-val="1" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">1</button>
                <button type="button" data-val="2" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">2</button>
                <button type="button" data-val="3" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">3</button>
                <button type="button" data-val="4" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">4</button>
                <button type="button" data-val="5" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">5</button>
                <button type="button" data-val="6" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">6</button>
                <button type="button" data-val="7" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">7</button>
                <button type="button" data-val="8" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">8</button>
                <button type="button" data-val="9" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">9</button>
              </div>

              <!-- Action Row: NOTHING / NOT SURE -->
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="nothing" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[13px] sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  TIDAK ADA
                </button>
                <button type="button" data-val="unsure" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[13px] sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  RAGU-RAGU
                </button>
              </div>
            </div>

            <!-- KIDS & SHAPES MODE KEYPAD (CIRCLE, SQUARE, TRIANGLE, STAR) -->
