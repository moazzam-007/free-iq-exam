---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Tes Kecemasan Online: Kuesioner GAD-7 Skrining Ansietas | FreeIQExam";
const description = "Skrining tingkat gejala kecemasan umum secara mandiri dengan instrumen Generalized Anxiety Disorder 7 (GAD-7). Hasil evaluasi mandiri awal instan.";
const canonicalUrl = 'https://freeiqexam.com/id/tes-kecemasan';

const alternates = {};

const faqItems = [
  [
    'What is the GAD-7 and who developed it?',
    'The GAD-7 (Generalized Anxiety Disorder 7-item scale) is an evidence-based clinical screening instrument developed by Dr. Robert L. Spitzer, Dr. Kurt Kroenke, Dr. Janet B. W. Williams, and Dr. Bernd Löwe in 2006. It measures the frequency and severity of core generalized anxiety symptoms over the preceding two weeks using a standardized 4-point response scale.'
  ],
  [
    'How accurate is the GAD-7 at identifying anxiety disorders?',
    'In original validation trials and extensive clinical meta-analyses, a GAD-7 score of 10 or higher demonstrates a sensitivity of 89% and a specificity of 82% for Generalized Anxiety Disorder against structured clinical interviews. It also serves as a moderately effective screening aid for panic disorder, social anxiety disorder, and post-traumatic stress disorder.'
  ],
  [
    'Can this test diagnose me with an anxiety disorder?',
    'No. The GAD-7 is a validated screening questionnaire, not a medical diagnosis. A formal diagnosis requires clinical evaluation by a licensed physician, psychiatrist, or clinical psychologist who can assess medical history, symptom duration, rule out physiological mimics (such as hyperthyroidism), and evaluate functional impairment.'
  ],
  [
    'What is the difference between cognitive worry and somatic anxiety?',
    'Cognitive worry involves mental perseveration, intrusive catastrophic thoughts, future-oriented anticipation, and difficulty controlling worry loops (GAD-7 items 1, 2, 3, and 7). Somatic anxiety involves physical autonomic arousal, muscle bracing, psychomotor restlessness, and irritability (GAD-7 items 4, 5, and 6).'
  ],
  [
    'How is Generalized Anxiety Disorder different from ordinary stress?',
    'Everyday stress is typically proportional to an identifiable external demand and subsides once the situation resolves. Generalized Anxiety Disorder is characterized by persistent, excessive, and uncontrollable worry that occurs on more days than not for at least six months across multiple life domains, often accompanied by physical tension and sleep disruption.'
  ],
  [
    'What do the different GAD-7 score ranges mean?',
    'Scores are stratified into four clinical tiers: 0–4 indicates Minimal Anxiety (healthy baseline fluctuation); 5–9 indicates Mild Anxiety (sub-clinical elevation; watchful waiting and lifestyle pacing); 10–14 indicates Moderate Anxiety (clinical cut-off reached; evaluation recommended); and 15–21 indicates Severe Anxiety (high symptom burden; active clinical care warranted).'
  ],
  [
    'What should I do if my score is 10 or above?',
    'A score of 10 or above indicates that your symptoms have reached clinical significance. You should consider sharing your results with a primary care doctor or mental health professional. You can print the Clinician Intake Summary generated by this tool to bring to your consultation.'
  ],
  [
    'How frequently should I retake the GAD-7?',
    'If you are monitoring symptoms without treatment, re-screening every 2 to 4 weeks is common. If you have initiated evidence-based psychotherapy (such as CBT) or pharmacotherapy (such as an SSRI), clinicians often repeat the GAD-7 every 2 to 4 weeks to objectively measure treatment response. A change of 4 to 5 points is generally considered clinically meaningful.'
  ]
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'GAD-7 Generalized Anxiety Disorder Screener & Nervous System Benchmark',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Generalized Anxiety Disorder',
      alternateName: ['GAD', 'Chronic Anxiety', 'Anxiety Neurosis', 'Generalized Anxiety'],
      code: { '@type': 'MedicalCode', code: 'F41.1', codingSystem: 'ICD-10' }
    },
    lastReviewed: '2026-09-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Free Clinical Anxiety Test (GAD-7)',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Keyboard-operable response controls (keys 1–4), high-contrast focus states, semantic headings, aria-live announcements, crisis hotline directory, and a printable clinician intake summary.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://freeiqexam.com/id' },
      { '@type': 'ListItem', position: 2, name: 'Asesmen', item: 'https://freeiqexam.com/id/tes' },
      { '@type': 'ListItem', position: 3, name: 'Tes Kecemasan (GAD-7)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'GAD-7 Generalized Anxiety Disorder Questionnaire — 7 Items',
    hasPart: [
      {
        '@type': 'Question',
        name: 'Feeling nervous, anxious, or on edge',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Not being able to stop or control worrying',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Worrying too much about different things',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Trouble relaxing',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Being so restless that it is hard to sit still',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Becoming easily annoyed or irritable',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      },
      {
        '@type': 'Question',
        name: 'Feeling afraid, as if something awful might happen',
        suggestedAnswer: [
          { '@type': 'Answer', text: 'Not at all' },
          { '@type': 'Answer', text: 'Several days' },
          { '@type': 'Answer', text: 'More than half the days' },
          { '@type': 'Answer', text: 'Nearly every day' }
        ]
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer }
    }))
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schemas}>
  <Header />

  <main class="min-h-screen bg-white px-4 py-12 text-zinc-900 transition-colors duration-300 dark:bg-[#09090b] dark:text-zinc-100 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      
      <!-- Header / Breadcrumbs -->
      <header class="relative text-center">
        <div class="anx-hero-glow" aria-hidden="true"></div>
        <nav class="flex items-center justify-center gap-2 text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-4" aria-label="Breadcrumb">
          <a href="/id" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Beranda</a>
          <span>/</span>
          <a href="/id/tes" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Asesmen</a>
          <span>/</span>
          <span class="text-zinc-800 dark:text-zinc-200">Anxiety Test (GAD-7)</span>
        </nav>

        <p class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-4 py-1.5 text-[13px] font-mono font-bold uppercase tracking-wider text-[#0066cc] dark:border-zinc-800 dark:bg-zinc-900 dark:text-[#2997ff]">
          <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          Clinical GAD-7 Psychometric Screener
        </p>

        <h1 class="mt-4 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-[-0.025em] leading-[1.08] text-zinc-950 dark:text-white">
          Clinical Anxiety Test & <span class="text-[#0066cc] dark:text-[#2997ff]">Nervous System Benchmark</span>
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-[17px] sm:text-lg leading-[1.62] text-zinc-600 dark:text-zinc-300">
          Measure symptom burden, differentiate cognitive worry loops from somatic tension, and evaluate your results against standardized psychiatric severity thresholds. 100% confidential and processed entirely in your browser.
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2.5 text-[13px] sm:text-sm font-mono text-zinc-600 dark:text-zinc-400">
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">7 Standard GAD Items</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">Dual-Domain Breakdown</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">Clinician Intake PDF</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">100% Client-Side</span>
        </div>
      </header>

      <!-- Crisis Helpline Resource Card -->
      <aside class="mt-8 rounded-2xl border border-amber-200 bg-amber-50/80 p-4 sm:p-5 text-amber-950 dark:border-amber-900/50 dark:bg-amber-950/25 dark:text-amber-200" aria-label="Crisis resources">
        <div class="flex items-start gap-3.5">
          <span class="text-xl shrink-0">🛡️</span>
          <div class="text-[13px] sm:text-sm leading-relaxed">
            <strong class="font-bold">Need immediate support?</strong> If you are experiencing overwhelming panic, acute distress, or thoughts of self-harm, confidential free help is available 24/7. In the US/Canada, call or text <strong>988</strong> (Suicide & Crisis Lifeline). In the UK, call <strong>111</strong> or <strong>116 123</strong>. Worldwide: <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="underline font-bold hover:text-amber-800 dark:hover:text-white">findahelpline.com</a>.
          </div>
        </div>
      </aside>

      <!-- Interactive Assessment Application -->
      <section id="anxiety-app" class="mt-8">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/90 p-5 dark:border-zinc-800 dark:bg-zinc-950/80 sm:p-8 shadow-xl backdrop-blur-xl">
          
          <!-- 1. INTRO / START CARD -->
          <div id="assessment-intro" class="border-t border-zinc-200 pt-6 dark:border-zinc-800 sm:pt-8">
            <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">Protokol Klinis</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-3xl">Sebelum Memulai</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Answer based on how often you have been bothered by each symptom over the <strong>last 2 weeks</strong>. The GAD-7 quantifies anxiety burden against validated clinical benchmarks. It is a screening instrument, not a medical diagnosis.
            </p>
            <p class="mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Everything runs locally in your browser. No personal health records are transmitted, logged, or stored on external servers.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <button id="begin-assessment" type="button" class="rounded-2xl bg-[#0066cc] px-8 py-4 text-base font-bold text-white transition-all hover:bg-[#0071e3] active:scale-[0.97] shadow-lg shadow-blue-600/20 cursor-pointer dark:bg-[#2997ff] dark:hover:bg-[#3b82f6]">
                Start the GAD-7 Screener
              </button>
              <span class="text-[13px] sm:text-sm font-mono text-zinc-500 dark:text-zinc-400">Papan ketik: 1–4 untuk menjawab · ← / → untuk berpindah</span>
            </div>
          </div>

          <!-- 2. LIVE QUESTIONNAIRE CARD (Hidden initially) -->
          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">GAD-7 · Past 2 Weeks</p>
                <p id="question-domain" class="mt-1 text-sm sm:text-base font-bold text-zinc-700 dark:text-zinc-300">Cognitive / Affective Worry</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-bold sm:text-lg text-zinc-950 dark:text-white">Question 1 of 7</div>
                <div id="progress-label" class="mt-0.5 text-[13px] sm:text-sm font-mono text-zinc-500 dark:text-zinc-400">0% answered</div>
              </div>
            </div>

            <!-- Progress Bar -->
            <div class="mt-4 h-[2px] overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
              <div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:4%"></div>
            </div>

            <!-- Active Question Article -->
            <article class="mt-6 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/90 sm:p-9 shadow-sm">
              <div class="flex flex-wrap gap-2 text-[13px] font-mono text-zinc-500 dark:text-zinc-400">
                <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1">Choose one response</span>
                <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1">Recall window: Past 2 weeks</span>
              </div>

              <h2 id="question-heading" class="mt-5 text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white"></h2>
              <p id="question-context" class="mt-2 text-sm sm:text-base font-medium text-[#0066cc] dark:text-[#2997ff]"></p>

              <!-- Likert 4-Option Grid -->
              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Frequency response options">
                <!-- Populated dynamically -->
              </div>

              <!-- Navigation Controls -->
              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="rounded-2xl border border-zinc-300 bg-white px-6 py-3.5 text-sm font-bold transition active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900 disabled:opacity-40 cursor-pointer">
                  ← Back
                </button>
                <button id="next-button" type="button" class="rounded-2xl bg-[#0066cc] px-7 py-3.5 text-sm font-bold text-white transition active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-[#2997ff] cursor-pointer">
                  Next question →
                </button>
              </div>
            </article>
          </section>

          <!-- 3. COMPREHENSIVE CLINICAL RESULTS CARD (Hidden initially) -->
          <section id="results-section" class="hidden space-y-8" aria-labelledby="results-title">
            
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/90 sm:p-9 shadow-lg">
              
              <!-- Result Header -->
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between border-b border-zinc-200 dark:border-zinc-800/80 pb-6">
                <div>
                  <div id="result-badge" class="result-badge minimal">Minimal Anxiety</div>
                  <h2 id="results-title" class="mt-4 text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 dark:text-white">Your GAD-7 Result</h2>
                  <p id="result-classification" class="mt-1 text-xl font-bold text-[#0066cc] dark:text-[#2997ff]">Minimal Anxiety</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-6 py-4 text-center dark:border-zinc-800 dark:bg-zinc-950">
                  <div class="text-[13px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Total GAD-7 Score</div>
                  <div id="result-score" class="mt-1 text-4xl font-black font-mono tracking-tight text-zinc-950 dark:text-white">0 / 21</div>
                </div>
              </div>

              <!-- Result Narrative -->
              <p id="result-narrative" class="mt-6 text-base sm:text-lg leading-relaxed text-zinc-700 dark:text-zinc-300"></p>

              <!-- Dual-Domain Subscales Grid -->
              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                
                <!-- Cognitive / Affective Worry Subscale -->
                <article class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[13px] font-mono uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] font-bold">Cognitive Worry Domain</span>
                    <span id="cognitive-status" class="text-[13px] font-bold text-zinc-500 dark:text-zinc-400">Lower endorsement</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1">
                    <div id="cognitive-score" class="text-3xl font-black font-mono text-zinc-950 dark:text-white">0 / 12</div>
                    <span class="text-[13px] font-mono text-zinc-500">Items 1, 2, 3, 7</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden mt-2">
                    <div id="cognitive-bar" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-500" style="width: 0%"></div>
                  </div>
                  <p class="text-[13px] text-zinc-500 dark:text-zinc-400 leading-normal pt-1">
                    Apprehension, uncontrollability of worry, diffuse catastrophic ideation, and anticipation of impending doom.
                  </p>
                </article>

                <!-- Somatic / Autonomic Tension Subscale -->
                <article class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[13px] font-mono uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] font-bold">Somatic Tension Domain</span>
                    <span id="somatic-status" class="text-[13px] font-bold text-zinc-500 dark:text-zinc-400">Lower endorsement</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1">
                    <div id="somatic-score" class="text-3xl font-black font-mono text-zinc-950 dark:text-white">0 / 9</div>
                    <span class="text-[13px] font-mono text-zinc-500">Items 4, 5, 6</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden mt-2">
                    <div id="somatic-bar" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-500" style="width: 0%"></div>
                  </div>
                  <p class="text-[13px] text-zinc-500 dark:text-zinc-400 leading-normal pt-1">
                    Neuromuscular tension, trouble relaxing, psychomotor restlessness, and nervous system irritability.
                  </p>
                </article>

              </div>

              <!-- Severity Stratification -->
              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Clinical Stratification</p>
                <h3 class="mt-1 text-xl font-bold sm:text-2xl text-zinc-950 dark:text-white">Severity Spectrum</h3>
                <div id="severity-scale" class="mt-5 space-y-2"></div>
              </article>

              <!-- Sub-Domain Profile Matrix -->
              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Symptom Distribution</p>
                <h3 class="mt-1 text-xl font-bold sm:text-2xl text-zinc-950 dark:text-white">Subscale Breakdown</h3>
                <div id="profile-matrix" class="mt-5 space-y-4"></div>
              </article>

              <!-- Key Clinical Indicators -->
              <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800">
                  <span class="text-[13px] font-mono text-zinc-500 block">Diagnostic Cut-off (≥ 10)</span>
                  <strong id="cutoff-status" class="text-sm font-bold text-zinc-950 dark:text-white block mt-1">Below clinical cut-off</strong>
                </div>
                <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800">
                  <span class="text-[13px] font-mono text-zinc-500 block">Symptom Breadth</span>
                  <strong id="breadth-status" class="text-sm font-bold text-zinc-950 dark:text-white block mt-1">0 of 7 items</strong>
                </div>
                <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200 dark:border-zinc-800">
                  <span class="text-[13px] font-mono text-zinc-500 block">Functional Impairment</span>
                  <strong id="functional-score" class="text-sm font-bold text-zinc-950 dark:text-white block mt-1">Not answered</strong>
                </div>
              </div>

              <!-- Recommended Next Steps -->
              <article class="mt-6 rounded-3xl border border-zinc-200 bg-zinc-50/60 p-6 dark:border-zinc-800 dark:bg-zinc-900">
                <h3 class="text-xl font-bold sm:text-2xl text-zinc-950 dark:text-white">Evidence-Based Next Steps</h3>
                <ul id="next-steps-list" class="mt-4 space-y-3"></ul>
              </article>

              <!-- Action Buttons -->
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="print-result" type="button" class="rounded-2xl bg-[#0066cc] px-7 py-4 text-sm font-bold text-white transition active:scale-[0.97] dark:bg-[#2997ff] cursor-pointer shadow-md">
                  Print Clinician Intake Summary
                </button>
                <button id="share-result" type="button" class="rounded-2xl border border-zinc-300 px-6 py-4 text-sm font-bold transition active:scale-[0.97] dark:border-zinc-700 cursor-pointer">
                  Share Screening Summary
                </button>
                <button id="retake-result" type="button" class="rounded-2xl border border-zinc-300 px-6 py-4 text-sm font-bold transition active:scale-[0.97] dark:border-zinc-700 cursor-pointer">
                  Retake Screener
                </button>
              </div>

              <!-- Context Disclaimer Box -->
