---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

// Alternate links for i18n
const alternates = {
  en: "https://freeiqexam.com/typing-test",
  id: "https://freeiqexam.com/id/tes-kecepatan-mengetik"
};

const title = "Tes Kecepatan Mengetik Online: Tes Mengetik WPM 60 Detik | FreeIQExam";
const description = "Uji kecepatan mengetik Anda dalam tes 60 detik Bahasa Indonesia. Hitung kata per menit (WPM), akurasi karakter, dan bandingkan performa mengetik Anda.";
const canonicalUrl = "https://freeiqexam.com/id/tes-kecepatan-mengetik";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Tes Kecepatan Mengetik & Tolok Ukur WPM Online",
    "url": "https://freeiqexam.com/id/tes-kecepatan-mengetik",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "browserRequirements": "Memerlukan dukungan JavaScript dan Web Audio API",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Kalkulasi kecepatan Net WPM dan Gross WPM secara real-time",
      "Fisika kursor caret halus mengambang dengan penyorotan karakter dinamis",
      "Sintesis suara sakelar mekanis Web Audio API (Cherry MX Blue, Brown, Red)",
      "Grafik sparkline kecepatan WPM dan kesalahan kanvas High-DPI",
      "Peta panas kesalahan tombol keyboard QWERTY dan analisis ketangkasan jari",
      "Pilihan mode Pengujian Waktu (15d, 30d, 60d, 120d) dan Jumlah Kata (25, 50, 100)",
      "Sertifikat kecepatan mengetik beresolusi tinggi yang dapat diunduh (PNG)",
      "100% gratis, tanpa login email, pemrosesan aman di peramban lokal"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Permainan",
        "item": "https://freeiqexam.com/id/permainan"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Tes Kecepatan Mengetik",
        "item": "https://freeiqexam.com/id/tes-kecepatan-mengetik"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Berapa kecepatan mengetik rata-rata (WPM) yang dianggap bagus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rata-rata kecepatan mengetik global adalah sekitar 40 hingga 45 kata per menit (WPM). Kecepatan 60 hingga 70 WPM dinilai di atas rata-rata dan sangat produktif untuk pekerjaan kantor serta profesional. Kecepatan 80 hingga 95 WPM menempatkan Anda di posisi 10% teratas, sedangkan 100+ WPM merupakan level pengetik 10 jari elit (top 2% dunia)."
        }
      },
      {
        "@type": "Question",
        "name": "Apa perbedaan antara Gross WPM dan Net WPM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Gross WPM (WPM Kotor) mengukur kecepatan ketikan mentah dengan membagi total karakter yang diketik dengan 5 (panjang kata standar internasional) per menit. Net WPM (WPM Bersih) menerapkan penalti kesalahan: Net WPM = Gross WPM - (Kesalahan yang Belum Dikoreksi / Waktu dalam Menit). Net WPM adalah standar resmi rekrutmen profesional karena kesalahan mengetik merusak produktivitas nyata."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana definisi 1 kata dihitung dalam tes mengetik?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dalam tolok ukur psikometri dan optometri mengetik, 1 kata distandardisasi menjadi tepat 5 ketukan tombol (mencakup karakter huruf, spasi, dan tanda baca). Standardisasi 5 ketukan ini memastikan kata panjang (misal 'pertanggungjawaban') tidak merugikan pengetik dibanding kata pendek (misal 'dan')."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana cara meningkatkan kecepatan mengetik dari 50 ke 100+ WPM?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Untuk menembus batas kecepatan mengetik: 1) Kuasai teknik mengetik 10 jari buta (touch typing) pada deret dasar home row (ASDF JKL;) tanpa menatap keyboard, 2) Prioritaskan akurasi 98%+ sebelum memacu kecepatan, 3) Latih mata membaca 1–2 kata di depan posisi kursor, 4) Lakukan latihan sprint singkat 15 detik setiap hari, dan 5) Gunakan keyboard mekanis ergonomis dengan resistensi aktuasi rendah."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah jenis switch keyboard mekanis memengaruhi kecepatan mengetik?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Switch mekanis memberikan titik aktuasi taktil atau suara klik yang jelas sebelum tombol menyentuh dasar (bottom-out), sehingga mengurangi keletihan otot jari. Switch taktil (seperti Cherry MX Brown) dan linier (Cherry MX Red) sangat disukai oleh pengetik cepat karena gerakan aktuasi yang halus dan responsif."
        }
      },
      {
        "@type": "Question",
        "name": "Mengapa akurasi mengetik jauh lebih penting daripada kecepatan mentah?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Setiap penekanan tombol Backspace menimbulkan tiga kerugian waktu: waktu untuk menekan Backspace, waktu untuk mengetik ulang karakter yang benar, dan terhentinya ritme aliran kognitif motorik Anda. Mengetik pada kecepatan 80 WPM dengan akurasi 99% menghasilkan teks yang jauh lebih cepat selesai dibanding 100 WPM dengan akurasi 90%."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah tata letak keyboard Dvorak atau Colemak lebih cepat daripada QWERTY?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tata letak alternatif seperti Dvorak dan Colemak dirancang untuk memaksimalkan penempatan huruf vokal dan konsonan umum pada baris dasar (home row hingga 70% vs 32% pada QWERTY). Hal ini mengurangi jarak jelajah jari dan mencegah cedera regangan berulang (RSI), meskipun kecepatan tertinggi tetap ditentukan oleh otomatisasi memori motorik otak."
        }
      },
      {
        "@type": "Question",
        "name": "Berapa rekor dunia kecepatan mengetik tercepat saat ini?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Kecepatan mengetik tercepat yang tercatat pada keyboard standar QWERTY dalam durasi 1 menit adalah 216 WPM oleh Sean Wrona. Rekor dunia Guinness untuk pengetikan berkelanjutan dipegang oleh Barbara Blackburn dengan rata-rata 150 WPM selama 50 menit dan puncak 212 WPM menggunakan layout Dvorak."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <style>
    /* Caret Pulse and Floating Smooth Movement */
    #caret {
      transition: transform 0.08s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    @keyframes caretBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .caret-blink {
      animation: caretBlink 1s infinite ease-in-out;
    }

    /* Word Box Line Clamping & Mask */
    .words-box {
      mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    .typ-hero-glow { position: absolute; inset-inline: -1rem; top: -2rem; height: 24rem; pointer-events: none; background: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.10) 0%, rgba(0, 102, 204, 0.03) 45%, transparent 70%); mask-image: linear-gradient(to bottom, black 55%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%); }
    :global(.dark) .typ-hero-glow { background: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%); }
    #typingSettingsBar button { min-height: 44px; }
    #typingSettingsBar button:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
    @media (prefers-reduced-motion: reduce) { .typ-hero-glow { display: none; } }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @media print {
      header, footer, #typingSettingsBar, #restartBtn, .no-print {
        display: none !important;
      }
      #resultsWrap {
        display: block !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <a href="/id/permainan" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Permainan</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Kecepatan Mengetik</span>
    </nav>

    <!-- Header & Hero Section -->
    <header class="relative text-center max-w-3xl mx-auto mb-10">
      <div class="typ-hero-glow" aria-hidden="true"></div>
      <div class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Kadensi Psikomotorik • Fisika Kursor Halus • Audio Switch Mekanis</span>
      </div>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4">
        Tes Kecepatan Mengetik (WPM) Online
      </h1>
      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto">
        Uji kecepatan mengetik, Net WPM, akurasi, dan konsistensi ketukan jari Anda. Dilengkapi audio sakelar mekanis, analisis grafik sparkline langsung, dan peta panas kesalahan jari.
      </p>
    </header>

    <!-- TOP SETTINGS & MODE TOOLBAR -->
    <section id="typingSettingsBar" class="max-w-4xl mx-auto mb-8 p-3 rounded-2xl bg-zinc-50 dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 text-[13px] font-mono shadow-xs">
      <!-- Mode Tabs (Waktu vs Kata) -->
      <div class="flex items-center gap-1 bg-zinc-200/60 dark:bg-zinc-800/60 p-1 rounded-xl">
        <button
          type="button"
          data-mode="time"
          class="mode-btn active px-3.5 py-1.5 rounded-lg font-bold transition-all cursor-pointer bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/40"
        >
          ⏱️ Waktu
        </button>
        <button
          type="button"
          data-mode="words"
          class="mode-btn px-3.5 py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer"
        >
          📝 Kata
        </button>
      </div>

      <!-- Pilihan Waktu (15, 30, 60, 120 detik) -->
      <div id="timeOptionsGroup" class="flex items-center gap-2">
        <span class="text-zinc-400 hidden sm:inline">Detik:</span>
        <button type="button" data-time="15" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">15</button>
        <button type="button" data-time="30" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">30</button>
        <button type="button" data-time="60" class="time-opt-btn active px-2.5 py-1 rounded-md text-blue-500 font-bold transition-colors cursor-pointer">60</button>
        <button type="button" data-time="120" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">120</button>
      </div>

      <!-- Pilihan Kata (25, 50, 100) -->
      <div id="wordOptionsGroup" class="hidden flex items-center gap-2">
        <span class="text-zinc-400 hidden sm:inline">Kata:</span>
        <button type="button" data-words="25" class="word-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">25</button>
        <button type="button" data-words="50" class="word-opt-btn active px-2.5 py-1 rounded-md text-blue-500 font-bold transition-colors cursor-pointer">50</button>
        <button type="button" data-words="100" class="word-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">100</button>
      </div>

      <!-- Sakelar Tanda Baca & Angka -->
      <div class="flex items-center gap-2">
        <button id="togglePunctuation" type="button" class="px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">
          @ Tanda Baca
        </button>
        <button id="toggleNumbers" type="button" class="px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">
          # Angka
        </button>
      </div>

      <!-- Pemilih Audio Switch Mekanis -->
      <div class="flex items-center gap-2">
        <span class="text-zinc-400">🔊 Suara:</span>
        <select
          id="soundSelect"
          class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-lg px-2 py-1 text-zinc-800 dark:text-zinc-200 focus:outline-none focus:border-blue-500 cursor-pointer"
        >
          <option value="blue">Cherry MX Blue (Klik Nyaring)</option>
          <option value="brown">Cherry MX Brown (Taktil Mantap)</option>
          <option value="red">Cherry MX Red (Linier Halus)</option>
          <option value="mute">Hening (Mute)</option>
        </select>
      </div>
    </section>

    <!-- INTERACTIVE TYPING ARENA -->
    <section class="relative w-full max-w-4xl mx-auto mb-16">
      
      <!-- ARENA CARD -->
      <div id="typingArena" class="relative w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl transition-all cursor-text select-none">
        
        <!-- Live HUD Status -->
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-6 font-mono">
          <div class="flex items-center gap-6">
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">Sisa Waktu</div>
              <div id="hudTimer" class="font-heading font-extrabold text-2xl sm:text-3xl text-[#0066cc] dark:text-[#2997ff]">60s</div>
            </div>
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">WPM Langsung</div>
              <div id="hudWpm" class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-900 dark:text-white">0</div>
            </div>
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">Akurasi</div>
              <div id="hudAccuracy" class="font-heading font-extrabold text-2xl sm:text-3xl text-emerald-600 dark:text-emerald-400">100%</div>
            </div>
          </div>

          <!-- Restart Button & Shortcut Hint -->
          <div class="flex items-center gap-3">
            <button
              id="restartBtn"
              type="button"
              class="p-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500/10 hover:text-blue-500 text-zinc-500 dark:text-zinc-400 transition-all cursor-pointer shadow-xs min-h-[44px] min-w-[44px] flex items-center justify-center"
              aria-label="Ulangi tes mengetik"
              title="Ulangi tes (Esc atau Tab)"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M1 4v6h6M23 20v-6h-6M20.49 9A9 9 0 005.64 5.64L1 10M3.51 15a9 9 0 0014.85 3.36L23 14" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Words Stream Display Box -->
        <div class="relative words-box">
          <div
            id="wordsWrapper"
            class="max-h-36 sm:max-h-44 overflow-hidden relative font-mono text-xl sm:text-2xl leading-loose sm:leading-loose text-zinc-400 dark:text-zinc-600 tracking-wide select-none"
          >
            <!-- Dynamically populated word spans -->
          </div>

          <!-- Smooth Caret Bar -->
          <div
            id="caret"
            class="absolute top-0 left-0 w-0.5 sm:w-[3px] h-7 sm:h-8 bg-[#0066cc] dark:bg-[#2997ff] rounded-full caret-blink pointer-events-none shadow-[0_0_8px_rgba(0,102,204,0.6)]"
          ></div>
        </div>

        <!-- Accessible Transparent Input for Desktop & Mobile IME Keyboards -->
        <input
          id="typingInput"
          type="text"
          class="absolute inset-0 opacity-0 w-full h-full cursor-text z-10"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Kolom input tes mengetik"
        />

        <!-- Click to focus prompt -->
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-[13px] font-mono text-zinc-400 dark:text-zinc-500">
          <span>Klik kotak ini atau langsung mulai mengetik</span>
          <span class="hidden sm:inline">Tekan <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">Tab</kbd> atau <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">Esc</kbd> untuk mengulang</span>
        </div>
      </div>

      <!-- RESULTS REPORT SECTION -->
      <div id="resultsWrap" class="hidden mt-8 space-y-8">
        
        <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl space-y-8">
          
          <!-- Result Hero Header -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-b border-zinc-100 dark:border-zinc-800/80 pb-8">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-[13px] font-mono font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wider mb-2">
                Hasil Tolok Ukur Psikomotorik
              </div>
              <h3 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-900 dark:text-white">
                Laporan Kecepatan Mengetik
              </h3>
            </div>
            
            <div class="flex items-center gap-3">
              <span id="resPercentile" class="px-4 py-2 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-600 dark:text-blue-400 font-mono font-bold text-sm">
                Top 10%
              </span>
              <span id="resTier" class="px-4 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white font-heading font-bold text-sm">
                Pengetik Mahir
              </span>
            </div>
          </div>

          <!-- Hero Metrics Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center col-span-2 sm:col-span-1">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Net WPM</div>
              <div class="font-heading font-black text-4xl sm:text-5xl text-[#0066cc] dark:text-[#2997ff]">
                <span id="resWpm">0</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Akurasi</div>
              <div class="font-heading font-extrabold text-2xl sm:text-3xl text-emerald-600 dark:text-emerald-400">
                <span id="resAccuracy">0%</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Raw WPM</div>
              <div class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-900 dark:text-white">
                <span id="resRawWpm">0</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Konsistensi</div>
              <div class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-900 dark:text-white">
                <span id="resConsistency">0%</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Karakter / Menit</div>
              <div class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-900 dark:text-white">
                <span id="resCpm">0</span>
              </div>
            </div>
          </div>

          <p id="resDesc" class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-3xl">
            --
          </p>

          <!-- Live WPM Sparkline Graph -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[13px] font-mono text-zinc-500 dark:text-zinc-400">
              <span>Linimasa Kecepatan WPM</span>
              <div class="flex items-center gap-4">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block"></span> Net WPM</span>
