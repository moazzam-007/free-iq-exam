---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Kuantitatif Online Gratis: 16 Soal Deret Angka (Gq) | FreeIQExam";
const description = "Uji kemampuan penalaran kuantitatif (Gq) dan induksi matematika Anda. 16 soal deret bilangan bertingkat dan pola relasional aljabar terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Penalaran Kuantitatif (Gq)",
    "description": "Penilaian kuantitatif 16 soal yang mengukur induksi deret matematika, pengenalan pola relasional, dan kecepatan deduksi numerik.",
    "url": "https://freeiqexam.com/id/tes-kuantitatif/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Kuantitatif",
        "item": "https://freeiqexam.com/id/tes-kuantitatif/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/quantitative-reasoning-test">
  <Header currentPath="/id/tes-kuantitatif" enPath="/quantitative-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Kuantitatif</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gq <span aria-hidden="true">&bull;</span> POLA MATEMATIKA INDUKTIF</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Penalaran Kuantitatif (Gq)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan Anda dalam menemukan pola relasional numerik tersembunyi, menyelesaikan deret bertingkat, dan memahami logika aljabar proporsional.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Deret &amp; Pola Numerik</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Struktur Relasional Induktif</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="quantitative"
      domainCode="Gq"
      domainTitle="Penalaran Kuantitatif"
      domainSubtitle="Induksi Deret Angka & Struktur Relasional"
      domainDescription="Penalaran Kuantitatif (Gq) mengukur kemampuan untuk bernalar secara induktif dan deduktif menggunakan konsep matematis serta mengenali relasi numerik bersarang."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-amber-600 to-orange-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />
  </main>

  <Footer />
</Layout>
