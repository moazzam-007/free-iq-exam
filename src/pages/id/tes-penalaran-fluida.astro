---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Fluida Online Gratis: 16 Soal Matriks IQ (Gf) | FreeIQExam";
const description = "Ikuti tes Penalaran Fluida (Gf) gratis secara online. 16 soal matriks progresif dan induksi pola yang terkalibrasi Teori Respons Butir 2PL. Penilaian instan.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Penalaran Fluida (Gf)",
    "description": "Penilaian inteligensi fluida non-verbal khusus 16 soal yang mengukur induksi aturan abstrak, penyelesaian matriks, dan logika transformasi topologis.",
    "url": "https://freeiqexam.com/id/tes-penalaran-fluida/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Penalaran Fluida",
        "item": "https://freeiqexam.com/id/tes-penalaran-fluida/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/fluid-reasoning-test">
  <Header currentPath="/id/tes-penalaran-fluida" enPath="/fluid-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Fluida</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gf <span aria-hidden="true">&bull;</span> BEBAS BIAS BUDAYA</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Penalaran Fluida (Gf)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kapasitas pemecahan masalah baru, induksi aturan matriks abstrak, dan logika topologis Anda. Pilih antara tes terstandardisasi 15 menit atau latihan tanpa batas waktu dengan penjelasan langkah demi langkah.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Matriks Progresif</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Pengatur Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Stimulus Bebas Bahasa</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="fluid"
      domainCode="Gf"
      domainTitle="Penalaran Fluida"
      domainSubtitle="Induksi Aturan Matriks Abstrak & Logika Topologis"
      domainDescription="Penalaran Fluida (Gf) mencerminkan kapasitas untuk bernalar dan menyelesaikan masalah baru secara independen dari pendidikan formal. Dalam penelitian psikometri, Gf menunjukkan korelasi tertinggi dengan faktor umum kecerdasan (faktor g)."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Memahami Penalaran Fluida dalam Kerangka Kognitif CHC
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          Kecerdasan fluida, pertama kali diformalkan oleh Raymond Cattell dan kemudian disempurnakan oleh John Horn dan John Carroll, merepresentasikan kekuatan mental fundamental untuk mengenali pola, mengekstrapolasi aturan, dan menyelesaikan tantangan asing. Berbeda dengan inteligensi kristalisasi (Gc), penalaran fluida tidak bergantung pada kosakata atau instruksi akademik sebelumnya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Induksi Matriks
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mengurai grid 2x2 dan 3x3 dengan memindai baris horizontal dan kolom vertikal untuk mengisolasi aturan transformasi visual independen.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Deret Topologis
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mengikuti algoritma progresi seperti pergeseran posisi, laju orbit searah atau berlawanan jarum jam, dan logika bayangan bergantian.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Kombinasi Fitur Boolean
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Matriks tingkat lanjut memakai operasi logis XOR (exclusive OR) di mana garis tumpang tindih saling membatalkan antar sel matriks berurutan.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Strategi Taktis untuk Skor Matriks Tinggi
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Urai fitur secara terpisah:</strong> Perhatikan bentuk, ukuran, rotasi, jumlah elemen, dan warna sebagai variabel independen, bukan mencoba memahami keseluruhan gambar sekaligus.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Verifikasi baris dan kolom:</strong> Pada matriks progresif autentik, aturan valid berlaku konsisten pada baris horizontal dan terverifikasi menurun melalui kolom vertikal.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Waspadai jebakan distraktor:</strong> Butir sulit menampilkan distraktor dengan aturan tak lengkap atau ketertarikan fitur (opsi yang tampak intuitif tetapi gagal pada satu batasan sekunder).</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Jelajahi Baterai Kognitif Khusus Lainnya
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/id/tes-spasial"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Visual-Spasial (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Rotasi Mental 3D &rarr;</div>
          </a>
          <a
            href="/id/tes-kuantitatif"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Kuantitatif (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Puzzle Logika Aritmetika &rarr;</div>
          </a>
          <a
            href="/id/tes-verbal"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Pemahaman Verbal (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Silogisme Deduktif &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
