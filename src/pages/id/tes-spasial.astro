---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Spasial Online Gratis: 16 Soal Rotasi 3D (Gv) | FreeIQExam";
const description = "Uji kemampuan visual-spasial (Gv) Anda secara online. 16 soal rotasi mental 3D, sintesis pola lipatan kubus, dan proyeksi ortografis terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Visual-Spasial (Gv)",
    "description": "Penilaian visual-spasial 16 soal yang mengukur rotasi mental 3D, sintesis jaring permukaan lipatan, dan proyeksi isometrik.",
    "url": "https://freeiqexam.com/id/tes-spasial/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Spasial",
        "item": "https://freeiqexam.com/id/tes-spasial/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/spatial-reasoning-test">
  <Header currentPath="/id/tes-spasial" enPath="/spatial-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Spasial</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gv <span aria-hidden="true">&bull;</span> MANIPULASI OBJEK 3D</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Pemrosesan Visual-Spasial (Gv)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan Anda dalam memanipulasi, memutar secara mental, dan membayangkan transformasi bentuk 2D ke 3D di bawah kerangka kerja Teori Respons Butir 2PL.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Rotasi Spasial 3D</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Sintesis Lipatan Jaring</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="spatial"
      domainCode="Gv"
      domainTitle="Pemrosesan Visual-Spasial"
      domainSubtitle="Rotasi Mental 3D & Sintesis Jaring Lipatan"
      domainDescription="Pemrosesan Visual-Spasial (Gv) mengukur kemampuan menghasilkan, menyimpan, mengingat kembali, dan mengubah representasi visual objek secara mental dalam ruang tiga dimensi."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-sky-600 to-blue-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Neurosains Kognitif Pemrosesan Visual-Spasial (Gv)
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          Dipionirkan oleh Roger Shepard dan Jacqueline Metzler dalam eksperimen rotasi mental tonggak 1971, kognisi spasial melibatkan simulasi transformasi objek fisik dalam memori kerja. Dalam taksonomi Cattell-Horn-Carroll, Gv mencakup rotasi mental (Vz), relasi spasial (SR), dan visualisasi (Vz).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Rotasi Kubus Isometrik 3D
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Memutar benda padat 3 dimensi sepanjang sumbu X, Y, atau Z untuk menentukan apakah sudut alternatif merepresentasikan objek identik atau refleksi kiral yang mustahil.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Jaring Lipatan Permukaan
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Melipat jaring datar silang atau bentuk T menjadi kubus 3D 6 sisi. Menuntut pelacakan sisi berpola mana yang bersebelahan versus berlawanan.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Perspektif Ortografis
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mensintesis beberapa tampilan 2D (tampak atas, tampak depan, profil lateral) untuk merekonstruksi geometri blok 3D komposit yang benar.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Aturan Taktis untuk Puzzle Jaring Lipatan 3D
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Aturan Sisi Berlawanan:</strong> Pada jaring kubus datar 2D standar, sisi yang dipisahkan tepat satu kotak dalam garis lurus selalu berlawanan saat dilipat menjadi kubus. Sisi berlawanan tidak pernah terlihat bersamaan dari sudut pandang mana pun.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Jangkar Satu Sisi:</strong> Pilih sisi paling khas atau asimetris sebagai jangkar acuan, lalu lipat sisi-sisi bersebelahan relatif terhadapnya.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Verifikasi Triad Sudut:</strong> Periksa 3 sisi yang bertemu pada verteks terlihat mana pun. Perhatikan penunjuk arah (panah, garis diagonal) yang mengarah ke atau menjauhi sudut bersama tersebut.</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Jelajahi Baterai Kognitif Khusus Lainnya
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/id/tes-penalaran-fluida"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Penalaran Fluida (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Induksi Matriks &rarr;</div>
          </a>
          <a
            href="/id/tes-kuantitatif"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Kuantitatif (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Puzzle Logika Aritmetika &rarr;</div>
          </a>
          <a
            href="/id/tes-verbal"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Pemahaman Verbal (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Silogisme Deduktif &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
