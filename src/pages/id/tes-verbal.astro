---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Verbal Online Gratis: 16 Soal Silogisme & Analogi (Gc) | FreeIQExam";
const description = "Uji kemampuan pemahaman verbal (Gc) dan silogisme deduktif logis Anda. 16 soal analogi kata dan logika formal terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Pemahaman Verbal (Gc)",
    "description": "Penilaian logika verbal 16 soal yang mengukur penalaran silogisme deduktif, analogi hubungan semantik, dan abstraksi bahasa.",
    "url": "https://freeiqexam.com/id/tes-verbal/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Verbal",
        "item": "https://freeiqexam.com/id/tes-verbal/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/verbal-reasoning-test">
  <Header currentPath="/id/tes-verbal" enPath="/verbal-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Verbal</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gc <span aria-hidden="true">&bull;</span> SILOGISME DEDUKTIF</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Pemahaman Verbal &amp; Logika (Gc)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan deduksi logika formal, validitas premis silogisme kategoris, dan pemahaman analogi hubungan semantik abstrak.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Silogisme &amp; Analogi</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Deduksi Logis Formal</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="verbal"
      domainCode="Gc"
      domainTitle="Pemahaman Verbal"
      domainSubtitle="Silogisme Deduktif & Analogi Hubungan Semantik"
      domainDescription="Pemahaman Verbal (Gc) mengukur kedalaman pengetahuan sistem bahasa, relasi semantik abstrak, dan kemampuan menarik kesimpulan logis formal dari premis yang diberikan."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-emerald-600 to-teal-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Fondasi Inteligensi Kristalisasi & Logika Verbal
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          Meski inteligensi kristalisasi mencakup bahasa dan pengetahuan budaya, tes psikometrik Gc terstandarisasi berfokus pada penalaran relasional dan deduksi formal, bukan hafalan kosakata superfisial. Individu harus memahami bagaimana konsep abstrak terhubung, berkontras, dan membentuk kebenaran logis yang niscaya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Analogi Relasional (A : B :: C : ?)
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Merumuskan relasi fungsional eksak antara pasangan kata primer (bagian-ke-keseluruhan, derajat intensitas, agen kausal, alat-ke-aksi) dan memetakannya ke pasangan target.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Silogisme Deduktif Formal
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mengevaluasi argumen dua premis untuk menentukan kesimpulan mana yang mengikuti dengan keniscayaan logis absolut, menahan dorongan mengandalkan bias keyakinan empiris.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Logika Inklusi Kategoris
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mengklasifikasikan konsep ke hierarki taksonomis dan mengidentifikasi istilah unik yang melanggar kriteria dasar halus (kategorisasi odd-one-out).
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Strategi Taktis untuk Silogisme Formal & Logika Verbal
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Abaikan Kebenaran Dunia Nyata:</strong> Silogisme harus diselesaikan sepenuhnya dalam semesta premis yang dinyatakan. Walau premis bertentangan dengan realitas empiris (mis. "Semua apel berwarna biru"), perlakukan sebagai 100% benar untuk lingkup deduksi.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Rumuskan Kalimat Jembatan Eksak untuk Analogi:</strong> Pada analogi (mis. Termometer : Suhu :: Barometer : ?), bangun kalimat presisi: "Termometer adalah instrumen untuk mengukur suhu; maka barometer adalah instrumen untuk mengukur tekanan atmosfer."</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Waspadai Jebakan "Sebagian":</strong> Dalam logika formal, "Sebagian" berarti "Minimal satu, dan mungkin semua." Ini TIDAK berarti "Sebagian tidak." Gambarkan himpunan tumpang tindih atau lingkaran Venn secara mental untuk mencegah lompatan kuantor invalid.</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Jelajahi Baterai Kognitif Khusus Lainnya
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/id/tes-penalaran-fluida"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Penalaran Fluida (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Induksi Matriks &rarr;</div>
          </a>
          <a
            href="/id/tes-spasial"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Visual-Spasial (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Rotasi Mental 3D &rarr;</div>
          </a>
          <a
            href="/id/tes-kuantitatif"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Kuantitatif (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Puzzle Logika Aritmetika &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
