---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';
import CategoryTestRunner from '../../components/id/CategoryTestRunnerId.astro';

const title = "Tes Penalaran Verbal Online Gratis: 16 Soal Silogisme & Analogi (Gc) | FreeIQExam";
const description = "Uji kemampuan pemahaman verbal (Gc) dan silogisme deduktif logis Anda. 16 soal analogi kata dan logika formal terkalibrasi IRT 2PL.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Tes Kemampuan Kognitif Pemahaman Verbal (Gc)",
    "description": "Penilaian logika verbal 16 soal yang mengukur penalaran silogisme deduktif, analogi hubungan semantik, dan abstraksi bahasa.",
    "url": "https://freeiqexam.com/id/tes-verbal/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://freeiqexam.com/id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tes Verbal",
        "item": "https://freeiqexam.com/id/tes-verbal/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/verbal-reasoning-test">
  <Header currentPath="/id/tes-verbal" enPath="/verbal-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/id" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Tes Penalaran Verbal</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>FAKTOR KOGNITIF CHC: Gc <span aria-hidden="true">&bull;</span> SILOGISME DEDUKTIF</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Penilaian Pemahaman Verbal &amp; Logika (Gc)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Evaluasi kemampuan deduksi logika formal, validitas premis silogisme kategoris, dan pemahaman analogi hubungan semantik abstrak.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Butir Soal Silogisme &amp; Analogi</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Batas Waktu 15 Menit</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Deduksi Logis Formal</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Kalibrasi IRT 2PL</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="verbal"
      domainCode="Gc"
      domainTitle="Pemahaman Verbal"
      domainSubtitle="Silogisme Deduktif & Analogi Hubungan Semantik"
      domainDescription="Pemahaman Verbal (Gc) mengukur kedalaman pengetahuan sistem bahasa, relasi semantik abstrak, dan kemampuan menarik kesimpulan logis formal dari premis yang diberikan."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-emerald-600 to-teal-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />
  </main>

  <Footer />
</Layout>
