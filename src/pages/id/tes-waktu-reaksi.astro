---
import Layout from '../../components/id/LayoutId.astro';
import Header from '../../components/id/HeaderId.astro';
import Footer from '../../components/id/FooterId.astro';

const title = "Reaction Time Test: Tes Kecepatan Refleks Visual Online | FreeIQExam";
const description =
  "Uji waktu reaksi visual dan kecepatan respons motorik Anda dalam milidetik. Bandingkan skor refleks Anda dengan tolok ukur populasi rata-rata.";
const canonicalUrl = 'https://freeiqexam.com/id/tes-waktu-reaksi';

const alternates: Record<string, string> = {
  en: 'https://freeiqexam.com/reaction-time-test',
  id: 'https://freeiqexam.com/id/tes-waktu-reaksi'
};

const faqItems = [
  {
    name: 'Berapa skor waktu reaksi yang dianggap bagus pada tes online?',
    answer:
      'Untuk tugas reaksi visual sederhana, mayoritas orang dewasa sehat berada di rentang 200–270 milidetik (ms). Pada FreeIQExam, skor di bawah 220 ms diklasifikasikan lebih cepat daripada median populasi umum, sedangkan atlet e-sports profesional atau pembalap sering mencapai 160–190 ms.'
  },
  {
    name: 'Mengapa waktu reaksi saya lebih lambat di smartphone dibanding di PC desktop?',
    answer:
      'Layar sentuh ponsel menambahkan latensi pemrosesan melalui sampling digitizer layar sentuh, filter sentuhan OS, dan siklus refresh layar (biasanya menambah latensi 30–60 ms). Komputer desktop dengan monitor refresh rate tinggi (144Hz+) dan mouse kabel memiliki jalur input yang jauh lebih cepat dan minim latensi.'
  },
  {
    name: 'Berapa batas biologis tercepat kecepatan reaksi manusia?',
    answer:
      'Batas biologis fisiologis murni untuk reaksi visual berkisar antara 140–160 ms karena adanya waktu fototransduksi di retina (20–40 ms), transmisi saraf optik ke korteks visual (30–50 ms), keputusan motorik di korteks serebral (40–60 ms), dan konduksi saraf ke otot jari (20–30 ms).'
  },
  {
    name: 'Mengapa manusia bereaksi lebih cepat terhadap suara daripada cahaya?',
    answer:
      'Sistem pendengaran bekerja melalui transduksi mekanis langsung di sel rambut koklea yang memicu impuls saraf dalam hitungan 1–2 milidetik. Sebaliknya, sistem visual memerlukan reaksi fotokimiawi bertingkat (fototransduksi) di sel fotoreseptor retina sebelum sinyal dapat dikirim ke saraf optik, memakan waktu lebih lama.'
  },
  {
    name: 'Seberapa besar pengaruh monitor gaming 144Hz atau 240Hz terhadap skor reaksi?',
    answer:
      'Monitor 60Hz memperbarui gambar setiap 16,67 ms, monitor 144Hz setiap 6,94 ms, dan monitor 240Hz setiap 4,17 ms. Refresh rate yang lebih tinggi mengurangi jeda tampilan antara stimulus hijau dan mata Anda, memberikan keuntungan beberapa milidetik pada skor akhir.'
  },
  {
    name: 'Berapa waktu reaksi normal untuk orang berusia 50 tahun ke atas?',
    answer:
      'Seiring bertambahnya usia, kecepatan transmisi saraf dan pemrosesan informasi visual melambat secara bertahap sekitar 2–6 ms per dekade setelah usia 25 tahun. Waktu reaksi 270–320 ms sangat wajar dan normal untuk usia 50 tahun ke atas.'
  },
  {
    name: 'Bisakah waktu reaksi visual dilatih dan ditingkatkan secara permanen?',
    answer:
      'Ya. Latihan refleks teratur, permainan aksi cepat, kualitas tidur yang cukup (7–9 jam), olahraga aerobik, dan menjaga fokus pandangan lembut (soft focus) dapat meningkatkan kecepatan reaksi sebesar 10–30 ms dengan mengoptimalkan kesiapan motorik (motor priming).'
  },
  {
    name: 'Mengapa tes ini menggunakan rata-rata dari 5 ronde?',
    answer:
      'Pengukuran tunggal sangat rentan terhadap fluktuasi fokus sesaat atau ketidaksengajaan. Mengambil rata-rata dari 5 ronde valid meredam kebisingan acak dan memberikan estimasi performa refleks yang stabil dan reliabel.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'FreeIQExam Tes Waktu Reaksi Visual Online',
    url: canonicalUrl,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    browserRequirements:
      'Memerlukan dukungan JavaScript, Performance API, Pointer Events, dan HTML5',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    description:
      'Tolok ukur waktu reaksi visual 5 ronde berbasis peramban yang menghitung kecepatan respons milidetik dan estimasi persentil populasi.',
    isAccessibleForFree: true,
    creator: {
      '@type': 'Organization',
      name: 'FreeIQExam',
      url: 'https://freeiqexam.com'
    },
    featureList: [
      '5 ronde tes reaksi visual terkalibrasi',
      'Dukungan input klik pointer dan tombol keyboard (Spasi/Enter)',
      'Penyimpanan rekor terbaik lokal di peramban',
      'Estimasi persentil populasi berbasis model Gaussian',
      'Efek suara audio sintetis opsional',
      'Berbagi skor ke papan klip instan'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Beranda',
        item: 'https://freeiqexam.com/id'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Permainan Kognitif',
        item: 'https://freeiqexam.com/id/permainan'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Tes Waktu Reaksi',
        item: canonicalUrl
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Tolok Ukur Waktu Reaksi Visual 5 Ronde',
    url: canonicalUrl,
    description:
      'Tugas reaksi visual sederhana di mana peserta merespons sesegera mungkin saat arena berubah dari merah menjadi hijau.',
    numberOfQuestions: 5,
    educationalAlignment: {
      '@type': 'AlignmentObject',
      alignmentType: 'educationalSubject',
      targetName: 'Kecepatan persepsi dan latensi sensorimotor'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.name,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <style>
    .reaction-page {
      --reaction-border: #e4e4e7;
      --reaction-muted: #52525b;
      background: #ffffff;
    }

    :global(.dark) .reaction-page {
      --reaction-border: #27272a;
      --reaction-muted: #a1a1aa;
      background: #000000;
    }

    .reaction-arena {
      touch-action: manipulation;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
      transition:
        transform 90ms ease-out,
        background 120ms ease-out;
    }

    .reaction-arena:active {
      transform: scale(0.997);
    }

    .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #2563eb 0%,
          #1d4ed8 62%,
          #1e40af 100%
        );
    }

    :global(.dark) .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #1d4ed8 0%,
          #0f172a 70%,
          #09090b 100%
        );
    }

    .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #e11d48 0%,
          #be123c 62%,
          #9f1239 100%
        );
    }

    :global(.dark) .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #be123c 0%,
          #881337 68%,
          #4c0519 100%
        );
    }

    .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #059669 62%,
          #047857 100%
        );
    }

    :global(.dark) .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #047857 68%,
          #064e3b 100%
        );
    }

    .state-toosoon {
      background:
        radial-gradient(
          circle at 50% 25%,
          #f97316 0%,
          #ea580c 65%,
          #c2410c 100%
        );
    }

    :global(.dark) .state-toosoon {
      background:
        radial-gradient(
          circle at 50% 25%,
          #ea580c 0%,
          #9a3412 70%,
          #431407 100%
        );
    }

    .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #0284c7 0%,
          #0369a1 62%,
          #075985 100%
        );
    }

    :global(.dark) .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #0284c7 0%,
          #082f49 70%,
          #09090b 100%
        );
    }

    .state-summary {
      background:
        radial-gradient(
          circle at 50% 15%,
          #f4f4f5 0%,
          #e4e4e7 65%,
          #d4d4d8 100%
        );
    }

    :global(.dark) .state-summary {
      background:
        radial-gradient(
          circle at 50% 20%,
          #18181b 0%,
          #09090b 70%,
          #000000 100%
        );
    }

    .summary-card {
      background: #ffffff;
      border: 1px solid #e4e4e7;
    }

    :global(.dark) .summary-card {
      background: #121215;
      border: 1px solid #27272a;
    }

    .rx-hero-glow {
      position: absolute;
      inset-inline: -1rem;
      top: -2rem;
      height: 24rem;
      pointer-events: none;
      background: radial-gradient(
        circle at 50% 10%,
        rgba(0, 102, 204, 0.1) 0%,
        rgba(0, 102, 204, 0.03) 45%,
        transparent 70%
      );
      mask-image: linear-gradient(to bottom, black 55%, transparent 92%);
      -webkit-mask-image: linear-gradient(
        to bottom,
        black 55%,
        transparent 92%
      );
    }

    :global(.dark) .rx-hero-glow {
      background: radial-gradient(
        circle at 50% 10%,
        rgba(41, 151, 255, 0.12) 0%,
        rgba(0, 102, 204, 0.04) 45%,
        transparent 70%
      );
    }

    @keyframes rxShake {
      0%,
      100% {
        transform: translateX(0);
      }
      20%,
      60% {
        transform: translateX(-6px);
      }
      40%,
      80% {
        transform: translateX(6px);
      }
    }

    .animate-reaction-shake {
      animation: rxShake 0.35s ease-in-out;
    }

    @media (prefers-reduced-motion: reduce) {
      .rx-hero-glow,
      .animate-reaction-shake {
        animation: none !important;
        display: none;
      }
    }
  </style>

  <main class="reaction-page flex-1 text-zinc-900 dark:text-zinc-100">
    <div
      class="max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
    >
      <!-- Breadcrumb -->
      <nav
        class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8"
        aria-label="Breadcrumb"
      >
        <a
          href="/id"
          class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors"
        >
          Beranda
        </a>

        <span class="mx-2 text-zinc-400 dark:text-zinc-600">
          /
        </span>

        <a
          href="/id/permainan"
          class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors"
        >
          Permainan
        </a>

        <span class="mx-2 text-zinc-400 dark:text-zinc-600">
          /
        </span>

        <span class="text-zinc-900 dark:text-zinc-100 font-semibold">
          Tes Waktu Reaksi
        </span>
      </nav>

      <!-- Hero Header -->
      <header class="relative text-center max-w-3xl mx-auto mb-10">
        <div class="rx-hero-glow" aria-hidden="true"></div>

        <div
          class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs"
        >
          <span
            class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"
          ></span>

          <span>Tolok Ukur Milidetik Presisi • 5 Ronde Terkalibrasi</span>
        </div>

        <h1
          class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4"
        >
          Tes Waktu Reaksi Visual Online
        </h1>

        <p
          class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto"
        >
          Ukur kecepatan refleks sensorimotor Anda dalam satuan milidetik (ms). Klik segera saat layar berubah warna dari merah menjadi hijau.
        </p>
      </header>

      <!-- Arena Section -->
      <section
        id="reaction-test-arena"
        class="relative max-w-3xl mx-auto"
        aria-label="Area Pengujian Waktu Reaksi"
      >
        <!-- Telemetry Header HUD -->
        <div
          class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm font-mono"
        >
          <div class="flex items-center gap-2">
            <span
              id="hud-trial-label"
              class="rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-3.5 py-1.5 font-bold text-zinc-900 dark:text-zinc-100"
            >
              Ronde 1 dari 5
            </span>
          </div>

          <div class="flex items-center gap-3">
            <div
              class="flex items-center gap-2 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-4 py-1.5 text-zinc-700 dark:text-zinc-300"
            >
              <span class="text-xs uppercase tracking-wider text-zinc-500">
                TERBAIK
              </span>

              <strong
                id="hud-personal-best"
                class="text-emerald-600 dark:text-emerald-400"
              >
                -
              </strong>
            </div>

            <button
              id="btn-sound-toggle"
              type="button"
              aria-pressed="false"
              aria-label="Matikan efek suara audio"
              class="inline-flex items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-2.5 font-semibold text-zinc-800 dark:text-zinc-200 transition-smooth active:scale-[0.97] min-h-[44px] cursor-pointer"
            >
              <span id="sound-icon" aria-hidden="true">
                🔊
              </span>

              <span id="sound-label">
                Audio
              </span>
            </button>
          </div>
        </div>

        <!-- Trial Progress Pills -->
        <div
          class="mb-4 flex items-center gap-2"
          aria-label="Kemajuan ronde"
        >
          <span
            id="pill-trial-1"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-2"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-3"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-4"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-5"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>
        </div>

        <!-- Interactive Box -->
        <div
          id="reaction-box"
          role="button"
          tabindex="0"
          aria-label="Arena tes waktu reaksi. Klik atau ketuk saat layar berubah hijau."
          aria-busy="false"
          class="reaction-arena state-start relative min-h-[430px] sm:min-h-[500px] rounded-[2rem] overflow-hidden cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/40 shadow-2xl"
        >
          <div
            class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_18%,rgba(255,255,255,.18),transparent_34%),radial-gradient(circle_at_50%_100%,rgba(0,0,0,.16),transparent_60%)]"
          ></div>

          <!-- 1. Start View -->
          <div
            id="content-start"
            class="relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg"
            >
              <svg
                class="w-10 h-10 sm:w-12 sm:h-12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
            </div>

            <div class="space-y-3 max-w-xl">
              <h3
                class="text-3xl sm:text-5xl font-extrabold tracking-tight"
              >
                Klik atau Ketuk untuk Mulai
              </h3>

              <p
                class="text-base sm:text-lg leading-relaxed text-white/90"
              >
                Tunggu warna hijau. Lalu klik secepat mungkin. Percobaan sebelum hijau tidak akan dihitung dalam 5 ronde resmi.
              </p>
            </div>

            <div
              class="inline-flex flex-wrap items-center justify-center gap-2 rounded-full bg-white/15 border border-white/20 px-5 py-3 text-sm font-semibold font-mono"
            >
              <span>Keyboard:</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                SPASI
              </kbd>

              <span>atau</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                ENTER
              </kbd>
            </div>
          </div>

          <!-- 2. Waiting (Red) -->
          <div
            id="content-waiting"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="flex items-center gap-3"
              aria-hidden="true"
            >
              <span
                class="w-4 h-4 rounded-full bg-white animate-ping"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:150ms]"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:300ms]"
              ></span>
            </div>

            <div>
              <h3
                class="text-4xl sm:text-6xl font-extrabold tracking-tight uppercase"
              >
                Tunggu Warna Hijau…
              </h3>

              <p
                class="mt-3 text-base sm:text-lg text-white/85"
              >
                Jangan menebak. Siapkan jari Anda, tetapi jangan ditekan dahulu.
              </p>
            </div>
          </div>

          <!-- 3. Active (Green) -->
          <div
            id="content-active"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="w-20 h-20 rounded-full bg-white/25 border border-white/30 flex items-center justify-center shadow-2xl"
            >
              <svg
                class="w-12 h-12"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>

            <div>
              <h3
                class="text-5xl sm:text-7xl font-extrabold tracking-tight uppercase"
              >
                KLIK SEKARANG!
              </h3>

              <p
                class="mt-3 text-sm sm:text-base font-semibold uppercase tracking-widest text-white/90"
              >
                Ketuk Layar, Klik, Spasi, atau Enter
              </p>
            </div>
          </div>

          <!-- 4. Too Soon (Orange) -->
          <div
            id="content-toosoon"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-5 px-6 sm:px-10 text-center text-white animate-reaction-shake"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center"
            >
              <svg
                class="w-10 h-10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3.732 1.732 3z"
                />
              </svg>
            </div>

            <h3
              class="text-4xl sm:text-5xl font-extrabold tracking-tight"
            >
              Terlalu Cepat!
            </h3>

            <p
              class="text-base sm:text-lg text-white/90 max-w-xl"
            >
              Anda mengklik saat arena masih merah. Percobaan ini dibatalkan dan ronde ini akan diulang.
            </p>

            <span
              class="rounded-full bg-white px-6 py-3 font-bold text-orange-700 shadow-xl"
            >
              Ketuk untuk Mengulang
            </span>
          </div>

          <!-- 5. Round Result -->
          <div
            id="content-result"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-5 px-6 sm:px-10 text-center text-white"
          >
            <span
              id="result-round-indicator"
              class="rounded-full bg-white/20 px-4 py-2 text-sm font-semibold uppercase tracking-wider font-mono"
            >
              RONDE 1 DARI 5
            </span>

            <div class="flex items-baseline gap-2">
              <span
                id="round-ms-display"
