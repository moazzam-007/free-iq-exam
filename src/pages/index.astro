<!-- Client Side Interactive Scripts (Theme Toggle & Demo Puzzle Feedback) -->
<script is:inline>
  // Theme Toggle Functionality
  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  // Interactive Demo Puzzle Choice Handling
  const optionButtons = document.querySelectorAll('.option-btn');
  const feedbackBox = document.getElementById('demo-feedback');

  optionButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isCorrect = btn.getAttribute('data-correct') === 'true';
      const optionLabel = btn.getAttribute('data-option');

      // Reset all buttons
      optionButtons.forEach((b) => {
        b.classList.remove('border-emerald-500', 'bg-emerald-50/50', 'dark:bg-emerald-950/40', 'border-red-500', 'bg-red-50/50', 'dark:bg-red-950/40');
      });

      if (isCorrect) {
        btn.classList.add('border-emerald-500', 'bg-emerald-50/50', 'dark:bg-emerald-950/40');
        if (feedbackBox) {
          feedbackBox.innerHTML = `
            <div class="text-base font-bold text-emerald-600 dark:text-emerald-400 mb-1">✓ Correct! Option ${optionLabel} is the exact solution.</div>
            <div class="text-sm text-zinc-600 dark:text-zinc-300">Rule: In each horizontal row, shape count increases (1 → 2 → 3) with identical geometry and color. Third row requires 3 purple triangles.</div>
          `;
          feedbackBox.className = "mt-6 p-5 rounded-2xl bg-emerald-50/60 dark:bg-emerald-950/30 border border-emerald-300 dark:border-emerald-800 text-center transition-all";
        }
      } else {
        btn.classList.add('border-red-500', 'bg-red-50/50', 'dark:bg-red-950/40');
        if (feedbackBox) {
          feedbackBox.innerHTML = `
            <div class="text-base font-bold text-red-600 dark:text-red-400 mb-1">✗ Option ${optionLabel} is not correct.</div>
            <div class="text-sm text-zinc-600 dark:text-zinc-300">Hint: Count the number of symbols in each row from left to right. Try again!</div>
          `;
          feedbackBox.className = "mt-6 p-5 rounded-2xl bg-red-50/60 dark:bg-red-950/30 border border-red-300 dark:border-red-800 text-center transition-all";
        }
      }
    });
  });
</script>
