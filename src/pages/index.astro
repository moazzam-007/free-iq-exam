---
import Layout from '../layouts/Layout.astro';

const title = "Free IQ Test 2026: Instant Results, No Email Required | FreeIQExam.com";
const description = "Take our standardized 24-item reasoning assessment. Get your estimated IQ-scale score (SD 15) and percentile rank instantly. 100% free, no email, no subscription traps.";
---

<Layout title={title} description={description}>
  <!-- Main Navigation Header (Apple Cleanliness + Pristine White Canvas) -->
  <header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200/80 dark:border-zinc-800 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-600 flex items-center justify-center text-white font-bold text-xl shadow-sm group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-xl tracking-tight text-zinc-950 dark:text-white leading-tight">
            FreeIQ<span class="text-blue-600 dark:text-blue-400">Exam</span>
          </span>
          <span class="text-xs font-mono font-medium tracking-widest text-zinc-500 uppercase">Scientific Norms</span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Spacious Apple Style) -->
      <nav class="hidden md:flex items-center gap-9 text-base font-medium text-zinc-600 dark:text-zinc-400">
        <a href="#demo-puzzle" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Sample Question</a>
        <a href="#features" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Scientific Method</a>
        <a href="#faq" class="hover:text-zinc-950 dark:hover:text-white transition-colors">FAQ</a>
      </nav>

      <!-- Right Actions (Theme Toggle + Apple Tactile Pill Button) -->
      <div class="flex items-center gap-4">
        <!-- Theme Toggle Button -->
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="w-10 h-10 rounded-full flex items-center justify-center border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 shadow-xs transition-colors">
          <svg id="theme-icon-sun" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="theme-icon-moon" class="w-5 h-5 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Apple-Style Primary Pill CTA -->
        <a href="#demo-puzzle" class="px-7 py-3 rounded-full text-base font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
          Start Test
        </a>
      </div>
    </div>
  </header>

  <main class="flex-1 bg-white dark:bg-black">
    <!-- HERO SECTION (Pure White Background + Monumental Apple Scale) -->
    <section class="relative pt-20 pb-24 md:pt-32 md:pb-36 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <!-- Vercel Eyebrow Badge (Pure White Surface) -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-mono text-zinc-700 dark:text-zinc-300 shadow-xs mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <span>STANDARDIZED 24-ITEM REASONING ASSESSMENT</span>
        </div>

        <!-- Monumental Display H1 -->
        <h1 class="font-heading font-extrabold text-5xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Measure Your Real IQ.<br />
          <span class="gradient-text">Instant, Accurate & Truly Free.</span>
        </h1>

        <!-- High-Legibility Subtitle (20px - 22px) -->
        <p class="text-xl sm:text-2xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto mb-12 leading-relaxed font-normal">
          Evaluate fluid reasoning through 24 progressive reasoning items across visual matrices, spatial rotation, and pattern induction. Get your standardized score estimate (SD 15) and percentile rank instantly, with <strong class="text-zinc-950 dark:text-white font-semibold">no email, no registration, and zero paywalls.</strong>
        </p>

        <!-- Large Tactile Action Button -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-14">
          <a href="#demo-puzzle" class="w-full sm:w-auto px-10 py-5 rounded-full text-lg font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3">
            <span>Start Free Test (20 Mins)</span>
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Clean 4-Bullet Trust Strip (16px Crisp Text) -->
        <div class="flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-base font-medium text-zinc-600 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Instant Results</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>No Email Needed</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Standardized SD 15</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Zero Paywalls</span>
          </div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE SAMPLE PUZZLE (Pure White Clean Background + Elevated Card) -->
    <section id="demo-puzzle" class="py-24 bg-white dark:bg-black border-t border-zinc-100 dark:border-zinc-900 transition-colors">
      <div class="max-w-5xl mx-auto px-6">
        <!-- Section Header -->
        <div class="text-center mb-14">
          <span class="text-sm font-mono font-semibold tracking-wider text-blue-600 dark:text-blue-400 uppercase">Interactive Sample</span>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-zinc-950 dark:text-white mt-2">
            Test Your Pattern Reasoning
          </h2>
          <p class="text-lg text-zinc-600 dark:text-zinc-400 mt-3">
            Which tile logically completes the 3×3 matrix? Click a solution below to test the interaction.
          </p>
        </div>

        <!-- The Elevated Puzzle Card (Pure White with Subtle Premium Shadow) -->
        <div class="bg-white dark:bg-zinc-950 rounded-3xl border border-zinc-200/90 dark:border-zinc-800 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.08)] overflow-hidden">
          <!-- Card Header Bar -->
          <div class="px-8 py-5 border-b border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-4 bg-white dark:bg-zinc-900/60">
            <div class="flex items-center gap-3">
              <span class="font-mono font-bold text-sm px-3 py-1 rounded-md bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                SAMPLE ITEM
              </span>
              <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Visual Pattern Progression</span>
            </div>
            <span class="text-sm font-mono text-zinc-500">Standard Pace: ~50 sec/item</span>
          </div>

          <!-- Puzzle Viewport + Interactive Choices -->
          <div class="p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-12">
            <!-- 3x3 Puzzle Display -->
            <div class="flex flex-col items-center">
              <div class="grid grid-cols-3 gap-3 p-4 bg-white dark:bg-zinc-900 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 w-72 h-72 sm:w-80 sm:h-80 shadow-sm">
                <!-- Cell 1: 1 Blue Dot -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-5 h-5 rounded-full bg-blue-600"></div>
                </div>
                <!-- Cell 2: 2 Blue Dots -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-4 h-4 rounded-full bg-blue-600"></div>
                  <div class="w-4 h-4 rounded-full bg-blue-600"></div>
                </div>
                <!-- Cell 3: 3 Blue Dots -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center gap-1 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                </div>

                <!-- Cell 4: 1 Indigo Square -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-5 h-5 rounded-xs bg-indigo-600"></div>
                </div>
                <!-- Cell 5: 2 Indigo Squares -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-4 h-4 rounded-xs bg-indigo-600"></div>
                  <div class="w-4 h-4 rounded-xs bg-indigo-600"></div>
                </div>
                <!-- Cell 6: 3 Indigo Squares -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center gap-1 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                </div>

                <!-- Cell 7: 1 Purple Triangle -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-0 h-0 border-l-[9px] border-l-transparent border-r-[9px] border-r-transparent border-b-[16px] border-b-purple-600"></div>
                </div>
                <!-- Cell 8: 2 Purple Triangles -->
                <div class="bg-zinc-50/50 dark:bg-black rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800 shadow-2xs">
                  <div class="w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-b-[13px] border-b-purple-600"></div>
                  <div class="w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-b-[13px] border-b-purple-600"></div>
                </div>
                <!-- Cell 9: TARGET ? -->
                <div class="bg-blue-50/70 dark:bg-blue-950/40 rounded-xl flex items-center justify-center border-2 border-dashed border-blue-500 animate-pulse">
                  <span class="font-heading font-black text-3xl text-blue-600 dark:text-blue-400">?</span>
                </div>
              </div>
            </div>

            <!-- Answer Buttons (Pure White with Crisp Borders) -->
            <div class="w-full md:w-1/2 flex flex-col">
              <div class="text-sm font-mono font-bold uppercase tracking-wider text-zinc-500 mb-4 text-center md:text-left">
                Select Solution (A - F):
              </div>

              <div id="option-container" class="grid grid-cols-3 gap-3.5">
                <!-- Option A -->
                <button type="button" data-option="A" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">A</span>
                  <div class="h-8 flex items-center justify-center gap-1">
                    <div class="w-3.5 h-3.5 rounded-full bg-purple-600"></div>
                    <div class="w-3.5 h-3.5 rounded-full bg-purple-600"></div>
                  </div>
                </button>

                <!-- Option B -->
                <button type="button" data-option="B" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">B</span>
                  <div class="h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                  </div>
                </button>

                <!-- Option C (Correct Answer) -->
                <button type="button" data-option="C" data-correct="true" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">C</span>
                  <div class="h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                  </div>
                </button>

                <!-- Option D -->
                <button type="button" data-option="D" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">D</span>
                  <div class="h-8 flex items-center justify-center gap-1">
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                  </div>
                </button>

                <!-- Option E -->
                <button type="button" data-option="E" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">E</span>
                  <div class="h-8 flex items-center justify-center">
                    <div class="w-4 h-4 bg-purple-600"></div>
                  </div>
                </button>

                <!-- Option F -->
                <button type="button" data-option="F" class="option-btn p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-white dark:bg-zinc-900 shadow-2xs flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-sm font-bold text-zinc-400">F</span>
                  <div class="h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-blue-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-blue-600"></div>
                  </div>
                </button>
              </div>

              <!-- Interactive Feedback Message (White Surface) -->
              <div id="demo-feedback" class="mt-6 p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center shadow-2xs transition-all">
                Click any option above to verify your solution.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SCIENTIFIC PILLARS (Pristine White Cards with Apple Depth) -->
    <section id="features" class="py-24 max-w-6xl mx-auto px-6 bg-white dark:bg-black border-t border-zinc-100 dark:border-zinc-900">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-sm font-mono font-semibold tracking-wider text-blue-600 dark:text-blue-400 uppercase">Methodology</span>
        <h2 class="font-heading font-bold text-3xl sm:text-5xl text-zinc-950 dark:text-white mt-2 tracking-tight">
          How Your IQ is Calibrated
        </h2>
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 mt-4 leading-relaxed">
          Standardized against modern population parameters using Item Response Theory.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-950 border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/50 transition-all hover:translate-y-[-2px] shadow-[0_4px_25px_rgba(0,0,0,0.04)]">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg mb-6 border border-blue-100 dark:border-blue-900">
            2PL
          </div>
          <h3 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-3">
            Item Response Theory
          </h3>
          <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Unlike crude tests that just count right answers, each question is calibrated for individual item difficulty (<span class="italic font-serif">b</span>) and discrimination (<span class="italic font-serif">a</span>).
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-950 border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/50 transition-all hover:translate-y-[-2px] shadow-[0_4px_25px_rgba(0,0,0,0.04)]">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg mb-6 border border-indigo-100 dark:border-indigo-900">
            SD15
          </div>
          <h3 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-3">
            Standardized IQ Scale
          </h3>
          <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mapped directly to the classic Wechsler-standard normal distribution (Mean 100, Standard Deviation 15) with precise percentile ranks.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-950 border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/50 transition-all hover:translate-y-[-2px] shadow-[0_4px_25px_rgba(0,0,0,0.04)]">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg mb-6 border border-emerald-100 dark:border-emerald-900">
            🌐
          </div>
          <h3 class="font-heading font-bold text-xl text-zinc-950 dark:text-white mb-3">
            Language-Independent
          </h3>
          <p class="text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            100% visual matrix puzzles. No vocabulary questions or cultural bias. Evaluating pure fluid intelligence (<span class="italic font-serif">G<sub>f</sub></span>) fairly across all backgrounds.
          </p>
        </div>
      </div>
    </section>

