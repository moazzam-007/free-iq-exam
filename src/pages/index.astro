---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Free IQ Test Online 2026 - Instant Results, No Email Required | FreeIQExam";
const description = "Take the most accurate free IQ test online. 24 standardized questions across 4 cognitive domains evaluated via 2PL Item Response Theory. Instant score, percentile & breakdown.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Standardized 24-item non-verbal cognitive assessment using 2PL Item Response Theory. Instant IQ-scale score estimate with percentile ranking.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": "24-question non-verbal IQ test, 2PL IRT scoring, instant results, no email required"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How accurate is this free IQ test?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This assessment uses 2-Parameter Logistic Item Response Theory (2PL IRT) with provisional item parameters anchored to peer-reviewed psychometric literature. It provides a statistical estimate suitable for self-assessment screening, not a clinical diagnosis."
        }
      },
      {
        "@type": "Question",
        "name": "How long does the IQ test take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The test consists of 24 non-verbal reasoning questions with a 20-minute time limit. Most participants complete it in 12 to 18 minutes."
        }
      },
      {
        "@type": "Question",
        "name": "Is my data stored or sold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. All scoring computations execute client-side in your web browser. Individual item responses and calculated scores are never stored on central databases or transmitted to any third parties."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <!-- Shared Global Navigation Header -->
  <Header currentPath="/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">
    <!-- HERO SECTION (Pure White Background + Monumental Apple Scale) -->
    <section class="relative pt-16 pb-20 md:pt-28 md:pb-32 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <!-- Vercel-Style Eyebrow Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 shadow-2xs mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
          <span>4-DOMAIN CHC ASSESSMENT - FLUID, SPATIAL, QUANTITATIVE, VERBAL</span>
        </div>

        <!-- Monumental Display H1 -->
        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Free Online IQ Test.<br />
          <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
            Get Your Estimated Score Instantly.
          </span>
        </h1>

        <!-- High-Legibility Subtitle -->
        <p class="text-lg sm:text-2xl text-zinc-600 dark:text-zinc-300 max-w-3xl mx-auto mb-10 sm:mb-12 leading-relaxed font-normal">
          Evaluate your cognitive abilities across Fluid Reasoning, Visual-Spatial, Quantitative, and Verbal domains. Get your estimated IQ-scale score (SD 15) and percentile rank instantly, with <strong class="text-zinc-950 dark:text-white font-semibold">no email, no registration, and zero paywalls.</strong>
        </p>

        <!-- Large Tactile Action Buttons - Dual Track -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
          <a 
            href="/test" 
            class="w-full sm:w-auto px-9 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-xl shadow-blue-600/25 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3"
          >
            <span>Full Test (20 Min)</span>
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a 
            href="/quick-test" 
            class="w-full sm:w-auto px-8 py-4 sm:py-5 rounded-full text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Quick Screening (10 Min)</span>
          </a>
        </div>

        <!-- Clean 4-Bullet Trust Strip -->
        <div class="flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-sm sm:text-base font-medium text-zinc-600 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Instant Results</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>No Email Needed</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Standardized SD 15</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Zero Paywalls</span>
          </div>
        </div>

        <!-- Transparent Scope Disclosure -->
        <div class="mt-8 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-900 text-xs font-medium text-blue-700 dark:text-blue-300">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>Evaluates Non-Verbal Fluid Reasoning (Gf) &amp; Visual Processing (Gv)</span>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE SAMPLE PUZZLE -->
    <section id="demo-puzzle" class="py-20 sm:py-24 bg-zinc-50 dark:bg-zinc-950/60 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <!-- Section Header -->
        <div class="text-center mb-12 sm:mb-14">
          <span class="text-xs sm:text-sm font-mono font-semibold tracking-wider text-blue-600 dark:text-blue-400 uppercase">
            Interactive Sample
          </span>
          <h2 class="font-heading font-bold text-3xl sm:text-4xl text-zinc-950 dark:text-white mt-2">
            Test Your Pattern Reasoning
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mt-3 max-w-2xl mx-auto">
            Which tile logically completes the 3x3 matrix? Select an answer option below to test the interaction.
          </p>
        </div>

        <!-- Elevated Puzzle Card -->
        <div class="bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.08)] overflow-hidden">
          <!-- Card Header Bar -->
          <div class="px-6 sm:px-8 py-4 sm:py-5 border-b border-zinc-100 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 bg-zinc-50/50 dark:bg-zinc-900/60">
            <div class="flex items-center gap-3">
              <span class="font-mono font-bold text-xs sm:text-sm px-3 py-1 rounded-md bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                SAMPLE ITEM
              </span>
              <span class="text-xs sm:text-sm font-medium text-zinc-600 dark:text-zinc-400">
                Visual Pattern Progression
              </span>
            </div>
            <span class="text-xs sm:text-sm font-mono text-zinc-500">
              Standard Pace: ~50 sec/item
            </span>
          </div>

          <!-- Puzzle Viewport + Interactive Choices -->
          <div class="p-6 sm:p-10 md:p-12 flex flex-col md:flex-row items-center justify-between gap-10 md:gap-12">
            <!-- 3x3 Puzzle Display -->
            <div class="flex flex-col items-center">
              <div class="grid grid-cols-3 gap-2 sm:gap-3 p-3 sm:p-4 bg-white dark:bg-black rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 w-64 h-64 sm:w-80 sm:h-80 shadow-sm">
                <!-- Cell 1: 1 Blue Dot -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800">
                  <div class="w-5 h-5 rounded-full bg-blue-600"></div>
                </div>
                <!-- Cell 2: 2 Blue Dots -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800">
                  <div class="w-4 h-4 rounded-full bg-blue-600"></div>
                  <div class="w-4 h-4 rounded-full bg-blue-600"></div>
                </div>
                <!-- Cell 3: 3 Blue Dots -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center gap-1 border border-zinc-200 dark:border-zinc-800">
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                  <div class="w-3.5 h-3.5 rounded-full bg-blue-600"></div>
                </div>

                <!-- Cell 4: 1 Indigo Square -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800">
                  <div class="w-5 h-5 rounded-xs bg-indigo-600"></div>
                </div>
                <!-- Cell 5: 2 Indigo Squares -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800">
                  <div class="w-4 h-4 rounded-xs bg-indigo-600"></div>
                  <div class="w-4 h-4 rounded-xs bg-indigo-600"></div>
                </div>
                <!-- Cell 6: 3 Indigo Squares -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center gap-1 border border-zinc-200 dark:border-zinc-800">
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                  <div class="w-3.5 h-3.5 rounded-xs bg-indigo-600"></div>
                </div>

                <!-- Cell 7: 1 Purple Triangle -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center border border-zinc-200 dark:border-zinc-800">
                  <div class="w-0 h-0 border-l-[9px] border-l-transparent border-r-[9px] border-r-transparent border-b-[16px] border-b-purple-600"></div>
                </div>
                <!-- Cell 8: 2 Purple Triangles -->
                <div class="bg-zinc-50/70 dark:bg-zinc-900 rounded-xl flex items-center justify-center gap-1.5 border border-zinc-200 dark:border-zinc-800">
                  <div class="w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-b-[13px] border-b-purple-600"></div>
                  <div class="w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-b-[13px] border-b-purple-600"></div>
                </div>
                <!-- Cell 9: TARGET ? -->
                <div class="bg-blue-50/70 dark:bg-blue-950/40 rounded-xl flex items-center justify-center border-2 border-dashed border-blue-500 animate-pulse">
                  <span class="font-heading font-black text-3xl text-blue-600 dark:text-blue-400">?</span>
                </div>
              </div>
            </div>

            <!-- Answer Buttons -->
            <div class="w-full md:w-1/2 flex flex-col">
              <div class="text-xs sm:text-sm font-mono font-bold uppercase tracking-wider text-zinc-500 mb-3 sm:mb-4 text-center md:text-left">
                Select Solution (A - F):
              </div>

              <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
                <!-- Option A -->
                <button type="button" data-option="A" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">A</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center">
                    <div class="w-0 h-0 border-l-[7px] border-l-transparent border-r-[7px] border-r-transparent border-b-[13px] border-b-purple-600"></div>
                  </div>
                </button>

                <!-- Option B -->
                <button type="button" data-option="B" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">B</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-purple-600"></div>
                  </div>
                </button>

                <!-- Option C (CORRECT) -->
                <button type="button" data-option="C" data-correct="true" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">C</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[5px] border-l-transparent border-r-[5px] border-r-transparent border-b-[10px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[5px] border-l-transparent border-r-[5px] border-r-transparent border-b-[10px] border-b-purple-600"></div>
                    <div class="w-0 h-0 border-l-[5px] border-l-transparent border-r-[5px] border-r-transparent border-b-[10px] border-b-purple-600"></div>
                  </div>
                </button>

                <!-- Option D -->
                <button type="button" data-option="D" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">D</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center gap-1">
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                    <div class="w-3.5 h-3.5 bg-blue-600"></div>
                  </div>
                </button>

                <!-- Option E -->
                <button type="button" data-option="E" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">E</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center">
                    <div class="w-4 h-4 bg-purple-600"></div>
                  </div>
                </button>

                <!-- Option F -->
                <button type="button" data-option="F" class="option-btn p-3 sm:p-4 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-500 bg-zinc-50/50 dark:bg-black flex flex-col items-center justify-center gap-2 hover:scale-105 active:scale-95 transition-all">
                  <span class="font-mono text-xs sm:text-sm font-bold text-zinc-500 dark:text-zinc-400">F</span>
                  <div class="h-7 sm:h-8 flex items-center justify-center gap-1">
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-blue-600"></div>
                    <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[11px] border-b-blue-600"></div>
                  </div>
                </button>
              </div>

              <!-- Interactive Feedback Message -->
              <div id="demo-feedback" class="mt-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300 text-center transition-all">
                Click any option above to verify your solution.
              </div>

              <!-- High-Converting Bridge CTA to /test -->
              <div class="mt-5 text-center">
                <a 
                  href="/test" 
                  class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm sm:text-base shadow-md transition-all hover:scale-[1.01] active:scale-[0.99]"
                >
                  <span>Take Complete 24-Question Test</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 ASSESSMENT PILLAR CARDS (Interlinked Deep Dives) -->
    <section id="pillars" class="py-20 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 bg-white dark:bg-black transition-colors">
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <span class="text-xs sm:text-sm font-mono font-semibold tracking-wider text-blue-600 dark:text-blue-400 uppercase">
          Assessment Architecture
        </span>
        <h2 class="font-heading font-bold text-3xl sm:text-5xl text-zinc-950 dark:text-white mt-2 tracking-tight">
          Scientific Intelligence Pillars
        </h2>
        <p class="text-base sm:text-xl text-zinc-600 dark:text-zinc-400 mt-4 leading-relaxed">
          Explore the psychometric frameworks, scoring models, and reasoning patterns behind the assessment.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        <!-- Pillar Card 1: Matrix Reasoning -->
        <a 
          href="/matrix-reasoning-test" 
          class="group p-8 rounded-3xl bg-zinc-50/70 dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800 hover:border-blue-500/60 hover:bg-white dark:hover:bg-zinc-900 transition-all hover:translate-y-[-2px] shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg mb-6 border border-blue-100 dark:border-blue-900 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">Core Domain</span>
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Matrix Reasoning Guide
            </h3>
            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
              Master the 5 fundamental Carpenter transformation rules: progression, distribution of three, XOR logic, subtraction, and topological series.
            </p>
          </div>
          <div class="flex items-center gap-2 text-sm font-semibold text-blue-600 dark:text-blue-400 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <span>Explore Matrix Guide</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar Card 2: Score Distribution -->
        <a 
          href="/iq-score-chart" 
          class="group p-8 rounded-3xl bg-zinc-50/70 dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800 hover:border-indigo-500/60 hover:bg-white dark:hover:bg-zinc-900 transition-all hover:translate-y-[-2px] shadow-sm flex flex-col justify-between"
