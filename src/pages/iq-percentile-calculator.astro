---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "IQ to Percentile Calculator (Instant 2-Way Conversion) | FreeIQExam";
const description = "Calculate theoretical normal distribution percentiles from any IQ score or convert your percentile into an estimated IQ score using standard deviation 15 models.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "IQ to Percentile Calculator",
    "url": "https://freeiqexam.com/iq-percentile-calculator",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Instant 2-way conversion utility between standard IQ scores (SD 15) and normal distribution percentile rankings.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "IQ to Percentile Calculator",
        "item": "https://freeiqexam.com/iq-percentile-calculator"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is an IQ percentile?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An IQ percentile indicates the percentage of the general population that scores at or below a given IQ score on a standardized normal distribution (Mean 100, SD 15)."
        }
      },
      {
        "@type": "Question",
        "name": "What percentile is an IQ of 100?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An IQ of 100 is the exact median of the population, corresponding to the 50th percentile."
        }
      },
      {
        "@type": "Question",
        "name": "What IQ score is needed to qualify for Mensa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mensa requires a score at or above the 98th percentile, which corresponds to an IQ of 130 or higher on the Wechsler scale (SD 15) or 132 on the Stanford-Binet scale (SD 16)."
        }
      },
      {
        "@type": "Question",
        "name": "How is the IQ percentile calculated mathematically?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IQ percentiles are derived using the standard normal cumulative distribution function (CDF). First, the Z-score is calculated as z = (IQ - 100) / 15, then integrated through the Gaussian error function."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/iq-percentile-calculator" />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/50 border border-indigo-200 dark:border-indigo-900 text-xs font-mono font-medium text-indigo-700 dark:text-indigo-300 mb-4">
        <span>INTERACTIVE UTILITY &bull; WECHSLER SD 15 MODEL</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        IQ to Percentile Calculator
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Convert any IQ score into its theoretical normal distribution percentile rank, or calculate the estimated IQ score required to reach a specific percentile tier.
      </p>
    </header>

    <!-- Interactive 2-Way Calculator Component Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs max-w-2xl mx-auto w-full">
      
      <!-- Mode Toggle Buttons -->
      <div class="flex items-center p-1 rounded-2xl bg-zinc-200/70 dark:bg-zinc-800/70 mb-8 max-w-md mx-auto">
        <button
          id="tab-iq-to-pct"
          type="button"
          class="flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white dark:bg-zinc-900 text-zinc-950 dark:text-white shadow-xs"
        >
          Score to Percentile
        </button>
        <button
          id="tab-pct-to-iq"
          type="button"
          class="flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
        >
          Percentile to Score
        </button>
      </div>

      <!-- Mode 1: IQ -> Percentile Panel -->
      <div id="panel-iq-to-pct" class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="iq-input" class="text-sm font-semibold text-zinc-900 dark:text-white">
              Enter IQ Score (SD 15)
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Range: 55 to 160</span>
          </div>
          <div class="relative">
            <input
              id="iq-input"
              type="number"
              min="55"
              max="160"
              value="120"
              class="w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-2xl font-bold font-mono text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-mono text-zinc-500 dark:text-zinc-400 font-semibold">IQ</span>
          </div>
          <!-- Range Slider -->
          <input
            id="iq-slider"
            type="range"
            min="55"
            max="160"
            value="120"
            aria-label="IQ Score Range Slider"
            class="w-full mt-4 accent-blue-600 cursor-pointer min-h-[44px]"
          />
        </div>

        <!-- Calculated Metrics Output Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4" role="status" aria-live="polite">
          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Percentile Rank</span>
            <span id="output-percentile" class="text-2xl font-heading font-extrabold text-blue-600 dark:text-blue-400">
              90.9%
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Population Rarity</span>
            <span id="output-rarity" class="text-base font-mono font-bold text-zinc-900 dark:text-white">
              Top 9.1% (1 in 11 people)
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Z-Score Deviation</span>
            <span id="output-zscore" class="text-base font-mono font-semibold text-zinc-900 dark:text-white">
              +1.33 &sigma;
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Classification</span>
            <span id="output-classification" class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300">
              Superior Cognitive Ability
            </span>
          </div>
        </div>
      </div>

      <!-- Mode 2: Percentile -> IQ Panel -->
      <div id="panel-pct-to-iq" class="hidden space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="pct-input" class="text-sm font-semibold text-zinc-900 dark:text-white">
              Enter Desired Percentile Rank
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Range: 0.1% to 99.9%</span>
          </div>
          <div class="relative">
            <input
              id="pct-input"
              type="number"
              min="0.1"
              max="99.9"
              step="0.1"
              value="98.0"
              class="w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-2xl font-bold font-mono text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-600"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-mono text-zinc-500 dark:text-zinc-400 font-semibold">%</span>
          </div>
          <input
            id="pct-slider"
            type="range"
            min="0.1"
            max="99.9"
            step="0.1"
            value="98.0"
            aria-label="Percentile Rank Range Slider"
            class="w-full mt-4 accent-indigo-600 cursor-pointer min-h-[44px]"
          />
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4" role="status" aria-live="polite">
          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Equivalent IQ Score</span>
            <span id="output-iq-from-pct" class="text-2xl font-heading font-extrabold text-indigo-600 dark:text-indigo-400">
              131 IQ
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Standard Deviation Tier</span>
            <span id="output-sd-from-pct" class="text-base font-mono font-semibold text-zinc-900 dark:text-white">
              +2.05 &sigma; (Wechsler SD 15)
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Mensa Status</span>
            <span id="output-mensa-status" class="text-xs font-semibold px-3 py-1 rounded-full bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
              Qualifies for Mensa (Top 2%)
            </span>
          </div>
        </div>
      </div>

    </section>

    <!-- Quick Reference Benchmark Table -->
    <section>
      <div class="mb-4 text-center sm:text-left">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Benchmark Score &amp; Percentile Lookup Table
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Standard deviation 15 reference values and cumulative normal distribution percentiles.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[560px] text-left text-xs sm:text-sm font-mono">
          <thead class="sticky top-0 bg-zinc-100/95 dark:bg-zinc-900/95 backdrop-blur-sm z-10 border-b border-zinc-200 dark:border-zinc-800 uppercase text-[11px] text-zinc-600 dark:text-zinc-400">
            <tr>
              <th class="py-3 px-4">IQ Score (SD 15)</th>
              <th class="py-3 px-4">Percentile Rank</th>
              <th class="py-3 px-4">Z-Score (&sigma;)</th>
              <th class="py-3 px-4">Population Frequency</th>
              <th class="py-3 px-4">Psychometric Tier</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/80 dark:divide-zinc-800 bg-white dark:bg-black">
            <tr>
              <td class="py-3 px-4 font-bold text-purple-600 dark:text-purple-400">145</td>
              <td class="py-3 px-4">99.87%</td>
              <td class="py-3 px-4">+3.00 &sigma;</td>
              <td class="py-3 px-4">1 in 740</td>
              <td class="py-3 px-4 font-sans font-semibold">Profoundly Superior</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-indigo-600 dark:text-indigo-400">130</td>
              <td class="py-3 px-4">97.72%</td>
              <td class="py-3 px-4">+2.00 &sigma;</td>
              <td class="py-3 px-4">1 in 44</td>
              <td class="py-3 px-4 font-sans font-semibold">Very Superior (Mensa)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-blue-600 dark:text-blue-400">120</td>
              <td class="py-3 px-4">90.88%</td>
              <td class="py-3 px-4">+1.33 &sigma;</td>
              <td class="py-3 px-4">1 in 11</td>
              <td class="py-3 px-4 font-sans font-semibold">Superior</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-teal-600 dark:text-teal-400">115</td>
              <td class="py-3 px-4">84.13%</td>
              <td class="py-3 px-4">+1.00 &sigma;</td>
              <td class="py-3 px-4">1 in 6</td>
              <td class="py-3 px-4 font-sans font-semibold">High Average (+1 SD)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">100</td>
              <td class="py-3 px-4">50.00%</td>
              <td class="py-3 px-4">0.00 &sigma;</td>
              <td class="py-3 px-4">1 in 2</td>
              <td class="py-3 px-4 font-sans font-semibold">Population Mean</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-amber-600 dark:text-amber-400">85</td>
              <td class="py-3 px-4">15.87%</td>
              <td class="py-3 px-4">-1.00 &sigma;</td>
              <td class="py-3 px-4">1 in 6</td>
              <td class="py-3 px-4 font-sans font-semibold">Low Average (-1 SD)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-rose-600 dark:text-rose-400">70</td>
              <td class="py-3 px-4">2.28%</td>
              <td class="py-3 px-4">-2.00 &sigma;</td>
              <td class="py-3 px-4">1 in 44</td>
              <td class="py-3 px-4 font-sans font-semibold">Borderline (-2 SD)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mathematical Formula Breakdown -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-3">
        Mathematical Formulation: Z-Scores and CDF Integration
      </h3>
      <p class="mb-3">
        The conversion from standard score to percentile operates through standard normal standardization:
      </p>
      <div class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-xs mb-3">
        z = (IQ - 100) / 15<br />
        Percentile = &Phi;(z) &times; 100 = 0.5 &times; [1 + erf(z / &radic;2)] &times; 100
      </div>
      <p>
        Where &Phi; is the cumulative distribution function of the standard normal distribution, and erf is the Gauss error function.
      </p>
    </section>

    <!-- ================================================================= -->
    <!-- LAYMAN PERCENTILE EXPLAINER: THE 100-PERSON LINE & NORMAL CURVE   -->
    <!-- ================================================================= -->
    <section class="space-y-8 border-t border-zinc-200 dark:border-zinc-800 pt-10" aria-labelledby="heading-layman-guide">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-2">
          Plain-English Guide
        </div>
        <h2 id="heading-layman-guide" class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
          How to Understand IQ Percentiles: The Layman Guide
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-3xl">
          Everything you need to know about what percentiles mean, how they differ from test scores, and why bell-curve distributions matter.
        </p>
      </div>

      <!-- 1. The 100-Person Line Analogy -->
      <div class="rounded-3xl border border-indigo-200/90 dark:border-indigo-900/60 bg-gradient-to-br from-indigo-50/70 via-white to-blue-50/50 dark:from-indigo-950/40 dark:via-zinc-900 dark:to-blue-950/30 p-6 sm:p-8 shadow-xs">
        <div class="flex items-center gap-3.5 mb-4">
          <div class="w-11 h-11 rounded-2xl bg-indigo-600 dark:bg-indigo-500 text-white flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white">
              The "100-Person Line" Intuitive Analogy
            </h3>
            <p class="text-xs font-mono text-indigo-700 dark:text-indigo-300">
              Visualizing Relative Population Standing
            </p>
          </div>
        </div>

        <blockquote class="text-sm sm:text-base text-zinc-800 dark:text-zinc-200 font-medium leading-relaxed mb-6 pl-4 border-l-4 border-indigo-500 italic">
          "Imagine 100 people chosen at random from the population, lined up from lowest score to highest score. If your IQ is at the 98th percentile, you are standing ahead of 98 out of those 100 people, with only 2 people ahead of you."
        </blockquote>

        <!-- 10x10 Cohort Visualization Grid -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-indigo-100 dark:border-indigo-900/40">
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3">
            <span>Lowest 1% (Behind)</span>
            <span class="font-bold text-indigo-600 dark:text-indigo-400">98th Percentile (Mensa Threshold)</span>
            <span>Top 100%</span>
          </div>
          <!-- Visual Dot Cohort Row -->
          <div class="grid grid-cols-10 gap-1.5 sm:gap-2">
            <!-- 98 People Ahead / Cohort Blocks -->
            <div class="col-span-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950/80 border border-blue-200 dark:border-blue-800 flex items-center justify-center text-xs font-mono font-semibold text-blue-800 dark:text-blue-300">
              98 People Behind You (98%)
            </div>
            <!-- Top 2 Elite -->
            <div class="col-span-2 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs font-mono font-bold shadow-xs">
              Top 2 (IQ 130+)
            </div>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2.5">
            On a standardized test scale, a 50th percentile rank places you exactly at the median (50 behind, 50 ahead), while a 99.9th percentile rank means standing ahead of 999 out of 1,000 people.
          </p>
        </div>
      </div>

      <!-- 2. Percentage vs. Percentile Comparison -->
      <div>
        <h3 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-4">
          Percentage vs. Percentile: The Critical Distinction
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Percentage Card -->
          <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center px-2.5 py-1 rounded-lg bg-zinc-200/70 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-mono font-bold mb-3">
                Percentage (%) - Raw Test Accuracy
              </div>
              <h4 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
                What Fraction of Items You Answered Correctly
              </h4>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
                An 80% on a test means you answered 80 out of 100 questions correctly. It reflects absolute performance on that specific set of questions, regardless of how anyone else performed or how difficult the questions were.
              </p>
            </div>
            <div class="p-3 rounded-xl bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-600 dark:text-zinc-400">
              Formula: (Correct Answers / Total Questions) &times; 100
            </div>
          </div>

          <!-- Percentile Card -->
          <div class="p-6 rounded-3xl bg-blue-50/50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900/60 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center px-2.5 py-1 rounded-lg bg-blue-100 dark:bg-blue-900/70 text-blue-800 dark:text-blue-300 text-xs font-mono font-bold mb-3">
                Percentile (th) - Relative Population Standing
              </div>
              <h4 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
                What Percentage of the Human Population Scored Below You
              </h4>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
                An 80th percentile rank means you scored higher than 80% of the entire standardized norm group, regardless of whether you answered 15, 20, or 24 questions correctly. It measures relative cognitive rarity.
              </p>
            </div>
            <div class="p-3 rounded-xl bg-white dark:bg-zinc-950 border border-blue-100 dark:border-blue-900/40 text-xs font-mono text-blue-700 dark:text-blue-300">
              Metric: Cumulative Normal Integral &Phi;(z) &times; 100
            </div>
          </div>
        </div>
      </div>

      <!-- 3. How the Two Conversion Tools Work -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-4">
          How the 2-Way Conversion Tools Work
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
