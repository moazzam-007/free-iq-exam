<script is:inline>
  (function() {
    // DOM Elements
    const ageInput = document.getElementById('age-input');
    const heightInput = document.getElementById('height-input');
    const weightInput = document.getElementById('weight-input');
    const goalSelect = document.getElementById('goal-select');
    
    const bmrResult = document.getElementById('bmr-result');
    const tdeeResult = document.getElementById('tdee-result');
    const targetResult = document.getElementById('target-result');
    const guardrailWarning = document.getElementById('guardrail-warning');

    const pGram = document.getElementById('p-gram');
    const pKcal = document.getElementById('p-kcal');
    const fGram = document.getElementById('f-gram');
    const fKcal = document.getElementById('f-kcal');
    const cGram = document.getElementById('c-gram');
    const cKcal = document.getElementById('c-kcal');

    const barP = document.getElementById('bar-p');
    const barF = document.getElementById('bar-f');
    const barC = document.getElementById('bar-c');

    const toggleActivityBtn = document.getElementById('toggle-activity-mode');
    const activityModeLabel = document.getElementById('activity-mode-label');
    const act3Container = document.getElementById('activity-3-levels');
    const act5Container = document.getElementById('activity-5-levels');

    let is5LevelMode = false;

    // Toggle 3-level vs 5-level mode
    if (toggleActivityBtn) {
      toggleActivityBtn.addEventListener('click', function() {
        is5LevelMode = !is5LevelMode;
        if (is5LevelMode) {
          act3Container.classList.add('hidden');
          act5Container.classList.remove('hidden');
          activityModeLabel.textContent = '詳細 5段階モード';
        } else {
          act5Container.classList.add('hidden');
          act3Container.classList.remove('hidden');
          activityModeLabel.textContent = '食事摂取基準 3段階';
        }
        calculate();
      });
    }

    function getSelectedRadio(name) {
      const el = document.querySelector('input[name="' + name + '"]:checked');
      return el ? el.value : null;
    }

    function calculate() {
      const formula = getSelectedRadio('formula') || 'ganpule';
      const sex = getSelectedRadio('sex') || 'male';
      const age = parseFloat(ageInput.value) || 30;
      const cm = parseFloat(heightInput.value) || 170;
      const kg = parseFloat(weightInput.value) || 65;

      let bmr = 0;
      if (formula === 'ganpule') {
        // Ganpule et al. (2007) formula for Japanese adults
        // sex: male = 1, female = 2
        const sexVal = (sex === 'male') ? 1 : 2;
        bmr = (0.1238 + (0.0481 * kg) + (0.0234 * cm) - (0.0138 * age) - (0.5473 * sexVal)) * 1000 / 4.186;
      } else {
        // Mifflin-St Jeor formula
        // s = +5 for male, -161 for female
        const sVal = (sex === 'male') ? 5 : -161;
        bmr = (10 * kg) + (6.25 * cm) - (5 * age) + sVal;
      }

      // Activity level multiplier
      let actMultiplier = 1.50;
      if (is5LevelMode) {
        actMultiplier = parseFloat(getSelectedRadio('act5') || '1.55');
      } else {
        actMultiplier = parseFloat(getSelectedRadio('act3') || '1.50');
      }

      const tdee = bmr * actMultiplier;

      // Goal target calculation with safety guardrails
      const goalVal = goalSelect.value;
      let targetCal = tdee;

      if (goalVal === 'mild-cut') {
        targetCal = tdee - 300;
      } else if (goalVal === 'cut') {
        targetCal = tdee - 500;
      } else if (goalVal === 'bulk') {
        targetCal = tdee + 300;
      } else if (goalVal === 'heavy-bulk') {
        targetCal = tdee + 500;
      }

      // Guardrail 1: Minimum target cannot drop below BMR
      // Guardrail 2: Maximum deficit capped at 25% of TDEE
      const minCut = tdee * 0.75;
      let isGuardrailHit = false;

      if (targetCal < bmr) {
        targetCal = bmr;
        isGuardrailHit = true;
      }
      if (targetCal < minCut) {
        targetCal = minCut;
        isGuardrailHit = true;
      }

      // Update Main Numbers
      bmrResult.textContent = Math.round(bmr).toLocaleString();
      tdeeResult.textContent = Math.round(tdee).toLocaleString();
      targetResult.textContent = Math.round(targetCal).toLocaleString();

      if (guardrailWarning) {
        if (isGuardrailHit) {
          guardrailWarning.classList.remove('hidden');
        } else {
          guardrailWarning.classList.add('hidden');
        }
      }

      // PFC Balance Breakdown
      const pfcMode = getSelectedRadio('pfc-mode') || 'standard';
      let pRatio = 0.15, fRatio = 0.25, cRatio = 0.60;
      if (pfcMode === 'high-protein') {
        pRatio = 0.25; fRatio = 0.25; cRatio = 0.50;
      } else if (pfcMode === 'low-carb') {
        pRatio = 0.25; fRatio = 0.40; cRatio = 0.35;
      }

      const pKcalVal = targetCal * pRatio;
      const fKcalVal = targetCal * fRatio;
      const cKcalVal = targetCal * cRatio;

      const pGramVal = pKcalVal / 4;
      const fGramVal = fKcalVal / 9;
      const cGramVal = cKcalVal / 4;

      pGram.textContent = Math.round(pGramVal) + 'g';
      pKcal.textContent = Math.round(pKcalVal) + ' kcal (' + Math.round(pRatio * 100) + '%)';

      fGram.textContent = Math.round(fGramVal) + 'g';
      fKcal.textContent = Math.round(fKcalVal) + ' kcal (' + Math.round(fRatio * 100) + '%)';

      cGram.textContent = Math.round(cGramVal) + 'g';
      cKcal.textContent = Math.round(cKcalVal) + ' kcal (' + Math.round(cRatio * 100) + '%)';

      barP.style.width = (pRatio * 100) + '%';
      barF.style.width = (fRatio * 100) + '%';
      barC.style.width = (cRatio * 100) + '%';
    }

    // Attach Event Listeners to all inputs
    const inputs = document.querySelectorAll('#bmr-form input, #bmr-form select');
    inputs.forEach(function(input) {
      input.addEventListener('change', calculate);
      input.addEventListener('input', calculate);
    });

    // Initial run
    calculate();
  })();
</script>
