---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const title = "基礎代謝 計算｜カロリー計算・1日の消費カロリー（TDEE） | FreeIQExam";
const description = "年齢・性別・身長・体重・活動量から基礎代謝量（BMR）と1日の消費カロリー（TDEE）を無料で計算。目標に応じた摂取カロリーとPFCバランスの目安も表示します。";
const canonicalUrl = "https://freeiqexam.com/ja/calorie-calculator";

const alternates = {
  en: "https://freeiqexam.com/calorie-calculator",
  de: "https://freeiqexam.com/de/kalorienrechner",
  nl: "https://freeiqexam.com/nl/calorie-calculator",
  ja: "https://freeiqexam.com/ja/calorie-calculator"
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam 基礎代謝・1日の消費カロリー（TDEE）計算機",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript support",
    "inLanguage": "ja",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "JPY"
    },
    "featureList": [
      "国立健康・栄養研究所の式（Ganpule et al. 2007 日本人成人向け）による基礎代謝量計算",
      "Mifflin-St Jeor 式（国際標準）との切替計算機能",
      "日本人の食事摂取基準に基づく3段階活動レベルおよび詳細5段階モード対応",
      "安全ガイドラインに基づいた減量・増量目標別の摂取カロリー目安計算",
      "PFCバランス（タンパク質・脂質・炭水化物）のグラム数およびカロリー自動展開"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://freeiqexam.com/ja/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "基礎代謝・カロリー計算機",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="ja"
>
  <Header currentPath="/ja/calorie-calculator" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-10 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-[#2997ff] border border-blue-500/20 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>国立健康・栄養研究所 (Ganpule) &amp; Mifflin-St Jeor 推定エンジン</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight mb-4 leading-tight">
        基礎代謝 計算・1日の消費カロリー（TDEE）
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        年齢・性別・身長・体重・身体活動レベルから、1日の基礎代謝量（BMR）と総消費エネルギー（TDEE）を即時に計算。減量や増量に必要な摂取カロリーとPFCバランスの目安を確認できます。
      </p>

      <!-- Purpose Notice Banner -->
      <div class="mt-6 p-4 rounded-xl bg-blue-50/80 dark:bg-zinc-900/90 border border-blue-200/80 dark:border-zinc-800 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 text-left sm:text-center max-w-3xl mx-auto shadow-sm">
        <div class="flex items-start sm:items-center justify-center gap-2.5">
          <svg class="w-5 h-5 shrink-0 text-[#0066cc] dark:text-[#2997ff] mt-0.5 sm:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong>ご注意：</strong>本ツールは1日の総消費エネルギー（TDEE）と基礎代謝（BMR）の計算機です（料理・食品のカロリー検索ではありません）。</span>
        </div>
      </div>
    </section>

    <!-- Top Medical & Safety Disclaimer Notice -->
    <section class="px-4 sm:px-6 max-w-4xl mx-auto mb-8">
      <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        <p>
          <strong>【免責事項・対象年齢】</strong>本計算機は18歳以上の健康な成人を対象としています。未成年の方、妊娠中・授乳中の方、心臓病・糖尿病・腎臓病などの持病をお持ちの方は、必ず医師や管理栄養士などの専門家にご相談ください。
        </p>
      </div>
    </section>

    <!-- Interactive Calculator Container -->
    <section class="px-4 sm:px-6 max-w-5xl mx-auto pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Input Form Controls -->
        <div class="lg:col-span-7 bg-white dark:bg-zinc-900/90 p-6 sm:p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h2 class="text-xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-2 border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <svg class="w-5 h-5 text-[#0066cc] dark:text-[#2997ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m-6 4h6m-6 4h6M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            身体データの入力
          </h2>

          <form id="bmr-form" class="space-y-6" onsubmit="return false;">
            
            <!-- Calculation Formula Selector -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
                計算公式の選択
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="formula" value="ganpule" checked class="peer sr-only">
                  <div class="p-3 text-xs sm:text-sm rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 text-center font-medium peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff] transition-all">
                    国立健康・栄養研究所の式<br><span class="text-[11px] opacity-75">（日本人成人向け標準）</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="formula" value="mifflin" class="peer sr-only">
                  <div class="p-3 text-xs sm:text-sm rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 text-center font-medium peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff] transition-all">
                    Mifflin-St Jeor 式<br><span class="text-[11px] opacity-75">（国際標準）</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Sex Selection -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
                性別
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="sex" value="male" checked class="peer sr-only">
                  <div class="p-3 text-sm rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 text-center font-medium peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff] transition-all">
                    男性
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="sex" value="female" class="peer sr-only">
                  <div class="p-3 text-sm rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 text-center font-medium peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff] transition-all">
                    女性
                  </div>
                </label>
              </div>
            </div>

            <!-- Numeric Inputs: Age, Height, Weight -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="age-input" class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  年齢 (歳)
                </label>
                <input
                  type="number"
                  id="age-input"
                  min="18"
                  max="120"
                  value="30"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] font-semibold text-lg text-center"
                />
              </div>
              <div>
                <label for="height-input" class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  身長 (cm)
                </label>
                <input
                  type="number"
                  id="height-input"
                  min="120"
                  max="230"
                  step="0.5"
                  value="170"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] font-semibold text-lg text-center"
                />
              </div>
              <div>
                <label for="weight-input" class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  体重 (kg)
                </label>
                <input
                  type="number"
                  id="weight-input"
                  min="30"
                  max="250"
                  step="0.5"
                  value="65"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] font-semibold text-lg text-center"
                />
              </div>
            </div>

            <!-- Activity Level Selection -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                  身体活動レベル
                </label>
                <button
                  type="button"
                  id="toggle-activity-mode"
                  class="text-xs text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium"
                >
                  切替: <span id="activity-mode-label">食事摂取基準 3段階</span>
                </button>
              </div>

              <!-- 3-Level Standard Mode -->
              <div id="activity-3-levels" class="space-y-2">
                <label class="flex items-start p-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
                  <input type="radio" name="act3" value="1.50" checked class="mt-1 text-[#0066cc] focus:ring-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-sm font-semibold text-zinc-900 dark:text-white">レベル I（低い / x1.50）</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">デスクワーク中心・一日の大半を座って過ごす生活</span>
                  </div>
                </label>
                <label class="flex items-start p-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
                  <input type="radio" name="act3" value="1.75" class="mt-1 text-[#0066cc] focus:ring-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-sm font-semibold text-zinc-900 dark:text-white">レベル II（ふつう / x1.75）</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">座り仕事主体だが、通勤・家事・適度な徒歩移動を行う生活</span>
                  </div>
                </label>
                <label class="flex items-start p-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
                  <input type="radio" name="act3" value="2.00" class="mt-1 text-[#0066cc] focus:ring-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-sm font-semibold text-zinc-900 dark:text-white">レベル III（高い / x2.00）</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">立ち仕事や移動が多い仕事、または活発な運動習慣がある生活</span>
                  </div>
                </label>
              </div>

              <!-- 5-Level Detailed Mode (Hidden by default) -->
              <div id="activity-5-levels" class="space-y-2 hidden">
                <label class="flex items-start p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer">
                  <input type="radio" name="act5" value="1.20" class="mt-1 text-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-xs font-semibold text-zinc-900 dark:text-white">ほぼ運動しない (x1.20)</span>
                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">デスクワーク・在宅中心</span>
                  </div>
                </label>
                <label class="flex items-start p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer">
                  <input type="radio" name="act5" value="1.375" class="mt-1 text-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-xs font-semibold text-zinc-900 dark:text-white">軽い運動 (x1.375)</span>
                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">週1〜3回の軽めのスポーツ・ウォーキング</span>
                  </div>
                </label>
                <label class="flex items-start p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer">
                  <input type="radio" name="act5" value="1.55" checked class="mt-1 text-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-xs font-semibold text-zinc-900 dark:text-white">中程度の運動 (x1.55)</span>
                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">週3〜5回程度のジム・スポーツ</span>
                  </div>
                </label>
                <label class="flex items-start p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer">
                  <input type="radio" name="act5" value="1.725" class="mt-1 text-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-xs font-semibold text-zinc-900 dark:text-white">活発な運動 (x1.725)</span>
                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">週6〜7回の高強度トレーニング</span>
                  </div>
                </label>
                <label class="flex items-start p-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 cursor-pointer">
                  <input type="radio" name="act5" value="1.90" class="mt-1 text-[#0066cc]">
                  <div class="ml-3">
                    <span class="block text-xs font-semibold text-zinc-900 dark:text-white">非常に活発 (x1.90)</span>
                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">肉体労働者・プロアスリート</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Target Goal Mode -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
                目的に応じた体重目標
              </label>
              <select
                id="goal-select"
                class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white font-medium focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff]"
              >
                <option value="maintain" selected>体重維持 (100% TDEE)</option>
                <option value="mild-cut">マイルドな減量 (TDEE - 300 kcal/日)</option>
                <option value="cut">標準的な減量 (TDEE - 500 kcal/日)</option>
                <option value="bulk">筋肉増量・バルクアップ (TDEE + 300 kcal/日)</option>
                <option value="heavy-bulk">積極的増量 (TDEE + 500 kcal/日)</option>
              </select>
            </div>

            <!-- PFC Balance Ratio Mode -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
                PFCバランス設定
              </label>
              <div class="grid grid-cols-3 gap-2">
                <label class="cursor-pointer">
                  <input type="radio" name="pfc-mode" value="standard" checked class="peer sr-only">
                  <div class="p-2 text-center text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff]">
                    標準 (15/25/60)<br><span class="text-[10px] text-zinc-500">厚労省指標</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="pfc-mode" value="high-protein" class="peer sr-only">
                  <div class="p-2 text-center text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff]">
                    高タンパク (25/25/50)<br><span class="text-[10px] text-zinc-500">筋トレ・減量向け</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="pfc-mode" value="low-carb" class="peer sr-only">
                  <div class="p-2 text-center text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/40 peer-checked:border-[#0066cc] dark:peer-checked:border-[#2997ff] peer-checked:bg-blue-50/50 dark:peer-checked:bg-blue-950/30 peer-checked:text-[#0066cc] dark:peer-checked:text-[#2997ff]">
                    低糖質 (25/40/35)<br><span class="text-[10px] text-zinc-500">ローカーボ</span>
                  </div>
                </label>
              </div>
            </div>

          </form>
        </div>

        <!-- Right: Realtime Calculation Dashboard -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- BMR & TDEE Main Cards -->
          <div class="bg-zinc-950 text-white p-6 sm:p-8 rounded-2xl border border-zinc-800 shadow-xl space-y-6">
            <div>
              <div class="text-xs uppercase tracking-wider text-zinc-400 mb-1 font-semibold">
                基礎代謝量 (BMR)
              </div>
              <div class="flex items-baseline gap-2">
                <span id="bmr-result" class="text-4xl font-extrabold text-white tracking-tight">1,497</span>
                <span class="text-sm font-medium text-zinc-400">kcal / 日</span>
              </div>
              <p class="text-xs text-zinc-400 mt-1">
                生命維持に必要な最小限のエネルギー消費量
              </p>
            </div>

            <div class="pt-6 border-t border-zinc-800">
              <div class="text-xs uppercase tracking-wider text-blue-400 mb-1 font-semibold">
                1日の総消費エネルギー (TDEE)
              </div>
              <div class="flex items-baseline gap-2">
                <span id="tdee-result" class="text-4xl font-extrabold text-[#2997ff] tracking-tight">2,246</span>
                <span class="text-sm font-medium text-zinc-400">kcal / 日</span>
              </div>
              <p class="text-xs text-zinc-400 mt-1">
                日常の活動・運動を含めた実際の推定消費カロリー
              </p>
            </div>

            <div class="pt-6 border-t border-zinc-800">
              <div class="text-xs uppercase tracking-wider text-emerald-400 mb-1 font-semibold">
                目標摂取カロリー目安
              </div>
              <div class="flex items-baseline gap-2">
                <span id="target-result" class="text-3xl font-extrabold text-emerald-400 tracking-tight">2,246</span>
                <span class="text-sm font-medium text-zinc-400">kcal / 日</span>
              </div>
              <p id="guardrail-warning" class="text-[11px] text-amber-300 mt-1 hidden">
                ※安全基準のため、基礎代謝量（BMR）を下回らないよう下限調整されています。
              </p>
            </div>
          </div>

