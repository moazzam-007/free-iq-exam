---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DEPRESSION_QUESTIONS_JA, DEPRESSION_OPTIONS_JA, DEPRESSION_SEVERITY_MAP } from '../../scripts/ja/depression-test/scoring';
import { JAPANESE_CRISIS_HOTLINES, CLINICAL_DISCLAIMER_JA } from '../../data/ja/mental-health/hotlines';

const title = "うつ病 診断テスト｜PHQ-9セルフチェック（無料・5分） | FreeIQExam";
const description = "国際標準質問票PHQ-9で、過去2週間の気分・睡眠・意欲などの状態を確認できる無料セルフチェック。※診断ではありません。24時間相談窓口も掲載。";
const canonicalUrl = "https://freeiqexam.com/ja/depression-test";

const alternates = {
  en: "https://freeiqexam.com/depression-test",
  ru: "https://freeiqexam.com/ru/depression-test",
  id: "https://freeiqexam.com/id/tes-depresi",
  de: "https://freeiqexam.com/de/depressionstest",
  nl: "https://freeiqexam.com/nl/depressie-test",
  fi: "https://freeiqexam.com/fi/masennustesti",
  'pt-BR': "https://freeiqexam.com/pt-br/teste-depressao",
  ja: "https://freeiqexam.com/ja/depression-test"
};

const faqItems = [
  {
    q: "PHQ-9とはどのような尺度ですか？",
    a: "PHQ-9（患者健康質問票-9）は、米国精神医学会のDSM診断基準に完全準拠し、大うつ病エピソードの9つの主症状を直接評価するためにロバート・L・スピッツァー博士らによって開発された国際標準の抑うつ尺度です。過去2週間の気分、意欲、睡眠、食欲などの状態を0〜3点で評価します。"
  },
  {
    q: "PHQ-9のスコアが10点以上だった場合は何を意味しますか？",
    a: "原著論文および数多くのメタアナリシス研究において、10点以上は「中等度以上の抑うつ状態」を示す国際標準のカットオフ値とされています。感度・特異度ともに約88%と高い識別力を持ち、専門医療機関（心療内科・精神科）での診察や治療介入が推奨される水準です。"
  },
  {
    q: "自傷・希死念慮の質問（第9問）で点数がついた場合はどうすればよいですか？",
    a: "第9問（死について考えることや自傷行為に関する項目）で1点以上の回答があった場合は、総合スコアにかかわらず安全確保が最優先されます。決して一人で抱え込まず、本ページ下部に掲載の「よりそいホットライン（0120-279-338）」や「#いのちSOS（0120-061-338）」等の24時間無料相談窓口や専門医療機関へご相談ください。"
  },
  {
    q: "うつ病と一時的な気分の落ち込みやバーンアウト（燃え尽き）の違いは何ですか？",
    a: "一時的な落ち込みは原因が去ったり休養を取ることで自然に回復します。一方、うつ病では「何をしても興味が湧かず楽しめない（アヘドニア）」「睡眠障害」「食欲の急変」「強い無価値感」といった心身の不調が2週間以上にわたり持続し、日常生活や仕事に深刻な支障をきたします。"
  },
  {
    q: "オンラインのPHQ-9セルフチェックは確定診断になりますか？",
    a: "いいえ、本ツールは客観的なスクリーニング（簡易把握）を目的としており、医学的診断を行うものではありません。確定診断には、甲状腺疾患や貧血等の身体疾患の除外、双極性障害や適応障害との鑑別を含む、医師による対面での問診と臨床評価が必要です。"
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'うつ病PHQ-9セルフチェック（無料）',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    inLanguage: 'ja-JP',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
    accessibilitySummary: 'キーボード操作対応（1〜4キー）、セマンティックHTML、危機ホットライン表示、プライバシー保護（回答データ保存なし）。'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://freeiqexam.com/ja/' },
      { '@type': 'ListItem', position: 2, name: 'うつ病セルフチェック（PHQ-9）', item: canonicalUrl }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="ja" ogLocale="ja_JP">
  <Header jaPath="/ja/depression-test" />

  <main id="main-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-zinc-50" style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic UI', 'Yu Gothic', 'Noto Sans JP', Meiryo, sans-serif; line-height: 1.75; line-break: strict; word-break: normal; overflow-wrap: anywhere;">
    <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav aria-label="パンくずリスト" class="mb-6 flex flex-wrap items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
        <a href="/ja/" class="hover:text-blue-600 dark:hover:text-blue-400">ホーム</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-900 font-medium dark:text-zinc-100">うつ病セルフチェック（PHQ-9）</span>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1.5 text-xs font-semibold text-blue-700 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          PHQ-9（患者健康質問票-9）国際標準尺度
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl text-zinc-950 dark:text-white" style="text-wrap: balance;">
          うつ病 診断テスト｜PHQ-9セルフチェック
        </h1>
        <p class="mt-4 text-base text-zinc-600 dark:text-zinc-300 sm:text-lg leading-relaxed">
          国際的に標準化されたPHQ-9質問票に基づき、過去2週間の気分・睡眠・意欲・疲労感などの状態を9問で客観的に確認できる無料セルフチェックです。
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
          <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">所要時間 約3分</span>
          <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">完全無料・登録不要</span>
          <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">回答データ保存なし</span>
        </div>
      </header>

      <!-- Prominent Top Disclaimer (Verbatim) -->
      <div class="mx-auto mt-8 max-w-3xl rounded-2xl border border-amber-200 bg-amber-50/90 p-4.5 text-sm text-amber-950 dark:border-amber-900/50 dark:bg-amber-950/40 dark:text-amber-200" role="note">
        <p class="font-bold flex items-center gap-2">
          <svg class="h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
          医療に関する重要な注意事項
        </p>
        <p class="mt-2 text-xs sm:text-sm leading-relaxed">{CLINICAL_DISCLAIMER_JA}</p>
      </div>

      <!-- Immediate Safety Intervention Modal / Banner (Active if Item 9 > 0) -->
      <div id="safety-gate-banner" class="hidden mx-auto mt-6 max-w-3xl rounded-2xl border-2 border-red-300 bg-red-50 p-5 text-red-950 dark:border-red-800 dark:bg-red-950/60 dark:text-red-100" role="alert">
        <div class="flex items-start gap-3">
          <svg class="h-6 w-6 shrink-0 text-red-600 dark:text-red-400 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-bold text-base sm:text-lg text-red-900 dark:text-red-200">
              つらいお気持ちを抱えていらっしゃる方へ
            </h3>
            <p class="mt-1 text-xs sm:text-sm leading-relaxed">
              ご回答の中に強い苦痛や自傷・希死に関する項目が含まれていました。決してご自身だけで抱え込まず、以下の無料相談窓口や身近な医療機関に今すぐご連絡ください。いつでもあなたの声を受け止める場所があります。
            </p>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <a href="tel:0120279338" class="inline-flex items-center gap-1.5 rounded-lg bg-red-600 px-3.5 py-2 font-bold text-white shadow-sm hover:bg-red-700 min-h-[44px]">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" /></svg>
                よりそいホットライン（通話無料・24時間）：0120-279-338
              </a>
              <a href="#support" class="inline-flex items-center gap-1.5 rounded-lg border border-red-300 bg-white px-3.5 py-2 font-semibold text-red-800 hover:bg-red-50 dark:border-red-700 dark:bg-red-900/40 dark:text-red-200 min-h-[44px]">
                相談窓口一覧を見る（ページ下部）
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Depression PHQ-9 Interactive App -->
      <section id="depression-app" class="mx-auto mt-8 max-w-3xl" aria-label="うつ病PHQ-9セルフチェックアプリ">
        <div class="rounded-3xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-950/60 sm:p-8">
          
          <!-- Intro View -->
          <div id="depression-intro-view" class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 text-center">
            <h2 class="text-xl font-bold text-zinc-950 dark:text-white sm:text-2xl">セルフチェックを開始する前に</h2>
            <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed text-left">
              <strong>過去2週間（この2週間の間）</strong>のご自身の気分や心身の状態について、最も頻度が高かった選択肢をお選びください。全9問の回答完了後、国際基準による抑うつ重症度バンドと目安が表示されます。
            </p>
            <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
              <button id="btn-start" type="button" class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-blue-600 px-8 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-blue-700 active:scale-[0.97] dark:bg-blue-500 dark:hover:bg-blue-600 min-h-[44px]">
                チェックを開始する（全9問）
              </button>
            </div>
            <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">キーボード操作：数字キー 1〜4 で回答、← / → で前後の質問へ移動</p>
          </div>

          <!-- Question View (Hidden initially) -->
          <div id="depression-question-view" class="hidden" aria-live="polite">
            <div class="flex items-center justify-between text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-2">
              <span id="question-indicator">第 1 問 / 全 9 問</span>
              <span id="progress-percent">0% 完了</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800 mb-6">
              <div id="progress-bar" class="h-full bg-blue-600 dark:bg-blue-500 transition-all duration-300" style="width: 11.1%;"></div>
            </div>

            <div class="rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
              <span id="question-context-tag" class="inline-block rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-semibold text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 mb-3">
                興味・意欲
              </span>
              <h2 id="question-text" class="text-lg sm:text-xl font-bold text-zinc-950 dark:text-white leading-snug">
                質問文
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
                ※過去2週間のご自身の状態に最も当てはまるものを1つ選んでください。
              </p>

              <!-- Option buttons -->
              <div id="options-container" class="mt-6 grid gap-3" role="radiogroup" aria-label="回答選択肢">
                <!-- Dynamically populated via JS -->
              </div>

              <!-- Navigation Controls -->
              <div class="mt-6 flex items-center justify-between pt-4 border-t border-zinc-100 dark:border-zinc-800">
                <button id="btn-prev" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm font-medium text-zinc-700 hover:bg-zinc-50 active:scale-[0.98] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-750 min-h-[44px]">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                  前の質問へ
                </button>
                <button id="btn-next" type="button" class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed dark:bg-blue-500 dark:hover:bg-blue-600 min-h-[44px]">
                  <span>次の質問へ</span>
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Results View (Hidden initially) -->
          <div id="depression-result-view" class="hidden" aria-live="polite">
            <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900">
              <div class="text-center pb-6 border-b border-zinc-200 dark:border-zinc-800">
                <span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300">
                  PHQ-9 総合判定結果
                </span>
                <h2 id="result-title" class="mt-3 text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white">
                  抑うつ傾向の重症度目安
                </h2>
                <div class="mt-4 inline-flex items-baseline gap-2 rounded-2xl bg-zinc-100 px-6 py-4 dark:bg-zinc-800/80">
                  <span class="text-sm font-medium text-zinc-600 dark:text-zinc-400">PHQ-9 合計得点：</span>
                  <span id="result-score" class="text-3xl sm:text-4xl font-black text-blue-600 dark:text-blue-400">0</span>
                  <span class="text-lg font-bold text-zinc-600 dark:text-zinc-400">/ 27 点</span>
                </div>
                <div class="mt-3">
                  <span id="result-badge" class="inline-block rounded-lg px-3 py-1 text-sm font-bold"></span>
                </div>
              </div>

              <!-- Safety Alert in Results if Item 9 > 0 -->
              <div id="result-item9-alert" class="hidden mt-6 rounded-xl border border-red-300 bg-red-50 p-4 text-red-900 dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-200">
                <p class="font-bold text-sm sm:text-base flex items-center gap-2">
                  <svg class="h-5 w-5 text-red-600 dark:text-red-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                  【安全に関する重要なお知らせ】
                </p>
                <p class="mt-1 text-xs sm:text-sm leading-relaxed">
                  希死念慮や自傷に関する項目（第9問）で回答がありました。点数の高低に関わらず、つらい気持ちは一人で抱え込まず、信頼できる専門機関や24時間無料相談窓口へ今すぐご相談ください。
                </p>
                <a href="#support" class="mt-2 inline-block text-xs font-bold text-red-700 dark:text-red-300 underline underline-offset-2">
                  24時間相談窓口ディレクトリ（id="support"）へジャンプ →
                </a>
              </div>

              <!-- Result explanation narrative -->
              <div class="mt-6 space-y-4 text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                <div class="rounded-xl bg-zinc-50 p-4 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800">
                  <h3 class="font-bold text-zinc-950 dark:text-white text-sm sm:text-base">臨床的解釈の目安</h3>
                  <p id="result-interpretation" class="mt-1 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed"></p>
                </div>
                <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-4 dark:border-blue-900/50 dark:bg-blue-950/30">
                  <h3 class="font-bold text-blue-950 dark:text-blue-200 text-sm sm:text-base">受診・対処の推奨アクション</h3>
                  <p id="result-action" class="mt-1 text-xs sm:text-sm text-blue-900 dark:text-blue-300 leading-relaxed"></p>
                </div>
              </div>

              <!-- Item-by-item breakdown list -->
              <div class="mt-8">
                <h3 class="text-base font-bold text-zinc-950 dark:text-white sm:text-lg">
                  全9項目の回答一覧
                </h3>
                <div id="item-breakdown-list" class="mt-4 space-y-3">
                  <!-- Populated via JS -->
                </div>
              </div>

              <!-- Action buttons -->
              <div class="mt-8 flex flex-col sm:flex-row gap-3 pt-6 border-t border-zinc-200 dark:border-zinc-800">
                <button id="btn-print" type="button" class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-zinc-900 px-5 py-3 text-sm font-semibold text-white hover:bg-zinc-800 active:scale-[0.98] dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-200 min-h-[44px]">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.5A1.75 1.75 0 0116.75 8H17a2 2 0 012 2v5a2 2 0 01-2 2h-1v-2.25A1.75 1.75 0 0014.25 13h-8.5A1.75 1.75 0 004 14.75V17H3a2 2 0 01-2-2v-5a2 2 0 012-2h.25A1.75 1.75 0 015 6.25v-3.5zm1.5 0v3.5h7v-3.5h-7zM4 14.75c0-.138.112-.25.25-.25h11.5c.138 0 .25.112.25.25V18H4v-3.25z" clip-rule="evenodd" /></svg>
                  結果を印刷・PDF保存
                </button>
                <button id="btn-retake" type="button" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-300 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 active:scale-[0.98] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-750 min-h-[44px]">
                  もう一度チェックする
                </button>
              </div>

            </div>
          </div>

