  <!-- Depression PHQ-9 Screener Client Script -->
  <script is:inline>
    (() => {
      'use strict';

      const QUESTIONS = [
        {
          id: 1,
          text: '物事に対してほとんど興味がない、または楽しめない',
          context: '興味・喜びの喪失（アヘドニア）'
        },
        {
          id: 2,
          text: '気分が落ち込む、憂うつになる、または絶望的な気持ちになる',
          context: '抑うつ気分・絶望感'
        },
        {
          id: 3,
          text: '寝つきが悪い、途中で目がさめる、または逆に眠りすぎる',
          context: '睡眠障害（不眠または過眠）'
        },
        {
          id: 4,
          text: '疲れた感じがする、または気力・エネルギーがない',
          context: '易疲労性・エネルギー減退'
        },
        {
          id: 5,
          text: '食欲がない、または逆に食べすぎてしまう',
          context: '食欲不振または過食'
        },
        {
          id: 6,
          text: '自分はダメな人間だ、失敗者だと感じる、または自分や家族に申し訳ないと感じる',
          context: '無価値感・過剰な罪責感'
        },
        {
          id: 7,
          text: '新聞を読むことやテレビを見ることなど、物事に集中することが難しい',
          context: '集中力・思考力の減退'
        },
        {
          id: 8,
          text: '他の人が気づくほど動きや話し方が遅くなる、または逆に落ち着きがなくそわそわして動き回る',
          context: '精神運動焦燥または精神運動制止'
        },
        {
          id: 9,
          text: '死んだ方がましだ、あるいは自分を何らかの方法で傷つけようと思ったことがある',
          context: '自傷・希死念慮（セーフティゲート項目）'
        }
      ];

      const OPTIONS = [
        { value: 0, label: '全くない（0点）' },
        { value: 1, label: '数日ある（1点）' },
        { value: 2, label: '半分以上の日数（2点）' },
        { value: 3, label: 'ほぼ毎日（3点）' }
      ];

      const SEVERITY_INFO = {
        minimal: {
          label: 'ほとんどなし（軽微）',
          badgeClass: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
          interpretation: '抑うつ症状はほとんど認められないか、日常生活に支障をきたさない軽微なレベルです。',
          action: '現時点では積極的な治療介入は必要ないと判断されることが多いですが、十分な休養と睡眠、バランスのよい生活リズムを維持してください。'
        },
        mild: {
          label: '軽度の抑うつ傾向',
          badgeClass: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300',
          interpretation: '軽度の抑うつ傾向が見られます。疲労や生活ストレスの蓄積が心身に影響を与えている可能性があります。',
          action: '経過観察（経過を見守る）や生活習慣の見直し、休養が推奨されます。症状が2週間以上続く場合や悪化する場合は専門機関への相談をご検討ください。'
        },
        moderate: {
          label: '中等度の抑うつ傾向（カットオフ該当）',
          badgeClass: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
          interpretation: '中等度の抑うつ状態を示唆しており、国際的な臨床基準においてうつ病（大うつ病エピソード）のカットオフ値（10点以上）に該当します。',
          action: '心療内科や精神科などの専門医療機関を受診し、医師による詳しい診察やカウンセリングを受けることが推奨されます。'
        },
        moderately_severe: {
          label: '中等度〜重度の抑うつ傾向',
          badgeClass: 'bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300',
          interpretation: '顕著な抑うつ症状が認められ、日常生活や仕事、対人関係に明確な支障が生じている可能性が高い状態です。',
          action: '早期の専門医療機関（心療内科・精神科）受診が必要です。十分な休養と、医師の指導のもとでの適切な薬物療法や精神療法の検討が強く推奨されます。'
        },
        severe: {
          label: '重度の抑うつ傾向',
          badgeClass: 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300',
          interpretation: '重度の抑うつ状態を示唆しています。心身の負担が非常に大きく、早急な専門的ケアを要する水準です。',
          action: '一人で抱え込まず、できるだけ早く心療内科・精神科などの専門医を受診してください。身近な信頼できる人や各種相談窓口への連絡もご検討ください。'
        }
      };

      // Pure in-memory state - ZERO persistence to localStorage / cookies
      const state = {
        currentIndex: 0,
        answers: {}
      };

      const introView = document.getElementById('depression-intro-view');
      const questionView = document.getElementById('depression-question-view');
      const resultView = document.getElementById('depression-result-view');
      const safetyBanner = document.getElementById('safety-gate-banner');
      const btnStart = document.getElementById('btn-start');
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const btnRetake = document.getElementById('btn-retake');
      const btnPrint = document.getElementById('btn-print');
      const optionsContainer = document.getElementById('options-container');

      function showQuestion(index) {
        state.currentIndex = index;
        const q = QUESTIONS[index];
        const currentAnswer = state.answers[q.id];

        document.getElementById('question-indicator').textContent = `第 ${index + 1} 問 / 全 ${QUESTIONS.length} 問`;
        const progressPct = Math.round(((index + 1) / QUESTIONS.length) * 100);
        document.getElementById('progress-percent').textContent = `${progressPct}% 完了`;
        document.getElementById('progress-bar').style.width = `${progressPct}%`;
        document.getElementById('question-context-tag').textContent = q.context;
        document.getElementById('question-text').textContent = q.text;

        btnPrev.disabled = index === 0;
        btnPrev.style.visibility = index === 0 ? 'hidden' : 'visible';

        // Render options
        optionsContainer.innerHTML = '';
        OPTIONS.forEach((opt, optIdx) => {
          const isSelected = currentAnswer === opt.value;
          
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `flex w-full items-center justify-between rounded-xl border p-4 text-left text-sm sm:text-base font-medium transition min-h-[48px] active:scale-[0.98] ${
            isSelected
              ? 'border-blue-600 bg-blue-50/80 text-blue-950 font-bold dark:border-blue-500 dark:bg-blue-950/40 dark:text-blue-100 ring-2 ring-blue-500/20'
              : 'border-zinc-200 bg-white text-zinc-800 hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-850 dark:text-zinc-200 dark:hover:border-zinc-700'
          }`;
          
          btn.innerHTML = `
            <span class="flex items-center gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold ${
                isSelected
                  ? 'bg-blue-600 text-white dark:bg-blue-500'
                  : 'border border-zinc-300 text-zinc-500 dark:border-zinc-700 dark:text-zinc-400'
              }">${optIdx + 1}</span>
              <span>${opt.label}</span>
            </span>
          `;

          btn.addEventListener('click', () => {
            selectOption(q.id, opt.value);
          });

          optionsContainer.appendChild(btn);
        });

        const hasAnswered = currentAnswer !== undefined;
        btnNext.disabled = !hasAnswered;
        btnNext.querySelector('span').textContent = index === QUESTIONS.length - 1 ? '結果を表示する' : '次の質問へ';
      }

      function selectOption(qId, val) {
        state.answers[qId] = val;

        // Safety Gate: If Item 9 is answered > 0, show supportive crisis banner
        if (qId === 9 && val > 0) {
          safetyBanner.classList.remove('hidden');
        }

        showQuestion(state.currentIndex);

        // Auto advance after brief delay for smooth tactile flow
        setTimeout(() => {
          if (state.currentIndex < QUESTIONS.length - 1) {
            showQuestion(state.currentIndex + 1);
          } else {
            showResults();
          }
        }, 220);
      }

      function calculateScore() {
        let totalScore = 0;
        const itemResults = [];

        for (const q of QUESTIONS) {
          const val = state.answers[q.id] ?? 0;
          totalScore += val;

          const opt = OPTIONS.find(o => o.value === val) || OPTIONS[0];
          itemResults.push({
            questionId: q.id,
            questionText: q.text,
            context: q.context,
            responseLabel: opt.label,
            points: val
          });
        }

        const item9Val = state.answers[9] ?? 0;
        const hasItem9Risk = item9Val > 0;

        let bandKey = 'minimal';
        if (totalScore <= 4) bandKey = 'minimal';
        else if (totalScore <= 9) bandKey = 'mild';
        else if (totalScore <= 14) bandKey = 'moderate';
        else if (totalScore <= 19) bandKey = 'moderately_severe';
        else bandKey = 'severe';

        return {
          totalScore,
          hasItem9Risk,
          severity: SEVERITY_INFO[bandKey],
          itemResults
        };
      }

      function showResults() {
        questionView.classList.add('hidden');
        resultView.classList.remove('hidden');

        const { totalScore, hasItem9Risk, severity, itemResults } = calculateScore();

        document.getElementById('result-score').textContent = totalScore;
        const badgeEl = document.getElementById('result-badge');
        badgeEl.textContent = severity.label;
        badgeEl.className = `inline-block rounded-lg px-3 py-1.5 text-sm font-bold ${severity.badgeClass}`;

        document.getElementById('result-interpretation').textContent = severity.interpretation;
        document.getElementById('result-action').textContent = severity.action;

        const item9AlertEl = document.getElementById('result-item9-alert');
        if (hasItem9Risk) {
          item9AlertEl.classList.remove('hidden');
        } else {
          item9AlertEl.classList.add('hidden');
        }

        // Render item breakdown list
        const breakdownContainer = document.getElementById('item-breakdown-list');
        breakdownContainer.innerHTML = '';
        itemResults.forEach((item) => {
          const div = document.createElement('div');
          const isItem9 = item.questionId === 9;
          div.className = `flex flex-col sm:flex-row sm:items-center justify-between gap-2 rounded-xl border p-3.5 text-xs sm:text-sm ${
            isItem9 && item.points > 0
              ? 'border-red-300 bg-red-50/50 dark:border-red-900/40 dark:bg-red-950/20'
              : 'border-zinc-200 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-900/30'
          }`;
          div.innerHTML = `
            <div class="flex-1">
              <span class="font-bold text-zinc-900 dark:text-zinc-100">問${item.questionId}. ${item.context}</span>
              <p class="text-zinc-600 dark:text-zinc-400 text-xs mt-0.5">${item.questionText}</p>
            </div>
            <div class="flex items-center gap-2 self-start sm:self-center shrink-0">
              <span class="rounded bg-white px-2.5 py-1 font-semibold text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">${item.responseLabel}</span>
            </div>
          `;
          breakdownContainer.appendChild(div);
        });

        // Scroll smoothly to results
        resultView.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Event Listeners
      if (btnStart) {
        btnStart.addEventListener('click', () => {
          introView.classList.add('hidden');
          questionView.classList.remove('hidden');
          showQuestion(0);
        });
      }

      if (btnPrev) {
        btnPrev.addEventListener('click', () => {
          if (state.currentIndex > 0) {
            showQuestion(state.currentIndex - 1);
          }
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', () => {
          if (state.currentIndex < QUESTIONS.length - 1) {
            showQuestion(state.currentIndex + 1);
          } else {
            showResults();
          }
        });
      }

      if (btnRetake) {
        btnRetake.addEventListener('click', () => {
          state.currentIndex = 0;
          state.answers = {};
          safetyBanner.classList.add('hidden');
          resultView.classList.add('hidden');
          introView.classList.remove('hidden');
          introView.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      if (btnPrint) {
        btnPrint.addEventListener('click', () => {
          window.print();
        });
      }

      // Keyboard navigation
      window.addEventListener('keydown', (e) => {
        if (questionView && !questionView.classList.contains('hidden')) {
          if (['1', '2', '3', '4'].includes(e.key)) {
            const optVal = parseInt(e.key, 10) - 1;
            const q = QUESTIONS[state.currentIndex];
            selectOption(q.id, optVal);
          } else if (e.key === 'ArrowLeft' && state.currentIndex > 0) {
            showQuestion(state.currentIndex - 1);
          } else if (e.key === 'ArrowRight' && state.answers[QUESTIONS[state.currentIndex].id] !== undefined) {
            if (state.currentIndex < QUESTIONS.length - 1) {
              showQuestion(state.currentIndex + 1);
            } else {
              showResults();
            }
          }
        }
      });

    })();
  </script>
</Layout>
