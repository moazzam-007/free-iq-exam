        continent: document.getElementById('flag-continent-select'),
        startBtn: document.getElementById('start-flag-btn'),
        progress: document.getElementById('flag-progress'),
        liveScore: document.getElementById('flag-live-score'),
        liveStreak: document.getElementById('flag-live-streak'),
        targetImage: document.getElementById('flag-target-image'),
        countryTitle: document.getElementById('flag-country-title'),
        optionsGrid: document.getElementById('flag-options-grid'),
        resScore: document.getElementById('res-flag-score'),
        resTier: document.getElementById('res-flag-tier'),
        resDesc: document.getElementById('res-flag-desc'),
        resAccuracy: document.getElementById('res-flag-accuracy'),
        resReaction: document.getElementById('res-flag-reaction'),
        resCorrect: document.getElementById('res-flag-correct'),
        resMaxStreak: document.getElementById('res-flag-maxstreak'),
        missedWrap: document.getElementById('res-flag-missed-wrap'),
        missedList: document.getElementById('res-flag-missed-list'),
        retakeBtn: document.getElementById('retake-flag-btn'),
      };

      let mode = 'sprint';
      let pool = [];
      let score = 0, streak = 0, maxStreak = 0, correct = 0, answered = 0;
      let reactionSum = 0, questionStart = 0, totalQuestions = 20;
      let missed = [];

      function shuffle(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      function selectPool() {
        const cont = el.continent.value;
        return cont === 'all' ? COUNTRIES_DB.slice() : COUNTRIES_DB.filter(c => c.continent === cont);
      }

      function buildOptions(correctCountry) {
        const candidates = COUNTRIES_DB.filter(c => c.code !== correctCountry.code);
        const others = shuffle(candidates).slice(0, 3);
        const opts = shuffle([correctCountry, ...others]);
        return opts;
      }

      function startQuiz() {
        mode = el.modeBtns.find(b => b.classList.contains('active')).dataset.mode;
        pool = selectPool();
        score = 0; streak = 0; maxStreak = 0; correct = 0; answered = 0;
        reactionSum = 0; missed = [];
        if (mode === 'survival') totalQuestions = Infinity;
        else if (mode === 'hard') totalQuestions = 15;
        else totalQuestions = 20;

        el.startCard.classList.add('hidden');
        el.resultsCard.classList.add('hidden');
        el.arenaCard.classList.remove('hidden');
        el.liveScore.textContent = '0';
        el.liveStreak.textContent = '0x';
        nextQuestion();
      }

      function nextQuestion() {
        if (answered >= totalQuestions) { finish(); return; }
        const question = pool[Math.floor(Math.random() * pool.length)];
        const options = buildOptions(question);
        const isReverse = mode === 'reverse';

        el.progress.textContent = `問題 ${answered + 1} / ${totalQuestions === Infinity ? '∞' : totalQuestions}`;
        if (isReverse) {
          el.targetImage.classList.add('hidden');
          el.countryTitle.classList.remove('hidden');
          el.countryTitle.textContent = `${question.name}（首都：${question.capital}）`;
        } else {
          el.countryTitle.classList.add('hidden');
          el.targetImage.classList.remove('hidden');
          el.targetImage.src = `https://flagcdn.com/w320/${question.code}.png`;
          el.targetImage.alt = `${question.name}の国旗`;
        }

        el.optionsGrid.innerHTML = '';
        options.forEach(opt => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'option-btn flex items-center gap-3 p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 text-left cursor-pointer transition-all hover:border-[#0066cc] dark:hover:border-[#2997ff] active:scale-[0.98] min-h-[44px]';
          if (isReverse) {
            const img = document.createElement('img');
            img.src = `https://flagcdn.com/w320/${opt.code}.png`;
            img.alt = `${opt.name}の国旗`;
            img.className = 'w-12 h-8 object-cover rounded shadow';
            const span = document.createElement('span');
            span.className = 'text-sm font-bold text-zinc-800 dark:text-zinc-200';
            span.textContent = opt.name;
            btn.appendChild(img);
            btn.appendChild(span);
          } else {
            const span = document.createElement('span');
            span.className = 'text-sm font-bold text-zinc-800 dark:text-zinc-200';
            span.textContent = opt.name;
            btn.appendChild(span);
          }
          btn.addEventListener('click', () => handleAnswer(question, opt, btn));
          el.optionsGrid.appendChild(btn);
        });

        questionStart = performance.now();
      }

      function handleAnswer(question, chosen, btn) {
        const reaction = performance.now() - questionStart;
        reactionSum += reaction;
        answered += 1;
        const isCorrect = chosen.code === question.code;

        Array.from(el.optionsGrid.children).forEach(b => {
          const isRight = b.textContent.includes(question.name) || (mode === 'reverse' && b.querySelector('img') && b.querySelector('img').src.includes(question.code));
          if (b.textContent.includes(question.name) || b.querySelector('img') && b.querySelector('img').src.includes(question.code)) {
            b.classList.add('correct');
          }
        });

        if (isCorrect) {
          correct += 1;
          streak += 1;
          maxStreak = Math.max(maxStreak, streak);
          const timeBonus = Math.max(0, 200 - reaction) / 100;
          score += Math.round(10 + streak * 2 + timeBonus * 5);
          playTone(880);
        } else {
          streak = 0;
          score = Math.max(0, score - 5);
          playTone(160);
          missed.push({ code: question.code, name: question.name, capital: question.capital });
        }
        if (isCorrect) btn.classList.add('correct'); else btn.classList.add('wrong');

        el.liveScore.textContent = String(score);
        el.liveStreak.textContent = streak + 'x';
        Array.from(el.optionsGrid.children).forEach(b => b.style.pointerEvents = 'none');

        if (!isCorrect && mode === 'survival') {
          setTimeout(() => finish(), 650);
          return;
        }

        setTimeout(() => { if (answered >= totalQuestions) finish(); else nextQuestion(); }, 650);
      }

      function playTone(freq) {
        try {
          const ctx = new (window.AudioContext || window.webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
          osc.connect(gain).connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.12);
        } catch (e) {}
      }

      function finish() {
        el.arenaCard.classList.add('hidden');
        el.resultsCard.classList.remove('hidden');
        const accuracy = answered ? Math.round((correct / answered) * 100) : 0;
        const avgReaction = answered ? Math.round(reactionSum / answered) : 0;

        el.resScore.textContent = String(score);
        el.resAccuracy.textContent = accuracy + '%';
        el.resReaction.textContent = avgReaction + 'ms';
        el.resCorrect.textContent = `${correct} / ${answered}`;
        el.resMaxStreak.textContent = maxStreak + 'x';

        const pct = answered ? correct / answered : 0;
        let tier, desc;
        if (pct >= 0.95) { tier = 'ベクシロジーの達人'; desc = '驚異的な視覚記憶力です。ほぼ全ての国旗を見分けました。'; }
        else if (pct >= 0.85) { tier = '国旗マイスター'; desc = '高い正答率で、双子旗も見分けています。'; }
        else if (pct >= 0.7) { tier = '地理愛好家'; desc = 'しっかりとした地理知識をお持ちです。'; }
        else if (pct >= 0.5) { tier = '学びの途中'; desc = '良いスタートです。復習リストでさらに磨きましょう。'; }
        else { tier = '入門者'; desc = 'これから国旗を覚える絶好の機会です。'; }
        el.resTier.textContent = tier;
        el.resDesc.textContent = desc;

        if (missed.length) {
          el.missedWrap.classList.remove('hidden');
          el.missedList.innerHTML = '';
          missed.forEach(m => {
            const row = document.createElement('div');
            row.className = 'flex items-center gap-3 p-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800';
            row.innerHTML = `<img src="https://flagcdn.com/w320/${m.code}.png" alt="${m.name}の国旗" class="w-12 h-8 object-cover rounded shadow"><div><p class="text-sm font-bold text-zinc-800 dark:text-zinc-200">${m.name}</p><p class="text-xs text-zinc-500">首都：${m.capital}</p></div>`;
            el.missedList.appendChild(row);
          });
        } else {
          el.missedWrap.classList.add('hidden');
        }
      }

      el.modeBtns.forEach(b => {
        b.addEventListener('click', () => {
          el.modeBtns.forEach(x => x.classList.remove('active'));
          b.classList.add('active');
        });
      });

      el.startBtn.addEventListener('click', startQuiz);
      el.retakeBtn.addEventListener('click', () => {
        el.resultsCard.classList.add('hidden');
        el.startCard.classList.remove('hidden');
      });
    })();
  </script>
</Layout>
