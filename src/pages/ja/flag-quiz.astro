---
// Japanese Flag Quiz
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const alternates = {
  'en': 'https://freeiqexam.com/flag-quiz',
  'ru': 'https://freeiqexam.com/ru/flag-quiz',
  'id': 'https://freeiqexam.com/id/kuis-bendera',
  'de': 'https://freeiqexam.com/de/flaggen-quiz',
  'ja': 'https://freeiqexam.com/ja/flag-quiz',
};

const title = "国旗クイズ｜世界195カ国の国旗を当てる無料ゲーム | FreeIQExam";
const description = "世界の国旗を4択で当てる無料クイズ。初級・中級（地域別）・上級の3レベル、連続正解記録つき。正解後は首都や豆知識も表示します。";
const canonicalUrl = "https://freeiqexam.com/ja/flag-quiz";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam 世界の国旗クイズ＆地理記憶力アリーナ",
    "url": canonicalUrl,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "inLanguage": "ja",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" },
    "featureList": [
      "世界各国の国旗データベース",
      "4つのゲームモード：20問スプリント・サバイバル・逆引き・ベクシロジー難問",
      "地域フィルター（全て・ヨーロッパ・アジア・アメリカ・アフリカ・オセアニア）",
      "ミリ秒単位の反応時間測定",
      "ストリーク倍率とWeb Audioによる効果音合成"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://freeiqexam.com/ja" },
      { "@type": "ListItem", "position": 2, "name": "世界の国旗クイズ", "item": canonicalUrl }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="ja">
  <Header currentPath="/ja/flag-quiz" />

  <style>
    .flag-img { image-rendering: auto; }
    .flag-mode-btn.active { border-color: #0066cc !important; color: #0066cc !important; }
    .dark .flag-mode-btn.active { border-color: #2997ff !important; color: #2997ff !important; }
    .option-btn.correct { border-color: #10b981 !important; background: rgba(16,185,129,0.12) !important; }
    .option-btn.wrong { border-color: #ef4444 !important; background: rgba(239,68,68,0.12) !important; }
    details summary::-webkit-details-marker { display: none; }
    details[open] summary .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="min-h-screen flex-1 w-full bg-white dark:bg-black text-zinc-900 dark:text-zinc-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">

      <nav class="flex items-center gap-2 mb-8 text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400" aria-label="パンくずリスト">
        <a href="/ja" class="hover:text-zinc-950 dark:hover:text-white transition-colors">ホーム</a>
        <span aria-hidden="true">/</span>
        <span class="text-zinc-900 dark:text-zinc-100">世界の国旗クイズ</span>
      </nav>

      <header class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 dark:border-blue-900 bg-blue-50 dark:bg-blue-950/40 px-4 py-2 text-xs sm:text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
          <span class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"></span>
          <span>空間地理 · 視覚記憶トレーニング</span>
        </div>
        <h1 class="font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
          世界の国旗クイズ
        </h1>
        <p class="mt-5 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
          世界各国の国旗を見分ける視覚パターン認識と地理知識をテスト。反応時間を測りながら、
          似ている双子旗すら見分けられるかを挑戦します。
        </p>
      </header>

      <section aria-label="国旗クイズ" class="max-w-3xl mx-auto">
        <div class="relative rounded-3xl bg-zinc-50 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 shadow-2xl p-6 sm:p-8">

          <div id="flag-start-card" class="space-y-6">
            <div class="text-center space-y-2">
              <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white tracking-tight">クイズ設定を選ぶ</h2>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">ゲームモードと地域フィルターを選択してください。</p>
            </div>

            <div class="space-y-2">
              <label class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">ゲームモード</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <button type="button" data-mode="sprint" class="flag-mode-btn active p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border-2 border-[#0066cc] dark:border-[#2997ff] text-[#0066cc] dark:text-[#2997ff] text-left transition-all cursor-pointer">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm">20問スプリント</span>
                    <span class="text-xs font-mono opacity-80">標準</span>
                  </div>
                  <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">正答率と素早い反応時間を測る標準の20ラウンド検定。</p>
                </button>
                <button type="button" data-mode="survival" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm">エンドレス・サバイバル</span>
                    <span class="text-xs font-mono text-rose-500">サドンデス</span>
                  </div>
                  <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">最初に間違えるまで続行。点数倍率がどんどん上がります。</p>
                </button>
                <button type="button" data-mode="reverse" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm">逆引きモード</span>
                    <span class="text-xs font-mono text-[#0066cc] dark:text-[#2997ff]">名前 → 旗</span>
                  </div>
                  <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">国名と首都から4つの選択肢の中から正しい旗を探します。</p>
                </button>
                <button type="button" data-mode="hard" class="flag-mode-btn p-3.5 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 text-left transition-all cursor-pointer">
                  <div class="flex items-center justify-between mb-1">
                    <span class="font-bold text-sm">ベクシロジー難問</span>
                    <span class="text-xs font-mono text-amber-500">双子旗</span>
                  </div>
                  <p class="text-[11px] text-zinc-600 dark:text-zinc-400 leading-tight">混同しやすい旗の組み合わせ（例：チャド vs ルーマニア）に挑戦。</p>
                </button>
              </div>
            </div>

            <div class="space-y-2">
              <label for="flag-continent-select" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">地域フィルター</label>
              <div class="relative">
                <select id="flag-continent-select" class="w-full p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-semibold text-zinc-900 dark:text-white focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors appearance-none cursor-pointer">
                  <option value="all">全世界（全国家）</option>
                  <option value="Europe">ヨーロッパ</option>
                  <option value="Asia">アジア</option>
                  <option value="Americas">アメリカ</option>
                  <option value="Africa">アフリカ</option>
                  <option value="Oceania">オセアニア</option>
                </select>
                <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-zinc-400 text-xs">▼</div>
              </div>
            </div>

            <button id="start-flag-btn" type="button" class="w-full py-4 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-base tracking-wide uppercase transition-all duration-200 shadow-sm active:scale-[0.97] cursor-pointer">
              クイズを開始
            </button>
          </div>

          <div id="flag-arena-card" class="hidden space-y-6">
            <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
              <div class="space-y-0.5">
                <span id="flag-progress" class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">問題 1 / 20</span>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-zinc-700 dark:text-zinc-300">得点:</span>
                  <span id="flag-live-score" class="text-base font-extrabold font-mono text-[#0066cc] dark:text-[#2997ff]">0</span>
                </div>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
                <span class="text-xs text-zinc-500 dark:text-zinc-400">連続:</span>
                <span id="flag-live-streak" class="text-sm font-extrabold font-mono text-amber-500">0x</span>
              </div>
            </div>

            <div class="flex flex-col items-center justify-center py-4 space-y-4">
              <div class="relative p-2 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl overflow-hidden max-w-sm w-full flex items-center justify-center min-h-[160px]">
                <img id="flag-target-image" src="" alt="国旗" class="flag-img max-h-40 w-auto rounded-lg shadow object-contain" />
              </div>
              <h3 id="flag-country-title" class="hidden text-xl sm:text-2xl font-extrabold text-zinc-950 dark:text-white text-center tracking-tight"></h3>
            </div>

            <div id="flag-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          </div>

          <div id="flag-results-card" class="hidden space-y-8">
            <div class="text-center space-y-2 p-6 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
              <span class="text-xs font-mono uppercase tracking-widest text-[#0066cc] dark:text-[#2997ff]">クイズ完了</span>
              <div id="res-flag-score" class="text-4xl sm:text-6xl font-mono font-bold text-zinc-900 dark:text-white">0</div>
              <div class="flex items-center justify-center gap-2 pt-1">
                <span id="res-flag-tier" class="px-3 py-1 rounded-full bg-blue-500/20 text-[#0066cc] dark:text-[#2997ff] font-extrabold text-xs tracking-wide">ベクシロジーの達人</span>
              </div>
              <p id="res-flag-desc" class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-md mx-auto pt-2 leading-relaxed"></p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
              <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">正答率</span>
                <div id="res-flag-accuracy" class="text-lg sm:text-xl font-bold font-mono text-zinc-950 dark:text-white">0%</div>
              </div>
              <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">反応時間</span>
                <div id="res-flag-reaction" class="text-lg sm:text-xl font-bold font-mono text-[#0066cc] dark:text-[#2997ff]">0ms</div>
              </div>
              <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">正解</span>
                <div id="res-flag-correct" class="text-lg sm:text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400">0 / 0</div>
              </div>
              <div class="p-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-0.5">
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">最大連続</span>
                <div id="res-flag-maxstreak" class="text-lg sm:text-xl font-bold font-mono text-amber-500">0x</div>
              </div>
            </div>

            <div id="res-flag-missed-wrap" class="hidden space-y-3">
              <h4 class="text-xs font-mono uppercase tracking-wider text-rose-500">復習したい間違い</h4>
              <div id="res-flag-missed-list" class="space-y-2 max-h-60 overflow-y-auto pr-1"></div>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <button id="retake-flag-btn" type="button" class="flex-1 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-extrabold text-sm uppercase tracking-wider transition-all duration-200 shadow-sm active:scale-[0.97] cursor-pointer">
                もう一度プレイ
              </button>
            </div>
          </div>

        </div>
      </section>

      <section class="mt-20 sm:mt-28 border-t border-zinc-200 dark:border-zinc-800 pt-16 sm:pt-20 max-w-3xl mx-auto">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">視覚記憶 · ベクシロジー</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white">国旗の認識と視覚記憶のメカニズム</h2>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
          人間の視覚記憶は、幾何学的な形・色のコントラスト・空間配置を一次視覚野（V1〜V4）で並列処理します。国旗の認識は
          <strong class="text-zinc-900 dark:text-white">Paivioの二重符号化理論</strong>に基づき、画像情報（旗の見た目）と意味的知識（国名・大陸・首都）が記憶の中で同時に結びつくことで成立します。
        </p>

        <div class="mt-7 rounded-3xl border border-blue-200 dark:border-blue-900 bg-blue-50/70 dark:bg-blue-950/25 p-6 sm:p-7">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">国旗デザインの5つの基本原則（ベクシロジー）</p>
          <ul class="mt-4 space-y-2 text-sm sm:text-base">
            <li><strong>1. 単純性：</strong>子供が記憶から描けるほどシンプル（例：日本、スイス）。</li>
            <li><strong>2. 意味のある象徴：</strong>色や図形が国の歴史・文化・自然を表す。</li>
            <li><strong>3. 2〜3色の基本色：</strong>赤・青・黄・緑・白・黒などコントラストの高い色を使う。</li>
            <li><strong>4. 文字や国章を避ける：</strong>遠くや風に揺れている状態では読めない。</li>
            <li><strong>5. 独自性：</strong>誤認を避け、意図的な地域共有（例：北欧十字）以外は似せない。</li>
          </ul>
        </div>
      </section>

      <section class="max-w-3xl mx-auto pt-16 border-t border-zinc-200 dark:border-zinc-800 mt-16">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-600 dark:text-zinc-400 uppercase tracking-wider mb-2">よくある質問</div>
          <h2 class="font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">国旗クイズに関するQ&amp;A</h2>
        </div>
        <div class="space-y-3">
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>国旗クイズの点数はどう計算される？</span>
              <span class="faq-chevron ml-4 shrink-0 text-zinc-400 transition-transform duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">総合点は正答率・ミリ秒単位の反応時間・連続正解（ストリーク）の倍率を組み合わせて算出します。速く正確に答え続けるほど高得点になります。</p>
          </details>
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>なぜチャドとルーマニアの旗はほぼ同じに見えるの？</span>
              <span class="faq-chevron ml-4 shrink-0 text-zinc-400 transition-transform duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">チャドとルーマニアは、歴史的に独立した経緯から同じ「青・黄・赤」の縦三色旗を採用しています。モナコとインドネシアも同じ赤白の二色旗ですが、縦横比（モナコ4:5 vs インドネシア2:3）で区別できます。</p>
          </details>
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>国旗クイズは視覚記憶のトレーニングになる？</span>
              <span class="faq-chevron ml-4 shrink-0 text-zinc-400 transition-transform duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">はい。視覚的な色とパターン＋意味的な国データの組み合わせは、長期記憶のシナプス結合を強化します。繰り返し学習することで国旗と国名の関連づけが固まります。</p>
          </details>
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>ゲームデータや結果は外部サーバーに保存される？</span>
              <span class="faq-chevron ml-4 shrink-0 text-zinc-400 transition-transform duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">いいえ。クイズも判定も100%ブラウザ内で完結します。スコアはあなたの端末のlocalStorageにのみ保存され、外部サーバーには送信されません。</p>
          </details>
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>特定の大陸だけに絞ってプレイできる？</span>
              <span class="faq-chevron ml-4 shrink-0 text-zinc-400 transition-transform duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
