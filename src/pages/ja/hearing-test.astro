<script is:inline>
  (function() {
    let audioCtx = null;
    let isCalibrated = false;

    let answersMode1 = {}; // { 20000: 'yes'|'no', ... }
    let ptSelectedFreq = 250;

    // DOM Elements
    const playCalibBtn = document.getElementById('play-calib-btn');
    const confirmCalibBtn = document.getElementById('confirm-calib-btn');
    const calibStatusBadge = document.getElementById('calib-status-badge');
    const testContentArea = document.getElementById('test-content-area');

    const playFreqBtns = document.querySelectorAll('.play-freq-btn');
    const ansBtns = document.querySelectorAll('.ans-btn');
    const earAgeResult = document.getElementById('ear-age-result');

    const ptFreqBtns = document.querySelectorAll('.pt-freq-btn');
    const testLeftBtn = document.getElementById('test-left-btn');
    const testRightBtn = document.getElementById('test-right-btn');

    function initAudio() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    // Pure Sine Tone Player with anti-popping smooth 20ms envelope
    function playPureTone(freq, panValue, durationSec) {
      initAudio();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const panner = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;

      const duration = durationSec || 2.5;
      const now = audioCtx.currentTime;

      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, now);

      // Smooth envelope: 20ms fade-in, 20ms fade-out
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.12, now + 0.03);
      gain.gain.setValueAtTime(0.12, now + duration - 0.05);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

      if (panner) {
        panner.pan.setValueAtTime(panValue || 0, now);
        osc.connect(gain);
        gain.connect(panner);
        panner.connect(audioCtx.destination);
      } else {
        osc.connect(gain);
        gain.connect(audioCtx.destination);
      }

      osc.start(now);
      osc.stop(now + duration);
    }

    // Step 0 Calibration Event Listeners
    if (playCalibBtn) {
      playCalibBtn.addEventListener('click', function() {
        playPureTone(1000, 0, 3.0);
      });
    }

    if (confirmCalibBtn) {
      confirmCalibBtn.addEventListener('click', function() {
        isCalibrated = true;
        calibStatusBadge.textContent = '完了 (固定済)';
        calibStatusBadge.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';

        testContentArea.classList.remove('opacity-50', 'pointer-events-none');
      });
    }

    // Mode 1: Mosquito Frequency Play Buttons
    playFreqBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const freq = parseFloat(btn.getAttribute('data-freq'));
        playPureTone(freq, 0, 2.0);
      });
    });

    // Mode 1: Answer buttons
    ansBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const freq = btn.getAttribute('data-freq');
        const ans = btn.getAttribute('data-ans');

        answersMode1[freq] = ans;

        // Highlight selected answer button
        const siblingBtns = btn.parentElement.querySelectorAll('.ans-btn');
        siblingBtns.forEach(b => {
          b.className = 'ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 font-medium text-zinc-400';
        });

        if (ans === 'yes') {
          btn.className = 'ans-btn flex-1 py-1.5 rounded-lg border border-blue-500 bg-blue-50 dark:bg-blue-950/40 font-bold text-[#0066cc] dark:text-[#2997ff]';
        } else {
          btn.className = 'ans-btn flex-1 py-1.5 rounded-lg border border-zinc-500 bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-700 dark:text-zinc-300';
        }

        evaluateEarAge();
      });
    });

    function evaluateEarAge() {
      // Find highest frequency heard
      const freqs = [20000, 17400, 15000, 12000, 10000, 8000];
      let maxHeard = null;

      for (let i = 0; i < freqs.length; i++) {
        if (answersMode1[freqs[i]] === 'yes') {
          maxHeard = freqs[i];
          break;
        }
      }

      if (maxHeard === 20000) {
        earAgeResult.textContent = '推定耳年齢: 10代以下（18歳未満相当）';
      } else if (maxHeard === 17400) {
        earAgeResult.textContent = '推定耳年齢: 20代前半以下（24歳未満相当）';
      } else if (maxHeard === 15000) {
        earAgeResult.textContent = '推定耳年齢: 20代後半〜30歳未満相当';
      } else if (maxHeard === 12000) {
        earAgeResult.textContent = '推定耳年齢: 30代〜40歳未満相当';
      } else if (maxHeard === 10000) {
        earAgeResult.textContent = '推定耳年齢: 40代〜50歳未満相当';
      } else if (maxHeard === 8000) {
        earAgeResult.textContent = '推定耳年齢: 50代〜60歳以上相当';
      } else {
        earAgeResult.textContent = '周波数ごとの回答を入力してください';
      }
    }

    // Mode 2: Frequency Selector
    ptFreqBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        ptFreqBtns.forEach(b => {
          b.className = 'pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold';
        });
        btn.className = 'pt-freq-btn py-2.5 rounded-xl border border-blue-500 bg-blue-50 dark:bg-blue-950/40 text-xs font-bold text-[#0066cc] dark:text-[#2997ff]';

        ptSelectedFreq = parseFloat(btn.getAttribute('data-pt-freq'));
      });
    });

    if (testLeftBtn) {
      testLeftBtn.addEventListener('click', function() {
        playPureTone(ptSelectedFreq, -1.0, 2.0); // pan left = -1
        updateChartStatus(ptSelectedFreq, 'L可聴');
      });
    }

    if (testRightBtn) {
      testRightBtn.addEventListener('click', function() {
        playPureTone(ptSelectedFreq, 1.0, 2.0); // pan right = +1
        updateChartStatus(ptSelectedFreq, 'R可聴');
      });
    }

    function updateChartStatus(freq, statusText) {
      const el = document.getElementById('status-' + freq);
      if (el) {
        el.textContent = statusText;
      }
    }
  })();
</script>
