---
// Japanese Hearing Test
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const title = "聴力検査 オンライン｜モスキート音で耳年齢チェック | FreeIQExam";
const description = "8,000〜20,000Hzのモスキート音による耳年齢チェックと、250〜8,000Hzの純音による簡易聴力チェック。左右別に確認できます。※医療用の検査ではありません。";
const canonicalUrl = "https://freeiqexam.com/ja/hearing-test";

const alternates = {
  en: "https://freeiqexam.com/hearing-test",
  fi: "https://freeiqexam.com/fi/kuulotesti",
  de: "https://freeiqexam.com/de/hoertest",
  nl: "https://freeiqexam.com/nl/gehoortest",
  ja: "https://freeiqexam.com/ja/hearing-test"
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam オンライン簡易聴力チェック・モスキート音耳年齢測定",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires Web Audio API support and stereo headphones",
    "inLanguage": "ja",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "JPY"
    },
    "featureList": [
      "1,000Hz基準音によるセーフティ音量キャリブレーション機能",
      "8,000Hz〜20,000Hz モスキート音による耳年齢推定チェック",
      "250Hz〜8,000Hz 純音による左右別（StereoPannerNode）簡易聴力バランスチェック",
      "結果の簡易参考グラフ表示機能",
      "ポップノイズ防止用の20msフェードイン・フェードアウト波形制御"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://freeiqexam.com/ja/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "オンライン聴力セルフチェック",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="ja"
>
  <Header currentPath="/ja/hearing-test" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-10 pb-6 px-4 sm:px-6 max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-[#2997ff] border border-blue-500/20 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Web Audio 純音合成 &amp; モスキート音チェックエンジン</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight mb-4 leading-tight">
        オンライン聴力セルフチェック・耳年齢
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        モスキート音（高周波）による耳年齢の測定と、左右別（ステレオイヤホン必須）の純音聴力セルフチェック。医療用検査ではない簡易スクリーニングガイドです。
      </p>

      <!-- Purpose Notice Banner -->
      <div class="mt-6 p-4 rounded-xl bg-blue-50/80 dark:bg-zinc-900/90 border border-blue-200/80 dark:border-zinc-800 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 text-left sm:text-center max-w-3xl mx-auto shadow-sm">
        <div class="flex items-start sm:items-center justify-center gap-2.5">
          <svg class="w-5 h-5 shrink-0 text-[#0066cc] dark:text-[#2997ff] mt-0.5 sm:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong>ご注意：</strong>本オンラインセルフチェックは医療用の聴力検査（臨床オージオメトリー）ではありません。聴力障害や耳鳴りの自己診断を目的としたものではありません。</span>
        </div>
      </div>
    </section>

    <!-- Top Disclaimer -->
    <section class="px-4 sm:px-6 max-w-3xl mx-auto mb-8">
      <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        <p>
          <strong>【推奨使用環境】</strong>必ず<strong>ステレオヘッドホンまたはイヤホン</strong>を装着し、静かな部屋でご使用ください。スマホ内蔵スピーカーでは左右別のチェックや高周波モスキート音が正しく再生されない場合があります。
        </p>
      </div>
    </section>

    <!-- Step 0: Mandatory Volume Calibration Panel -->
    <section class="px-4 sm:px-6 max-w-3xl mx-auto mb-10">
      <div class="bg-zinc-950 text-white rounded-3xl p-6 sm:p-8 border border-zinc-800 shadow-xl space-y-6">
        
        <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#0066cc] text-white flex items-center justify-center font-bold text-sm">
              0
            </span>
            <div>
              <h2 class="text-base sm:text-lg font-bold text-white">
                Step 0: 音量キャリブレーション（必須）
              </h2>
              <p class="text-xs text-zinc-400">
                聴覚保護のため、検査開始前に基準音（1,000 Hz）で音量を調整します。
              </p>
            </div>
          </div>
          <span id="calib-status-badge" class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
            未完了
          </span>
        </div>

        <div class="space-y-4">
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
            下の「基準音（1,000 Hz）を試聴」ボタンを押し、お使いの端末やイヤホンの音量を調節して、<strong>「かすかに聞こえる程度」の静かな音量</strong>に設定してください。
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <button
              type="button"
              id="play-calib-btn"
              class="px-5 py-3 rounded-xl bg-[#0066cc] hover:bg-blue-600 text-white text-xs sm:text-sm font-bold flex items-center gap-2 shadow-md transition-all active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span>基準音 (1,000 Hz) を試聴 (3秒)</span>
            </button>

            <button
              type="button"
              id="confirm-calib-btn"
              class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold transition-all active:scale-95"
            >
              音量を固定した（検査を開始する）
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- Main Test Modes Container (Disabled until Step 0 is completed) -->
    <section id="test-content-area" class="px-4 sm:px-6 max-w-4xl mx-auto pb-16 opacity-50 pointer-events-none transition-opacity duration-300 space-y-12">
      
      <!-- MODE 1: Mosquito Sound Ear Age Check -->
      <div class="bg-white dark:bg-zinc-900/90 rounded-3xl p-6 sm:p-8 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-6">
        
        <div>
          <div class="inline-block px-3 py-1 rounded-md bg-blue-100 dark:bg-blue-950/60 text-[#0066cc] dark:text-[#2997ff] text-xs font-bold uppercase tracking-wider mb-2">
            Mode 1
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">
            モスキート音 耳年齢チェック
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            加齢とともに高周波音（モスキート音）に対する感度が低下する傾向に基づいた簡易目安ガイドです。
          </p>
        </div>

        <!-- Warning Note regarding phone speakers -->
        <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 text-xs text-zinc-600 dark:text-zinc-400">
          ※スマホ内蔵スピーカーや一部のイヤホンは、高周波（15,000Hz〜20,000Hz）を出力できないハードウェア仕様の場合があります。聞こえない場合でも機器の再生限界による可能性があります。
        </div>

        <!-- Frequency Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          
          <!-- 20,000 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">20,000 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">10代以下 (18歳未満)</span>
              </div>
              <button
                type="button"
                data-freq="20000"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="20000Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="20000" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="20000" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

          <!-- 17,400 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">17,400 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">24歳未満</span>
              </div>
              <button
                type="button"
                data-freq="17400"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="17400Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="17400" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="17400" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

          <!-- 15,000 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">15,000 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">30歳未満</span>
              </div>
              <button
                type="button"
                data-freq="15000"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="15000Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="15000" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="15000" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

          <!-- 12,000 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">12,000 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">40歳未満</span>
              </div>
              <button
                type="button"
                data-freq="12000"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="12000Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="12000" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="12000" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

          <!-- 10,000 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">10,000 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">50歳未満</span>
              </div>
              <button
                type="button"
                data-freq="10000"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="10000Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="10000" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="10000" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

          <!-- 8,000 Hz -->
          <div class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-lg font-extrabold text-zinc-900 dark:text-white">8,000 Hz</span>
                <span class="block text-xs font-semibold text-blue-600 dark:text-blue-400">60歳以上</span>
              </div>
              <button
                type="button"
                data-freq="8000"
                class="play-freq-btn p-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 hover:bg-[#0066cc] hover:text-white dark:hover:bg-[#2997ff] transition-colors"
                aria-label="8000Hz再生"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="flex gap-2 text-xs">
              <button type="button" data-freq="8000" data-ans="yes" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-blue-500 font-medium">聞こえる</button>
              <button type="button" data-freq="8000" data-ans="no" class="ans-btn flex-1 py-1.5 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-500 font-medium text-zinc-400">聞こえない</button>
            </div>
          </div>

        </div>

        <!-- Mode 1 Result Box -->
        <div class="p-6 rounded-2xl bg-zinc-900 text-white flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <div class="text-xs uppercase tracking-wider text-zinc-400">
              推定耳年齢ガイド
            </div>
            <div id="ear-age-result" class="text-2xl sm:text-3xl font-extrabold text-[#2997ff] mt-1">
              周波数ボタンを押して試聴してください
            </div>
          </div>
        </div>

      </div>

      <!-- MODE 2: Stereo Pure Tone Screening (250Hz - 8,000Hz) -->
      <div class="bg-white dark:bg-zinc-900/90 rounded-3xl p-6 sm:p-8 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-6">
        
        <div>
          <div class="inline-block px-3 py-1 rounded-md bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider mb-2">
            Mode 2
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">
            左右別 簡易純音チェック
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            250Hz〜8,000Hzの純音を用いて、左耳（Left）と右耳（Right）の可聴バランスを確認します。
          </p>
        </div>

        <!-- Pure Tone Controls -->
        <div class="space-y-4">
          <div class="grid grid-cols-2 sm:grid-cols-6 gap-2">
            <button type="button" data-pt-freq="250" class="pt-freq-btn py-2.5 rounded-xl border border-blue-500 bg-blue-50 dark:bg-blue-950/40 text-xs font-bold text-[#0066cc] dark:text-[#2997ff]">250 Hz</button>
            <button type="button" data-pt-freq="500" class="pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold">500 Hz</button>
            <button type="button" data-pt-freq="1000" class="pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold">1,000 Hz</button>
            <button type="button" data-pt-freq="2000" class="pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold">2,000 Hz</button>
            <button type="button" data-pt-freq="4000" class="pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold">4,000 Hz</button>
            <button type="button" data-pt-freq="8000" class="pt-freq-btn py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-xs font-bold">8,000 Hz</button>
          </div>

          <!-- Channel Testing Buttons -->
          <div class="grid grid-cols-2 gap-4">
            <button
              type="button"
              id="test-left-btn"
              class="p-4 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-md transition-all active:scale-95"
            >
              <span>左耳（L）で試聴</span>
            </button>
            <button
              type="button"
              id="test-right-btn"
              class="p-4 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm sm:text-base flex items-center justify-center gap-2 shadow-md transition-all active:scale-95"
            >
              <span>右耳（R）で試聴</span>
            </button>
          </div>
        </div>

        <!-- Result Reference Chart -->
        <div>
          <h3 class="text-sm font-bold text-zinc-900 dark:text-white mb-2">
            簡易グラフ（参考）
          </h3>
          <div class="p-4 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-3">
            <div class="flex justify-between text-xs text-zinc-400">
              <span>周波数 (Hz)</span>
              <span>可聴反応ステータス</span>
            </div>
            <div class="grid grid-cols-6 gap-2 text-center text-xs font-mono">
              <div class="p-2 rounded bg-zinc-900 border border-zinc-800">
                <div class="text-[10px] text-zinc-500">250Hz</div>
                <div id="status-250" class="font-bold text-emerald-400 mt-1">-</div>
              </div>
              <div class="p-2 rounded bg-zinc-900 border border-zinc-800">
                <div class="text-[10px] text-zinc-500">500Hz</div>
                <div id="status-500" class="font-bold text-emerald-400 mt-1">-</div>
              </div>
              <div class="p-2 rounded bg-zinc-900 border border-zinc-800">
                <div class="text-[10px] text-zinc-500">1kHz</div>
                <div id="status-1000" class="font-bold text-emerald-400 mt-1">-</div>
