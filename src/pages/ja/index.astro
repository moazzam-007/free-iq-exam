---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const title = "FreeIQExam 日本語｜無料の認知・心理セルフチェックツール集";
const description = "登録不要・無料で使えるIQテスト、ADHDやうつ病のセルフチェック、タイピング練習、基礎代謝・カロリー計算、メメントモリ人生時計など、科学的根拠に基づく測定ツールをまとめています。";
const canonicalUrl = "https://freeiqexam.com/ja/";
const alternates = {}; // Central directory hub

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection-page`,
    "name": title,
    "url": canonicalUrl,
    "inLanguage": "ja",
    "description": description,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 15,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "無料IQテスト（24問マトリックス推理）", "url": "https://freeiqexam.com/ja/iq-test" },
        { "@type": "ListItem", "position": 2, "name": "メンサ向け練習テスト（高難度マトリックス）", "url": "https://freeiqexam.com/ja/mensa-test" },
        { "@type": "ListItem", "position": 3, "name": "メメントモリ・人生時計（4,000週間カレンダー）", "url": "https://freeiqexam.com/ja/memento-mori" },
        { "@type": "ListItem", "position": 4, "name": "大人のADHDセルフチェック（ASRS v1.1）", "url": "https://freeiqexam.com/ja/adhd-test" },
        { "@type": "ListItem", "position": 5, "name": "自閉スペクトラム症セルフチェック（AQ-10）", "url": "https://freeiqexam.com/ja/autism-test" },
        { "@type": "ListItem", "position": 6, "name": "うつ病セルフチェック（PHQ-9）", "url": "https://freeiqexam.com/ja/depression-test" },
        { "@type": "ListItem", "position": 7, "name": "基礎代謝・カロリー計算（TDEE・BMR）", "url": "https://freeiqexam.com/ja/calorie-calculator" },
        { "@type": "ListItem", "position": 8, "name": "ホワイトノイズ音源生成器", "url": "https://freeiqexam.com/ja/white-noise" },
        { "@type": "ListItem", "position": 9, "name": "オンライン聴力検査（可聴域・耳年齢）", "url": "https://freeiqexam.com/ja/hearing-test" },
        { "@type": "ListItem", "position": 10, "name": "タイピング練習・打鍵速度測定", "url": "https://freeiqexam.com/ja/typing-test" },
        { "@type": "ListItem", "position": 11, "name": "CPSテスト（クリック速度測定）", "url": "https://freeiqexam.com/ja/cps-test" },
        { "@type": "ListItem", "position": 12, "name": "反射神経テスト（視覚反応速度ms）", "url": "https://freeiqexam.com/ja/reaction-time-test" },
        { "@type": "ListItem", "position": 13, "name": "色覚テスト（石原式22枚プレート）", "url": "https://freeiqexam.com/ja/color-blind-test" },
        { "@type": "ListItem", "position": 14, "name": "国旗クイズ（世界195カ国暗記）", "url": "https://freeiqexam.com/ja/flag-quiz" }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://freeiqexam.com/ja/"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="ja"
>
  <Header currentPath="/ja/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">

    <!-- HERO SECTION (Pure flat canvas — strictly ZERO radial glow) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden border-b border-zinc-200/80 dark:border-zinc-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>FREEIQEXAM 日本語 — 15 FLAGSHIP TOOLS</span>
        </div>

        <h1 class="font-heading font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-tight leading-[1.18] mb-6">
          無料の認知・心理<br class="hidden sm:inline" />
          <span class="text-zinc-500 dark:text-zinc-400">
            セルフチェックツール集
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          登録不要・完全無料。現代の心理測定科学とアルゴリズムに基づく知能テスト、臨床尺度スクリーニング、感覚・運動能力チェックをブラウザ上で即座に実行できます。
        </p>

        <!-- CTA Action Area -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
          <a
            href="/ja/iq-test"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0055b3] dark:bg-[#2997ff] dark:hover:bg-[#1a80e5] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97] shadow-sm"
          >
            <span>無料IQテストを開始する</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a
            href="/ja/memento-mori"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-zinc-100 dark:bg-zinc-900 hover:bg-zinc-200 dark:hover:bg-zinc-800 text-zinc-900 dark:text-white font-semibold text-sm sm:text-base border border-zinc-300 dark:border-zinc-800 transition-all duration-200 active:scale-[0.97]"
          >
            <span>メメントモリ人生時計</span>
            <svg class="w-4 h-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- MAIN TOOLS DIRECTORY (4 STRICT CATEGORIES) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 space-y-16">

      <!-- CATEGORY 1: 知能・論理思考 -->
      <section>
        <div class="mb-6">
          <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-1.5">Category 01</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
            知能・論理思考
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            視覚的マトリックス問題と項目応答理論（IRT）に基づく抽象的推論能力の測定。
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- IQ Test Card -->
          <a
            href="/ja/iq-test"
            class="group p-6 sm:p-7 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m4.93 4.93 4.24 4.24" /><path d="m14.83 9.17 4.24-4.24" /><path d="m14.83 14.83 4.24 4.24" /><path d="m9.17 14.83-4.24 4.24" /><circle cx="12" cy="12" r="4" /></svg>
                </span>
                <span class="text-[11px] font-bold font-mono px-2.5 py-1 rounded-full bg-blue-500/10 text-[#0066cc] dark:text-[#2997ff] border border-blue-500/20">
                  24問 / 20分
                </span>
              </div>
              <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                無料IQテスト（24問マトリックス推理）
              </h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2.5">
                流動性知能（Gf）を測定する24問の標準化テスト。ウェクスラー尺度（平均100・SD15）に基づく推定IQ、日本の偏差値（Tスコア）、パーセンタイル順位を即時算出します。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
              テストを受験する &rarr;
            </span>
          </a>

          <!-- Mensa Practice Test Card -->
          <a
            href="/ja/mensa-test"
            class="group p-6 sm:p-7 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12l4 6-10 12L2 9z" /><path d="M11 3 8 9l4 12 4-12-3-6" /><path d="M2 9h20" /></svg>
                </span>
                <span class="text-[11px] font-bold font-mono px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                  高難度 / 上位2%
                </span>
              </div>
              <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                メンサ向け練習テスト（高難度マトリックス）
              </h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2.5">
                メンサ（Mensa）入会基準の目安であるIQ130前後（第98パーセンタイル）を意識した高難度マトリックス演習。流動性知能と多重ルールの分析力を鍛えます。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
              高難度問題に挑戦 &rarr;
            </span>
          </a>
        </div>
      </section>

      <!-- CATEGORY 2: メンタルヘルス・発達スクリーニング -->
      <section>
        <div class="mb-6">
          <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-1.5">Category 02</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
            メンタルヘルス・発達スクリーニング
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            国際的に標準化された医学研究基準に基づくセルフチェック。自己理解と専門医相談の判断材料に。
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- ADHD Test -->
          <a
            href="/ja/adhd-test"
            class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a4.5 4.5 0 0 0-4.5 4.5c0 1.5.8 2.8 2 3.6V14h5V10.1c1.2-.8 2-2.1 2-3.6A4.5 4.5 0 0 0 12 2Z" /><path d="M9.5 17h5" /><path d="M10 20h4" /></svg>
                </span>
                <span class="text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  WHO ASRS v1.1
                </span>
              </div>
              <h3 class="font-bold text-base text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                大人のADHDセルフチェック
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
                WHO共同開発の標準スクリーニング。不注意や衝動性の特性傾向を客観的にチェック。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-4">
              チェックを開始 &rarr;
            </span>
          </a>

          <!-- Autism Spectrum (AQ-10) -->
          <a
            href="/ja/autism-test"
            class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="8" x="2" y="2" rx="2" /><rect width="8" height="8" x="14" y="2" rx="2" /><rect width="8" height="8" x="2" y="14" rx="2" /><rect width="8" height="8" x="14" y="14" rx="2" /></svg>
                </span>
                <span class="text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  AQ-10
                </span>
              </div>
              <h3 class="font-bold text-base text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                自閉スペクトラム症（ASD）チェック
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
                ケンブリッジ大学自閉症研究センター作成。社会的コミュニケーション特性の簡易評価。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-4">
              チェックを開始 &rarr;
            </span>
          </a>

          <!-- Depression (PHQ-9) -->
          <a
            href="/ja/depression-test"
            class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                </span>
                <span class="text-[11px] font-bold font-mono px-2 py-0.5 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  PHQ-9
                </span>
              </div>
              <h3 class="font-bold text-base text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                うつ病セルフチェック
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
                臨床現場で広く採用されるPHQ-9尺度。気分の落ち込みや睡眠、疲労度を自己評価。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-4">
              チェックを開始 &rarr;
            </span>
          </a>
        </div>
      </section>

      <!-- CATEGORY 3: スピード・感覚・ゲーム -->
      <section>
        <div class="mb-6">
          <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-1.5">Category 03</p>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
            スピード・感覚・ゲーム
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            キーボード入力速度、ミリ秒単位の神経反応、色覚・聴覚知覚、地理的記憶のトレーニング。
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Typing Speed -->
          <a
            href="/ja/typing-test"
            class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="12" x="2" y="6" rx="2" /><circle cx="6" cy="10" r="1" /><circle cx="10" cy="10" r="1" /><circle cx="14" cy="10" r="1" /><circle cx="18" cy="10" r="1" /><circle cx="6" cy="14" r="1" /><circle cx="18" cy="14" r="1" /><path d="M10 14h4" /></svg>
                </span>
                <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">1分間測定</span>
              </div>
              <h3 class="font-bold text-base text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
                タイピング練習・速度測定
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
                ローマ字および英語入力の1分間打鍵速度（CPM/WPM）と正確性を測定。
              </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-4">
              タイピング開始 &rarr;
            </span>
          </a>

          <!-- Reflex / Reaction Time Test -->
          <a
            href="/ja/reaction-time-test"
            class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                </span>
