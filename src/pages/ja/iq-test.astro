---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';
import { getStandardTestSet } from '../../data/questions';

const title = "IQテスト 無料｜24問で知能指数と偏差値の目安を測定 | FreeIQExam";
const description = "登録不要・完全無料の24問マトリックス推理IQテスト。パターン認識と論理的推理力を測定し、推定IQ（平均100・SD15）、偏差値、パーセンタイルを即時表示。";
const canonicalUrl = "https://freeiqexam.com/ja/iq-test";

const alternates = {
  'en': 'https://freeiqexam.com/test',
  'nl': 'https://freeiqexam.com/nl/iq-test',
  'de': 'https://freeiqexam.com/de/iq-test',
  'pt-BR': 'https://freeiqexam.com/pt-br/teste-de-qi',
  'ja': 'https://freeiqexam.com/ja/iq-test'
};

// Select 24 standardized questions across 4 CHC domains
const selectedItems = getStandardTestSet();

const sanitizedBank = selectedItems.map((q) => ({
  id: q.id,
  domain: q.domain,
  subType: q.subType,
  domainLabel: q.domainLabel,
  promptType: q.promptType,
  promptText: q.promptText,
  promptSvg: q.promptSvg ?? null,
  a: q.a,
  b: q.b,
  options: q.options.map((opt) => ({
    id: opt.id,
    text: opt.text ?? '',
    svgContent: opt.svgContent ?? null,
  })),
}));

const bankJson = JSON.stringify(sanitizedBank);

// Answer key token for client scoring
const answerKeyToken = Buffer.from(
  JSON.stringify(
    selectedItems.reduce((acc, q) => {
      const correctOpt = q.options.find((o) => o.isCorrect);
      acc[q.id] = {
        c: correctOpt ? correctOpt.id : 1,
        exp: q.explanation || '',
      };
      return acc;
    }, {} as Record<number, { c: number; exp: string }>)
  )
).toString('base64');

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "無料オンラインIQテスト（24問マトリックス推理）",
    "description": "2パラメータ・ロジスティック（2PL）項目応答理論に基づく24問の視覚的認知テスト。流動性知能（Gf）、空間視覚処理（Gv）、量的推理（Gq）、論理的類推（Gc）を測定。",
    "url": canonicalUrl,
    "inLanguage": "ja",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "about": {
      "@type": "Thing",
      "name": "知能指数 (IQ)"
    },
    "timeRequired": "PT20M",
    "numberOfQuestions": 24
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "無料IQテスト 2026",
    "url": canonicalUrl,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "inLanguage": "ja",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "JPY"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://freeiqexam.com/ja/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "無料IQテスト",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="ja"
>
  <!-- Distraction-Free Sticky Navigation Bar -->
  <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">

      <!-- Brand / Exit Trigger -->
      <a
        href="/ja/"
        class="flex items-center gap-2.5 group text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xl p-1.5 -ml-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        aria-label="トップページへ戻る"
      >
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] flex items-center justify-center text-white font-bold text-base shadow-xs transition-opacity group-hover:opacity-90">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-base sm:text-lg tracking-tight text-zinc-950 dark:text-white leading-tight">
            Free<span class="text-[#0066cc] dark:text-[#2997ff]">IQ</span>Exam
          </span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">テスト終了・戻る</span>
        </div>
      </a>

      <!-- Center: Live Countdown Timer and Item Counter -->
      <div class="flex items-center gap-3 sm:gap-6">
        <div
          id="timer-container"
          class="flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors duration-300"
          role="timer"
          aria-live="polite"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="timer-display" class="font-mono text-sm sm:text-base font-medium tracking-tight text-zinc-800 dark:text-zinc-200">
            20:00
          </span>
        </div>

        <!-- Question Counter Badge -->
        <div class="hidden sm:flex items-center gap-1 text-sm font-medium text-zinc-500 dark:text-zinc-400">
          <span>問題</span>
          <span id="stat-current" class="font-bold text-zinc-900 dark:text-white">1</span>
          <span>/</span>
          <span class="font-semibold text-zinc-900 dark:text-white">24</span>
        </div>
      </div>

      <!-- Right: Finish Action -->
      <div class="flex items-center gap-2">
        <button
          id="btn-top-submit"
          type="button"
          class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[44px] flex items-center cursor-pointer active:scale-[0.97]"
        >
          テストを完了
        </button>
      </div>

    </div>
  </header>

  <main class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    
    <!-- TEST RUNNER CONTAINER -->
    <div id="test-runner-container" class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

      <!-- Test Title & Introduction (Single H1) -->
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h1 class="font-heading font-extrabold text-2xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight mb-2">
          無料IQテスト（24問マトリックス推理）
        </h1>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
          登録不要・完全無料。図形パターンと論理的推理力から推定知能指数と偏差値を測定します。
        </p>
      </div>

      <!-- Assessment Card -->
      <div class="rounded-3xl bg-zinc-50/90 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 shadow-sm overflow-hidden p-6 sm:p-10 mb-10">

        <!-- Card Header: Category Badge & Mobile Counter -->
        <div class="flex items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="domain-badge" class="px-3 py-1 rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-mono font-bold tracking-wide uppercase">
              流動性知能
            </span>
            <span id="domain-category" class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              抽象的帰納推論 (Gf)
            </span>
          </div>

          <div class="sm:hidden text-xs font-mono font-bold text-zinc-600 dark:text-zinc-400">
            問題 <span id="mobile-q-num">1</span> / 24
          </div>
        </div>

        <!-- Question Prompt Heading -->
        <div class="mb-6 text-center sm:text-left">
          <h2 id="question-prompt-text" class="text-lg sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center">
            空欄に入る最も論理的な図形を選択してください：
          </h2>
        </div>

        <!-- Stimulus Display Box -->
        <div class="flex justify-center mb-8">
          <div
            id="stimulus-card"
            class="w-full max-w-[340px] sm:max-w-[420px] aspect-square rounded-2xl bg-white dark:bg-black border border-zinc-200 dark:border-zinc-800 flex items-center justify-center p-4 sm:p-6 shadow-inner relative overflow-hidden"
          >
            <div id="stimulus-container" class="w-full h-full flex items-center justify-center">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Options Header Hint -->
        <div class="flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400 mb-3 px-1">
          <span>選択肢（1つ選択）</span>
          <span id="answered-indicator" class="font-mono">未選択</span>
        </div>

        <!-- Interactive Options Grid -->
        <div
          id="options-grid"
          class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 mb-8"
          role="radiogroup"
          aria-label="回答の選択肢"
        >
          <!-- Options injected via JS -->
        </div>

        <!-- Card Footer: Navigation Controls -->
        <div class="flex items-center justify-between gap-4 pt-6 border-t border-zinc-200/80 dark:border-zinc-800">
          <button
            id="btn-prev"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 text-sm font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[44px] cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed active:scale-[0.97]"
            disabled
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
            <span>前の問題</span>
          </button>

          <button
            id="btn-next"
            type="button"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white text-sm font-semibold hover:opacity-90 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[44px] cursor-pointer active:scale-[0.97]"
          >
            <span id="btn-next-text">次の問題</span>
            <svg id="btn-next-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </button>
        </div>

      </div>

      <!-- Quick Question Jump Navigator -->
      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 mb-12">
        <div class="flex items-center justify-between mb-3 text-xs">
          <span class="font-bold text-zinc-700 dark:text-zinc-300">問題一覧</span>
          <span class="font-mono text-zinc-500"><span id="stat-answered">0</span> / 24 回答済み</span>
        </div>
        <div id="navigator-strip" class="grid grid-cols-6 sm:grid-cols-12 gap-1.5 sm:gap-2">
          <!-- 24 buttons injected via JS -->
        </div>
      </div>

    </div>

    <!-- IN-PAGE RESULTS CONTAINER (Hidden by default, shown upon completion) -->
    <div id="results-container" class="hidden max-w-4xl mx-auto px-4 sm:px-6 py-10">
      
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-mono font-bold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>テスト完了・採点結果</span>
        </div>
        <h2 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight mb-3">
          あなたの推定知能指数と偏差値
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          項目応答理論（IRT 2PLモデル）およびウェクスラー尺度に基づく推定結果です。
        </p>
      </div>

      <!-- Main Score Hero Card -->
      <div class="rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 p-6 sm:p-10 mb-8 shadow-sm">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center mb-8 pb-8 border-b border-zinc-200 dark:border-zinc-800">
          <!-- Estimated IQ -->
          <div class="p-5 rounded-2xl bg-white dark:bg-black border border-zinc-200/80 dark:border-zinc-800">
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">推定知能指数（IQ）</div>
            <div id="res-iq" class="font-heading font-extrabold text-4xl sm:text-6xl text-[#0066cc] dark:text-[#2997ff] my-1">115</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400">平均100 / SD 15</div>
          </div>

          <!-- T-Score (偏差値) -->
          <div class="p-5 rounded-2xl bg-white dark:bg-black border border-zinc-200/80 dark:border-zinc-800">
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">日本の偏差値（Tスコア）</div>
            <div id="res-tscore" class="font-heading font-extrabold text-4xl sm:text-6xl text-zinc-950 dark:text-white my-1">60.0</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400">50 + 10*(IQ-100)/15</div>
          </div>

          <!-- Percentile Rank -->
          <div class="p-5 rounded-2xl bg-white dark:bg-black border border-zinc-200/80 dark:border-zinc-800">
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">パーセンタイル順位</div>
            <div id="res-percentile" class="font-heading font-extrabold text-4xl sm:text-6xl text-emerald-600 dark:text-emerald-400 my-1">84.1%</div>
            <div id="res-rank-text" class="text-xs text-zinc-500 dark:text-zinc-400">上位 15.9% 相当</div>
          </div>
        </div>

        <!-- Performance Summary & Raw Accuracy -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
          <div>
            <div class="text-xs font-mono text-zinc-500">分類区分</div>
            <div id="res-classification" class="text-lg font-bold text-zinc-950 dark:text-white">平均の上 (High Average)</div>
          </div>
          <div class="text-right sm:text-right">
            <div class="text-xs font-mono text-zinc-500">正答率</div>
            <div id="res-raw-score" class="text-lg font-bold text-zinc-950 dark:text-white font-mono">18 / 24 問 正解 (75%)</div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <button
            id="btn-download-badge"
            type="button"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white font-semibold text-sm hover:opacity-90 transition-all cursor-pointer min-h-[44px] active:scale-[0.97]"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            <span>スコアバッジ画像を保存（PNG）</span>
          </button>
          <button
            id="btn-retake"
            type="button"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white font-semibold text-sm border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-all cursor-pointer min-h-[44px] active:scale-[0.97]"
          >
            <span>もう一度テストを受ける</span>
          </button>
        </div>

      </div>

      <!-- Hidden canvas for badge rendering -->
      <canvas id="badge-canvas" width="1200" height="630" class="hidden"></canvas>

    </div>

    <!-- EDUCATIONAL CONTENT & SCIENTIFIC FOUNDATIONS -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 border-t border-zinc-200 dark:border-zinc-800 space-y-12">

      <!-- SECTION 1: BELL CURVE & PERCENTILE EXPLAINER -->
      <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800">
        <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white mb-4">
          IQの正規分布（ベルカーブ）とパーセンタイル
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
          現代の知能指数（ウェクスラー式偏差IQ）は、同年代の母集団において平均値を100、標準偏差を15（SD15）とする正規分布曲線を描くように設計されています。全体の約68.2%がIQ 85〜115の範囲に収まり、IQ 130以上は全体の約2.2%（上位50人に1人の水準）に該当します。
        </p>

        <!-- Conversion Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 font-mono">
                <th class="py-2.5 pr-4 font-semibold">推定IQ (SD15)</th>
                <th class="py-2.5 px-4 font-semibold">日本の偏差値</th>
                <th class="py-2.5 px-4 font-semibold">パーセンタイル</th>
                <th class="py-2.5 pl-4 font-semibold">一般的な知能分類</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200/60 dark:divide-zinc-800/60 text-zinc-700 dark:text-zinc-300">
              <tr>
                <td class="py-2.5 pr-4 font-mono font-bold text-[#0066cc] dark:text-[#2997ff]">130 以上</td>
                <td class="py-2.5 px-4 font-mono font-semibold">70.0 以上</td>
                <td class="py-2.5 px-4 font-mono">上位 2.2%</td>
                <td class="py-2.5 pl-4 font-semibold text-amber-600 dark:text-amber-400">極めて優秀 (メンサ入会目安)</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4 font-mono font-bold">120 〜 129</td>
                <td class="py-2.5 px-4 font-mono">63.3 〜 69.3</td>
                <td class="py-2.5 px-4 font-mono">上位 9.1% 〜 2.3%</td>
                <td class="py-2.5 pl-4">優秀 (Superior)</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4 font-mono font-bold">110 〜 119</td>
                <td class="py-2.5 px-4 font-mono">56.7 〜 62.7</td>
                <td class="py-2.5 px-4 font-mono">上位 25.2% 〜 9.2%</td>
                <td class="py-2.5 pl-4">平均の上 (High Average)</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4 font-mono font-bold">90 〜 109</td>
                <td class="py-2.5 px-4 font-mono">43.3 〜 56.0</td>
                <td class="py-2.5 px-4 font-mono">約 50% 帯 (49.9%)</td>
                <td class="py-2.5 pl-4">平均的 (Average)</td>
              </tr>
              <tr>
                <td class="py-2.5 pr-4 font-mono font-bold">80 〜 89</td>
                <td class="py-2.5 px-4 font-mono">36.7 〜 42.7</td>
                <td class="py-2.5 px-4 font-mono">下位 9.2% 〜 25.1%</td>
                <td class="py-2.5 pl-4">平均の下 (Low Average)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- SECTION 2: 3 COGNITIVE PILLARS -->
      <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800">
        <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white mb-4">
          本テストが測定する認知の3側面（CHC理論）
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-6">
          <div class="p-4 rounded-2xl bg-white dark:bg-black border border-zinc-200/80 dark:border-zinc-800">
            <h3 class="font-bold text-base text-zinc-950 dark:text-white mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
              流動性知能 (Gf)
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              過去の知識や言語経験に依存せず、初めて遭遇する新しい問題に対して論理的パターンや因果則を見出す根本的な思考力です。
