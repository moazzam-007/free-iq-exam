<!-- Client Runner Script -->
<script define:vars={{ bankJson, answerKeyToken }}>
  (function () {
    var questions = JSON.parse(bankJson);
    var TOTAL_QUESTIONS = questions.length;
    var currentIndex = 0;
    var userAnswers = {}; // questionId -> optionId
    var startTime = Date.now();
    var durationSeconds = 20 * 60; // 20 minutes
    var timerInterval = null;
    var isSubmitted = false;

    // Domain display names in Japanese
    var DOMAIN_MAP = {
      fluid: { badge: '流動性知能', category: '抽象的帰納推論 (Gf)' },
      spatial: { badge: '視覚空間処理', category: 'パターン変換・空間把握 (Gv)' },
      quantitative: { badge: '量的・数理推理', category: '論理演算・関係把握 (Gq)' },
      verbal: { badge: '結晶性・論理推理', category: '概念分析・論理類推 (Gc)' }
    };

    // DOM Elements
    var timerDisplay = document.getElementById('timer-display');
    var timerContainer = document.getElementById('timer-container');
    var statCurrent = document.getElementById('stat-current');
    var mobileQNum = document.getElementById('mobile-q-num');
    var domainBadge = document.getElementById('domain-badge');
    var domainCategory = document.getElementById('domain-category');
    var promptText = document.getElementById('question-prompt-text');
    var stimulusContainer = document.getElementById('stimulus-container');
    var optionsGrid = document.getElementById('options-grid');
    var answeredIndicator = document.getElementById('answered-indicator');
    var btnPrev = document.getElementById('btn-prev');
    var btnNext = document.getElementById('btn-next');
    var btnNextText = document.getElementById('btn-next-text');
    var btnTopSubmit = document.getElementById('btn-top-submit');
    var navigatorStrip = document.getElementById('navigator-strip');
    var statAnswered = document.getElementById('stat-answered');
    var testRunnerContainer = document.getElementById('test-runner-container');
    var resultsContainer = document.getElementById('results-container');

    // Build question navigator strip
    function initNavigator() {
      navigatorStrip.innerHTML = '';
      for (var i = 0; i < TOTAL_QUESTIONS; i++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'h-9 rounded-lg font-mono text-xs font-semibold flex items-center justify-center transition-all cursor-pointer border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black text-zinc-700 dark:text-zinc-300 hover:border-[#0066cc] dark:hover:border-[#2997ff] active:scale-[0.95]';
        btn.textContent = String(i + 1);
        btn.setAttribute('aria-label', '問題 ' + (i + 1) + ' へ移動');
        (function (idx) {
          btn.addEventListener('click', function () {
            goToQuestion(idx);
          });
        })(i);
        navigatorStrip.appendChild(btn);
      }
      updateNavigator();
    }

    function updateNavigator() {
      var buttons = navigatorStrip.children;
      var answeredCount = 0;
      for (var i = 0; i < TOTAL_QUESTIONS; i++) {
        var qId = questions[i].id;
        var btn = buttons[i];
        var isAnswered = userAnswers[qId] !== undefined;
        if (isAnswered) answeredCount++;

        if (i === currentIndex) {
          btn.className = 'h-9 rounded-lg font-mono text-xs font-bold flex items-center justify-center transition-all cursor-pointer ring-2 ring-[#0066cc] dark:ring-[#2997ff] bg-blue-50 dark:bg-blue-950/60 text-[#0066cc] dark:text-[#2997ff] border-transparent';
        } else if (isAnswered) {
          btn.className = 'h-9 rounded-lg font-mono text-xs font-semibold flex items-center justify-center transition-all cursor-pointer bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-white border-transparent';
        } else {
          btn.className = 'h-9 rounded-lg font-mono text-xs font-semibold flex items-center justify-center transition-all cursor-pointer border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black text-zinc-700 dark:text-zinc-300 hover:border-[#0066cc] dark:hover:border-[#2997ff]';
        }
      }
      if (statAnswered) statAnswered.textContent = String(answeredCount);
    }

    function renderCurrentQuestion() {
      var q = questions[currentIndex];
      
      // Update counters
      statCurrent.textContent = String(currentIndex + 1);
      mobileQNum.textContent = String(currentIndex + 1);

      // Domain info
      var dInfo = DOMAIN_MAP[q.domain] || { badge: '一般知能', category: 'マトリックス推論' };
      domainBadge.textContent = dInfo.badge;
      domainCategory.textContent = dInfo.category;

      // Question prompt
      promptText.textContent = '空欄に入る最も論理的な図形を選択してください：';

      // Stimulus container (SVG or Text)
      stimulusContainer.innerHTML = '';
      if (q.promptSvg) {
        stimulusContainer.innerHTML = q.promptSvg;
      } else if (q.promptText) {
        var p = document.createElement('div');
        p.className = 'text-center font-mono font-bold text-xl sm:text-2xl text-zinc-900 dark:text-white p-4';
        p.textContent = q.promptText;
        stimulusContainer.appendChild(p);
      }

      // Answered indicator
      var currentAnswer = userAnswers[q.id];
      if (currentAnswer !== undefined) {
        answeredIndicator.textContent = '回答済み';
        answeredIndicator.className = 'font-mono text-emerald-600 dark:text-emerald-400 font-semibold';
      } else {
        answeredIndicator.textContent = '未選択';
        answeredIndicator.className = 'font-mono text-zinc-400 dark:text-zinc-500';
      }

      // Render options
      optionsGrid.innerHTML = '';
      q.options.forEach(function (opt, oIdx) {
        var optBtn = document.createElement('button');
        optBtn.type = 'button';
        optBtn.setAttribute('role', 'radio');
        optBtn.setAttribute('aria-checked', currentAnswer === opt.id ? 'true' : 'false');
        optBtn.setAttribute('aria-label', '選択肢 ' + String.fromCharCode(65 + oIdx));

        var isSelected = currentAnswer === opt.id;
        var baseClasses = 'p-3 sm:p-4 rounded-2xl border transition-all cursor-pointer flex flex-col items-center justify-center min-h-[90px] sm:min-h-[110px] active:scale-[0.97] relative ';
        if (isSelected) {
          optBtn.className = baseClasses + 'border-[#0066cc] dark:border-[#2997ff] bg-blue-50/80 dark:bg-blue-950/40 ring-2 ring-[#0066cc] dark:ring-[#2997ff] shadow-sm';
        } else {
          optBtn.className = baseClasses + 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black hover:border-zinc-400 dark:hover:border-zinc-600';
        }

        // Letter pill
        var pill = document.createElement('span');
        pill.className = 'absolute top-2 left-2 text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-md ' + 
          (isSelected ? 'bg-[#0066cc] text-white' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-500');
        pill.textContent = String.fromCharCode(65 + oIdx);
        optBtn.appendChild(pill);

        // Content
        if (opt.svgContent) {
          var svgWrap = document.createElement('div');
          svgWrap.className = 'w-12 h-12 sm:w-16 sm:h-16 flex items-center justify-center pointer-events-none mt-2';
          svgWrap.innerHTML = opt.svgContent;
          optBtn.appendChild(svgWrap);
        } else if (opt.text) {
          var textEl = document.createElement('div');
          textEl.className = 'font-mono text-base sm:text-lg font-bold text-zinc-900 dark:text-white mt-3';
          textEl.textContent = opt.text;
          optBtn.appendChild(textEl);
        }

        optBtn.addEventListener('click', function () {
          userAnswers[q.id] = opt.id;
          renderCurrentQuestion();
          updateNavigator();
        });

        optionsGrid.appendChild(optBtn);
      });

      // Update button states
      btnPrev.disabled = currentIndex === 0;
      if (currentIndex === TOTAL_QUESTIONS - 1) {
        btnNextText.textContent = '完了して結果を見る';
      } else {
        btnNextText.textContent = '次の問題';
      }

      updateNavigator();
    }

    function goToQuestion(index) {
      if (index >= 0 && index < TOTAL_QUESTIONS) {
        currentIndex = index;
        renderCurrentQuestion();
      }
    }

    btnPrev.addEventListener('click', function () {
      if (currentIndex > 0) {
        goToQuestion(currentIndex - 1);
      }
    });

    btnNext.addEventListener('click', function () {
      if (currentIndex < TOTAL_QUESTIONS - 1) {
        goToQuestion(currentIndex + 1);
      } else {
        submitTest();
      }
    });

    btnTopSubmit.addEventListener('click', function () {
      var answeredCount = Object.keys(userAnswers).length;
      if (answeredCount < TOTAL_QUESTIONS) {
        var remain = TOTAL_QUESTIONS - answeredCount;
        if (!confirm('まだ ' + remain + ' 問が未回答です。このままテストを完了して採点しますか？')) {
          return;
        }
      }
      submitTest();
    });

    // Timer functions
    function startTimer() {
      var remaining = durationSeconds;
      timerInterval = setInterval(function () {
        remaining--;
        if (remaining <= 0) {
          clearInterval(timerInterval);
          alert('制限時間（20分）が経過しました。回答を採点します。');
          submitTest();
          return;
        }
        var m = Math.floor(remaining / 60);
        var s = remaining % 60;
        timerDisplay.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;

        if (remaining <= 120) {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 animate-pulse';
        }
      }, 1000);
    }

    // Scoring & Results Engine
    function submitTest() {
      if (isSubmitted) return;
      isSubmitted = true;
      if (timerInterval) clearInterval(timerInterval);

      var answerKey = {};
      try {
        answerKey = JSON.parse(atob(answerKeyToken));
      } catch (e) {}

      // Calculate raw score and domain breakdowns
      var rawScore = 0;
      questions.forEach(function (q) {
        var key = answerKey[q.id];
        var correctId = key ? key.c : 0;
        if (userAnswers[q.id] === correctId) {
          rawScore++;
        }
      });

      // 2PL IRT ability estimate approximation
      // 0 correct -> IQ 70, 24 correct -> IQ 145, 12 correct -> IQ 100
      var estimatedIq = 100;
      if (rawScore === 0) {
        estimatedIq = 70;
      } else if (rawScore >= 24) {
        estimatedIq = 145;
      } else {
        // Calibrated non-linear scaling across standard normal curve
        var z = (rawScore - 12) / 4.4;
        estimatedIq = Math.round(100 + z * 15);
        if (estimatedIq < 70) estimatedIq = 70;
        if (estimatedIq > 145) estimatedIq = 145;
      }

      // 日本の偏差値: T = 50 + 10 * (IQ - 100) / 15
      var tScore = Math.round((50 + 10 * (estimatedIq - 100) / 15) * 10) / 10;

      // Percentile approximation via Error Function
      var zScore = (estimatedIq - 100) / 15;
      function normalCdf(z) {
        var t = 1 / (1 + 0.2316419 * Math.abs(z));
        var d = 0.3989423 * Math.exp(-z * z / 2);
        var p = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
        return z > 0 ? 1 - p : p;
      }
      var percentile = Math.min(99.9, Math.max(0.1, normalCdf(zScore) * 100));
      var topPercent = Math.round((100 - percentile) * 10) / 10;

      // Classification
      var classification = '平均的 (Average)';
      if (estimatedIq >= 130) classification = '極めて優秀 (Very Superior / メンサ目安)';
      else if (estimatedIq >= 120) classification = '優秀 (Superior)';
      else if (estimatedIq >= 110) classification = '平均の上 (High Average)';
      else if (estimatedIq >= 90) classification = '平均的 (Average)';
      else if (estimatedIq >= 80) classification = '平均の下 (Low Average)';
      else classification = '境界域 (Borderline)';

      // Display in Results DOM
      document.getElementById('res-iq').textContent = String(estimatedIq);
      document.getElementById('res-tscore').textContent = tScore.toFixed(1);
      document.getElementById('res-percentile').textContent = percentile.toFixed(1) + '%';
      document.getElementById('res-rank-text').textContent = '上位 ' + (topPercent <= 0.1 ? 0.1 : topPercent) + '% 相当';
      document.getElementById('res-classification').textContent = classification;
      document.getElementById('res-raw-score').textContent = rawScore + ' / 24 問 正解 (' + Math.round((rawScore / 24) * 100) + '%)';

      // Switch containers
      testRunnerContainer.classList.add('hidden');
      resultsContainer.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Badge download setup
      setupBadgeCanvas(estimatedIq, tScore, percentile.toFixed(1), classification);
    }

    function setupBadgeCanvas(iq, tScore, percentile, classification) {
      var canvas = document.getElementById('badge-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');

      // Background
      ctx.fillStyle = '#09090b';
      ctx.fillRect(0, 0, 1200, 630);

      // Gradient border
      ctx.strokeStyle = '#27272a';
      ctx.lineWidth = 4;
      ctx.strokeRect(30, 30, 1140, 570);

      // FreeIQExam Logo
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 36px sans-serif';
      ctx.fillText('Free', 80, 110);
      ctx.fillStyle = '#2997ff';
      ctx.fillText('IQ', 165, 110);
      ctx.fillStyle = '#ffffff';
      ctx.fillText('Exam', 215, 110);

      ctx.fillStyle = '#71717a';
      ctx.font = '20px monospace';
      ctx.fillText('認知能力測定認定バッジ (2PL IRT 理論準拠)', 80, 150);

      // Score Big Display
      ctx.fillStyle = '#a1a1aa';
      ctx.font = '24px sans-serif';
      ctx.fillText('推定知能指数 (IQ)', 80, 260);

      ctx.fillStyle = '#2997ff';
      ctx.font = 'bold 96px sans-serif';
      ctx.fillText(String(iq), 80, 360);

      // T-Score & Percentile
      ctx.fillStyle = '#a1a1aa';
      ctx.font = '22px sans-serif';
      ctx.fillText('日本の偏差値', 460, 260);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 54px sans-serif';
      ctx.fillText(tScore.toFixed(1), 460, 330);

      ctx.fillStyle = '#a1a1aa';
      ctx.font = '22px sans-serif';
      ctx.fillText('パーセンタイル', 780, 260);
      ctx.fillStyle = '#10b981';
      ctx.font = 'bold 54px sans-serif';
      ctx.fillText(percentile + '%', 780, 330);

      // Classification & Date
      ctx.fillStyle = '#e4e4e7';
      ctx.font = '28px sans-serif';
      ctx.fillText('知能分類: ' + classification, 80, 460);

      var today = new Date();
      var dateStr = today.getFullYear() + '年' + (today.getMonth() + 1) + '月' + today.getDate() + '日 測定';
      ctx.fillStyle = '#71717a';
      ctx.font = '20px sans-serif';
      ctx.fillText(dateStr + ' • freeiqexam.com/ja/iq-test', 80, 530);

      var btnDownload = document.getElementById('btn-download-badge');
      if (btnDownload) {
        btnDownload.onclick = function () {
          var link = document.createElement('a');
          link.download = 'FreeIQExam_IQ_' + iq + '_Badge.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        };
      }
    }

    var btnRetake = document.getElementById('btn-retake');
    if (btnRetake) {
      btnRetake.addEventListener('click', function () {
        userAnswers = {};
        currentIndex = 0;
        isSubmitted = false;
        resultsContainer.classList.add('hidden');
        testRunnerContainer.classList.remove('hidden');
        initNavigator();
        renderCurrentQuestion();
        startTimer();
      });
    }

    // Initialize
    initNavigator();
    renderCurrentQuestion();
    startTimer();
  })();
</script>
