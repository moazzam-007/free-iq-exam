<!-- Client Script for Life Calendar Calculation & Grid Rendering -->
<script>
  (function () {
    var inputDob = document.getElementById('input-dob');
    var selectPreset = document.getElementById('select-lifespan-preset');
    var customAgeWrap = document.getElementById('custom-age-wrap');
    var inputCustomAge = document.getElementById('input-custom-age');

    var metricLivedWeeks = document.getElementById('metric-lived-weeks');
    var metricRemainingWeeks = document.getElementById('metric-remaining-weeks');
    var metricPercentElapsed = document.getElementById('metric-percent-elapsed');
    var metricRemainingDays = document.getElementById('metric-remaining-days');
    var gridMaxAge = document.getElementById('grid-max-age');
    var calendarGrid = document.getElementById('calendar-grid');
    var weekInspectBar = document.getElementById('week-inspect-bar');
    var btnExport = document.getElementById('btn-export-memento');
    var canvas = document.getElementById('memento-canvas');

    function getTargetLifespan() {
      var val = selectPreset.value;
      if (val === 'custom') {
        var num = parseFloat(inputCustomAge.value);
        return isNaN(num) || num < 1 ? 80 : num;
      }
      return parseFloat(val);
    }

    function calculateAndRender() {
      var dobStr = inputDob.value;
      if (!dobStr) return;
      var dob = new Date(dobStr);
      if (isNaN(dob.getTime())) return;

      var now = new Date();
      var targetYears = getTargetLifespan();
      gridMaxAge.textContent = String(Math.round(targetYears));

      // Milliseconds conversion
      var msLived = Math.max(0, now.getTime() - dob.getTime());
      var daysLived = Math.floor(msLived / (1000 * 60 * 60 * 24));
      var weeksLived = Math.floor(daysLived / 7);

      var totalDays = Math.round(targetYears * 365.25);
      var totalWeeks = Math.round(targetYears * 52);
      var remainingWeeks = Math.max(0, totalWeeks - weeksLived);
      var remainingDays = Math.max(0, totalDays - daysLived);
      var percentElapsed = Math.min(100, Math.max(0, (weeksLived / totalWeeks) * 100));

      // Update metrics DOM
      metricLivedWeeks.textContent = weeksLived.toLocaleString('ja-JP');
      metricRemainingWeeks.textContent = remainingWeeks.toLocaleString('ja-JP');
      metricPercentElapsed.textContent = percentElapsed.toFixed(1) + '%';
      metricRemainingDays.textContent = remainingDays.toLocaleString('ja-JP');

      // Render 52-column grid
      calendarGrid.innerHTML = '';
      var numYears = Math.ceil(targetYears);

      for (var y = 0; y < numYears; y++) {
        var row = document.createElement('div');
        row.className = 'flex items-center gap-1';

        // Age label on left (every 5 years)
        var label = document.createElement('span');
        label.className = 'w-6 text-[10px] font-mono text-zinc-400 text-right pr-1 shrink-0 select-none';
        label.textContent = (y % 5 === 0 || y === numYears - 1) ? String(y) : '';
        row.appendChild(label);

        // 52 week blocks
        for (var w = 0; w < 52; w++) {
          var weekIndex = y * 52 + w;
          var block = document.createElement('div');
          
          if (weekIndex < weeksLived) {
            block.className = 'w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-xs bg-[#0066cc] dark:bg-[#2997ff] shrink-0 transition-opacity hover:opacity-75';
          } else if (weekIndex === weeksLived) {
            block.className = 'w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-xs bg-amber-500 shrink-0 ring-2 ring-amber-400 animate-pulse';
          } else {
            block.className = 'w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-xs border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black shrink-0 transition-colors hover:border-zinc-400';
          }

          // Tooltip listener
          (function (ageYear, weekNum, isPast, isCurr) {
            block.addEventListener('mouseenter', function () {
              var status = isCurr ? '★ 現在の週' : (isPast ? '経過済み' : 'これからの未来');
              weekInspectBar.textContent = ageYear + '歳 ' + (weekNum + 1) + '週目（通算 ' + (ageYear * 52 + weekNum + 1) + '週）: ' + status;
            });
          })(y, w, weekIndex < weeksLived, weekIndex === weeksLived);

          row.appendChild(block);
        }

        calendarGrid.appendChild(row);
      }
    }

    // Toggle custom age input
    selectPreset.addEventListener('change', function () {
      if (this.value === 'custom') {
        customAgeWrap.classList.remove('hidden');
      } else {
        customAgeWrap.classList.add('hidden');
      }
      calculateAndRender();
    });

    inputDob.addEventListener('input', calculateAndRender);
    inputCustomAge.addEventListener('input', calculateAndRender);

    // PNG Export Card Generator
    if (btnExport && canvas) {
      btnExport.addEventListener('click', function () {
        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Background
        ctx.fillStyle = '#09090b';
        ctx.fillRect(0, 0, 1200, 700);

        // Border
        ctx.strokeStyle = '#27272a';
        ctx.lineWidth = 3;
        ctx.strokeRect(30, 30, 1140, 640);

        // Header Title
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 36px sans-serif';
        ctx.fillText('メメントモリ • 人生時計カレンダー', 70, 95);

        ctx.fillStyle = '#71717a';
        ctx.font = '18px monospace';
        ctx.fillText('FREEIQEXAM.COM / MEMENTO MORI', 70, 130);

        // Metrics Boxes
        var livedW = metricLivedWeeks.textContent || '0';
        var remainW = metricRemainingWeeks.textContent || '0';
        var pct = metricPercentElapsed.textContent || '0%';
        var remD = metricRemainingDays.textContent || '0';

        var metrics = [
          { label: '経過した週数', val: livedW + ' 週', color: '#2997ff' },
          { label: '残された週数', val: remainW + ' 週', color: '#ffffff' },
          { label: '人生の消化率', val: pct, color: '#f59e0b' },
          { label: '残りの概算日数', val: remD + ' 日', color: '#10b981' }
        ];

        for (var i = 0; i < metrics.length; i++) {
          var m = metrics[i];
          var x = 70 + i * 270;
          ctx.fillStyle = '#18181b';
          ctx.fillRect(x, 170, 250, 100);
          ctx.strokeStyle = '#27272a';
          ctx.strokeRect(x, 170, 250, 100);

          ctx.fillStyle = '#a1a1aa';
          ctx.font = '16px sans-serif';
          ctx.fillText(m.label, x + 20, 205);

          ctx.fillStyle = m.color;
          ctx.font = 'bold 32px sans-serif';
          ctx.fillText(m.val, x + 20, 250);
        }

        // Quote
        ctx.fillStyle = '#e4e4e7';
        ctx.font = 'italic 20px serif';
        ctx.fillText('「我々が持っている時間が短いのではない。多くの時間を浪費しているのだ。」', 70, 340);
        ctx.fillStyle = '#71717a';
        ctx.font = '16px sans-serif';
        ctx.fillText('— ルキウス・アンナエウス・セネカ 『人生の短さについて』', 70, 375);

        // Mini graphical representation
        var totalW = parseInt(livedW.replace(/,/g, '')) + parseInt(remainW.replace(/,/g, '')) || 4160;
        var livedNum = parseInt(livedW.replace(/,/g, '')) || 1600;
        var barW = 1060;
        var livedBarW = Math.round((livedNum / totalW) * barW);

        ctx.fillStyle = '#27272a';
        ctx.fillRect(70, 440, barW, 28);
        ctx.fillStyle = '#2997ff';
        ctx.fillRect(70, 440, livedBarW, 28);

        ctx.fillStyle = '#71717a';
        ctx.font = '16px monospace';
        ctx.fillText('0 週 (誕生)', 70, 495);
        ctx.fillText(totalW.toLocaleString('ja-JP') + ' 週 (想定寿命)', 1130 - ctx.measureText(totalW.toLocaleString('ja-JP') + ' 週 (想定寿命)').width, 495);

        // Footer timestamp
        var today = new Date();
        var dateStr = today.getFullYear() + '年' + (today.getMonth() + 1) + '月' + today.getDate() + '日 生成';
        ctx.fillStyle = '#71717a';
        ctx.font = '16px sans-serif';
        ctx.fillText(dateStr + ' • freeiqexam.com/ja/memento-mori', 70, 610);

        // Download trigger
        var link = document.createElement('a');
        link.download = 'Memento_Mori_Life_Calendar.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    // Initial render
    calculateAndRender();
  })();
</script>
