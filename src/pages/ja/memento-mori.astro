---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const alternates = {
  'en': 'https://freeiqexam.com/memento-mori',
  'de': 'https://freeiqexam.com/de/memento-mori',
  'pt-BR': 'https://freeiqexam.com/pt-br/memento-mori',
  'nl': 'https://freeiqexam.com/nl/memento-mori',
  'ja': 'https://freeiqexam.com/ja/memento-mori'
};

const title = "メメントモリ 意味と人生時計｜人生の残り週数を可視化 | FreeIQExam";
const description = "「メメントモリ」の意味（死を忘れるな）とストア派哲学を解説。生年月日から経過週数と残り時間を可視化する無料の人生カレンダー。※同名のゲームとは無関係です。";
const canonicalUrl = "https://freeiqexam.com/ja/memento-mori";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "メメントモリ人生時計・人生カレンダー",
    "url": canonicalUrl,
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "All",
    "inLanguage": "ja",
    "browserRequirements": "JavaScript対応ブラウザ",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "JPY"
    },
    "featureList": [
      "人生4,000週間の対話型グリッドカレンダー（80歳・日本人平均寿命プリセット対応）",
      "経過週数・残り週数・人生経過率のリアルタイム算出",
      "4つのライフステージ別カラー分類",
      "セネカ、マルクス・アウレリウス、エピクテトスのストア派哲学名言集",
      "高解像度PNGカレンダーカードのワンクリック無料画像出力",
      "ブラウザ内ローカル処理による完全なプライバシー保護（サーバー送信ゼロ）"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ホーム",
        "item": "https://freeiqexam.com/ja/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "メメントモリ人生時計",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema} alternates={alternates} lang="ja">
  <Header currentPath="/ja/memento-mori" />

  <main class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- HERO HEADER -->
    <section class="pt-12 pb-8 px-4 sm:px-6 max-w-5xl mx-auto text-center border-b border-zinc-200/80 dark:border-zinc-900">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-xs font-mono font-bold uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>ストア派哲学の実践 • 人生4,000週カレンダー</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-tight mb-4">
        メメントモリの意味と人生時計
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        「死を忘れるな（Memento Mori）」。有限な時間を可視化し、日々の生活をより豊かで主体的なものへと変える哲学的ライフカレンダー。
      </p>

      <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-3">
        ※本ページは歴史的・哲学的概念としての「メメント・モリ」および人生時間の可視化ツールを解説するものであり、同名のスマートフォン向けゲームアプリ等とは関係ありません。
      </p>
    </section>

    <!-- SECTION 1: TOP SEARCH INTENT — メメントモリの意味・語源・哲学解説 -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800">
        <h2 class="font-heading font-bold text-2xl text-zinc-950 dark:text-white mb-4">
          「メメント・モリ（Memento Mori）」とは何か：語源と本来の意味
        </h2>
        
        <div class="space-y-4 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          <p>
            「メメント・モリ（ラテン語: <em>Memento mori</em>）」は、直訳すると<strong>「死を忘れるな」「自分がいつか必ず死ぬ身であることを忘れるな」</strong>という意味を持つ古代ローマ発祥の警句です。
          </p>
          <p>
            古代ローマにおいて、対外戦争で勝利を収めた将軍が凱旋パレードを行う際、将軍の背後に立つ奴隷が<em>「メメント・モリ」</em>と囁き続けたと伝えられています。これは、絶大な権力や民衆の喝采に包まれた英雄であっても、神ではなく死を免れない一人の人間に過ぎないという事実を思い起こさせ、傲慢（ヒュブリス）を戒めるための重要な儀礼でした。
          </p>
          <p>
            中世ヨーロッパやバロック絵画においては、砂時計、髑髏（骸骨）、枯れかけた花などを描いた「ヴァニタス（Vanitas・人生の儚さ）」画の主題として広まりました。現代においては、死を単なる恐怖やペシミズム（悲観主義）として捉えるのではなく、<strong>「終わりがあるからこそ、今手の中にある時間が無二の価値を持つ」という前向きな生の指針（ストア派哲学の実践）</strong>として再評価されています。
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 2: INTERACTIVE LIFE WEEKS CALENDAR TOOL -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- User Input Deck -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-xs">
        
        <div class="flex items-center gap-2 mb-6">
          <span class="w-8 h-8 rounded-xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center font-mono font-bold text-sm">
            1
          </span>
          <h2 class="text-xl font-bold text-zinc-950 dark:text-white">
            生年月日と想定寿命を設定する
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <!-- Date of Birth Input -->
          <div>
            <label for="input-dob" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 mb-2">
              生年月日
            </label>
            <input
              id="input-dob"
              type="date"
              value="1995-01-01"
              class="w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-black text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] min-h-[44px]"
            />
          </div>

          <!-- Lifespan Preset Selector -->
          <div>
            <label for="select-lifespan-preset" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 mb-2">
              目標・平均寿命プリセット
            </label>
            <select
              id="select-lifespan-preset"
              class="w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-black text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] min-h-[44px]"
            >
              <option value="80" selected>80歳（標準・4,160週）</option>
              <option value="81.09">日本人男性平均寿命（81.09歳・厚労省統計）</option>
              <option value="87.14">日本人女性平均寿命（87.14歳・厚労省統計）</option>
              <option value="90">90歳（長寿・4,680週）</option>
              <option value="custom">カスタム指定（手動入力）</option>
            </select>
          </div>

          <!-- Custom Age (hidden unless custom) -->
          <div id="custom-age-wrap" class="hidden">
            <label for="input-custom-age" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 mb-2">
              カスタム寿命（1〜120歳）
            </label>
            <input
              id="input-custom-age"
              type="number"
              min="1"
              max="120"
              value="80"
              class="w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-black text-sm text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff] min-h-[44px]"
            />
          </div>
        </div>

      </div>

      <!-- Real-Time Metrics Overview Deck -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 text-center">
          <div class="text-xs font-mono text-zinc-500 mb-1">経過した週数</div>
          <div id="metric-lived-weeks" class="font-heading font-extrabold text-2xl sm:text-4xl text-[#0066cc] dark:text-[#2997ff]">1,620</div>
          <div class="text-[11px] text-zinc-400 mt-0.5">週間を経過</div>
        </div>

        <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 text-center">
          <div class="text-xs font-mono text-zinc-500 mb-1">残された週数</div>
          <div id="metric-remaining-weeks" class="font-heading font-extrabold text-2xl sm:text-4xl text-zinc-950 dark:text-white">2,540</div>
          <div class="text-[11px] text-zinc-400 mt-0.5">残りの週末</div>
        </div>

        <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 text-center">
          <div class="text-xs font-mono text-zinc-500 mb-1">人生の経過率</div>
          <div id="metric-percent-elapsed" class="font-heading font-extrabold text-2xl sm:text-4xl text-amber-600 dark:text-amber-400">38.9%</div>
          <div class="text-[11px] text-zinc-400 mt-0.5">消化済み</div>
        </div>

        <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 text-center">
          <div class="text-xs font-mono text-zinc-500 mb-1">残りの概算日数</div>
          <div id="metric-remaining-days" class="font-heading font-extrabold text-2xl sm:text-4xl text-emerald-600 dark:text-emerald-400">17,780</div>
          <div class="text-[11px] text-zinc-400 mt-0.5">日</div>
        </div>
      </div>

      <!-- Life Stages Legend -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-zinc-600 dark:text-zinc-400 mb-6 p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/60 dark:border-zinc-800/60">
        <span class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-xs bg-[#0066cc] dark:bg-[#2997ff]"></span>
          <span>経過した週</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-xs bg-amber-500 animate-pulse"></span>
          <span>現在の週（今週）</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-xs border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-black"></span>
          <span>これからの週（未来）</span>
        </span>
      </div>

      <!-- 52-Week Life Calendar Grid Container -->
      <div class="p-4 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 overflow-hidden mb-8">
        <div class="flex items-center justify-between text-xs text-zinc-500 font-mono mb-4">
          <span>横軸: 1年間の52週間 (Week 1 〜 52)</span>
          <span>縦軸: 年齢 (0歳 〜 <span id="grid-max-age">80</span>歳)</span>
        </div>

        <div id="calendar-grid-wrap" class="w-full overflow-x-auto pb-4">
          <div id="calendar-grid" class="flex flex-col gap-1 min-w-[620px]">
            <!-- Injected via client script -->
          </div>
        </div>

        <!-- Tooltip display bar -->
        <div id="week-inspect-bar" class="text-xs font-mono text-zinc-500 dark:text-zinc-400 text-center pt-2">
          いずれかの週ブロックにカーソルを合わせると詳細が表示されます。
        </div>
      </div>

      <!-- Canvas PNG Export Bar -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 mb-12">
        <div>
          <div class="font-bold text-sm text-zinc-900 dark:text-white">人生カレンダーを画像として保存</div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">高解像度PNG形式（1200×630）で出力。PC壁紙やプリント用に活用できます。</div>
        </div>
        <button
          id="btn-export-memento"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white font-semibold text-sm hover:opacity-90 transition-all cursor-pointer min-h-[44px] active:scale-[0.97]"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          <span>人生時計画像をダウンロード</span>
        </button>
      </div>

      <!-- Hidden canvas for export -->
      <canvas id="memento-canvas" width="1200" height="700" class="hidden"></canvas>

      <!-- GENTLE TONE MENTAL HEALTH SUPPORT CALLOUT -->
      <aside id="support" class="p-5 sm:p-6 rounded-2xl bg-blue-50/70 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900/40 text-sm text-zinc-700 dark:text-zinc-300">
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-xl bg-blue-600/10 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">
            i
          </span>
          <div class="space-y-1.5">
            <h3 class="font-bold text-zinc-950 dark:text-white">もし時間の有限性に不安や苦痛を感じたら</h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              時間の有限性を可視化する試みは、本来「今日という日の価値を高める」ための哲学的な道具です。もしこれによって強い不安、無力感、抑うつ気分を感じる場合は、作業を中断し深呼吸してください。
            </p>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              気分の状態がすぐれないときは、当サイトの <a href="/ja/depression-test#support" class="text-[#0066cc] dark:text-[#2997ff] font-semibold underline">うつ病セルフチェックおよび相談窓口案内</a> や、公的な電話相談窓口（こころの健康相談統一ダイヤル: 0570-064-556 等）をご活用ください。
            </p>
          </div>
        </div>
      </aside>

    </section>

    <!-- SECTION 3: STOIC PHILOSOPHY INSIGHTS & QUOTES -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 border-t border-zinc-200/80 dark:border-zinc-900">
      <div class="text-center mb-10">
        <h2 class="font-heading font-extrabold text-2xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight mb-3">
          古代ストア派哲学者たちの洞察
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          セネカ、マルクス・アウレリウス、エピクテトスが遺した、時間と生についての言葉。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Seneca -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Seneca</div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white mb-3">
              ルキウス・アンナエウス・セネカ
            </h3>
            <blockquote class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed italic mb-4">
              「我々が持っている時間が短いのではない。多くの時間を浪費しているのだ。人生は十分に長く、善く生きる者には寛大に与えられている。」
            </blockquote>
          </div>
          <div class="text-[11px] text-zinc-400 font-mono border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
            『人生の短さについて』(De Brevitate Vitae)
          </div>
        </div>

        <!-- Marcus Aurelius -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">Marcus Aurelius</div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white mb-3">
              マルクス・アウレリウス
            </h3>
            <blockquote class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed italic mb-4">
              「明日にも人生から去っていく可能性があることを心に留めよ。一瞬一瞬を、あたかもそれが生涯最後の行動であるかのように生きよ。」
            </blockquote>
          </div>
          <div class="text-[11px] text-zinc-400 font-mono border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
            『自省録』(Meditations)
          </div>
        </div>

        <!-- Epictetus -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-2">Epictetus</div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white mb-3">
              エピクテトス
            </h3>
            <blockquote class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed italic mb-4">
              「自分にコントロールできることと、コントロールできないことを厳格に区別せよ。死は避けられないが、今この瞬間をどう生きるかは完全にあなたの手中にある。」
            </blockquote>
          </div>
          <div class="text-[11px] text-zinc-400 font-mono border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
            『要録』(Enchiridion)
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 4: FAQ ACCORDION -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12 border-t border-zinc-200/80 dark:border-zinc-900 mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight mb-8 text-center">
        よくあるご質問（FAQ）
      </h2>

      <div class="space-y-4">
        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-zinc-900 dark:text-white">
            <span>「メメント・モリ」という言葉の本来の意味や由来は何ですか？</span>
            <span class="ml-4 shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="mt-3.5 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3.5">
            古代ローマに由来するラテン語の警句で、「死を忘れるな」を意味します。凱旋将軍の傲慢を戒める言葉として始まり、ストア派哲学では「人生の有限性を自覚することで、今ある時間を誠実に全うする」ための積極的な智慧として受け継がれました。
          </div>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base text-zinc-900 dark:text-white">
            <span>なぜ人生の時間を「年」ではなく「週（約4,000週）」で数えるのですか？</span>
            <span class="ml-4 shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="mt-3.5 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3.5">
