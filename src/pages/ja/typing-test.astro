          weakKeysList.textContent = sortedMisses.slice(0, 3).map(function (p) { return p[0].toUpperCase() + ' (' + p[1] + '回)'; }).join(', ');
        } else {
          weakKeysList.textContent = 'なし（ノーミスです！）';
        }

        resultsPanel.classList.remove('hidden');
        window.scrollTo({ top: resultsPanel.offsetTop - 60, behavior: 'smooth' });
      }

      function evaluateTierJa(cpm, acc) {
        if (cpm >= 400 && acc >= 96) {
          resTierTitle.textContent = '神速・プロフェッショナル級';
          resTierDesc.textContent = '驚異的な打鍵速度と正確性です。思考と同じ速度で文字を紡ぎ出せる最上位レベルです。';
        } else if (cpm >= 300 && acc >= 95) {
          resTierDesc.textContent = '完全なタッチタイピングを習得しており、プログラミングや原稿執筆を極めて効率的にこなせます。';
          resTierTitle.textContent = '上級・プログラマー級';
        } else if (cpm >= 200) {
          resTierTitle.textContent = '一般事務・ビジネス実務レベル';
          resTierDesc.textContent = '日常的なビジネス文書やメール作成において十分実用的な打鍵速度です。';
        } else {
          resTierTitle.textContent = '初級・トレーニング段階';
          resTierDesc.textContent = 'まずはホームポジションを固定し、キーを見ずに打つ練習を継続しましょう。';
        }
      }

      function evaluateTierEn(wpm, acc) {
        if (wpm >= 80) {
          resTierTitle.textContent = 'Elite Typist (上位5%水準)';
          resTierDesc.textContent = 'ネイティブのプロタイピストに匹敵する極めて高速な入力速度です。';
        } else if (wpm >= 60) {
          resTierTitle.textContent = 'Fluent Business Typist';
          resTierDesc.textContent = '国際的なオフィスワークで十分な競争力を持つタイピング速度です。';
        } else {
          resTierTitle.textContent = 'Developing Typist';
          resTierDesc.textContent = '正確率を98%以上に保ちながら、ホームポジションでの練習を重ねましょう。';
        }
      }

      function handleKeystroke(keyChar) {
        if (!isRunning && remainingSeconds === timeLimit) {
          startTest();
        }
        if (!isRunning) return;

        totalKeystrokes++;
        var expectedChar = currentTargetStr[typedInCurrentWord.length];

        if (keyChar === expectedChar) {
          typedInCurrentWord += keyChar;
          highlightKey(keyChar, false);
          renderRomajiDisplay();

          if (typedInCurrentWord.length >= currentTargetStr.length) {
            pickNextWord();
          }
        } else {
          totalMisses++;
          keyMissCounts[expectedChar] = (keyMissCounts[expectedChar] || 0) + 1;
          highlightKey(keyChar, true);
        }
        updateHUD();
      }

      // Keyboard Event Listener
      document.addEventListener('keydown', function (e) {
        // IME Composition check
        if (e.isComposing || e.key === 'Process') {
          imeAlert.classList.remove('hidden');
          return;
        } else {
          imeAlert.classList.add('hidden');
        }

        if (e.key === 'Escape') {
          resetAll();
          return;
        }

        if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
          var char = e.key.toLowerCase();
          handleKeystroke(char);
          e.preventDefault();
        }
      });

      function resetAll() {
        clearInterval(timerInterval);
        isRunning = false;
        remainingSeconds = timeLimit;
        hudTimer.textContent = remainingSeconds;
        hudSpeed.textContent = '0';
        hudAccuracy.textContent = '100%';
        hudMisses.textContent = '0';
        totalKeystrokes = 0;
        totalMisses = 0;
        keyMissCounts = {};
        resultsPanel.classList.add('hidden');
        pickNextWord();
      }

      // Settings Listeners
      btnLangJa.addEventListener('click', function () {
        currentLang = 'ja';
        btnLangJa.className = 'px-3.5 py-1.5 rounded-lg font-bold bg-white dark:bg-zinc-800 text-[#0066cc] dark:text-[#2997ff] shadow-xs transition-all cursor-pointer';
        btnLangEn.className = 'px-3.5 py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer';
        hudMetricLabel.textContent = '速度: ';
        hudMetricUnit.textContent = ' CPM';
        resetAll();
      });

      btnLangEn.addEventListener('click', function () {
        currentLang = 'en';
        btnLangEn.className = 'px-3.5 py-1.5 rounded-lg font-bold bg-white dark:bg-zinc-800 text-[#0066cc] dark:text-[#2997ff] shadow-xs transition-all cursor-pointer';
        btnLangJa.className = 'px-3.5 py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer';
        hudMetricLabel.textContent = '速度: ';
        hudMetricUnit.textContent = ' WPM';
        resetAll();
      });

      timeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          timeBtns.forEach(function (b) { b.classList.remove('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]'); });
          btn.classList.add('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]');
          timeLimit = parseInt(btn.getAttribute('data-time'), 10);
          resetAll();
        });
      });

      displayContainer.addEventListener('click', function () {
        hiddenInput.focus();
      });

      btnRestart.addEventListener('click', resetAll);
      btnAgain.addEventListener('click', resetAll);

      btnCopyRes.addEventListener('click', function () {
        var text = 'タイピング速度測定結果: ' + resSpeedVal.textContent + ' ' + resSpeedUnit.textContent + '（正確率: ' + resAccVal.textContent + '） | FreeIQExam: https://freeiqexam.com/ja/typing-test';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text);
        }
        btnCopyRes.textContent = 'コピー完了';
        setTimeout(function () { btnCopyRes.textContent = '結果をコピー'; }, 2000);
      });

      // Initialize First Word
      pickNextWord();
    })();
  </script>
</Layout>
