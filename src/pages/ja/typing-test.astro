      function renderRomajiDisplay() {
        var html = '';
        for (var i = 0; i < currentTargetStr.length; i++) {
          var ch = currentTargetStr[i];
          if (i < typedInCurrentWord.length) {
            html += '<span class="char-typed">' + ch + '</span>';
          } else if (i === typedInCurrentWord.length) {
            html += '<span class="char-current font-bold px-0.5 rounded">' + ch + '</span>';
          } else {
            html += '<span class="text-zinc-400 dark:text-zinc-600">' + ch + '</span>';
          }
        }
        wordRomaji.innerHTML = html;
      }

      function highlightKey(keyChar, isMiss) {
        var id = 'key-' + keyChar.toUpperCase();
        if (keyChar === '-') id = 'key-MINUS';
        if (keyChar === ' ') id = 'key-SPACE';
        var el = document.getElementById(id);
        if (el) {
          el.classList.add(isMiss ? 'key-missed' : 'key-active');
          setTimeout(function () {
            el.classList.remove('key-missed', 'key-active');
          }, 140);
        }
      }

      function startTest() {
        if (isRunning) return;
        isRunning = true;
        remainingSeconds = timeLimit;
        hudTimer.textContent = remainingSeconds;
        totalKeystrokes = 0;
        totalMisses = 0;
        keyMissCounts = {};
        resultsPanel.classList.add('hidden');

        timerInterval = setInterval(function () {
          remainingSeconds--;
          hudTimer.textContent = remainingSeconds;
          updateHUD();
          if (remainingSeconds <= 0) {
            finishTest();
          }
        }, 1000);
      }

      function updateHUD() {
        var elapsedMin = (timeLimit - remainingSeconds) / 60;
        if (elapsedMin <= 0) elapsedMin = 1 / 60;

        var acc = totalKeystrokes > 0 ? Math.max(0, Math.round(((totalKeystrokes - totalMisses) / totalKeystrokes) * 100)) : 100;
        hudAccuracy.textContent = acc + '%';
        hudMisses.textContent = totalMisses;

        if (currentLang === 'ja') {
          var cpm = Math.round(totalKeystrokes / elapsedMin);
          hudSpeed.textContent = cpm;
        } else {
          var wpm = Math.round((totalKeystrokes / 5) / elapsedMin);
          hudSpeed.textContent = wpm;
        }
      }

      function finishTest() {
        clearInterval(timerInterval);
        isRunning = false;
        hiddenInput.blur();

        var elapsedMin = timeLimit / 60;
        var cpm = Math.round(totalKeystrokes / elapsedMin);
        var wpm = Math.round((totalKeystrokes / 5) / elapsedMin);
        var acc = totalKeystrokes > 0 ? Math.max(0, Math.round(((totalKeystrokes - totalMisses) / totalKeystrokes) * 100)) : 100;

        resKeysVal.textContent = totalKeystrokes;
        resMissesVal.textContent = totalMisses;
        resAccVal.textContent = acc + '%';

        if (currentLang === 'ja') {
          resSpeedVal.textContent = cpm;
          resSpeedUnit.textContent = '打/分 (CPM)';
          evaluateTierJa(cpm, acc);
        } else {
          resSpeedVal.textContent = wpm;
          resSpeedUnit.textContent = '単語/分 (WPM)';
          evaluateTierEn(wpm, acc);
