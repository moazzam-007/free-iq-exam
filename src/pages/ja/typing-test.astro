---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterJa from '../../components/ja/FooterJa.astro';

const alternates = {
  'en': 'https://freeiqexam.com/typing-test',
  'fi': 'https://freeiqexam.com/fi/kirjoitustesti',
  'de': 'https://freeiqexam.com/de/tipptest',
  'pt-BR': 'https://freeiqexam.com/pt-br/teste-de-digitacao',
  'ja': 'https://freeiqexam.com/ja/typing-test',
};

const title = "タイピング練習｜無料のタイピング速度測定（ローマ字・英文） | FreeIQExam";
const description = "登録不要のタイピング練習と速度測定。ローマ字入力の日本語と英文に対応し、打鍵数/分・正確率・苦手キーをリアルタイムで確認できます。";
const canonicalUrl = "https://freeiqexam.com/ja/typing-test";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam 日本語タイピング練習・速度測定ツール",
    "url": canonicalUrl,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "inLanguage": "ja",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" },
    "featureList": [
      "日本語ローマ字・英文の2モード対応",
      "si/shi、ti/chi、tu/tsuなどの複数ローマ字表記自動対応ステートマシン",
      "打鍵数/分（CPM/KPM）・正確率・ミス打鍵数のリアルタイム算出",
      "キーボード別苦手キー（ヒートマップ）可視化",
      "IME変換オン検知アラート機能",
      "登録不要・完全無料・ローカル完結処理"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://freeiqexam.com/ja" },
      { "@type": "ListItem", "position": 2, "name": "タイピング練習", "item": canonicalUrl }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="ja">
  <Header currentPath="/ja/typing-test" />

  <style>
    .typing-arena {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }
    .char-typed { color: #10b981; }
    .char-current {
      background-color: rgba(0, 102, 204, 0.2);
      border-bottom: 2px solid #0066cc;
    }
    .dark .char-current {
      background-color: rgba(41, 151, 255, 0.25);
      border-bottom-color: #2997ff;
    }
    .char-wrong {
      color: #ef4444;
      background-color: rgba(239, 68, 68, 0.18);
    }
    .key-active {
      background-color: #0066cc !important;
      color: white !important;
      border-color: #0066cc !important;
    }
    .dark .key-active {
      background-color: #2997ff !important;
      color: black !important;
      border-color: #2997ff !important;
    }
    .key-missed {
      background-color: #ef4444 !important;
      color: white !important;
      border-color: #ef4444 !important;
    }
    details summary::-webkit-details-marker { display: none; }
    details[open] summary .faq-chevron { transform: rotate(180deg); }
  </style>

  <main class="min-h-screen flex-1 w-full bg-white dark:bg-black text-zinc-900 dark:text-zinc-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">

      <!-- Breadcrumbs -->
      <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="パンくずリスト">
        <a href="/ja" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">ホーム</a>
        <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-semibold">タイピング練習</span>
      </nav>

      <!-- Hero Header -->
      <header class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>運動学習 · 打鍵速度・正確率測定</span>
        </div>
        <h1 class="font-heading font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.15] mb-4">
          タイピング練習・速度測定
        </h1>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
          ローマ字入力の日本語または英文でタイピング速度を測定します。1分あたりの打鍵数（CPM/KPM）、正確率、苦手キーの傾向を判定します。
        </p>
      </header>

      <!-- IME Alert Banner (Shown when IME composition / Process key detected) -->
      <div id="ime-alert-banner" class="hidden max-w-3xl mx-auto mb-6 p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700 text-amber-900 dark:text-amber-200 text-xs sm:text-sm flex items-start gap-3 shadow-xs">
        <svg class="w-5 h-5 shrink-0 text-amber-600 dark:text-amber-400 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
        <div class="space-y-1">
          <strong class="font-bold">日本語入力（IME）がオンになっています</strong>
          <p class="leading-relaxed">
            正確に打鍵数を測定するため、キーボードの「半角/全角」キーまたは「英数」キーを押して、直接入力（半角英数）に切り替えてください。
          </p>
        </div>
      </div>

      <!-- Settings Bar (Language & Time Duration) -->
      <section class="max-w-3xl mx-auto mb-6 p-3 rounded-2xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
        <!-- Language Select -->
        <div class="flex items-center gap-1.5 p-1 rounded-xl bg-zinc-200/60 dark:bg-zinc-900">
          <button type="button" id="lang-btn-ja" class="px-3.5 py-1.5 rounded-lg font-bold bg-white dark:bg-zinc-800 text-[#0066cc] dark:text-[#2997ff] shadow-xs transition-all cursor-pointer">
            日本語（ローマ字）
          </button>
          <button type="button" id="lang-btn-en" class="px-3.5 py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all cursor-pointer">
            English（英文）
          </button>
        </div>

        <!-- Duration Select -->
        <div class="flex items-center gap-2">
          <span class="text-zinc-500">制限時間:</span>
          <button type="button" data-time="15" class="time-btn px-3 py-1 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-[#0066cc] transition-colors cursor-pointer">15秒</button>
          <button type="button" data-time="30" class="time-btn px-3 py-1 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-[#0066cc] transition-colors cursor-pointer">30秒</button>
          <button type="button" data-time="60" class="time-btn active font-bold text-[#0066cc] dark:text-[#2997ff] px-3 py-1 rounded-md transition-colors cursor-pointer">60秒</button>
        </div>
      </section>

      <!-- Main Typing Arena -->
      <div class="relative max-w-3xl mx-auto">
        <div id="typing-card" class="typing-arena w-full rounded-3xl p-6 sm:p-10 bg-zinc-50/90 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 shadow-2xl flex flex-col items-center">

          <!-- Live HUD -->
          <div class="w-full flex items-center justify-between pb-4 mb-6 border-b border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-500 dark:text-zinc-400">
            <div class="flex items-center gap-4">
              <div>
                <span>残り時間: </span>
                <strong id="hud-timer" class="text-zinc-950 dark:text-white text-base">60</strong>秒
              </div>
              <div>
                <span id="hud-metric-label">速度: </span>
                <strong id="hud-speed" class="text-[#0066cc] dark:text-[#2997ff] text-base">0</strong>
                <span id="hud-metric-unit" class="text-[11px]"> CPM</span>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div>
                <span>正確率: </span>
                <strong id="hud-accuracy" class="text-emerald-600 dark:text-emerald-400 text-base">100%</strong>
              </div>
              <div>
                <span>ミス: </span>
                <strong id="hud-misses" class="text-rose-500 text-base">0</strong>
              </div>
            </div>
          </div>

          <!-- Typing Display Box -->
          <div id="display-container" class="w-full min-h-[140px] flex flex-col items-center justify-center p-6 rounded-2xl bg-white dark:bg-black border border-zinc-200 dark:border-zinc-800 mb-8 cursor-text">
            <div id="word-display-kanji" class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white tracking-wide mb-2">
              ここに日本語が表示されます
            </div>
            <div id="word-display-kana" class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 font-medium mb-3">
              ここに読み（かな）が表示されます
            </div>
            <div id="word-display-romaji" class="font-mono text-lg sm:text-2xl tracking-widest flex items-center gap-0.5">
              <span class="text-zinc-400 dark:text-zinc-600">キーを押してタイピングを開始</span>
            </div>
          </div>

          <!-- Hidden Input for Mobile / Focus Capture -->
          <input
            type="text"
            id="hidden-typing-input"
            class="absolute opacity-0 pointer-events-none w-0 h-0"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />

          <!-- Virtual Keyboard Heatmap Preview (QWERTY) -->
          <div class="w-full max-w-xl mx-auto space-y-1.5 p-4 rounded-2xl bg-zinc-100/70 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 select-none text-[11px] sm:text-xs font-mono font-bold">
            <!-- Row 1 -->
            <div class="flex justify-center gap-1">
              {['Q','W','E','R','T','Y','U','I','O','P'].map(k => (
                <div id={`key-${k}`} class="w-8 sm:w-10 h-9 sm:h-11 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 shadow-xs transition-colors">{k}</div>
              ))}
            </div>
            <!-- Row 2 -->
            <div class="flex justify-center gap-1">
              {['A','S','D','F','G','H','J','K','L'].map(k => (
                <div id={`key-${k}`} class="w-8 sm:w-10 h-9 sm:h-11 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 shadow-xs transition-colors">{k}</div>
              ))}
            </div>
            <!-- Row 3 -->
            <div class="flex justify-center gap-1">
              {['Z','X','C','V','B','N','M'].map(k => (
                <div id={`key-${k}`} class="w-8 sm:w-10 h-9 sm:h-11 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 shadow-xs transition-colors">{k}</div>
              ))}
              <div id="key-MINUS" class="w-8 sm:w-10 h-9 sm:h-11 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 shadow-xs transition-colors">-</div>
            </div>
            <div class="flex justify-center gap-1 pt-1">
              <div id="key-SPACE" class="w-48 sm:w-64 h-8 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-400 text-[10px] shadow-xs">SPACE</div>
            </div>
          </div>

          <!-- Bottom Prompt -->
          <div class="mt-6 flex items-center justify-between w-full text-xs font-mono text-zinc-500">
            <span>※ Escキーでいつでもリセットできます</span>
            <button id="btn-restart" type="button" class="text-[#0066cc] dark:text-[#2997ff] hover:underline cursor-pointer">
              リセットして最初から
            </button>
          </div>

          <!-- Results Overlay Panel (Hidden by default) -->
          <div id="results-panel" class="hidden w-full mt-8 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex flex-col items-center text-center">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-mono font-bold uppercase tracking-wider mb-3">
              測定完了 · スコア
            </div>
            <h2 id="res-tier-title" class="text-2xl sm:text-4xl font-heading font-extrabold text-zinc-950 dark:text-white mb-2">
              一般実務レベル
            </h2>
            <p id="res-tier-desc" class="text-sm text-zinc-600 dark:text-zinc-400 max-w-md mb-6">
              ビジネス実務において十分な入力速度です。
            </p>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full max-w-xl mb-8">
              <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
                <div class="text-xs text-zinc-500 mb-1">打鍵速度</div>
                <div id="res-speed-val" class="font-heading font-extrabold text-3xl text-[#0066cc] dark:text-[#2997ff]">240</div>
                <div id="res-speed-unit" class="text-[11px] text-zinc-400">打/分 (CPM)</div>
              </div>
              <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
                <div class="text-xs text-zinc-500 mb-1">正確率</div>
                <div id="res-acc-val" class="font-heading font-extrabold text-3xl text-emerald-600 dark:text-emerald-400">98%</div>
                <div class="text-[11px] text-zinc-400">正確率</div>
              </div>
              <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
                <div class="text-xs text-zinc-500 mb-1">総打鍵数</div>
                <div id="res-keys-val" class="font-heading font-extrabold text-3xl text-zinc-950 dark:text-white">245</div>
                <div class="text-[11px] text-zinc-400">キー入力</div>
              </div>
              <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
                <div class="text-xs text-zinc-500 mb-1">ミス打鍵</div>
                <div id="res-misses-val" class="font-heading font-extrabold text-3xl text-rose-500">5</div>
                <div class="text-[11px] text-zinc-400">ミス回数</div>
              </div>
            </div>

            <!-- Weak Keys Summary -->
            <div id="weak-keys-box" class="w-full max-w-md p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs mb-8">
              <span class="font-bold text-zinc-700 dark:text-zinc-300">ミスが多かった苦手キー: </span>
              <span id="weak-keys-list" class="font-mono font-bold text-rose-500">なし（ノーミス）</span>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-3">
              <button id="btn-again" type="button" class="min-h-[44px] px-6 py-2.5 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-bold text-sm hover:opacity-90 active:scale-[0.97] transition-all cursor-pointer">
                もう一度練習する
              </button>
              <button id="btn-copy-res" type="button" class="min-h-[44px] px-6 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 font-semibold text-sm hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] transition-all cursor-pointer">
                結果をコピー
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- EDUCATIONAL CONTENT SECTION -->
      <section class="mt-20 border-t border-zinc-200 dark:border-zinc-800 pt-16 space-y-16">

        <!-- Typing Speed Benchmarks -->
        <article class="max-w-3xl mx-auto space-y-4">
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            日本語タイピング速度の目安（打鍵数/分）
          </h2>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
            ローマ字タイピングにおいて、1分間にどれだけのキーを打鍵できるか（CPM: Characters Per Minute または KPM: Keystrokes Per Minute）は、デスクワークやプログラミングの生産性を左右する重要な指標です。
          </p>

          <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800">
            <table class="w-full text-left border-collapse text-xs sm:text-sm font-mono">
              <thead>
                <tr class="bg-zinc-100 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-bold">
                  <th class="py-3 px-4">レベル分類</th>
                  <th class="py-3 px-4">打鍵速度 (CPM)</th>
                  <th class="py-3 px-4 font-sans">実務・スキルの目安</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                <tr>
                  <td class="py-3 px-4 font-bold text-zinc-500">初級・入門</td>
                  <td class="py-3 px-4 text-zinc-500">〜150 打/分</td>
                  <td class="py-3 px-4 font-sans text-zinc-600 dark:text-zinc-400">キーボードを見ながら打つ段階。ホームポジションの習得が効果的です。</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-zinc-700 dark:text-zinc-300">一般実務</td>
                  <td class="py-3 px-4 text-blue-600 dark:text-blue-400">150〜250 打/分</td>
                  <td class="py-3 px-4 font-sans text-zinc-600 dark:text-zinc-400">日常的なビジネスメールや文書作成に支障のない標準レベルです。</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-emerald-600 dark:text-emerald-400">上級者</td>
                  <td class="py-3 px-4 text-emerald-600 dark:text-emerald-400">250〜350 打/分</td>
                  <td class="py-3 px-4 font-sans text-zinc-600 dark:text-zinc-400">完全なブラインドタッチが可能で、思考とほぼ同速で文字入力ができます。</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-amber-500">プロ・エンジニア</td>
                  <td class="py-3 px-4 text-amber-500">350〜450 打/分</td>
                  <td class="py-3 px-4 font-sans text-zinc-600 dark:text-zinc-400">速記者、プログラマー、ライターなど打鍵速度が強みとなるレベルです。</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-rose-500">神速・大会入賞級</td>
                  <td class="py-3 px-4 text-rose-500">450打/分 超</td>
                  <td class="py-3 px-4 font-sans text-zinc-600 dark:text-zinc-400">タイピング競技会で上位に進出できる上位1%未満の最速域です。</td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>

        <!-- Touch Typing Tips -->
        <article class="max-w-3xl mx-auto space-y-4">
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            タッチタイピング（ブラインドタッチ）最速上達の3原則
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-2">
              <h3 class="font-bold text-base text-zinc-950 dark:text-white">1. ホームポジションを死守する</h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                左手人差し指を「F」、右手人差し指を「J」の突起に常に固定します。各指の担当キーを守ることが速度向上の基盤です。
              </p>
            </div>
            <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-2">
              <h3 class="font-bold text-base text-zinc-950 dark:text-white">2. キーボードを絶対に見ない</h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                間違えても画面だけを見ます。指の空間記憶（筋運動感覚）で打鍵位置を覚えることがブラインドタッチの絶対条件です。
              </p>
            </div>
            <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-2">
