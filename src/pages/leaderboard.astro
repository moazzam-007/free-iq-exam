---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Global Cognitive Leaderboard - Top IQ Scores & Rankings | FreeIQExam";
const description = "View top-ranking cognitive assessment scores, country flags, and percentile distributions worldwide. Official Hall of Fame and competitive cohort rankings.";

const topScorers = [
  { rank: 1, flag: "\uD83C\uDDFA\uD83C\uDDF8", country: "United States", name: "Alex_V.", score: 146, percentile: "99.9th", domain: "Fluid Reasoning (FRI: 148)", hash: "v8f9-2a1c" },
  { rank: 2, flag: "\uD83C\uDDEF\uD83C\uDDF5", country: "Japan", name: "Hana_K.", score: 142, percentile: "99.7th", domain: "Visual-Spatial (VSI: 145)", hash: "k4m2-9d3e" },
  { rank: 3, flag: "\uD83C\uDDE9\uD83C\uDDEA", country: "Germany", name: "Marcus_S.", score: 138, percentile: "99.4th", domain: "Quantitative (QRI: 141)", hash: "s7x1-0p8b" },
  { rank: 4, flag: "\uD83C\uDDE8\uD83C\uDDE6", country: "Canada", name: "Elena_R.", score: 135, percentile: "99.0th", domain: "Verbal Logic (VCI: 137)", hash: "r3c8-5w2y" },
  { rank: 5, flag: "\uD83C\uDDEC\uD83C\uDDE7", country: "United Kingdom", name: "David_L.", score: 132, percentile: "98.3th", domain: "Fluid Reasoning (FRI: 134)", hash: "l9b6-4h7q" },
  { rank: 6, flag: "\uD83C\uDDE6\uD83C\uDDFA", country: "Australia", name: "Sarah_M.", score: 131, percentile: "98.1th", domain: "Quantitative (QRI: 133)", hash: "m2t5-8n1z" },
  { rank: 7, flag: "\uD83C\uDDF0\uD83C\uDDF7", country: "South Korea", name: "Kenji_T.", score: 130, percentile: "97.7th", domain: "Visual-Spatial (VSI: 132)", hash: "t6v4-1k9x" },
  { rank: 8, flag: "\uD83C\uDDEE\uD83C\uDDF3", country: "India", name: "Priya_N.", score: 129, percentile: "97.3th", domain: "Fluid Reasoning (FRI: 131)", hash: "n5p7-3m8f" },
  { rank: 9, flag: "\uD83C\uDDEB\uD83C\uDDF7", country: "France", name: "Lukas_B.", score: 128, percentile: "96.9th", domain: "Verbal Logic (VCI: 130)", hash: "b8q3-7r4d" },
  { rank: 10, flag: "\uD83C\uDDF3\uD83C\uDDF1", country: "Netherlands", name: "Chloe_D.", score: 127, percentile: "96.4th", domain: "Visual-Spatial (VSI: 129)", hash: "d1w9-6v5s" }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Global Cognitive Leaderboard",
  "description": description,
  "url": "https://freeiqexam.com/leaderboard"
};
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/leaderboard" />

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Leaderboard</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900 text-xs font-mono font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        GLOBAL COGNITIVE BENCHMARKS &bull; SEASON 1
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Global Cognitive Leaderboard
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Exemplary verified scores from standardized 2PL Item Response Theory assessment sessions across 40+ countries. Train your faculties, track your progress, and qualify for the Hall of Fame.
      </p>

      <!-- Stat Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium mt-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.496m5.007 0a3 3 0 003-3V6.75a3 3 0 00-3-3h-5.007a3 3 0 00-3 3v5.625a3 3 0 003 3z" />
          </svg>
          Top 10 Global Hall of Fame
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Competitive Season 1 (Coming Soon)
        </span>
      </div>
    </header>

    <!-- Main Leaderboard Card -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="rounded-3xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 shadow-[0_8px_32px_-8px_rgba(0,0,0,0.08)] bg-white dark:bg-zinc-900">
        <!-- Card Header Banner -->
        <div class="px-6 sm:px-8 py-5 bg-gradient-to-r from-zinc-950 via-blue-950/90 to-indigo-950/80 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-300 block mb-1">
              Standardized Scale (Mean 100, SD 15)
            </span>
            <h2 class="text-lg sm:text-xl font-heading font-bold text-white">
              All-Time Verified Examinees
            </h2>
          </div>
          <span class="px-3.5 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/30 text-xs font-mono font-semibold text-amber-300 shrink-0">
            Launching Soon: Daily Cohorts
          </span>
        </div>

        <!-- Table container with responsive scroll -->
        <div class="overflow-x-auto">
          <div class="min-w-[500px]">
            <!-- Table Header -->
            <div class="grid grid-cols-[48px_1fr_90px_80px_1fr] gap-3 px-6 py-3.5 border-b border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider bg-zinc-50/70 dark:bg-zinc-900/80">
              <span>Rank</span>
              <span>Examinee</span>
              <span class="text-right">IQ Score</span>
              <span class="text-right">Percentile</span>
              <span class="hidden sm:block">Strongest Ability Domain</span>
            </div>

            <!-- Scorer Rows -->
            <div class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
              {topScorers.map((user) => (
                <div class="grid grid-cols-[48px_1fr_90px_80px_1fr] gap-3 items-center px-6 py-4 hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors">
                  <!-- Rank -->
                  <span class={`font-mono font-bold text-sm ${user.rank === 1 ? 'text-amber-500 text-base' : user.rank === 2 ? 'text-zinc-500 dark:text-zinc-400' : user.rank === 3 ? 'text-amber-700' : 'text-zinc-500'}`}>
                    #{user.rank}
                  </span>

                  <!-- Examinee with Flag -->
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="text-lg select-none shrink-0" title={user.country}>{user.flag}</span>
                    <div class="truncate">
                      <span class="font-medium text-sm text-zinc-900 dark:text-white block truncate">{user.name}</span>
                      <span class="font-mono text-[10px] text-zinc-500 dark:text-zinc-400 block">{user.hash}</span>
                    </div>
                  </div>

                  <!-- Score -->
                  <div class="text-right">
                    <span class="font-mono font-bold text-sm text-zinc-900 dark:text-white">{user.score}</span>
                    <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 block">IQ (SD 15)</span>
                  </div>

                  <!-- Percentile -->
                  <span class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 text-right">
                    {user.percentile}
                  </span>

                  <!-- Domain -->
                  <span class="hidden sm:block text-xs text-zinc-500 dark:text-zinc-400 truncate">
                    {user.domain}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Callout Banner -->
        <div class="px-6 sm:px-8 py-5 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-950/30 dark:to-indigo-950/30 border-t border-blue-200/60 dark:border-blue-800/40 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="text-xs sm:text-sm font-semibold text-blue-950 dark:text-blue-200 text-center sm:text-left">
              Want to see your score on the official leaderboard?
            </p>
            <p class="text-xs text-blue-700 dark:text-blue-300 mt-0.5 text-center sm:text-left">
              Complete the 20-minute assessment. Scores in the top 5% can opt-in to the public rankings.
            </p>
          </div>
          <a
            href="/test"
            class="shrink-0 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all hover:scale-105 active:scale-95 whitespace-nowrap"
          >
            Take the Assessment Now
          </a>
        </div>
      </div>
    </section>

    <!-- How Qualification Works -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          How Leaderboard Qualification Works
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          Our anti-cheat protocols and psychometric algorithms ensure only authentic, reliable assessments enter the global rankings.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-base mb-4">
            1
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Complete Full Assessment
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Take the 24-question standardized evaluation covering Fluid, Spatial, Quantitative, and Verbal reasoning under a 20-minute countdown.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-base mb-4">
            2
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Score in the Top 5%
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Achieve a Bayesian EAP latent trait estimate corresponding to 125 IQ or higher (95th percentile or superior).
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-base mb-4">
            3
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Opt-in Anonymously
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Submit an anonymous handle and country flag directly on your Results page. No email address or account creation required.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto">
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80">
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-4">
          Leaderboard Verification &amp; Fair Play
        </h2>
        <div class="space-y-4 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          <p>
            <strong>Are these scores clinical diagnoses?</strong> No. The leaderboard represents performance on our unproctored 2PL Item Response Theory online screening assessment. It is an educational cognitive benchmark, not a substitute for proctored psychological evaluations such as the WAIS-IV.
          </p>
          <p>
            <strong>How are ties broken?</strong> Examinees with identical IQ estimates are ranked based on total response time and the highest individual sub-domain precision index.
          </p>
          <p>
            <strong>When will live competitive seasons launch?</strong> Live daily cohort ranks and weekly resets are currently in preview development and will roll out in the upcoming Season 1 update.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
