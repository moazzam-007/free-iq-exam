---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Alternate links for future i18n releases
const alternates = {
  'pt-BR': 'https://freeiqexam.com/pt-br/memento-mori'
};

const title = "Memento Mori Life Calendar: Free Life in Weeks Visualizer | FreeIQExam";
const description = "Visualize your entire life in weeks with our free interactive Memento Mori calendar. Inspired by Stoic philosophy to foster daily gratitude, focus, and perspective.";
const canonicalUrl = "https://freeiqexam.com/memento-mori";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Interactive Memento Mori Life-in-Weeks Calendar",
    "url": "https://freeiqexam.com/memento-mori",
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Interactive 4,000 Weeks Life Grid (80-90+ years visualized week-by-week)",
      "4 Color-coded life eras: Formative Years (0-18), Ascent (18-35), Mastery (35-60), and Legacy (60+)",
      "Actuarial life expectancy calculator with biometric lifestyle modifiers (exercise, sleep, diet, smoking, stress)",
      "Interactive week inspection tooltip displaying exact age, historical dates, and life milestones",
      "Curated daily Stoic reflections from Marcus Aurelius, Seneca, and Epictetus",
      "High-resolution 1200x675 PNG personalized 'Your Life in Weeks' printable poster download",
      "100% private client-side processing with zero personal data transmission"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.97",
      "ratingCount": "24200",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://freeiqexam.com/tools"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Memento Mori Life Calendar",
        "item": "https://freeiqexam.com/memento-mori"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Memento Mori and why do Stoics practice it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Memento Mori is a Latin phrase meaning 'Remember that you must die.' In classical Stoic philosophy (championed by Seneca, Marcus Aurelius, and Epictetus), reflecting upon mortality is not morbid or pessimistic. Instead, it serves as the ultimate cognitive clarifier, cutting through trivial anxieties, eliminating procrastination, fostering profound gratitude, and infusing every waking hour with intentional purpose and virtue."
        }
      },
      {
        "@type": "Question",
        "name": "How many weeks are in an average human lifetime?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "An average human lifespan of 80 years contains approximately 4,160 weeks (80 × 52.1775). By age 30, you have lived approximately 1,560 weeks (37.5% of your life). By age 50, you have lived 2,600 weeks (62.5%). Visualizing your life as a physical 4,000-week grid transforms abstract time into a finite, tangible visual asset."
        }
      },
      {
        "@type": "Question",
        "name": "Why does time seem to accelerate as we grow older?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Psychologists explain this through Janet's Proportional Theory of Time Perception. At age 10, a single year represents 10% of your total lived existence. At age 50, a single year represents only 2% of your life, making it feel five times shorter. Additionally, adulthood often involves predictable routines; the brain stops recording detailed episodic memories when events lack novel sensory stimulation, causing time to compress in retrospect."
        }
      },
      {
        "@type": "Question",
        "name": "How does lifestyle affect statistical life expectancy and healthspan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Epidemiological research from Harvard T.H. Chan School of Public Health demonstrates that adhering to five healthy lifestyle habits—regular aerobic and resistance exercise (+3.5 to +4.5 years), 7-8 hours of regular sleep (+2.4 years), a whole-food Mediterranean diet (+2.8 years), avoiding smoking (+8.5 years), and managing chronic stress—can extend total life expectancy by over 12 to 14 disease-free years (healthspan)."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between lifespan and healthspan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Lifespan refers to the total number of years an individual remains biologically alive. Healthspan refers to the period of life spent in vibrant health, free from chronic debilitating disease, cognitive impairment, or physical frailty. The goal of Stoic self-care and modern longevity medicine is to compress morbidity, matching your healthspan as closely as possible to your lifespan."
        }
      },
      {
        "@type": "Question",
        "name": "What is Amor Fati in Stoic philosophy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Amor Fati is a Latin phrase translating to 'Love of Fate.' Popularized by Friedrich Nietzsche and rooted in the teachings of Marcus Aurelius and Epictetus, it represents the practice of not merely enduring whatever life throws your way, but embracing every hardship, obstacle, and limitation as necessary fuel for character and wisdom."
        }
      },
      {
        "@type": "Question",
        "name": "How does Memento Mori reduce daily anxiety and stress?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Daily anxiety is largely driven by inflating temporary setbacks into existential crises. Meditating on the finitude of life provides instant cosmic perspective (the 'View from Above'). In the grand expanse of time, minor professional disputes, petty criticisms, and social awkwardness shrink to complete insignificance, freeing mental energy for what truly matters."
        }
      },
      {
        "@type": "Question",
        "name": "Is my birthdate or personal information stored on your servers?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Our Memento Mori engine runs 100% locally in your client web browser. Your birthdate, age, lifestyle selections, and milestone notes are processed entirely in browser memory and are never transmitted, logged, or stored on any external server."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
>
  <Header currentPath="/memento-mori" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Stoic Mortality Observatory · 4,000 Weeks Calendar</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Memento Mori Life in Weeks
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        “It is not that we have a short time to live, but that we waste a lot of it.” Visualize your finite 4,000 weeks on Earth, calculate statistical life expectancy, and align daily actions with classical Stoic intentionality.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- Biometric & Lifestyle Input Deck -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-8 mb-8 shadow-xl">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          
          <!-- Date of Birth Input -->
          <div>
            <label for="mementoDob" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Date of Birth</span>
            </label>
            <input
              type="date"
              id="mementoDob"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            />
          </div>

          <!-- Biological Sex Selector -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 4v2" /><path d="M20 12h-2" /><path d="M12 20v-2" /><path d="M4 12h2" /></svg>Biological Sex</span>
            </label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="memento-gender-btn active flex-1 py-2.5 rounded-2xl text-xs font-bold border border-amber-500/40 bg-amber-500/10 text-amber-500 transition-all cursor-pointer"
                data-gender="male"
              >
                ♂ Male
              </button>
              <button
                type="button"
                class="memento-gender-btn flex-1 py-2.5 rounded-2xl text-xs font-medium border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer"
                data-gender="female"
              >
                ♀ Female
              </button>
            </div>
          </div>

          <!-- Poster Download Action Button -->
          <div class="flex flex-col justify-end">
            <button
              type="button"
              id="downloadMementoPosterBtn"
              class="w-full py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-extrabold text-xs sm:text-sm shadow-lg shadow-amber-500/20 transition-all duration-150 transform hover:scale-[1.02] active:scale-98 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>Download Life Poster (PNG)</span>
            </button>
          </div>

        </div>

        <!-- Longevity & Lifestyle Modifiers Toggle -->
        <div class="pt-6">
          <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-3">
            <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18h8" /><path d="M3 22h18" /><path d="M14 22a7 7 0 1 0-7-7h1" /><path d="M9 14h2" /><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z" /><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3" /></svg>Actuarial Healthspan & Lifestyle Factors</span>
          </label>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
            
            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modExercise" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">150m+ Exercise</span>
                <span class="text-[10px] text-emerald-500 font-mono">+3.8 yrs</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modSleep" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">7-8h Sleep</span>
                <span class="text-[10px] text-emerald-500 font-mono">+2.4 yrs</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modDiet" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Clean Diet</span>
                <span class="text-[10px] text-emerald-500 font-mono">+2.8 yrs</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modSmoking" class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Smoking / Vape</span>
                <span class="text-[10px] text-rose-500 font-mono">-8.5 yrs</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modStress" class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Chronic Stress</span>
                <span class="text-[10px] text-rose-500 font-mono">-2.5 yrs</span>
              </div>
            </label>

          </div>
        </div>

      </div>

      <!-- Life Metrics Scorecard -->
      <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-2xl relative overflow-hidden">

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
          
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Weeks Lived</span>
            <span id="statLivedWeeks" class="text-3xl sm:text-4xl font-black font-mono text-amber-400">1,460</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Elapsed Journey</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Weeks Remaining</span>
            <span id="statRemainingWeeks" class="text-3xl sm:text-4xl font-black font-mono text-white">2,700</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Future Potential</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Life Spent</span>
            <span id="statPercentSpent" class="text-3xl sm:text-4xl font-black font-mono text-orange-400">35.1%</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Time Elapsed</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Expected Age</span>
            <span id="statLifeExpectancy" class="text-3xl sm:text-4xl font-black font-mono text-emerald-400">87.2 yrs</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Actuarial Span</span>
          </div>

        </div>

        <!-- Life Progress Bar -->
        <div class="space-y-1.5 mb-6">
          <div class="flex justify-between text-xs font-mono text-zinc-400">
            <span>Age 0</span>
            <span id="statAgeYears" class="text-amber-400 font-bold">28.0 yrs</span>
            <span>Longevity Target</span>
          </div>
          <div class="w-full h-3 bg-zinc-900 rounded-full overflow-hidden border border-zinc-800 p-0.5">
            <div id="lifeProgressBar" class="h-full bg-[#0066cc] dark:bg-[#2997ff] rounded-full transition-all duration-500" style="width: 35.1%;"></div>
          </div>
        </div>

        <!-- Deep Time Breakdown -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-zinc-800 text-center font-mono text-xs text-zinc-400">
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Estimated Days Left</span>
            <span id="statRemainingDays" class="font-bold text-white text-sm">18,900</span>
          </div>
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Estimated Hours Left</span>
            <span id="statRemainingHours" class="font-bold text-white text-sm">453,600</span>
          </div>
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Heartbeats Remaining</span>
            <span id="statRemainingHeartbeats" class="font-bold text-amber-400 text-sm">1,959,552,000</span>
          </div>
        </div>

      </div>

      <!-- 4,000 Weeks Interactive Grid Arena -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-4 sm:p-8 shadow-sm">
        
        <!-- Legend & Eras Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          <div>
            <h2 class="text-base sm:text-lg font-extrabold text-zinc-950 dark:text-white">
              The 4,000 Weeks Life Grid
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Each square represents 1 week (52 weeks per horizontal row = 1 full year).
            </p>
          </div>

          <!-- Dot Legend -->
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Lived Week</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-white shadow-[0_0_6px_#ffffff] animate-pulse"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Current Week</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm border border-zinc-700"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Remaining</span>
            </div>
          </div>
        </div>

        <!-- Life Eras Key -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 text-xs font-mono">
          <div class="p-2 rounded-xl bg-indigo-500/10 border border-indigo-500/30 text-indigo-400">
            <span class="block font-bold">Ages 0 – 18</span>
            <span class="text-[10px] text-zinc-400">Formative Childhood</span>
          </div>
          <div class="p-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">
            <span class="block font-bold">Ages 18 – 35</span>
            <span class="text-[10px] text-zinc-400">Ascent & Ambition</span>
          </div>
          <div class="p-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400">
            <span class="block font-bold">Ages 35 – 60</span>
            <span class="text-[10px] text-zinc-400">Mastery & Climax</span>
          </div>
          <div class="p-2 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400">
            <span class="block font-bold">Ages 60 – 85+</span>
            <span class="text-[10px] text-zinc-400">Wisdom & Legacy</span>
          </div>
        </div>

        <!-- Interactive Grid Container -->
        <div class="relative overflow-x-auto py-2">
          <div id="lifeGridContainer" class="min-w-[640px] space-y-1 select-none"></div>

          <!-- Floating Inspection Tooltip -->
          <div
            id="gridTooltip"
            class="hidden fixed z-50 bg-zinc-950/95 text-white border border-zinc-700 p-3 rounded-xl shadow-2xl backdrop-blur-md pointer-events-none text-xs"
          ></div>
        </div>

      </div>

      <!-- Daily Stoic Meditation Card -->
      <div class="mt-8 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono uppercase tracking-wider text-amber-500 font-bold flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="22" x2="21" y2="22" /><line x1="6" y1="18" x2="6" y2="11" /><line x1="10" y1="18" x2="10" y2="11" /><line x1="14" y1="18" x2="14" y2="11" /><line x1="18" y1="18" x2="18" y2="11" /><polygon points="12 2 20 7 4 7" /></svg>
            <span>Daily Stoic Reflection</span>
          </span>
          <button
            type="button"
            id="nextQuoteBtn"
            class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-amber-500 font-mono transition-colors cursor-pointer"
          >
            <span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>Next Meditation</span>
          </button>
        </div>

        <blockquote class="text-base sm:text-lg font-serif italic text-zinc-800 dark:text-zinc-200 leading-relaxed mb-3">
          <span id="stoicQuoteText">“It is not that we have a short time to live, but that we waste a lot of it.”</span>
        </blockquote>

        <div class="flex items-center justify-between text-xs text-zinc-500 font-mono">
          <span id="stoicQuoteAuthor" class="font-bold text-amber-500">Seneca</span>
          <span id="stoicQuoteSource">De Brevitate Vitae</span>
        </div>
      </div>

    </section>

    <!-- 2,000-Word Philosophical & Actuarial Guide -->
