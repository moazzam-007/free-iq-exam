    .guide h3 { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 1rem; }
    .guide p { font-size: 1.05rem; line-height: 1.75; color: rgb(39 39 42); margin: 0 0 1.1rem; }
    .guide strong { font-weight: 700; color: rgb(24 24 27); }

    /* ============================ FAQ ============================ */
