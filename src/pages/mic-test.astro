      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgb(124 58 237);
    }
    .panel-title {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }
    .panel-help {
      margin: 0.75rem 0 0;
      font-size: 0.95rem;
      line-height: 1.65;
      color: rgb(82 82 91);
    }
    @media (min-width: 640px) { .panel-help { font-size: 1rem; } }

    /* ============================ Notices ============================ */
