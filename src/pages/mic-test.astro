      padding: 1.25rem 1.5rem;
      margin-bottom: 1.25rem;
    }
    .notice-bad { border-color: rgb(220 38 38); background: rgb(254 242 242); }
    .notice-title { margin: 0 0 0.5rem; font-size: 1.05rem; font-weight: 700; }
    .notice-body { margin: 0; font-size: 0.95rem; line-height: 1.6; color: rgb(63 63 70); }

    /* ============================ Controls ============================ */
    .transport-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 0.9rem 1.5rem;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform 0.12s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    .btn:active:not(:disabled) { transform: scale(0.99); }
    .btn:focus-visible { outline: 3px solid rgb(124 58 237); outline-offset: 2px; }
    .btn:disabled { opacity: 0.42; cursor: not-allowed; }

    .btn-primary { background: rgb(124 58 237); color: #ffffff; }
    .btn-primary:hover:not(:disabled) { background: rgb(109 40 217); }
    .btn-ghost { background: #ffffff; border-color: rgb(212 212 216); color: rgb(24 24 27); }
    .btn-ghost:hover:not(:disabled) { border-color: rgb(124 58 237); color: rgb(109 40 217); }
    .btn-quiet { background: transparent; border-color: transparent; color: rgb(113 113 122); padding-left: 0.75rem; padding-right: 0.75rem; }
    .btn-quiet:hover:not(:disabled) { color: rgb(109 40 217); }

    .field-grid { margin-top: 1.25rem; }
    .field { display: block; }
    .field-label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(113 113 122);
      margin-bottom: 0.5rem;
    }
    .field-control {
      width: 100%;
      border: 1px solid rgb(212 212 216);
      border-radius: 0.9rem;
      background: #ffffff;
      color: rgb(24 24 27);
      padding: 0.85rem 1rem;
      font-size: 1rem;
    }
    .field-control:focus-visible { outline: 3px solid rgb(124 58 237); outline-offset: 1px; }

    .dsp-fieldset { margin-top: 1.5rem; border: 0; padding: 0; }
    .dsp-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; }
    .toggle { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; cursor: pointer; }
    .toggle input { width: 1.15rem; height: 1.15rem; accent-color: rgb(124 58 237); cursor: pointer; }

    /* ============================ Hardware ============================ */
    .hw-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      margin: 0;
      background: rgb(228 228 231);
      border: 1px solid rgb(228 228 231);
      border-radius: 1rem;
      overflow: hidden;
    }
    @media (min-width: 640px) { .hw-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1024px) { .hw-grid { grid-template-columns: repeat(3, 1fr); } }

    .hw-item { background: #ffffff; padding: 1rem 1.15rem; }
    .hw-label {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgb(113 113 122);
      margin-bottom: 0.4rem;
    }
    .hw-value {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 1.05rem;
      font-weight: 700;
      color: rgb(24 24 27);
      overflow-wrap: anywhere;
    }
    .hw-value-text { font-size: 0.95rem; font-weight: 600; }

    /* ============================ Meter ============================ */
    .readout-pair { display: flex; gap: 1.5rem; }
    .readout { text-align: right; }
    .readout-label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgb(113 113 122);
    }
    .readout-value {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.15;
      color: rgb(24 24 27);
    }
    .readout-unit { font-size: 0.7rem; font-weight: 600; margin-left: 0.25rem; color: rgb(113 113 122); }

    .meter-track {
      position: relative;
      height: 1.35rem;
      margin-top: 1.25rem;
      border-radius: 999px;
      overflow: hidden;
      /* The gradient is mapped to dB, not to pixel position: green runs to
         -24 dBFS, amber to -12, red for the last 12 dB before the ceiling. */
      background: linear-gradient(
        90deg,
        rgb(16 185 129) 0%,
        rgb(16 185 129) 58%,
        rgb(245 158 11) 62%,
        rgb(245 158 11) 78%,
        rgb(239 68 68) 82%,
        rgb(239 68 68) 100%
      );
      opacity: 0.95;
    }
    /* The gradient lives on the track and is anchored to the full -60..0
       scale, so a lit segment always carries the colour that belongs to its
       own dB position. The fill therefore masks the *unlit* remainder from
       the right edge; the engine sets its width to (100 - level). */
    .meter-fill {
      position: absolute;
      inset: 0 0 0 auto;
      width: 100%;
      background: rgb(228 228 231);
      transition: width 0.06s linear;
    }
    .meter-track::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 12px);
      pointer-events: none;
    }
    .dark .meter-track::after {
      background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px 12px);
    }
    .meter-peak-marker {
      position: absolute;
      top: -2px;
      bottom: -2px;
      left: 0%;
      width: 3px;
      border-radius: 2px;
      background: #ffffff;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.45);
      transition: left 0.08s linear;
      pointer-events: none;
    }
    .meter-ticks {
      display: flex;
      justify-content: space-between;
      margin-top: 0.45rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 600;
      color: rgb(113 113 122);
    }

    .clip-indicator {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgb(212 212 216);
      padding: 0.4rem 0.9rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: rgb(161 161 170);
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .clip-indicator.is-active {
      background: rgb(220 38 38);
      border-color: rgb(220 38 38);
      color: #ffffff;
    }

    /* ============================ Spectrum ============================ */
    .spectrum-wrap {
      margin-top: 1.25rem;
      border: 1px solid rgb(228 228 231);
      border-radius: 1rem;
      background: rgb(250 250 250);
      padding: 0.75rem;
    }
    .spectrum-canvas { display: block; width: 100%; height: 15rem; }

    .band-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 0.85rem;
      color: rgb(82 82 91);
    }
    .band-legend li { display: inline-flex; align-items: center; gap: 0.45rem; }
    .band-swatch { width: 0.7rem; height: 0.7rem; border-radius: 3px; display: inline-block; }

    /* ============================ Diagnostics ============================ */
    .diag-list { margin: 0; display: flex; flex-direction: column; gap: 1px; background: rgb(228 228 231); border: 1px solid rgb(228 228 231); border-radius: 1rem; overflow: hidden; }
    .diag-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: #ffffff; padding: 0.95rem 1.15rem; }
    .diag-label { font-size: 0.95rem; font-weight: 600; color: rgb(82 82 91); }
    .diag-value {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.95rem;
      font-weight: 700;
      text-align: right;
    }
    .diag-value.good { color: rgb(5 150 105); }
    .diag-value.moderate { color: rgb(180 83 9); }
    .diag-value.bad { color: rgb(220 38 38); }
    .diag-value.neutral { color: rgb(113 113 122); }

    /* ============================ SNR ============================ */
    .analysis-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      margin: 1.25rem 0 0;
      background: rgb(228 228 231);
      border: 1px solid rgb(228 228 231);
      border-radius: 1rem;
      overflow: hidden;
    }
    @media (min-width: 640px) { .analysis-grid { grid-template-columns: repeat(3, 1fr); } }
    .analysis-item { background: #ffffff; padding: 1.1rem 1.15rem; }
    .analysis-item-accent { background: rgb(245 243 255); }
    .analysis-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(113 113 122);
      margin-bottom: 0.45rem;
    }
    .analysis-value {
      margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 1.5rem;
      font-weight: 700;
      color: rgb(24 24 27);
    }

    .result-badge {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgb(212 212 216);
      padding: 0.45rem 1rem;
      font-size: 0.85rem;
      font-weight: 700;
    }
    .result-badge.neutral { background: rgb(244 244 245); color: rgb(63 63 70); border-color: rgb(212 212 216); }
    .result-badge.good { background: rgb(236 253 245); color: rgb(4 120 87); border-color: rgb(167 243 208); }
    .result-badge.moderate { background: rgb(255 251 235); color: rgb(180 83 9); border-color: rgb(253 230 138); }
    .result-badge.bad { background: rgb(254 242 242); color: rgb(185 28 28); border-color: rgb(254 202 202); }

    .noise-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.25rem; }
    .noise-status { font-size: 0.9rem; color: rgb(82 82 91); }
    .noise-progress-track { height: 4px; border-radius: 999px; background: rgb(228 228 231); overflow: hidden; margin-top: 0.85rem; }
    .noise-progress { height: 100%; width: 0%; background: rgb(124 58 237); transition: width 0.1s linear; }

    /* ============================ Guide ============================ */
    .guide { max-width: 52rem; }
    .guide-head { margin-bottom: 2.5rem; }
    .guide-title { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0.75rem 0 0; }
    @media (min-width: 640px) { .guide-title { font-size: 2.5rem; } }
    .guide-standfirst { margin-top: 1rem; font-size: 1.1rem; line-height: 1.6; color: rgb(82 82 91); }
