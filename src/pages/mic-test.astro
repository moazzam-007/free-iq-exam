    .faq-title { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 1.5rem; }
    .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .faq-item { border: 1px solid rgb(228 228 231); border-radius: 1rem; padding: 1.1rem 1.35rem; }
