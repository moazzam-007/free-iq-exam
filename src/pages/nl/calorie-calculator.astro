---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Calorie Calculator: Caloriebehoefte & BMR Berekenen | FreeIQExam";
const description = "Bereken nauwkeurig je dagelijkse caloriebehoefte (TDEE), BMR en macronutriënten voor afvallen, spieropbouw of gewichtsbehoud. 100% gratis en wetenschappelijk onderbouwd.";
const canonicalUrl = "https://freeiqexam.com/nl/calorie-calculator";

const alternates = {
  en: "https://freeiqexam.com/calorie-calculator",
  ru: "https://freeiqexam.com/ru/calorie-calculator",
  id: "https://freeiqexam.com/id/kalkulator-kalori",
  fi: "https://freeiqexam.com/fi/kalorilaskuri",
  de: "https://freeiqexam.com/de/kalorienrechner",
  'pt-BR': "https://freeiqexam.com/pt-br/calculadora-de-calorias",
  nl: "https://freeiqexam.com/nl/calorie-calculator"
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Caloriebehoefte & BMR Calculator",
    "url": "https://freeiqexam.com/nl/calorie-calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript support",
    "inLanguage": "nl",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Basaal metabolisme berekening (BMR) met Mifflin-St Jeor (gouden standaard), Katch-McArdle (vetvrije massa) en Oxford-formule",
      "Totale dagelijkse energiebehoefte (TDEE) gebaseerd op 5 fysieke activiteitsfactoren (PAL)",
      "Doelgerichte caloriebehoefte: Licht tekort (-10%), Standaard tekort (-20%), Agressief tekort (-25%), Droge spiermassa (+10%), Massa opbouw (+20%)",
      "Interactieve macronutriëntenverdeling in grammen voor 4 voedingsprotocollen: Eiwitrijk, Gebalanceerd, Koolhydraatarm/Keto, Plantaardig/Duursport",
      "Neurometabool glucoseverbruik van de hersenen (~20% van basaal metabolisme)",
      "US Navy lichaamsvetpercentage calculator (nek, taille, heupomtrek)",
      "Dubbele eenhedenconversie: Metrisch (kg/cm) en Imperiaal (lbs/ft-in) met realtime synchronisatie",
      "Interactief 60FPS high-DPI canvas macronutriënten donutdiagram"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.99",
      "ratingCount": "95400",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/nl/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Caloriebehoefte Calculator",
        "item": "https://freeiqexam.com/nl/calorie-calculator"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="nl"
>
  <Header currentPath="/nl/calorie-calculator" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Mifflin-St Jeor &amp; Katch-McArdle Berekeningsmodule</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Calorie Calculator &amp; TDEE Berekenen
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        Bereken je dagelijkse caloriebehoefte (TDEE), basaal metabolisme (BMR), optimaal calorietekort voor afvallen en macronutriënten in grammen – gratis, zonder registratie en direct in je browser.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Left Column: Inputs Form (7 Cols) -->
        <div class="lg:col-span-7 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-7 shadow-lg space-y-6">

          <!-- Unit & Gender Selectors -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-zinc-200 dark:border-zinc-800/80">

            <!-- Unit Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                id="calc-unit-metric"
                class="cal-unit-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer active:scale-[0.97]"
                data-unit="metric"
              >
                Metrisch (kg / cm)
              </button>
              <button
                type="button"
                id="calc-unit-us"
                class="cal-unit-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer active:scale-[0.97]"
                data-unit="imperial"
              >
                Imperiaal (lbs / ft-in)
              </button>
            </div>

            <!-- Gender Selector -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-xs">
              <button
                type="button"
                id="calc-gender-m"
                class="cal-gender-btn active px-3.5 py-1.5 rounded-xl font-bold transition-all bg-emerald-500/10 text-emerald-500 border border-emerald-500/40 cursor-pointer active:scale-[0.97]"
                data-gender="male"
              >
                ♂ Man
              </button>
              <button
                type="button"
                id="calc-gender-f"
                class="cal-gender-btn px-3.5 py-1.5 rounded-xl font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer active:scale-[0.97]"
                data-gender="female"
              >
                ♀ Vrouw
              </button>
            </div>

          </div>

          <!-- Biometric Inputs Grid -->
          <div class="space-y-4">

            <!-- Age & Optional Body Fat -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calAge" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Leeftijd (jaren)
                </label>
                <input
                  type="number"
                  id="calAge"
                  value="28"
                  min="12"
                  max="110"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="calBodyFat" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                    Vetpercentage % <span class="text-[10px] text-zinc-400 lowercase font-sans">(optioneel)</span>
                  </label>
                  <span id="navyBfResultBadge" class="hidden text-[10px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full"></span>
                </div>
                <input
                  type="number"
                  id="calBodyFat"
                  placeholder="bijv: 16"
                  step="0.1"
                  min="4"
                  max="60"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Metric Inputs (Weight kg, Height cm) -->
            <div id="metricInputsWrap" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Gewicht (kg)
                </label>
                <input
                  type="number"
                  id="calWeightMetric"
                  value="75"
                  step="0.5"
                  min="25"
                  max="300"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label for="calHeightMetric" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Lengte (cm)
                </label>
                <input
                  type="number"
                  id="calHeightMetric"
                  value="178"
                  min="80"
                  max="250"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>
            </div>

            <!-- Imperial Inputs - Hidden by default -->
            <div id="imperialInputsWrap" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="calWeightImperial" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Gewicht (lbs)
                </label>
                <input
                  type="number"
                  id="calWeightImperial"
                  value="165"
                  step="1"
                  min="55"
                  max="660"
                  class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                  Lengte (feet &amp; inches)
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <input
                    type="number"
                    id="calHeightFeet"
                    value="5"
                    min="3"
                    max="8"
                    placeholder="Feet"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                  <input
                    type="number"
                    id="calHeightInches"
                    value="10"
                    min="0"
                    max="11"
                    placeholder="Inches"
                    class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                </div>
              </div>
            </div>

            <!-- Activity Level Multiplier -->
            <div>
              <label for="calActivity" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                Dagelijks Activiteitsniveau (PAL)
              </label>
              <select
                id="calActivity"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
              >
                <option value="1.2">Sedentair (weinig tot geen beweging, zittend werk) &times; 1,20</option>
                <option value="1.375" selected>Licht Actief (lichte sport 1-3 dagen per week) &times; 1,375</option>
                <option value="1.55">Gemiddeld Actief (matige sport 3-5 dagen per week) &times; 1,55</option>
                <option value="1.725">Zeer Actief (intensieve training 6-7 dagen per week) &times; 1,725</option>
                <option value="1.9">Extreem Actief (zware fysieke arbeid of 2x per dag trainen) &times; 1,90</option>
              </select>
            </div>

            <!-- Primary Goal Selector -->
            <div>
              <label for="calGoal" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
                Caloriedoelstelling
              </label>
              <select
                id="calGoal"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
              >
                <option value="maintain">Gewichtsbehoud (0% tekort / onderhoud)</option>
                <option value="mild-cut">Licht Tekort (-10% calorieën &bull; geleidelijk en duurzaam)</option>
                <option value="standard-cut" selected>Standaard Tekort (-20% calorieën &bull; aanbevolen voor vetverlies)</option>
                <option value="aggressive-cut">Agressief Tekort (-25% calorieën &bull; snel vetverlies)</option>
                <option value="lean-bulk">Droge Spiermassa (+10% calorieën &bull; spieropbouw met minimaal vet)</option>
                <option value="heavy-bulk">Massa Opbouw (+20% calorieën &bull; maximale spierhypertrofie)</option>
              </select>
            </div>

            <!-- Optional: US Navy Body Fat Tape Measurement Drawer -->
            <div class="pt-2">
              <button
                type="button"
                id="navyCalcToggle"
                class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1.5 cursor-pointer"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 8v8" /><path d="M8 12h8" /></svg>
                Vetpercentage niet bekend? Bereken met meetlint (US Navy Methode)
              </button>

              <div id="navyCalcBody" class="hidden mt-3 p-4 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 space-y-3">
                <p class="text-xs text-zinc-500 dark:text-zinc-400">
                  Meet je lichaamsomtrekken om het geschatte vetpercentage te berekenen:
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label for="calNeckMetric" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Nek (cm)
                    </label>
                    <input
                      type="number"
                      id="calNeckMetric"
                      placeholder="bijv: 38"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                  <div>
                    <label for="calWaistMetric" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Taille (cm)
                    </label>
                    <input
                      type="number"
                      id="calWaistMetric"
                      placeholder="bijv: 84"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                  <div id="navyHipField" class="hidden">
                    <label for="calHipMetric" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Heupen (cm)
                    </label>
                    <input
                      type="number"
                      id="calHipMetric"
                      placeholder="bijv: 98"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                </div>

                <div id="navyImperialFields" class="hidden grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label for="calNeckImperial" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Nek (inch)
                    </label>
                    <input
                      type="number"
                      id="calNeckImperial"
                      placeholder="bijv: 15"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                  <div>
                    <label for="calWaistImperial" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Taille (inch)
                    </label>
                    <input
                      type="number"
                      id="calWaistImperial"
                      placeholder="bijv: 33"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                  <div id="navyHipFieldImperial" class="hidden">
                    <label for="calHipImperial" class="block text-[11px] font-mono font-medium text-zinc-500 uppercase mb-1">
                      Heupen (inch)
                    </label>
                    <input
                      type="number"
                      id="calHipImperial"
                      placeholder="bijv: 38"
                      class="w-full bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 rounded-xl px-3 py-1.5 text-xs font-mono"
                    />
                  </div>
                </div>

                <button
                  type="button"
                  id="applyNavyBfBtn"
                  class="px-4 py-2 rounded-xl bg-emerald-500 text-white font-semibold text-xs transition-all hover:bg-emerald-600 cursor-pointer active:scale-[0.97]"
                >
                  Bereken en Pas Vetpercentage Toe
                </button>
              </div>
            </div>

          </div>

        </div>

        <!-- Right Column: Interactive Results & Analytics (5 Cols) -->
        <div class="lg:col-span-5 space-y-5">

          <!-- Primary Calorie Target Card -->
          <div class="bg-zinc-900 text-white border border-zinc-800 rounded-3xl p-6 shadow-2xl relative overflow-hidden space-y-5">

            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold block mb-1">
                Aanbevolen Dagelijkse Calorie-inname
              </span>
              <div class="flex items-baseline gap-2">
                <span id="targetCaloriesDisplay" class="font-heading font-extrabold text-4xl sm:text-5xl tracking-tight text-white">
                  1.980
                </span>
                <span class="text-sm sm:text-base font-mono font-normal text-zinc-400">kcal / dag</span>
              </div>
              <p id="targetGoalLabel" class="text-xs font-mono text-emerald-400 mt-1">
                Standaard Tekort (-20%) voor duurzaam vetverlies
              </p>
            </div>

            <!-- TDEE & BMR Sub-Metrics Grid -->
            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-zinc-800">
              <div class="bg-zinc-950/80 p-3 rounded-2xl border border-zinc-800/80">
                <span class="text-[10px] font-mono text-zinc-400 uppercase block mb-0.5">Totaalverbruik (TDEE)</span>
                <span id="tdeeDisplay" class="font-mono font-bold text-lg sm:text-xl text-zinc-100">2.475</span>
                <span class="text-[10px] text-zinc-400 block">kcal onderhoud</span>
              </div>
              <div class="bg-zinc-950/80 p-3 rounded-2xl border border-zinc-800/80">
                <span class="text-[10px] font-mono text-zinc-400 uppercase block mb-0.5">Basaal Metabolisme (BMR)</span>
                <span id="bmrDisplay" class="font-mono font-bold text-lg sm:text-xl text-zinc-100">1.720</span>
                <span class="text-[10px] text-zinc-400 block">kcal in rust</span>
              </div>
            </div>

            <!-- Deficit / Surplus Note -->
            <div class="bg-zinc-950/40 p-3 rounded-2xl border border-zinc-800/60 text-xs text-zinc-300">
              <span id="targetDeficitSub" class="block font-medium">
                Dagelijks tekort van 495 kcal &bull; Geschat vetverlies: ~0,45 kg per week.
              </span>
            </div>

          </div>

          <!-- Macronutrient Splitter Module -->
          <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-6 shadow-lg space-y-5">

            <div class="flex items-center justify-between">
              <h3 class="font-heading font-bold text-sm sm:text-base text-zinc-950 dark:text-white">
                Macronutriëntenverdeling
              </h3>
              <select
                id="macroProtocol"
                class="bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-2.5 py-1 text-xs font-medium text-zinc-900 dark:text-zinc-100 focus:outline-none cursor-pointer"
              >
                <option value="high-protein" selected>Eiwitrijk (35/40/25)</option>
                <option value="balanced">Gebalanceerd (30/45/25)</option>
                <option value="low-carb">Koolhydraatarm / Keto (35/15/50)</option>
                <option value="plant-based">Plantaardig / Duursport (20/60/20)</option>
              </select>
            </div>

            <!-- Macro Doughnut Chart & Gram Details -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">

              <!-- Interactive 60FPS Canvas Chart -->
              <div class="sm:col-span-5 flex justify-center">
                <div class="relative w-32 h-32">
                  <canvas id="macroChart" width="256" height="256" class="w-full h-full"></canvas>
                  <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                    <span class="text-[10px] font-mono text-zinc-400">Totaal</span>
                    <span id="chartCalCenter" class="font-mono font-bold text-xs text-zinc-900 dark:text-white">1.980</span>
                  </div>
                </div>
              </div>

              <!-- Macro Grams Breakdown -->
              <div class="sm:col-span-7 space-y-2 text-xs font-mono">

                <!-- Protein -->
                <div class="p-2.5 rounded-xl bg-white dark:bg-zinc-900/60 border border-emerald-500/30 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    <span class="font-bold text-zinc-900 dark:text-zinc-100 font-sans">Eiwitten</span>
                  </div>
                  <div class="text-right">
                    <span id="macroProteinGrams" class="font-bold text-emerald-500 text-sm block">173g</span>
                    <span id="macroProteinKcal" class="text-[10px] text-zinc-400 block">693 kcal (35 %)</span>
                  </div>
