    };

    function $(id) { return document.getElementById(id); }

    function showToast(msg) {
      var toast = $('cocToast');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('coc-toast-show');
      setTimeout(function () { toast.classList.remove('coc-toast-show'); }, 2400);
    }

    function save() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.items));
      } catch (e) {}
    }

    function load() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          var parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) state.items = parsed;
        }
      } catch (e) {}
    }

    function computeRadius(zone) {
      if (zone === 'control') return 8 + Math.random() * 10;
      if (zone === 'influence') return 22 + Math.random() * 9;
      return 36 + Math.random() * 9;
    }

    function addItem(text, zone) {
      var clean = String(text || '').trim();
      if (!clean) return;
      clean = clean.slice(0, MAX_TEXT_LEN);

      var angle = Math.random() * Math.PI * 2;
      var r = computeRadius(zone);

      var item = {
        id: 'coc_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6),
        text: clean,
        zone: zone,
        x: 50 + Math.cos(angle) * r,
        y: 50 + Math.sin(angle) * r
      };

      state.items.push(item);
      save();
      render();
    }

    function removeItem(id) {
      state.items = state.items.filter(function (it) { return it.id !== id; });
      save();
      render();
    }

    function setItemZone(id, newZone) {
      var item = state.items.find(function (it) { return it.id === id; });
      if (!item) return;
      item.zone = newZone;
      var angle = Math.random() * Math.PI * 2;
      var r = computeRadius(newZone);
      item.x = 50 + Math.cos(angle) * r;
      item.y = 50 + Math.sin(angle) * r;
      save();
      render();
    }

    function renderCards() {
      var container = $('cocCards');
      var emptyNotice = $('cocEmpty');
      if (!container) return;
      container.innerHTML = '';

      if (state.items.length === 0) {
        if (emptyNotice) emptyNotice.style.display = 'flex';
        return;
      }
      if (emptyNotice) emptyNotice.style.display = 'none';

      state.items.forEach(function (item) {
        var card = document.createElement('div');
        card.className = 'coc-card coc-card-' + item.zone;
        card.style.left = item.x + '%';
        card.style.top = item.y + '%';

        var tagInfo = ZONES[item.zone] || ZONES.control;

        card.innerHTML = 
          '<span class="coc-card-tag">' + tagInfo.tagText + '</span>' +
          '<span class="coc-card-text">' + item.text + '</span>' +
          '<div class="coc-card-actions">' +
            '<button type="button" class="coc-mini coc-mini-c" title="Directe Controle">C</button>' +
            '<button type="button" class="coc-mini coc-mini-f" title="Invloed">I</button>' +
            '<button type="button" class="coc-mini coc-mini-n" title="Betrokkenheid / Loslaten">B</button>' +
            '<button type="button" class="coc-mini coc-mini-d" title="Verwijderen">&times;</button>' +
          '</div>';

        var btnC = card.querySelector('.coc-mini-c');
        var btnI = card.querySelector('.coc-mini-f');
        var btnB = card.querySelector('.coc-mini-n');
        var btnD = card.querySelector('.coc-mini-d');

        if (btnC) btnC.addEventListener('click', function (e) { e.stopPropagation(); setItemZone(item.id, 'control'); });
        if (btnI) btnI.addEventListener('click', function (e) { e.stopPropagation(); setItemZone(item.id, 'influence'); });
        if (btnB) btnB.addEventListener('click', function (e) { e.stopPropagation(); setItemZone(item.id, 'concern'); });
        if (btnD) btnD.addEventListener('click', function (e) { e.stopPropagation(); removeItem(item.id); });

        // Dragging support
        card.addEventListener('mousedown', function (e) {
          if (e.target.tagName === 'BUTTON') return;
          e.preventDefault();
          var arenaEl = $('cocArena');
          if (!arenaEl) return;
          var rect = arenaEl.getBoundingClientRect();

          function onMouseMove(moveEvent) {
            var px = ((moveEvent.clientX - rect.left) / rect.width) * 100;
            var py = ((moveEvent.clientY - rect.top) / rect.height) * 100;
            px = Math.max(8, Math.min(92, px));
            py = Math.max(8, Math.min(92, py));
            item.x = px;
            item.y = py;
            card.style.left = px + '%';
            card.style.top = py + '%';

            // Auto-classify by radius
            var dx = px - 50;
            var dy = py - 50;
            var dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 20) item.zone = 'control';
            else if (dist < 35) item.zone = 'influence';
            else item.zone = 'concern';
          }

          function onMouseUp() {
            window.removeEventListener('mousemove', onMouseMove);
            window.removeEventListener('mouseup', onMouseUp);
            save();
            render();
          }

          window.addEventListener('mousemove', onMouseMove);
          window.addEventListener('mouseup', onMouseUp);
        });

        container.appendChild(card);
      });
    }

    function renderScorecard() {
      var total = state.items.length;
      var countControl = 0;
      var countInfluence = 0;
      var countConcern = 0;

      state.items.forEach(function (it) {
        if (it.zone === 'control') countControl++;
        else if (it.zone === 'influence') countInfluence++;
        else countConcern++;
      });

      var agencyPct = total > 0 ? Math.round(((countControl + countInfluence * 0.5) / total) * 100) : 0;

      if ($('countText')) $('countText').textContent = total + ' situatie' + (total === 1 ? '' : 's') + ' in het observatorium';
      if ($('statControl')) $('statControl').textContent = String(countControl);
      if ($('statInfluence')) $('statInfluence').textContent = String(countInfluence);
      if ($('statConcern')) $('statConcern').textContent = String(countConcern);
      if ($('statAgency')) $('statAgency').textContent = total > 0 ? (agencyPct + '%') : '—';
      if ($('agencyBar')) $('agencyBar').style.width = agencyPct + '%';

      var diag = $('agencyDiagnostic');
      if (diag) {
        if (total === 0) {
          diag.textContent = 'Voeg situaties toe om uw persoonlijke energie-allocatie te berekenen.';
        } else if (agencyPct >= 70) {
          diag.textContent = 'Uitstekende focus! Het overgrote deel van uw aandacht ligt op zaken die u direct kunt vormgeven.';
        } else if (agencyPct >= 45) {
          diag.textContent = 'Gebalanceerde verdeling. Overweeg enkele zorgen uit de Cirkel van Betrokkenheid los te laten of om te zetten.';
        } else {
          diag.textContent = 'Let op: Meer dan de helft van uw aandacht gaat naar externe factoren. Dit leidt tot frustratie en vermoeidheid.';
        }
      }

      // Reframe selector options
      var reframeSel = $('reframeSelect');
      if (reframeSel) {
        reframeSel.innerHTML = '';
        var concerns = state.items.filter(function (it) { return it.zone === 'concern'; });
        if (concerns.length === 0) {
          var opt = document.createElement('option');
          opt.value = '';
          opt.textContent = 'Geen zorgen aanwezig — de innerlijke burcht is rustig';
          reframeSel.appendChild(opt);
        } else {
          concerns.forEach(function (it) {
            var o = document.createElement('option');
            o.value = it.id;
            o.textContent = it.text;
            reframeSel.appendChild(o);
          });
        }
      }

      // Action plan lists
      var focusList = $('planFocusList');
      var influenceList = $('planInfluenceList');
      var releaseList = $('planReleaseList');

      if (focusList) focusList.innerHTML = '';
      if (influenceList) influenceList.innerHTML = '';
      if (releaseList) releaseList.innerHTML = '';

      state.items.forEach(function (it) {
        var li = document.createElement('li');
        li.textContent = it.text;
        if (it.zone === 'control' && focusList) focusList.appendChild(li);
        else if (it.zone === 'influence' && influenceList) influenceList.appendChild(li);
        else if (it.zone === 'concern' && releaseList) releaseList.appendChild(li);
      });

      if (focusList && focusList.children.length === 0) focusList.innerHTML = '<li class="text-zinc-400 italic list-none">Nog geen directe controlepunten</li>';
      if (influenceList && influenceList.children.length === 0) influenceList.innerHTML = '<li class="text-zinc-400 italic list-none">Nog geen invloedspunten</li>';
      if (releaseList && releaseList.children.length === 0) releaseList.innerHTML = '<li class="text-zinc-400 italic list-none">Geen loslaatpunten geregistreerd</li>';
    }

    function renderStarters() {
      var chipsContainer = $('starterChips');
      if (!chipsContainer) return;
      chipsContainer.innerHTML = '';
      STARTERS.forEach(function (s) {
        var chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'coc-chip';
        chip.textContent = '+ ' + s.text;
        chip.addEventListener('click', function () {
          addItem(s.text, s.zone);
          showToast('Toegevoegd aan ' + ZONES[s.zone].label);
        });
        chipsContainer.appendChild(chip);
      });
    }

    function render() {
      renderCards();
      renderScorecard();
    }

    // Event Bindings
    var form = $('worryForm');
    var input = $('worryInput');
    var btnAddC = $('btnAddControl');
    var btnAddI = $('btnAddInfluence');
    var btnAddB = $('btnAddConcern');

    if (btnAddC) btnAddC.addEventListener('click', function () { if (input) { addItem(input.value, 'control'); input.value = ''; } });
    if (btnAddI) btnAddI.addEventListener('click', function () { if (input) { addItem(input.value, 'influence'); input.value = ''; } });
    if (btnAddB) btnAddB.addEventListener('click', function () { if (input) { addItem(input.value, 'concern'); input.value = ''; } });

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (input && input.value.trim()) {
          addItem(input.value, 'control');
          input.value = '';
        }
      });
    }

    // Presets
    document.querySelectorAll('[data-preset]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = btn.getAttribute('data-preset');
        var p = PRESETS[key];
        if (!p) return;
        state.items = [];
        p.items.forEach(function (it) {
          var angle = Math.random() * Math.PI * 2;
          var r = computeRadius(it.zone);
          state.items.push({
            id: 'coc_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6),
            text: it.text,
            zone: it.zone,
            x: 50 + Math.cos(angle) * r,
            y: 50 + Math.sin(angle) * r
          });
        });
        save();
        render();
        showToast('Voorbeeldscenario &bdquo;' + p.title + '&rdquo; geladen');
      });
    });

    // Reframing Engine
    var btnReframe = $('btnBuildReframe');
    var reframePanel = $('reframePanel');
    var reframeText = $('reframeText');
    var reframeAction = $('reframeAction');

    document.querySelectorAll('.coc-virtue-btn').forEach(function (vBtn) {
      vBtn.addEventListener('click', function () {
        document.querySelectorAll('.coc-virtue-btn').forEach(function (b) { b.classList.remove('coc-virtue-active'); });
        vBtn.classList.add('coc-virtue-active');
        state.activeVirtue = vBtn.getAttribute('data-virtue') || 'Wisdom';
      });
    });

    if (btnReframe) {
      btnReframe.addEventListener('click', function () {
        var sel = $('reframeSelect');
        if (!sel || !sel.value) {
          showToast('Kies eerst een zorg uit de selectielijst');
          return;
        }
        var concernItem = state.items.find(function (it) { return it.id === sel.value; });
        if (!concernItem) return;

        var txt = concernItem.text;
        var matched = null;
        for (var i = 0; i < REFRAME_TEMPLATES.length; i++) {
          if (REFRAME_TEMPLATES[i].match.test(txt)) {
            matched = REFRAME_TEMPLATES[i];
            break;
          }
        }

        var reframeStr = matched ? matched.reframe : GENERIC_REFRAMES[Math.floor(Math.random() * GENERIC_REFRAMES.length)];
        var actionStr = matched ? ('Handeling: ' + matched.action) : 'Handeling: Bepaal binnen 15 minuten één aspect waar je wél zeggenschap over hebt.';

        if (reframeText) reframeText.textContent = reframeStr;
        if (reframeAction) reframeAction.textContent = actionStr;
        if (reframePanel) reframePanel.classList.remove('hidden');
        showToast('Nieuw perspectief gegenereerd');
      });
    }

    // Daily Quote
    var btnNextQuote = $('btnNextQuote');
    if (btnNextQuote) {
      btnNextQuote.addEventListener('click', function () {
        state.quoteIndex = (state.quoteIndex + 1) % QUOTES.length;
        var q = QUOTES[state.quoteIndex];
        if ($('stoicQuoteText')) $('stoicQuoteText').textContent = '\u201E' + q.text + '\u201D';
        if ($('stoicQuoteAuthor')) $('stoicQuoteAuthor').textContent = q.author;
        if ($('stoicQuoteSource')) $('stoicQuoteSource').textContent = q.source;
      });
    }

    // Micro commitment
    var btnSaveCommit = $('btnSaveCommit');
    var commitInput = $('commitInput');
    if (btnSaveCommit && commitInput) {
      btnSaveCommit.addEventListener('click', function () {
        var val = commitInput.value.trim();
        if (!val) return;
        try { localStorage.setItem(COMMIT_KEY, val); } catch (e) {}
        showToast('Toewijding opgeslagen');
      });
      try {
        var savedCommit = localStorage.getItem(COMMIT_KEY);
        if (savedCommit) commitInput.value = savedCommit;
      } catch (e) {}
    }

    // Action plan buttons
    var btnCopy = $('btnCopyPlan');
    var btnDownload = $('btnDownloadPlan');
    var btnPrint = $('btnPrintPlan');
    var btnReset = $('btnResetArena');

    if (btnCopy) {
      btnCopy.addEventListener('click', function () {
        var txt = '=== STOÏCIJNS ACTIEPLAN (CIRKEL VAN INVLOED) ===\n\n';
        txt += 'DIRECTE CONTROLE:\n';
        state.items.filter(function (it) { return it.zone === 'control'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        txt += '\nINVLOED:\n';
        state.items.filter(function (it) { return it.zone === 'influence'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        txt += '\nBETROKKENHEID (LOSLATEN):\n';
        state.items.filter(function (it) { return it.zone === 'concern'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        if (commitInput && commitInput.value.trim()) {
          txt += '\nMICRO-TOEWIJDING VOOR VANDAAG:\n' + commitInput.value.trim() + '\n';
        }
        txt += '\nBron: https://freeiqexam.com/nl/cirkel-van-invloed';

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(txt).then(function () { showToast('Actieplan gekopieerd naar klembord'); });
        }
      });
    }

    if (btnDownload) {
      btnDownload.addEventListener('click', function () {
        var txt = '=== STOÏCIJNS ACTIEPLAN (CIRKEL VAN INVLOED) ===\n\n';
        txt += 'DIRECTE CONTROLE:\n';
        state.items.filter(function (it) { return it.zone === 'control'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        txt += '\nINVLOED:\n';
        state.items.filter(function (it) { return it.zone === 'influence'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        txt += '\nBETROKKENHEID (LOSLATEN):\n';
        state.items.filter(function (it) { return it.zone === 'concern'; }).forEach(function (it) { txt += '• ' + it.text + '\n'; });
        var blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'cirkel-van-invloed-actieplan.txt';
        link.click();
      });
    }

    if (btnPrint) {
      btnPrint.addEventListener('click', function () {
        window.print();
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', function () {
        state.items = [];
        save();
        render();
        showToast('Observatorium hersteld');
      });
    }

    load();
    renderStarters();
    render();
  })();
</script>
