---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  'en': 'https://freeiqexam.com/circle-of-control',
  'de': 'https://freeiqexam.com/de/kreis-des-einflusses',
  'nl': 'https://freeiqexam.com/nl/cirkel-van-invloed'
};

const title = "Cirkel van Invloed & Betrokkenheid (Stephen Covey): Gratis Tool | FreeIQExam";
const description = "Breng rust en focus in je leven met de interactieve Cirkel van Invloed en Betrokkenheid tool van Stephen Covey. Sorteer stressfactoren en herwin mentale controle.";
const canonicalUrl = "https://freeiqexam.com/nl/cirkel-van-invloed";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cirkel van Invloed en Betrokkenheid (Covey) — Interactieve Tool",
    "url": canonicalUrl,
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "All",
    "inLanguage": "nl",
    "browserRequirements": "Vereist JavaScript ondersteuning",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Interactieve concentrische SVG-arena (Cirkel van Controle, Invloed en Betrokkenheid)",
      "Stephen Covey proactieve energieallocatie- en Agency Index calculator",
      "Sorteer en herformuleer zorgen via drag & drop en een-klik categorieknoppen",
      "Vier Nederlandse thematische presets: Werk, Relaties, Financiën en Gezondheid",
      "Stoïcijnse herkaderingsmachine gebaseerd op de 4 klassieke deugden",
      "Persoonlijk Stoïcijns Actieplan met micro-toewijding en exportmogelijkheden (.txt, klembord, print)",
      "100% privacy: alle reflecties blijven uitsluitend lokaal in uw eigen browser"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/nl"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Cirkel van Invloed",
        "item": "https://freeiqexam.com/nl/cirkel-van-invloed"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="nl"
>
  <Header currentPath="/nl/cirkel-van-invloed" />

  <main class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Stephen Covey &bull; Cirkel van Invloed &amp; Betrokkenheid</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-tight mb-4">
        Cirkel van Invloed &amp; Betrokkenheid
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        &bdquo;Sommige dingen liggen binnen onze controle en andere niet.&rdquo; Sorteer je zorgen in wat je direct beheerst, wat je kunt beïnvloeden en wat je moet loslaten. Gratis, privé en zonder registratie.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16" aria-label="Interactief observatorium van controle en invloed">

      <!-- Quick-Add Triage Deck -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-8 mb-8 shadow-sm">
        <label for="worryInput" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>
            Benoem een zorg, stressfactor of situatie
          </span>
        </label>
        <form id="worryForm" class="flex flex-col gap-3">
          <input
            type="text"
            id="worryInput"
            maxlength="120"
            autocomplete="off"
            placeholder="bijv. Wat mijn leidinggevende van mijn presentatie vindt…"
            class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-3 text-zinc-900 dark:text-zinc-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <button
              type="button"
              id="btnAddControl"
              class="min-h-[44px] py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm shadow-sm transition-all active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>
              Directe Controle
            </button>
            <button
              type="button"
              id="btnAddInfluence"
              class="min-h-[44px] py-2.5 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs sm:text-sm shadow-sm transition-all active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>
              Mijn Invloed
            </button>
            <button
              type="button"
              id="btnAddConcern"
              class="min-h-[44px] py-2.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:border-rose-400 font-bold text-xs sm:text-sm transition-all active:scale-[0.98] cursor-pointer inline-flex items-center justify-center gap-2"
            >
              <svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              Betrokkenheid (Loslaten)
            </button>
          </div>
        </form>

        <!-- Starter chips -->
        <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800/80">
          <p class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Klik op een voorbeeld om direct toe te voegen:</p>
          <div id="starterChips" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <!-- Four 1-Click Preset Scenarios -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
        <button
          type="button"
          data-preset="work"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 transition-all cursor-pointer group"
        >
          <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">Werk &amp; Deadlines</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Planning &bull; baas &bull; teamoutput</span>
        </button>
        <button
          type="button"
          data-preset="relationship"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500 transition-all cursor-pointer group"
        >
          <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">Relaties &amp; Sociaal</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Erkenning &bull; grenzen &bull; gesprek</span>
        </button>
        <button
          type="button"
          data-preset="financial"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-amber-500 transition-all cursor-pointer group"
        >
          <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7" /><polyline points="16 17 22 17 22 11" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-amber-600 dark:group-hover:text-amber-400">Financiële Zorgen</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Inflatie &bull; budget &bull; markten</span>
        </button>
        <button
          type="button"
          data-preset="health"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-rose-400 transition-all cursor-pointer group"
        >
          <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-rose-500">Gezondheid &amp; Lichaam</span>
          <span class="block text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">Gewoonten &bull; veroudering &bull; slaap</span>
        </button>
      </div>

      <!-- Concentric Arena -->
      <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-4 sm:p-8 mb-8 shadow-xl relative overflow-hidden">

        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 relative">
          <div>
            <h2 class="text-base sm:text-lg font-heading font-extrabold text-white">De Concentrische Arena</h2>
            <p id="countText" class="text-xs font-mono text-zinc-400" aria-live="polite">0 situaties in het observatorium</p>
          </div>
          <div class="flex items-center gap-2 text-[11px] font-mono">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>Controle</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>Invloed</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>Betrokkenheid</span>
          </div>
        </div>

        <div
          id="cocArena"
          class="coc-arena"
          role="application"
          aria-label="Interactieve concentrische cirkels. Sleep situaties naar een ring of gebruik de C, I, B knoppen op elk kaartje."
        >
          <svg viewBox="0 0 100 100" class="coc-rings" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs>
              <radialGradient id="cocConcernGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#fb7185" stop-opacity="0.02"></stop>
                <stop offset="100%" stop-color="#fb7185" stop-opacity="0.10"></stop>
              </radialGradient>
              <radialGradient id="cocInfluenceGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.03"></stop>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.12"></stop>
              </radialGradient>
              <radialGradient id="cocControlGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.06"></stop>
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.20"></stop>
              </radialGradient>
              <filter id="cocGlow" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="1.2" result="blur"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="blur"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>
            <!-- Outer: Concern -->
            <circle id="ringConcern" cx="50" cy="50" r="47" class="coc-ring coc-ring-concern" filter="url(#cocGlow)"></circle>
            <!-- Middle: Influence -->
            <circle id="ringInfluence" cx="50" cy="50" r="34" class="coc-ring coc-ring-influence" filter="url(#cocGlow)"></circle>
            <!-- Inner: Control -->
            <circle id="ringControl" cx="50" cy="50" r="20" class="coc-ring coc-ring-control" filter="url(#cocGlow)"></circle>
            <circle cx="50" cy="50" r="2.2" class="coc-core"></circle>
            <text x="50" y="49.2" text-anchor="middle" class="coc-svg-title">CONTROLE</text>
            <text x="50" y="52.6" text-anchor="middle" class="coc-svg-sub">keuze &bull; inspanning &bull; reactie</text>
            <text x="50" y="24" text-anchor="middle" class="coc-svg-zone">INVLOED</text>
            <text x="50" y="6.5" text-anchor="middle" class="coc-svg-zone coc-svg-zone-outer">BETROKKENHEID — LOSLATEN</text>
          </svg>
          <div id="cocCards" class="coc-cards"></div>
          <div id="cocEmpty" class="coc-empty">
            <strong>Maak het onzichtbare zichtbaar.</strong>
            <span>Voeg hierboven een zorg toe of laad een voorbeeld om je mentale cirkels te kalibreren.</span>
          </div>
        </div>
        <p class="text-[11px] font-mono text-zinc-500 mt-3 relative">Tip: De sleep-positie classificeert automatisch op basis van straal &bull; binnenste = Controle, midden = Invloed, buiten = Betrokkenheid.</p>

        <!-- Live ratio scorecards / Energy Allocation -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5 relative" aria-live="polite">
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Agency Index</span>
            <span id="statAgency" class="text-3xl font-black font-mono text-emerald-400">—</span>
            <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden mt-2">
              <div id="agencyBar" class="coc-bar-fill" style="width: 0%;"></div>
            </div>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-emerald-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Controle</span>
            <span id="statControl" class="text-3xl font-black font-mono text-emerald-400">0</span>
            <span id="ringCountControl" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-cyan-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Invloed</span>
            <span id="statInfluence" class="text-3xl font-black font-mono text-cyan-300">0</span>
            <span id="ringCountInfluence" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-rose-500/30 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider mb-1 flex items-center justify-center gap-1"><svg class="w-2.5 h-2.5" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Betrokkenheid</span>
            <span id="statConcern" class="text-3xl font-black font-mono text-rose-300">0</span>
            <span id="ringCountConcern" class="text-[10px] text-zinc-500 block mt-1"></span>
          </div>
        </div>
        <p id="agencyDiagnostic" class="text-xs text-zinc-400 mt-3 relative">Voeg situaties toe om uw persoonlijke energie-allocatie te berekenen.</p>
      </div>

      <!-- Stoic Action Plan -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-heading font-extrabold text-zinc-950 dark:text-white">Uw Stoïcijnse Actieplan</h2>
            <p id="planIntro" class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Classificeer een situatie om uw gerichte actieplan te genereren.</p>
          </div>
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">Focus &bull; Beïnvloeden &bull; Loslaten</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-5">
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-emerald-500/30">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2 flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Focus &mdash; directe actie</h3>
            <ul id="planFocusList" class="space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-cyan-500/30">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-300 mb-2 flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Sturen &mdash; invloed uitoefenen</h3>
            <ul id="planInfluenceList" class="space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-rose-400/30">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-rose-500 mb-2 flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Loslaten &mdash; acceptatie &amp; rust</h3>
            <ul id="planReleaseList" class="space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
        </div>

        <blockquote class="p-4 rounded-2xl border-l-2 border-amber-500 bg-amber-500/5 text-sm text-zinc-700 dark:text-zinc-300 mb-5">
          <p id="planQuoteText" class="italic">&bdquo;Sommige dingen liggen binnen onze controle en andere niet.&rdquo;</p>
          <cite id="planQuoteAuthor" class="block text-xs font-mono text-zinc-500 mt-1.5 not-italic">Epictetus &bull; Enchiridion 1</cite>
        </blockquote>

        <!-- Micro-commitment -->
        <div class="flex flex-col sm:flex-row gap-2.5 mb-5">
          <label for="commitInput" class="sr-only">Mijn 5 tot 20 minuten micro-toewijding</label>
          <input
            type="text"
            id="commitInput"
            maxlength="140"
            placeholder="Mijn micro-toewijding voor vandaag (5–20 min): bijv. 15 min aan de e-mail werken…"
            class="flex-1 bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-2xl px-4 py-2.5 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
          <button
            type="button"
            id="btnSaveCommit"
            class="min-h-[44px] px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold text-white bg-zinc-900 dark:bg-white dark:text-zinc-900 hover:opacity-90 transition-opacity cursor-pointer whitespace-nowrap"
          >
            Toewijding opslaan
          </button>
        </div>

        <div class="flex flex-wrap gap-2.5">
          <button type="button" id="btnCopyPlan" class="min-h-[44px] px-5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition-all cursor-pointer inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>Kopieer Samenvatting</button>
