---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Depressie Test Online: PHQ-9 Zelftest & Stemmingsmeting | FreeIQExam";
const description = "Herken symptomen van depressieve klachten met de wetenschappelijk onderbouwde PHQ-9 vragenlijst. Anonieme zelftest met directe uitslag en hulplijnen.";
const canonicalUrl = "https://freeiqexam.com/nl/depressie-test";

const alternates = {
  en: "https://freeiqexam.com/depression-test",
  ru: "https://freeiqexam.com/ru/depression-test",
  id: "https://freeiqexam.com/id/tes-depresi",
  fi: "https://freeiqexam.com/fi/masennustesti",
  de: "https://freeiqexam.com/de/depressionstest",
  'pt-BR': "https://freeiqexam.com/pt-br/teste-depressao",
  nl: "https://freeiqexam.com/nl/depressie-test"
};

const faqItems = [
  [
    'Wat is de PHQ-9 en hoe werkt de puntentelling?',
    'De Patient Health Questionnaire-9 (PHQ-9) is een wereldwijd gevalideerde vragenlijst die de 9 officiële DSM-5 criteria voor een depressieve episode meet over de afgelopen 14 dagen. Elk item wordt gescoord van 0 (helemaal niet) tot 3 (bijna elke dag). De totale score varieert van 0 tot 27 en is onderverdeeld in 5 ernstcategorieën.'
  ],
  [
    'Hoe betrouwbaar is de PHQ-9 bij het signaleren van een depressie?',
    'In wetenschappelijke validatiestudies heeft een score van 10 of hoger een sensitiviteit en specificiteit van circa 88% voor het identificeren van een klinisch relevante depressieve episode. Het instrument wordt wereldwijd aanbevolen door huisartsen en GGZ-instellingen als betrouwbare eerstelijns screening.'
  ],
  [
    'Wat betekenen de 5 ernstcategorieën van de PHQ-9?',
    'De scores worden als volgt geïnterpreteerd: 0–4 punten duidt op minimale of geen symptomen; 5–9 punten op lichte klachten (vaak passend bij stress); 10–14 punten op een matige depressieve episode (waarbij professionele ondersteuning wordt aangeraden); 15–19 punten op matig-ernstige klachten; en 20–27 punten op een ernstige depressieve episode die directe specialistische zorg vereist.'
  ],
  [
    'Wat gebeurt er als ik vraag 9 (gedachten aan zelfbeschadiging of dood) positief beantwoord?',
    'Vraag 9 is een essentieel veiligheidsitem. Wanneer u hierop een score van 1 of hoger invult, toont de tool direct een vertrouwelijk overzicht van acute contactgegevens (zoals 113 Zelfmoordpreventie). Dit staat los van uw totaalscore en is bedoeld om direct laagdrempelige hulp te bieden bij zware gevoelens.'
  ],
  [
    'Waarom is er een 10e vraag over het dagelijks functioneren?',
    'Vraag 10 meet de functionele belemmering: hoe moeilijk de symptomen het maken om te werken, voor het huishouden te zorgen of met anderen om te gaan. Deze vraag telt niet mee voor de 0–27 puntenscore, maar geeft behandelaars waardevolle klinische context over de impact op uw dagelijks leven.'
  ],
  [
    'Wat moet ik doen bij een verhoogde score (10 punten of hoger)?',
    'Een score van 10 of hoger is een duidelijke aanleiding om een afspraak te maken met uw huisarts of praktijkondersteuner GGZ (POH-GGZ). U kunt het afdrukbare samenvattingsrapport meenemen naar het spreekuur als gestructureerde voorbereiding op het diagnostisch gesprek.'
  ]
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Depressie Test Online (PHQ-9 Vragenlijst)',
    url: canonicalUrl,
    inLanguage: 'nl',
    medicalAudience: 'Patient',
    aspect: 'Screening',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Depressieve Episode',
      alternateName: ['Depressie', 'Major Depression', 'Depressieve Stoornis'],
      code: { '@type': 'MedicalCode', code: 'F32', codingSystem: 'ICD-10' }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Online Depressie Zelftest & PHQ-9 Screening',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'All',
    inLanguage: 'nl',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    accessibilitySummary: 'Toetsenbordnavigatie met cijfers 1–4 en pijltjestoetsen, veiligheidskritisch crisisinterstitial, schermlezerondersteuning en afdrukbaar rapport.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startpagina', item: 'https://freeiqexam.com/nl/' },
      { '@type': 'ListItem', position: 2, name: 'Zelftests', item: 'https://freeiqexam.com/nl/#tests' },
      { '@type': 'ListItem', position: 3, name: 'Depressie Test (PHQ-9)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'PHQ-9 Depressie Vragenlijst — 9 Vragen',
    url: canonicalUrl,
    inLanguage: 'nl',
    numberOfQuestions: 9,
    isAccessibleForFree: true
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="nl"
>
  <Header currentPath="/nl/depressie-test" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-[#000000] dark:text-white transition-colors duration-200">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">

      <!-- Breadcrumb Navigation -->
      <nav aria-label="Kruimelpad" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/nl/" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Startpagina</a>
        <span aria-hidden="true">/</span>
        <a href="/nl/#tests" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Zelftests</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white font-semibold">Depressie Test (PHQ-9)</span>
      </nav>

      <!-- Hero Header -->
      <header class="mx-auto max-w-4xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-[#2997ff] sm:text-sm">
          <svg class="w-4 h-4 text-[#0066cc] dark:text-[#2997ff]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Wetenschappelijk Gevalideerde PHQ-9 Vragenlijst
        </div>

        <h1 class="mt-6 font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em]">
          Depressie Test Online: Gratis PHQ-9 Zelftest
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Herken symptomen van neerslachtigheid, verlies van interesse en vermoeidheid over de afgelopen 14 dagen volgens de officiële PHQ-9 richtlijnen. Anoniem, gratis en met directe toelichting.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['9 DSM-5 Kernvragen', 'Klinische Drempelwaarde (Score ≥ 10)', 'Veiligheidsinterlock Vraag 9', 'Directe Uitslag', '100% Anoniem & Veilig'].map((item) => (
            <span class="rounded-full border border-zinc-200 bg-zinc-50/80 px-4 py-2 text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-300 shadow-sm">{item}</span>
          ))}
        </div>
      </header>

      <!-- Main Application Container -->
      <section id="depression-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/90 p-5 dark:border-zinc-800 dark:bg-zinc-950 p-6 sm:p-9 shadow-sm">

          <!-- Intro Panel -->
          <div id="assessment-intro" class="rounded-[1.5rem] border border-blue-200 bg-blue-50/70 p-6 dark:border-blue-900/50 dark:bg-blue-950/20 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Belangrijke informatie vooraf</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-3xl">Indicatieve screening — geen definitieve diagnose</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Geef bij elk van de 9 vragen aan hoe vaak u de afgelopen 2 weken last heeft gehad van de beschreven klachten. Deze zelftest biedt inzicht in uw stemming en helpt bepalen of overleg met een huisarts gewenst is.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <button
                id="begin-assessment"
                type="button"
                class="rounded-full bg-[#0066cc] hover:bg-[#0055b3] text-white px-8 py-4 text-base font-semibold shadow-sm transition-all duration-150 hover:scale-[1.02] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 cursor-pointer"
              >
                Start de zelftest
              </button>
              <span class="text-sm text-zinc-500 dark:text-zinc-400">Toetsenbord: toetsen 1–4 voor antwoorden · pijltjestoetsen voor navigatie</span>
            </div>
          </div>

          <!-- Questionnaire Section -->
          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-xs font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">PHQ-9 · Afgelopen 2 weken</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-800 dark:text-zinc-200">Stemming &amp; Emotionele beleving</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold text-zinc-900 dark:text-white sm:text-lg">Vraag 1 van 9</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">0% beantwoord</div>
              </div>
            </div>

            <div class="mt-5 h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
              <div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:10%"></div>
            </div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              <div class="flex flex-wrap gap-2 text-xs sm:text-sm font-semibold text-zinc-500 dark:text-zinc-400">
                <span class="rounded-full border border-zinc-200 px-3 py-1 dark:border-zinc-700">Kies één antwoord</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1 dark:border-zinc-700">Helemaal niet → Bijna elke dag</span>
              </div>

              <h2 id="question-heading" class="mt-6 text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white"></h2>
              <p id="question-context" class="mt-3 text-sm sm:text-base text-zinc-500 dark:text-zinc-400"></p>

              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Antwoordopties frequentie"></div>

              <div id="question-safety-note" class="mt-6 hidden rounded-2xl border border-amber-300 bg-amber-50 p-4 text-xs sm:text-sm text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
                <strong>Let op:</strong> Deze vraag meet gedachten over zelfbeschadiging of de dood. Bij een bevestigend antwoord tonen we direct contactgegevens voor directe ondersteuning.
              </div>

              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button
                  id="back-button"
                  type="button"
                  class="rounded-full border border-zinc-300 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 hover:bg-zinc-50 transition active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 cursor-pointer"
                >
                  Vorige vraag
                </button>
                <button
                  id="next-button"
                  type="button"
                  class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition hover:bg-black active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-white dark:text-zinc-900 cursor-pointer"
                >
                  Volgende vraag
                </button>
              </div>
            </article>
          </section>

          <!-- Crisis Interstitial Modal (Triggers ONLY when Q9 is positive) -->
          <div id="crisis-interstitial" class="hidden my-8 rounded-[1.75rem] border border-rose-200 bg-rose-50/90 p-6 dark:border-rose-900/60 dark:bg-rose-950/40 sm:p-9 shadow-lg">
            <div class="inline-flex items-center gap-2 rounded-full border border-rose-300 bg-rose-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-rose-800 dark:border-rose-800 dark:bg-rose-900/50 dark:text-rose-200">
              Belangrijke Ondersteuning
            </div>
            <h3 class="mt-4 text-2xl font-extrabold text-zinc-900 dark:text-white sm:text-3xl">U staat er niet alleen voor</h3>
            <p class="mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
              U heeft aangegeven gedachten aan de dood of zelfbeschadiging te ervaren. Zware gevoelens kunnen overweldigend zijn, maar er is altijd hulp en een luisterend oor beschikbaar:
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-2 text-sm">
              <div class="rounded-2xl border border-rose-200 bg-white p-4 dark:border-rose-800 dark:bg-zinc-900">
                <strong class="text-zinc-900 dark:text-white block font-bold">113 Zelfmoordpreventie (Nederland)</strong>
                <span class="font-mono font-bold text-lg text-rose-600 dark:text-rose-400">0800-0113</span>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">24/7 gratis, anoniem bellen of chatten via <a href="https://www.113.nl" target="_blank" rel="noopener noreferrer" class="underline">113.nl</a></p>
              </div>
              <div class="rounded-2xl border border-rose-200 bg-white p-4 dark:border-rose-800 dark:bg-zinc-900">
                <strong class="text-zinc-900 dark:text-white block font-bold">De Luisterlijn (Nederland)</strong>
                <span class="font-mono font-bold text-lg text-[#0066cc] dark:text-[#2997ff]">088-0767 000</span>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Dag en nacht bereikbaar voor een vertrouwelijk gesprek</p>
              </div>
              <div class="rounded-2xl border border-rose-200 bg-white p-4 dark:border-rose-800 dark:bg-zinc-900">
                <strong class="text-zinc-900 dark:text-white block font-bold">Zelfmoordlijn 1813 (België)</strong>
                <span class="font-mono font-bold text-lg text-rose-600 dark:text-rose-400">1813</span>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">24/7 gratis en anoniem bereikbaar via telefoon en chat</p>
              </div>
              <div class="rounded-2xl border border-rose-200 bg-white p-4 dark:border-rose-800 dark:bg-zinc-900">
                <strong class="text-zinc-900 dark:text-white block font-bold">Acute Noodsituatie</strong>
                <span class="font-mono font-bold text-lg text-rose-600 dark:text-rose-400">112</span>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Bel direct 112 bij acuut levensgevaar</p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-rose-200 pt-5 dark:border-rose-800">
              <span class="text-xs text-zinc-500 dark:text-zinc-400">U kunt nu doorgaan om uw volledige uitslag te bekijken.</span>
              <button
                id="crisis-continue"
                type="button"
                class="rounded-full bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-black active:scale-[0.97] dark:bg-white dark:text-zinc-900 cursor-pointer"
              >
                Ik begrijp het, ga door naar uitslag
              </button>
            </div>
          </div>

          <!-- Results Section -->
          <section id="results-section" class="hidden" aria-labelledby="results-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900 sm:p-9 shadow-sm">
              
              <!-- Crisis Banner on Results (shows only if Q9 was positive) -->
              <div id="crisis-banner" class="hidden mb-8 rounded-2xl border border-rose-300 bg-rose-50 p-5 dark:border-rose-900/60 dark:bg-rose-950/40">
                <div class="flex items-start gap-3">
                  <div class="shrink-0 text-rose-600 dark:text-rose-400 font-bold text-lg">⚠️</div>
                  <div>
                    <h4 class="font-bold text-zinc-900 dark:text-white text-base">Belangrijke herinnering: hulp bij suïcidale gedachten</h4>
                    <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-300">
                      U heeft aangegeven gedachten aan zelfbeschadiging te hebben. Neem contact op met <strong>113 Zelfmoordpreventie (0800-0113)</strong> of uw huisarts. Er is altijd iemand om mee te praten.
                    </p>
                  </div>
                </div>
              </div>

              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div id="result-badge" class="result-badge low">Minimale symptomen</div>
                  <h2 id="results-title" class="mt-5 text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">Uw indicatieve uitslag</h2>
                  <p id="result-classification" class="mt-2 text-xl font-bold text-[#0066cc] dark:text-[#2997ff]">Minimaal of geen</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-xs sm:text-sm font-semibold text-zinc-600 dark:border-zinc-800 dark:bg-zinc-800 dark:text-zinc-300">
                  Geen medische diagnose
                </div>
              </div>

              <!-- Main Score Card -->
              <div class="mt-8 rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-800/50">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                  <div>
                    <span class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Totale PHQ-9 Score</span>
                    <div id="result-score" class="mt-1 text-4xl font-extrabold text-zinc-900 dark:text-white">0 / 27</div>
                  </div>
                  <div id="cutoff-status" class="rounded-xl border border-zinc-300 px-4 py-2 font-mono text-sm font-bold text-zinc-700 dark:border-zinc-700 dark:text-zinc-300">
                    Onder de klinische drempel van 10
                  </div>
                </div>
                <p id="result-narrative" class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300"></p>
                <div class="mt-4 border-t border-zinc-200 pt-3 dark:border-zinc-700 text-xs text-zinc-500 dark:text-zinc-400">
                  <span id="algorithm-status">DSM-5 criteria</span>
                </div>
              </div>

              <!-- Severity Scale Visualizer -->
              <div class="mt-8">
                <p class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Ernstverdeling op de PHQ-9 Schaal</p>
                <div id="severity-scale" class="mt-3 grid grid-cols-2 sm:grid-cols-5 gap-2"></div>
              </div>

              <!-- Subscale Scores Grid -->
              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <article class="score-card">
                  <div class="score-label">Stemming &amp; Anhedonie</div>
                  <div id="affective-score" class="mt-3 text-2xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div id="affective-status" class="score-status">Lage score</div>
                  <div class="meter"><span id="affective-bar"></span></div>
                </article>
                <article class="score-card">
                  <div class="score-label">Somatisch &amp; Energie</div>
                  <div id="somatic-score" class="mt-3 text-2xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div id="somatic-status" class="score-status">Lage score</div>
                  <div class="meter"><span id="somatic-bar"></span></div>
                </article>
                <article class="score-card">
                  <div class="score-label">Cognitief &amp; Psychomotoriek</div>
                  <div id="cognitive-score" class="mt-3 text-2xl font-extrabold text-zinc-900 dark:text-white">0 / 9</div>
                  <div id="cognitive-status" class="score-status">Lage score</div>
                  <div class="meter"><span id="cognitive-bar"></span></div>
                </article>
              </div>

              <!-- Daily Impairment Item -->
              <div class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-400">Vraag 10 · Dagelijkse Belemmering</span>
                <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">Impact op werk, huishouden en sociale contacten:</p>
                <div id="functional-score" class="mt-2 text-lg font-bold text-zinc-900 dark:text-white">Helemaal niet moeilijk</div>
              </div>

              <!-- Profile Matrix -->
              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Symptoomprofiel</p>
                <h3 class="mt-2 text-xl font-bold text-zinc-900 dark:text-white">Domeinverdeling</h3>
                <div id="profile-matrix" class="mt-6 space-y-5"></div>
              </article>

              <!-- Next Steps List -->
              <article class="mt-6 rounded-3xl border border-blue-200 bg-blue-50/70 p-6 dark:border-blue-900/50 dark:bg-blue-950/20">
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white sm:text-2xl">Aanbevolen Vervolgstappen</h3>
                <ul id="next-steps-list" class="mt-4 space-y-2 text-sm sm:text-base text-zinc-700 dark:text-zinc-300"></ul>
              </article>

              <!-- Action Buttons -->
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button
                  id="print-result"
                  type="button"
                  class="rounded-full bg-zinc-950 px-7 py-4 text-base font-semibold text-white dark:bg-white dark:text-zinc-950 hover:opacity-90 transition active:scale-[0.97] cursor-pointer"
                >
