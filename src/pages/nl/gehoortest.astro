---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  'en': 'https://freeiqexam.com/hearing-test',
  'fi': 'https://freeiqexam.com/fi/kuulotesti',
  'de': 'https://freeiqexam.com/de/hoertest',
  'nl': 'https://freeiqexam.com/nl/gehoortest'
};

const title = "Gratis Gehoortest Online: Frequentie & Audio Bereik | FreeIQExam";
const description = "Test uw gehoor van 20 Hz tot 20 kHz met onze gratis online gehoortest. Bepaal uw biologische oorleeftijd, controleer uw stereobalans en ontdek hoge frequentie verlies.";
const canonicalUrl = "https://freeiqexam.com/nl/gehoortest";

const faqItems = [
  {
    question: "Hoe nauwkeurig is een online gehoortest?",
    answer: "Online gehoortests via de Web Audio API bieden een betrouwbare indicatieve vroege waarschuwingsscreening van gehoordrempels wanneer ze worden uitgevoerd met een goede over-ear hoofdtelefoon in een stille omgeving. Hoewel ze een formeel klinisch audiologisch onderzoek in een geluiddichte cabine niet kunnen vervangen, identificeren ze betrouwbaar leeftijdsgebonden hoogfrequent gehoorverlies (presbyacusis) en asymmetrieën tussen beide oren."
  },
  {
    question: "Heb ik per se een hoofdtelefoon nodig voor deze test?",
    answer: "Ja, een stereohoofdtelefoon of in-ear oortelefoons zijn essentieel. Luidsprekers mengen linker- en rechter audiokanalen in de kamer, waardoor het onmogelijk is elk oor afzonderlijk te testen. Bovendien vervormen kamerakoestiek en achtergrondgeluid de meting en kunnen laptopluidsprekers frequenties boven 10.000 Hz vaak niet zuiver weergeven. Schakel ruimtelijke audio of equalizers uit voor een betrouwbaar resultaat."
  },
  {
    question: "Wat is biologische oorleeftijd en hoe wordt deze berekend?",
    answer: "Biologische oorleeftijd is een schatting van auditieve slijtage gebaseerd op de hoogste akoestische frequentie die u nog kunt waarnemen. Gezonde pasgeborenen hebben circa 16.000 haarcellen en horen tot 20.000 Hz. Naarmate we ouder worden sterven de haarcellen aan de basis van het slakkenhuis geleidelijk af door cumulatieve geluidsbelasting, waardoor de bovengrens daalt: 19 kHz komt overeen met jonger dan 18 jaar, 17 kHz met circa 24 jaar, 15 kHz met 34 jaar, 12 kHz met 54 jaar en 8 kHz met 65+ jaar."
  },
  {
    question: "Wat is het verschil tussen Hertz (Hz) en Decibels (dB)?",
    answer: "Hertz (Hz) meet de frequentie of toonhoogte — hoe snel geluidsgolven trillen per seconde (bijv. een lage bastoon van 250 Hz versus een hoge piep van 17.000 Hz). Decibels (dB) meten de geluidsdruk of het volume op een logaritmische schaal. In de audiometrie geeft dB HL (Hearing Level) de gehoordrempel aan ten opzichte van een gezond menselijk gehoor (0 dB HL)."
  },
  {
    question: "Waarom kunnen jongeren de 'mosquito tone' wel horen en ouderen niet?",
    answer: "De mosquito-toon heeft een frequentie van circa 17.400 Hz (17,4 kHz). De haarcellen die deze ultrahoge frequenties detecteren bevinden zich bij de ingang (basis) van het slakkenhuis en ervaren levenslang de zwaarste mechanische belasting. Rond het 25e levensjaar zijn deze cellen bij de meeste mensen al dermate afgesleten dat 17,4 kHz onhoorbaar wordt, terwijl tieners dit nog scherp waarnemen."
  },
  {
    question: "Wat is de 'spraakbanaan' op een audiogram?",
    answer: "De spraakbanaan is een banaanvormig gebied op een audiogram tussen 250 Hz en 6.000 Hz en 20 tot 55 dB HL waarin menselijke spraakklanken zich bevinden. Klinkers (a, o, oe) zijn laagfrequent (250–1.000 Hz) en dragen het meeste volume. Medeklinkers (s, f, th, k) zijn hoogfrequent (2.000–6.000 Hz) en bepalen de spraakverstaanbaarheid. Bij hoogfrequent gehoorverlies klinkt spraak gedempt en onverstaanbaar."
  },
  {
    question: "Wat is de 60/60 regel van de WHO voor veilig luisteren?",
    answer: "De 60/60-regel van de Wereldgezondheidsorganisatie (WHO) adviseert om audio via een hoofdtelefoon op maximaal 60% van het maximale volume te beluisteren en niet langer dan 60 minuten achter elkaar. Neem daarna minstens 10 tot 15 minuten rust om tijdelijke gehoorvermoeidheid te laten herstellen en permanente schade te voorkomen."
  },
  {
    question: "Kan permanent gehoorverlies worden hersteld of genezen?",
    answer: "Perceptief gehoorverlies (schade aan haarcellen in het slakkenhuis of de gehoorzenuw) is momenteel onomkeerbaar omdat menselijke haarcellen niet teruggroeien. Geleidingsverlies (door bijvoorbeeld oorsmeer of vocht) kan medisch behandeld worden. Perceptief verlies kan succesvol gerevalideerd worden met moderne hoortoestellen of cochleaire implantaten."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Online Gehoorscreening & Biologische Oorleeftijd Test",
    "description": "Indicatieve online gehoorscreening met zuivere toon audiometrie (250 Hz - 8.000 Hz) en presbyacusis frequentieanalyse (8.000 Hz - 20.000 Hz).",
    "url": canonicalUrl,
    "inLanguage": "nl",
    "medicalAudience": "Patient",
    "aspect": "Screening"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Online Gehoortest & Oorleeftijd Calculator",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Vereist Web Audio API ondersteuning en een stereohoofdtelefoon",
    "inLanguage": "nl",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.96",
      "ratingCount": "24800",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startpagina",
        "item": "https://freeiqexam.com/nl/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Zelftests",
        "item": "https://freeiqexam.com/nl/#tests"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Gehoortest & Oorleeftijd",
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
  lang="nl"
>
  <Header currentPath="/nl/gehoortest" />

  <style>
    /* Custom acoustic waveform bar animations */
    .earage-waveform {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 64px;
      margin: 24px 0;
    }

    .earage-waveform .bar {
      width: 4px;
      background: #06b6d4;
      border-radius: 9999px;
      height: 8px;
      transition: height 0.1s ease;
    }

    .earage-waveform.active .bar {
      animation: waveBar 0.8s infinite ease-in-out;
    }

    .earage-waveform.active .bar:nth-child(2) { animation-delay: 0.05s; }
    .earage-waveform.active .bar:nth-child(3) { animation-delay: 0.10s; }
    .earage-waveform.active .bar:nth-child(4) { animation-delay: 0.15s; }
    .earage-waveform.active .bar:nth-child(5) { animation-delay: 0.20s; }
    .earage-waveform.active .bar:nth-child(6) { animation-delay: 0.25s; }
    .earage-waveform.active .bar:nth-child(7) { animation-delay: 0.30s; }
    .earage-waveform.active .bar:nth-child(8) { animation-delay: 0.35s; }
    .earage-waveform.active .bar:nth-child(9) { animation-delay: 0.40s; }
    .earage-waveform.active .bar:nth-child(10) { animation-delay: 0.45s; }
    .earage-waveform.active .bar:nth-child(11) { animation-delay: 0.50s; }
    .earage-waveform.active .bar:nth-child(12) { animation-delay: 0.55s; }
    .earage-waveform.active .bar:nth-child(13) { animation-delay: 0.60s; }
    .earage-waveform.active .bar:nth-child(14) { animation-delay: 0.65s; }
    .earage-waveform.active .bar:nth-child(15) { animation-delay: 0.70s; }
    .earage-waveform.active .bar:nth-child(16) { animation-delay: 0.75s; }
    .earage-waveform.active .bar:nth-child(17) { animation-delay: 0.80s; }
    .earage-waveform.active .bar:nth-child(18) { animation-delay: 0.85s; }
    .earage-waveform.active .bar:nth-child(19) { animation-delay: 0.90s; }
    .earage-waveform.active .bar:nth-child(20) { animation-delay: 0.95s; }

    @keyframes waveBar {
      0%, 100% { height: 10px; }
      50% { height: 58px; }
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @media print {
      header, footer, #calibrationPanel, .no-print {
        display: none !important;
      }
      #resultsWrap {
        display: block !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-500 dark:text-zinc-400">Tools</span>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Hearing Test & Ear Age</span>
    </nav>

    <!-- Header & Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-200 dark:border-cyan-800 text-xs sm:text-sm font-mono font-semibold text-cyan-700 dark:text-cyan-400 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>Klinische Zuivere Toon Audiometrie • Biologische Oorleeftijd Sweep</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Gratis Online Gehoortest & Audio Frequentie Check
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
        Screen uw auditieve scherpte met klinische precisie. Voer hoge-frequentie biologische oorleeftijd sweeps (8-20 kHz) uit of complete zuivere toon audiometrie (250-8.000 Hz) met onafhankelijke linker- en rechteroor stereo-isolatie.
      </p>
    </header>

    <!-- ACOUSTIC SAFETY & CALIBRATION ADVISORY -->
    <div class="max-w-3xl mx-auto mb-10 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
        <div class="space-y-1">
          <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Akoestische Veiligheid & Koptelefoon Vereist</h4>
          <p class="text-amber-800 dark:text-amber-300/90 text-xs sm:text-sm leading-relaxed">
            <strong>1)</strong> Zet een hoogwaardige stereo koptelefoon op. <strong>2)</strong> Zet uw systeemvolume nooit op maximum; begin op 50% volume en gebruik onze 1.000 Hz kalibratietoon om een comfortabele hoorbaarheid te bevestigen. <strong>3)</strong> Schakel ruimtelijke audio, Dolby Atmos en equalizer-presets uit voor klinische nauwkeurigheid.
          </p>
        </div>
      </div>
    </div>

    <!-- TESTING ARENA -->
    <section id="test-arena" class="relative w-full max-w-4xl mx-auto mb-16 scroll-mt-6">
      
      <!-- MODE SELECTOR CARDS -->
      <div id="modeSelector" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Ear Age Test -->
        <button
          type="button"
          data-mode="ear-age"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              Hoge-Frequentie Sweep (8-20 kHz)
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Biologische Oorleeftijd Test
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Vind de hoogste frequentie die uw oren kunnen detecteren. Brengt uw akoestische afkappunt in kaart tegen epidemiologische presbyacusis-gegevens om uw biologische auditieve leeftijd te berekenen.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Duur: ~60 Seconden</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Start Oorleeftijd Test →
            </span>
          </div>
        </button>

        <!-- Card 2: Zuivere Toon Audiometrie -->
        <button
          type="button"
          data-mode="audiometry"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-cyan-500/50 dark:hover:border-cyan-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform" aria-hidden="true">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
              Klinisch Hughson-Westlake Protocol
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              Zuivere Toon Audiometrie
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Standaard klinische screening die 250 Hz tot 8.000 Hz onafhankelijk in uw linker- en rechteroor evalueert. Zet een officieel audiogram uit tegen normale gehoordrempels.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Duur: ~3 Minuten</span>
            <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Start Audiometrie →
            </span>
          </div>
        </button>
      </div>

      <!-- ACTIVE WORKSPACE WRAPPER -->
      <div id="workspace" class="hidden rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl">
        <!-- Workspace Header Status -->
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
            <h2 id="workspaceTitle" class="font-heading font-bold text-lg sm:text-xl text-zinc-900 dark:text-white">
              Akoestische Test
            </h2>
          </div>
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Stap <span id="stepNum" class="font-bold text-cyan-600 dark:text-cyan-400">1</span> van 3
          </div>
        </div>

        <!-- STEP 1: CALIBRATION PANEL -->
        <div id="calibrationPanel" class="max-w-xl mx-auto text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-600 dark:text-cyan-400 flex items-center justify-center" aria-hidden="true">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white">
              Referentie Volume Kalibratie
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              We spelen een veilige 1.000 Hz referentietoon. Pas uw systeemvolume aan totdat het geluid duidelijk hoorbaar, comfortabel en niet ongemakkelijk luid is.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 space-y-4">
            <div class="flex items-center justify-between text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400">
              <span>Kalibratieniveau</span>
              <span id="calibDbDisplay" class="text-cyan-600 dark:text-cyan-400 font-bold">40 dB HL</span>
            </div>
            <input
              id="calibSlider"
              type="range"
              min="20"
              max="80"
              step="5"
              value="40"
              class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
            />
            <div class="flex gap-3 justify-center pt-2">
              <button
                id="calibPlayBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border border-cyan-500/30 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor" /></svg> Test Toon (1 kHz)
              </button>
              <button
                id="calibStopBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" /></svg> Stop
              </button>
            </div>
          </div>

          <button
            id="startTestBtn"
            type="button"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-heading font-bold text-base shadow-lg hover:shadow-cyan-500/25 transition-all cursor-pointer inline-flex items-center justify-center gap-2"
          >
            <span>Volume is Ingesteld · Begin Test</span>
            <span>→</span>
          </button>
        </div>

        <!-- STEP 2A: BIOLOGICAL EAR AGE PANEL -->
        <div id="earAgePanel" class="hidden max-w-xl mx-auto text-center space-y-6">
          <div class="space-y-1">
            <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Huidige Frequentietoon</div>
            <div class="flex items-baseline justify-center gap-2 font-mono font-extrabold text-5xl sm:text-6xl text-cyan-600 dark:text-cyan-400 tracking-tight">
              <span id="earAgeFreq">20,000</span>
              <span class="text-2xl text-zinc-400 font-bold">Hz</span>
            </div>
            <p id="earAgeStatus" class="text-sm text-zinc-600 dark:text-zinc-400 pt-1">
              Luister goed. Kunt u deze hoge frequentietoon horen?
            </p>
          </div>

          <!-- Animated Sound Waveform -->
          <div class="earage-waveform active" id="earAgeWave">
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
            <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
