---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Gratis Online Zelftests, Calculators & Cognitieve Tools | FreeIQExam Nederland";
const description = "Ontdek de Nederlandstalige tools van FreeIQExam: Caloriebehoefte Calculator, Gratis IQ Test, ADHD & Depressie zelftests, en zintuiglijke metingen zonder registratie.";
const canonicalUrl = "https://freeiqexam.com/nl/";
const alternates = {}; // Central directory hub

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection-page`,
    "name": title,
    "url": canonicalUrl,
    "inLanguage": "nl",
    "description": description,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 11,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Caloriebehoefte & BMR Calculator", "url": "https://freeiqexam.com/nl/calorie-calculator" },
        { "@type": "ListItem", "position": 2, "name": "Gratis IQ Test Online (24 Vragen)", "url": "https://freeiqexam.com/nl/iq-test" },
        { "@type": "ListItem", "position": 3, "name": "CPS Test & Kliksnelheid Test", "url": "https://freeiqexam.com/nl/cps-test" },
        { "@type": "ListItem", "position": 4, "name": "Memento Mori (Levenskalender & Weken)", "url": "https://freeiqexam.com/nl/memento-mori" },
        { "@type": "ListItem", "position": 5, "name": "Cirkel van Invloed & Betrokkenheid (Covey)", "url": "https://freeiqexam.com/nl/cirkel-van-invloed" },
        { "@type": "ListItem", "position": 6, "name": "ADHD Test Volwassenen (WHO ASRS v1.1)", "url": "https://freeiqexam.com/nl/adhd-test" },
        { "@type": "ListItem", "position": 7, "name": "Autisme Test Volwassenen (AQ-10)", "url": "https://freeiqexam.com/nl/autisme-test" },
        { "@type": "ListItem", "position": 8, "name": "Depressie Test (PHQ-9 Zelftest)", "url": "https://freeiqexam.com/nl/depressie-test" },
        { "@type": "ListItem", "position": 9, "name": "Gehoortest Online (Audiometrie)", "url": "https://freeiqexam.com/nl/gehoortest" },
        { "@type": "ListItem", "position": 10, "name": "Kleurentest (22 Ishihara Platen)", "url": "https://freeiqexam.com/nl/kleurentest" },
        { "@type": "ListItem", "position": 11, "name": "Ogentest & Astigmatisme (Snellen Grafiek)", "url": "https://freeiqexam.com/nl/ogentest" }
      ]
    }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="nl"
>
  <Header currentPath="/nl/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">

    <!-- HERO SECTION (Pure flat canvas — ZERO radial glow) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>FREEIQEXAM NEDERLAND — 11 FLAGSHIP TOOLS</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Gratis online calculators &amp;<br />
          <span class="text-zinc-500 dark:text-zinc-400">
            psychometrische tests.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          Direct in je browser, privacy-vriendelijk, 100% gratis en zonder verplichte registratie of e-mail.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/nl/calorie-calculator"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0055b3] dark:bg-[#2997ff] dark:hover:bg-[#1a80e5] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97]"
          >
            Caloriebehoefte Berekenen
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a
            href="/nl/iq-test"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-900 dark:text-white font-semibold text-sm sm:text-base border border-zinc-300 dark:border-zinc-700 transition-all duration-200 active:scale-[0.97]"
          >
            IQ Test Starten
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CATEGORY 1: Gezondheid, Energie & Levensstijl -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categorie 1</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Gezondheid, Energie &amp; Levensstijl
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Calorie Calculator -->
        <a
          href="/nl/calorie-calculator"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Caloriebehoefte &amp; BMR Calculator
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Bereken je dagelijkse energiebehoefte (TDEE), basaal metabolisme (BMR) en macronutriënten met wetenschappelijk onderbouwde formules.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Bereken calorieën &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Memento Mori -->
        <a
          href="/nl/memento-mori"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Memento Mori Levenskalender
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Visualiseer je leven in weken en reflecteer op tijd, doelen en prioriteiten met een interactieve filosofische levensmatrix.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Kalender bekijken &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Cirkel van Invloed -->
        <a
          href="/nl/cirkel-van-invloed"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Cirkel van Invloed (Covey)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Breng je zorgen en invloed in kaart volgens het model van Stephen Covey voor meer focus, proactiviteit en mentale rust.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Matrix openen &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 2: Cognitie, Intelligentie & Snelheid -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categorie 2</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Cognitie, Intelligentie &amp; Snelheid
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Gratis IQ Test -->
        <a
          href="/nl/iq-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Gratis IQ Test Online (24 Vragen)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Gestandaardiseerde visuele matrixredeneertest met 24 opgaven, 20-minuten timer en direct cognitief percentielrapport.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Test starten &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- CPS Test -->
        <a
          href="/nl/cps-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 9 5 12 1.8-5.2L21 14Z" /><path d="M7.2 2.2 8 2.8" /><path d="M5.1 5.1l.2.1" /><path d="M3.4 9.5l.5.1" /><path d="M2.9 14.1l.5-.1" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              CPS Test &amp; Kliksnelheid Test
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Meet je reactievermogen en kliksnelheid in clicks per seconde (CPS) met 5-, 10- en 30-seconden prestatiemetingen.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Kliktest starten &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 3: Klinische Zelftests (YMYL Safe) -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categorie 3</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Klinische Zelftests
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Psycho-educatieve reflectietools voor inzicht in welzijn. Geen vervanging voor medisch consult.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- ADHD Test -->
        <a
          href="/nl/adhd-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              ADHD Test Volwassenen (ASRS v1.1)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Wetenschappelijk gevalideerde oriënterende zelftest gebaseerd op de 6-vragen WHO ASRS v1.1 screeningsschaal.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Zelftest starten &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Autisme Test -->
        <a
          href="/nl/autisme-test"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" /><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ACTIEF
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Autisme Test Volwassenen (AQ-10)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Oriënterende screeningsvragenlijst naar autismekenmerken bij volwassenen volgens het 10-item Autism Spectrum Quotient.
            </p>
          </div>
