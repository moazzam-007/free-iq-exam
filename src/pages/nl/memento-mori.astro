<!-- Self-Contained Dutch Memento Mori Engine Script -->
<script is:inline>
  (function () {
    'use strict';

    var STOIC_QUOTES = [
      {
        author: 'Seneca',
        source: 'De Brevitate Vitae (Over de kortheid van het leven)',
        text: 'Het is niet dat we weinig tijd hebben om te leven, maar dat we er veel van verspillen. Het leven is lang genoeg als je het verstandig besteedt.'
      },
      {
        author: 'Marcus Aurelius',
        source: 'Overpeinzingen, Boek II',
        text: 'Je zou dit leven nu direct kunnen verlaten. Laat die gedachte bepalen wat je doet, zegt en denkt.'
      },
      {
        author: 'Seneca',
        source: 'Brieven aan Lucilius, Brief I',
        text: 'Houd elk uur in je greep. Pak de taak van vandaag aan, en je zult minder afhankelijk zijn van morgen. Terwijl we uitstellen, snelt het leven voorbij.'
      },
      {
        author: 'Epictetus',
        source: 'Enchiridion (Zakboekje)',
        text: 'Houd de dood en tegenslag dagelijks voor ogen. Dan zul je nooit laffe gedachten koesteren noch iets met overmatige hebzucht begeren.'
      },
      {
        author: 'Marcus Aurelius',
        source: 'Overpeinzingen, Boek IV',
        text: 'De tijd is een rivier, een woeste stroom van gebeurtenissen. Nauwelijks is iets zichtbaar, of het wordt weggespoeld en iets anders neemt de plaats in.'
      },
      {
        author: 'Seneca',
        source: 'De Brevitate Vitae',
        text: 'Jullie handelen als stervelingen in alles wat jullie vrezen, en als onsterfelijken in alles wat jullie verlangen.'
      },
      {
        author: 'Marcus Aurelius',
        source: 'Overpeinzingen, Boek VII',
        text: 'Beschouw jezelf als gestorven. Je hebt je leven geleefd. Neem nu wat overblijft en leef het op een deugdzame wijze.'
      }
    ];

    var quoteIdx = 0;
    var quoteText = document.getElementById('stoicQuoteText');
    var quoteAuthor = document.getElementById('stoicQuoteAuthor');
    var quoteSource = document.getElementById('stoicQuoteSource');
    var btnNextQuote = document.getElementById('nextQuoteBtn');

    if (btnNextQuote) {
      btnNextQuote.addEventListener('click', function () {
        quoteIdx = (quoteIdx + 1) % STOIC_QUOTES.length;
        var q = STOIC_QUOTES[quoteIdx];
        if (quoteText) quoteText.textContent = '\u201E' + q.text + '\u201D';
        if (quoteAuthor) quoteAuthor.textContent = q.author;
        if (quoteSource) quoteSource.textContent = q.source;
      });
    }

    // Actuarial Engine State
    var birthDate = new Date();
    birthDate.setFullYear(birthDate.getFullYear() - 28);
    var gender = 'male';
    var baseExpectancy = 80.3; // CBS Nederland basis voor mannen

    var inputDob = document.getElementById('mementoDob');
    var btnMale = document.getElementById('btn-gender-male');
    var btnFemale = document.getElementById('btn-gender-female');
    var modExercise = document.getElementById('modExercise');
    var modSleep = document.getElementById('modSleep');
    var modDiet = document.getElementById('modDiet');
    var modSmoking = document.getElementById('modSmoking');
    var modStress = document.getElementById('modStress');

    var statLivedWeeks = document.getElementById('statLivedWeeks');
    var statRemainingWeeks = document.getElementById('statRemainingWeeks');
    var statPercentSpent = document.getElementById('statPercentSpent');
    var statLifeExpectancy = document.getElementById('statLifeExpectancy');
    var statAgeYears = document.getElementById('statAgeYears');
    var lifeProgressBar = document.getElementById('lifeProgressBar');
    var statRemainingDays = document.getElementById('statRemainingDays');
    var statRemainingHours = document.getElementById('statRemainingHours');
    var statRemainingHeartbeats = document.getElementById('statRemainingHeartbeats');
    var gridContainer = document.getElementById('lifeGridContainer');
    var tooltip = document.getElementById('gridTooltip');
    var btnDownloadPoster = document.getElementById('downloadMementoPosterBtn');

    // Initialize date input to 28 years ago
    if (inputDob) {
      var yyyy = birthDate.getFullYear();
      var mm = String(birthDate.getMonth() + 1).padStart(2, '0');
      var dd = String(birthDate.getDate()).padStart(2, '0');
      inputDob.value = yyyy + '-' + mm + '-' + dd;
    }

    function calculateStats() {
      var now = new Date();
      var diffMs = now.getTime() - birthDate.getTime();
      var livedWeeks = Math.max(0, Math.floor(diffMs / (7 * 24 * 60 * 60 * 1000)));
      var ageYears = diffMs / (365.25 * 24 * 60 * 60 * 1000);

      baseExpectancy = (gender === 'female') ? 83.3 : 80.3;

      var exp = baseExpectancy;
      if (modExercise && modExercise.checked) exp += 3.8;
      if (modSleep && modSleep.checked) exp += 2.4;
      if (modDiet && modDiet.checked) exp += 2.8;
      if (modSmoking && modSmoking.checked) exp -= 8.5;
      if (modStress && modStress.checked) exp -= 2.5;

      var totalWeeks = Math.max(livedWeeks + 1, Math.round(exp * 52.1775));
      var remainingWeeks = Math.max(0, totalWeeks - livedWeeks);
      var percentSpent = Math.min(100, Math.max(0, (livedWeeks / totalWeeks) * 100));

      var remainingDays = remainingWeeks * 7;
      var remainingHours = remainingDays * 24;
      var remainingHeartbeats = remainingHours * 60 * 72; // ~72 bpm

      return {
        livedWeeks: livedWeeks,
        totalWeeks: totalWeeks,
        remainingWeeks: remainingWeeks,
        percentSpent: percentSpent,
        expectancyYears: exp,
        ageYears: ageYears,
        remainingDays: remainingDays,
        remainingHours: remainingHours,
        remainingHeartbeats: remainingHeartbeats
      };
    }

    function updateUI() {
      var stats = calculateStats();

      if (statLivedWeeks) statLivedWeeks.textContent = stats.livedWeeks.toLocaleString('nl-NL');
      if (statRemainingWeeks) statRemainingWeeks.textContent = stats.remainingWeeks.toLocaleString('nl-NL');
      if (statPercentSpent) statPercentSpent.textContent = stats.percentSpent.toFixed(1) + '%';
      if (statLifeExpectancy) statLifeExpectancy.textContent = stats.expectancyYears.toFixed(1) + ' jr';
      if (statAgeYears) statAgeYears.textContent = stats.ageYears.toFixed(1) + ' jaar';
      if (lifeProgressBar) lifeProgressBar.style.width = stats.percentSpent.toFixed(1) + '%';
      if (statRemainingDays) statRemainingDays.textContent = stats.remainingDays.toLocaleString('nl-NL');
      if (statRemainingHours) statRemainingHours.textContent = stats.remainingHours.toLocaleString('nl-NL');
      if (statRemainingHeartbeats) statRemainingHeartbeats.textContent = stats.remainingHeartbeats.toLocaleString('nl-NL');

      renderGrid(stats);
    }

    function renderGrid(stats) {
      if (!gridContainer) return;
      gridContainer.innerHTML = '';

      var totalYears = Math.min(90, Math.max(80, Math.ceil(stats.expectancyYears)));
      var currentWeek = stats.livedWeeks;

      for (var y = 0; y < totalYears; y++) {
        var row = document.createElement('div');
        row.className = 'flex items-center gap-1';

        // Row label (age)
        var label = document.createElement('span');
        label.className = 'w-6 text-[10px] font-mono text-zinc-400 dark:text-zinc-600 text-right pr-1 select-none shrink-0';
        if (y % 5 === 0) label.textContent = String(y);
        row.appendChild(label);

        // 52 week squares per row
        for (var w = 0; w < 52; w++) {
          var weekIndex = y * 52 + w;
          var square = document.createElement('span');
          square.className = 'w-2 h-2 rounded-[2px] transition-all duration-75 cursor-pointer shrink-0';

          var eraColor = '';
          if (y < 18) eraColor = 'hover:bg-indigo-400';
          else if (y < 35) eraColor = 'hover:bg-cyan-400';
          else if (y < 60) eraColor = 'hover:bg-amber-400';
          else eraColor = 'hover:bg-rose-400';

          if (weekIndex < currentWeek) {
            square.className += ' bg-amber-500 ' + eraColor;
          } else if (weekIndex === currentWeek) {
            square.className += ' bg-white ring-2 ring-amber-400 animate-pulse';
          } else if (weekIndex < stats.totalWeeks) {
            square.className += ' bg-zinc-200 dark:bg-zinc-800 hover:scale-125 ' + eraColor;
          } else {
            square.className += ' bg-zinc-100 dark:bg-zinc-900/50 opacity-40';
          }

          // Tooltip hover
          square.setAttribute('data-year', String(y));
          square.setAttribute('data-week', String(w + 1));
          square.setAttribute('data-index', String(weekIndex));

          square.addEventListener('mouseenter', function (e) {
            var target = e.target;
            var yr = target.getAttribute('data-year');
            var wk = target.getAttribute('data-week');
            var idx = parseInt(target.getAttribute('data-index') || '0', 10);

            var eraName = 'Jeugd (0-18)';
            var yNum = parseInt(yr, 10);
            if (yNum >= 60) eraName = 'Pensioen & Wijsheid (60+)';
            else if (yNum >= 35) eraName = 'Carrière & Meesterschap (35-60)';
            else if (yNum >= 18) eraName = 'Studie & Ambitie (18-35)';

            var statusStr = idx < currentWeek ? 'Geleefd' : (idx === currentWeek ? 'Huidige Week' : 'Toekomst');

            if (tooltip) {
              tooltip.innerHTML = '<div class="font-bold text-amber-400">Leeftijd ' + yr + ' &bull; Week ' + wk + '</div>' +
                                  '<div class="text-[11px] text-zinc-300">' + eraName + '</div>' +
                                  '<div class="text-[10px] font-mono text-zinc-400 mt-1">Status: ' + statusStr + '</div>';
              tooltip.classList.remove('hidden');
              tooltip.style.left = (e.clientX + 14) + 'px';
              tooltip.style.top = (e.clientY + 14) + 'px';
            }
          });

          square.addEventListener('mousemove', function (e) {
            if (tooltip) {
              tooltip.style.left = (e.clientX + 14) + 'px';
              tooltip.style.top = (e.clientY + 14) + 'px';
            }
          });

          square.addEventListener('mouseleave', function () {
            if (tooltip) tooltip.classList.add('hidden');
          });

          row.appendChild(square);
        }

        gridContainer.appendChild(row);
      }
    }

    // Gender toggles
    if (btnMale && btnFemale) {
      btnMale.addEventListener('click', function () {
        gender = 'male';
        btnMale.className = 'memento-gender-btn active flex-1 py-2.5 rounded-2xl text-xs font-bold border border-amber-500/40 bg-amber-500/10 text-amber-500 transition-all cursor-pointer';
        btnFemale.className = 'memento-gender-btn flex-1 py-2.5 rounded-2xl text-xs font-medium border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer';
        updateUI();
      });

      btnFemale.addEventListener('click', function () {
        gender = 'female';
        btnFemale.className = 'memento-gender-btn active flex-1 py-2.5 rounded-2xl text-xs font-bold border border-amber-500/40 bg-amber-500/10 text-amber-500 transition-all cursor-pointer';
        btnMale.className = 'memento-gender-btn flex-1 py-2.5 rounded-2xl text-xs font-medium border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer';
        updateUI();
      });
    }

    // Date change
    if (inputDob) {
      inputDob.addEventListener('change', function () {
        var parsed = new Date(inputDob.value);
        if (!isNaN(parsed.getTime())) {
          birthDate = parsed;
          updateUI();
        }
      });
    }

    // Lifestyle checkboxes
    [modExercise, modSleep, modDiet, modSmoking, modStress].forEach(function (el) {
      if (el) el.addEventListener('change', updateUI);
    });

    // Poster Generation
    if (btnDownloadPoster) {
      btnDownloadPoster.addEventListener('click', function () {
        var stats = calculateStats();
        var canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 675;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        // Background
        ctx.fillStyle = '#0a0a0c';
        ctx.fillRect(0, 0, 1200, 675);

        // Border
        ctx.strokeStyle = '#27272a';
        ctx.lineWidth = 2;
        ctx.strokeRect(20, 20, 1160, 635);

        // Header Title
        ctx.fillStyle = '#f59e0b';
        ctx.font = 'bold 28px sans-serif';
        ctx.fillText('MEMENTO MORI — JOUW LEVEN IN WEKEN', 50, 65);

        ctx.fillStyle = '#a1a1aa';
        ctx.font = '14px sans-serif';
        ctx.fillText('Elk vierkantje vertegenwoordigt 1 week. 52 weken per rij = 1 vol levensjaar.', 50, 92);

        // Stats summary
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 16px monospace';
        ctx.fillText('Geleefd: ' + stats.livedWeeks.toLocaleString('nl-NL') + ' wkn (' + stats.percentSpent.toFixed(1) + '%)', 50, 125);
        ctx.fillText('Resterend: ' + stats.remainingWeeks.toLocaleString('nl-NL') + ' wkn', 380, 125);
        ctx.fillText('Verwachting: ' + stats.expectancyYears.toFixed(1) + ' jaar', 710, 125);

        // Draw Mini Grid
        var startX = 50;
        var startY = 150;
        var boxSize = 7.5;
        var gap = 3.2;
        var totalYears = Math.min(90, Math.ceil(stats.expectancyYears));

        for (var yr = 0; yr < totalYears; yr++) {
          for (var wk = 0; wk < 52; wk++) {
            var idx = yr * 52 + wk;
            var x = startX + wk * (boxSize + gap);
            var y = startY + yr * (boxSize + 2.2);

            if (idx < stats.livedWeeks) {
              ctx.fillStyle = '#f59e0b';
            } else if (idx === stats.livedWeeks) {
              ctx.fillStyle = '#ffffff';
            } else if (idx < stats.totalWeeks) {
              ctx.fillStyle = '#27272a';
            } else {
              ctx.fillStyle = '#18181b';
            }
            ctx.fillRect(x, y, boxSize, boxSize);
          }
        }

        // Quote at bottom
        ctx.fillStyle = '#71717a';
        ctx.font = 'italic 14px serif';
        ctx.fillText('\u201EHet is niet dat we weinig tijd hebben om te leven, maar dat we er veel van verspillen.\u201D \u2014 Seneca', 50, 625);

        ctx.fillStyle = '#f59e0b';
        ctx.font = 'bold 12px monospace';
        ctx.fillText('FreeIQExam.com/nl/memento-mori', 950, 625);

        // Trigger Download
        var link = document.createElement('a');
        link.download = 'memento-mori-levenskalender.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    updateUI();
  })();
</script>
