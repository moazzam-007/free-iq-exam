---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Memento Mori Levenskalender: Jouw Leven in 4.000 Weken | FreeIQExam";
const description = "Visualiseer je hele bestaan in weken met de gratis interactieve Memento Mori levenskalender. Bereken je statistische levensverwachting en reflecteer met stoïcijnse wijsheid.";
const canonicalUrl = "https://freeiqexam.com/nl/memento-mori";

const alternates = {
  'en': 'https://freeiqexam.com/memento-mori',
  'de': 'https://freeiqexam.com/de/memento-mori',
  'pt-BR': 'https://freeiqexam.com/pt-br/memento-mori',
  'nl': 'https://freeiqexam.com/nl/memento-mori'
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Interactieve Memento Mori Levenskalender: 4.000 Weken Visualizer",
    "url": canonicalUrl,
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "All",
    "inLanguage": "nl",
    "browserRequirements": "Vereist JavaScript ondersteuning",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    },
    "featureList": [
      "Interactief 4.000-weken levensraster (80 tot 90+ jaar gevisualiseerd week voor week)",
      "4 kleurgecodeerde levensfasen: Jeugd (0-18), Ambitie (18-35), Meesterschap (35-60) en Pensioen/Wijsheid (60+)",
      "Actuariële levensverwachtingscalculator met leefstijlfactoren (beweging, slaap, voeding, roken, stress)",
      "Interactieve weekinspectie met exacte leeftijd en databerekening",
      "Dagelijkse stoïcijnse reflecties van Seneca, Marcus Aurelius en Epictetus in het Nederlands",
      "Gratis posterdownload in hoge resolutie PNG (1200x675)",
      "100% privacy gegarandeerd dankzij zuiver lokale verwerking in de browser"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/nl"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Memento Mori",
        "item": "https://freeiqexam.com/nl/memento-mori"
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="nl"
>
  <Header currentPath="/nl/memento-mori" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Stoïcijns Observatorium &bull; 4.000 Weken Kalender</span>
      </div>

      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-tight mb-4">
        Memento Mori: Je Leven in Weken
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
        &bdquo;Het is niet dat we weinig tijd hebben om te leven, maar dat we er veel van verspillen.&rdquo; Visualiseer je circa 4.000 weken op aarde, bereken je statistische levensverwachting en geef elke dag bewuste betekenis.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- Biometric & Lifestyle Input Deck -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-8 mb-8 shadow-sm">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          
          <!-- Date of Birth Input -->
          <div>
            <label for="mementoDob" class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                Geboortedatum
              </span>
            </label>
            <input
              type="date"
              id="mementoDob"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-2.5 text-zinc-900 dark:text-zinc-100 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 cursor-pointer"
            />
          </div>

          <!-- Biological Sex Selector -->
          <div>
            <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 4v2" /><path d="M20 12h-2" /><path d="M12 20v-2" /><path d="M4 12h2" /></svg>
                Biologisch Geslacht
              </span>
            </label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-gender-male"
                class="memento-gender-btn active flex-1 py-2.5 rounded-2xl text-xs font-bold border border-amber-500/40 bg-amber-500/10 text-amber-500 transition-all cursor-pointer"
                data-gender="male"
              >
                &male; Man
              </button>
              <button
                type="button"
                id="btn-gender-female"
                class="memento-gender-btn flex-1 py-2.5 rounded-2xl text-xs font-medium border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer"
                data-gender="female"
              >
                &female; Vrouw
              </button>
            </div>
          </div>

          <!-- Poster Download Action Button -->
          <div class="flex flex-col justify-end">
            <button
              type="button"
              id="downloadMementoPosterBtn"
              class="w-full py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-extrabold text-xs sm:text-sm shadow-md transition-all duration-150 active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer min-h-[44px]"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
              <span>Download Levensposter (PNG)</span>
            </button>
          </div>

        </div>

        <!-- Longevity & Lifestyle Modifiers Toggle -->
        <div class="pt-6">
          <label class="block text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-3">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18h8" /><path d="M3 22h18" /><path d="M14 22a7 7 0 1 0-7-7h1" /><path d="M9 14h2" /><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z" /><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3" /></svg>
              Actuariële Leefstijl- &amp; Gezondheidsfactoren
            </span>
          </label>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
            
            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modExercise" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">150m+ Bewegen</span>
                <span class="text-[10px] text-emerald-500 font-mono">+3.8 jaar</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modSleep" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">7–8u Slaap</span>
                <span class="text-[10px] text-emerald-500 font-mono">+2.4 jaar</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modDiet" checked class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Gezonde Voeding</span>
                <span class="text-[10px] text-emerald-500 font-mono">+2.8 jaar</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modSmoking" class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Roken / Vapen</span>
                <span class="text-[10px] text-rose-500 font-mono">-8.5 jaar</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-amber-500 transition-colors">
              <input type="checkbox" id="modStress" class="rounded accent-amber-500 w-4 h-4 cursor-pointer" />
              <div>
                <span class="font-bold block text-zinc-900 dark:text-zinc-100">Chronische Stress</span>
                <span class="text-[10px] text-rose-500 font-mono">-2.5 jaar</span>
              </div>
            </label>

          </div>
        </div>

      </div>

      <!-- Life Metrics Scorecard -->
      <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-xl relative overflow-hidden">

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
          
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Geleefde Weken</span>
            <span id="statLivedWeeks" class="text-3xl sm:text-4xl font-black font-mono text-amber-400">1.460</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Verstreken Reis</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Resterende Weken</span>
            <span id="statRemainingWeeks" class="text-3xl sm:text-4xl font-black font-mono text-white">2.700</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Toekomstig Potentieel</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Leven Voltooid</span>
            <span id="statPercentSpent" class="text-3xl sm:text-4xl font-black font-mono text-orange-400">35.1%</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Verstreken Tijd</span>
          </div>

          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider block mb-1">Verwachte Leeftijd</span>
            <span id="statLifeExpectancy" class="text-3xl sm:text-4xl font-black font-mono text-emerald-400">86.5 jr</span>
            <span class="text-[10px] text-zinc-400 block mt-1">Actuariële Span</span>
          </div>

        </div>

        <!-- Life Progress Bar -->
        <div class="space-y-1.5 mb-6">
          <div class="flex justify-between text-xs font-mono text-zinc-400">
            <span>Leeftijd 0</span>
            <span id="statAgeYears" class="text-amber-400 font-bold">28.0 jaar</span>
            <span>Doel: Einde Reis</span>
          </div>
          <div class="w-full h-3 bg-zinc-900 rounded-full overflow-hidden border border-zinc-800 p-0.5">
            <div id="lifeProgressBar" class="h-full bg-[#0066cc] dark:bg-[#2997ff] rounded-full transition-all duration-500" style="width: 35.1%;"></div>
          </div>
        </div>

        <!-- Deep Time Breakdown -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-zinc-800 text-center font-mono text-xs text-zinc-400">
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Geschatte Dagen Over</span>
            <span id="statRemainingDays" class="font-bold text-white text-sm">18.900</span>
          </div>
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Geschatte Uren Over</span>
            <span id="statRemainingHours" class="font-bold text-white text-sm">453.600</span>
          </div>
          <div>
            <span class="text-[10px] text-zinc-500 uppercase block">Resterende Hartslagen</span>
            <span id="statRemainingHeartbeats" class="font-bold text-amber-400 text-sm">1.959.552.000</span>
          </div>
        </div>

      </div>

      <!-- 4,000 Weeks Interactive Grid Arena -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-4 sm:p-8 shadow-sm">
        
        <!-- Legend & Eras Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          <div>
            <h2 class="text-base sm:text-lg font-heading font-extrabold text-zinc-950 dark:text-white">
              Het 4.000 Weken Levensraster
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Elk vierkantje vertegenwoordigt 1 week (52 weken per horizontale rij = 1 vol levensjaar).
            </p>
          </div>

          <!-- Dot Legend -->
          <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Geleefde Week</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-white shadow-[0_0_6px_#ffffff] animate-pulse"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Huidige Week</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm border border-zinc-400 dark:border-zinc-700"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Resterend</span>
            </div>
          </div>
        </div>

        <!-- Life Eras Key (Dutch Milestones) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 text-xs font-mono">
          <div class="p-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/30 text-indigo-500 dark:text-indigo-400">
            <span class="block font-bold">0 – 18 Jaar</span>
            <span class="text-[10px] text-zinc-600 dark:text-zinc-400">Jeugd &amp; Vormende Jaren</span>
          </div>
          <div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400">
            <span class="block font-bold">18 – 35 Jaar</span>
            <span class="text-[10px] text-zinc-600 dark:text-zinc-400">Studie &amp; Ambitie</span>
          </div>
          <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400">
            <span class="block font-bold">35 – 60 Jaar</span>
            <span class="text-[10px] text-zinc-600 dark:text-zinc-400">Carrière &amp; Meesterschap</span>
          </div>
          <div class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400">
            <span class="block font-bold">60 – 85+ Jaar</span>
            <span class="text-[10px] text-zinc-600 dark:text-zinc-400">Pensioen &amp; Wijsheid</span>
          </div>
        </div>

        <!-- Interactive Grid Container -->
        <div class="relative overflow-x-auto py-2">
          <div id="lifeGridContainer" class="min-w-[640px] space-y-1 select-none"></div>

          <!-- Floating Inspection Tooltip -->
          <div
            id="gridTooltip"
            class="hidden fixed z-50 bg-zinc-950/95 text-white border border-zinc-700 p-3 rounded-xl shadow-2xl backdrop-blur-md pointer-events-none text-xs"
          ></div>
        </div>

      </div>

      <!-- Daily Stoic Meditation Card -->
      <div class="mt-8 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 font-bold flex items-center gap-1.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="22" x2="21" y2="22" /><line x1="6" y1="18" x2="6" y2="11" /><line x1="10" y1="18" x2="10" y2="11" /><line x1="14" y1="18" x2="14" y2="11" /><line x1="18" y1="18" x2="18" y2="11" /><polygon points="12 2 20 7 4 7" /></svg>
            <span>Dagelijkse Stoïcijnse Reflectie</span>
          </span>
          <button
            type="button"
            id="nextQuoteBtn"
            class="text-xs text-zinc-500 dark:text-zinc-400 hover:text-amber-500 font-mono transition-colors cursor-pointer min-h-[44px] flex items-center gap-1 px-2"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10" /><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10" /></svg>
            <span>Volgende Meditatie</span>
          </button>
        </div>

        <blockquote class="text-base sm:text-lg font-serif italic text-zinc-800 dark:text-zinc-200 leading-relaxed mb-3">
          <span id="stoicQuoteText">&bdquo;Het is niet dat we weinig tijd hebben om te leven, maar dat we er veel van verspillen.&rdquo;</span>
        </blockquote>

        <div class="flex items-center justify-between text-xs text-zinc-500 font-mono">
          <span id="stoicQuoteAuthor" class="font-bold text-amber-600 dark:text-amber-400">Seneca</span>
          <span id="stoicQuoteSource">De Brevitate Vitae (Over de kortheid van het leven)</span>
        </div>
      </div>

    </section>

    <!-- 6 Dutch Educational Sections -->
    <article class="max-w-4xl mx-auto px-4 sm:px-6 pb-24 text-zinc-700 dark:text-zinc-300 leading-relaxed text-sm sm:text-base space-y-12">
      
      <section class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight">
          1. De Romeinse &amp; Stoïcijnse Oorsprong van Memento Mori en Amor Fati
        </h2>
        <p>
          Tijdens de Romeinse Republiek reed een zegevierende generaal na een militaire overwinning in een gouden strijdwagen door de straten van Rome. Achter hem op de wagen stond een staatsslaaf die hem een lauwerkrans boven het hoofd hield en hem voortdurend in het oor fluisterde: <em>&bdquo;Respice post te. Hominem te esse memento. Memento mori.&rdquo;</em> (&bdquo;Kijk achter je. Bedenk dat je slechts een mens bent. Gedenk te sterven.&rdquo;)
        </p>
        <p>
          In het klassieke stoïcisme &ndash; onderwezen door <strong>Seneca, Epictetus en keizer Marcus Aurelius</strong> &ndash; werd de dood niet gezien als een duistere vijand, maar als de ultieme filter tegen hoogmoed, uitstelgedrag en trivialiteit. Door dagelijks stil te staan bij je sterfelijkheid, verdampen nutteloze ruzies en herwint het heden zijn volle gewicht. Dit concept is onlosmakelijk verbonden met <strong>Amor Fati</strong>: het omarmen van elk lot en elke tegenslag als brandstof voor innerlijke veerkracht.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight">
          2. Waarom Tijd Sneller Lijkt te Gaan naarmate je Ouder Wordt
        </h2>
        <p>
          Psychologen verklaren de perceptie van versnellende tijd via de <em>proportionele theorie van Janet</em>. Voor een kind van 10 jaar vertegenwoordigt één enkel jaar maar liefst 10% van zijn totale levenservaring. Voor een volwassene van 50 jaar is een jaar nog slechts 2% van het geleefde bestaan &ndash; waardoor het subjectief vijf keer zo snel voorbijtrekt.
        </p>
        <p>
          Bovendien nestelen volwassenen zich vaak in herhalende routines. De hersenen registreren alleen rijke episodische herinneringen wanneer we nieuwe, zintuiglijke indrukken opdoen. Door bewust nieuwe vaardigheden te leren en het 4.000-wekenraster visueel te observeren, doorbreek je deze automatische piloot.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight">
          3. De Wiskunde van een Mensenleven: 4.000 Weken in Cijfers
        </h2>
        <p>
          Een gemiddelde levensverwachting van 80 jaar omvat circa <strong>4.160 weken</strong>. Wie 30 jaar oud is, heeft al circa 1.560 weken achter de rug (37,5%). Op je 50e heb je al 2.600 weken geleefd (62,5%). Door tijd niet langer te beschouwen als een vage, oneindige abstractie, maar als een fysieke doos met 4.000 knikkers waarvan er wekelijks één verdwijnt, verandert je prioriteitstelling onmiddellijk.
        </p>
