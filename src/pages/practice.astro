---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Cognitive Practice Hub - Free IQ Test Questions & Step-by-Step Drills | FreeIQExam";
const description = "Master cognitive & IQ test questions with free untimed practice drills. Step-by-step solutions for Carpenter's 5 matrix rules, 3D mental rotation, number series, and formal syllogisms.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cognitive Practice Hub",
    "url": "https://freeiqexam.com/practice",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Interactive cognitive drill platform providing untimed practice and step-by-step solution breakdowns across 4 CHC intelligence domains.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Practice Hub",
        "item": "https://freeiqexam.com/practice"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the difference between timed tests and untimed practice drills?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Timed assessments simulate standardized test environments under 15-minute limits to benchmark performance speed. Untimed practice drills provide immediate solution explanations after each question so you can study the underlying transformation rules at your own pace."
        }
      },
      {
        "@type": "Question",
        "name": "What are Carpenter's 5 rules for matrix reasoning?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Carpenter, Just, and Shell (1990) identified 5 primary transformation algorithms in progressive matrices: constant in a row, quantitative progression, distribution of three values, distribution of two values (XOR cancellation), and rotational movement."
        }
      },
      {
        "@type": "Question",
        "name": "Can practicing cognitive drills improve my official IQ score?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Practice improves test familiarity, reduces anxiety, and builds pattern-recognition schemas for transformation rules. While innate fluid ability has high genetic heritability, eliminating procedural mistakes and distractor traps often yields a 5 to 10 point gain in measured test performance."
        }
      },
      {
        "@type": "Question",
        "name": "Do high-IQ societies test these same question types?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. High-IQ societies like Mensa, Intertel, and Triple Nine utilize standardized batteries (such as the WAIS-IV, Stanford-Binet, Cattell Culture Fair, and Raven's APM) that heavily feature matrix induction, mental rotation, numerical series, and verbal analogies."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/practice" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-14 max-w-6xl">
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-900 text-xs font-mono font-medium text-blue-700 dark:text-blue-300 mb-4">
        <span>COGNITIVE DRILL CENTER &bull; UNTIMED PRACTICE</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Train Your Cognitive Abilities - Free Practice Drills by Domain
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Improve your deductive speed, mental rotation, and logical reasoning. Choose between untimed practice drills with instant step-by-step solutions or full 15-minute standardized category assessments.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">4 CHC Cognitive Domains</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Instant Solution Explanations</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">No Sign-up Required</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">100% Free &amp; Private</span>
      </div>
    </header>

    <!-- 4 Interactive Domain Cards -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white">
            Specialized Domain Drills
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Focus your practice on a specific cognitive ability area.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 1. Fluid Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-blue-300 dark:hover:border-blue-800 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                Gf &bull; Fluid Reasoning
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 Questions</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Matrix &amp; Pattern Induction
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Master 2x2 and 3x3 matrix pattern rules, Latin square permutations, topological progression series, and Boolean XOR feature cancellation. Completely non-verbal and culture-reduced.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Carpenter Rules</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Topological Series</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">XOR Logic</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/fluid-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Untimed Practice Drill</span>
            </a>
            <a
              href="/fluid-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Timed Test (15m)
            </a>
          </div>
        </div>

        <!-- 2. Visual-Spatial Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-indigo-300 dark:hover:border-indigo-800 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-indigo-100 text-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
                Gv &bull; Visual-Spatial
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 Questions</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              3D Cube Rotation &amp; Folding Nets
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Train mental rotation across 3D axes, mentally fold 2D flat nets into 6-sided cubes, and deduce orthographic projections. Essential for engineering and spatial reasoning.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Shepard-Metzler Rotation</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Cube Unfolding</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Opposite Face Rule</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/spatial-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Untimed Practice Drill</span>
            </a>
            <a
              href="/spatial-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Timed Test (15m)
            </a>
          </div>
        </div>

        <!-- 3. Quantitative Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-emerald-300 dark:hover:border-emerald-800 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                Gq &bull; Quantitative
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 Questions</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              Number Series &amp; Arithmetic Logic
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Solve second-order difference sequences, interleaved alternating progressions, and multi-step relational rate puzzles. Pure deductive math logic without requiring advanced calculus.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Higher Differences</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Interleaved Series</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Proportional Logic</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/quantitative-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Untimed Practice Drill</span>
            </a>
            <a
              href="/quantitative-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Timed Test (15m)
            </a>
          </div>
        </div>

        <!-- 4. Verbal Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-purple-300 dark:hover:border-purple-800 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300 border border-purple-200 dark:border-purple-800">
                Gc &bull; Verbal Comprehension
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 Questions</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
              Analogies &amp; Deductive Syllogisms
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Sharpen your verbal concept formation with relational analogies (A : B :: C : ?), formal Aristotelian syllogisms, and categorical inclusion logic.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Formal Syllogisms</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Relational Analogies</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Categorical Logic</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/verbal-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-purple-600 hover:bg-purple-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Untimed Practice Drill</span>
            </a>
            <a
              href="/verbal-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Timed Test (15m)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Dual Full Track Callouts -->
    <section class="p-6 sm:p-10 rounded-3xl bg-gradient-to-br from-zinc-950 via-blue-950/80 to-indigo-950/60 dark:from-zinc-950 dark:via-blue-950/90 dark:to-indigo-950/70 text-white">
      <div class="max-w-3xl mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-xs font-mono font-semibold text-blue-200 uppercase tracking-wider mb-3">
          COMPREHENSIVE MULTI-DOMAIN EVALUATION
        </span>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white">
          Ready for a Certified Composite Score?
        </h2>
        <p class="text-sm sm:text-base text-blue-200/80 mt-2 leading-relaxed">
          While domain practice drills isolate specific abilities, clinical IQ scores require composite sampling across all four CHC factors to compute an accurate general factor (g) estimate.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Quick Screener -->
        <div class="p-6 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-blue-300 font-semibold mb-1 uppercase tracking-wider">Option A</div>
            <h3 class="font-heading font-bold text-xl text-white mb-2">
              Quick 10-Min Screening
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
              12 questions (3 from each of the 4 domains). Fast, streamlined assessment providing an immediate provisional IQ score and percentile ranking.
            </p>
          </div>
          <a
            href="/quick-test"
            class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-zinc-950 bg-white hover:bg-zinc-100 transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Start Quick Screening (10 min)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Full Assessment -->
        <div class="p-6 rounded-2xl bg-blue-600/30 border border-blue-400/30 backdrop-blur-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-amber-300 font-semibold mb-1 uppercase tracking-wider">Option B (Recommended)</div>
            <h3 class="font-heading font-bold text-xl text-white mb-2">
              Full 20-Min Comprehensive Assessment
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
              24 questions (6 per domain). High psychometric precision, 95% posterior credible interval, downloadable high-res certificate, and full review accordion.
            </p>
          </div>
          <a
            href="/test"
            class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Start Full Assessment (20 min)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Educational Guide Section -->
    <section class="space-y-8">
      <div>
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-2">
          Cognitive Problem-Solving Masterclass
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Master the formal principles that cognitive scientists and psychometricians use to construct high-difficulty test items.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1. Carpenter's Matrix Rules -->
        <div class="p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 font-mono font-bold flex items-center justify-center mb-4">
            1
          </div>
          <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
            Carpenter's 5 Matrix Rules
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            In their 1990 Cognitive Psychology paper, Carpenter, Just, and Shell identified 5 universal transformation rules across matrix puzzles:
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300">
            <li>&bull; <strong>Constant in row:</strong> Shape remains invariant horizontally.</li>
            <li>&bull; <strong>Quantitative progression:</strong> Dot count increases (+1, +2).</li>
            <li>&bull; <strong>Distribution of 3 values:</strong> Latin square permutation.</li>
            <li>&bull; <strong>Distribution of 2 values:</strong> XOR cancellation of overlapping segments.</li>
            <li>&bull; <strong>Movement &amp; rotation:</strong> Clockwise 45 or 90 degree step progression.</li>
          </ul>
        </div>

        <!-- 2. Mentally Unrolling 3D Cube Nets -->
