---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Privacy Policy: Client-Side Evaluation & Data Privacy | FreeIQExam";
const description = "Review our privacy policy. FreeIQExam evaluates test responses locally in your browser with no mandatory account, no email harvesting, and transparent client-side storage.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Privacy Policy - FreeIQExam",
    "url": "https://freeiqexam.com/privacy/",
    "description": "Review our privacy policy. FreeIQExam evaluates test responses locally in your browser with no mandatory account, no email harvesting, and transparent client-side storage."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": "https://freeiqexam.com/privacy/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/privacy" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Privacy Policy</span>
    </nav>
    
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-3">
        <span>CLIENT-SIDE EVALUATION &bull; PRIVACY BY DESIGN</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight">
        Privacy Policy &amp; Data Protection
      </h1>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-2">
        Last Revised: September 2026 &bull; Effective Immediately
      </p>
    </header>

    <article class="prose prose-zinc dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-6">
      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          1. Client-Side Evaluation Architecture
        </h2>
        <p>
          At FreeIQExam.com, we respect your fundamental right to digital privacy. Unlike conventional assessment platforms that store responses on central servers, <strong>all scoring algorithms, 2PL IRT estimations, and percentile conversions execute 100% locally in your web browser runtime</strong>.
        </p>
        <p>
          Your individual item answers, elapsed time, and calculated IQ estimates are never transmitted to our web servers, database repositories, or commercial advertising networks.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          2. Local Storage Usage
        </h2>
        <p>
          We utilize standard HTML5 local storage (localStorage) exclusively to provide functional convenience during your assessment session:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>freeiq_active_session:</strong> Temporarily stores your answers and remaining timer seconds so your progress is preserved if you accidentally refresh the page.</li>
          <li><strong>freeiq_test_answers:</strong> Stores your finalized responses upon submission so the results page can compute your score.</li>
          <li><strong>theme:</strong> Remembers your light or dark mode aesthetic preference.</li>
        </ul>
        <p class="mt-2">
          You can erase this data at any time simply by clearing your browser's site data or storage, or by clicking "Retake Test".
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          3. No Collection of Personally Identifiable Information (PII)
        </h2>
        <p>
          We do not require, collect, or store your name, email address, postal address, phone number, social media handles, or payment credentials. You may complete the test without providing personal identification.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          4. Zero Sale of Personal Data
        </h2>
        <p>
          Under the California Consumer Privacy Act (CCPA) and European Union General Data Protection Regulation (GDPR), we affirm that FreeIQExam does not sell, rent, license, or barter user data to data brokers or third-party marketers.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          5. Contact for Privacy Matters
        </h2>
        <p>
          If you have inquiries regarding our data handling principles, contact our privacy officer at <a href="mailto:privacy@freeiqexam.com" class="text-blue-600 dark:text-blue-400 font-semibold underline">privacy@freeiqexam.com</a>.
        </p>
      </section>
    </article>

  </main>

  <Footer />
</Layout>
