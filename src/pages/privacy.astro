---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Privacy Policy: Client-Side Evaluation & Data Privacy | FreeIQExam";
const description = "Review our privacy policy. FreeIQExam evaluates test responses locally in your browser with no mandatory account, no email harvesting, and transparent client-side storage.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Privacy Policy - FreeIQExam",
    "url": "https://freeiqexam.com/privacy/",
    "description": "Review our privacy policy. FreeIQExam evaluates test responses locally in your browser with no mandatory account, no email harvesting, and transparent client-side storage."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": "https://freeiqexam.com/privacy/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/privacy" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Privacy Policy</span>
    </nav>
    
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-3">
        <span>CLIENT-SIDE EVALUATION &bull; PRIVACY BY DESIGN</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight">
        Privacy Policy &amp; Data Protection
      </h1>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-2">
        Last Revised: September 2026 &bull; Effective Immediately
      </p>
    </header>

    <article class="prose prose-zinc dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-6">
      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          1. Client-Side Evaluation Architecture
        </h2>
        <p>
          At FreeIQExam.com, we respect your fundamental right to digital privacy. Unlike conventional assessment platforms that store responses on central servers, <strong>all cognitive scoring algorithms, 2PL IRT latent ability estimations, and normative percentile conversions execute 100% locally in your web browser runtime</strong>.
        </p>
        <p>
          Your individual item answers, assessment response vectors, and calculated psychometric scores are processed strictly on your device and are never sold, bartered, or transmitted to centralized profiling databases.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          2. Local Storage Usage
        </h2>
        <p>
          We utilize standard HTML5 local storage (localStorage) exclusively to provide functional convenience during your assessment session:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>freeiq_active_session / freeiq_quick_session:</strong> Temporarily stores your answers and remaining timer seconds so your progress is preserved if you accidentally refresh the page.</li>
          <li><strong>iq_assessment_result / iq_review_data:</strong> Stores your finalized score summary and question review data locally so the results page can render your psychometric report without re-downloading item banks.</li>
          <li><strong>theme:</strong> Remembers your light or dark mode aesthetic preference.</li>
        </ul>
        <p class="mt-2">
          You can erase this data at any time simply by clearing your browser's site data or storage, or by clicking "Retake Test".
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          3. No Collection of Personally Identifiable Information (PII)
        </h2>
        <p>
          We do not require, collect, or store your name, email address, postal address, phone number, social media handles, or payment credentials. You may complete any assessment and view full results without providing personal identification.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          4. Third-Party Advertising &amp; Cookies
        </h2>
        <p>
          To sustain our psychometric item bank development, high-availability hosting infrastructure, and free public access without paywalls or mandatory accounts, FreeIQExam.com partners with third-party advertising networks, including <strong>Google AdSense</strong>.
        </p>
        <p>
          Google and other third-party vendors use cookies, web beacons, and unique identifiers to serve advertisements on this website based on prior visits. Specifically:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong>Advertising Cookies:</strong> Google's use of advertising cookies enables it and its partners to serve relevant advertisements to users based on their visits to FreeIQExam.com and/or other sites on the Internet.
          </li>
          <li>
            <strong>Opting Out of Personalized Advertising:</strong> You may opt out of personalized advertising by visiting <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 font-semibold underline">Google Ads Settings (https://adssettings.google.com)</a>. Alternatively, you can opt out of third-party vendor cookies for personalized advertising by visiting <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 font-semibold underline">www.aboutads.info (https://www.aboutads.info)</a>.
          </li>
          <li>
            <strong>Consent Management (GDPR &amp; ePrivacy):</strong> For users accessing our site from the European Economic Area (EEA), the United Kingdom, or Switzerland, a Consent Management Platform (CMP) is employed to gather granular user consent for advertising cookies and measurement in compliance with GDPR and the ePrivacy Directive.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          5. CCPA / CPRA &amp; GDPR Privacy Rights
        </h2>
        <p>
          Under the California Consumer Privacy Act (CCPA), California Privacy Rights Act (CPRA), and European Union General Data Protection Regulation (GDPR):
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li><strong>Zero Sale of Personal Assessment Data:</strong> We affirm that FreeIQExam does not sell, rent, license, or barter user assessment responses or cognitive scores to data brokers or third-party marketers.</li>
          <li><strong>Right to Opt-Out:</strong> Residents of California and jurisdictions with applicable privacy statutes have the right to opt out of the sale or sharing of personal data for cross-context behavioral advertising via the opt-out links provided above or browser-based Global Privacy Control (GPC) signals.</li>
          <li><strong>Right to Erasure:</strong> Because assessment responses are held locally in your browser, you retain complete sovereignty over your data and can delete all records instantly by clearing local storage or browser cookies.</li>
        </ul>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          6. Contact for Privacy Matters
        </h2>
        <p>
          If you have inquiries regarding our data handling principles or cookie consent disclosures, contact our privacy officer at <a href="mailto:privacy@freeiqexam.com" class="text-blue-600 dark:text-blue-400 font-semibold underline">privacy@freeiqexam.com</a>.
        </p>
      </section>
    </article>

  </main>

  <Footer />
</Layout>
