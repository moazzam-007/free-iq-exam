        if (gender === 'male') {
          bmrMifflin += 5;
        } else {
          bmrMifflin -= 161;
        }

        // 2. Katch-McArdle (LBM)
        var bmrKatch = bmrMifflin;
        if (bf !== null && bf > 3 && bf < 60) {
          var lbm = weightKg * (1 - (bf / 100));
          bmrKatch = 370 + (21.6 * lbm);
        }

        // 3. Oxford / Henry Equation
        var bmrOxford = bmrMifflin;
        if (gender === 'male') {
          if (age < 30) bmrOxford = (14.4 * weightKg) + (313 * (heightCm / 100)) + 113;
          else if (age < 60) bmrOxford = (11.4 * weightKg) + (541 * (heightCm / 100)) - 137;
          else bmrOxford = (11.4 * weightKg) + (541 * (heightCm / 100)) - 256;
        } else {
          if (age < 30) bmrOxford = (10.4 * weightKg) + (615 * (heightCm / 100)) - 282;
          else if (age < 60) bmrOxford = (8.18 * weightKg) + (502 * (heightCm / 100)) - 11.6;
          else bmrOxford = (8.52 * weightKg) + (421 * (heightCm / 100)) + 10.7;
        }

        // Active primary BMR
        var primaryBmr = (bf !== null && bf > 3) ? bmrKatch : bmrMifflin;
        var tdee = Math.round(primaryBmr * activity);
        var targetCal = Math.round(tdee * (1 + goalData.delta));

        // Macronutrient Breakdown
        var protCal = targetCal * ratios[0];
        var carbCal = targetCal * ratios[1];
        var fatCal = targetCal * ratios[2];

        var protGrams = Math.round(protCal / 4);
        var carbGrams = Math.round(carbCal / 4);
        var fatGrams = Math.round(fatCal / 9);

        // Neuro-metabolic brain metrics
        var brainKcalVal = Math.round(primaryBmr * 0.20);
        var brainGlucoseVal = Math.round(brainKcalVal / 4);
        var brainWattsVal = (brainKcalVal * 4184 / 86400).toFixed(1);

        // Update DOM Displays
        if (targetCaloriesDisp) targetCaloriesDisp.textContent = targetCal.toLocaleString('pt-BR');
        if (targetGoalLabel) targetGoalLabel.textContent = goalData.label;
        if (targetDeficitSub) targetDeficitSub.textContent = goalData.sub;
        if (tdeeDisp) tdeeDisp.textContent = tdee.toLocaleString('pt-BR');
        if (bmrDisp) bmrDisp.textContent = Math.round(primaryBmr).toLocaleString('pt-BR');

        if (macroProteinGrams) macroProteinGrams.textContent = protGrams + 'g';
        if (macroProteinKcal) macroProteinKcal.textContent = Math.round(protCal) + ' kcal (' + Math.round(ratios[0] * 100) + ' %)';

        if (macroCarbGrams) macroCarbGrams.textContent = carbGrams + 'g';
        if (macroCarbKcal) macroCarbKcal.textContent = Math.round(carbCal) + ' kcal (' + Math.round(ratios[1] * 100) + ' %)';

        if (macroFatGrams) macroFatGrams.textContent = fatGrams + 'g';
        if (macroFatKcal) macroFatKcal.textContent = Math.round(fatCal) + ' kcal (' + Math.round(ratios[2] * 100) + ' %)';

        if (chartCalCenter) chartCalCenter.textContent = targetCal.toLocaleString('pt-BR');

        if (neuroKcal) neuroKcal.textContent = brainKcalVal + ' kcal/dia';
        if (neuroGlucose) neuroGlucose.textContent = brainGlucoseVal + 'g glicose';
        if (neuroWatts) neuroWatts.textContent = brainWattsVal.replace('.', ',') + ' Watts';

        if (bmrMifflinVal) bmrMifflinVal.textContent = Math.round(bmrMifflin).toLocaleString('pt-BR') + ' kcal';
        if (bmrKatchVal) bmrKatchVal.textContent = Math.round(bmrKatch).toLocaleString('pt-BR') + ' kcal';
        if (bmrOxfordVal) bmrOxfordVal.textContent = Math.round(bmrOxford).toLocaleString('pt-BR') + ' kcal';

        drawMacroDoughnut(ratios);
      }

      function drawMacroDoughnut(ratios) {
        if (!ctx || !canvas) return;
        var w = canvas.width;
        var h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        var cx = w / 2;
        var cy = h / 2;
        var radius = (w / 2) - 16;
        var lineWidth = 24;

        var startAngle = -Math.PI / 2;
        var colors = ['#10b981', '#06b6d4', '#f59e0b']; // emerald (protein), cyan (carbs), amber (fat)

        ratios.forEach(function(pct, idx) {
          var sliceAngle = pct * 2 * Math.PI;
          var endAngle = startAngle + sliceAngle;

          ctx.beginPath();
          ctx.arc(cx, cy, radius, startAngle, endAngle);
          ctx.strokeStyle = colors[idx];
          ctx.lineWidth = lineWidth;
          ctx.stroke();

          startAngle = endAngle;
        });
      }

      // Unit switch handlers
      unitBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          unitBtns.forEach(function(b) {
            b.classList.remove('active', 'bg-emerald-500/10', 'text-emerald-500', 'border-emerald-500/40', 'font-bold');
            b.classList.add('font-medium', 'text-zinc-600', 'dark:text-zinc-400');
          });
          btn.classList.add('active', 'bg-emerald-500/10', 'text-emerald-500', 'border-emerald-500/40', 'font-bold');
          btn.classList.remove('font-medium', 'text-zinc-600', 'dark:text-zinc-400');

          state.unit = btn.getAttribute('data-unit');
          if (state.unit === 'metric') {
            if (metricWrap) metricWrap.classList.remove('hidden');
            if (imperialWrap) imperialWrap.classList.add('hidden');
          } else {
            if (metricWrap) metricWrap.classList.add('hidden');
            if (imperialWrap) imperialWrap.classList.remove('hidden');
          }
          updateCalculations();
        });
      });

      // Gender switch handlers
      genderBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          genderBtns.forEach(function(b) {
            b.classList.remove('active', 'bg-emerald-500/10', 'text-emerald-500', 'border-emerald-500/40', 'font-bold');
            b.classList.add('font-medium', 'text-zinc-600', 'dark:text-zinc-400');
          });
          btn.classList.add('active', 'bg-emerald-500/10', 'text-emerald-500', 'border-emerald-500/40', 'font-bold');
          btn.classList.remove('font-medium', 'text-zinc-600', 'dark:text-zinc-400');

          state.gender = btn.getAttribute('data-gender');
          if (state.gender === 'female') {
            if (navyHipField) navyHipField.classList.remove('hidden');
            if (navyHipFieldImp) navyHipFieldImp.classList.remove('hidden');
          } else {
            if (navyHipField) navyHipField.classList.add('hidden');
            if (navyHipFieldImp) navyHipFieldImp.classList.add('hidden');
          }
          updateCalculations();
        });
      });

      // Event listeners for inputs
      var liveInputs = [
        ageInput, bfInput, weightMetricInput, heightMetricInput,
        weightImperialInput, heightFeetInput, heightInchesInput
      ];
      liveInputs.forEach(function(inp) {
        if (inp) {
          inp.addEventListener('input', updateCalculations);
          inp.addEventListener('change', updateCalculations);
        }
      });

      if (activitySelect) activitySelect.addEventListener('change', updateCalculations);
      if (goalSelect) goalSelect.addEventListener('change', updateCalculations);
      if (macroProtocolSelect) macroProtocolSelect.addEventListener('change', updateCalculations);

      // Navy Body Fat Calculation
      if (navyToggle && navyBody) {
        navyToggle.addEventListener('click', function() {
          state.navyOpen = !state.navyOpen;
          if (state.navyOpen) navyBody.classList.remove('hidden');
          else navyBody.classList.add('hidden');
        });
      }

      if (applyNavyBtn) {
        applyNavyBtn.addEventListener('click', function() {
          var neckCm = 38;
          var waistCm = 84;
          var hipCm = 98;
          var hCm = 178;

          if (state.unit === 'metric') {
            neckCm = parseFloat(document.getElementById('calNeckMetric').value) || 38;
            waistCm = parseFloat(document.getElementById('calWaistMetric').value) || 84;
            hipCm = parseFloat(document.getElementById('calHipMetric').value) || 98;
            hCm = parseFloat(heightMetricInput.value) || 178;
          } else {
            var neckIn = parseFloat(document.getElementById('calNeckImperial').value) || 15;
            var waistIn = parseFloat(document.getElementById('calWaistImperial').value) || 33;
            var hipIn = parseFloat(document.getElementById('calHipImperial').value) || 38;
            neckCm = neckIn * 2.54;
            waistCm = waistIn * 2.54;
            hipCm = hipIn * 2.54;
            var ft = parseFloat(heightFeetInput.value) || 5;
            var inc = parseFloat(heightInchesInput.value) || 10;
            hCm = (ft * 30.48) + (inc * 2.54);
          }

          var bf = 15;
          if (state.gender === 'male') {
            bf = 495 / (1.0324 - 0.19077 * Math.log10(Math.max(1, waistCm - neckCm)) + 0.15456 * Math.log10(hCm)) - 450;
          } else {
            bf = 495 / (1.29579 - 0.35004 * Math.log10(Math.max(1, waistCm + hipCm - neckCm)) + 0.22100 * Math.log10(hCm)) - 450;
          }

          bf = Math.max(4, Math.min(55, Math.round(bf * 10) / 10));
          if (bfInput) bfInput.value = bf;

          if (navyBfBadge) {
            navyBfBadge.textContent = bf + ' % calculado';
            navyBfBadge.classList.remove('hidden');
          }

          if (navyBody) navyBody.classList.add('hidden');
          state.navyOpen = false;

          updateCalculations();
        });
      }

      // Initial execution
      updateCalculations();

    })();
  </script>
</Layout>
