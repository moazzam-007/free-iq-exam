---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = "Testes Online Gratuitos, Calculadoras & Avaliações Cognitivas | FreeIQExam Brasil";
const description = "Descubra as ferramentas em português do FreeIQExam: Teste de QI, Calculadora de Calorias, Testes de TDAH e Autismo, e ferramentas sensoriais gratuitas sem cadastro.";
const canonicalUrl = "https://freeiqexam.com/pt-br/";
const alternates = {}; // Central directory hub

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonicalUrl}#collection-page`,
    "name": title,
    "url": canonicalUrl,
    "inLanguage": "pt-BR",
    "description": description,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": 12,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Teste de QI Gratuito (24 Questões)", "url": "https://freeiqexam.com/pt-br/teste-de-qi" },
        { "@type": "ListItem", "position": 2, "name": "Calculadora de Calorias & TDEE", "url": "https://freeiqexam.com/pt-br/calculadora-de-calorias" },
        { "@type": "ListItem", "position": 3, "name": "Testar Microfone Online", "url": "https://freeiqexam.com/pt-br/testar-microfone" },
        { "@type": "ListItem", "position": 4, "name": "Teste de Digitação (WPM Velocidade)", "url": "https://freeiqexam.com/pt-br/teste-de-digitacao" },
        { "@type": "ListItem", "position": 5, "name": "Memento Mori (Calendário da Vida)", "url": "https://freeiqexam.com/pt-br/memento-mori" },
        { "@type": "ListItem", "position": 6, "name": "Jogo da Memória Espacial", "url": "https://freeiqexam.com/pt-br/jogo-da-memoria" },
        { "@type": "ListItem", "position": 7, "name": "CPS Test (Velocidade de Clique)", "url": "https://freeiqexam.com/pt-br/cps-test" },
        { "@type": "ListItem", "position": 8, "name": "Teste de TDAH Adulto (WHO ASRS v1.1)", "url": "https://freeiqexam.com/pt-br/teste-tdah" },
        { "@type": "ListItem", "position": 9, "name": "Teste de Autismo Adulto (AQ-10)", "url": "https://freeiqexam.com/pt-br/teste-autismo" },
        { "@type": "ListItem", "position": 10, "name": "Teste de Depressão (PHQ-9)", "url": "https://freeiqexam.com/pt-br/teste-depressao" },
        { "@type": "ListItem", "position": 11, "name": "Teste de Daltonismo (22 Placas Ishihara)", "url": "https://freeiqexam.com/pt-br/teste-de-daltonismo" },
        { "@type": "ListItem", "position": 12, "name": "Teste de Visão Online (Tabela Snellen)", "url": "https://freeiqexam.com/pt-br/teste-de-visao" }
      ]
    }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  lang="pt-BR"
>
  <Header currentPath="/pt-br/" />

  <main class="flex-1 bg-white dark:bg-black transition-colors">

    <!-- HERO SECTION (Pure flat canvas — ZERO radial glow) -->
    <section class="relative pt-12 pb-14 md:pt-20 md:pb-20 bg-white dark:bg-black overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm font-mono text-zinc-700 dark:text-zinc-300 mb-8">
          <span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          <span>FREEIQEXAM BRASIL — 12 FERRAMENTAS</span>
        </div>

        <h1 class="font-heading font-extrabold text-4xl sm:text-6xl md:text-7xl text-zinc-950 dark:text-white tracking-tight leading-[1.08] mb-8">
          Ferramentas gratuitas &amp;<br />
          <span class="text-zinc-500 dark:text-zinc-400">
            testes cognitivos online.
          </span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed mb-10">
          Cálculos úteis, autoavaliações cognitivas e testes sensoriais – diretamente no navegador, 100% gratuito e sem cadastro.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/pt-br/teste-de-qi"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-[#0066cc] hover:bg-[#0055b3] dark:bg-[#2997ff] dark:hover:bg-[#1a80e5] text-white font-semibold text-sm sm:text-base transition-all duration-200 active:scale-[0.97]"
          >
            Iniciar Teste de QI
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a
            href="/pt-br/calculadora-de-calorias"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 min-h-[44px] rounded-2xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-900 dark:text-white font-semibold text-sm sm:text-base border border-zinc-300 dark:border-zinc-700 transition-all duration-200 active:scale-[0.97]"
          >
            Calcular Calorias
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- CATEGORY 1: Cognição, QI & Memória -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categoria 1</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Cognição, QI &amp; Memória
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Teste de QI -->
        <a
          href="/pt-br/teste-de-qi"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Teste de QI Gratuito (24 Questões)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Teste de raciocínio lógico em matrizes com 24 itens, cronômetro de 20 minutos e relatório cognitivo instantâneo.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Fazer teste &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Jogo da Memória -->
        <a
          href="/pt-br/jogo-da-memoria"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M3 9h18" /><path d="M9 21V9" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Jogo da Memória Espacial
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Exercício cognitivo para memória de trabalho e retenção de padrões espaciais em grade interativa.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Jogar agora &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 2: Saúde, Nutrição & Estilo de Vida -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categoria 2</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Saúde, Nutrição &amp; Estilo de Vida
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Calculadora de Calorias -->
        <a
          href="/pt-br/calculadora-de-calorias"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z" /><path d="M10 2c1 .5 2 2 2 5" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Calculadora de Calorias &amp; TDEE
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Estime sua taxa metabólica basal (TMB), gasto calórico diário (TDEE) e metas de macronutrientes com a fórmula de Mifflin-St Jeor.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Calcular agora &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Memento Mori -->
        <a
          href="/pt-br/memento-mori"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Memento Mori (Calendário da Vida)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Visualização filosófica do tempo de vida em semanas para reflexão estoica, perspectiva e produtividade intencional.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Ver calendário &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </section>

    <!-- CATEGORY 3: Autoavaliações de Saúde (YMYL Safe) -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      <div class="mb-8">
        <p class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2">Categoria 3</p>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-white tracking-tight">
          Autoavaliações de Saúde
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl leading-relaxed">
          Autoavaliações orientativas para reflexão sobre sintomas e bem-estar. Não substituem diagnóstico médico.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Teste TDAH -->
        <a
          href="/pt-br/teste-tdah"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Teste de TDAH Adulto (ASRS v1.1)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Autoavaliação orientativa baseada na escala padronizada da OMS para sintomas de atenção e hiperatividade.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Fazer teste &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Teste Autismo -->
        <a
          href="/pt-br/teste-autismo"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" /><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Teste de Autismo Adulto (AQ-10)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Questionário de autoavaliação orientativa baseado no Autism-Spectrum Quotient de 10 itens.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0066cc] dark:text-[#2997ff] pt-5">
            Fazer teste &rarr;
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>

        <!-- Teste Depressão -->
        <a
          href="/pt-br/teste-depressao"
          class="group p-6 rounded-3xl bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all duration-200 active:scale-[0.98] flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/20 dark:border-[#2997ff]/30">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
              </span>
              <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-300/60 dark:border-zinc-700">
                ATIVO
              </span>
            </div>
            <h3 class="font-bold text-lg text-zinc-950 dark:text-white group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">
              Teste de Depressão (PHQ-9)
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mt-2">
              Questionário padronizado de 9 itens para autoavaliação e acompanhamento orientativo do humor.
            </p>
