  <Footer />

  <!-- Self-Contained Web Audio API Engine Script -->
  <script is:inline>
    (function () {
      'use strict';

      const FFT_SIZE = 2048;
      const ANALYSER_SMOOTHING = 0.8;
      const METER_FLOOR_DB = -60;
      const METER_CEIL_DB = 0;
      const DB_FLOOR = -100;
      const RING_SECONDS = 5;

      let audioCtx = null;
      let mediaStream = null;
      let sourceNode = null;
      let analyserNode = null;
      let scriptNode = null;

      let ringBuffer = null;
      let ringWrite = 0;
      let ringFilled = 0;
      let ringCapacity = 0;

      let animFrameId = null;
      let peakDbfs = -100;
      let peakHoldDbfs = -100;
      let peakHoldTime = 0;
      let consecutiveClips = 0;
      let clipTimer = null;

      // Noise floor state
      let noiseMeasuring = false;
      let noiseSamples = [];
      let measuredFloor = null;
      let speechPeak = null;

      // DOM elements
      const btnStart = document.getElementById('mic-start');
      const btnStop = document.getElementById('mic-stop');
      const deviceSelect = document.getElementById('mic-device');
      const clipIndicator = document.getElementById('clip-indicator');
      const meterFill = document.getElementById('meter-fill');
      const meterPeakMarker = document.getElementById('meter-peak-marker');
      const meterRms = document.getElementById('meter-rms');
      const meterPeak = document.getElementById('meter-peak');
      const spectrumCanvas = document.getElementById('spectrum-canvas');
      const snrBadge = document.getElementById('snr-badge');
      const analysisFloor = document.getElementById('analysis-floor');
      const analysisSpeech = document.getElementById('analysis-speech');
      const analysisSnr = document.getElementById('analysis-snr');
      const btnNoiseCapture = document.getElementById('noise-capture');
      const noiseStatus = document.getElementById('noise-status');
      const noiseProgress = document.getElementById('noise-progress');
      const btnPlayback = document.getElementById('mic-playback');
      const btnClear = document.getElementById('mic-clear');
      const playbackStatus = document.getElementById('playback-status');
      const micError = document.getElementById('mic-error');
      const micErrorMessage = document.getElementById('mic-error-message');
      const micUnsupported = document.getElementById('mic-unsupported');
      const micUnsupportedReason = document.getElementById('mic-unsupported-reason');

      const hwDevice = document.getElementById('hw-device');
      const hwRate = document.getElementById('hw-rate');
      const hwChannels = document.getElementById('hw-channels');
      const hwLatency = document.getElementById('hw-latency');

      const dspEcho = document.getElementById('dsp-echoCancellation');
      const dspNoise = document.getElementById('dsp-noiseSuppression');
      const dspAgc = document.getElementById('dsp-autoGainControl');

      function toDb(linear) {
        if (linear <= 0.000001) return DB_FLOOR;
        return 20 * Math.log10(linear);
      }

      function updateDevices() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
        navigator.mediaDevices.enumerateDevices().then(devices => {
          const audioInputs = devices.filter(d => d.kind === 'audioinput');
          const currentVal = deviceSelect.value;
          deviceSelect.innerHTML = '';
          if (audioInputs.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = 'Nenhum microfone detectado';
            deviceSelect.appendChild(opt);
            return;
          }
          audioInputs.forEach((dev, idx) => {
            const opt = document.createElement('option');
            opt.value = dev.deviceId;
            opt.textContent = dev.label || `Microfone ${idx + 1}`;
            deviceSelect.appendChild(opt);
          });
          if (currentVal) deviceSelect.value = currentVal;
        }).catch(() => {});
      }

      async function startMic() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          micUnsupported.hidden = false;
          micUnsupportedReason.textContent = 'Seu navegador não oferece suporte à captura via getUserMedia. Utilize o Chrome, Firefox, Edge ou Safari atualizados.';
          return;
        }

        micError.hidden = true;

        const constraints = {
          audio: {
            deviceId: deviceSelect.value ? { exact: deviceSelect.value } : undefined,
            echoCancellation: dspEcho.checked,
            noiseSuppression: dspNoise.checked,
            autoGainControl: dspAgc.checked
          }
        };

        try {
          mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') {
            await audioCtx.resume();
          }

          sourceNode = audioCtx.createMediaStreamSource(mediaStream);
          analyserNode = audioCtx.createAnalyser();
          analyserNode.fftSize = FFT_SIZE;
          analyserNode.smoothingTimeConstant = ANALYSER_SMOOTHING;

          ringCapacity = Math.ceil(audioCtx.sampleRate * RING_SECONDS);
          ringBuffer = new Float32Array(ringCapacity);
          ringWrite = 0;
          ringFilled = 0;

          // ScriptProcessor for ring buffer capture & clipping detection
          scriptNode = audioCtx.createScriptProcessor(2048, 1, 1);
          scriptNode.onaudioprocess = function (e) {
            const input = e.inputBuffer.getChannelData(0);
            const len = input.length;
            for (let i = 0; i < len; i++) {
              const sample = input[i];
              ringBuffer[ringWrite] = sample;
              ringWrite = (ringWrite + 1) % ringCapacity;
              if (ringFilled < ringCapacity) ringFilled++;

              const abs = Math.abs(sample);
              if (abs >= 0.99) {
                consecutiveClips++;
                if (consecutiveClips >= 3) {
                  triggerClip();
                }
              } else {
                consecutiveClips = 0;
              }
            }
          };

          sourceNode.connect(analyserNode);
          sourceNode.connect(scriptNode);
          scriptNode.connect(audioCtx.destination);

          // Update Hardware stats
          const track = mediaStream.getAudioTracks()[0];
          const settings = track.getSettings ? track.getSettings() : {};
          hwDevice.textContent = track.label || 'Microfone Padrão';
          hwRate.textContent = `${audioCtx.sampleRate.toLocaleString('pt-BR')} Hz`;
          hwChannels.textContent = settings.channelCount ? `${settings.channelCount} canais` : '1 (Mono)';
          hwLatency.textContent = settings.latency ? `${Math.round(settings.latency * 1000)} ms` : '< 20 ms';

          btnStart.disabled = true;
          btnStop.disabled = false;
          btnPlayback.disabled = false;
          playbackStatus.textContent = 'Gravando em buffer contínuo (5 segundos)...';

          updateDevices();
          renderLoop();
        } catch (err) {
          micError.hidden = false;
          if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
            micErrorMessage.textContent = 'Permissão negada. Clique no ícone de cadeado ou câmera na barra do navegador para autorizar o microfone.';
          } else if (err.name === 'NotFoundError' || err.name === 'DevicesNotFoundError') {
            micErrorMessage.textContent = 'Nenhum microfone foi detectado conectado ao seu computador.';
          } else if (err.name === 'NotReadableError' || err.name === 'TrackStartError') {
            micErrorMessage.textContent = 'O microfone já está em uso exclusivo por outro aplicativo (como Discord, Teams, Zoom ou OBS).';
          } else {
            micErrorMessage.textContent = 'Erro ao acessar o microfone: ' + (err.message || err.name);
          }
        }
      }

      function triggerClip() {
        clipIndicator.classList.add('bg-red-600', 'text-white', 'border-red-700');
        clipIndicator.classList.remove('text-zinc-400', 'dark:text-zinc-600');
        clearTimeout(clipTimer);
        clipTimer = setTimeout(() => {
          clipIndicator.classList.remove('bg-red-600', 'text-white', 'border-red-700');
          clipIndicator.classList.add('text-zinc-400', 'dark:text-zinc-600');
        }, 1500);
      }

      function stopMic() {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        if (mediaStream) {
          mediaStream.getTracks().forEach(t => t.stop());
          mediaStream = null;
        }
        if (sourceNode) {
          sourceNode.disconnect();
          sourceNode = null;
        }
        if (scriptNode) {
          scriptNode.disconnect();
          scriptNode = null;
        }
        if (audioCtx && audioCtx.state !== 'closed') {
          audioCtx.close();
          audioCtx = null;
        }

        btnStart.disabled = false;
        btnStop.disabled = true;
        playbackStatus.textContent = ringFilled > 0 ? 'Gravação retida no buffer pronta para reproduzir.' : 'Microfone parado.';
        meterFill.style.width = '0%';
        meterPeakMarker.style.left = '0%';
        meterRms.textContent = '--';
        meterPeak.textContent = '--';
      }

      function renderLoop() {
        if (!analyserNode) return;

        const timeData = new Float32Array(analyserNode.fftSize);
        analyserNode.getFloatTimeDomainData(timeData);

        let sumSquares = 0;
        let peak = 0;
        for (let i = 0; i < timeData.length; i++) {
          const val = timeData[i];
          const abs = Math.abs(val);
          if (abs > peak) peak = abs;
          sumSquares += val * val;
        }
        const rms = Math.sqrt(sumSquares / timeData.length);
        const currentRmsDbfs = Math.max(toDb(rms), METER_FLOOR_DB);
        const currentPeakDbfs = Math.max(toDb(peak), METER_FLOOR_DB);

        // Peak Hold computation
        const now = performance.now();
        if (currentPeakDbfs > peakHoldDbfs || (now - peakHoldTime > 1200)) {
          peakHoldDbfs = currentPeakDbfs;
          peakHoldTime = now;
        }

        // Meter UI update
        const fillPct = Math.max(0, Math.min(100, ((currentRmsDbfs - METER_FLOOR_DB) / (METER_CEIL_DB - METER_FLOOR_DB)) * 100));
        const peakPct = Math.max(0, Math.min(100, ((peakHoldDbfs - METER_FLOOR_DB) / (METER_CEIL_DB - METER_FLOOR_DB)) * 100));

        meterFill.style.width = `${fillPct}%`;
        meterPeakMarker.style.left = `${peakPct}%`;
        meterRms.textContent = currentRmsDbfs > -59 ? currentRmsDbfs.toFixed(1) : '--';
        meterPeak.textContent = currentPeakDbfs > -59 ? currentPeakDbfs.toFixed(1) : '--';

        // Track speech peak for SNR
        if (currentPeakDbfs > -45) {
          if (speechPeak === null || currentPeakDbfs > speechPeak) {
            speechPeak = currentPeakDbfs;
            analysisSpeech.textContent = `${speechPeak.toFixed(1)} dBFS`;
            updateSnr();
          }
        }

        // Noise measurement collection
        if (noiseMeasuring) {
          noiseSamples.push(currentRmsDbfs);
        }

        // Canvas FFT Spectrum Render
        drawSpectrum();

        animFrameId = requestAnimationFrame(renderLoop);
      }

      function drawSpectrum() {
        if (!spectrumCanvas || !analyserNode) return;
        const ctx = spectrumCanvas.getContext('2d');
        const width = spectrumCanvas.width = spectrumCanvas.offsetWidth;
        const height = spectrumCanvas.height = spectrumCanvas.offsetHeight;

        const freqData = new Uint8Array(analyserNode.frequencyBinCount);
        analyserNode.getByteFrequencyData(freqData);

        ctx.fillStyle = '#09090b';
        ctx.fillRect(0, 0, width, height);

        const barCount = 72;
        const barWidth = (width / barCount) - 1.5;
        const binCount = analyserNode.frequencyBinCount;

        for (let i = 0; i < barCount; i++) {
          // Logarithmic bin distribution
          const logIdx = Math.floor(Math.pow(binCount, i / barCount));
          const val = freqData[logIdx] || 0;
          const barHeight = (val / 255) * (height - 8);

          // Hue gradient: violet (270) to cyan/green (160)
          const hue = 260 - ((i / barCount) * 120);
          ctx.fillStyle = `hsl(${hue}, 85%, 60%)`;

          const x = i * (barWidth + 1.5);
          const y = height - barHeight;
          ctx.beginPath();
          ctx.roundRect(x, y, barWidth, barHeight, [2, 2, 0, 0]);
          ctx.fill();
        }
      }

      // Noise floor sampling
      btnNoiseCapture.addEventListener('click', () => {
        if (!mediaStream) {
          alert('Por favor, inicie o microfone primeiro antes de medir o ruído.');
          return;
        }
        noiseMeasuring = true;
        noiseSamples = [];
        btnNoiseCapture.disabled = true;
        noiseStatus.textContent = 'Medindo silêncio do quarto... permaneça calado (3s)';
        noiseProgress.style.width = '0%';

        const startTime = performance.now();
        const interval = setInterval(() => {
          const elapsed = performance.now() - startTime;
          const pct = Math.min(100, (elapsed / 3000) * 100);
          noiseProgress.style.width = `${pct}%`;
          if (elapsed >= 3000) {
            clearInterval(interval);
            noiseMeasuring = false;
            btnNoiseCapture.disabled = false;
            if (noiseSamples.length > 0) {
              // average of samples
              const sum = noiseSamples.reduce((a, b) => a + b, 0);
              measuredFloor = sum / noiseSamples.length;
              analysisFloor.textContent = `${measuredFloor.toFixed(1)} dBFS`;
              noiseStatus.textContent = 'Calibrado com sucesso!';
              updateSnr();
            }
          }
        }, 50);
      });

      function updateSnr() {
        if (measuredFloor !== null && speechPeak !== null) {
          const snr = Math.max(0, speechPeak - measuredFloor);
          analysisSnr.textContent = `${snr.toFixed(1)} dB`;

          if (snr >= 35) {
            snrBadge.textContent = 'Excelente (>35 dB)';
            snrBadge.className = 'font-mono text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          } else if (snr >= 25) {
            snrBadge.textContent = 'Bom (25–35 dB)';
            snrBadge.className = 'font-mono text-xs font-bold px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400';
          } else if (snr >= 15) {
            snrBadge.textContent = 'Regular (15–25 dB)';
            snrBadge.className = 'font-mono text-xs font-bold px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400';
          } else {
            snrBadge.textContent = 'Ruído Excessivo (<15 dB)';
            snrBadge.className = 'font-mono text-xs font-bold px-3 py-1 rounded-full border border-red-500/30 bg-red-500/10 text-red-600 dark:text-red-400';
          }
        }
      }

      // Loopback instant playback
      btnPlayback.addEventListener('click', () => {
        if (!ringBuffer || ringFilled === 0 || !audioCtx) return;
        playbackStatus.textContent = 'Reproduzindo gravação de 5 segundos...';
        btnPlayback.disabled = true;

        const playbackCtx = new (window.AudioContext || window.webkitAudioContext)();
        const audioBuffer = playbackCtx.createBuffer(1, ringFilled, audioCtx.sampleRate);
        const channelData = audioBuffer.getChannelData(0);

        const start = ringFilled < ringCapacity ? 0 : ringWrite;
        for (let i = 0; i < ringFilled; i++) {
          channelData[i] = ringBuffer[(start + i) % ringCapacity];
        }

        const playSource = playbackCtx.createBufferSource();
        playSource.buffer = audioBuffer;
        playSource.connect(playbackCtx.destination);
        playSource.onended = () => {
          playbackStatus.textContent = 'Reprodução finalizada.';
          btnPlayback.disabled = false;
          playbackCtx.close();
        };
        playSource.start();
      });

      btnClear.addEventListener('click', () => {
        if (ringBuffer) {
          ringBuffer.fill(0);
          ringFilled = 0;
          ringWrite = 0;
          playbackStatus.textContent = 'Gravação apagada da memória.';
          btnPlayback.disabled = true;
        }
      });

      btnStart.addEventListener('click', startMic);
      btnStop.addEventListener('click', stopMic);
      deviceSelect.addEventListener('change', () => {
        if (mediaStream) {
          stopMic();
          startMic();
        }
      });

      [dspEcho, dspNoise, dspAgc].forEach(el => {
        el.addEventListener('change', () => {
          if (mediaStream) {
            stopMic();
            startMic();
          }
        });
      });

      // Populate devices on load if available
      if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
        updateDevices();
      }
    })();
  </script>
</Layout>
