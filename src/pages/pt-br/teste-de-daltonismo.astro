---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const alternates = {
  en: 'https://freeiqexam.com/color-blind-test',
  ru: 'https://freeiqexam.com/ru/color-blind-test',
  id: 'https://freeiqexam.com/id/tes-buta-warna',
  fi: 'https://freeiqexam.com/fi/varisokeustesti',
  de: 'https://freeiqexam.com/de/farbsehtest',
  'pt-BR': 'https://freeiqexam.com/pt-br/teste-de-daltonismo'
};

const title = "Teste de Daltonismo Online: Teste de Ishihara para Daltonismo | FreeIQExam";
const description = "Faça o teste de daltonismo online gratuito com 22 placas Ishihara. Detecte daltonismo verde-vermelho (deuteranopia e protanopia) e azul-amarelo no navegador.";
const canonicalUrl = "https://freeiqexam.com/pt-br/teste-de-daltonismo";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Teste de Daltonismo Ishihara Online",
    "description": "Clinical 22-plate Ishihara assessment for red-green (Deuteranopia, Protanopia) and blue-yellow (Tritanopia) color vision deficiency.",
    "url": "https://freeiqexam.com/pt-br/teste-de-daltonismo",
    "medicalAudience": "Patient",
    "aspect": "Diagnostic"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam Online Color Blind Test",
    "url": "https://freeiqexam.com/pt-br/teste-de-daltonismo",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript and HTML5 Canvas/SVG support",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Authentic 22-Plate Ishihara Color Blindness Test",
      "Screening for Deuteranopia, Protanopia, and Tritanopia",
      "Interactive Color Vision Deficiency Simulator",
      "Kids and Symbols Mode for pre-literate pediatric testing",
      "Individual L-Cone, M-Cone, and S-Cone Sensitivity Percentages",
      "Zero paywall, zero signup instant clinical report"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.94",
      "ratingCount": "18450",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tools",
        "item": "https://freeiqexam.com/color-blind-test"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Color Blind Test",
        "item": "https://freeiqexam.com/color-blind-test"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the clinical color blind test called?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The clinical color blind test is officially called the Ishihara Test, named after Japanese ophthalmologist Dr. Shinobu Ishihara who published it in 1917. Other specialized diagnostic instruments include the Farnsworth D-15 / 100-Hue test, the Nagel Anomaloscope (the diagnostic gold standard), the HRR (Hardy-Rand-Rittler) test, and aviation lantern tests like the Farnsworth Lantern (Falant)."
        }
      },
      {
        "@type": "Question",
        "name": "How do you test for color blindness at home?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To take an accurate free color blind test online at home: 1) Set your display brightness to 100%, 2) Turn off Night Shift, TrueTone, f.lux, or blue-light screen filters, 3) Position yourself approximately arm's length (75 cm) from the display, and 4) Complete the 22 Ishihara plates without guessing. Our online test evaluates red-green (Deutan/Protan) and blue-yellow (Tritan) confusion axes with instant diagnostic percentages."
        }
      },
      {
        "@type": "Question",
        "name": "What is a reverse color blind test?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A reverse color blind test uses pseudo-isochromatic plates specifically designed so that individuals with normal color vision see only random dots or cannot distinguish the number, while individuals with red-green color blindness easily read the hidden digit. This occurs because colorblind observers are not distracted by camouflage color hues and perceive subtle luminance edges that trichromats overlook."
        }
      },
      {
        "@type": "Question",
        "name": "How do you test young kids for color blindness?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard Ishihara plates require reading numbers, which is unsuitable for toddlers and preschool children. For pediatric screening, use a color blind test for kids that employs geometric shapes (Circle, Square, Triangle, Star) or winding paths. Children point to the shape or trace the path with their finger, enabling accurate screening as early as ages 3 to 4."
        }
      },
      {
        "@type": "Question",
        "name": "Can you pass or cheat an Ishihara color blind test?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You cannot cheat an authentic clinical color blind test because genuine Ishihara and anomaloscope tests rely on biological retinal cone photopigments. While some attempt to memorize plate numbers, occupational exams (such as aviation, maritime, and military) use randomized plate sequences or alternative tests like the Farnsworth Lantern and Nagel Anomaloscope where memorization is impossible. Color-correcting lenses (like EnChroma) are prohibited during official certification testing."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between EnChroma and Pilestone color blind glasses?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EnChroma and Pilestone are the two leading manufacturers of optical notch-filter glasses for color blindness. Both companies offer online Ishihara screening tests. Their glasses use specialized spectral multi-notch coatings that filter out overlapping wavelengths between red and green cone absorption bands, boosting color contrast for anomalous trichromats (Deuteranomaly and Protanomaly). However, neither glasses cure color blindness nor do they work for dichromats who completely lack a functional cone photopigment."
        }
      },
      {
        "@type": "Question",
        "name": "What do red-green color blind people actually see?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "People with red-green color blindness do not see in black and white. Instead, reds, greens, oranges, and browns appear as muted variations of yellow, khaki, olive, and brown. For protanopes (red-blind), red objects also appear substantially dimmer or almost black. For deuteranopes (green-blind), green and red objects retain normal brightness but share an identical yellowish-brown hue."
        }
      },
      {
        "@type": "Question",
        "name": "Can you become a commercial airline pilot with color blindness?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, conditionally. The FAA (Federal Aviation Administration) and international civil aviation authorities require pilots to hold normal color vision for unrestricted Class 1 medical certification. If an applicant fails standard Ishihara plates, they can request an Operational Color Vision Test (OCVT), including a control tower light gun signal test and a medical flight test, to receive a Letter of Evidence (LOE) granting full flight privileges."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <!-- CVD SVG Simulation Filter Matrices (Hidden in DOM, referenced by CSS) -->
  <svg class="hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="deutan-filter">
      <feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0" />
    </filter>
    <filter id="protan-filter">
      <feColorMatrix type="matrix" values="0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0" />
    </filter>
    <filter id="tritan-filter">
      <feColorMatrix type="matrix" values="0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0" />
    </filter>
  </svg>

  <style>
    .plate-container {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    @keyframes pilestonePop {
      0% { transform: scale(1); }
      30% { transform: scale(0.96); opacity: 0.9; }
      70% { transform: scale(1.02); opacity: 0.98; }
      100% { transform: scale(1); opacity: 1; }
    }

    .pilestone-transition {
      animation: pilestonePop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .timeline-dot {
      transition: all 0.25s ease;
    }

    .plate-dot {
      vector-effect: non-scaling-stroke;
      shape-rendering: geometricPrecision;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    /* Simulation filters */
    .filter-normal { filter: none; }
    .filter-deutan { filter: url('#deutan-filter'); }
    .filter-protan { filter: url('#protan-filter'); }
    .filter-tritan { filter: url('#tritan-filter'); }
    .filter-achroma { filter: grayscale(100%); }

    @media print {
      header, footer, #calibration-banner, #keypad-numbers, #keypad-kids, .mode-toggle-container, #btn-restart-link, .no-print {
        display: none !important;
      }
      #results-view {
        display: flex !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-500 dark:text-zinc-400">Tools</span>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Color Blind Test</span>
    </nav>

    <!-- Page Header & Eyebrow -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs sm:text-sm font-mono font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Official Ishihara 22-Plate Diagnostic • Clinical CVD Screening</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-[-0.025em] mb-4">
        Free Color Blind Test (Ishihara Plate Assessment)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl mx-auto">
        Evaluate your color perception with the authentic 22-plate <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">Ishihara color blind test</strong>. High-resolution procedural dot plates detect <strong class="text-emerald-600 dark:text-emerald-400 font-bold">Deuteranopia</strong>, <strong class="text-rose-600 dark:text-rose-400 font-bold">Protanopia</strong>, and <strong class="text-blue-600 dark:text-blue-400 font-bold">Tritanopia</strong> with zero paywall.
      </p>
    </header>

    <!-- PRE-TEST DISPLAY CALIBRATION ADVISORY -->
    <div id="calibration-banner" class="max-w-3xl mx-auto mb-8 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
          <div class="space-y-1">
            <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Pre-Test Screen Calibration Check</h4>
            <p class="text-amber-800 dark:text-amber-300/90 text-sm leading-relaxed">
              For diagnostic precision: <strong>1)</strong> Set screen brightness to 100%, <strong>2)</strong> Turn off Night Shift, TrueTone, f.lux, or blue-light screen filters, and <strong>3)</strong> Maintain an arm's-length viewing distance (~50–75 cm).
            </p>
          </div>
        </div>
        <button id="btn-dismiss-calibration" type="button" class="text-amber-600 dark:text-amber-400 hover:text-amber-950 dark:hover:text-white p-1 cursor-pointer min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Dismiss calibration advisory"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
      </div>
    </div>

    <!-- TEST MODE TOGGLE (STANDARD NUMBERS VS KIDS SHAPES) -->
    <div class="mode-toggle-container max-w-md mx-auto mb-8 flex items-center justify-center p-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs font-medium text-xs sm:text-sm">
      <button id="mode-btn-numbers" type="button" class="flex-1 py-3 px-4 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-bold shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /><line x1="10" y1="3" x2="8" y2="21" /><line x1="16" y1="3" x2="14" y2="21" /></svg><span>Standard Numbers (22 Plates)</span>
      </button>
      <button id="mode-btn-kids" type="button" class="flex-1 py-3 px-4 rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg><span>Kids & Shapes Mode</span>
      </button>
    </div>

    <!-- INTERACTIVE TEST ARENA CARD -->
    <div class="relative w-full max-w-4xl mx-auto">
      <div id="test-card" class="plate-container w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl flex flex-col items-center">
        
        <!-- Header Bar with Brand & Plate Progress -->
        <div class="w-full flex items-center justify-between pb-4 mb-6 text-xs sm:text-sm font-mono border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <span class="font-heading font-extrabold tracking-wider uppercase text-zinc-900 dark:text-zinc-100 text-xs sm:text-sm">
              FREE<span class="text-blue-600 dark:text-blue-500">IQ</span>EXAM <span class="text-zinc-400 dark:text-zinc-500 font-normal">ISHIHARA</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span id="plate-counter-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-zinc-100 dark:bg-zinc-800 text-blue-600 dark:text-blue-400 border border-zinc-200 dark:border-zinc-700">
              PLATE 1 OF 22
            </span>
          </div>
        </div>

        <!-- 22-Plate Connected Timeline Progress Bar -->
        <div class="w-full mb-8 px-1 sm:px-4">
          <div id="timeline-chain" class="relative flex items-center justify-between w-full h-8">
            <div class="absolute left-2 right-2 top-1/2 -translate-y-1/2 h-[2px] bg-zinc-200 dark:bg-zinc-800 z-0"></div>
            <div id="timeline-dots" class="relative z-10 flex items-center justify-between w-full"></div>
          </div>
        </div>

        <!-- ACTIVE TESTING ARENA (SIDE-BY-SIDE ON DESKTOP, STACKED ON MOBILE) -->
        <div id="active-test-view" class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-14 my-2">
          
          <!-- High-DPI Procedural 764-Circle Ishihara SVG Stage -->
          <div id="plate-stage" class="relative w-[300px] sm:w-[380px] lg:w-[440px] aspect-square rounded-full bg-zinc-100 dark:bg-[#18181c] p-2 shadow-2xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center shrink-0">
            <svg id="plate-svg" class="w-full h-full rounded-full block cursor-pointer select-none" viewBox="0 0 666 666" role="img" aria-label="Authentic Ishihara color blindness test plate" xmlns="http://www.w3.org/2000/svg">
              <circle cx="333" cy="333" r="328" fill="#121215"></circle>
              <g id="plate-dots"></g>
            </svg>
          </div>

          <!-- Keypad & Touch Controls Column -->
          <div class="flex flex-col items-center justify-center w-full max-w-[300px]">
            <!-- Instruction Prompt -->
            <div class="text-center mb-5">
              <p id="prompt-main-text" class="text-xs sm:text-sm font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-300 font-semibold mb-1">Select the Number You See</p>
              <p id="prompt-sub-text" class="text-xs text-zinc-400 dark:text-zinc-500">Keyboard: [1-9], [N] Nothing, [U] Unsure</p>
            </div>

            <!-- NUMBERS MODE KEYPAD (1-9, NOTHING, NOT SURE) -->
            <div id="keypad-numbers" class="w-full flex flex-col items-center">
              <div class="grid grid-cols-3 gap-3 w-full mb-3">
                <button type="button" data-val="1" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">1</button>
                <button type="button" data-val="2" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">2</button>
                <button type="button" data-val="3" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">3</button>
                <button type="button" data-val="4" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">4</button>
                <button type="button" data-val="5" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">5</button>
                <button type="button" data-val="6" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">6</button>
                <button type="button" data-val="7" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">7</button>
                <button type="button" data-val="8" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">8</button>
                <button type="button" data-val="9" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">9</button>
              </div>

              <!-- Action Row: NOTHING / NOT SURE -->
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="nothing" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  NOTHING
                </button>
                <button type="button" data-val="unsure" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  NOT SURE
                </button>
              </div>
            </div>

            <!-- KIDS & SHAPES MODE KEYPAD (CIRCLE, SQUARE, TRIANGLE, STAR) -->
            <div id="keypad-kids" class="w-full flex flex-col items-center hidden">
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="Circle" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border-2 border-emerald-500/40 hover:border-emerald-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-emerald-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="currentColor" /></svg></span><span>Circle</span>
                </button>
                <button type="button" data-val="Square" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.98] border-2 border-blue-500/40 hover:border-blue-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
