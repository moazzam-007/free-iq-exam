  <Footer />

  <!-- Self-Contained Typing Engine Script -->
  <script is:inline>
    (function () {
      'use strict';

      const WORDS_POOL = [
        "você", "muito", "tempo", "vida", "mundo", "trabalho", "pessoa", "coisa",
        "governo", "país", "cidade", "estudo", "amigo", "família", "verdade", "momento",
        "grande", "pequeno", "novo", "velho", "primeiro", "último", "agora", "sempre",
        "nunca", "talvez", "depois", "ainda", "mesmo", "outro", "fazer", "dizer",
        "poder", "saber", "querer", "ficar", "deixar", "passar", "pensar", "achar",
        "levar", "olhar", "chamar", "sentir", "tentar", "esperar", "coração", "atenção",
        "situação", "educação", "informação", "decisão", "produção", "questão", "solução",
        "relação", "posição", "função", "ação", "espaço", "serviço", "preço", "começo",
        "braço", "peça", "força", "praça", "fácil", "difícil", "página", "história",
        "ciência", "saúde", "música", "próximo", "número", "público", "próprio", "também",
        "além", "porém", "alguém", "ninguém", "então", "assim", "hoje", "ontem", "manhã",
        "tarde", "noite", "água", "fogo", "terra", "vento", "casa", "porta", "janela",
        "livro", "mesa", "carro", "rua", "caminho", "ideia", "sonho", "amor", "paz",
        "direito", "dever", "razão", "exemplo", "grupo", "forma", "parte", "lugar", "caso"
      ];

      // State
      let mode = 'time';
      let targetTime = 60;
      let targetWords = 50;
      let timeLeft = 60;
      let timerInterval = null;
      let isRunning = false;
      let isFinished = false;

      let currentWordIndex = 0;
      let currentCharIndex = 0;
      let wordsList = [];
      let totalTypedChars = 0;
      let correctTypedChars = 0;
      let incorrectTypedChars = 0;

      let speedHistory = []; // WPM per second

      // Web Audio Synth for Key Sounds
      let audioCtx = null;
      function playKeySound(type) {
        if (type === 'mute') return;
        try {
          if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') audioCtx.resume();

          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          const now = audioCtx.currentTime;

          if (type === 'blue') {
            // Clicky high pitch snap
            osc.frequency.setValueAtTime(1800, now);
            osc.frequency.exponentialRampToValueAtTime(300, now + 0.04);
            gain.gain.setValueAtTime(0.15, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.04);
          } else if (type === 'brown') {
            // Thock tactile
            osc.frequency.setValueAtTime(450, now);
            osc.frequency.exponentialRampToValueAtTime(120, now + 0.05);
            gain.gain.setValueAtTime(0.18, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.05);
          } else if (type === 'red') {
            // Soft linear
            osc.frequency.setValueAtTime(280, now);
            osc.frequency.exponentialRampToValueAtTime(90, now + 0.06);
            gain.gain.setValueAtTime(0.1, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.06);
          }
        } catch (e) {}
      }

      // DOM Elements
      const wordsWrapper = document.getElementById('wordsWrapper');
      const caret = document.getElementById('caret');
      const typingInput = document.getElementById('typingInput');
      const hudTimer = document.getElementById('hudTimer');
      const hudWpm = document.getElementById('hudWpm');
      const hudAccuracy = document.getElementById('hudAccuracy');
      const restartBtn = document.getElementById('restartBtn');
      const soundSelect = document.getElementById('soundSelect');
      const typingArena = document.getElementById('typingArena');
      const resultsWrap = document.getElementById('resultsWrap');

      const resNetWpm = document.getElementById('resNetWpm');
      const resAccuracy = document.getElementById('resAccuracy');
      const resRawWpm = document.getElementById('resRawWpm');
      const resChars = document.getElementById('resChars');
      const resTierBadge = document.getElementById('resTierBadge');
      const sparklineCanvas = document.getElementById('sparklineCanvas');

      const btnDownloadCert = document.getElementById('btnDownloadCert');
      const btnCopyShare = document.getElementById('btnCopyShare');
      const btnRetry = document.getElementById('btnRetry');

      const timeOptionsGroup = document.getElementById('timeOptionsGroup');
      const wordOptionsGroup = document.getElementById('wordOptionsGroup');

      function shuffleWords(count) {
        const list = [];
        for (let i = 0; i < count; i++) {
          const rand = WORDS_POOL[Math.floor(Math.random() * WORDS_POOL.length)];
          list.push(rand);
        }
        return list;
      }

      function initTest() {
        clearInterval(timerInterval);
        isRunning = false;
        isFinished = false;
        timeLeft = targetTime;
        currentWordIndex = 0;
        currentCharIndex = 0;
        totalTypedChars = 0;
        correctTypedChars = 0;
        incorrectTypedChars = 0;
        speedHistory = [];

        resultsWrap.classList.add('hidden');
        typingInput.value = '';
        typingInput.disabled = false;

        hudTimer.textContent = mode === 'time' ? `${targetTime}s` : `${targetWords} pal`;
        hudWpm.textContent = '0';
        hudAccuracy.textContent = '100%';

        const numWordsToGen = mode === 'words' ? targetWords : 120;
        wordsList = shuffleWords(numWordsToGen);

        renderWords();
        updateCaret();
        typingInput.focus();
      }

      function renderWords() {
        wordsWrapper.innerHTML = '';
        wordsList.forEach((w, wIdx) => {
          const spanWord = document.createElement('span');
          spanWord.className = 'word inline-block mr-3';
          spanWord.dataset.wordIndex = wIdx;

          for (let i = 0; i < w.length; i++) {
            const spanChar = document.createElement('span');
            spanChar.className = 'char text-zinc-400 dark:text-zinc-500';
            spanChar.textContent = w[i];
            spanWord.appendChild(spanChar);
          }
          wordsWrapper.appendChild(spanWord);
        });
      }

      function updateCaret() {
        const wordEl = wordsWrapper.children[currentWordIndex];
        if (!wordEl) return;

        const charEl = wordEl.children[currentCharIndex];
        let targetX = 0;
        let targetY = 0;

        if (charEl) {
          targetX = charEl.offsetLeft;
          targetY = charEl.offsetTop + 4;
        } else {
          // Caret after last character
          const lastChar = wordEl.children[wordEl.children.length - 1];
          if (lastChar) {
            targetX = lastChar.offsetLeft + lastChar.offsetWidth;
            targetY = lastChar.offsetTop + 4;
          }
        }

        caret.style.transform = `translate(${targetX}px, ${targetY}px)`;

        // Scroll words wrapper if line advances
        if (targetY > 70) {
          wordsWrapper.scrollTop = targetY - 40;
        } else {
          wordsWrapper.scrollTop = 0;
        }
      }

      function startTimer() {
        if (isRunning) return;
        isRunning = true;
        const startTime = Date.now();

        timerInterval = setInterval(() => {
          const elapsedSec = Math.floor((Date.now() - startTime) / 1000);

          if (mode === 'time') {
            timeLeft = targetTime - elapsedSec;
            hudTimer.textContent = `${Math.max(0, timeLeft)}s`;
            if (timeLeft <= 0) {
              finishTest();
            }
          } else {
            hudTimer.textContent = `${elapsedSec}s`;
          }

          // Compute instantaneous live WPM
          if (elapsedSec > 0) {
            const currentWpm = Math.round((correctTypedChars / 5) / (elapsedSec / 60));
            hudWpm.textContent = String(Math.max(0, currentWpm));
            speedHistory.push(currentWpm);
          }
        }, 1000);
      }

      function finishTest() {
        clearInterval(timerInterval);
        isRunning = false;
        isFinished = true;
        typingInput.disabled = true;

        const durationMinutes = (targetTime - Math.max(0, timeLeft)) / 60 || 1;
        const rawWpm = Math.round((totalTypedChars / 5) / durationMinutes);
        const netWpm = Math.max(0, Math.round((correctTypedChars / 5) / durationMinutes));
        const accuracy = totalTypedChars > 0 ? Math.round((correctTypedChars / totalTypedChars) * 100) : 100;

        resNetWpm.textContent = String(netWpm);
        resAccuracy.textContent = `${accuracy}%`;
        resRawWpm.textContent = String(rawWpm);
        resChars.textContent = String(totalTypedChars);

        // Tier classification
        let tierLabel = '';
        let tierColor = '';
        if (netWpm >= 85) {
          tierLabel = 'Mestre (Top 5%)';
          tierColor = 'border-amber-500 bg-amber-500/10 text-amber-600 dark:text-amber-400';
        } else if (netWpm >= 65) {
          tierLabel = 'Avançado';
          tierColor = 'border-purple-500 bg-purple-500/10 text-purple-600 dark:text-purple-400';
        } else if (netWpm >= 45) {
          tierLabel = 'Fluente';
          tierColor = 'border-emerald-500 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
        } else if (netWpm >= 25) {
          tierLabel = 'Médio';
          tierColor = 'border-blue-500 bg-blue-500/10 text-blue-600 dark:text-blue-400';
        } else {
          tierLabel = 'Iniciante';
          tierColor = 'border-zinc-500 bg-zinc-500/10 text-zinc-600 dark:text-zinc-400';
        }

        resTierBadge.textContent = tierLabel;
        resTierBadge.className = `px-5 py-2.5 rounded-2xl border text-sm sm:text-base font-bold text-center ${tierColor}`;

        resultsWrap.classList.remove('hidden');
        renderSparkline();
        resultsWrap.scrollIntoView({ behavior: 'smooth' });
      }

      function renderSparkline() {
        if (!sparklineCanvas || speedHistory.length < 2) return;
        const ctx = sparklineCanvas.getContext('2d');
        const width = sparklineCanvas.width = sparklineCanvas.offsetWidth;
        const height = sparklineCanvas.height = sparklineCanvas.offsetHeight;

        ctx.clearRect(0, 0, width, height);

        const maxVal = Math.max(...speedHistory, 50);
        const minVal = Math.min(...speedHistory, 0);
        const stepX = width / (speedHistory.length - 1);

        // Draw Area
        ctx.beginPath();
        speedHistory.forEach((val, idx) => {
          const x = idx * stepX;
          const y = height - ((val - minVal) / (maxVal - minVal || 1)) * (height - 20) - 10;
          if (idx === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.lineTo(width, height);
        ctx.lineTo(0, height);
        ctx.closePath();
        ctx.fillStyle = 'rgba(0, 102, 204, 0.1)';
        ctx.fill();

        // Draw Line
        ctx.beginPath();
        speedHistory.forEach((val, idx) => {
          const x = idx * stepX;
          const y = height - ((val - minVal) / (maxVal - minVal || 1)) * (height - 20) - 10;
          if (idx === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.strokeStyle = '#0066cc';
        ctx.lineWidth = 3;
        ctx.stroke();
      }

      // Input Event Handler
      typingInput.addEventListener('input', (e) => {
        if (isFinished) return;
        if (!isRunning) startTimer();

        playKeySound(soundSelect.value);

        const val = typingInput.value;
        const currentTargetWord = wordsList[currentWordIndex];
        const wordEl = wordsWrapper.children[currentWordIndex];
        if (!wordEl) return;

        // Spacebar pressed: advance to next word
        if (val.endsWith(' ')) {
          const typedWord = val.trim();
          totalTypedChars += typedWord.length + 1; // plus space

          // Validate current word characters
          for (let i = 0; i < currentTargetWord.length; i++) {
            const charSpan = wordEl.children[i];
            if (i < typedWord.length) {
              if (typedWord[i] === currentTargetWord[i]) {
                correctTypedChars++;
                if (charSpan) charSpan.className = 'char correct';
              } else {
                incorrectTypedChars++;
                if (charSpan) charSpan.className = 'char incorrect';
              }
            } else {
              // Missed char
              if (charSpan) charSpan.className = 'char incorrect';
              incorrectTypedChars++;
            }
          }

          currentWordIndex++;
          currentCharIndex = 0;
          typingInput.value = '';

          // Check if words mode is finished
          if (mode === 'words' && currentWordIndex >= targetWords) {
            finishTest();
            return;
          }

          updateCaret();
          return;
        }

        // Mid-word typing update
        currentCharIndex = val.length;
        for (let i = 0; i < currentTargetWord.length; i++) {
          const charSpan = wordEl.children[i];
          if (!charSpan) continue;

          if (i < val.length) {
            if (val[i] === currentTargetWord[i]) {
              charSpan.className = 'char correct';
            } else {
              charSpan.className = 'char incorrect';
            }
          } else {
            charSpan.className = 'char text-zinc-400 dark:text-zinc-500';
          }
        }

        // Live accuracy computation
        const currentTotal = totalTypedChars + val.length;
        const currentCorrect = correctTypedChars + (val === currentTargetWord.slice(0, val.length) ? val.length : 0);
        const liveAcc = currentTotal > 0 ? Math.round((currentCorrect / currentTotal) * 100) : 100;
        hudAccuracy.textContent = `${liveAcc}%`;

        updateCaret();
      });

      // Restart shortcuts (Tab, Esc)
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Tab' || e.key === 'Escape') {
          e.preventDefault();
          initTest();
        }
      });

      typingArena.addEventListener('click', () => {
        typingInput.focus();
      });

      restartBtn.addEventListener('click', initTest);
      btnRetry.addEventListener('click', initTest);

      // Certificate Download (Canvas render)
      btnDownloadCert.addEventListener('click', () => {
        const certCanvas = document.createElement('canvas');
        certCanvas.width = 1200;
        certCanvas.height = 675;
        const c = certCanvas.getContext('2d');

        // Background Flat Luxury Obsidian
        c.fillStyle = '#09090b';
        c.fillRect(0, 0, 1200, 675);

        // Subtle Gold Border
        c.strokeStyle = '#27272a';
        c.lineWidth = 8;
        c.strokeRect(30, 30, 1140, 615);

        // Header
        c.fillStyle = '#0066cc';
        c.font = 'bold 20px monospace';
        c.textAlign = 'center';
        c.fillText('CERTIFICADO OFICIAL DE VELOCIDADE DE DIGITAÇÃO', 600, 100);

        c.fillStyle = '#ffffff';
        c.font = 'bold 44px sans-serif';
        c.fillText('FreeIQExam · Teste de Digitação', 600, 160);

        // Metrics Section
        c.fillStyle = '#a1a1aa';
        c.font = '22px sans-serif';
        c.fillText('Este documento certifica que o usuário realizou o teste em português com o resultado:', 600, 230);

        // Score Highlight Box
        c.fillStyle = '#18181b';
        c.beginPath();
        c.roundRect(400, 270, 400, 140, 16);
        c.fill();
        c.strokeStyle = '#0066cc';
        c.lineWidth = 2;
        c.stroke();

        c.fillStyle = '#2997ff';
        c.font = 'extrabold 72px monospace';
        c.fillText(resNetWpm.textContent, 600, 350);

        c.fillStyle = '#a1a1aa';
        c.font = 'bold 18px monospace';
        c.fillText('PALAVRAS POR MINUTO (WPM)', 600, 390);

        // Secondary Details
        c.fillStyle = '#e4e4e7';
        c.font = '20px monospace';
        c.fillText(`Precisão: ${resAccuracy.textContent}   |   Velocidade Bruta: ${resRawWpm.textContent} WPM   |   Total Toques: ${resChars.textContent} CPM`, 600, 460);

        c.fillStyle = '#10b981';
        c.font = 'bold 24px sans-serif';
        c.fillText(`Classificação: ${resTierBadge.textContent}`, 600, 510);

        // Footer & Verification
        c.fillStyle = '#71717a';
        c.font = '16px monospace';
        const today = new Date().toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' });
        c.fillText(`Emitido em: ${today} · Verificação: freeiqexam.com/pt-br/teste-de-digitacao`, 600, 590);

        const a = document.createElement('a');
        a.download = `certificado-digitacao-${resNetWpm.textContent}wpm.png`;
        a.href = certCanvas.toDataURL('image/png');
        a.click();
      });

      // Copy Share Result
      btnCopyShare.addEventListener('click', () => {
        const text = `🏆 Alcancei ${resNetWpm.textContent} WPM com ${resAccuracy.textContent} de precisão no Teste de Digitação em Português do FreeIQExam!\nTeste sua velocidade gratuitamente em: https://freeiqexam.com/pt-br/teste-de-digitacao`;
        navigator.clipboard.writeText(text).then(() => {
          const original = btnCopyShare.textContent;
          btnCopyShare.textContent = 'Copiado para a Área de Transferência!';
          setTimeout(() => { btnCopyShare.textContent = original; }, 2000);
        });
      });

      // Time options buttons
      document.querySelectorAll('.time-opt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.time-opt-btn').forEach(b => b.classList.remove('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]'));
          btn.classList.add('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]');
          targetTime = parseInt(btn.dataset.time, 10);
          initTest();
        });
      });

      // Word options buttons
      document.querySelectorAll('.word-opt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.word-opt-btn').forEach(b => b.classList.remove('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]'));
          btn.classList.add('active', 'font-bold', 'text-[#0066cc]', 'dark:text-[#2997ff]');
          targetWords = parseInt(btn.dataset.words, 10);
          initTest();
        });
      });

      // Mode toggle buttons (Tempo vs Palavras)
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.mode-btn').forEach(b => {
            b.classList.remove('active', 'bg-blue-500/10', 'text-[#0066cc]', 'dark:text-[#2997ff]', 'border', 'border-blue-500/40');
            b.classList.add('text-zinc-600', 'dark:text-zinc-400');
          });
          btn.classList.add('active', 'bg-blue-500/10', 'text-[#0066cc]', 'dark:text-[#2997ff]', 'border', 'border-blue-500/40');
          btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');

          mode = btn.dataset.mode;
          if (mode === 'time') {
            timeOptionsGroup.classList.remove('hidden');
            wordOptionsGroup.classList.add('hidden');
          } else {
            timeOptionsGroup.classList.add('hidden');
            wordOptionsGroup.classList.remove('hidden');
          }
          initTest();
        });
      });

      // Initial start
      initTest();
    })();
  </script>
</Layout>
