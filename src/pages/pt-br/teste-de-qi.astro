  <!-- Obfuscated Test Bank and Answer Key -->
  <script is:inline id="test-bank-data" type="application/json" set:html={bankJson} />
  <script is:inline id="scoring-key-token" type="application/json" set:html={JSON.stringify({ token: answerKeyToken })} />

  <!-- Client-side Interactive Runner Script -->
  <script is:inline>
    (function () {
      'use strict';

      var bankScript = document.getElementById('test-bank-data');
      var tokenScript = document.getElementById('scoring-key-token');
      if (!bankScript || !tokenScript) return;

      var FULL_BANK = JSON.parse(bankScript.textContent || '[]');
      var SCORING_KEY = {};
      try {
        var tokenObj = JSON.parse(tokenScript.textContent || '{}');
        if (tokenObj.token) {
          SCORING_KEY = JSON.parse(atob(tokenObj.token));
        }
      } catch (e) {
        SCORING_KEY = {};
      }

      var TOTAL_TIME_SECONDS = 1200; // 20 minutes

      var STORAGE_KEY_SESSION   = 'pt_br_iq_session';
      var STORAGE_KEY_ANSWERS   = 'pt_br_iq_answers';
      var STORAGE_KEY_QUESTIONS = 'pt_br_iq_active_questions';
      var STORAGE_KEY_TYPE      = 'pt_br_iq_test_type';

      // CHC domain display labels (Portuguese)
      var DOMAIN_LABELS = {
        fluid:        { label: 'Raciocínio Fluido', cat: 'Indução Abstrata (Gf)' },
        spatial:      { label: 'Visuoespacial', cat: 'Rotação Mental & Visualização (Gv)' },
        quantitative: { label: 'Raciocínio Quantitativo', cat: 'Lógica Numérica (Gq)' },
        verbal:       { label: 'Compreensão Verbal', cat: 'Cognição Semântica (Gc)' }
      };

      // Seeded RNG (Mulberry32)
      function createRng(seed) {
        var s = seed >>> 0;
        return function () {
          s += 0x6d2b79f5;
          var t = s;
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function shuffle(arr, rng) {
        var out = arr.slice();
        for (var i = out.length - 1; i > 0; i--) {
          var j = Math.floor(rng() * (i + 1));
          var tmp = out[i]; out[i] = out[j]; out[j] = tmp;
        }
        return out;
      }

      function sampleDomain(domain, count, rng) {
        var pool = FULL_BANK.filter(function (item) { return item.domain === domain; });
        return shuffle(pool, rng).slice(0, count);
      }

      function buildStandardSet(seed) {
        var rng = createRng(seed);
        var domains = ['fluid', 'spatial', 'quantitative', 'verbal'];
        var result = [];
        domains.forEach(function (d) {
          sampleDomain(d, 6, rng).forEach(function (item) { result.push(item); });
        });
        return result;
      }

      // State
      var questions = [];
      var currentIndex = 0;
      var userAnswers = {};
      var timeRemaining = TOTAL_TIME_SECONDS;
      var timerInterval = null;
      var autoAdvanceTimer = null;
      var targetEndTime = null;
      var sessionSeed = null;
      var startTimeMs = Date.now();
      var sessionExpired = false;

      // Restore or init session
      try {
        var saved = localStorage.getItem(STORAGE_KEY_SESSION);
        if (saved) {
          var parsed = JSON.parse(saved);
          if (parsed && typeof parsed === 'object') {
            var now = Date.now();
            var isFresh = !parsed.savedAt || (now - parsed.savedAt) < 7200000;
            if (isFresh) {
              if (typeof parsed.startTimeMs === 'number') startTimeMs = parsed.startTimeMs;
              if (typeof parsed.seed === 'number') sessionSeed = parsed.seed;
              if (parsed.answers && typeof parsed.answers === 'object') userAnswers = parsed.answers;
              if (typeof parsed.timeRemaining === 'number' && parsed.timeRemaining > 0) timeRemaining = parsed.timeRemaining;
              if (typeof parsed.currentQuestionIndex === 'number' && parsed.currentQuestionIndex >= 0) {
                currentIndex = parsed.currentQuestionIndex;
              }
              if (typeof parsed.targetEndTime === 'number') {
                if (parsed.targetEndTime <= now) {
                  timeRemaining = 0;
                  sessionExpired = true;
                } else {
                  targetEndTime = parsed.targetEndTime;
                  timeRemaining = Math.max(0, Math.round((targetEndTime - now) / 1000));
                }
              } else {
                targetEndTime = now + timeRemaining * 1000;
              }
            } else {
              localStorage.removeItem(STORAGE_KEY_SESSION);
              targetEndTime = now + timeRemaining * 1000;
            }
          }
        } else {
          targetEndTime = Date.now() + timeRemaining * 1000;
        }
      } catch (err) {
        targetEndTime = Date.now() + timeRemaining * 1000;
      }

      if (!sessionSeed) sessionSeed = Math.floor(Math.random() * 0xffffffff);
      questions = buildStandardSet(sessionSeed);
      if (currentIndex >= questions.length) currentIndex = 0;

      if (sessionExpired) {
        localStorage.removeItem(STORAGE_KEY_SESSION);
        submitTestImmediately();
        return;
      }

      // DOM Elements
      var timerDisplay    = document.getElementById('timer-display');
      var timerContainer  = document.getElementById('timer-container');
      var statCurrent     = document.getElementById('stat-current');
      var mobileQNum      = document.getElementById('mobile-q-num');
      var progressBar     = document.getElementById('progress-bar');
      var domainBadge     = document.getElementById('domain-badge');
      var domainCategory  = document.getElementById('domain-category');
      var promptText      = document.getElementById('question-prompt-text');
      var stimulusCont    = document.getElementById('stimulus-container');
      var optionsGrid     = document.getElementById('options-grid');
      var answeredCount   = document.getElementById('answered-count');
      var optCountHint    = document.getElementById('opt-count-hint');
      var navStrip        = document.getElementById('navigator-strip');
      var btnPrev         = document.getElementById('btn-prev');
      var btnNext         = document.getElementById('btn-next');
      var btnNextText     = document.getElementById('btn-next-text');
      var btnTopSubmit    = document.getElementById('btn-top-submit');
      var btnExit         = document.getElementById('btn-exit');
      var srAnnouncer     = document.getElementById('sr-announcer');

      // Modals
      var modalExit       = document.getElementById('modal-exit');
      var modalExitCancel = document.getElementById('modal-exit-cancel');
      var modalExitConfirm= document.getElementById('modal-exit-confirm');

      var modalSubmit     = document.getElementById('modal-submit');
      var modalSubmitBody = document.getElementById('modal-submit-body');
      var modalSubmitCancel = document.getElementById('modal-submit-cancel');
      var modalSubmitConfirm= document.getElementById('modal-submit-confirm');

      var modalTimeout    = document.getElementById('modal-timeout');
      var modalTimeoutConfirm = document.getElementById('modal-timeout-confirm');

      function saveSession() {
        try {
          var payload = {
            savedAt: Date.now(),
            startTimeMs: startTimeMs,
            seed: sessionSeed,
            answers: userAnswers,
            timeRemaining: timeRemaining,
            currentQuestionIndex: currentIndex,
            targetEndTime: targetEndTime
          };
          localStorage.setItem(STORAGE_KEY_SESSION, JSON.stringify(payload));
        } catch (e) {}
      }

      function updateTimerDisplay() {
        var m = Math.floor(timeRemaining / 60);
        var s = timeRemaining % 60;
        var formatted = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
        if (timerDisplay) timerDisplay.textContent = formatted;

        if (timeRemaining <= 120) {
          if (timerContainer) {
            timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 animate-pulse';
          }
        }
      }

      function startTimer() {
        updateTimerDisplay();
        timerInterval = setInterval(function () {
          var now = Date.now();
          if (targetEndTime) {
            timeRemaining = Math.max(0, Math.round((targetEndTime - now) / 1000));
          } else {
            timeRemaining--;
          }
          updateTimerDisplay();
          saveSession();

          if (timeRemaining <= 0) {
            clearInterval(timerInterval);
            if (modalTimeout) modalTimeout.classList.remove('hidden');
          }
        }, 1000);
      }

      function renderNavigator() {
        if (!navStrip) return;
        navStrip.innerHTML = '';
        questions.forEach(function (q, idx) {
          var isAnswered = typeof userAnswers[q.id] !== 'undefined';
          var isCurrent = idx === currentIndex;
          var pill = document.createElement('button');
          pill.type = 'button';
          pill.setAttribute('aria-label', 'Questão ' + (idx + 1) + (isAnswered ? ' (Respondida)' : ' (Pendente)'));
          pill.textContent = idx + 1;

          var baseClass = 'w-8 h-8 rounded-lg text-xs font-mono font-bold transition-all flex items-center justify-center shrink-0 cursor-pointer ';
          if (isCurrent) {
            pill.className = baseClass + 'bg-[#0066cc] dark:bg-[#2997ff] text-white ring-2 ring-blue-500/40';
          } else if (isAnswered) {
            pill.className = baseClass + 'bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-500/40';
          } else {
            pill.className = baseClass + 'bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-200 dark:hover:bg-zinc-700';
          }

          pill.addEventListener('click', function () {
            currentIndex = idx;
            renderQuestion();
            saveSession();
          });
          navStrip.appendChild(pill);
        });
      }

      function renderQuestion() {
        if (!questions || questions.length === 0) return;
        var q = questions[currentIndex];
        if (!q) return;

        if (statCurrent) statCurrent.textContent = (currentIndex + 1);
        if (mobileQNum) mobileQNum.textContent = (currentIndex + 1);

        var pct = ((currentIndex + 1) / questions.length) * 100;
        if (progressBar) progressBar.style.width = pct + '%';

        var domInfo = DOMAIN_LABELS[q.domain] || { label: q.domainLabel || 'Cognição', cat: 'Raciocínio' };
        if (domainBadge) domainBadge.textContent = domInfo.label;
        if (domainCategory) domainCategory.textContent = domInfo.cat;

        if (promptText) {
          if (q.promptText && q.promptText.trim()) {
            promptText.textContent = q.promptText;
          } else {
            promptText.textContent = 'Selecione a opção que completa logicamente a matriz:';
          }
        }

        // Render Stimulus SVG
        if (stimulusCont) {
          if (q.promptSvg) {
            stimulusCont.innerHTML = q.promptSvg;
          } else {
            stimulusCont.innerHTML = '<div class="text-sm font-mono text-zinc-400 p-8 text-center">[Visualização do estímulo]</div>';
          }
        }

        // Render Options
        if (optionsGrid) {
          optionsGrid.innerHTML = '';
          var count = q.options.length;
          if (optCountHint) optCountHint.textContent = count;

          q.options.forEach(function (opt, oIdx) {
            var isSelected = userAnswers[q.id] === opt.id;
            var optBtn = document.createElement('button');
            optBtn.type = 'button';
            optBtn.setAttribute('data-opt-id', opt.id);
            optBtn.setAttribute('data-key', (oIdx + 1));
            optBtn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');

            var btnClass = 'group relative p-3 sm:p-4 rounded-2xl border transition-all flex flex-col items-center justify-center min-h-[90px] sm:min-h-[110px] cursor-pointer active:scale-[0.97] ';
            if (isSelected) {
              btnClass += 'bg-[#0066cc]/10 dark:bg-[#2997ff]/10 border-[#0066cc] dark:border-[#2997ff] ring-2 ring-[#0066cc]/30 dark:ring-[#2997ff]/30 text-zinc-950 dark:text-white';
            } else {
              btnClass += 'bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 text-zinc-800 dark:text-zinc-200';
            }
            optBtn.className = btnClass;

            var keyBadge = document.createElement('span');
            keyBadge.className = 'absolute top-2 left-2 text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400';
            keyBadge.textContent = (oIdx + 1);
            optBtn.appendChild(keyBadge);

            if (opt.svgContent) {
              var svgHolder = document.createElement('div');
              svgHolder.className = 'w-full flex items-center justify-center pointer-events-none py-1';
              svgHolder.innerHTML = opt.svgContent;
              optBtn.appendChild(svgHolder);
            } else if (opt.text) {
              var textHolder = document.createElement('span');
              textHolder.className = 'font-mono text-base sm:text-lg font-bold py-2';
              textHolder.textContent = opt.text;
              optBtn.appendChild(textHolder);
            }

            optBtn.addEventListener('click', function () {
              selectOption(q.id, opt.id);
            });

            optionsGrid.appendChild(optBtn);
          });
        }

        // Tally of answered
        var totalAnswered = Object.keys(userAnswers).length;
        if (answeredCount) answeredCount.textContent = totalAnswered;

        // Button states
        if (btnPrev) btnPrev.disabled = (currentIndex === 0);
        if (btnNextText) {
          btnNextText.textContent = (currentIndex === questions.length - 1) ? 'Finalizar' : 'Próxima';
        }

        renderNavigator();
      }

      function selectOption(qId, optId) {
        userAnswers[qId] = optId;
        saveSession();
        renderQuestion();

        if (srAnnouncer) {
          srAnnouncer.textContent = 'Opção selecionada para a questão ' + (currentIndex + 1);
        }

        // Auto-advance with debounce
        if (autoAdvanceTimer) clearTimeout(autoAdvanceTimer);
        if (currentIndex < questions.length - 1) {
          autoAdvanceTimer = setTimeout(function () {
            currentIndex++;
            renderQuestion();
            saveSession();
          }, 240);
        }
      }

      // Keyboard navigation
      document.addEventListener('keydown', function (e) {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

        if (e.key === 'ArrowRight' || e.key === 'PageDown') {
          if (currentIndex < questions.length - 1) {
            currentIndex++;
            renderQuestion();
            saveSession();
          }
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
          if (currentIndex > 0) {
            currentIndex--;
            renderQuestion();
            saveSession();
          }
        } else if (e.key >= '1' && e.key <= '6') {
          var num = parseInt(e.key, 10);
          var q = questions[currentIndex];
          if (q && q.options && q.options[num - 1]) {
            selectOption(q.id, q.options[num - 1].id);
          }
        }
      });

      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          if (currentIndex > 0) {
            currentIndex--;
            renderQuestion();
            saveSession();
          }
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', function () {
          if (currentIndex < questions.length - 1) {
            currentIndex++;
            renderQuestion();
            saveSession();
          } else {
            promptSubmit();
          }
        });
      }

      if (btnTopSubmit) {
        btnTopSubmit.addEventListener('click', function () {
          promptSubmit();
        });
      }

      function promptSubmit() {
        var answered = Object.keys(userAnswers).length;
        var total = questions.length;
        if (modalSubmitBody) {
          if (answered < total) {
            var diff = total - answered;
            modalSubmitBody.textContent = 'Você respondeu a ' + answered + ' de ' + total + ' questões (' + diff + ' pendente' + (diff > 1 ? 's' : '') + '). Deseja finalizar mesmo assim?';
          } else {
            modalSubmitBody.textContent = 'Você respondeu a todas as 24 questões. Deseja calcular seu QI agora?';
          }
        }
        if (modalSubmit) modalSubmit.classList.remove('hidden');
      }

      if (modalSubmitCancel) {
        modalSubmitCancel.addEventListener('click', function () {
          if (modalSubmit) modalSubmit.classList.add('hidden');
        });
      }

      if (modalSubmitConfirm) {
        modalSubmitConfirm.addEventListener('click', function () {
          if (modalSubmit) modalSubmit.classList.add('hidden');
          submitTestImmediately();
        });
      }

      if (modalTimeoutConfirm) {
        modalTimeoutConfirm.addEventListener('click', function () {
          if (modalTimeout) modalTimeout.classList.add('hidden');
          submitTestImmediately();
        });
      }

      // Exit Modal
      if (btnExit) {
        btnExit.addEventListener('click', function () {
          if (modalExit) modalExit.classList.remove('hidden');
        });
      }

      if (modalExitCancel) {
        modalExitCancel.addEventListener('click', function () {
          if (modalExit) modalExit.classList.add('hidden');
        });
      }

      if (modalExitConfirm) {
        modalExitConfirm.addEventListener('click', function () {
          try {
            localStorage.removeItem(STORAGE_KEY_SESSION);
          } catch (e) {}
          window.location.href = '/pt-br/';
        });
      }

      // 2PL IRT Scoring Engine (Client Evaluation)
      function calculateIrtScore() {
        var theta = 0.0;
        var maxIter = 40;
        var convCriteria = 0.001;

        for (var iter = 0; iter < maxIter; iter++) {
          var firstDeriv = 0.0;
          var secondDeriv = 0.0;

          questions.forEach(function (q) {
            var ans = userAnswers[q.id];
            var correctId = (SCORING_KEY[q.id] && SCORING_KEY[q.id].c) || 1;
            var isCorrect = (ans === correctId) ? 1 : 0;

            var a = q.a || 1.2;
            var b = q.b || 0.0;
            var expVal = Math.exp(-a * (theta - b));
            var p = 1.0 / (1.0 + expVal);
            var qProb = 1.0 - p;

            firstDeriv += a * (isCorrect - p);
            secondDeriv -= (a * a) * p * qProb;
          });

          // Prior normal N(0, 1) regularizer
          firstDeriv -= theta;
          secondDeriv -= 1.0;

          var delta = firstDeriv / (Math.abs(secondDeriv) > 0.0001 ? secondDeriv : -1.0);
          theta = theta - delta;

          if (Math.abs(delta) < convCriteria) break;
        }

        // Clamp theta to [-3.5, +3.5]
        theta = Math.max(-3.5, Math.min(3.5, theta));

        // Standard Wechsler Scaling (Mean 100, SD 15)
        var iq = Math.round(100 + (theta * 15));
        iq = Math.max(65, Math.min(155, iq));

        // Standard Error of Measurement (SEM)
        var info = 0.0;
        questions.forEach(function (q) {
          var a = q.a || 1.2;
          var b = q.b || 0.0;
          var p = 1.0 / (1.0 + Math.exp(-a * (theta - b)));
          info += (a * a) * p * (1.0 - p);
        });
        info += 1.0; // prior
        var semTheta = 1.0 / Math.sqrt(Math.max(0.1, info));
        var semIq = Math.round(semTheta * 15);

        // Percentile from normal CDF
        function normalCdf(z) {
          var t = 1.0 / (1.0 + 0.2316419 * Math.abs(z));
          var d = 0.3989423 * Math.exp(-z * z / 2.0);
          var prob = d * t * (0.3193815 + t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));
          if (z > 0) prob = 1.0 - prob;
          return (1.0 - prob) * 100.0;
        }

        var percentile = Math.round(normalCdf(theta) * 10) / 10;
        percentile = Math.max(0.1, Math.min(99.9, percentile));

        // Domain breakdowns
        var domains = ['fluid', 'spatial', 'quantitative', 'verbal'];
        var domainStats = {};
        domains.forEach(function (d) {
          var domQuestions = questions.filter(function (q) { return q.domain === d; });
          var correct = 0;
          domQuestions.forEach(function (q) {
            var ans = userAnswers[q.id];
            var cId = (SCORING_KEY[q.id] && SCORING_KEY[q.id].c) || 1;
            if (ans === cId) correct++;
          });
          var pct = domQuestions.length > 0 ? Math.round((correct / domQuestions.length) * 100) : 0;
          domainStats[d] = {
            correct: correct,
            total: domQuestions.length,
            pct: pct
          };
        });

        return {
          iq: iq,
          theta: theta,
          semIq: semIq,
          percentile: percentile,
          domainStats: domainStats,
          totalQuestions: questions.length,
          answeredQuestions: Object.keys(userAnswers).length,
          elapsedSeconds: Math.round((Date.now() - startTimeMs) / 1000)
        };
      }

      function submitTestImmediately() {
        if (timerInterval) clearInterval(timerInterval);
        var scoreData = calculateIrtScore();

        // Save results to localStorage for viewing/retrieval
        try {
          localStorage.setItem('pt_br_iq_last_result', JSON.stringify(scoreData));
          localStorage.removeItem(STORAGE_KEY_SESSION);
        } catch (e) {}

        // Render Results View dynamically in place
        renderResultsView(scoreData);
      }

      function renderResultsView(res) {
        var mainEl = document.querySelector('main');
        if (!mainEl) return;

        // Classification
        var classification = 'Inteligência Média';
        var classColor = 'text-blue-500';
        if (res.iq >= 130) {
          classification = 'Superdotação / Altas Habilidades (Faixa Mensa)';
          classColor = 'text-purple-400';
        } else if (res.iq >= 120) {
          classification = 'Inteligência Superior';
          classColor = 'text-emerald-400';
        } else if (res.iq >= 110) {
          classification = 'Média Superior';
          classColor = 'text-cyan-400';
        } else if (res.iq >= 90) {
          classification = 'Inteligência Média';
          classColor = 'text-blue-400';
        } else if (res.iq >= 80) {
          classification = 'Média Inferior';
          classColor = 'text-amber-400';
        } else {
          classification = 'Faixa Limítrofe';
          classColor = 'text-rose-400';
        }

        var html = '<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">';

        // Result Card
        html += '<div class="rounded-3xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 sm:p-10 shadow-xl text-center space-y-8">';
        
        html += '<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-bold uppercase tracking-wider">';
        html += '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Avaliação Psicométrica Concluída';
        html += '</div>';

        html += '<div>';
        html += '<span class="text-xs font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400 block mb-2">Seu Quociente de Inteligência Estimado</span>';
        html += '<div class="font-heading font-black text-6xl sm:text-8xl text-zinc-950 dark:text-white tracking-tight leading-none">' + res.iq + '</div>';
        html += '<p class="text-lg sm:text-xl font-bold ' + classColor + ' mt-3">' + classification + '</p>';
        html += '<p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-1">Escala Wechsler (Média = 100, DP = 15) &bull; Intervalo 95%: ' + (res.iq - res.semIq) + ' – ' + (res.iq + res.semIq) + '</p>';
        html += '</div>';

        // Key stats grid
        html += '<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto text-left">';
        html += '<div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">';
        html += '<span class="text-xs font-mono text-zinc-500 uppercase block mb-1">Percentil Populacional</span>';
        html += '<div class="font-mono font-bold text-2xl text-zinc-950 dark:text-white">' + res.percentile + 'º</div>';
        html += '<p class="text-[11px] text-zinc-500 mt-1">Superior a ' + res.percentile + '% da população</p>';
        html += '</div>';

        html += '<div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">';
        html += '<span class="text-xs font-mono text-zinc-500 uppercase block mb-1">Precisão do Modelo</span>';
        html += '<div class="font-mono font-bold text-2xl text-zinc-950 dark:text-white">&plusmn;' + res.semIq + ' QI</div>';
        html += '<p class="text-[11px] text-zinc-500 mt-1">Erro padrão de medição (TRI)</p>';
        html += '</div>';

        html += '<div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">';
        html += '<span class="text-xs font-mono text-zinc-500 uppercase block mb-1">Tempo Total</span>';
        var elapsedM = Math.floor(res.elapsedSeconds / 60);
        var elapsedS = res.elapsedSeconds % 60;
        html += '<div class="font-mono font-bold text-2xl text-zinc-950 dark:text-white">' + elapsedM + 'm ' + (elapsedS < 10 ? '0' : '') + elapsedS + 's</div>';
        html += '<p class="text-[11px] text-zinc-500 mt-1">24 itens processados</p>';
        html += '</div>';
        html += '</div>';

        // CHC Domains breakdown
        html += '<div class="pt-6 border-t border-zinc-200 dark:border-zinc-800 text-left max-w-2xl mx-auto space-y-4">';
        html += '<h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white">Perfil Cognitivo por Domínio (CHC)</h3>';
        
        var dKeys = ['fluid', 'spatial', 'quantitative', 'verbal'];
        dKeys.forEach(function (dk) {
          var dInfo = DOMAIN_LABELS[dk];
          var stat = res.domainStats[dk] || { correct: 0, total: 6, pct: 0 };
          html += '<div class="space-y-1.5">';
          html += '<div class="flex justify-between text-xs font-mono font-semibold">';
          html += '<span class="text-zinc-800 dark:text-zinc-200">' + dInfo.label + ' <span class="text-zinc-400 font-normal">(' + stat.correct + '/' + stat.total + ')</span></span>';
          html += '<span class="text-[#0066cc] dark:text-[#2997ff]">' + stat.pct + '%</span>';
          html += '</div>';
          html += '<div class="w-full bg-zinc-200 dark:bg-zinc-800 h-2 rounded-full overflow-hidden">';
          html += '<div class="bg-[#0066cc] dark:bg-[#2997ff] h-full rounded-full transition-all duration-500" style="width: ' + stat.pct + '%;"></div>';
          html += '</div>';
          html += '</div>';
        });
        html += '</div>';

        // Actions
        html += '<div class="flex flex-wrap items-center justify-center gap-4 pt-6 border-t border-zinc-200 dark:border-zinc-800">';
        html += '<button type="button" onclick="window.location.reload()" class="px-6 py-3 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white font-semibold text-sm transition-all hover:opacity-95 active:scale-[0.97] cursor-pointer">Refazer Teste</button>';
        html += '<a href="/pt-br/" class="px-6 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 font-semibold text-sm border border-zinc-300 dark:border-zinc-700 transition-all hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97]">Voltar ao Hub Brasil</a>';
        html += '</div>';

        html += '</div>'; // end Result Card
        html += '</div>'; // end container

        mainEl.innerHTML = html;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      // Initialize
      startTimer();
      renderQuestion();

    })();
  </script>
</Layout>
