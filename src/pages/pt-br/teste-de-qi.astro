---
import Layout from '../../layouts/Layout.astro';
import { getStandardTestSet } from '../../data/questions';

const title = "Teste de QI Grátis Online: Teste de Inteligência com 24 Questões | FreeIQExam";
const description = "Faça o teste de QI online gratuito com 24 questões de matriz lógica. Avaliação psicométrica com curva de percentil e relatório de perfil cognitivo instantâneo.";
const canonicalUrl = "https://freeiqexam.com/pt-br/teste-de-qi";

const alternates = {
  en: "https://freeiqexam.com/test",
  ru: "https://freeiqexam.com/ru/test",
  id: "https://freeiqexam.com/id/tes",
  fi: "https://freeiqexam.com/fi/alykkyystesti",
  de: "https://freeiqexam.com/de/iq-test",
  'pt-BR': "https://freeiqexam.com/pt-br/teste-de-qi"
};

// Sample 24 items (6 per CHC domain) on the server.
const selectedItems = getStandardTestSet();

const sanitizedBank = selectedItems.map((q) => ({
  id: q.id,
  domain: q.domain,
  subType: q.subType,
  domainLabel: q.domainLabel,
  promptType: q.promptType,
  promptText: q.promptText,
  promptSvg: q.promptSvg ?? null,
  a: q.a,
  b: q.b,
  options: q.options.map((opt) => ({
    id: opt.id,
    text: opt.text ?? '',
    svgContent: opt.svgContent ?? null,
  })),
}));

const bankJson = JSON.stringify(sanitizedBank);

// Obfuscated scoring answer key token: questionId -> { c: correctOptionId, exp: explanation }
const answerKeyToken = Buffer.from(
  JSON.stringify(
    selectedItems.reduce((acc, q) => {
      const correctOpt = q.options.find((o) => o.isCorrect);
      acc[q.id] = {
        c: correctOpt ? correctOpt.id : 1,
        exp: q.explanation || '',
      };
      return acc;
    }, {} as Record<number, { c: number; exp: string }>)
  )
).toString('base64');

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Teste de QI Online Gratuito: 24 Questões, 20 Minutos",
    "description": "Avaliação cognitiva padronizada de 24 itens baseada no modelo logístico de 2 parâmetros (2PL) da Teoria de Resposta ao Item. Avalia raciocínio fluido (Gf), processamento visuoespacial (Gv), raciocínio quantitativo (Gq) e compreensão verbal (Gc).",
    "url": "https://freeiqexam.com/pt-br/teste-de-qi",
    "inLanguage": "pt-BR",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "about": {
      "@type": "Thing",
      "name": "Quociente de Inteligência (QI)"
    },
    "timeRequired": "PT20M",
    "numberOfQuestions": 24
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Teste de QI Online Gratuito",
    "url": "https://freeiqexam.com/pt-br/teste-de-qi",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "BRL"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Início",
        "item": "https://freeiqexam.com/pt-br/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Teste de QI Gratuito",
        "item": "https://freeiqexam.com/pt-br/teste-de-qi"
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema} lang="pt-BR">
  <!-- Distraction-Free Top Navigation Bar -->
  <header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-white/95 dark:bg-black/90 border-b border-zinc-200 dark:border-zinc-800 transition-colors duration-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">

      <!-- Brand / Exit Trigger -->
      <button
        id="btn-exit"
        type="button"
        class="flex items-center gap-2.5 group text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black rounded-xl p-1.5 -ml-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        aria-label="Sair do teste"
      >
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] flex items-center justify-center text-white font-bold text-base shadow-xs transition-opacity group-hover:opacity-90">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-base sm:text-lg tracking-tight text-zinc-950 dark:text-white leading-tight">
            FreeIQ<span class="text-[#0066cc] dark:text-[#2997ff]">Exam</span>
          </span>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Sair do teste</span>
        </div>
      </button>

      <!-- Center: Live Countdown Timer and Item Counter -->
      <div class="flex items-center gap-3 sm:gap-6">
        <div
          id="timer-container"
          class="flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors duration-300"
          role="timer"
          aria-live="polite"
        >
          <svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="timer-display" class="font-mono text-sm sm:text-base font-medium tracking-tight text-zinc-800 dark:text-zinc-200">
            20:00
          </span>
        </div>

        <!-- Question Counter Badge -->
        <div class="hidden sm:flex items-center gap-1 text-sm font-medium text-zinc-500 dark:text-zinc-400">
          <span>Questão</span>
          <span id="stat-current" class="font-bold text-zinc-900 dark:text-white">1</span>
          <span>/</span>
          <span class="font-semibold text-zinc-900 dark:text-white">24</span>
        </div>
      </div>

      <!-- Right: Finish Action -->
      <div class="flex items-center gap-2">
        <button
          id="btn-top-submit"
          type="button"
          class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black min-h-[44px] flex items-center cursor-pointer active:scale-[0.97]"
        >
          Finalizar Teste
        </button>
      </div>

    </div>
  </header>

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

      <!-- Storage warning banner (hidden by default) -->
      <div id="storage-warning-banner" class="hidden mb-6 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-200 text-xs sm:text-sm">
        <strong>Aviso:</strong> O armazenamento local do navegador está desativado. Seu progresso não poderá ser restaurado caso a página seja recarregada.
      </div>

      <!-- Live Assessment Card -->
      <div class="rounded-3xl bg-zinc-50/90 dark:bg-zinc-950/80 border border-zinc-200 dark:border-zinc-800 shadow-sm overflow-hidden p-6 sm:p-10 mb-10">

        <!-- Header of Card: Category Badge & Mobile Counter -->
        <div class="flex items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="domain-badge" class="px-3 py-1 rounded-full bg-[#0066cc]/10 dark:bg-[#2997ff]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-mono font-bold tracking-wide uppercase">
              Raciocínio Fluido
            </span>
            <span id="domain-category" class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              Indução Abstrata (Gf)
            </span>
          </div>

          <div class="sm:hidden text-xs font-mono font-bold text-zinc-600 dark:text-zinc-400">
            Questão <span id="mobile-q-num">1</span> / 24
          </div>
        </div>

        <!-- Question Prompt Heading -->
        <div class="mb-6 text-center sm:text-left">
          <h1 id="question-prompt-text" class="text-lg sm:text-xl font-medium text-zinc-800 dark:text-zinc-200 leading-relaxed max-w-2xl mx-auto text-left sm:text-center">
            Selecione a opção que completa logicamente a matriz:
          </h1>
        </div>

        <!-- Stimulus Container (Matrix SVG or Diagram) -->
        <div id="stimulus-card" class="mb-8 p-4 sm:p-8 rounded-2xl bg-white dark:bg-[#0a0a0c] border border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-center min-h-[220px] sm:min-h-[280px]">
          <div id="stimulus-container" class="w-full flex items-center justify-center">
            <!-- Rendered SVG stimulus injected dynamically -->
          </div>
        </div>

        <!-- Multiple Choice Options Grid -->
        <div class="mb-8">
          <div id="options-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
            <!-- Option buttons injected dynamically -->
          </div>
        </div>

        <!-- Keyboard hint & Answered tally -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400 pt-4 border-t border-zinc-200/80 dark:border-zinc-800">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
            </svg>
            <span>Teclas 1–<span id="opt-count-hint">6</span> para selecionar &bull; Setas para navegar</span>
          </div>
          <div>
            Respondidas: <span id="answered-count" class="font-bold text-zinc-900 dark:text-white">0</span> / 24
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-1.5 mt-6 overflow-hidden">
          <div id="progress-bar" class="bg-[#0066cc] dark:bg-[#2997ff] h-1.5 rounded-full transition-all duration-300" style="width: 4.16%;"></div>
        </div>

        <!-- Item Navigator Strip -->
        <div class="mt-6 pt-6 border-t border-zinc-200/80 dark:border-zinc-800">
          <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3 text-center sm:text-left">
            Visão geral das questões:
          </div>
          <div id="navigator-strip" class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-thin">
            <!-- 24 numbered pills injected dynamically -->
          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="flex items-center justify-between gap-4 mt-8 pt-6 border-t border-zinc-200/80 dark:border-zinc-800">
          <button
            id="btn-prev"
            type="button"
            disabled
            class="px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all disabled:opacity-40 disabled:pointer-events-none min-h-[44px] flex items-center gap-2 active:scale-[0.97] cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            Anterior
          </button>

          <button
            id="btn-next"
            type="button"
            class="px-6 py-2.5 rounded-xl bg-[#0066cc] dark:bg-[#2997ff] text-white font-semibold text-sm transition-all hover:opacity-95 active:scale-[0.97] min-h-[44px] flex items-center gap-2 shadow-xs cursor-pointer"
          >
            <span id="btn-next-text">Próxima</span>
            <svg id="btn-next-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>

      </div>

      <!-- Screen reader announcer -->
      <div id="sr-announcer" class="sr-only" aria-live="polite"></div>

      <!-- Educational Content Section (6 Portuguese H2 Sections) -->
      <article class="prose prose-zinc dark:prose-invert max-w-none border-t border-zinc-200 dark:border-zinc-800 pt-16 space-y-16">

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 1 &bull; Fundamentos Psicométricos
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            O Modelo Cattell-Horn-Carroll (CHC) da Inteligência
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            A psicometria contemporânea baseia-se no modelo hierárquico CHC, que organiza as habilidades cognitivas humanas em três estratos: o fator geral (<em>g</em>), amplas áreas cognitivas e habilidades primárias específicas. Nosso teste de 24 itens avalia quatro dos domínios com maior validade preditiva:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose mt-4">
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Raciocínio Fluido (Gf)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Capacidade de resolver problemas inéditos por meio de inferência indutiva e dedutiva, sem depender de conhecimentos prévios.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Processamento Visuoespacial (Gv)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Rotação mental, visualização de dobraduras e transformação de figuras geométricas no espaço bidimensional e tridimensional.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Raciocínio Quantitativo (Gq)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Identificação de sequências numéricas, proporções e regularidades em padrões matemáticos formais.</p>
            </div>
            <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800">
              <div class="font-bold text-sm text-zinc-950 dark:text-white mb-1">Compreensão Verbal (Gc)</div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">Relações lógicas entre conceitos, analogias abstratas e estruturação semântica do raciocínio.</p>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 2 &bull; Metodologia Estatística
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Teoria de Resposta ao Item (TRI 2PL): Escalonamento Científico
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            A Teoria Clássica dos Testes limita-se a somar o número de acertos, tratando questões fáceis e difíceis com o mesmo peso. O FreeIQExam implementa o modelo logístico de 2 parâmetros (2PL) da Teoria de Resposta ao Item:
          </p>
          <div class="p-5 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-sm text-zinc-800 dark:text-zinc-200 not-prose text-center">
            P(θ) = 1 / (1 + e<sup>-a(θ - b)</sup>)
          </div>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Nessa formulação, <em>b</em> representa a dificuldade do item, <em>a</em> indica o poder de discriminação e <em>&theta;</em> é o nível latente de habilidade cognitiva. O algoritmo calcula também o erro padrão de medição (SEM), gerando um intervalo de confiança de 95% estatisticamente consistente.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 3 &bull; Padronização &amp; Escala Wechsler
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            A Escala Padrão de QI: Distribuição Normal (Desvio-Padrão 15)
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            O Quociente de Inteligência é uma métrica padronizada. Na escala de Wechsler (a mais utilizada mundialmente), a média populacional é fixada em 100 com desvio-padrão (&sigma;) de 15:
          </p>
          <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-300">
            <li><strong>QI 70–84:</strong> Faixa limítrofe inferior (~14% da população)</li>
            <li><strong>QI 85–114:</strong> Faixa média (~68% da população)</li>
            <li><strong>QI 115–129:</strong> Inteligência acima da média (~14% da população)</li>
            <li><strong>QI 130+:</strong> Altas habilidades / Superdotação &ndash; critério de admissão da Mensa (top 2%, percentil 98)</li>
          </ul>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 4 &bull; Imparcialidade Cultural
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Matrizes Progressivas &amp; Testes Culture-Fair
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Para minimizar vieses linguísticos, educacionais e socioculturais, a maior parte da avaliação é composta por matrizes lógicas visuais inspiradas nos modelos de Raven e Cattell Culture Fair. Esses desafios avaliam a velocidade de processamento e a abstração relacional pura do cérebro.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 5 &bull; Condições de Aplicação
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Tempo Limite de 20 Minutos &amp; Eficiência Cognitiva
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            O limite de 20 minutos (média de 50 segundos por questão) mede a eficiência cognitiva sob pressão de tempo. Você pode pular questões mais difíceis e retornar a elas a qualquer momento por meio do painel de navegação inferior.
          </p>
        </section>

        <section class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-xs font-mono font-semibold text-[#0066cc] dark:text-[#2997ff] uppercase tracking-wider">
            Seção 6 &bull; Relatório
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Interpretação de Resultados &amp; Perfil Cognitivo
          </h2>
          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
            Ao concluir o teste, você recebe um relatório detalhado com sua pontuação global de QI, classificação percentil, intervalo de confiança e a distribuição de suas forças relativas em raciocínio fluido, visuoespacial, quantitativo e verbal.
          </p>
        </section>

      </article>

      <!-- FAQ Accordion Section (Visible HTML Accordions only, zero FAQPage schema) -->
      <section class="mt-16 pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-600 dark:text-zinc-400 uppercase tracking-wider mb-2">
            Perguntas Frequentes
          </div>
          <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
            Dúvidas frequentes sobre o Teste de QI Online
          </h2>
        </div>

        <div class="space-y-3">
          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Quanto tempo dura o teste de QI gratuito?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              O teste contém 24 questões e possui um tempo limite de 20 minutos. Se terminar antes, você pode submeter suas respostas para visualização imediata do relatório.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>O resultado do teste tem validade científica?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              O teste utiliza modelos psicométricos consagrados (Teoria de Resposta ao Item 2PL) e a estrutura CHC, oferecendo uma autoavaliação confiável e padronizada das capacidades cognitivas no ambiente online.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>O que significa uma pontuação de QI de 100, 115 ou 130?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Um QI de 100 representa a média exata da população (percentil 50). Uma pontuação de 115 está 1 desvio-padrão acima da média (percentil ~84), e 130 marca o limiar de altas habilidades cognitivas (percentil 98).
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Minhas respostas ou dados pessoais são armazenados?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Não. O processamento das respostas e o cálculo das pontuações ocorrem 100% no seu navegador. Nenhuma informação pessoal ou endereço de e-mail é solicitado.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Por que o teste utiliza exatamente 24 questões?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Vinte e quatro itens proporcionam o equilíbrio ideal entre confiabilidade psicométrica (&alpha; &gt; 0.85) e economia de tempo (20 minutos), prevenindo fadiga mental durante a avaliação.
            </p>
          </details>

          <details class="group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between font-bold text-zinc-950 dark:text-white cursor-pointer select-none text-sm sm:text-base">
              <span>Qual é a diferença entre este teste e uma bateria clínica presencial?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform duration-200">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-200 dark:border-zinc-800/80 pt-3">
              Testes clínicos completos (como o WAIS-IV) levam várias horas, são aplicados presencialmente por neuropsicólogos e abrangem subtestes auditivos e motores. Nosso teste é uma triagem padronizada digital para autoavaliação.
            </p>
          </details>
        </div>
      </section>

    </div>
  </main>

