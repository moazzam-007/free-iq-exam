---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Reaction Time Test Online - Test Your Reflexes (ms) | FreeIQExam';
const description =
  'Measure your visual reaction speed in milliseconds with a free five-trial reaction time test. Get an instant average, percentile estimate, personal best, and reflex tier with no signup.';
const canonicalUrl = 'https://freeiqexam.com/reaction-time-test';

const alternates: Record<string, string> = {};

const faqItems = [
  {
    name: 'What is a good score on an online reaction time test?',
    answer:
      'For a simple visual reaction task, many healthy adults fall around the mid-200 millisecond range, although the exact value varies by protocol, device, and population. On FreeIQExam, scores below about 220 ms are presented as faster than the reference distribution used by the percentile model, while very low scores should be treated as an exceptional performance rather than a clinical measurement.'
  },
  {
    name: 'Why is my reaction time significantly slower on a smartphone than on a PC?',
    answer:
      'A phone can add latency through the display refresh cycle, touchscreen digitizer, operating-system processing, browser scheduling, and touch-to-paint pipeline. A desktop with a high-refresh display and low-latency wired mouse usually has a shorter and more predictable input path. The size of the difference varies substantially by device and browser, so there is no universal 40–75 ms penalty.'
  },
  {
    name: 'What is the absolute biological limit of human reaction speed?',
    answer:
      'There is no single universal biological limit because reaction time depends on the sensory modality, stimulus, response, and measurement method. Auditory simple reaction times can be near or below 150 ms in trained or laboratory settings, while simple visual reactions are commonly slower. Extremely short values can reflect anticipation, measurement artifacts, or a very different task definition.'
  },
  {
    name: 'How does the reaction time of professional gamers compare to non-gamers?',
    answer:
      'Competitive gamers often show faster average responses on simple visual tasks than non-gamers, but the gap varies across studies and tasks. Training can improve attention, visual search, response selection, and motor preparation; it does not simply make every nerve conduct impulses faster.'
  },
  {
    name: 'Why do humans react faster to sudden sound than to sudden light?',
    answer:
      'Auditory signals generally reach awareness and initiate a motor response faster than visual signals because the auditory transduction and early neural pathway can be faster for simple stimuli. Vision adds retinal phototransduction and additional cortical processing before the motor response is selected.'
  },
  {
    name: 'How much can a 144Hz or 240Hz gaming monitor improve my test score?',
    answer:
      'Higher refresh rates reduce the time between available display frames: about 16.67 ms at 60 Hz, 6.94 ms at 144 Hz, and 4.17 ms at 240 Hz. That reduces one component of presentation uncertainty, but it does not subtract the full difference from every user score because the actual pipeline includes rendering, scan-out, input, and operating-system latency.'
  },
  {
    name: 'What is considered a normal reaction time for a 50-year-old?',
    answer:
      'There is no single clinical cutoff for a normal 50-year-old reaction time. Reaction speed generally changes gradually with age, and a healthy individual result is influenced by vision, sleep, medication, device latency, practice, and the test protocol. Comparing your repeated scores under the same conditions is more useful than treating one internet benchmark as a diagnosis.'
  },
  {
    name: 'Can visual reaction time be permanently trained and improved?',
    answer:
      'Yes, some components of performance can improve with practice, especially attention, stimulus detection, response preparation, and task familiarity. Gains are usually task-specific and are bounded by physiology. Consistent sleep, physical activity, good visual conditions, and repeated practice under the same protocol are more defensible strategies than chasing a single extreme score.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'Free Visual Reaction Time Test',
    url: canonicalUrl,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    browserRequirements:
      'Requires JavaScript, Performance API, Pointer Events, and HTML5 support',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    description:
      'A five-trial browser-based visual reaction time benchmark that reports millisecond response speed and a model-based population percentile estimate.',
    isAccessibleForFree: true,
    creator: {
      '@type': 'Organization',
      name: 'FreeIQExam',
      url: 'https://freeiqexam.com'
    },
    featureList: [
      'Five calibrated visual reaction trials',
      'Pointerdown and keyboard input',
      'Client-side personal best storage',
      'Model-based population percentile estimate',
      'Synthesized optional sound cues',
      'Score sharing via clipboard'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://freeiqexam.com/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cognitive Games',
        item: 'https://freeiqexam.com/games'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Reaction Time Test',
        item: canonicalUrl
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Five-Trial Visual Reaction Time Benchmark',
    url: canonicalUrl,
    description:
      'A simple reaction-time task in which the participant responds when the arena changes from red to green.',
    numberOfQuestions: 5,
    educationalAlignment: {
      '@type': 'AlignmentObject',
      alignmentType: 'educationalSubject',
      targetName:
        'Perceptual speed and sensorimotor response latency'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.name,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  schema={schema}
>
  <Header />

  <style>
    .reaction-page {
      --reaction-border: #e4e4e7;
      --reaction-muted: #52525b;
      background: #ffffff;
    }

    .dark .reaction-page {
      --reaction-border: #27272a;
      --reaction-muted: #a1a1aa;
      background: #000000;
    }

    .reaction-arena {
      touch-action: manipulation;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
      transition:
        transform 90ms ease-out,
        background 120ms ease-out;
    }

    .reaction-arena:active {
      transform: scale(0.997);
    }

    .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #2563eb 0%,
          #1d4ed8 62%,
          #1e40af 100%
        );
    }

    .dark .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #1d4ed8 0%,
          #0f172a 70%,
          #09090b 100%
        );
    }

    .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #e11d48 0%,
          #be123c 62%,
          #9f1239 100%
        );
    }

    .dark .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #be123c 0%,
          #881337 68%,
          #4c0519 100%
        );
    }

    .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #059669 62%,
          #047857 100%
        );
    }

    .dark .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #047857 68%,
          #064e3b 100%
        );
    }

    .state-toosoon {
      background:
        radial-gradient(
          circle at 50% 25%,
          #f97316 0%,
          #ea580c 65%,
          #c2410c 100%
        );
    }

    .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #38bdf8 0%,
          #0284c7 65%,
          #0369a1 100%
        );
    }

    .dark .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #0ea5e9 0%,
          #0369a1 68%,
          #082f49 100%
        );
    }

    .state-summary {
      background: #fafafa;
    }

    .dark .state-summary {
      background: #09090b;
    }

    .summary-card {
      background: rgba(255, 255, 255, 0.97);
      border: 1px solid #e4e4e7;
      backdrop-filter: blur(16px);
    }

    .dark .summary-card {
      background: rgba(18, 18, 21, 0.97);
      border-color: #27272a;
    }

    .reaction-copy p {
      max-width: 75ch;
    }

    .reaction-copy table {
      min-width: 760px;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @keyframes reaction-shake {
      10%,
      90% {
        transform: translateX(-2px);
      }

      20%,
      80% {
        transform: translateX(4px);
      }

      30%,
      50%,
      70% {
        transform: translateX(-6px);
      }

      40%,
      60% {
        transform: translateX(6px);
      }
    }

    .animate-reaction-shake {
      animation:
        reaction-shake
        0.4s
        cubic-bezier(.36, .07, .19, .97)
        both;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-reaction-shake {
        animation: none;
      }
    }
  </style>

  <main
    id="main-content"
    class="reaction-page min-h-screen flex-1 w-full"
  >
    <div
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
    >
      <nav
        class="flex items-center gap-2 mb-8 text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400"
        aria-label="Breadcrumb"
      >
        <a
          href="/"
          class="hover:text-zinc-950 dark:hover:text-white transition-colors"
        >
          Home
        </a>

        <span aria-hidden="true">/</span>

        <a
          href="/games"
          class="hover:text-zinc-950 dark:hover:text-white transition-colors"
        >
          Cognitive Games
        </a>

        <span aria-hidden="true">/</span>

        <span class="text-zinc-900 dark:text-zinc-100">
          Reaction Time Test
        </span>
      </nav>

      <header
        class="text-center max-w-3xl mx-auto mb-10 sm:mb-12"
      >
        <div
          class="inline-flex items-center gap-2 rounded-full border border-blue-200 dark:border-blue-900 bg-blue-50 dark:bg-blue-950/40 px-4 py-2 text-xs sm:text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300"
        >
          <span
            class="w-2 h-2 rounded-full bg-blue-600 dark:bg-blue-400 animate-pulse"
            aria-hidden="true"
          ></span>

          <span>
            Perceptual Speed · Gs Chronometrics
          </span>
        </div>

        <h1
          class="mt-5 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight text-zinc-950 dark:text-white"
        >
          Reaction Time Test Online
        </h1>

        <p
          class="mt-5 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300"
        >
          Test your visual reflexes in milliseconds. Wait for the red arena to
          turn green, then click, tap, press Space, or press Enter as quickly
          as you can. Five valid trials produce an average reaction time, a
          model-based percentile estimate, a reflex tier, and a personal-best
          check.
        </p>
      </header>

      <section
        aria-labelledby="arena-heading"
        class="max-w-3xl mx-auto"
      >
        <h2 id="arena-heading" class="sr-only">
          Interactive reaction time test
        </h2>

        <div
          class="flex items-center justify-between gap-4 px-1 mb-4 text-sm sm:text-base"
        >
          <div class="flex items-center gap-2">
            <span
              class="text-zinc-500 dark:text-zinc-400 font-medium"
            >
              TRIAL
            </span>

            <strong
              id="hud-round-counter"
              class="text-zinc-950 dark:text-white"
            >
              0 / 5
            </strong>
          </div>

          <div
            class="flex items-center gap-3 sm:gap-5"
          >
            <div class="flex items-center gap-2">
              <span
                class="text-zinc-500 dark:text-zinc-400 font-medium"
              >
                BEST
              </span>

              <strong
                id="hud-personal-best"
                class="text-emerald-600 dark:text-emerald-400"
              >
                —
              </strong>
            </div>

            <button
              id="btn-sound-toggle"
              type="button"
              aria-pressed="false"
              aria-label="Mute sound effects"
              class="inline-flex items-center gap-2 min-h-[44px] rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-2.5 font-semibold text-zinc-800 dark:text-zinc-200 transition-smooth hover:scale-[1.02] active:scale-[0.98]"
            >
              <span id="sound-icon" aria-hidden="true" class="inline-flex">
                <svg id="sound-icon-on" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
                <svg id="sound-icon-off" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><line x1="23" y1="9" x2="17" y2="15" /><line x1="17" y1="9" x2="23" y2="15" /></svg>
              </span>

              <span id="sound-label">
                Audio
              </span>
            </button>
          </div>
        </div>

        <div
          class="mb-4 flex items-center gap-2"
          aria-label="Trial progress"
        >
          <span
            id="pill-trial-1"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-2"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-3"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-4"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-5"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>
        </div>

        <div
          id="reaction-box"
          role="button"
          tabindex="0"
          aria-label="Reaction time test arena. Click or tap when the arena turns green."
          aria-busy="false"
          class="reaction-arena state-start relative min-h-[430px] sm:min-h-[500px] rounded-[2rem] overflow-hidden cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/40 shadow-2xl"
        >
          <div
            class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_18%,rgba(255,255,255,.18),transparent_34%),radial-gradient(circle_at_50%_100%,rgba(0,0,0,.16),transparent_60%)]"
          ></div>

          <div
            id="content-start"
            class="relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg"
            >
              <svg
                class="w-10 h-10 sm:w-12 sm:h-12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
            </div>

            <div class="space-y-3 max-w-xl">
              <h3
                class="text-3xl sm:text-5xl font-extrabold tracking-tight"
              >
                Click or Tap to Begin
              </h3>

              <p
                class="text-base sm:text-lg leading-relaxed text-white/90"
              >
                Wait for green. Then respond immediately. False starts do not
                count toward your five valid trials.
              </p>
            </div>

            <div
              class="inline-flex flex-wrap items-center justify-center gap-2 rounded-full bg-white/15 border border-white/20 px-5 py-3 text-sm font-semibold"
            >
              <span>Keyboard:</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                SPACE
              </kbd>

              <span>or</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                ENTER
              </kbd>
            </div>
          </div>

          <div
            id="content-waiting"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="flex items-center gap-3"
              aria-hidden="true"
            >
              <span
                class="w-4 h-4 rounded-full bg-white animate-ping"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:150ms]"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:300ms]"
              ></span>
            </div>

            <div>
              <h3
                class="text-4xl sm:text-6xl font-extrabold tracking-tight uppercase"
              >
                Wait for green…
              </h3>

              <p
                class="mt-3 text-base sm:text-lg text-white/85"
              >
                Do not anticipate. Keep the finger ready, but do not press.
              </p>
            </div>
          </div>

          <div
            id="content-active"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="w-20 h-20 rounded-full bg-white/25 border border-white/30 flex items-center justify-center shadow-2xl"
            >
              <svg
                class="w-12 h-12"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>

            <div>
              <h3
                class="text-5xl sm:text-7xl font-extrabold tracking-tight uppercase"
              >
                CLICK NOW!
              </h3>

              <p
                class="mt-3 text-sm sm:text-base font-semibold uppercase tracking-widest text-white/90"
              >
                Tap, click, Space, or Enter
              </p>
            </div>
          </div>

          <div
            id="content-toosoon"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-5 px-6 sm:px-10 text-center text-white animate-reaction-shake"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center"
            >
              <svg
                class="w-10 h-10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3.732 1.732 3z"
                />
              </svg>
            </div>

            <h3
              class="text-4xl sm:text-5xl font-extrabold tracking-tight"
            >
              Too Soon!
            </h3>

            <p
              class="text-base sm:text-lg text-white/90 max-w-xl"
            >
              You clicked while the arena was red. The attempt is discarded and
              this same round will be retried.
            </p>

            <span
              class="rounded-full bg-white px-6 py-3 font-bold text-orange-700 shadow-xl"
            >
              Tap to Retry
            </span>
          </div>

          <div
            id="content-result"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-5 px-6 sm:px-10 text-center text-white"
          >
            <span
              id="result-round-indicator"
              class="rounded-full bg-white/20 px-4 py-2 text-sm font-semibold uppercase tracking-wider"
            >
              ROUND 1 OF 5
            </span>

            <div class="flex items-baseline gap-2">
              <span
                id="round-ms-display"
                class="text-6xl sm:text-8xl font-extrabold tracking-tight"
              >
                250
              </span>

              <span
                class="text-2xl sm:text-3xl font-mono font-bold text-white/80"
              >
                ms
              </span>
            </div>

            <p
              id="round-quick-feedback"
              class="text-base sm:text-lg font-semibold text-white/90"
            >
              Strong visual reaction.
            </p>

            <span
              class="rounded-full bg-white px-7 py-3.5 text-base font-bold text-sky-700 shadow-xl"
            >
              Click to Continue
            </span>
          </div>

          <div
            id="content-summary"
            class="hidden relative z-10 w-full min-h-[430px] sm:min-h-[500px] flex items-center justify-center p-4 sm:p-8"
          >
            <div
              class="summary-card w-full max-w-xl rounded-[2rem] p-6 sm:p-8 text-zinc-900 dark:text-white shadow-2xl"
            >
              <div
                class="mx-auto w-14 h-14 rounded-2xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center"
              >
                <svg
                  class="w-8 h-8"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>

              <h3
                class="mt-4 text-2xl sm:text-3xl font-bold text-center tracking-tight"
              >
                Test Complete
              </h3>

              <p
                class="mt-1 text-base text-zinc-500 dark:text-zinc-400 text-center"
              >
                Five valid trials · average visual reaction time
              </p>

              <div
                class="mt-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 p-5 text-center"
              >
                <p
                  class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400"
                >
                  Average Response
                </p>

                <div
                  class="mt-2 flex items-baseline justify-center gap-2"
                >
                  <span
                    id="final-avg-ms"
                    class="text-6xl sm:text-7xl font-extrabold tracking-tight text-sky-600 dark:text-sky-400"
                  >
                    250
                  </span>

                  <span
