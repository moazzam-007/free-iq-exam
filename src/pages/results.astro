  </main>

  <!-- Client-Side Evaluation and Hydration Script -->
  <script>
    import type { AssessmentResult } from '../utils/scoring';

    interface ReviewOption {
      id: number;
      text?: string;
      svgContent?: string | null;
      isCorrect: boolean;
    }

    interface ReviewItem {
      id: number;
      domain: 'fluid' | 'spatial' | 'quantitative' | 'verbal';
      subType: string;
      promptType: 'text' | 'svg';
      promptText: string;
      promptSvg?: string | null;
      a: number;
      b: number;
      explanation: string;
      options: ReviewOption[];
      selectedOptionId?: number;
      isCorrect: boolean;
    }

    // Static Demo Fixture (Zero Question Bank bundle import required)
    const DEMO_RESULT: AssessmentResult = {
      theta: 1.60,
      sem: 0.28,
      iqEstimate: 124,
      confidenceInterval: [118, 130],
      percentile: 94.5,
      rawScore: 19,
      totalQuestions: 24,
      testType: 'standard',
      domainBreakdown: {
        fluid:        { rawScore: 5, total: 6, theta: 1.55, standardScore: 123, percentile: 94.0 },
        spatial:      { rawScore: 5, total: 6, theta: 1.62, standardScore: 124, percentile: 94.8 },
        quantitative: { rawScore: 5, total: 6, theta: 1.68, standardScore: 125, percentile: 95.3 },
        verbal:       { rawScore: 4, total: 6, theta: 1.45, standardScore: 122, percentile: 92.7 },
      },
    };

    const DEMO_REVIEW_ITEMS: ReviewItem[] = [
      {
        id: 1,
        domain: 'fluid',
        subType: 'matrix_reasoning',
        promptType: 'text',
        promptText: 'Which pattern logically completes the 3x3 matrix following the horizontal clockwise rotation rule?',
        a: 1.45,
        b: -0.42,
        explanation: 'Each row shifts elements by 90 degrees clockwise while inverting color polarity in the final column.',
        selectedOptionId: 3,
        isCorrect: true,
        options: [
          { id: 1, text: 'Option A: Clockwise rotation without inversion', isCorrect: false },
          { id: 2, text: 'Option B: Vertical flip with inversion', isCorrect: false },
          { id: 3, text: 'Option C: 90-degree clockwise rotation with color inversion', isCorrect: true },
          { id: 4, text: 'Option D: 180-degree static inversion', isCorrect: false },
        ],
      },
      {
        id: 2,
        domain: 'spatial',
        subType: 'cube_rotation',
        promptType: 'text',
        promptText: 'If the reference cube is rotated 90 degrees pitch forward and 90 degrees yaw clockwise, which view is displayed?',
        a: 1.52,
        b: 0.15,
        explanation: 'Rotating the cube forward brings the top face to the front, and rotating clockwise shifts the right face to the front.',
        selectedOptionId: 2,
        isCorrect: true,
        options: [
          { id: 1, text: 'Option A: Front square with circle face', isCorrect: false },
          { id: 2, text: 'Option B: Cross on front with triangle on top', isCorrect: true },
          { id: 3, text: 'Option C: Inverted triangle face', isCorrect: false },
          { id: 4, text: 'Option D: Circle face with diagonal cross', isCorrect: false },
        ],
      },
      {
        id: 3,
        domain: 'quantitative',
        subType: 'arithmetic_proportional_deduction',
        promptType: 'text',
        promptText: 'Determine the missing term in the sequence: 3, 7, 16, 35, ?',
        a: 1.38,
        b: 0.78,
        explanation: 'The progression rule is: x_(n+1) = (x_n * 2) + n. For 35: (35 * 2) + 4 = 70 + 4 = 74.',
        selectedOptionId: 1,
        isCorrect: true,
        options: [
          { id: 1, text: '74', isCorrect: true },
          { id: 2, text: '72', isCorrect: false },
          { id: 3, text: '70', isCorrect: false },
          { id: 4, text: '68', isCorrect: false },
        ],
      },
      {
        id: 4,
        domain: 'verbal',
        subType: 'lexical_analogy_deductive_logic',
        promptType: 'text',
        promptText: 'EPHEMERAL is to PERMANENCE as VACILLATING is to:',
        a: 1.65,
        b: 1.12,
        explanation: 'Ephemeral denotes lack of permanence (antonym). Vacillating denotes lack of resolute steadfastness (antonym: Resolution).',
        selectedOptionId: 2,
        isCorrect: false,
        options: [
          { id: 1, text: 'Hesitant', isCorrect: false },
          { id: 2, text: 'Ambiguous', isCorrect: false },
          { id: 3, text: 'Resolution', isCorrect: true },
          { id: 4, text: 'Velocity', isCorrect: false },
        ],
      },
    ];

    let currentCertResult: AssessmentResult | null = null;

    document.addEventListener('DOMContentLoaded', () => {
      // Stamp print date
      const printDateEl = document.getElementById('print-date');
      if (printDateEl) printDateEl.textContent = 'Generated: ' + new Date().toLocaleDateString();

      // --- Read localStorage ---
      const savedResultStr  = localStorage.getItem('iq_assessment_result');
      const savedReviewStr  = localStorage.getItem('iq_review_data');
      const savedTestType   = localStorage.getItem('iq_test_type') as 'quick' | 'standard' | null;
      const demoBanner      = document.getElementById('demo-banner');
      const testTypeBadge   = document.getElementById('test-type-badge');

      let result: AssessmentResult | null = null;
      let reviewItems: ReviewItem[] = [];

      if (savedResultStr) {
        try { result = JSON.parse(savedResultStr); } catch (e) {}
      }
      if (savedReviewStr) {
        try { reviewItems = JSON.parse(savedReviewStr); } catch (e) {}
      }

      const isDemo = !result;

      if (isDemo) {
        if (demoBanner) demoBanner.classList.remove('hidden');
        result = DEMO_RESULT;
        reviewItems = DEMO_REVIEW_ITEMS;
      }

      currentCertResult = result;

      const testType: 'quick' | 'standard' = result.testType ?? savedTestType ?? 'standard';

      // Test type badge
      if (testTypeBadge) {
        testTypeBadge.textContent = testType === 'quick'
          ? 'Quick Screening - 12 Items (CHC Multi-Domain)'
          : 'Full Assessment - 24 Items (CHC Multi-Domain)';
      }

      // --- DOM Hydration: Primary Score ---
      const scoreDisplay        = document.getElementById('score-display');
      const ciDisplay           = document.getElementById('ci-display');
      const semDisplay          = document.getElementById('sem-display');
      const percentileDisplay   = document.getElementById('percentile-display');
      const rarityDisplay       = document.getElementById('rarity-display');
      const thetaDisplay        = document.getElementById('theta-display');
      const classificationBadge = document.getElementById('classification-badge');

      // Animate score and percentile reveal
      const targetIq = result.iqEstimate;
      const targetPercentile = result.percentile;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && scoreDisplay) {
        const duration = 1200;
        const startTime = performance.now();
        const startIq = Math.max(60, targetIq - 25);

        function animateScore(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(1, elapsed / duration);
          // easeOutCubic
          const ease = 1 - Math.pow(1 - progress, 3);
          const currentIq = Math.round(startIq + (targetIq - startIq) * ease);
          if (scoreDisplay) scoreDisplay.textContent = String(currentIq);

          if (percentileDisplay) {
            const currentPct = (targetPercentile * ease).toFixed(1);
            percentileDisplay.textContent = `${currentPct}%`;
          }

          if (progress < 1) {
            requestAnimationFrame(animateScore);
          } else {
            if (scoreDisplay) scoreDisplay.textContent = String(targetIq);
            if (percentileDisplay) percentileDisplay.textContent = `${targetPercentile.toFixed(1)}%`;
          }
        }
        requestAnimationFrame(animateScore);
      } else {
        if (scoreDisplay) scoreDisplay.textContent = String(targetIq);
        if (percentileDisplay) percentileDisplay.textContent = `${targetPercentile.toFixed(1)}%`;
      }

      if (ciDisplay) ciDisplay.textContent = `${result.confidenceInterval[0]} - ${result.confidenceInterval[1]}`;
      if (semDisplay) semDisplay.textContent = String((result.sem * 15).toFixed(1));
      const percentileSubtext = document.getElementById('percentile-subtext');
      if (percentileSubtext) percentileSubtext.textContent = 'Exceeds ' + result.percentile.toFixed(1) + '% of test-takers (50% is global average)';
      const guidePct = document.getElementById('guide-dynamic-pct');
      const guideCount = document.getElementById('guide-dynamic-count');
      if (guidePct) guidePct.textContent = result.percentile.toFixed(1) + '%';
      if (guideCount) guideCount.textContent = String(Math.max(1, Math.round(result.percentile)));
      if (thetaDisplay) thetaDisplay.textContent = (result.theta >= 0 ? '+' : '') + result.theta.toFixed(2);

      if (rarityDisplay) {
        const z = (result.iqEstimate - 100) / 15;
        // Standard normal CDF helper for the client script
        function calcNormalCdf(val: number): number {
          const sign = val < 0 ? -1 : 1;
          const x = Math.abs(val) / Math.SQRT2;
          const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429;
          const p = 0.3275911;
          const t = 1.0 / (1.0 + p * x);
          const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
          return 0.5 * (1.0 + sign * y);
        }

        if (z >= 0) {
          const p = Math.max(1e-6, 1.0 - calcNormalCdf(z));
          const rarity = Math.max(2, Math.round(1.0 / p));
          rarityDisplay.textContent = '1 in ' + (rarity >= 10000 ? '10,000+' : rarity.toLocaleString());
        } else {
          const p = Math.max(1e-6, calcNormalCdf(z));
          const rarity = Math.max(2, Math.round(1.0 / p));
          rarityDisplay.textContent = '1 in ' + (rarity >= 10000 ? '10,000+' : rarity.toLocaleString());
        }
      }

      if (classificationBadge) {
        let label = 'Average Ability';
        let cls   = 'bg-zinc-100 text-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 border-zinc-300 dark:border-zinc-700';
        const iq  = result.iqEstimate;
        if (iq >= 145)      { label = 'Profoundly Superior (Top 0.1%)'; cls = 'bg-purple-100 text-purple-900 dark:bg-zinc-900 dark:text-purple-300 border-purple-300 dark:border-zinc-700'; }
        else if (iq >= 130) { label = 'Very Superior (Mensa Threshold / Top 2%)'; cls = 'bg-indigo-100 text-indigo-900 dark:bg-zinc-900 dark:text-blue-400 border-indigo-300 dark:border-zinc-700'; }
        else if (iq >= 120) { label = 'Superior Cognitive Ability'; cls = 'bg-blue-100 text-blue-900 dark:bg-zinc-900 dark:text-blue-400 border-blue-300 dark:border-zinc-700'; }
        else if (iq >= 110) { label = 'High Average Ability'; cls = 'bg-teal-100 text-teal-900 dark:bg-zinc-900 dark:text-teal-300 border-teal-300 dark:border-zinc-700'; }
        else if (iq >= 90)  { label = 'Average Cognitive Ability'; cls = 'bg-zinc-100 text-zinc-800 dark:bg-zinc-900 dark:text-zinc-200 border-zinc-200 dark:border-zinc-700'; }
        else if (iq >= 80)  { label = 'Low Average Ability'; cls = 'bg-amber-100 text-amber-900 dark:bg-zinc-900 dark:text-amber-300 border-amber-300 dark:border-zinc-700'; }
        else                { label = 'Borderline Range'; cls = 'bg-rose-100 text-rose-900 dark:bg-zinc-900 dark:text-rose-300 border-rose-300 dark:border-zinc-700'; }
        classificationBadge.textContent = label;
        classificationBadge.className = 'inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold border ' + cls;
      }

      // --- Domain Performance Cards ---
      function getDomainTier(pct: number): { label: string; cls: string } {
        if (pct >= 83) return { label: 'Strength Area',  cls: 'bg-emerald-100 text-emerald-800 dark:bg-zinc-900 dark:text-emerald-300 border-emerald-200 dark:border-zinc-700' };
        if (pct >= 67) return { label: 'High Average',   cls: 'bg-blue-100 text-blue-800 dark:bg-zinc-900 dark:text-blue-300 border-blue-200 dark:border-zinc-700' };
        if (pct >= 50) return { label: 'Average Range',  cls: 'bg-zinc-100 text-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700' };
        return              { label: 'Developing Area', cls: 'bg-amber-100 text-amber-800 dark:bg-zinc-900 dark:text-amber-300 border-amber-200 dark:border-zinc-700' };
      }

      const domainConfig = [
        { key: 'fluid',        prefix: 'fluid' },
        { key: 'spatial',      prefix: 'spatial' },
        { key: 'quantitative', prefix: 'quantitative' },
        { key: 'verbal',       prefix: 'verbal' },
      ] as const;

      for (const { key, prefix } of domainConfig) {
        const d        = result.domainBreakdown[key];
        const accuracy = d.total > 0 ? (d.rawScore / d.total) * 100 : 0;
        const tier     = getDomainTier(accuracy);

        const rawEl      = document.getElementById(`domain-${prefix}-raw`);
        const accEl      = document.getElementById(`domain-${prefix}-accuracy`);
        const pctBadge   = document.getElementById(`domain-${prefix}-pct-badge`);
        const tierEl     = document.getElementById(`domain-${prefix}-tier`);
        const barEl      = document.getElementById(`domain-${prefix}-bar`);
        const pctEl      = document.getElementById(`domain-${prefix}-pct`);
        const thetaEl    = document.getElementById(`domain-${prefix}-theta`);

        if (rawEl)    rawEl.textContent    = `${d.rawScore} / ${d.total}`;
        if (accEl)    accEl.textContent    = `${d.rawScore} / ${d.total}`;
        if (pctBadge) pctBadge.textContent = `(${accuracy.toFixed(0)}%)`;
        if (tierEl)   { tierEl.textContent = tier.label; tierEl.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ' + tier.cls; }
        if (barEl)    { barEl.style.width  = `${accuracy}%`; }
        if (pctEl)    pctEl.textContent    = `${accuracy.toFixed(0)}% accuracy`;
        if (thetaEl)  thetaEl.textContent  = `theta: ${(d.theta >= 0 ? '+' : '') + d.theta.toFixed(2)}`;
      }

      // --- Bell Curve ---
      renderBellCurve(result.iqEstimate);

      // --- Question Review Accordion ---
      renderReviewAccordion(reviewItems);

      // --- Print Button ---
      const btnPrint = document.getElementById('btn-print');
      if (btnPrint) btnPrint.addEventListener('click', () => window.print());

      // --- Copy Summary ---
      const btnCopy     = document.getElementById('btn-copy-share');
      const btnCopyText = document.getElementById('btn-copy-text');
      if (btnCopy && btnCopyText) {
        btnCopy.addEventListener('click', () => {
          const shareText = `FreeIQExam Assessment Summary\nEstimated Score: ${result.iqEstimate} IQ (SD 15)\n95% Posterior Credible Interval: ${result.confidenceInterval[0]} - ${result.confidenceInterval[1]}\nPercentile: ${result.percentile.toFixed(1)}th\nTest Type: ${result.testType === 'quick' ? 'Quick Screening (12 items)' : 'Full Assessment (24 items)'}\nFRI: ${result.domainBreakdown.fluid.rawScore}/${result.domainBreakdown.fluid.total} | VSI: ${result.domainBreakdown.spatial.rawScore}/${result.domainBreakdown.spatial.total} | QRI: ${result.domainBreakdown.quantitative.rawScore}/${result.domainBreakdown.quantitative.total} | VCI: ${result.domainBreakdown.verbal.rawScore}/${result.domainBreakdown.verbal.total}\nScored via 2PL Item Response Theory at https://freeiqexam.com`;
          navigator.clipboard.writeText(shareText)
            .then(() => {
              btnCopyText.textContent = 'Copied to Clipboard!';
              setTimeout(() => { btnCopyText.textContent = 'Copy Summary'; }, 2500);
            })
            .catch(() => { window.prompt('Copy your score summary:', shareText); });
        });
      }

      // --- Clear session on Retake ---
      function handleRetake(e: Event) {
        e.preventDefault();
        localStorage.removeItem('iq_assessment_answers');
        localStorage.removeItem('iq_active_questions');
        localStorage.removeItem('iq_test_type');
        localStorage.removeItem('iq_assessment_result');
        localStorage.removeItem('iq_review_data');
        localStorage.removeItem('freeiq_active_session');
        localStorage.removeItem('freeiq_quick_session');
        window.location.href = (e.currentTarget as HTMLAnchorElement).href;
      }
      document.getElementById('btn-retake-top')?.addEventListener('click', handleRetake);
      document.getElementById('btn-retake-bottom')?.addEventListener('click', handleRetake);
      document.getElementById('btn-quick-test-top')?.addEventListener('click', (e) => {
        e.preventDefault();
        localStorage.removeItem('iq_assessment_answers');
        localStorage.removeItem('iq_active_questions');
        localStorage.removeItem('iq_test_type');
        localStorage.removeItem('iq_assessment_result');
        localStorage.removeItem('iq_review_data');
        localStorage.removeItem('freeiq_active_session');
        localStorage.removeItem('freeiq_quick_session');
        window.location.href = '/quick-test';
      });

      // --- Expand All accordion ---
      const btnExpandAll = document.getElementById('btn-expand-all');
      let allExpanded = false;
      if (btnExpandAll) {
        btnExpandAll.addEventListener('click', () => {
          allExpanded = !allExpanded;
          document.querySelectorAll('.review-panel').forEach((el) => {
            (el as HTMLElement).style.display = allExpanded ? 'block' : 'none';
          });
          btnExpandAll.textContent = allExpanded ? 'Collapse All' : 'Expand All';
        });
      }
    });

    // --- SubType label formatter (Bug 3 fix) ---
    function formatSubType(subType: string): string {
      const map: Record<string, string> = {
        matrix_reasoning:                 'Matrix Reasoning',
        topological_series:               'Pattern Series',
        cube_rotation:                    '3D Cube Rotation',
        cube_nets:                        'Cube Folding Nets',
        abstract_rule_induction:          'Abstract Induction',
        spatial_visualization:            'Spatial Transformation',
        arithmetic_proportional_deduction:'Quantitative Reasoning',
        lexical_analogy_deductive_logic:  'Verbal Logic',
      };
      return map[subType] || subType.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    }

    // --- Bell Curve Render ---
    function renderBellCurve(userIq: number) {
      const minIq = 55; const maxIq = 145;
      const baselineY = 190; const peakHeight = 155;
      const mean = 100; const sd = 15;
      const xForIq = (iq: number) => 50 + ((iq - minIq) / (maxIq - minIq)) * 500;
      const yForIq = (iq: number) => baselineY - peakHeight * Math.exp(-0.5 * Math.pow((iq - mean) / sd, 2));
      let outlineD = `M 50 ${baselineY}`;
      for (let iq = minIq; iq <= maxIq; iq++) {
        outlineD += ` L ${xForIq(iq).toFixed(1)} ${yForIq(iq).toFixed(1)}`;
      }
      document.getElementById('curve-outline')?.setAttribute('d', outlineD);
      const clamped = Math.max(55, Math.min(145, userIq));
      let shadedD = `M 50 ${baselineY}`;
      for (let iq = minIq; iq <= clamped; iq++) {
        shadedD += ` L ${xForIq(iq).toFixed(1)} ${yForIq(iq).toFixed(1)}`;
      }
      shadedD += ` L ${xForIq(clamped).toFixed(1)} ${baselineY} Z`;
      document.getElementById('curve-shaded-area')?.setAttribute('d', shadedD);
      const curvePin = document.getElementById('curve-pin');
      if (curvePin) {
        curvePin.setAttribute('transform', `translate(${xForIq(clamped).toFixed(1)}, ${yForIq(clamped).toFixed(1)})`);
        const pinText = document.getElementById('curve-pin-text');
        if (pinText) pinText.textContent = `You: ${userIq}`;
      }
    }

    // --- Question Review Accordion ---
    function renderReviewAccordion(items: ReviewItem[]) {
      const accordion = document.getElementById('review-accordion');
      if (!accordion) return;
      accordion.innerHTML = '';

      const domainColors: Record<string, string> = {
        fluid:        'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono',
        spatial:      'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono',
        quantitative: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono',
        verbal:       'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono',
      };
      const domainLabels: Record<string, string> = {
        fluid: 'FRI', spatial: 'VSI', quantitative: 'QRI', verbal: 'VCI',
      };

      items.forEach((q, idx) => {
        const selectedId = q.selectedOptionId;
        const selectedOpt = q.options.find((o) => o.id === selectedId);
        const correctOpt  = q.options.find((o) => o.isCorrect);
        const isCorrect   = q.isCorrect;
        const wasAnswered = selectedId !== undefined;

        const wrapper = document.createElement('div');
        wrapper.className = 'rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden';

        // Header button
        const header = document.createElement('button');
        header.type = 'button';
        header.className = 'w-full flex items-center gap-3 p-4 text-left hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-inset';

        // Result icon
        const icon = document.createElement('span');
        icon.className = 'shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold ' + (isCorrect ? 'bg-emerald-500' : wasAnswered ? 'bg-rose-500' : 'bg-zinc-400');
        icon.innerHTML = isCorrect
          ? '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'
          : '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>';

        const meta = document.createElement('div');
        meta.className = 'flex-1 min-w-0';
        const topRow = document.createElement('div');
        topRow.className = 'flex items-center gap-2 flex-wrap';
        const qNum = document.createElement('span');
        qNum.className = 'font-mono text-sm font-semibold text-zinc-700 dark:text-zinc-300';
        qNum.textContent = `Q${idx + 1}`;
        const domainBadge = document.createElement('span');
        const dc = domainColors[q.domain] || '';
        domainBadge.className = `inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-semibold border ${dc}`;
        domainBadge.textContent = domainLabels[q.domain] || q.domain;
        const resultText = document.createElement('span');
        resultText.className = 'text-xs font-mono ' + (isCorrect ? 'text-emerald-600 dark:text-emerald-400' : wasAnswered ? 'text-rose-600 dark:text-rose-400' : 'text-zinc-400');
        resultText.textContent = isCorrect ? 'Correct' : wasAnswered ? 'Incorrect' : 'Skipped';
        topRow.append(qNum, domainBadge, resultText);

        const questionSummary = document.createElement('p');
        questionSummary.className = 'text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 truncate pr-8';
        questionSummary.textContent = q.promptType === 'svg' ? `[Visual: ${formatSubType(q.subType)}]` : q.promptText.slice(0, 80) + (q.promptText.length > 80 ? '...' : '');
        meta.append(topRow, questionSummary);

        const chevron = document.createElement('span');
        chevron.className = 'shrink-0 text-zinc-400 transition-transform duration-200';
        chevron.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';

        header.append(icon, meta, chevron);

        // Expandable panel
        const panel = document.createElement('div');
        panel.className = 'review-panel border-t border-zinc-100 dark:border-zinc-800 p-4 sm:p-5 text-sm text-zinc-700 dark:text-zinc-300';
        panel.style.display = 'none';

        // Show prompt if text
        if (q.promptType !== 'svg' && q.promptText) {
          const promptEl = document.createElement('p');
          promptEl.className = 'text-sm font-medium text-zinc-800 dark:text-zinc-200 mb-3 leading-relaxed p-3 rounded-xl bg-zinc-50 dark:bg-zinc-800';
          promptEl.textContent = q.promptText;
          panel.appendChild(promptEl);
        }

        // Selected vs correct answer display
        const answerRow = document.createElement('div');
        answerRow.className = 'flex flex-col sm:flex-row gap-3 mb-4';

        const makeAnswerCard = (label: string, opt: typeof correctOpt, highlight: 'correct' | 'wrong' | 'neutral') => {
          const card = document.createElement('div');
          const bg = highlight === 'correct' ? 'bg-emerald-50 dark:bg-emerald-950/30 border-emerald-300 dark:border-emerald-800' :
                     highlight === 'wrong'   ? 'bg-rose-50 dark:bg-rose-950/30 border-rose-300 dark:border-rose-800' :
                                              'bg-zinc-50 dark:bg-zinc-800 border-zinc-200 dark:border-zinc-700';
          card.className = `flex-1 p-3 rounded-xl border ${bg}`;
          const labelEl = document.createElement('span');
          labelEl.className = 'block text-xs font-mono font-semibold mb-1 ' + (highlight === 'correct' ? 'text-emerald-700 dark:text-emerald-400' : highlight === 'wrong' ? 'text-rose-700 dark:text-rose-400' : 'text-zinc-500');
          labelEl.textContent = label;
          card.appendChild(labelEl);
          if (opt) {
            if (opt.text) {
              const t = document.createElement('p');
              t.className = 'text-xs text-zinc-800 dark:text-zinc-200';
              t.textContent = opt.text;
              card.appendChild(t);
            } else {
              const svgWrap = document.createElement('div');
              svgWrap.className = 'max-w-[80px] mx-auto';
              svgWrap.innerHTML = opt.svgContent ?? '';
              card.appendChild(svgWrap);
            }
          } else {
            const t = document.createElement('p');
            t.className = 'text-xs text-zinc-400 italic';
            t.textContent = 'Not answered';
            card.appendChild(t);
          }
          return card;
        };

        if (!isCorrect) {
          answerRow.appendChild(makeAnswerCard('Your Answer', selectedOpt, wasAnswered ? 'wrong' : 'neutral'));
          answerRow.appendChild(makeAnswerCard('Correct Answer', correctOpt, 'correct'));
        } else {
          answerRow.appendChild(makeAnswerCard('Your Answer (Correct)', selectedOpt, 'correct'));
        }
        panel.appendChild(answerRow);

        // Explanation
        const explainLabel = document.createElement('p');
        explainLabel.className = 'text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider mb-2';
        explainLabel.textContent = 'Step-by-Step Explanation';
        const explainText = document.createElement('p');
        explainText.className = 'text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed p-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80';
        explainText.textContent = q.explanation;
        panel.append(explainLabel, explainText);

        // IRT params
        const params = document.createElement('p');
        params.className = 'text-xs font-mono text-zinc-400 mt-3';
        params.textContent = `IRT: a = ${q.a} (discrimination), b = ${q.b} (difficulty)`;
        panel.appendChild(params);

        // Toggle
        header.addEventListener('click', () => {
          const isOpen = panel.style.display !== 'none';
          panel.style.display = isOpen ? 'none' : 'block';
          chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        });
      });
    }

    // --- Certificate Generator ---
    (function () {
      function getCertResult(): AssessmentResult | null {
        if (currentCertResult) return currentCertResult;
        const savedResultStr = localStorage.getItem('iq_assessment_result');
        if (savedResultStr) {
          try {
            return JSON.parse(savedResultStr);
          } catch (e) {}
        }
        return DEMO_RESULT;
      }

      function drawCertificate(canvas: HTMLCanvasElement, recipientName: string, result: AssessmentResult) {
        const W = 1600, H = 1130;
        // High-DPI retina canvas buffer
        canvas.width = 3200;
        canvas.height = 2260;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.setTransform(2, 0, 0, 2, 0, 0);

        // Helper for rounded rectangle with fallback
        function drawRoundRect(x: number, y: number, w: number, h: number, r: number) {
          if (!ctx) return;
          if (typeof (ctx as any).roundRect === 'function') {
            (ctx as any).roundRect(x, y, w, h, r);
          } else {
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + w - r, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + r);
            ctx.lineTo(x + w, y + h - r);
            ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
            ctx.lineTo(x + r, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
          }
        }

        // Background gradient (cream)
        const bg = ctx.createLinearGradient(0, 0, W, H);
        bg.addColorStop(0, '#ffffff');
        bg.addColorStop(1, '#f8fafc');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, W, H);

        // Outer double border
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 12;
        ctx.strokeRect(24, 24, W - 48, H - 48);
        ctx.strokeStyle = '#d97706';
        ctx.lineWidth = 4;
        ctx.strokeRect(40, 40, W - 80, H - 80);
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2;
        ctx.strokeRect(52, 52, W - 104, H - 104);

        // Corner ornament dots
        const corners = [[68, 68], [W - 68, 68], [68, H - 68], [W - 68, H - 68]];
        corners.forEach(([cx, cy]) => {
          ctx.beginPath();
          ctx.arc(cx, cy, 10, 0, Math.PI * 2);
          ctx.fillStyle = '#d97706';
          ctx.fill();
        });

        // Header registry line
        ctx.font = 'bold 26px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.textAlign = 'center';
        ctx.fillText('FREEIQEXAM.COM PSYCHOMETRIC REGISTRY', W / 2, 140);

        // Gold separator
        ctx.fillStyle = '#d97706';
        ctx.fillRect(W / 2 - 300, 158, 600, 3);

        // Monumental title
        ctx.font = 'bold 50px "Georgia", serif';
        ctx.fillStyle = '#0f172a';
        ctx.fillText('UNPROCTORED COGNITIVE EVALUATION CERTIFICATE', W / 2, 240);

        // Presentation text
        ctx.font = '30px "Georgia", serif';
        ctx.fillStyle = '#6b7280';
        ctx.fillText('This is to certify that', W / 2, 320);

        // Recipient name (prominent with dynamic font sizing)
        const displayName = recipientName.trim() || 'Verified Candidate';
        let nameFontSize = 70;
        ctx.font = `bold ${nameFontSize}px "Georgia", serif`;
        while (ctx.measureText(displayName).width > 1200 && nameFontSize > 26) {
          nameFontSize -= 4;
          ctx.font = `bold ${nameFontSize}px "Georgia", serif`;
        }
        ctx.fillStyle = '#1e40af';
        ctx.fillText(displayName, W / 2, 420);

        // Name underline
        const nameWidth = Math.min(ctx.measureText(displayName).width, 1200);
        ctx.fillStyle = '#1e40af';
        ctx.fillRect(W / 2 - nameWidth / 2, 432, nameWidth, 2);

        // Performance paragraph
        const dateStr = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        ctx.font = '24px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.fillText('has successfully completed the Standardized 4-Domain Cognitive Ability Assessment on ' + dateStr + '.', W / 2, 490);
        ctx.fillText('Evaluated under the 2-Parameter Logistic (2PL) Item Response Theory model on the Standardized Psychometric Scale (Mean 100, SD 15).', W / 2, 526);

        // Central score box
        const boxX = W / 2 - 280, boxY = 566, boxW = 560, boxH = 200;
        ctx.fillStyle = '#f0f9ff';
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 3;
        ctx.beginPath();
        drawRoundRect(boxX, boxY, boxW, boxH, 16);
        ctx.fill();
        ctx.stroke();

        // Score + IQ label
        ctx.font = 'bold 80px "Georgia", serif';
        ctx.fillStyle = '#0f172a';
        ctx.textAlign = 'center';
        ctx.fillText(String(result.iqEstimate) + ' IQ', W / 2, boxY + 82);

        ctx.font = '24px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.fillText(
          '95% Credible Interval: [' + result.confidenceInterval[0] + ' - ' + result.confidenceInterval[1] + ']   |   ' +
          result.percentile.toFixed(1) + 'th Percentile',
          W / 2, boxY + 126
        );

        // Classification
        let classification = 'Average Cognitive Ability';
        const iq = result.iqEstimate;
        if (iq >= 145) classification = 'Profoundly Superior Cognitive Ability';
        else if (iq >= 130) classification = 'Very Superior Cognitive Ability';
        else if (iq >= 120) classification = 'Superior Cognitive Ability';
        else if (iq >= 110) classification = 'High Average Cognitive Ability';
        else if (iq >= 90)  classification = 'Average Cognitive Ability';
        else if (iq >= 80)  classification = 'Low Average Cognitive Ability';
        else                classification = 'Borderline Range';

        ctx.font = 'bold 26px "Georgia", serif';
        ctx.fillStyle = '#1e40af';
        ctx.fillText(classification, W / 2, boxY + 168);

        // 4 CHC Domain sub-indices
        const domainLabels = [
          { key: 'fluid',        label: 'Fluid Reasoning (FRI)' },
          { key: 'spatial',      label: 'Visual-Spatial (VSI)' },
          { key: 'quantitative', label: 'Quantitative (QRI)' },
          { key: 'verbal',       label: 'Verbal Comprehension (VCI)' },
        ] as const;

        const colW = (W - 160) / 4;
        const domY = 810;
        ctx.font = '22px "Georgia", serif';
        domainLabels.forEach((d, i) => {
          const cx         = 80 + colW * i + colW / 2;
          const dd         = result.domainBreakdown[d.key];
          const accPct     = dd.total > 0 ? Math.round((dd.rawScore / dd.total) * 100) : 0;
          const tierLabel  = accPct >= 83 ? 'Strength Area' : accPct >= 67 ? 'High Average' : accPct >= 50 ? 'Average Range' : 'Developing Area';
          ctx.fillStyle = '#374151';
          ctx.textAlign = 'center';
          ctx.fillText(d.label, cx, domY);
          ctx.font = 'bold 36px "Georgia", serif';
          ctx.fillStyle = '#0f172a';
          ctx.fillText(dd.rawScore + '/' + dd.total + ' Correct', cx, domY + 46);
          ctx.font = '20px "Georgia", serif';
          ctx.fillStyle = '#374151';
          ctx.fillText('(' + tierLabel + ')', cx, domY + 74);
          ctx.font = '22px "Georgia", serif';
        });

        // Gold separator above footer
        ctx.fillStyle = '#d97706';
        ctx.fillRect(80, 900, W - 160, 2);

        // Footer: Reference ID | Seal text | Date
        const hashInput = `${result.iqEstimate}-${result.theta.toFixed(2)}-${result.rawScore}-${result.totalQuestions}`;
        let hashVal = 5381;
        for (let i = 0; i < hashInput.length; i++) {
          hashVal = ((hashVal << 5) + hashVal) + hashInput.charCodeAt(i);
          hashVal |= 0;
        }
        const hexCode = Math.abs(hashVal).toString(16).padStart(6, '0').slice(-6).toUpperCase();
        const dateYear = new Date().getFullYear().toString();
        const referenceId = `FIQ-${dateYear}-${hexCode}`;
        ctx.font = '20px monospace';
        ctx.fillStyle = '#6b7280';
        ctx.textAlign = 'left';
        ctx.fillText('Reference ID: ' + referenceId, 100, 950);

        ctx.textAlign = 'center';
        ctx.font = 'bold 20px "Georgia", serif';
        ctx.fillStyle = '#d97706';
        ctx.fillText('ESTIMATED 2PL IRT ABILITY REPORT | SELF-ASSESSMENT', W / 2, 950);

        ctx.textAlign = 'right';
        ctx.font = '20px "Georgia", serif';
        ctx.fillStyle = '#6b7280';
        ctx.fillText('FreeIQExam Psychometrics Engine', W - 100, 950);
        ctx.fillText(dateStr, W - 100, 978);

        // Signature line
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(W - 400, 940);
        ctx.lineTo(W - 100, 940);
        ctx.stroke();

        // Mirror canvas to print certificate image
        const printCertImg = document.getElementById('print-cert-img') as HTMLImageElement | null;
        if (printCertImg) {
          printCertImg.src = canvas.toDataURL('image/png');
        }
      }

      // Button wiring (runs after DOM is ready)
      document.addEventListener('DOMContentLoaded', function () {
        const btnGenerate   = document.getElementById('btn-generate-cert');
        const btnDownload   = document.getElementById('btn-download-cert');
        const btnPrintCert  = document.getElementById('btn-print-cert');
        const btnShare      = document.getElementById('btn-share-result');
        const nameInput     = document.getElementById('cert-name-input') as HTMLInputElement | null;
        const previewWrap   = document.getElementById('cert-preview-wrap');
        const canvas        = document.getElementById('cert-canvas') as HTMLCanvasElement | null;

        if (btnGenerate && canvas && previewWrap) {
          btnGenerate.addEventListener('click', () => {
            const r = getCertResult();
            if (!r) return;
            const name = nameInput ? nameInput.value.trim() : '';
            drawCertificate(canvas, name, r);
            previewWrap.classList.remove('hidden');
            previewWrap.classList.add('flex');
            canvas.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
        }

        if (btnDownload && canvas) {
          btnDownload.addEventListener('click', () => {
            const name = (nameInput ? nameInput.value.trim() : '') || 'Verified_Candidate';
            const safeName = name.replace(/[^a-zA-Z0-9_]/g, '_');
            const filename = 'FreeIQExam_Certificate_' + safeName + '.png';

            if (canvas.toBlob) {
              canvas.toBlob((blob) => {
                if (!blob) return;
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
                if (isIOS) {
                  const url = URL.createObjectURL(blob);
                  window.open(url, '_blank');
                  setTimeout(() => URL.revokeObjectURL(url), 30000);
                } else {
                  const url = URL.createObjectURL(blob);
                  const link = document.createElement('a');
                  link.download = filename;
                  link.href = url;
                  document.body.appendChild(link);
                  link.click();
                  document.body.removeChild(link);
                  setTimeout(() => URL.revokeObjectURL(url), 1000);
                }
              }, 'image/png');
            } else {
              const link = document.createElement('a');
              link.download = filename;
              link.href = canvas.toDataURL('image/png');
              link.click();
            }
          });
        }

        if (btnPrintCert) {
          btnPrintCert.addEventListener('click', () => window.print());
        }

        if (btnShare) {
          btnShare.addEventListener('click', () => {
            const r = getCertResult();
            const shareText = r
              ? 'I scored ' + r.iqEstimate + ' IQ (' + r.percentile.toFixed(1) + 'th percentile) on the FreeIQExam 4-Domain Cognitive Assessment. Take the free test at https://freeiqexam.com'
              : 'Take the free FreeIQExam 4-Domain IQ Assessment at https://freeiqexam.com';
            if (navigator.share) {
              navigator.share({ title: 'My FreeIQExam Score', text: shareText, url: 'https://freeiqexam.com/results' }).catch(() => {});
            } else {
              navigator.clipboard.writeText(shareText).then(() => {
                if (btnShare) btnShare.textContent = 'Link Copied!';
                setTimeout(() => { if (btnShare) btnShare.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg> Share My Score'; }, 2500);
              }).catch(() => { window.prompt('Copy your score link:', shareText); });
            }
          });
        }
      });
    })();
  </script>
</Layout>
