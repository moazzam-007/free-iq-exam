---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = "Your IQ Test Score Report & Psychometric Breakdown | FreeIQExam";
const description = "View your estimated IQ score, 95% posterior credible interval, population percentile rank, and 4-domain CHC cognitive breakdown. Free instant results.";
---

<Layout title={title} description={description}>
  <!-- Print-Only Official Document Header -->
  <div class="hidden print:block mb-8 pb-4 border-b-2 border-zinc-900">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-2xl font-bold font-heading text-zinc-950 block">FreeIQExam.com</span>
        <p class="text-xs text-zinc-500 font-mono">Standardized Multi-Domain Cognitive Assessment Report (SD 15, 4-Domain CHC)</p>
      </div>
      <div class="text-right text-xs font-mono text-zinc-500">
        <p id="print-date">Generated: 2026</p>
        <p>Model: 2PL Item Response Theory</p>
      </div>
    </div>
  </div>

  <!-- Shared Site Navigation (global Header with mobile drawer; print-hidden via global print stylesheet) -->
  <Header currentPath="/results" />

  <!-- Demo Notice Banner -->
  <div id="demo-banner" class="hidden max-w-5xl mx-auto px-4 sm:px-6 pt-6 print:hidden">
    <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-amber-200 dark:bg-amber-900 flex items-center justify-center text-amber-800 dark:text-amber-200 shrink-0">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <p class="text-xs sm:text-sm text-amber-900 dark:text-amber-200 font-medium">
          <strong>Demo Report:</strong> Viewing a sample score report. Complete an assessment to obtain your personalized psychometric estimate.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/quick-test" class="px-4 py-2 rounded-full text-xs font-semibold text-white bg-zinc-700 hover:bg-zinc-600 whitespace-nowrap shadow-xs">Quick (10 min)</a>
        <a href="/test" class="px-4 py-2 rounded-full text-xs font-semibold text-white bg-amber-600 hover:bg-amber-500 whitespace-nowrap shadow-xs">Full Test (20 min)</a>
      </div>
    </div>
  </div>

  <!-- Test Type Badge -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-4 print:hidden">
    <span id="test-type-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 uppercase tracking-wider"></span>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">

    <!-- Accessible Landmark Heading (WCAG 2.4.6) -->
    <h1 class="sr-only">Your Standardized Cognitive Assessment Results</h1>

    <!-- Hero Score Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs text-center relative overflow-hidden">

      <div class="relative z-10 flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-600 dark:text-zinc-300 mb-6 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>STANDARDIZED COMPOSITE IQ ESTIMATE (SD 15, CHC MODEL)</span>
        </div>

        <div class="flex items-baseline justify-center gap-2 my-2">
          <span id="score-display" class="font-heading font-extrabold text-6xl sm:text-7xl lg:text-8xl tracking-tight text-zinc-950 dark:text-white leading-none min-h-[1em]" aria-busy="true">
            &mdash;
          </span>
          <span class="text-xl sm:text-2xl font-mono text-zinc-500 dark:text-zinc-400 font-semibold">IQ</span>
        </div>

        <div class="mt-3 mb-2">
          <span id="classification-badge" class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-semibold bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
            Calculating...
          </span>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-md mx-auto mb-6 text-center leading-relaxed">
          Standardized psychometric scale centered at <strong>100 IQ (Global Population Mean)</strong> with standard deviation &sigma; = 15. The clinical scale ranges from 40 to 160+; this is a relative cognitive distribution, not a percentage score out of 100.
        </p>

        <div class="w-full max-w-lg p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 shadow-2xs">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
            <span class="font-mono font-medium">
              95% Posterior Credible Interval:
              <strong id="ci-display" class="text-zinc-950 dark:text-white font-bold ml-1">&mdash;</strong>
            </span>
            <span class="text-zinc-500 dark:text-zinc-400 font-mono text-xs">
              SEM: &plusmn;<span id="sem-display">&mdash;</span> pts
            </span>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 text-left mt-2 border-t border-zinc-100 dark:border-zinc-800/80 pt-2 leading-relaxed">
            Bayesian EAP estimated interval accounting for provisional item parameters and posterior measurement variance.
          </p>
        </div>

        <!-- Percentile / Rarity / Theta Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full max-w-2xl mt-6">
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Percentile Rank</span>
            <span id="percentile-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span id="percentile-subtext" class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">Calculating percentile...</span>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Population Rarity</span>
            <span id="rarity-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">General cohort frequency</span>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col items-center">
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase">Latent Ability (&theta;)</span>
            <span id="theta-display" class="text-xl sm:text-2xl font-bold font-heading text-zinc-900 dark:text-white mt-1">&mdash;</span>
            <span class="text-xs text-zinc-600 dark:text-zinc-400 text-center mt-1">Standard normal metric</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational Guide: IQ Scale vs. Percentile vs. Percentage -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xs print:break-inside-avoid">
      <div class="flex items-center gap-2 mb-4">
        <span class="p-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-900/60">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <h2 class="font-heading text-base sm:text-lg font-bold text-zinc-950 dark:text-white">
          Understanding Your Score: IQ Scale vs. Percentile vs. Percentage
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-1">1. The IQ Scale (Mean = 100)</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Not Out of 100</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Unlike school exams, IQ tests are <strong>not graded out of 100</strong>. Instead, <strong>100 represents the exact global average</strong>. The clinical bell curve spans from 40 to 160+. Scores between <strong>90 and 109</strong> denote standard average adult cognitive ability.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Baseline: 100 IQ = 50th Percentile
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1">2. Percentile Rank (Midpoint = 50%)</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Relative Human Ranking</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Your percentile rank indicates what percentage of human test-takers scored lower than you. A <strong>50% percentile is the global midpoint</strong>. With your percentile of <strong><span id="guide-dynamic-pct">27.1%</span></strong>, your cognitive performance exceeds approximately <strong id="guide-dynamic-count">27</strong> out of every 100 people worldwide.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Formula: &Phi;(Z) across normal population
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/70 dark:border-zinc-800/70 flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-wider mb-1">3. The Normal Bell Curve</div>
            <h3 class="font-bold text-zinc-900 dark:text-white mb-1.5">Gaussian Population Spread</h3>
            <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Over <strong>68% of humanity</strong> falls between 85 and 115 IQ (within &plusmn;1 standard deviation). Scores above 130 represent the top 2% (Mensa threshold), while scores below 70 indicate clinical cognitive divergence.
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-200/60 dark:border-zinc-800 text-[11px] font-mono text-zinc-500">
            Distribution: &mu; = 100, &sigma; = 15
          </div>
        </div>
      </div>
    </section>

    <!-- Certificate Generator Card -->
    <section id="certificate-section" class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs print:hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
            <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            OFFICIAL CERTIFICATE
          </div>
          <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
            Claim Your Official Certificate
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Generate a high-resolution certificate of your cognitive ability assessment. Enter your full name as it should appear on the certificate.
          </p>
        </div>
        <div class="shrink-0 w-12 h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        </div>
      </div>

      <!-- Name input + generate -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <label for="cert-name-input" class="sr-only">Full name for certificate</label>
        <input
          id="cert-name-input"
          type="text"
          placeholder="Full Name (as it will appear on your certificate)"
          aria-label="Full name for certificate"
          maxlength="60"
          class="flex-1 px-4 py-3 min-h-[44px] rounded-2xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-900 dark:text-white placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-colors"
        />
        <button
          id="btn-generate-cert"
          type="button"
          class="min-h-[44px] px-6 py-3 rounded-2xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all flex items-center justify-center gap-2 whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
          Generate Certificate
        </button>
      </div>

      <!-- Canvas preview (hidden until generated) -->
      <div id="cert-preview-wrap" class="hidden flex-col gap-4">
        <canvas
          id="cert-canvas"
          width="3200"
          height="2260"
          class="w-full max-w-full h-auto block rounded-xl border border-zinc-800 shadow-2xl"
        ></canvas>

        <!-- Mirror for print stylesheet -->
        <img id="print-cert-img" class="hidden print:block w-full max-w-2xl mx-auto my-6 rounded-xl border border-zinc-300" alt="Official Cognitive Screening Certificate" />

        <!-- Download / Print actions -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            id="btn-download-cert"
            type="button"
            class="min-h-[44px] flex-1 px-5 py-3 rounded-2xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            Download High-Res Certificate (PNG)
          </button>
          <button
            id="btn-print-cert"
            type="button"
            class="min-h-[44px] flex-1 px-5 py-3 rounded-2xl text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-all flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" /></svg>
            Print / Save as PDF
          </button>
        </div>
      </div>
    </section>

    <!-- Global Cognitive Leaderboard Preview -->
    <section class="rounded-3xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs print:hidden">
      <!-- Section Header -->
      <div class="px-6 sm:px-8 py-6 bg-zinc-900 border-b border-zinc-800 text-white">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 uppercase tracking-wider mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse" aria-hidden="true"></span>
              GLOBAL COHORT BENCHMARKS
            </span>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-white">
              Illustrative Global Standings
            </h2>
            <p class="text-sm text-zinc-400 mt-1">
              Sample percentile cohort benchmarks illustrating standard population distributions.
            </p>
          </div>
          <div class="px-3 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 whitespace-nowrap">
            Launching Soon <span aria-hidden="true">&bull;</span> Reference Benchmarks
          </div>
        </div>
      </div>

      <!-- Leaderboard Table -->
      <div class="bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm">
        <!-- Header Row -->
        <div class="grid grid-cols-[40px_1fr_90px_80px_1fr] gap-3 px-6 py-3 border-b border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider">
          <span>#</span>
          <span>Reference Cohort</span>
          <span class="text-right">Score</span>
          <span class="text-right">Pctile</span>
          <span class="hidden sm:block">Strongest Domain</span>
        </div>

        <!-- Row 1 -->
        <div class="grid grid-cols-[40px_1fr_90px_80px_1fr] gap-3 items-center px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/60 hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
          <span class="font-mono font-bold text-sm text-amber-500">#1</span>
          <div class="flex items-center gap-2">
            <span class="text-lg leading-none">&#127482;&#127480;</span>
            <span class="font-medium text-sm text-zinc-900 dark:text-white">Alex_V.</span>
          </div>
          <span class="font-mono font-bold text-sm text-zinc-900 dark:text-white text-right">146 IQ</span>
          <span class="font-mono text-xs text-zinc-500 text-right">99.9th</span>
          <span class="hidden sm:block text-xs text-zinc-500 dark:text-zinc-400 truncate">Fluid Reasoning (FRI: 148)</span>
        </div>

        <!-- Row 2 -->
        <div class="grid grid-cols-[40px_1fr_90px_80px_1fr] gap-3 items-center px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/60 hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
          <span class="font-mono font-bold text-sm text-zinc-500 dark:text-zinc-400">#2</span>
          <div class="flex items-center gap-2">
            <span class="text-lg leading-none">&#127471;&#127477;</span>
            <span class="font-medium text-sm text-zinc-900 dark:text-white">Hana_K.</span>
          </div>
          <span class="font-mono font-bold text-sm text-zinc-900 dark:text-white text-right">142 IQ</span>
          <span class="font-mono text-xs text-zinc-500 text-right">99.7th</span>
          <span class="hidden sm:block text-xs text-zinc-500 dark:text-zinc-400 truncate">Visual-Spatial (VSI: 145)</span>
        </div>

        <!-- Row 3 -->
        <div class="grid grid-cols-[40px_1fr_90px_80px_1fr] gap-3 items-center px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/60 hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
          <span class="font-mono font-bold text-sm text-amber-700">#3</span>
          <div class="flex items-center gap-2">
            <span class="text-lg leading-none">&#127465;&#127466;</span>
            <span class="font-medium text-sm text-zinc-900 dark:text-white">Marcus_S.</span>
          </div>
          <span class="font-mono font-bold text-sm text-zinc-900 dark:text-white text-right">138 IQ</span>
          <span class="font-mono text-xs text-zinc-500 text-right">99.4th</span>
          <span class="hidden sm:block text-xs text-zinc-500 dark:text-zinc-400 truncate">Quantitative (QRI: 141)</span>
        </div>

        <!-- Row 4 -->
