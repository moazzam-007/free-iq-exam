---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Страница не найдена (404) | FreeIQExam";
const description = "Запрашиваемая страница не найдена. Вернитесь на главную или пройдите бесплатный тест на IQ.";
---

<Layout title={title} description={description} noindex={true} enPath="/404" idPath="/404" canonicalUrl="https://freeiqexam.com/ru/404">
  <Header  enPath="/404" idPath="/404"/>

  <main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center flex flex-col items-center justify-center">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-600 dark:text-zinc-400 mb-6">
      <span>ОШИБКА 404 &bull; СТРАНИЦА НЕ НАЙДЕНА</span>
    </div>

    <h1 class="font-heading font-extrabold text-7xl sm:text-9xl text-zinc-950 dark:text-white tracking-tight leading-none mb-4">
      404
    </h1>

    <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-900 dark:text-zinc-100 mb-4">
      Страница не найдена
    </h2>

    <p class="text-sm sm:text-base text-zinc-500 dark:text-zinc-400 max-w-md mx-auto mb-8 leading-relaxed">
      Фрагмент головоломки, который вы ищете, перемещён или не существует. Воспользуйтесь нашим действующим тестом на IQ онлайн бесплатно или справочными материалами ниже.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a 
        href="/ru/" 
        class="px-6 py-3 rounded-full text-sm font-semibold text-zinc-950 dark:text-white bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
      >
        Вернуться на главную
      </a>
      <a 
        href="/ru/test" 
        class="px-7 py-3 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all"
      >
        Пройти тест на IQ
      </a>
      <a 
        href="/ru/iq-score-chart" 
        class="px-6 py-3 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
      >
        Таблица баллов
      </a>
    </div>

  </main>

  <Footer />
</Layout>
