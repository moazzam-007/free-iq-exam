---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "О проекте FreeIQExam: миссия, психометрическая методология и команда | FreeIQExam";
const description = "О миссии FreeIQExam: бесплатная научная оценка когнитивных способностей по модели 2PL IRT и CHC, этические стандарты, прозрачность и редакция.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "О проекте FreeIQExam: миссия, психометрика и прозрачность",
    "url": "https://freeiqexam.com/ru/about/",
    "description": "Узнайте о миссии FreeIQExam: научно обоснованное, прозрачное и бесплатное когнитивное тестирование на основе психометрической модели CHC и 2PL IRT."
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "FreeIQExam",
    "url": "https://freeiqexam.com/ru/",
    "logo": "https://freeiqexam.com/ru/logo-horizontal.svg",
    "sameAs": [
      "https://github.com/freeiqexam"
    ],
    "description": "Открытая платформа для научной оценки когнитивных способностей и тренировки мозга с приоритетом приватности и без платных барьеров."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "О проекте",
        "item": "https://freeiqexam.com/ru/about/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/about" idPath="/tentang-kami" canonicalUrl="https://freeiqexam.com/ru/about">
  <Header currentPath="/about"  enPath="/about" idPath="/tentang-kami"/>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">О проекте</span>
    </nav>
    
    <!-- Hero Section -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>ПРОЗРАЧНОСТЬ • НАУЧНЫЙ ПОДХОД • ДОСТУПНОСТЬ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Научная оценка когнитивных способностей без платного барьера
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        FreeIQExam создан как независимый образовательный проект: объяснять, как устроена онлайн-оценка IQ, не скрывать результат за оплатой и по возможности выполнять вычисления непосредственно в браузере пользователя.
      </p>
    </header>

    <!-- Mission & The Problem Section -->
    <section class="space-y-4">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Наша миссия: прозрачный бесплатный онлайн-тест IQ
      </h2>
      <p>
        Пользователи часто ищут бесплатный тест на IQ, но сталкиваются с сайтами, где стоимость результата становится понятна только после завершения длинной сессии. Такой опыт снижает доверие к онлайн-тестированию как к инструменту самооценки.
      </p>

      <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-900 dark:text-red-200 my-4 text-xs sm:text-sm">
        <strong>Типичная проблема:</strong> сайт обещает бесплатный тест, пользователь проходит задания, а полный отчёт оказывается доступен только после регистрации, ввода карты или оформления подписки.
      </div>

      <p>
        FreeIQExam использует другую продуктовую модель: пользователь должен заранее понимать, что именно он проходит, какие показатели увидит и какие ограничения есть у онлайн-скрининга.
      </p>

      <p>
        Онлайн-результат не следует называть клиническим диагнозом. Его интерпретация зависит от конкретного инструмента, норм и условий прохождения.
      </p>
    </section>

    <!-- Core Pillars Grid -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 not-prose my-6">
      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
        <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-900/60 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm mb-3">
          01
        </div>
        <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white mb-1.5">
          Психометрическая основа CHC
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Архитектура тестов опирается на модель Кеттелла–Хорна–Кэрролла (CHC) и использует отдельные когнитивные области, включая подвижный интеллект и визуально-пространственное мышление.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-200 dark:border-indigo-900/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm mb-3">
          02
        </div>
        <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white mb-1.5">
          Математическая модель 2PL IRT
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Для заданий используются параметры трудности и дискриминативности, а латентная способность оценивается байесовским методом EAP в рамках модели 2PL IRT.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm mb-3">
          03
        </div>
        <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-white mb-1.5">
          Приватное выполнение в браузере
        </h3>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Основные расчёты выполняются на стороне клиента. Для запуска теста не требуется e-mail или обязательная регистрация.
        </p>
      </div>
    </section>

    <!-- Psychometric Rigor Details -->
    <section class="space-y-4">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
        Как рассчитывается результат теста IQ
      </h2>
      <p>
        Простое количество правильных ответов не описывает всю информацию о взаимодействии человека и конкретных заданий. В IRT каждый вопрос имеет собственные параметры, характеризующие трудность и способность различать разные уровни латентной способности.
      </p>

      <ul class="list-disc pl-5 space-y-2">
        <li><strong>Характеристическая кривая задания (ICC):</strong> параметр <em>a</em> описывает дискриминативность, а параметр <em>b</em> — положение задания на шкале трудности.</li>
        <li><strong>Байесовская EAP-оценка:</strong> латентный параметр <em>&theta;</em> оценивается по последовательности ответов с учётом заданного априорного распределения.</li>
        <li><strong>Шкала SD 15:</strong> значение &theta; преобразуется в IQ-шкалу проекта и затем используется для расчёта процентильного положения.</li>
      </ul>

      <p>
        Полные формулы приведены на странице <a href="/ru/methodology" class="font-semibold underline">методологии и психометрии</a>.
      </p>
    </section>

    <!-- Clinical Scope Callout -->
    <section class="p-6 rounded-3xl bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-amber-900 dark:text-amber-200 space-y-2">
      <h2 class="font-heading font-bold text-lg sm:text-xl text-amber-950 dark:text-amber-100">
        Клинические границы и научные рамки
      </h2>
      <p>
        Психометрическая честность требует чётких границ. Несмотря на высокую математическую строгость наших тестов:
      </p>
      <ul class="list-disc pl-5 space-y-1.5">
        <li><strong>Скрининговый инструмент, а не клинический диагноз:</strong> FreeIQExam — образовательный инструмент для самооценки и скрининга. Он не заменяет комплексное индивидуальное обследование у лицензированного нейропсихолога.</li>
        <li><strong>Невербальная направленность:</strong> наш основной 20-минутный тест оценивает подвижный интеллект ($Gf$) и пространственное рассуждение, снижая языковой и культурный барьер.</li>
        <li><strong>Приём в Mensa и спецпрограммы:</strong> сообщества требуют очных прокторируемых экзаменов либо аккредитованных исторических свидетельств. Подробнее на странице <a href="/ru/mensa-iq-test-practice" class="font-semibold underline">тренировки к тесту Mensa</a>.</li>
      </ul>
    </section>

    <!-- PAA FAQs Accordion -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-6">
        Часто задаваемые вопросы о проекте FreeIQExam
      </h2>
      <div class="space-y-4">
        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Есть ли действительно бесплатный тест на IQ без оплаты и e-mail?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Да. FreeIQExam предоставляет полностью бесплатное тестирование с результатом сразу после завершения. Мы не требуем банковскую карту, подписку или ввод адреса электронной почты.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Почему многие онлайн-тесты на IQ начинают брать плату после прохождения?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Многие коммерческие сайты используют воронку с обманчивым предложением: привлекают обещанием бесплатного теста, а после 30 минут прохождения блокируют результат пейволлом. FreeIQExam создан именно для прозрачной альтернативы.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Можно ли считать FreeIQExam реальным бесплатным тестом на IQ?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Да. Проект построен на принципах открытой психометрии: модель 2PL IRT, теория CHC, конфиденциальность на стороне браузера и отсутствие скрытых платежей.
          </p>
        </details>

        <details class="group border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 sm:p-5 transition-colors open:bg-white dark:open:bg-zinc-900">
          <summary class="flex justify-between items-center font-heading font-semibold text-zinc-900 dark:text-white cursor-pointer list-none select-none text-sm sm:text-base">
            <span>Может ли онлайн-тест на IQ поставить официальный клинический диагноз?</span>
            <span class="ml-4 transition-transform group-open:rotate-180 text-zinc-400">&darr;</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Нет. Ни один онлайн-тест не заменяет очного клинического обследования у лицензированного психолога с батареями WAIS-IV или Stanford-Binet. FreeIQExam является скрининговым и образовательным инструментом.
          </p>
        </details>
      </div>
    </section>

    <!-- Assessment CTA -->
    <section class="p-8 sm:p-12 rounded-3xl bg-zinc-900 border border-zinc-800 text-white text-center shadow-lg">
      <h2 class="font-heading font-extrabold text-2xl sm:text-4xl mb-3 tracking-tight">
        Готовы пройти тест на IQ?
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
        Пройдите полный тест из 24 вопросов и получите оценку IQ и процентиль сразу после завершения.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/ru/test"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-white bg-blue-600 hover:bg-blue-500 transition-all shadow-md hover:scale-102 active:scale-[0.98]"
        >
          <span>Пройти полный тест (20 мин)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="/ru/quick-test"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full text-base font-bold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition-all border border-zinc-700 hover:scale-102 active:scale-[0.98]"
        >
          <span>Пройти экспресс-тест (10 мин)</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
