---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Бесплатный онлайн FPS-тренажёр аима | Точность мыши и скорость реакции";
const description = "Развивайте точность мыши, скорость реакции и меткость фликов в бесплатном браузерном FPS-тренажёре аима. Режимы Gridshot, плавного трекинга и точных микро-целей, конвертер чувствительности eDPI. Без загрузки и регистрации.";
const canonicalUrl = "https://freeiqexam.com/ru/aim-trainer";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "FreeIQExam - FPS-тренажёр аима и тест точности мыши",
    "url": "https://freeiqexam.com/ru/aim-trainer",
    "applicationCategory": "GameApplication",
    "operatingSystem": "All",
    "browserRequirements": "Требуется JavaScript и поддержка HTML5 Canvas",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Три тренировочные дисциплины: Gridshot (флики), плавный трекинг и точные микро-цели",
      "Высокопроизводительный рендеринг HTML5 Canvas на 60+ FPS с субпиксельными хитбоксами и физикой частиц",
      "Звуковые сигналы попаданий Web Audio API с нарастающей высотой тона и акустический отклик промаха",
      "Кинематические метрики в реальном времени: общий счёт, TPS (целей/сек), чистая точность % и задержка реакции (мс)",
      "Встроенный конвертер чувствительности eDPI для Valorant, CS2 / Counter-Strike, Overwatch 2, Apex Legends и R6 Siege",
      "Настраиваемые стили прицела (перекрестие, точка, круг с точкой) и яркие неоновые цвета",
      "Загружаемая карточка результата в высоком разрешении (PNG 1200x675)",
      "Без загрузки, без регистрации, полностью в браузере"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Инструменты",
        "item": "https://freeiqexam.com/ru/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "FPS-тренажёр аима",
        "item": "https://freeiqexam.com/ru/aim-trainer"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое FPS-тренажёр аима и как он улучшает точность мыши?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "FPS-тренажёр аима - это специализированная программная среда, которая изолирует и отрабатывает ключевую моторику прицеливания: захват цели (флики), динамический трекинг и точность микрокоррекций. Убирая внутриигровые отвлекающие факторы (отдачу, способности, физику перемещения), тренажёр позволяет выполнять сотни плотных повторений в минуту, ускоряя моторное обучение мозжечка и миелинизацию нейронных путей."
        }
      },
      {
        "@type": "Question",
        "name": "Что такое eDPI и как рассчитать его для разных игр?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "eDPI (эффективные точек на дюйм) отражает вашу истинную чувствительность мыши: eDPI = DPI × чувствительность в игре. Поскольку разные игровые движки используют разные константы рыскания (например, движок Source в CS2 использует 0,022, а Valorant - 0,07), чувствительность 1.0 в Valorant равна 3,1818 в CS2. Используйте наш встроенный конвертер, чтобы сохранить одинаковое расстояние поворота на 360 градусов во всех играх."
        }
      },
      {
        "@type": "Question",
        "name": "Стоит ли целиться рукой, запястьем или кончиками пальцев?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Сильнейшие киберспортсмены используют гибридную технику: 1) прицеливание рукой (поворот от локтя) отвечает за широкие движения (повороты на 90–180 градусов) на низкой чувствительности, 2) прицеливание запястьем (поворот от кисти) выполняет средние флики и трекинг по экрану, 3) микрокоррекции кончиками пальцев доводят финальное попадание в голову в пределах 5–15 пикселей и компенсируют вертикальную отдачу. Опора только на запястье на высокой чувствительности повышает риск туннельного синдрома и ухудшает точность на дальней дистанции."
        }
      },
      {
        "@type": "Question",
        "name": "Улучшает ли прицеливание более высокая частота обновления монитора (144 Гц, 240 Гц, 360 Гц)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Монитор 240 Гц обновляет кадр каждые 4,16 мс против 16,67 мс на стандартном 60 Гц. Это сокращение сквозной задержки «движение - фотон» на 12,5 мс отображает траектории цели со значительно меньшим смазыванием движения и временным шлейфом, позволяя вашей саккадической системе рассчитывать координаты перехвата цели с более высокой статистической точностью."
        }
      },
      {
        "@type": "Question",
        "name": "Какой результат в Gridshot (флики) считается хорошим?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "В стандартном 30-секундном тесте Gridshot: результаты ниже 40 000 (менее 2,0 целей/сек) соответствуют уровню новичка / Iron; 50 000–70 000 (2,5–3,2 целей/сек при точности 85 %+) - средний и промежуточный соревновательный уровень (Gold / Platinum); 80 000–95 000 - элитный уровень Master / Grandmaster; а результаты выше 100 000 (4,5+ целей/сек при точности 95 %+) отражают скорость фликов профессионального киберспортивного уровня."
        }
      },
      {
        "@type": "Question",
        "name": "Как частота опроса мыши (1000 Гц против 4000 Гц и 8000 Гц) влияет на точность?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Стандартные 1000 Гц передают координаты мыши каждые 1,0 мс. Сенсоры с высоким опросом на 4000 Гц (0,25 мс) и 8000 Гц (0,125 мс) снижают задержку ввода от сенсора до процессора и микродрожание, давая более плавные кривые микро-трекинга на мониторах 240 Гц и выше. Однако 8000 Гц требует существенной производительности одного ядра CPU, чтобы избежать просадок кадров в требовательных 3D-играх."
        }
      },
      {
        "@type": "Question",
        "name": "Почему на тренировке точность важнее сырой скорости фликов?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Исследования моторного обучения показывают, что быстрые неточные движения закрепляют неверные нейронные пути и формируют привычку к перелёту. Если осознанно тренироваться в ритме, при кото��ом вы удерживаете точность 90–95 %, моторная кора выстраивает точные кинематические траектории. Скорость естественно появляется как побочный продукт эффективности движения и снижения задержки коррекции."
        }
      },
      {
        "@type": "Question",
        "name": "Влияют ли вес мыши и трение коврика на точное прицеливание?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ультралёгкие мыши (менее 60 граммов) минимизируют кинетическую инерцию, обеспечивая более быстрое начальное ускорение и мгновенную остановку без мышечного напряжения. Коврики с низким статическим трением (гибридные или стеклянные поверхности) облегчают микрокоррекции для точности на уровне пикселя, а тканевые контрол-коврики дают более высокое динамическое трение для стабильного трекинга."
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  enPath="/aim-trainer"
  idPath="/id/pelatih-akurasi-aim"
  schema={schema}
>
  <Header currentPath="/aim-trainer" enPath="/aim-trainer" idPath="/id/pelatih-akurasi-aim" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

  <style>
    .aim-hero-glow { position: absolute; inset-inline: 0; top: 0; height: 24rem; pointer-events: none; background: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.10) 0%, rgba(0, 102, 204, 0.03) 45%, transparent 70%); mask-image: linear-gradient(to bottom, black 55%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%); }
    .dark .aim-hero-glow { background: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%); }
    .aim-mode-btn, .aim-time-btn { min-height: 44px; transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
    .aim-mode-btn:active, .aim-time-btn:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
    select#crosshairStyleSelect, select#crosshairColorSelect, #resultsWrap select, #resultsWrap input { min-height: 44px; }
    @media (prefers-reduced-motion: reduce) { .aim-hero-glow { display: none; } }
  </style>

    <!-- Hero Header -->
    <section class="relative pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
      <div class="aim-hero-glow" aria-hidden="true"></div>
      <div class="relative inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 text-[13px] font-mono font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>FPS-тренажёр аима и тест точности мыши</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-[-0.025em] leading-[1.08] text-zinc-950 dark:text-white mb-4">
        Бесплатный онлайн <span class="text-[#0066cc] dark:text-[#2997ff]">FPS-тренажёр аима</span>
      </h1>

      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-[1.62]">
        Отточите точность фликов, динамический трекинг и рефлексы на микро-целях с нашим аппаратно-ускоренным canvas-движком на 60 FPS. Настройте прицел, переведите чувствительность eDPI между играми и измерьте кинематику своей реакции.
      </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">

      <!-- Control Bar / Settings -->
      <div class="bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-4 sm:p-6 mb-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">

          <!-- Mode Selector -->
          <div class="flex items-center gap-1.5 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-[13px] font-medium">
            <button
              type="button"
              class="aim-mode-btn active px-3.5 py-2 rounded-xl transition-all duration-150 bg-blue-500/10 text-blue-500 border border-blue-500/40 font-semibold cursor-pointer"
              data-mode="gridshot"
            >
              <span>Gridshot (флики)</span>
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-mode="tracking"
            >
              <span>Плавный трекинг</span>
            </button>
            <button
              type="button"
              class="aim-mode-btn px-3.5 py-2 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
              data-mode="precision"
            >
              <span>Точные микро-цели</span>
            </button>
          </div>

          <!-- Duration & Crosshair Settings -->
          <div class="flex flex-wrap items-center gap-3">

            <!-- Duration -->
            <div class="flex items-center gap-1 bg-zinc-200/70 dark:bg-zinc-900 p-1 rounded-2xl border border-zinc-300/60 dark:border-zinc-800 text-[13px]">
              <button
                type="button"
                class="aim-time-btn active px-3 py-1.5 rounded-xl transition-all duration-150 text-blue-500 font-bold cursor-pointer"
                data-time="30"
              >
                30с
              </button>
              <button
                type="button"
                class="aim-time-btn px-3 py-1.5 rounded-xl transition-all duration-150 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white cursor-pointer"
                data-time="60"
              >
                60с
              </button>
            </div>

            <!-- Crosshair Style -->
            <div class="flex items-center gap-2 text-[13px]">
              <label for="crosshairStyleSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Прицел:</label>
              <select
                id="crosshairStyleSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-[13px] rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer"
              >
                <option value="crosshair">Перекрестие</option>
                <option value="dot">Точка</option>
                <option value="circle">Круг + точка</option>
              </select>
            </div>

            <!-- Crosshair Color -->
            <div class="flex items-center gap-2 text-[13px]">
              <label for="crosshairColorSelect" class="text-zinc-500 dark:text-zinc-400 font-medium hidden sm:inline">Цвет:</label>
              <select
                id="crosshairColorSelect"
                class="bg-zinc-200/70 dark:bg-zinc-900 border border-zinc-300/60 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 text-[13px] rounded-xl px-2.5 py-2 focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer"
              >
                <option value="#22c55e">Неоново-зелёный</option>
                <option value="#06b6d4">Голубой</option>
                <option value="#f43f5e" selected>Розово-красный</option>
                <option value="#ffffff">Чистый белый</option>
                <option value="#eab308">Янтарно-золотой</option>
              </select>
            </div>

          </div>
        </div>
      </div>

      <!-- Interactive Game Arena Container -->
      <div id="arenaContainer" class="relative bg-zinc-950 rounded-3xl p-3 sm:p-4 border border-zinc-800 shadow-2xl overflow-hidden select-none">

        <!-- Live HUD Bar -->
        <div class="flex items-center justify-between px-3 py-2 mb-3 bg-zinc-900/90 backdrop-blur-md rounded-2xl border border-zinc-800/80 text-zinc-100 text-[13px] sm:text-sm font-mono">
          <div class="flex items-center gap-4 sm:gap-8">
            <div>
              <span class="text-zinc-500 text-[13px] uppercase tracking-wider block font-sans">Осталось времени</span>
              <span id="hudAimTimer" class="font-bold text-base sm:text-lg text-blue-400">30s</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[13px] uppercase tracking-wider block font-sans">Счёт</span>
              <span id="hudAimScore" class="font-bold text-base sm:text-lg text-white">0</span>
            </div>
            <div>
              <span class="text-zinc-500 text-[13px] uppercase tracking-wider block font-sans">Попаданий</span>
              <span id="hudAimHits" class="font-bold text-base sm:text-lg text-emerald-400">0</span>
            </div>
          </div>

          <div class="flex items-center gap-4 sm:gap-6 text-right">
            <div>
              <span class="text-zinc-500 text-[13px] uppercase tracking-wider block font-sans">Точность</span>
              <span id="hudAimAcc" class="font-bold text-base sm:text-lg text-cyan-400">100%</span>
            </div>
            <div class="hidden sm:block text-zinc-500 text-[13px] font-sans">
              <span class="kbd px-1.5 py-0.5 rounded bg-zinc-800 text-[13px] text-zinc-400 border border-zinc-700">ESC</span> Сброс
            </div>
          </div>
        </div>

        <!-- Canvas Game Surface -->
        <div class="relative w-full h-[420px] sm:h-[540px] rounded-2xl overflow-hidden bg-[#0a0a0f] border border-zinc-800/60 flex items-center justify-center">
          <canvas id="aimCanvas" class="w-full h-full cursor-none touch-none block"></canvas>

          <!-- Start Game Overlay -->
          <div
            id="startOverlay"
            class="absolute inset-0 bg-zinc-950/85 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-all duration-200 z-10"
          >
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-blue-500/10 border-2 border-blue-500/40 flex items-center justify-center mb-5 text-blue-500 animate-pulse">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="3"></circle>
                <path stroke-linecap="round" d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
              </svg>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-2 tracking-tight">
              Нажмите в любом месте, чтобы начать тренировку
            </h2>
            <p class="text-sm text-zinc-400 max-w-md mb-6">
              Держите запястье расслабленным и сохраняйте ровный темп. Уничтожайте цели как можно быстрее и точнее.
            </p>

            <div class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-bold text-sm shadow-lg shadow-blue-600/25 transition-transform active:scale-[0.97]">
              <span>Начать сессию</span>
              <span>→</span>
            </div>

            <div class="mt-8 flex items-center gap-4 text-[13px] text-zinc-500">
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>Физика 60 FPS</span>
              <span>•</span>
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>Отклик Web Audio</span>
              <span>•</span>
              <span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>Свои прицелы</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Results Scorecard Container (Hidden by default) -->
      <div id="resultsWrap" class="hidden mt-8 bg-zinc-50 dark:bg-[#09090b] border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-xl transition-all duration-300">

        <!-- Score Header & Tier Badge -->
        <div class="text-center pb-8 border-b border-zinc-200 dark:border-zinc-800/80">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 text-[13px] font-mono font-semibold uppercase tracking-wider mb-3">
            <span>Сессия завершена</span>
          </div>

          <div class="text-5xl sm:text-7xl font-black text-zinc-950 dark:text-white font-mono tracking-tight mb-2">
            <span id="resAimScore">0</span>
            <span class="text-base sm:text-xl font-sans font-normal text-zinc-500">очк.</span>
          </div>

          <div class="flex items-center justify-center gap-3 mb-3">
            <span id="resAimTier" class="px-3.5 py-1 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-950 border border-transparent text-sm font-bold tracking-wide">
              Diamond II
            </span>
            <span id="resAimPercentile" class="text-[13px] text-zinc-500 dark:text-zinc-400 font-mono">
              Топ 12% в мире
            </span>
