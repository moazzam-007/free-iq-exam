---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Тест на тревожность онлайн: бесплатный скрининг GAD-7 и уровень тревоги | FreeIQExam';
const description = 'Пройдите клинический скрининг тревожности GAD-7 онлайн. Оценка симптомов генерализованной тревоги (ГТР), соматического напряжения и уровня стресса бесплатно.';
const canonicalUrl = 'https://freeiqexam.com/ru/anxiety-test';

const faqItems = [
  ['Что такое GAD-7 и кто его разработал?', 'GAD-7 (шкала генерализованного тревожного расстройства из 7 пунктов) - научно обоснованный клинический инструмент скрининга, разработанный доктором Робертом Л. Шпитцером, доктором Куртом Крёнке, доктором Джанет Б. У. Уильямс и доктором Берндом Лёве в 2006 году. Он измеряет частоту и тяжесть ключевых симптомов генерализованной тревоги за предшествующие две недели с использованием стандартизированной 4-балльной шкалы ответов.'],
  ['Насколько точен GAD-7 при выявлении тревожных расстройств?', 'В оригинальных валидационных исследованиях и обширных клинических метаанализах балл GAD-7 от 10 и выше демонстрирует чувствительность 89% и специфичность 82% для генерализованного тревожного расстройства относительно структурированных клинических интервью. Он также служит умеренно эффективным инструментом скрининга для панического расстройства, социального тревожного расстройства и посттравматического стрессового расстройства.'],
  ['Может ли этот тест диагностировать у меня тревожное расстройство?', 'Нет. GAD-7 - валидированный скрининговый опросник, а не медицинский диагноз. Формальный диагноз требует клинической оценки лицензированным врачом, психиатром или клиническим психологом, который может оценить историю болезни, длительность симптомов, исключить физиологические имитаторы (такие как гипертиреоз) и оценить нарушение функционирования.'],
  ['В чём разница между когнитивным беспокойством и соматической тревогой?', 'Когнитивное беспокойство включает психическое персеверирование, навязчивые катастрофические мысли, ориентированное на будущее предвосхищение и трудности с контролем петель беспокойства (пункты GAD-7 1, 2, 3 и 7). Соматическая тревога включает физическое автономное возбуждение, мышечное напряжение, психомоторное беспокойство и раздражительность (пункты GAD-7 4, 5 и 6).'],
  ['Чем генерализованное тревожное расстройство отличается от обычного стресса?', 'Повседневный стресс обычно пропорционален идентифицируемому внешнему требованию и стихает, когда ситуация разрешается. Генерализованное тревожное расстройство характеризуется стойким, чрезмерным и неконтролируемым беспокойством, которое возникает в большинстве дней в течение как минимум шести месяцев в нескольких жизненных сферах, часто сопровождаясь физическим напряжением и нарушением сна.'],
  ['Что означают разные диапазоны баллов GAD-7?', 'Баллы стратифицируются по четырём клиническим ступеням: 0–4 - минимальная тревожность (здоровые базовые колебания); 5–9 - лёгкая тревожность (субклиническое повышение; выжидательная тактика и lifestyle-ритм); 10–14 - умеренная тревожность (клинический порог достигнут; рекомендуется оценка); 15–21 - тяжёлая тревожность (высокое бремя симптомов; показана активная клиническая помощь).'],
  ['Что делать, если мой балл 10 или выше?', 'Балл 10 и выше указывает, что ваши симптомы достигли клинической значимости. Стоит рассмотреть возможность поделиться результатами с врачом первичного звена или специалистом по психическому здоровью. Вы можете распечатать сводку для клинициста, сформированную этим инструментом, и взять её на консультацию.'],
  ['Как часто нужно повторять GAD-7?', 'Если вы наблюдаете за симптомами без лечения, повторный скрининг каждые 2–4 недели - обычная практика. Если вы начали научно обоснованную психотерапию (например, КПТ) или фармакотерапию (например, СИОЗС), клиницисты часто повторяют GAD-7 каждые 2–4 недели, чтобы объективно измерить ответ на лечение. Изменение на 4–5 баллов обычно считается клинически значимым.']
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Скрининг генерализованного тревожного расстройства GAD-7 и ориентир нервной системы',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Screening',
    isAccessibleForFree: true,
    inLanguage: 'ru',
    about: {
      '@type': 'MedicalCondition',
      name: 'Генерализованное тревожное расстройство',
      alternateName: ['ГТР', 'Хроническая тревожность', 'Тревожный невроз', 'Генерализованная тревога'],
      code: { '@type': 'MedicalCode', code: 'F41.1', codingSystem: 'ICD-10' }
    },
    lastReviewed: '2026-09-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Бесплатный клинический тест на тревожность (GAD-7)',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Управление ответами с клавиатуры (клавиши 1–4), высококонтрастные состояния фокуса, семантические заголовки, aria-live объявления, кризисный каталог и печатная сводка для клинициста.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://freeiqexam.com/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Тесты', item: 'https://freeiqexam.com/ru/test' },
      { '@type': 'ListItem', position: 3, name: 'Тест на тревожность (GAD-7)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Опросник генерализованного тревожного расстройства GAD-7 - 7 пунктов',
    url: canonicalUrl,
    numberOfQuestions: 7,
    isAccessibleForFree: true,
    inLanguage: 'ru'
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/anxiety-test" idPath="/id/tes-kecemasan" schema={schemas}>
  <Header currentPath="/anxiety-test" enPath="/anxiety-test" idPath="/id/tes-kecemasan" />

  <main class="min-h-screen bg-white px-4 py-12 text-zinc-900 transition-colors duration-300 dark:bg-[#09090b] dark:text-zinc-100 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">

      <header class="text-center">
        <nav class="flex items-center justify-center gap-2 text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-4" aria-label="Хлебные крошки">
          <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Главная</a>
          <span>/</span>
          <a href="/ru/test" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Тесты</a>
          <span>/</span>
          <span class="text-zinc-800 dark:text-zinc-200">Тест на тревожность (GAD-7)</span>
        </nav>

        <p class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-4 py-1.5 text-[13px] font-mono font-bold uppercase tracking-wider text-[#0066cc] dark:border-zinc-800 dark:bg-zinc-900 dark:text-[#2997ff]">
          <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
          Клинический психометрический скрининг GAD-7
        </p>

        <h1 class="mt-4 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-[-0.025em] leading-[1.08] text-zinc-950 dark:text-white">
          Клинический тест на тревожность & <span class="text-[#0066cc] dark:text-[#2997ff]">ориентир нервной системы</span>
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-[17px] sm:text-lg leading-[1.62] text-zinc-600 dark:text-zinc-300">
          Измерьте бремя симптомов, различите петли когнитивного беспокойства и соматическое напряжение и оцените результат относительно стандартизированных психиатрических порогов тяжести. 100% конфиденциально, обработка полностью в вашем браузере.
        </p>

        <div class="mt-6 flex flex-wrap justify-center gap-2.5 text-[13px] sm:text-sm font-mono text-zinc-600 dark:text-zinc-400">
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">7 стандартных пунктов GAD</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">Двухдоменный разбор</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">Сводка для клинициста</span>
          <span class="rounded-xl border border-zinc-200 bg-zinc-50 px-3.5 py-1.5 dark:border-zinc-800 dark:bg-zinc-900">100% на стороне клиента</span>
        </div>
      </header>

      <aside class="mt-8 rounded-2xl border border-amber-200 bg-amber-50/80 p-4 sm:p-5 text-amber-950 dark:border-amber-900/50 dark:bg-amber-950/25 dark:text-amber-200" aria-label="Кризисные ресурсы">
        <div class="flex items-start gap-3.5">
          <svg class="w-4 h-4 shrink-0 text-amber-600 dark:text-amber-400 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></svg>
          <div class="text-[13px] sm:text-sm leading-relaxed">
            <strong class="font-bold">Нужна немедленная поддержка?</strong> Если вы испытываете непреодолимую панику, острый дистресс или мысли о самоповреждении, конфиденциальная бесплатная помощь доступна 24/7. В России звоните <strong>8-800-200-0122</strong> (Единая линия) или <strong>112</strong>. В США/Канаде: <strong>988</strong>. В Великобритании: <strong>111</strong> или <strong>116 123</strong>. По всему миру: <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="underline font-bold hover:text-amber-800 dark:hover:text-white">findahelpline.com</a>.
          </div>
        </div>
      </aside>

      <section id="anxiety-app" class="mt-8">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/90 p-5 dark:border-zinc-800 dark:bg-zinc-950/80 sm:p-8 shadow-xl backdrop-blur-xl">

          <div id="assessment-intro" class="border-t border-zinc-200 pt-6 dark:border-zinc-800 sm:pt-8">
            <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff]">Клинический протокол</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-3xl">Перед началом</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Отвечайте исходя из того, как часто каждый симптом беспокоил вас за <strong>последние 2 недели</strong>. GAD-7 количественно оценивает бремя тревоги относительно валидированных клинических ориентиров. Это инструмент скрининга, а не медицинский диагноз.
            </p>
            <p class="mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Всё работает локально в вашем браузере. Никакие персональные медицинские записи не передаются, не логируются и не сохраняются на внешних серверах.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <button id="begin-assessment" type="button" class="min-h-[44px] rounded-2xl bg-[#0066cc] px-8 py-4 text-base font-bold text-white transition-all hover:bg-[#0071e3] active:scale-[0.97] shadow-lg shadow-blue-600/20 cursor-pointer dark:bg-[#2997ff] dark:hover:bg-[#3b82f6]">
                Начать скрининг GAD-7
              </button>
              <span class="text-[13px] sm:text-sm font-mono text-zinc-500 dark:text-zinc-400">Горячие клавиши: 1–4 для ответа · ← / → для навигации</span>
            </div>
          </div>

          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">GAD-7 · Последние 2 недели</p>
                <p id="question-domain" class="mt-1 text-sm sm:text-base font-bold text-zinc-700 dark:text-zinc-300">Когнитивное / аффективное беспокойство</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-bold sm:text-lg text-zinc-950 dark:text-white">Вопрос 1 из 7</div>
                <div id="progress-label" class="mt-0.5 text-[13px] sm:text-sm font-mono text-zinc-500 dark:text-zinc-400">0% отвечено</div>
              </div>
            </div>

            <div class="mt-4 h-[2px] overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800">
              <div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:4%"></div>
            </div>

            <article class="mt-6 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/90 sm:p-9 shadow-sm">
              <div class="flex flex-wrap gap-2 text-[13px] font-mono text-zinc-500 dark:text-zinc-400">
                <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1">Выберите один ответ</span>
                <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1">Период: последние 2 недели</span>
              </div>

              <h2 id="question-heading" class="mt-5 text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white"></h2>
              <p id="question-context" class="mt-2 text-sm sm:text-base font-medium text-[#0066cc] dark:text-[#2997ff]"></p>

              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Варианты частотных ответов"></div>

              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="min-h-[44px] rounded-2xl border border-zinc-300 bg-white px-6 py-3.5 text-sm font-bold transition active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900 disabled:opacity-40 cursor-pointer">
                  ← Назад
                </button>
                <button id="next-button" type="button" class="min-h-[44px] rounded-2xl bg-[#0066cc] px-7 py-3.5 text-sm font-bold text-white transition active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-[#2997ff] cursor-pointer">
                  Следующий вопрос →
                </button>
              </div>
            </article>
          </section>

          <section id="results-section" class="hidden space-y-8" aria-labelledby="results-title">

            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/90 sm:p-9 shadow-lg">

              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between border-b border-zinc-200 dark:border-zinc-800/80 pb-6">
                <div>
                  <div id="result-badge" class="result-badge minimal">Минимальная тревожность</div>
                  <h2 id="results-title" class="mt-4 text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 dark:text-white">Ваш результат GAD-7</h2>
                  <p id="result-classification" class="mt-1 text-xl font-bold text-[#0066cc] dark:text-[#2997ff]">Минимальная тревожность</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-6 py-4 text-center dark:border-zinc-800 dark:bg-zinc-950">
                  <div class="text-[13px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Суммарный балл GAD-7</div>
                  <div id="result-score" class="mt-1 text-4xl font-black font-mono tracking-tight text-zinc-950 dark:text-white">0 / 21</div>
                </div>
              </div>

              <p id="result-narrative" class="mt-6 text-base sm:text-lg leading-relaxed text-zinc-700 dark:text-zinc-300"></p>

              <div class="mt-8 grid gap-4 sm:grid-cols-2">

                <article class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[13px] font-mono uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] font-bold">Домен когнитивного беспокойства</span>
                    <span id="cognitive-status" class="text-[13px] font-bold text-zinc-500 dark:text-zinc-400">Низкая выраженность</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1">
                    <div id="cognitive-score" class="text-3xl font-black font-mono text-zinc-950 dark:text-white">0 / 12</div>
                    <span class="text-[13px] font-mono text-zinc-500">Пункты 1, 2, 3, 7</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden mt-2">
                    <div id="cognitive-bar" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-500" style="width: 0%"></div>
                  </div>
                  <p class="text-[13px] text-zinc-500 dark:text-zinc-400 leading-normal pt-1">
                    Опасения, неконтролируемость беспокойства, диффузные катастрофические идеи и предвосхищение надвигающейся беды.
                  </p>
                </article>

                <article class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-[13px] font-mono uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] font-bold">Домен соматического напряжения</span>
                    <span id="somatic-status" class="text-[13px] font-bold text-zinc-500 dark:text-zinc-400">Низкая выраженность</span>
                  </div>
                  <div class="flex items-baseline justify-between pt-1">
                    <div id="somatic-score" class="text-3xl font-black font-mono text-zinc-950 dark:text-white">0 / 9</div>
                    <span class="text-[13px] font-mono text-zinc-500">Пункты 4, 5, 6</span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden mt-2">
                    <div id="somatic-bar" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-500" style="width: 0%"></div>
                  </div>
                  <p class="text-[13px] text-zinc-500 dark:text-zinc-400 leading-normal pt-1">
                    Нервно-мышечное напряжение, трудности с расслаблением, психомоторное беспокойство и раздражительность нервной системы.
                  </p>
                </article>

              </div>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Клиническая стратификация</p>
                <h3 class="mt-1 text-xl font-bold sm:text-2xl text-zinc-950 dark:text-white">Спектр тяжести</h3>
                <div id="severity-scale" class="mt-5 space-y-2"></div>
              </article>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Распределение симптомов</p>
                <h3 class="mt-1 text-xl font-bold sm:text-2xl text-zinc-950 dark:text-white">Разбор подшкал</h3>
                <div id="profile-matrix" class="mt-5 space-y-4"></div>
              </article>

              <div class="mt-6 grid gap-4 sm:grid-cols-3">
