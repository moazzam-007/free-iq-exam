---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Тест на аутизм онлайн - бесплатный скрининг AQ-10 для взрослых с профилем черт | FreeIQExam';
const description = 'Пройдите бесплатный скрининг аутизма у взрослых по методике AQ-10. Разбор социальной коммуникации, сенсорики, переключения внимания и систематизирующих черт с интерактивным радарным профилем. Без e-mail.';
const canonicalUrl = 'https://freeiqexam.com/ru/autism-test';

const faqItems = [
  ['Может ли онлайн-тест на аутизм диагностировать аутизм?', 'Нет. Онлайн-скрининг, такой как AQ-10, может выявить паттерны черт, которые могут обосновать более полную оценку, но сам по себе он не может диагностировать аутизм. Формальный диагноз требует комплексной оценки квалифицированными клиницистами, включая историю развития, структурированное наблюдение или интервью и рассмотрение альтернативных объяснений.'],
  ['Что на самом деле означает балл AQ-10 6 и выше?', 'Балл 6 и более из 10 - это порог направления, используемый в клинических руководствах: он указывает на клинически значимые аутичные черты и обосновывает обращение за комплексной диагностической оценкой к специализированной команде. Это не означает, что вы аутист - оригинальная валидационная работа показала хорошую, но несовершенную чувствительность и специфичность, поэтому возможны и ложноположительные, и ложноотрицательные результаты.'],
  ['Почему так много взрослых - особенно женщин - диагностируют поздно?', 'Многие взрослые аутисты, и непропорционально часто женщины, учатся камуфлировать или маскировать свои черты: репетируют разговоры, заставляют себя поддерживать зрительный контакт, подавляют стимминг и изучают социальные правила интеллектуально. Маскировка может скрывать наблюдаемые черты от клиницистов, учителей и даже семьи, откладывая распознавание до тех пор, пока способность справляться не рухнет - часто как выгорание во взрослом возрасте. Скрининг, отвеченный честно о внутреннем опыте, может выявить то, что маскирует маскировка.'],
  ['Как аутизм и СДВГ пересекаются? Что такое AuDHD?', 'Аутизм и СДВГ часто сосуществуют - оценки предполагают, что значительная часть аутистов также соответствует критериям СДВГ, и наоборот. Оба могут включать различия исполнительных фун��ций, трудности регуляции внимания и сенсорную чувствительность, поэтому важна тщательная дифференциальная оценка. AuDHD - это термин сообщества для обладания обоими; клинически каждое состояние оценивается по собственным критериям, признавая, что они взаимодействуют.'],
  ['Могут ли быть сенсорные различия без аутизма?', 'Да. Сенсорная гипер- или гипореактивность встречается при СДВГ, тревоге, ПТСР и в общей популяции, и одна сенсорная черта сама по себе ничего не доказывает. При аутизме сенсорные различия обычно появляются вместе со стойкими различиями социальной коммуникации и ограниченными, повторяющимися паттернами поведения или интересов, присутствующими с раннего развития. Паттерн по доменам значит больше, чем любой отдельный пункт.'],
  ['Что такое стимминг и нужно ли его прекращать?', 'Стимминг - повторяющиеся движения, звуки или суетливость, такие как раскачивание, взмахи руками, гудение или постукивание, - это форма саморегуляции: он может сбрасывать избыточную энергию, успокаивать при перегрузке или поддерживать фокус. Клиницисты обычно не нацелены на устранение безвредного стимминга; поддержка фокусируется на понимании его функции и обеспечении безопасных, принимаемых способов регуляции, с вмешательством только там, где поведение причиняет вред.'],
  ['Какие приспособления помогают взрослым аутистам на работе или в университете?', 'Часто полезные адаптации включают чёткие письменные инструкции и ожидания, предсказуемое расписание с предварительным уведомлением об изменениях, более тихое рабочее место или шумоподавляющие наушники, снижение флуоресцентного или мерцающего освещения, разрешение общаться письменно и структурированные перерывы в длительные социальные или сенсорно-интенсивные периоды. Во многих юрисдикциях работодатели и преподаватели обязаны рассматривать разумные приспособления - формальный диагноз может усилить такие запросы, но не всегда является обязательным условием для неформальных.'],
  ['Как мне получить формальную оценку аутизма во взрослом возрасте?', 'Начните с врача первичного звена, который может направить вас в службу помощи взрослым с аутизмом, к нейропсихологу, психиатру или мультидисциплинарной команде. Подготовьте конкретные примеры из жизни по социальной сфере, сенсорному опыту, рутинам и интересам - включая детские паттерны из школьных отчётов или семейных воспоминаний, где возможно. Спросите, что включает оценка, упомяните маскировку прямо и возьмите эту сводку скрининга как структурированную отправную точку.']
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Спектральный коэффициент аутизма (AQ-10) для взрослых',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Screening',
    isAccessibleForFree: true,
    inLanguage: 'ru'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Бесплатный опросник скрининга аутизма у взрослых с профилем черт',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Управление ответами с клавиатуры, видимые состояния фокуса, семантические заголовки, live-объявления и результаты для печати.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://freeiqexam.com/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Когнитивные игры', item: 'https://freeiqexam.com/ru/games' },
      { '@type': 'ListItem', position: 3, name: 'Тест на аутизм', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Опросник скрининга аутизма у взрослых - 10 пунктов',
    url: canonicalUrl,
    numberOfQuestions: 10,
    isAccessibleForFree: true,
    inLanguage: 'ru'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text }
    }))
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/autism-test" idPath="/tes-autisme" schema={schemas}>
  <Header currentPath="/autism-test" enPath="/autism-test" idPath="/tes-autisme" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Хлебные крошки" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Главная</a><span aria-hidden="true">/</span>
        <a href="/ru/games" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Когнитивные игры</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Тест на аутизм</span>
      </nav>

      <header class="relative mx-auto max-w-4xl text-center">
        <div class="aut-hero-glow" aria-hidden="true"></div>
        <div class="relative inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-zinc-100 px-4 py-2 text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 sm:text-sm">
          <span aria-hidden="true" class="text-base font-extrabold">∞</span> AQ-10 · Скрининг для взрослых по стандартам NICE
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-[-0.025em] leading-[1.08] sm:text-5xl md:text-6xl">Тест на аутизм онлайн</h1>
        <p class="mx-auto mt-6 max-w-3xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Пройдите бесплатный опросник скрининга аутизма у взрослых на основе методики AQ-10. Разбор социальной коммуникации, сенсорики и фокуса на деталях, переключения внимания и систематизирующих черт - визуализированных на интерактивном радарном профиле - без запроса e-mail.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['10 вопросов', 'Четыре варианта ответа', 'Радарный профиль черт', 'Без регистрации'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="autism-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">
          <div id="assessment-intro" class="border-t border-zinc-200 pt-6 dark:border-zinc-800 sm:pt-8">
            <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Перед началом</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Скрининг - это не диагноз</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Отвечайте исходя из вашего типичного, повседневного опыта - а не из того, как вы действуете, когда сознательно маскируетесь или играете роль. Скрининг оценивает выраженность черт относительно порога направления AQ-10. Он не может подтвердить аутизм и не заменяет клиническую оценку.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-assessment" type="button" class="min-h-[44px] rounded-full bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition hover:bg-[#0071e3] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:bg-[#2997ff] dark:hover:bg-[#3b82f6]">Начать скрининг аутизма</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Клавиатура: 1–4 для ответа · ← / → для на��игации</span>
            </div>
          </div>

          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">AQ-10 · Скрининг аутизма у взрослых</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-700 dark:text-zinc-300">Социальная коммуникация</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold sm:text-lg">Вопрос 1 из 10</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">0% отвечено</div>
              </div>
            </div>
            <div class="mt-5 h-[2px] overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:4%"></div></div>
            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-wrap gap-2 text-sm font-semibold text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Выберите один вариант</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Определённо согласен → Определённо не согласен</span>
              </div>
              <h2 id="question-heading" class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl"></h2>
              <p id="question-context" class="mt-3 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg"></p>
              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Варианты ответов по согласию"></div>
              <p class="mt-6 rounded-2xl border border-zinc-200 bg-zinc-50 px-5 py-4 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 sm:text-base">Выделенные варианты - это ответы, которые дают 1 балл по текущему пункту.</p>
              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="min-h-[44px] rounded-full border border-zinc-300 bg-white px-6 py-3.5 text-base font-semibold active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900">Назад</button>
                <button id="next-button" type="button" class="min-h-[44px] rounded-full bg-[#0066cc] px-7 py-3.5 text-base font-semibold text-white active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-[#2997ff]">Следующий вопрос</button>
              </div>
            </article>
          </section>

          <section id="results-section" class="hidden" aria-labelledby="results-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div id="result-badge" class="result-badge low">Ниже клинического порога направления</div>
                  <h2 id="results-title" class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">Ваш профиль скрининга</h2>
                  <p id="result-classification" class="mt-2 text-xl font-bold text-[#0066cc] dark:text-[#2997ff]">Слабо выраженный паттерн черт</p>
                </div>
                <div class="rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-center dark:border-zinc-800 dark:bg-zinc-900">
                  <div id="result-score" class="text-3xl font-extrabold">0 / 10</div>
                  <div id="threshold-status" class="mt-1 text-sm font-semibold text-zinc-600 dark:text-zinc-300">Ниже порога направления 6</div>
                </div>
              </div>
              <div class="mt-3 rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-semibold text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 sm:text-base">Это не диагноз</div>
              <p id="result-narrative" class="mt-6 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg"></p>

              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <article class="score-card"><div class="score-label">Социальная коммуникация</div><div id="social-score" class="mt-3 text-3xl font-extrabold">0 / 5</div><div id="social-status" class="score-status">Минимальная выраженность</div><div class="meter"><span id="social-bar"></span></div></article>
                <article class="score-card"><div class="score-label">Сенсорика и внимание к деталям</div><div id="sensory-score" class="mt-3 text-3xl font-extrabold">0 / 2</div><div id="sensory-status" class="score-status">Минимальная выраженность</div><div class="meter"><span id="sensory-bar"></span></div></article>
                <article class="score-card"><div class="score-label">Переключение внимания</div><div id="attention-score" class="mt-3 text-3xl font-extrabold">0 / 2</div><div id="attention-status" class="score-status">Минимальная выраженность</div><div class="meter"><span id="attention-bar"></span></div></article>
                <article class="score-card"><div class="score-label">Систематизирующие интересы</div><div id="systematizing-score" class="mt-3 text-3xl font-extrabold">0 / 1</div><div id="systematizing-status" class="score-status">Минимальная выраженность</div><div class="meter"><span id="systematizing-bar"></span></div></article>
              </div>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-sm">Радар черт · четыре измерения</p>
                <h3 class="mt-2 text-xl font-bold sm:text-2xl">Ваш профиль подшкал</h3>
                <div class="relative mx-auto mt-4 max-w-[26.5rem]">
                  <canvas id="radar-chart" role="img" aria-label="Радарная диаграмма четырёх подшкал черт AQ-10"></canvas>
                  <div id="radar-tooltip" class="radar-tooltip hidden" role="status"></div>
                </div>
                <p class="mt-3 text-center text-sm text-zinc-500 dark:text-zinc-400">Наведите на вершину для деталей. Каждая ось масштабирована по своему максимуму.</p>
              </article>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-sm">Порог направления · отсечка 6</p>
                <h3 class="mt-2 text-xl font-bold sm:text-2xl">Где находится ваш балл</h3>
                <div id="threshold-scale" class="mt-5 grid grid-cols-11 gap-1" aria-hidden="true"></div>
                <div class="mt-3 flex justify-between text-[13px] font-semibold text-zinc-500 dark:text-zinc-400 sm:text-sm"><span>0 · минимальные черты</span><span class="text-[#0066cc] dark:text-[#2997ff]">6 · порог направления</span><span>10 · максимум</span></div>
              </article>

              <article class="mt-6 rounded-3xl border border-zinc-200 p-6 dark:border-zinc-800">
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 sm:text-sm">Срез по доменам черт</p>
                <h3 class="mt-2 text-xl font-bold sm:text-2xl">Разбор по пунктам</h3>
                <div id="profile-matrix" class="mt-6 space-y-5"></div>
              </article>

              <article class="mt-6 rounded-3xl border border-zinc-200 bg-zinc-50/60 p-6 dark:border-zinc-800 dark:bg-zinc-900/40">
                <h3 class="text-xl font-bold sm:text-2xl">Рекомендуемые следующие шаги</h3>
                <ul id="next-steps-list" class="mt-4 space-y-3"></ul>
              </article>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="print-result" type="button" class="min-h-[44px] rounded-full bg-[#0066cc] px-7 py-4 text-base font-semibold text-white active:scale-[0.97] dark:bg-[#2997ff]">Печать сводки черт</button>
                <button id="share-result" type="button" class="min-h-[44px] rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold active:scale-[0.97] dark:border-zinc-700">Поделиться сводкой</button>
                <button id="retake-result" type="button" class="min-h-[44px] rounded-full border border-zinc-300 px-6 py-4 text-base font-semibold active:scale-[0.97] dark:border-zinc-700">Пройти заново</button>
              </div>

              <div class="mt-8 rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900">
                <h3 class="text-xl font-bold sm:text-2xl">Как читать результат в контексте</h3>
                <p class="mt-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">Балл 6 и выше означает, что паттерн ответов пересёк порог направления этой методики. Это не устанавливает аутизм, степень тяжести или потребности в поддержке. Камуфляж может занижать баллы у людей с высокой маскировкой, тогда как СДВГ, социальная тревога, депрессия, реакции на травму и различия сенсорной обработки могут каждый повышать части этого паттерна. Специализированная оценка взвешивает полную картину развития - никогда одно число.</p>
              </div>
            </div>
          </section>

