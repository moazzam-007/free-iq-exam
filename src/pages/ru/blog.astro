---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Блог о когнитивной науке и психометрии | FreeIQExam";
const description = "Научно обоснованные разборы: шкала IQ, процентили, эффект Флинна, матричное мышление и подготовка к Mensa.";

const featuredPost = {
  title: "The Comprehensive IQ Шкала классификации: WAIS-IV, Stanford-Binet 5, and the Колоколообразная кривая",
  slug: "/iq-classification-scale",
  category: "Psychometrics & Scales",
  categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
  readTime: "8 min read",
  date: "September 2026",
  author: "Psychometrics Research Group",
  excerpt: "A deep comparative analysis of modern intelligence classifications. Learn how Wechsler, Stanford-Binet, and Woodcock-Johnson define Very Superior, Gifted, and Average cognitive ability across the standard normal distribution."
};

const articles = [
  {
    title: "Сообщества высокого IQ Compared: Mensa, Intertel, and Общество Triple Nine",
    slug: "/high-iq-societies",
    category: "Сообщества высокого IQ",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "7 min read",
    date: "September 2026",
    author: "Psychometrics Research Group",
    excerpt: "Explore admission cutoffs, qualifying prior evidence tests (SAT, GRE, ACT), and membership standards for the world's most prestigious high-IQ organizations."
  },
  {
    title: "Carpenter's 5 Rules: Decoding Abstract Matrix Reasoning & Raven's Matrices",
    slug: "/matrix-reasoning-test",
    category: "Когнитивная тренировка",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "6 min read",
    date: "September 2026",
    author: "Evaluation Science Team",
    excerpt: "Master the cognitive rule hierarchy first documented by Carpenter, Just, and Shell (1990). Learn how to identify XOR cancellation, quantitative progressions, and distribution patterns."
  },
  {
    title: "Средний IQ by Age: Lifespan Cognitive Trajectories, Peak Ability & the Эффект Флинна",
    slug: "/average-iq-by-age",
    category: "Lifespan Psychology",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "7 min read",
    date: "September 2026",
    author: "Developmental Science Group",
    excerpt: "Why is the population median IQ always 100 at every age? Examine fluid intelligence decline curves vs crystallized vocabulary stability, and secular generational drift."
  },
  {
    title: "Подготовка к тесту Mensa: культурно-нейтральные задания и стратегия квалификации",
    slug: "/mensa-iq-test-practice",
    category: "Test Preparation",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "6 min read",
    date: "September 2026",
    author: "Assessment Preparation Team",
    excerpt: "Practical preparation strategies for the supervised Mensa Admissions Test. Learn how non-verbal matrix induction and speeded spatial reasoning are evaluated under timed conditions."
  },
  {
    title: "Understanding the IQ Колоколообразная кривая: Стандартное отклонениеs, Редкость & Процентильs",
    slug: "/iq-score-chart",
    category: "Statistical Measurement",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "5 min read",
    date: "September 2026",
    author: "Psychometrics Research Group",
    excerpt: "Demystify Gaussian distribution bands, standard deviation conversions (SD 15 vs SD 16 vs SD 24), and understand what an IQ score really signifies in population terms."
  },
  {
    title: "2PL Вопрос Response Theory & Bayesian EAP Scoring: The FreeIQExam Whitepaper",
    slug: "/methodology",
    category: "Technical Методология",
    categoryColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700/80",
    readTime: "12 min read",
    date: "September 2026",
    author: "Core Psychometrics Team",
    excerpt: "Full mathematical documentation of our 2-Parameter Logistic IRT model, Gauss-Hermite quadrature over 81 nodes, 95% Posterior Credible Intervals, and Harvard Dataverse DOIs."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "FreeIQExam Когнитивная наука & Psychometrics Блог",
  "description": description,
  "url": "https://freeiqexam.com/ru/blog"
};
---

<Layout title={title} description={description} schema={schema} enPath="/blog" idPath="/blog" canonicalUrl="https://freeiqexam.com/ru/blog">
  <Header currentPath="/blog"  enPath="/blog" idPath="/blog"/>

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Блог &amp; Articles</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-semibold uppercase tracking-wider mb-4">
        COGNITIVE RESEARCH &bull; PSYCHOMETRIC GUIDES &bull; ARTICLES
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Cognitive Science &amp; Psychometrics Блог
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Evidence-based guides, psychometric methodologies, and empirical research on human intelligence, matrix reasoning, and cognitive measurement.
      </p>
    </header>

    <!-- Featured Pillar Article Card -->
    <section class="mb-14 sm:mb-16">
      <div class="relative group rounded-3xl overflow-hidden border border-zinc-200/90 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm p-6 sm:p-10 shadow-sm hover:shadow-md transition-all">
        <div class="flex flex-col lg:flex-row gap-8 items-start justify-between">
          <div class="max-w-2xl">
            <div class="flex flex-wrap items-center gap-2.5 mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-mono font-semibold border ${featuredPost.categoryColor}`}>
                {featuredPost.category}
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Featured Research Guide</span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">&bull;</span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">{featuredPost.readTime}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-4">
              <a href={featuredPost.slug}>{featuredPost.title}</a>
            </h2>

            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              {featuredPost.excerpt}
            </p>

            <div class="flex items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400">
              <span class="font-medium text-zinc-700 dark:text-zinc-300">{featuredPost.author}</span>
              <span>&bull;</span>
              <span>{featuredPost.date}</span>
            </div>
          </div>

          <div class="shrink-0 w-full lg:w-auto flex lg:flex-col justify-end">
            <a
              href={featuredPost.slug}
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all hover:scale-105 active:scale-[0.97] w-full sm:w-auto"
            >
              <span>Read Full Guide</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Articles Grid Section -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-zinc-200 dark:border-zinc-800">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-zinc-950 dark:text-white">
          All Research Guides &amp; Articles
        </h2>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          {articles.length + 1} Publications
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((article) => (
          <article class="flex flex-col justify-between rounded-2xl p-6 bg-white/80 dark:bg-zinc-900/80 border border-zinc-200/90 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md transition-all group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold border ${article.categoryColor}`}>
                  {article.category}
                </span>
                <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  {article.readTime}
                </span>
              </div>

              <h3 class="text-lg font-heading font-bold text-zinc-950 dark:text-white mb-2 leading-snug">
                <a href={article.slug}>{article.title}</a>
              </h3>

              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
                {article.excerpt}
              </p>
            </div>

            <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-xs">
              <span class="text-zinc-500 dark:text-zinc-400 font-mono">{article.date}</span>
              <a
                href={article.slug}
                class="font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1"
              >
                <span>Read Article</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Assessment CTA Banner -->
    <section class="p-8 sm:p-12 rounded-3xl bg-zinc-900 border border-zinc-800 text-white text-center shadow-lg relative overflow-hidden">
      <h2 class="font-heading font-extrabold text-2xl sm:text-4xl mb-3 tracking-tight">
        Put the Theory into Практика
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
        Test your abstract matrix reasoning, 3D cube rotations, quantitative logic, and verbal deductions on our standardized, free assessment.
      </p>
      <a
        href="/ru/test"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-sm sm:text-base font-bold text-white bg-blue-600 hover:bg-blue-500 transition-all shadow-md hover:scale-105 active:scale-[0.97]"
      >
        <span>Take Standard Test (20 мин)</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </section>
  </main>

  <Footer />
</Layout>
