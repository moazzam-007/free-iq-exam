                <th class="p-3 font-semibold">Время</th>
                <th class="p-3 font-semibold">Погрешность</th>
                <th class="p-3 font-semibold">Целевое назначение</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 text-zinc-700 dark:text-zinc-300">
              <tr>
