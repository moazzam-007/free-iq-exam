---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const alternates = {
  en: '/calorie-calculator',
  id: '/id/kalkulator-kalori'
};

const title = 'Калькулятор калорий и TDEE онлайн | Расчёт BMR, дефицита и БЖУ';
const description = 'Рассчитайте суточный расход энергии (TDEE), базовый метаболизм (BMR), целевой дефицит/профицит калорий и граммы белков, жиров и углеводов клинически точно.';
const canonicalUrl = 'https://freeiqexam.com/ru/calorie-calculator';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'FreeIQExam Клинический калькулятор калорий, TDEE и БЖУ',
    'url': 'https://freeiqexam.com/ru/calorie-calculator',
    'applicationCategory': 'HealthApplication',
    'operatingSystem': 'All',
    'browserRequirements': 'Требуется поддержка JavaScript',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    },
    'featureList': [
      'Расчёт BMR по формулам Миффлина-Сан Жеора, Кэтча-МакАрдла и Оксфорда',
      'Поддержка метрической (кг/см) и имперской (фунты/дюймы) систем',
      'Калькулятор процента жира по методике ВМС США (шея, талия, бедра)',
      '6 целевых пресетов: Поддержание, Умеренный дефицит (-10%), Стандартный (-20%), Агрессивный (-25%), Набор (+10%), Массонабор (+20%)',
      '4 протокола БЖУ: Сбалансированный, Высокобелковый, Низкоуглеводный/Кето, Выносливость',
      'Индекс энергопотребления мозга глюкозой (~20% от базового метаболизма)',
      'Интерактивная круговая диаграмма распределения макронутриентов 60 FPS',
      '100% конфиденциальные вычисления в браузере без отправки данных'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Главная',
        'item': 'https://freeiqexam.com/ru'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Инструменты',
        'item': 'https://freeiqexam.com/ru#tools'
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': 'Калькулятор калорий и TDEE',
        'item': 'https://freeiqexam.com/ru/calorie-calculator'
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} alternates={alternates} schema={schema}>
  <Header enPath="/calorie-calculator" idPath="/kalkulator-kalori" />

  <main class="flex-1 py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Хлебные крошки">
      <a href="/ru" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-500">Инструменты</span>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Калькулятор калорий и TDEE</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wide bg-blue-50 text-[#0066cc] dark:bg-blue-950/40 dark:text-[#2997ff] border border-blue-200 dark:border-blue-800/60 mb-3">
        Клинический метаболический калькулятор &bull; Формулы Миффлина-Сан Жеора и Кэтча-МакАрдла
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight mb-4">
        Калькулятор калорий, TDEE и БЖУ
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Рассчитайте суточную норму калорий (TDEE), базовый обмен (BMR), целевой дефицит для похудения или профицит для набора массы с точным граммовым распределением макронутриентов.
      </p>
    </header>

    <!-- Calculator Grid Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      
      <!-- Left Column: Input Form (5 cols) -->
      <section class="lg:col-span-5 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-7 shadow-xs">
        <h2 class="text-xl font-heading font-bold text-zinc-950 dark:text-white mb-5 flex items-center gap-2">
          <span>1. Ваши параметры</span>
        </h2>

        <!-- Units Selector -->
        <div class="mb-5">
          <label class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Система мер</label>
          <div class="grid grid-cols-2 gap-2 p-1 bg-zinc-100 dark:bg-zinc-800/70 rounded-xl">
            <button id="unitMetricBtn" type="button" class="py-2 text-sm font-semibold rounded-lg bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs transition-all">Метрическая (кг, см)</button>
            <button id="unitImperialBtn" type="button" class="py-2 text-sm font-semibold rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all">Имперская (фунты, футы)</button>
          </div>
        </div>

        <!-- Gender Selection -->
        <div class="mb-5">
          <label class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Биологический пол</label>
          <div class="grid grid-cols-2 gap-2">
            <button id="genderMaleBtn" type="button" class="py-2.5 px-4 rounded-xl border border-blue-600 bg-blue-50/50 text-[#0066cc] dark:border-blue-500 dark:bg-blue-950/30 dark:text-[#2997ff] font-semibold text-sm flex items-center justify-center gap-2 transition-all">
              <span>Мужской</span>
            </button>
            <button id="genderFemaleBtn" type="button" class="py-2.5 px-4 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50/50 dark:bg-zinc-800/40 text-zinc-700 dark:text-zinc-300 font-semibold text-sm flex items-center justify-center gap-2 hover:border-zinc-300 dark:hover:border-zinc-600 transition-all">
              <span>Женский</span>
            </button>
          </div>
        </div>

        <!-- Metric Inputs -->
        <div id="metricInputContainer" class="grid grid-cols-2 gap-4 mb-5">
          <div>
            <label for="calWeightMetric" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Вес (кг)</label>
            <input id="calWeightMetric" type="number" value="75" min="25" max="300" step="0.5" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div>
            <label for="calHeightMetric" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Рост (см)</label>
            <input id="calHeightMetric" type="number" value="178" min="80" max="250" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
        </div>

        <!-- Imperial Inputs (Hidden by default) -->
        <div id="imperialInputContainer" class="hidden mb-5 space-y-4">
          <div>
            <label for="calWeightImperial" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Вес (фунты)</label>
            <input id="calWeightImperial" type="number" value="165" min="50" max="650" step="1" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="calHeightFeet" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Рост (футы)</label>
              <input id="calHeightFeet" type="number" value="5" min="3" max="8" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
            </div>
            <div>
              <label for="calHeightInches" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Дюймы</label>
              <input id="calHeightInches" type="number" value="10" min="0" max="11" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
            </div>
          </div>
        </div>

        <!-- Age & Optional Body Fat -->
        <div class="grid grid-cols-2 gap-4 mb-5">
          <div>
            <label for="calAge" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Возраст (лет)</label>
            <input id="calAge" type="number" value="28" min="12" max="110" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="calBodyFat" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">% жира (опц.)</label>
              <button id="toggleNavyCalcBtn" type="button" class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 hover:underline">Калькулятор</button>
            </div>
            <input id="calBodyFat" type="number" placeholder="Напр. 18" min="4" max="55" step="0.5" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white font-mono text-base focus:outline-none focus:ring-2 focus:ring-blue-600 placeholder:text-zinc-400" />
          </div>
        </div>

        <!-- Navy Body Fat Estimator Accordion/Box -->
        <div id="navyCalcDrawer" class="hidden mb-5 p-4 rounded-2xl bg-zinc-100 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700">
          <p class="text-xs font-bold text-zinc-800 dark:text-zinc-200 mb-3">Оценка процента жира (ВМС США, см):</p>
          <div class="grid grid-cols-3 gap-2 mb-3">
            <div>
              <label class="block text-[10px] font-mono uppercase text-zinc-500 mb-1">Шея</label>
              <input id="navyNeck" type="number" value="38" class="w-full px-2.5 py-1.5 text-xs font-mono bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-600 rounded-lg text-zinc-900 dark:text-white" />
            </div>
            <div>
              <label class="block text-[10px] font-mono uppercase text-zinc-500 mb-1">Талия</label>
              <input id="navyWaist" type="number" value="84" class="w-full px-2.5 py-1.5 text-xs font-mono bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-600 rounded-lg text-zinc-900 dark:text-white" />
            </div>
            <div id="navyHipContainer" class="hidden">
              <label class="block text-[10px] font-mono uppercase text-zinc-500 mb-1">Бедра</label>
              <input id="navyHip" type="number" value="98" class="w-full px-2.5 py-1.5 text-xs font-mono bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-600 rounded-lg text-zinc-900 dark:text-white" />
            </div>
          </div>
          <button id="applyNavyFatBtn" type="button" class="w-full py-1.5 text-xs font-semibold bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Применить результат жира</button>
        </div>

        <!-- Activity Level (PAL) -->
        <div class="mb-5">
          <label for="calActivity" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Уровень физической активности</label>
          <select id="calActivity" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
            <option value="1.2">Сидячий образ жизни (мало или нет упражнений)</option>
            <option value="1.375">Лёгкая активность (тренировки 1–3 раза в неделю)</option>
            <option value="1.55" selected>Умеренная активность (тренировки 3–5 раз в неделю)</option>
            <option value="1.725">Высокая активность (тяжёлые тренировки 6–7 раз в неделю)</option>
            <option value="1.9">Экстремальная активность (спортсмены, физический труд)</option>
          </select>
        </div>

        <!-- Target Goals -->
        <div class="mb-5">
          <label for="calGoal" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Цель по весу</label>
          <select id="calGoal" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
            <option value="maintenance" selected>Поддержание веса (0 ккал)</option>
            <option value="mild-cut">Умеренный дефицит (-10% ккал &bull; мягкое похудение)</option>
            <option value="standard-cut">Стандартный дефицит (-20% ккал &bull; оптимум)</option>
            <option value="aggressive-cut">Агрессивный дефицит (-25% ккал &bull; быстрое похудение)</option>
            <option value="lean-bulk">Чистый набор массы (+10% ккал &bull; минимум жира)</option>
            <option value="heavy-bulk">Интенсивный набор (+20% ккал &bull; максимум силы)</option>
          </select>
        </div>

        <!-- Macro Diet Protocol -->
        <div>
          <label for="calProtocol" class="block text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">Пропорции макронутриентов (БЖУ)</label>
          <select id="calProtocol" class="w-full px-4 py-2.5 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-950 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
            <option value="balanced" selected>Сбалансированный (30% Белок, 30% Жиры, 40% Углеводы)</option>
            <option value="high-protein">Высокобелковый (40% Белок, 25% Жиры, 35% Углеводы)</option>
            <option value="keto">Низкоуглеводный / Кето (25% Белок, 70% Жиры, 5% Углеводы)</option>
            <option value="endurance">Выносливость (20% Белок, 20% Жиры, 60% Углеводы)</option>
          </select>
        </div>

      </section>

      <!-- Right Column: Interactive Results Dashboard (7 cols) -->
      <section class="lg:col-span-7 space-y-6">
        
        <!-- Main Target Calories Card -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-xs relative overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-3">
            <div>
              <span class="text-xs font-mono font-bold tracking-wider uppercase text-[#0066cc] dark:text-[#2997ff]">Суточная норма калорий</span>
              <h2 id="resTargetCalories" class="text-4xl sm:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tabular-nums tracking-tight mt-1">
                2,450
              </h2>
            </div>
            <div class="text-left sm:text-right">
              <span id="resDeltaVal" class="inline-block text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                0 ккал
              </span>
            </div>
          </div>
          <p id="resGoalDesc" class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
            Поддержание (0 ккал) &bull; Метаболическое равновесие и рекомпозиция
          </p>

          <!-- Metrics Comparison Pill Group -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-5 border-t border-zinc-100 dark:border-zinc-800/80">
            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-2xl">
              <span class="block text-[11px] font-mono text-zinc-500 uppercase">TDEE (Расход)</span>
              <span id="resTdeeVal" class="text-lg font-bold font-mono text-zinc-950 dark:text-white tabular-nums">2,450</span>
              <span class="text-[10px] text-zinc-400 block">ккал/день</span>
            </div>
            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-2xl">
              <span class="block text-[11px] font-mono text-zinc-500 uppercase">BMR (Базовый)</span>
              <span id="resBmrVal" class="text-lg font-bold font-mono text-zinc-950 dark:text-white tabular-nums">1,720</span>
              <span class="text-[10px] text-zinc-400 block">ккал/день</span>
            </div>
            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-2xl">
              <span class="block text-[11px] font-mono text-zinc-500 uppercase">ИМТ (BMI)</span>
              <span id="resBmiVal" class="text-lg font-bold font-mono text-zinc-950 dark:text-white tabular-nums">23.7</span>
              <span id="resBmiCategory" class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 block">Норма</span>
            </div>
            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-2xl">
              <span class="block text-[11px] font-mono text-zinc-500 uppercase">Мозг (~20%)</span>
              <span id="neuroBrainKcal" class="text-lg font-bold font-mono text-zinc-950 dark:text-white tabular-nums">344</span>
              <span class="text-[10px] text-zinc-400 block">ккал глюкозы</span>
            </div>
          </div>
        </div>

        <!-- Macronutrients Interactive Doughnut & Breakdown -->
        <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-xs">
          <h3 class="text-lg font-heading font-bold text-zinc-950 dark:text-white mb-6">
            Целевое распределение макронутриентов (БЖУ)
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            
            <!-- Canvas Doughnut Chart (5 cols) -->
            <div class="md:col-span-5 flex flex-col items-center justify-center">
              <div class="relative w-44 h-44 sm:w-48 sm:h-48">
                <canvas id="macroChartCanvas" class="w-full h-full block"></canvas>
                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center">
                  <span class="text-xs font-mono text-zinc-400 uppercase">Макро</span>
                  <span class="text-lg font-bold font-heading text-zinc-900 dark:text-white">100%</span>
                </div>
              </div>
            </div>

            <!-- Grams and Calories Details (7 cols) -->
            <div class="md:col-span-7 space-y-3.5">
              
              <!-- Protein -->
              <div class="p-3.5 rounded-2xl bg-blue-50/60 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="w-3.5 h-3.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
                  <div>
                    <h4 class="text-sm font-bold text-zinc-900 dark:text-white">Белки (4 ккал/г)</h4>
                    <span id="macroProteinKcal" class="text-xs text-zinc-500 dark:text-zinc-400">735 ккал (30%)</span>
                  </div>
                </div>
                <span id="macroProteinGrams" class="text-xl font-heading font-extrabold text-blue-600 dark:text-blue-400 tabular-nums">184 г</span>
              </div>

              <!-- Fats -->
              <div class="p-3.5 rounded-2xl bg-amber-50/60 dark:bg-amber-950/20 border border-amber-100 dark:border-amber-900/40 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="w-3.5 h-3.5 rounded-full bg-amber-500"></span>
                  <div>
                    <h4 class="text-sm font-bold text-zinc-900 dark:text-white">Жиры (9 ккал/г)</h4>
                    <span id="macroFatKcal" class="text-xs text-zinc-500 dark:text-zinc-400">735 ккал (30%)</span>
                  </div>
                </div>
                <span id="macroFatGrams" class="text-xl font-heading font-extrabold text-amber-600 dark:text-amber-400 tabular-nums">82 г</span>
              </div>

              <!-- Carbs -->
              <div class="p-3.5 rounded-2xl bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-100 dark:border-emerald-900/40 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-500"></span>
                  <div>
                    <h4 class="text-sm font-bold text-zinc-900 dark:text-white">Углеводы (4 ккал/г)</h4>
