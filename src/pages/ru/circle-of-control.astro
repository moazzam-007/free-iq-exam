---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const alternates = {
  en: '/circle-of-control',
  id: '/id/lingkaran-kendali'
};

const title = 'Круг контроля и влияния: интерактивная практика стоицизма | FreeIQExam';
const description = 'Интерактивный круг контроля Эпиктета и Кови: распределите заботы, влияние и личный контроль. Практика стоицизма и ясности ума онлайн.';
const canonicalUrl = 'https://freeiqexam.com/ru/circle-of-control';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'Интерактивный круг контроля и влияния: стоическая практика ясности',
    'url': 'https://freeiqexam.com/ru/circle-of-control',
    'applicationCategory': 'LifestyleApplication',
    'operatingSystem': 'All',
    'browserRequirements': 'Требуется поддержка JavaScript',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    },
    'featureList': [
      'Интерактивная 3-зонная модель кругов (Контроль, Влияние, Заботы)',
      'Быстрая сортировка тревог и ситуаций с авто-определением радиуса',
      '4 готовых стоических сценария (работа, отношения, финансы, здоровье)',
      'Расчет индекса личного контроля и коэффициента влияния в реальном времени',
      'Стоический инструмент переосмысления (рефрейминг) по Эпиктету',
      'Экспорт плана действий (.txt), печать карточки ясности и копирование',
      '100% конфиденциальность: локальные вычисления в браузере без отправки данных'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Главная',
        'item': 'https://freeiqexam.com/ru/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Инструменты',
        'item': 'https://freeiqexam.com/ru/tools'
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': 'Круг контроля',
        'item': 'https://freeiqexam.com/ru/circle-of-control'
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  enPath="/circle-of-control"
  idPath="/id/lingkaran-kendali"
>
  <Header currentPath="/circle-of-control" enPath="/circle-of-control" idPath="/id/lingkaran-kendali" />

  <main class="min-h-screen bg-white dark:bg-black text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">

    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-[13px] font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
          <span>ИНТЕРАКТИВНАЯ ПРАКТИКА · СТОИЧЕСКАЯ ЯСНОСТЬ</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-extrabold tracking-[-0.025em] text-zinc-950 dark:text-white mb-4">
          Круг контроля и личное влияние
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          Разделите то, чем вы управляете напрямую, на что можете влиять косвенно и что находится вне вашей власти. Превратите тревогу в ясный план действий.
        </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16" aria-label="Интерактивный круг контроля">

      <!-- Quick-Add Triage Deck -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-8 mb-8 shadow-xl">
        <label for="worryInput" class="block text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">
          <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /></svg>Запишите тревогу, мысль или ситуацию</span>
        </label>
        <form id="worryForm" class="flex flex-col gap-3">
          <input
            type="text"
            id="worryInput"
            maxlength="120"
            autocomplete="off"
            placeholder="Пример: Что думает руководитель о моем отчете…"
            class="w-full min-h-[44px] bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-2xl px-4 py-3 text-zinc-900 dark:text-zinc-100 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#0066cc] dark:focus:ring-[#2997ff]"
          />
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <button
              type="button"
              id="btnAddControl"
              class="min-h-[44px] py-2.5 rounded-2xl bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white dark:text-zinc-950 font-bold text-[13px] sm:text-sm shadow-md transition-all active:scale-[0.97] cursor-pointer"
            >
              <span class="inline-flex items-center justify-center gap-2"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Полный контроль</span>
            </button>
            <button
              type="button"
              id="btnAddInfluence"
              class="min-h-[44px] py-2.5 rounded-2xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-[13px] sm:text-sm shadow-md transition-all active:scale-[0.97] cursor-pointer"
            >
              <span class="inline-flex items-center justify-center gap-2"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Могу влиять</span>
            </button>
            <button
              type="button"
              id="btnAddConcern"
              class="min-h-[44px] py-2.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:border-zinc-400 font-bold text-[13px] sm:text-sm transition-all active:scale-[0.97] cursor-pointer"
            >
              <span class="inline-flex items-center justify-center gap-2"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Вне контроля</span>
            </button>
          </div>
        </form>

        <!-- Starter chips -->
        <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800/80">
          <p class="text-[13px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-2">Выберите пример для быстрого добавления:</p>
          <div id="starterChips" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <!-- Four 1-Click Preset Scenarios -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
        <button
          type="button"
          data-preset="work"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all hover:-translate-y-0.5 active:scale-[0.97] cursor-pointer group"
        >
          <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff]">Рабочая перегрузка</span>
          <span class="block text-[13px] text-zinc-500 dark:text-zinc-400 mt-0.5">Дедлайны · руководство · задачи</span>
        </button>
        <button
          type="button"
          data-preset="relationship"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all hover:-translate-y-0.5 active:scale-[0.97] cursor-pointer group"
        >
          <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff]">Отношения и социум</span>
          <span class="block text-[13px] text-zinc-500 dark:text-zinc-400 mt-0.5">Одобрение · границы · диалог</span>
        </button>
        <button
          type="button"
          data-preset="financial"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all hover:-translate-y-0.5 active:scale-[0.97] cursor-pointer group"
        >
          <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7" /><polyline points="16 17 22 17 22 11" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff]">Финансовая неопределенность</span>
          <span class="block text-[13px] text-zinc-500 dark:text-zinc-400 mt-0.5">Инфляция · рынок · бюджет</span>
        </button>
        <button
          type="button"
          data-preset="health"
          class="min-h-[44px] text-left p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-all hover:-translate-y-0.5 active:scale-[0.97] cursor-pointer group"
        >
          <svg class="w-6 h-6 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" /><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" /></svg>
          <span class="block font-bold text-sm text-zinc-950 dark:text-white mt-1.5 group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff]">Здоровье и самочувствие</span>
          <span class="block text-[13px] text-zinc-500 dark:text-zinc-400 mt-0.5">Привычки · генетика · сон</span>
        </button>
      </div>

      <!-- Concentric Arena -->
      <div class="bg-zinc-950 text-white border border-zinc-800 rounded-3xl p-4 sm:p-8 mb-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-16 -right-16 w-56 h-56 bg-[#0066cc]/10 dark:bg-[#2997ff]/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 relative">
          <div>
            <h2 class="text-base sm:text-lg font-extrabold">Интерактивные сферы</h2>
            <p id="countText" class="text-[13px] font-mono text-zinc-400" aria-live="polite">0 ситуаций на круге</p>
          </div>
          <div class="flex items-center gap-2 text-[13px] font-mono">
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>Kendali</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-sky-400"></span>Pengaruh</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-zinc-400"></span>Perhatian</span>
          </div>
        </div>

        <div
          id="cocArena"
          class="coc-arena"
          role="application"
          aria-label="Интерактивные круги. Перетаскивайте карточки по радиусам или используйте кнопки."
        >
          <svg viewBox="0 0 100 100" class="coc-rings" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs>
              <radialGradient id="cocConcernGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#71717a" stop-opacity="0.02"></stop>
                <stop offset="100%" stop-color="#71717a" stop-opacity="0.10"></stop>
              </radialGradient>
              <radialGradient id="cocInfluenceGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.03"></stop>
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.12"></stop>
              </radialGradient>
              <radialGradient id="cocControlGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#0066cc" stop-opacity="0.08"></stop>
                <stop offset="100%" stop-color="#0066cc" stop-opacity="0.22"></stop>
              </radialGradient>
              <filter id="cocGlow" x="-40%" y="-40%" width="180%" height="180%">
                <feGaussianBlur stdDeviation="1.2" result="blur"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="blur"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>
            <!-- Outer: Concern -->
            <circle id="ringConcern" cx="50" cy="50" r="47" class="coc-ring coc-ring-concern" filter="url(#cocGlow)"></circle>
            <!-- Middle: Influence -->
            <circle id="ringInfluence" cx="50" cy="50" r="34" class="coc-ring coc-ring-influence" filter="url(#cocGlow)"></circle>
            <!-- Inner: Control -->
            <circle id="ringControl" cx="50" cy="50" r="20" class="coc-ring coc-ring-control" filter="url(#cocGlow)"></circle>
            <circle cx="50" cy="50" r="2.2" class="coc-core"></circle>
            <text x="50" y="49.2" text-anchor="middle" class="coc-svg-title">KENDALI</text>
            <text x="50" y="52.6" text-anchor="middle" class="coc-svg-sub">pilihan · ikhtiar · respons</text>
            <text x="50" y="24" text-anchor="middle" class="coc-svg-zone">PENGARUH</text>
            <text x="50" y="6.5" text-anchor="middle" class="coc-svg-zone coc-svg-zone-outer">PERHATIAN - LEPASKAN</text>
          </svg>
          <div id="cocCards" class="coc-cards"></div>
          <div id="cocEmpty" class="coc-empty">
            <strong>Visualisasikan apa yang ada di pikiran Anda.</strong>
            <span>Tambahkan kekhawatiran di atas atau muat prasetel, lalu geser kartu ke cincin yang sesuai.</span>
          </div>
        </div>
        <p class="text-[13px] font-mono text-zinc-400 mt-3 relative">Petunjuk: Posisi penempatan otomatis mengklasifikasikan cincin · Dalam = Kendali, Tengah = Pengaruh, Luar = Perhatian.</p>

        <!-- Live ratio scorecards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5 relative" aria-live="polite">
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-800 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">Индекс контроля</span>
            <span id="statAgency" class="text-3xl font-black font-mono text-[#0066cc] dark:text-[#2997ff]">-</span>
            <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden mt-2">
              <div id="agencyBar" class="coc-bar-fill" style="width: 0%;"></div>
            </div>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-[#0066cc]/30 dark:border-[#2997ff]/30 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider mb-1 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Kendali</span>
            <span id="statControl" class="text-3xl font-black font-mono text-[#0066cc] dark:text-[#2997ff]">0</span>
            <span id="ringCountControl" class="text-[12px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-sky-500/30 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider mb-1 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Pengaruh</span>
            <span id="statInfluence" class="text-3xl font-black font-mono text-sky-300">0</span>
            <span id="ringCountInfluence" class="text-[12px] text-zinc-500 block mt-1"></span>
          </div>
          <div class="bg-zinc-900/80 p-4 rounded-2xl border border-zinc-700 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider mb-1 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Perhatian</span>
            <span id="statConcern" class="text-3xl font-black font-mono text-zinc-300">0</span>
            <span id="ringCountConcern" class="text-[12px] text-zinc-500 block mt-1"></span>
          </div>
        </div>
        <p id="agencyDiagnostic" class="text-[13px] text-zinc-400 mt-3 relative">Tambahkan situasi untuk melihat diagnostik agensi Anda.</p>
      </div>

      <!-- Stoic Action Plan -->
      <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 mb-8 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-zinc-950 dark:text-white">Rencana Aksi Stoik Anda</h2>
            <p id="planIntro" class="text-[13px] text-zinc-500 dark:text-zinc-400 mt-1">Klasifikasikan situasi pertama Anda untuk menghasilkan rencana aksi yang jelas.</p>
          </div>
          <span class="text-[13px] font-mono px-3 py-1 rounded-full bg-blue-600/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400 border border-blue-600/30 font-semibold">Tindak · Bentuk · Ikhlaskan</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-5">
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-[#0066cc]/30 dark:border-[#2997ff]/30">
            <h3 class="text-[13px] font-mono font-bold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] mb-2 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>Fokus - bertindak dengan kebajikan</h3>
            <ul id="planFocusList" class="space-y-1.5 text-[14px] text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-sky-500/30">
            <h3 class="text-[13px] font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-300 mb-2 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 1a5 5 0 0 1 0 10z" fill="currentColor" /></svg>Bentuk - pengaruhi dengan bijak</h3>
            <ul id="planInfluenceList" class="space-y-1.5 text-[14px] text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700">
            <h3 class="text-[13px] font-mono font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2 inline-flex items-center gap-1.5"><svg class="w-3 h-3" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>Ikhlaskan - terima & bersiap</h3>
            <ul id="planReleaseList" class="space-y-1.5 text-[14px] text-zinc-700 dark:text-zinc-300 leading-relaxed list-disc pl-4"></ul>
          </div>
        </div>

