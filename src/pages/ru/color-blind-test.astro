---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const alternates = {};

const title = "Тест на дальтонизм онлайн: таблицы Исихары и Рабкина | FreeIQExam";
const description = "Пройдите бесплатный тест на дальтонизм онлайн: 22 полихроматические таблицы для проверки цветового зрения, дейтеранопии, протанопии и тританопии. Мгновенный результат.";
const canonicalUrl = "https://freeiqexam.com/ru/color-blind-test";

const faqItems = [
  {
    name: "В чём разница между таблицами Исихары и таблицами Рабкина?",
    answer: "Таблицы Исихары (1917) — признанный во всём мире золотой стандарт выявления врождённых красно-зелёных дефектов зрения (дейтеранопии и протанопии). Таблицы Рабкина (1936) широко применяются в клинической практике для более тонкой дифференциации степени аномалии цветовосприятия и дополнительной диагностики сине-жёлтых дефектов (тританопии)."
  },
  {
    name: "Что такое протанопия, дейтеранопия и тританопия?",
    answer: "Это три формы дихромазии: протанопия вызвана отсутствием фотопигмента длинноволновых колбочек (L-колбочек, отвечающих за красный спектр); дейтеранопия обусловлена отсутствием пигмента средневолновых колбочек (M-колбочек, зелёный спектр); тританопия — редкое нарушение восприятия сине-жёлтой части спектра (S-колбочки)."
  },
  {
    name: "Может ли онлайн-тест на дальтонизм заменить очную консультацию офтальмолога?",
    answer: "Нет. Онлайн-тест является исключительно первичным скрининговым инструментом. На цветопередачу могут влиять калибровка монитора, цветовая температура экрана, уровень внешней освещённости и настройки цветового профиля (True Tone, Night Shift). Окончательный клинический диагноз устанавливается офтальмологом с использованием аномалоскопа и стандартизированных таблиц при освещении D65."
  },
  {
    name: "Передаётся ли дальтонизм по наследству?",
    answer: "Красно-зелёный дальтонизм является сцепленным с полом рецессивным генетическим признаком, локализованным в X-хромосоме. По этой причине он встречается примерно у 8% мужчин и лишь у 0,4–0,5% женщин. Тританопия является аутосомно-доминантным признаком и наследуется независимо от пола."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Онлайн-тест на дальтонизм по таблицам Исихары и Рабкина",
    "description": "Клинический скрининг цветового зрения из 22 полихроматических таблиц для выявления красно-зелёного дефицита (дейтеранопия, протанопия) и тританопии.",
    "url": canonicalUrl,
    "medicalAudience": "Patient",
    "aspect": "Screening",
    "inLanguage": "ru"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Онлайн-тест на дальтонизм FreeIQExam",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Требуется JavaScript и поддержка HTML5 Canvas/SVG",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "Скрининг из 22 таблиц в стиле Исихары и Рабкина",
      "Проверка дейтеранопии и протанопии (красно-зелёный дефицит)",
      "Интерактивный симулятор недостаточности цветового зрения",
      "Детский режим с фигурами для нечитающих детей",
      "Проценты чувствительности L-, M- и S-колбочек",
      "Нулевой пейволл, мгновенный отчёт скрининга"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://freeiqexam.com/ru/" },
      { "@type": "ListItem", "position": 2, "name": "Инструменты", "item": "https://freeiqexam.com/ru/tools" },
      { "@type": "ListItem", "position": 3, "name": "Тест на дальтонизм", "item": canonicalUrl }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/color-blind-test" idPath="/id/tes-buta-warna" schema={schema}>
  <Header currentPath="/color-blind-test" enPath="/color-blind-test" idPath="/id/tes-buta-warna" />

  <svg class="hidden" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="deutan-filter">
      <feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0" />
    </filter>
    <filter id="protan-filter">
      <feColorMatrix type="matrix" values="0.567 0.433 0 0 0  0.558 0.442 0 0 0  0 0.242 0.758 0 0  0 0 0 1 0" />
    </filter>
    <filter id="tritan-filter">
      <feColorMatrix type="matrix" values="0.95 0.05 0 0 0  0 0.433 0.567 0 0  0 0.475 0.525 0 0  0 0 0 1 0" />
    </filter>
  </svg>

  <style>
    .plate-container { touch-action: manipulation; user-select: none; -webkit-user-select: none; }
    @keyframes pilestonePop {
      0% { transform: scale(1); }
      30% { transform: scale(0.96); opacity: 0.9; }
      70% { transform: scale(1.02); opacity: 0.98; }
      100% { transform: scale(1); opacity: 1; }
    }
    .pilestone-transition { animation: pilestonePop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .timeline-dot { transition: all 0.25s ease; }
    .plate-dot { vector-effect: non-scaling-stroke; shape-rendering: geometricPrecision; }
    details summary::-webkit-details-marker { display: none; }
    details[open] summary .faq-chevron { transform: rotate(180deg); }

    .filter-normal { filter: none; }
    .filter-deutan { filter: url('#deutan-filter'); }
    .filter-protan { filter: url('#protan-filter'); }
    .filter-tritan { filter: url('#tritan-filter'); }
    .filter-achroma { filter: grayscale(100%); }

    #test-card .key-btn:active, #test-card .shape-btn:active, .sim-filter-btn:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }

    @media print {
      header, footer, #calibration-banner, #keypad-numbers, #keypad-kids, .mode-toggle-container, #btn-restart-link, .no-print { display: none !important; }
      #results-view { display: flex !important; }
      body { background: white !important; color: black !important; }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Хлебные крошки">
      <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Главная</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <a href="/ru/tools" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Инструменты</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест на дальтонизм</span>
    </nav>

    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Скрининг по таблицам Исихары и Рабкина · Цветовое зрение</span>
      </div>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4">
        Тест на дальтонизм онлайн
      </h1>
      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto">
        Оцените своё цветовосприятие с подлинным 22-табличным <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">тестом на дальтонизм</strong> по полихроматическим таблицам Исихары и Рабкина. Процедурные точечные пластины выявляют <strong class="text-blue-600 dark:text-blue-400 font-bold">дейтеранопию</strong> и <strong class="text-blue-600 dark:text-blue-400 font-bold">протанопию</strong> (красно-зелёный дефицит) без пейволла.
      </p>
    </header>

    <div id="calibration-banner" class="max-w-3xl mx-auto mb-8 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
          <div class="space-y-1">
            <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Проверка калибровки экрана перед тестом</h4>
            <p class="text-amber-800 dark:text-amber-300/90 text-sm leading-relaxed">
              Для диагностической точности: <strong>1)</strong> Установите яркость экрана на 100%, <strong>2)</strong> Отключите Night Shift, TrueTone, f.lux или фильтры синего света, <strong>3)</strong> Сохраняйте расстояние вытянутой руки (~50–75 см).
            </p>
          </div>
        </div>
        <button id="btn-dismiss-calibration" type="button" class="text-amber-600 dark:text-amber-400 hover:text-amber-950 dark:hover:text-white p-1 cursor-pointer min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Закрыть предупреждение калибровки"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
      </div>
    </div>

    <div class="mode-toggle-container max-w-md mx-auto mb-8 flex items-center justify-center p-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs font-medium text-[13px] sm:text-sm">
      <button id="mode-btn-numbers" type="button" class="flex-1 min-h-[44px] py-3 px-4 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-bold shadow-sm transition-all active:scale-[0.97] flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="9" x2="20" y2="9" /><line x1="4" y1="15" x2="20" y2="15" /><line x1="10" y1="3" x2="8" y2="21" /><line x1="16" y1="3" x2="14" y2="21" /></svg><span>Стандартные числа (22 таблицы)</span>
      </button>
      <button id="mode-btn-kids" type="button" class="flex-1 min-h-[44px] py-3 px-4 rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition-all active:scale-[0.97] flex items-center justify-center gap-2 cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg><span>Детский режим с фигурами</span>
      </button>
    </div>

    <div class="relative w-full max-w-4xl mx-auto">
      <div id="test-card" class="plate-container w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl flex flex-col items-center">

        <div class="w-full flex items-center justify-between pb-4 mb-6 text-[13px] sm:text-sm font-mono border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">
          <div class="flex items-center gap-2">
            <span class="font-heading font-extrabold tracking-wider uppercase text-zinc-900 dark:text-zinc-100 text-[13px] sm:text-sm">
              FREE<span class="text-blue-600 dark:text-blue-500">IQ</span>EXAM <span class="text-zinc-400 dark:text-zinc-500 font-normal">ИСИХАРА</span>
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span id="plate-counter-badge" class="px-3 py-1 rounded-full text-[13px] font-mono font-bold bg-zinc-100 dark:bg-zinc-800 text-blue-600 dark:text-blue-400 border border-zinc-200 dark:border-zinc-700">
              ТАБЛИЦА 1 ИЗ 22
            </span>
          </div>
        </div>

        <div class="w-full mb-8 px-1 sm:px-4">
          <div id="timeline-chain" class="relative flex items-center justify-between w-full h-8">
            <div class="absolute left-2 right-2 top-1/2 -translate-y-1/2 h-[2px] bg-zinc-200 dark:bg-zinc-800 z-0"></div>
            <div id="timeline-dots" class="relative z-10 flex items-center justify-between w-full"></div>
          </div>
        </div>

        <div id="active-test-view" class="w-full flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-14 my-2">

          <div id="plate-stage" class="relative w-[300px] sm:w-[380px] lg:w-[440px] aspect-square rounded-full bg-zinc-100 dark:bg-[#18181c] p-2 shadow-2xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center shrink-0">
            <svg id="plate-svg" class="w-full h-full rounded-full block cursor-pointer select-none" viewBox="0 0 666 666" role="img" aria-label="Подлинная таблица Исихары для теста на цветослепоту" xmlns="http://www.w3.org/2000/svg">
              <circle cx="333" cy="333" r="328" fill="#121215"></circle>
              <g id="plate-dots"></g>
            </svg>
          </div>

          <div class="flex flex-col items-center justify-center w-full max-w-[300px]">
            <div class="text-center mb-5">
              <p id="prompt-main-text" class="text-[13px] sm:text-sm font-mono uppercase tracking-wider text-zinc-600 dark:text-zinc-300 font-semibold mb-1">Выберите число, которое видите</p>
              <p id="prompt-sub-text" class="text-[13px] text-zinc-400 dark:text-zinc-500">Клавиатура: [1-9], [N] Ничего, [U] Не уверен</p>
            </div>

            <div id="keypad-numbers" class="w-full flex flex-col items-center">
              <div class="grid grid-cols-3 gap-3 w-full mb-3">
                <button type="button" data-val="1" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">1</button>
                <button type="button" data-val="2" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">2</button>
                <button type="button" data-val="3" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">3</button>
                <button type="button" data-val="4" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">4</button>
                <button type="button" data-val="5" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">5</button>
                <button type="button" data-val="6" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">6</button>
                <button type="button" data-val="7" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">7</button>
                <button type="button" data-val="8" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">8</button>
                <button type="button" data-val="9" class="key-btn h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-950 dark:text-white font-bold text-xl transition-all shadow-sm flex items-center justify-center cursor-pointer">9</button>
              </div>
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="nothing" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[13px] sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  НИЧЕГО
                </button>
                <button type="button" data-val="unsure" class="key-btn h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-[13px] sm:text-sm font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center cursor-pointer">
                  НЕ УВЕРЕН
                </button>
              </div>
            </div>

            <div id="keypad-kids" class="w-full flex flex-col items-center hidden">
              <div class="grid grid-cols-2 gap-3 w-full mb-4">
                <button type="button" data-val="Circle" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-emerald-500/40 hover:border-emerald-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-emerald-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="currentColor" /></svg></span><span>Круг</span>
                </button>
                <button type="button" data-val="Square" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-blue-500/40 hover:border-blue-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-blue-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="2" fill="currentColor" /></svg></span><span>Квадрат</span>
                </button>
                <button type="button" data-val="Triangle" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-amber-500/40 hover:border-amber-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-amber-500"><svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><polygon points="12 4 21 20 3 20" fill="currentColor" /></svg></span><span>Треугольник</span>
                </button>
                <button type="button" data-val="Star" class="shape-btn h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 active:scale-[0.97] border-2 border-purple-500/40 hover:border-purple-500 text-zinc-950 dark:text-white font-bold text-base transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
