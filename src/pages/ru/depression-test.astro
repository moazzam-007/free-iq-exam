---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Бесплатный клинический тест на депрессию (PHQ-9) онлайн | Конфиденциальная оценка';
const description = 'Пройдите официальный клинически валидированный скрининг депрессии PHQ-9 онлайн. 100% бесплатно, конфиденциально, мгновенный результат и сводка для клинициста. Без регистрации.';
const canonicalUrl = 'https://freeiqexam.com/ru/depression-test';

const faqItems = [
  ['Что такое PHQ-9 и кто его разработал?', 'PHQ-9 - это модуль депрессии из 9 пунктов Опросника здоровья пациента, разработанный доктором Робертом Л. Шпитцером, доктором Джанет Б. У. Уильямс, доктором Куртом Крёнке и коллегами при образовательном гранте Pfizer. Каждый пункт напрямую соответствует одному из девяти критериев DSM-5 для большого депрессивного эпизода и оценивается от 0 до 3 за двухнедельный период.'],
  ['Насколько точен PHQ-9 при выявлении депрессии?', 'В оригинальных валидационных исследованиях и последующих метаанализах порог 10 и выше даёт объединённую чувствительность и специфичность около 88% для большого депрессивного расстройства относительно структурированного клинического интервью. Чувствительность и специфичность несколько варьируются в зависимости от популяции и условий, поэтому балл рассматривается как сигнал скрининга, а не диагноз.'],
  ['Может ли этот тест диагностировать у меня депрессию?', 'Нет. PHQ-9 - валидированный инструмент скрининга, а не диагностический. Формальный диагноз требует клинической оценки лицензированным специалистом здравоохранения, который может оценить длительность, нарушения, историю и альтернативные объяснения. Высокий балл означает, что паттерн симптомов заслуживает профессиональной оценки, а не то, что у вас подтверждённый диагноз.'],
  ['Как интерпретировать балл от 10 до 14?', 'Балл от 10 до 14 попадает в умеренный диапазон и достигает стандартного порога PHQ-9 для вероятной большой депрессии. На этом уровне рекомендуется клиническая оценка, и обычно рассматривается структурированная психотерапия или фармакотерапия. Это также точка, в которой активное лечение обычно превосходит выжидательную тактику.'],
  ['Что значит, если я получил больше 0 по вопросу о самоповреждении?', 'Пункт 9 спрашивает о мыслях о том, что вам лучше было бы умереть, или о том, чтобы причинить себе вред. Любой балл выше 0 по этому пункту рассматривается как флаг безопасности независимо от суммарного балла. Это не обязательно означает, что вы в непосредственной опасности, но означает, что тема заслуживает прямого разговора с клиницистом или кризисной службой, а не откладывания.'],
  ['Почему есть десятый вопрос, если в PHQ-9 девять пунктов?', 'Десятый пункт - вопрос о нарушении функционирования. Он не входит в суммарный балл от 0 до 27. Он спрашивает, насколько трудными ваши симптомы сделали работу, домашние дела или отношения с другими людьми. Клиницисты придают этому большое значение, потому что тяжесть симптомов и нарушение функционирования связаны, но действительно различны, и именно нарушения часто определяют решения о лечении.'],
  ['Чем депрессия отличается от выгорания или обычной грусти?', 'Грусть обычно пропорциональна событию и уходит по мере изменения обстоятельств. Выгорание обычно привязано к контексту, связано с хронической рабочей или заботливой нагрузкой и улучшается при отдыхе и изменении границ. Большая депрессия более всеобъемлюща, сохраняется в разных контекстах и обычно включает ангедонию, вину и нейровегетативные симптомы, такие как изменение сна и аппетита. Различия важны, потому что лечение различается.'],
  ['Как часто нужно повторять PHQ-9?', 'Если вы не лечитесь, повторный скрининг каждые две-четыре недели разумен при лёгких симптомах и раньше, если они нарастают. Если вы начали лечение, PHQ-9 обычно повторяют каждые две недели, чтобы ответ можно было измерить, а не оценить приблизительно. Изменение на 5 баллов и более обычно считается клинически значимым.']
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Скрининг депрессии и настроения PHQ-9',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
    inLanguage: 'ru',
    about: {
      '@type': 'MedicalCondition',
      name: 'Большое депрессивное расстройство',
      alternateName: ['Депрессия', 'Клиническая депрессия', 'Большая депрессия'],
      code: { '@type': 'MedicalCode', code: 'F32', codingSystem: 'ICD-10' }
    },
    lastReviewed: '2026-09-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Бесплатный клинический тест на депрессию (PHQ-9)',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Управление ответами с клавиатуры (клавиши 1–4), видимые состояния фокуса, семантические заголовки, live-объявления, кризисные интерстициалы и печатная сводка для клинициста.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://freeiqexam.com/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Тесты', item: 'https://freeiqexam.com/ru/test' },
      { '@type': 'ListItem', position: 3, name: 'Тест на депрессию (PHQ-9)', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Опросник скрининга депрессии PHQ-9 - 9 пунктов',
    url: canonicalUrl,
    numberOfQuestions: 9,
    isAccessibleForFree: true,
    inLanguage: 'ru',
    about: { '@type': 'MedicalCondition', name: 'Большое депрессивное расстройство' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text }
    }))
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/depression-test" idPath="/id/tes-depresi" schema={schemas}>
  <Header currentPath="/depression-test" enPath="/depression-test" idPath="/id/tes-depresi" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Хлебные крошки" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Главная</a><span aria-hidden="true">/</span>
        <a href="/ru/test" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Тесты</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Тест на депрессию</span>
      </nav>

      <header class="mx-auto max-w-4xl text-center">
        <div class="relative inline-flex items-center rounded-full border border-zinc-300 bg-zinc-100 px-4 py-2 text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 sm:text-sm">
          PHQ-9 · Клинически валидированный инструмент
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-[-0.025em] leading-[1.08] sm:text-5xl md:text-6xl">Бесплатный клинический тест на депрессию</h1>
        <p class="mx-auto mt-6 max-w-3xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Пройдите Опросник здоровья пациента-9, самый широко используемый инструмент скрининга депрессии в клинической практике. Девять вопросов, мгновенный подсчёт, разбор по осям симптомов и печатная сводка для клинициста - бесплатно, конфиденциально и без регистрации или e-mail.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['9 клинических пунктов', 'Период 2 недели', 'Мгновенный балл 0–27', 'Версия для печати', 'Без регистрации'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="depression-app" class="mx-auto mt-12 max-w-4xl">
        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">
          <div id="assessment-intro" class="border-t border-zinc-200 pt-6 dark:border-zinc-800 sm:pt-8">
            <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Перед началом</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">Скрининг - это не диагноз</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Отвечайте исходя из того, как часто каждый симптом беспокоил вас за <strong>последние две недели</strong>. PHQ-9 оценивает бремя симптомов относительно валидированных порогов тяжести. Он не может подтвердить или исключить депрессию и не заменяет оценку квалифицированным клиницистом.
            </p>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              Всё, что вы вводите, остаётся в вашем браузере. Ответы не передаются, не сохраняются и не связываются с вашей личностью.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-assessment" type="button" class="min-h-[44px] rounded-2xl bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition hover:bg-[#0071e3] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] sm:rounded-full">Начать скрининг PHQ-9</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Клавиатура: 1–4 для ответа · ← / → для навигации</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
              <strong>Если вы в непосредственной опасности,</strong> немедленно свяжитесь с местным экстренным номером. В США и Канаде звоните или пишите <strong>988</strong>. Этот инструмент не отслеживается и не может вызвать помощь.
            </p>
          </div>

          <section id="questionnaire-section" class="hidden" aria-labelledby="question-heading">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p id="question-part" class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">PHQ-9 · Последние 2 недели</p>
                <p id="question-domain" class="mt-2 text-base font-semibold text-zinc-700 dark:text-zinc-300">Аффективный · настроение и ангедония</p>
              </div>
              <div class="text-left sm:text-right">
                <div id="question-number" class="text-base font-semibold sm:text-lg">Вопрос 1 из 9</div>
                <div id="progress-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">0% отвечено</div>
              </div>
            </div>
            <div class="mt-5 h-[2px] overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:4%"></div></div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <div class="flex flex-wrap gap-2 text-sm font-semibold text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">Выберите один вариант</span>
                <span class="rounded-full border border-zinc-200 px-3 py-1.5 dark:border-zinc-800">За последние 2 недели, как часто вас беспокоили…</span>
              </div>
              <h2 id="question-heading" class="mt-6 text-2xl font-bold tracking-tight sm:text-3xl"></h2>
              <p id="question-context" class="mt-3 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg"></p>
              <div id="likert-options" class="mt-8 grid gap-3 sm:grid-cols-4" role="group" aria-label="Варианты частотных ответов"></div>
              <p id="question-safety-note" class="mt-6 hidden rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
                Этот пункт задаётся всем и не является обвинением. Отвечайте честно - это меняет то, какая помощь будет предложена, а не то, как к вам относятся. Ресурсы поддержки появятся, когда вы выберете ответ выше нуля.
              </p>
              <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
                <button id="back-button" type="button" class="min-h-[44px] rounded-2xl border border-zinc-300 bg-white px-6 py-4 text-base font-semibold transition active:scale-[0.97] dark:border-zinc-700 dark:bg-zinc-900 sm:rounded-full">Назад</button>
                <button id="next-button" type="button" class="min-h-[44px] rounded-2xl bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-40 dark:bg-[#2997ff] sm:rounded-full">Следующий вопрос</button>
              </div>
            </article>
          </section>

          <section id="crisis-interstitial" class="hidden" role="alertdialog" aria-labelledby="crisis-interstitial-title" aria-describedby="crisis-interstitial-body">
            <div class="rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-9">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Проверка безопасности</p>
              <h2 id="crisis-interstitial-title" class="mt-3 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100 sm:text-3xl">Спасибо за честный ответ</h2>
              <p id="crisis-interstitial-body" class="mt-4 text-base leading-relaxed text-red-950 dark:text-red-100 sm:text-lg">
                Вы указали на мысли о том, что вам лучше было бы умереть, или о том, чтобы причинить себе вред. Эти мысли - признак того, какую боль вы несёте, а не недостаток характера и не то, что вы должны нести в одиночку. Разговор с кем-то сейчас действительно помогает.
              </p>
              <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">RU</span> Россия</span><strong>8-800-200-0122</strong><span>Единая линия психологической помощи · 24/7 · бесплатно (или 112)</span></li>
                <li class="crisis-line"><span class="crisis-flag"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg> Везде остальное</span><strong>findahelpline.com</strong><span>Бесплатные линии помощи в 130+ странах</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">US</span> <span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">CA</span> США и Канада</span><strong>988</strong><span>Suicide &amp; Crisis Lifeline · 24/7 · бесплатно</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">GB</span> Великобритания и Ирландия</span><strong>116 123</strong><span>Samaritans · 24/7 · или NHS 111</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">DE</span> Германия</span><strong>0800 111 0 111</strong><span>TelefonSeelsorge · бесплатно и анонимно</span></li>
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">AU</span> Австралия</span><strong>13 11 14</strong><span>Lifeline Australia · 24/7</span></li>
              </ul>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="crisis-continue" type="button" class="min-h-[44px] rounded-2xl bg-zinc-950 px-7 py-4 text-base font-semibold text-white transition active:scale-[0.99] dark:bg-white dark:text-zinc-950 sm:rounded-full">Я прочитал(а) - перейти к результатам</button>
              </div>
            </div>
          </section>

          <section id="results-section" class="hidden" aria-labelledby="results-title">
            <div id="crisis-banner" class="hidden mb-6 rounded-[1.75rem] border-2 border-red-300 bg-red-50 p-6 dark:border-red-900 dark:bg-red-950/40 sm:p-8">
              <p class="text-xs font-semibold uppercase tracking-wider text-red-700 dark:text-red-300 sm:text-sm">Доступна немедленная поддержка</p>
              <h2 class="mt-3 text-2xl font-bold tracking-tight text-red-950 dark:text-red-100 sm:text-3xl">Вы отметили мысли о самоповреждении</h2>
              <p class="mt-4 text-base leading-relaxed text-red-950 dark:text-red-100 sm:text-lg">
                Независимо от суммарного балла, этот пункт рассматривается как приоритет безопасности. Пожалуйста, обратитесь к одному из этих ресурсов сейчас - они бесплатны, конфиденциальны и укомплектованы людьми, обученными именно такому разговору.
              </p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                <li class="crisis-line"><span class="crisis-flag"><span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200" aria-hidden="true">RU</span> Россия</span><strong>8-800-200-0122</strong><span>Единая линия психологической помощи · 24/7 (или 112)</span></li>
