---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Бесплатный онлайн-тест зрения и проверка остроты глаз | Таблица Снеллена и тест на астигматизм';
const description = 'Проверьте остроту зрения онлайн с помощью бесплатного клинического скрининга. Калибровка по банковской карте, тест Ш-типа / оптотипы Снеллена, лучистая фигура астигматизма и дуохромный красно-зеленый тест.';
const canonicalUrl = 'https://freeiqexam.com/ru/eye-test';

const alternates = {
  // de: '/de/sehtest-online',
  // ru: '/ru/proverka-zreniya-online',
  // pt: '/pt/teste-de-visao-online',
  // fr: '/fr/test-de-vue-en-ligne',
  // es: '/es/test-de-vista-online',
  // id: '/id/tes-mata-online',
  // pl: '/pl/badanie-wzroku-online',
};

const faqItems = [
  [
    'Насколько точен онлайн-тест зрения по сравнению с приемом офтальмолога?',
    'Онлайн-тест дает ориентировочную оценку остроты зрения на заданном расстоянии, но не может измерить рефракцию, внутриглазное давление, состояние сетчатки или бинокулярное зрение. Размер экрана, плотность пикселей, расстояние и освещение вносят погрешность. Результаты теста служат поводом для очной консультации врача, а не заменой визита.'
  ],
  [
    'Зачем при калибровке прикладывать банковскую карту к экрану?',
    'Острота зрения определяется угловым размером оптотипа на сетчатке, а не его физическим размером в пикселях. Оптотип 20/20 на расстоянии 1 метра имеет высоту 1,45 мм. Так как браузер не может напрямую узнать плотность пикселей вашего монитора, стандартная карта ISO/IEC 7810 (ширина 85,60 мм) позволяет вычислить точное соотношение пикселей на миллиметр для реального масштаба.'
  ],
  [
    'Почему тест иногда не может проверить зрение острее 20/40?',
    'На дистанции 1 метр оптотип 20/20 имеет высоту 1,45 мм, что соответствует примерно 5 пикселям на мониторе 96 DPI — этого недостаточно для качественной отрисовки буквы. Чтобы не искажать измерения, движок ограничивает шкалу максимальным разрешением экрана. Отодвиньтесь дальше и выберите большее расстояние, чтобы оптотипы стали крупнее в пикселях.'
  ],
  [
    'Что такое оптотип Ш-типа (Tumbling E) и почему он лучше обычных букв?',
    'Tumbling E — это буква E, ориентированная вверх, вниз, влево или вправо (аналог оптотипа Ш). Пользователь указывает направление, а не называет букву, что исключает влияние грамотности, языка и распознавания шрифта. Это международный золотой стандарт оптометрии для детей и многоязычных тестов.'
  ],
  [
    'Что выявляет лучистая фигура астигматизма (тест-мишень)?',
    'Лучистая фигура состоит из радиальных линий во всех меридианах. При астигматизме роговица или хрусталик имеют разную кривизну в перпендикулярных плоскостях, из-за чего одни линии кажутся темнее и резче других. Асимметрия четкости линий указывает на вероятный астигматизм, требующий подбора цилиндрических линз.'
  ],
  [
    'Почему красно-зеленые панели выявляют близорукость и дальнозоркость?',
    'В основе лежит продольная хроматическая аберрация глаза. Зеленый свет (535 нм) преломляется сильнее красного (650 нм), поэтому зеленый фокус формируется чуть ближе сетчатки, а красный — чуть глубже. Если красное кольцо четче — преобладает миопическая тенденция; если зеленое — гиперметропическая. Одинаковая четкость означает сферический баланс.'
  ],
  [
    'Может ли этот тест выдать рецепт на очки?',
    'Нет. Рецепт на оптическую коррекцию включает точные диоптрии сферы, цилиндра, ось астигматизма, межзрачковое расстояние и аддидацию. Этот скрининг оценивает только остроту и баланс. Официальный рецепт выдает исключительно сертифицированный врач-офтальмолог.'
  ],
  [
    'В каких случаях нужно срочно обратиться к офтальмологу независимо от теста?',
    'Немедленно обратитесь к врачу при внезапном падении зрения, вспышках, резком появлении мушек или завесы перед глазами, боли, стойком покраснении, двоении в глазах или при сопутствующем диабете. Внезапная потеря зрения — это неотложное состояние.'
  ]
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    '@id': `${canonicalUrl}#medical-page`,
    name: 'Online Visual Acuity, Astigmatism and Duochrome Screener',
    url: canonicalUrl,
    medicalAudience: 'Patient',
    aspect: 'Diagnostic',
    isAccessibleForFree: true,
    about: {
      '@type': 'MedicalCondition',
      name: 'Refractive Error',
      alternateName: ['Myopia', 'Hyperopia', 'Astigmatism', 'Presbyopia']
    },
    lastReviewed: '2026-09-15'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#application`,
    name: 'Free Online Eye Test - Snellen, Astigmatism Dial and Duochrome',
    url: canonicalUrl,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    accessibilitySummary: 'Keyboard-operable direction responses, on-screen directional controls, full-card calibration slider, visible focus states, live announcements, and a printable screening summary.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://freeiqexam.com/' },
      { '@type': 'ListItem', position: 2, name: 'Assessments', item: 'https://freeiqexam.com/test' },
      { '@type': 'ListItem', position: 3, name: 'Eye Test', item: canonicalUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text }
    }))
  }
];

const stages = [
  ['intro-section', '1 · Обзор'],
  ['calibration-section', '2 · Калибровка'],
  ['acuity-section', '3 · Острота'],
  ['astigmatism-section', '4 · Астигматизм'],
  ['duochrome-section', '5 · Дуохром'],
  ['results-section', '6 · Результаты']
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/eye-test" idPath="/tes-mata" schema={schemas}>
  <Header />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Хлебные крошки" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Главная</a><span aria-hidden="true">/</span>
        <a href="/ru/test" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Тесты</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Тест зрения</span>
      </nav>

      <header class="relative mx-auto max-w-4xl text-center">
        <div class="eye-hero-glow" aria-hidden="true"></div>
        <div class="relative inline-flex items-center rounded-full border border-zinc-300 bg-zinc-100 px-4 py-2 text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 sm:text-sm">
          Калибровка по экрану · Оптометрический скрининг
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-[-0.025em] leading-[1.08] sm:text-5xl md:text-6xl">Бесплатный онлайн-тест зрения</h1>
        <p class="mx-auto mt-6 max-w-3xl text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-300 sm:text-lg">
          Проверьте остроту зрения по таблице Снеллена с оптотипами Ш-типа, оцените меридиональное размытие на фигуре астигматизма и баланс сферы на красно-зеленом дуохромном тесте. Работает локально в браузере.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 text-sm sm:text-base">
          {['Калибровка по карте', 'Острота зрения Ш-типа', 'Тест на астигматизм', 'Дуохромный баланс', 'Без регистрации'].map((item) => (
            <span class="rounded-full border border-zinc-200 px-4 py-2.5 text-zinc-700 dark:border-zinc-800 dark:text-zinc-300">{item}</span>
          ))}
        </div>
      </header>

      <section id="eye-app" class="mx-auto mt-12 max-w-4xl">
        <ol class="stage-strip" aria-label="Test progress">
          {stages.map(([id, label]) => (
            <li data-stage={id} class="stage-chip">{label}</li>
          ))}
        </ol>

        <div class="rounded-[2rem] border border-zinc-200 bg-zinc-50/80 p-5 dark:border-zinc-800 dark:bg-zinc-950/70 sm:p-8">

          <section id="intro-section" class="border-t border-zinc-200 pt-6 dark:border-zinc-800 sm:pt-8">
            <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Before you begin</p>
            <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">A screening tool, not an examination</h2>
            <p class="mt-4 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              This test estimates how well you see at a chosen distance. It cannot measure your refraction, eye pressure, visual fields, or retinal health, and it cannot produce a prescription. Screen size, pixel density, viewing distance, and room lighting all affect the result.
            </p>
            <ul class="mt-5 space-y-3 text-base leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-lg">
              <li class="intro-bullet">Have a standard bank card or ID card ready - you will match it against the screen to calibrate physical scale.</li>
              <li class="intro-bullet">You will need to cover one eye at a time. A palm works better than a hand cupped over the eye.</li>
              <li class="intro-bullet">Test in even, moderate lighting. Avoid a bright window directly behind or in front of the screen.</li>
              <li class="intro-bullet">Wear your usual glasses or contact lenses if you are checking how well your current correction works. Remove them only if you want to know your uncorrected acuity.</li>
            </ul>
            <div class="mt-7 flex flex-wrap gap-3">
              <button id="begin-eye-test" type="button" class="rounded-2xl bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition hover:bg-[#0071e3] active:scale-[0.97] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] sm:rounded-full">Start the vision test</button>
              <span class="self-center text-sm text-zinc-600 dark:text-zinc-400 sm:text-base">Keyboard: ↑ ↓ ← → to answer during acuity</span>
            </div>
            <p class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-200 sm:text-base">
              <strong>Sudden vision loss, flashes, a curtain across your vision, or eye pain is a medical emergency.</strong> Do not test online - seek immediate care.
            </p>
          </section>

          <section id="calibration-section" class="hidden" aria-labelledby="calibration-title">
            <div class="rounded-[1.5rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-8">
              <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Step 1 · Physical calibration</p>
              <h2 id="calibration-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Match a real card to the screen</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Hold a standard bank, ID, or library card flat against the screen and drag the slider until the white outline below is exactly the same width as the card. This gives the test your screen's true pixels-per-millimetre ratio, which is what makes the optotypes physically accurate.
              </p>

              <div class="calibration-stage">
                <div id="card-preview" class="card-preview" aria-hidden="true"></div>
              </div>

              <label for="card-slider" class="mt-8 block text-base font-semibold">Card width on screen</label>
              <input id="card-slider" type="range" min="100" max="600" step="1" value="260" class="calibration-slider" />
              <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">
                <span>Card width: <strong id="card-width-label" class="font-mono">260 px</strong></span>
                <span>Screen scale: <strong id="ppm-readout" class="font-mono">-</strong></span>
              </div>

              <div class="mt-8">
                <p class="text-base font-semibold">Test distance</p>
                <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Sit or stand so your eye is exactly this far from the screen. Further back makes sharper optotypes physically larger - and therefore measurable.</p>
                <div class="mt-4 flex flex-wrap gap-3">
                  {[['near', '40 cm', '16 in · phone'], ['desk', '1 m', '3.3 ft · desktop'], ['room', '2 m', '6.6 ft'], ['hall', '3 m', '10 ft'], ['snellen', '6 m', '20 ft · Snellen standard']].map(([id, label, hint]) => (
                    <button type="button" data-distance={id} class="distance-button">
                      <span class="distance-label">{label}</span>
                      <span class="distance-hint">{hint}</span>
                    </button>
                  ))}
                </div>
              </div>

              <p id="resolution-warning" class="mt-7 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900 dark:border-amber-900/50 dark:bg-amber-950/30 dark:text-amber-200 sm:text-base"></p>

              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="confirm-calibration" type="button" class="rounded-2xl bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition hover:bg-[#0071e3] active:scale-[0.97] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] sm:rounded-full">Калиброватьd - begin acuity test</button>
                <button id="skip-calibration" type="button" class="rounded-2xl border border-zinc-300 px-6 py-4 text-base font-semibold transition active:scale-[0.99] dark:border-zinc-700 sm:rounded-full">Skip to astigmatism &amp; duochrome</button>
              </div>
              <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Calibration is only needed for the acuity chart. The dial and duochrome modules work without it.</p>
            </div>
          </section>

          <section id="acuity-section" class="hidden" aria-labelledby="acuity-title">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Step 2 · Visual acuity</p>
                <h2 id="acuity-title" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl"><span id="acuity-eye-label">Right eye</span></h2>
              </div>
              <div class="text-left sm:text-right">
                <div id="acuity-eye-progress" class="text-base font-semibold sm:text-lg">Eye 1 of 3</div>
                <div id="acuity-trial-label" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">-</div>
              </div>
            </div>
            <div class="mt-5 h-[2px] overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"><div id="acuity-progress-fill" class="h-full rounded-full bg-[#0066cc] dark:bg-[#2997ff] transition-all duration-300" style="width:0%"></div></div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
              <div id="acuity-tier-dots" class="tier-dots" aria-hidden="true"></div>
              <p class="text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">Three correct clears a level · two misses step down a level or end the eye</p>
            </div>

            <article class="mt-8 rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p id="acuity-instruction" class="rounded-2xl border border-zinc-200 bg-zinc-50 px-5 py-4 text-base font-semibold text-zinc-700 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 sm:text-lg">Cover your LEFT eye.</p>
              <p class="mt-6 text-base text-zinc-500 dark:text-zinc-400 sm:text-lg">
                Which direction is the E pointing? Current level <strong id="acuity-tier-label" class="font-mono text-zinc-900 dark:text-white">-</strong>
              </p>

              <div id="optotype-mount" class="mt-6"></div>

              <div class="direction-pad mt-8">
                <div></div>
                <button type="button" data-direction="up" class="direction-button" aria-label="E points up">↑</button>
                <div></div>
                <button type="button" data-direction="left" class="direction-button" aria-label="E points left">←</button>
                <div class="direction-center" aria-hidden="true">E</div>
                <button type="button" data-direction="right" class="direction-button" aria-label="E points right">→</button>
                <div></div>
                <button type="button" data-direction="down" class="direction-button" aria-label="E points down">↓</button>
                <div></div>
              </div>

              <p id="acuity-feedback" class="acuity-feedback" role="status" aria-live="polite"></p>
              <p class="mt-6 text-center text-sm text-zinc-500 dark:text-zinc-400 sm:text-base">
                Three correct at a level clears it. Two wrong ends that eye.
              </p>
            </article>
          </section>

          <section id="astigmatism-section" class="hidden" aria-labelledby="astig-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Step 3 · Astigmatism dial</p>
              <h2 id="astig-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Do any lines look darker or sharper?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Stand or sit at your chosen distance. With one eye at a time, look at the centre of the dial and compare the twelve lines. Some people with uncorrected astigmatism see one or two lines as noticeably darker, bolder, or sharper than the rest. Select every line that stands out.
              </p>
              <p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Each ray is selectable on its own, including the two opposite rays that lie on the same line through the centre - those two describe one and the same meridian, so if a line looks blurred at both ends, mark both.
              </p>
              <div id="dial-mount" class="dial-stage mt-8"></div>
              <p id="dial-selection-label" class="mt-6 text-base font-semibold text-[#0066cc] dark:text-[#2997ff] sm:text-lg">Линии пока не выбраны.</p>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <button id="submit-astigmatism" type="button" class="rounded-2xl bg-[#0066cc] px-7 py-4 text-base font-semibold text-white transition hover:bg-[#0071e3] active:scale-[0.97] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] sm:rounded-full">Перейти к дуохромному тесту</button>
                <button id="dial-none" type="button" aria-pressed="false" class="rounded-2xl border border-zinc-300 px-6 py-4 text-base font-semibold transition active:scale-[0.99] dark:border-zinc-700 sm:rounded-full">Все линии выглядят одинаково</button>
              </div>
            </div>
          </section>

          <section id="duochrome-section" class="hidden" aria-labelledby="duo-title">
            <div class="rounded-[1.75rem] border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950 sm:p-9">
              <p class="text-[13px] font-mono font-semibold uppercase tracking-wider text-[#0066cc] dark:text-[#2997ff] sm:text-sm">Шаг 4 · Красно-зеленый дуохромный тест</p>
              <h2 id="duo-title" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">Какое кольцо кажется четче?</h2>
              <p class="mt-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-300 sm:text-lg">
                Сравните черное кольцо на красном фоне с черным кольцом на зеленом фоне. Оценивайте <strong>четкость и резкость</strong>, а не яркость. Посмотрите на оба кольца несколько секунд перед выбором.
              </p>
              <div class="duochrome-grid mt-8">
                <div class="duochrome-panel duo-red">
                  <div id="duochrome-red" class="duochrome-target"></div>
                  <span class="duochrome-caption">Красный · ~650 нм</span>
                </div>
                <div class="duochrome-panel duo-green">
                  <div id="duochrome-green" class="duochrome-target"></div>
                  <span class="duochrome-caption">Зеленый · ~535 нм</span>
                </div>
              </div>
              <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
