---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';
import CategoryTestRunner from '../../components/ru/CategoryTestRunnerRu.astro';

const title = "Тест на логическое мышление онлайн: подвижный интеллект (Gf) | FreeIQExam";
const description = "Пройдите тест на логическое мышление и подвижный интеллект (Gf): 16 невербальных заданий на индукцию правил. Оценка фактора g по психометрической шкале.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "name": "Тест подвижного интеллекта (Gf): когнитивные способности",
    "description": "Специализированный невербальный тест подвижного интеллекта из 16 заданий: индукция абстрактных правил, завершение матриц и топологическая логика.",
    "url": "https://freeiqexam.com/ru/fluid-reasoning-test",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Тест подвижного интеллекта",
        "item": "https://freeiqexam.com/ru/fluid-reasoning-test"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/fluid-reasoning-test" idPath="/tes-penalaran-fluida" canonicalUrl="https://freeiqexam.com/ru/fluid-reasoning-test">
  <Header currentPath="/fluid-reasoning-test"  enPath="/fluid-reasoning-test" idPath="/tes-penalaran-fluida"/>

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест подвижного интеллекта</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>КОГНИТИВНЫЙ ФАКТОР CHC: Gf <span aria-hidden="true">&bull;</span> БЕЗ КУЛЬТУРНОГО СМЕЩЕНИЯ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тест подвижного интеллекта (Gf)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Оцените способность решать новые задачи, выводить абстрактные матричные правила и мыслить топологически. Выберите стандартный тест на 15 минут или неторопливую тренировку без времени с пошаговыми разборами.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 прогрессивных матричных заданий</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Таймер 15 минут (или без времени)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Задания без культурного смещения</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Калибровка 2PL IRT</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="fluid"
      domainCode="Gf"
      domainTitle="Подвижный интеллект (Gf)"
      domainSubtitle="Индукция абстрактных матричных правил и топологическая логика"
      domainDescription="Подвижный интеллект (Gf) отражает способность обдумывать и решать новые задачи независимо от полученного формального образования. В психометрических исследованиях Gf сильнее всего коррелирует с общим фактором Спирмена (g), поэтому он централен для оценки базовых возможностей обработки информации."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Понимание подвижного интеллекта в когнитивной модели CHC
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Подвижный интеллект, впервые формализованный Раймондом Кеттеллом и позднее уточнённый Джоном Хорном и Джоном Кэрроллом, — это фундаментальная ментальная мощность, позволяющая распознавать закономерности, выводить правила и решать незнакомые задачи. В отличие от кристаллизованного интеллекта (Gc), подвижный интеллект не зависит от словарного запаса и академической подготовки.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Индукция матриц
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Разбор сеток 2×2 и 3×3 через просмотр строк по горизонтали и столбцов по вертикали, чтобы выделить независимые правила визуальных преобразований.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Топологические ряды
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Отслеживание алгоритмов прогрессии: сдвиги позиций, скорость движения по часовой и против часовой стрелки, чередование заливки.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Булевы комбинации признаков
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            В сложных матрицах используется логическая операция XOR (исключающее ИЛИ), при которой совпадающие линии взаимно погашаются в соседних клетках матрицы.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Тактика высоких баллов в матричных тестах
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Разбирайте признаки по отдельности:</strong> рассматривайте форму, размер, поворот, число элементов и цвет как независимые переменные, а не пытайтесь охватить всё изображение сразу.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Проверяйте и по строкам, и по столбцам:</strong> в настоящих прогрессивных матрицах верное правило стабильно работает по горизонтальным строкам и подтверждается по вертикальным столбцам.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Остерегайтесь ловушек-дистракторов:</strong> в сложных заданиях встречаются варианты с неполным правилом или притягательные на вид ответы, нарушающие одно вторичное условие.</span>
          </li>
        </ul>
      </div>

      <!-- User-Facing FAQ Accordion -->
      <div class="space-y-4 pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Частые вопросы о подвижном интеллекте (Gf)
        </h3>
        <div class="space-y-3 pt-2">
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>В чём разница между подвижным (Gf) и кристаллизованным (Gc) интеллектом?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Подвижный интеллект (Gf) — это способность рассуждать логически и решать принципиально новые задачи без опоры на прошлые знания. Кристаллизованный интеллект (Gc) опирается на накопленный словарный запас, образование и культурный опыт.
            </p>
          </details>
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Почему задания на подвижный интеллект считаются свободными от языка?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              В тестах Gf используются абстрактные геометрические матрицы, символы и формы. Участникам не требуется владение специальной терминологией или знанием конкретного языка, что обеспечивает кросс-культурную справедливость оценки.
            </p>
          </details>
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Можно ли развить подвижный интеллект регулярными тренировками?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Хотя биологический фактор Gf имеет сильную генетическую основу, целенаправленная практика развивает метакогнитивные стратегии: умение декомпозировать признаки (размер, поворот, XOR), исключать дистракторы и эффективнее распределять объем рабочей памяти.
            </p>
          </details>
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Какова связь подвижного интеллекта со шкалой IQ?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              В факторном анализе Спирмена и современной модели Кателла-Хорна-Кэрролла (CHC) подвижный интеллект имеет наибольшую нагрузку на общий фактор интеллекта (g ≈ 0.8–0.9), что делает его ключевым предиктором общего уровня IQ.
            </p>
          </details>
        </div>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Другие специализированные когнитивные батареи
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/ru/spatial-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Пространственное мышление (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Ментальное вращение 3D &rarr;</div>
          </a>
          <a
            href="/ru/quantitative-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Количественное мышление (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Арифметические логические задачи &rarr;</div>
          </a>
          <a
            href="/ru/verbal-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Вербальное понимание (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Дедуктивные силлогизмы &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
