---
import Layout from '../../../components/ru/LayoutRu.astro';
import Header from '../../../components/ru/HeaderRu.astro';
import Footer from '../../../components/ru/FooterRu.astro';

const title = "3D вращение фигур онлайн: тест пространственного мышления | FreeIQExam";
const description = "Тест на мысленное 3D-вращение фигур онлайн: парадигма Шепарда-Метцлера. Определяйте идентичность трёхмерных блоков на скорость и тренируйте пространственную логику.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "3D-вращение",
    "url": "https://freeiqexam.com/ru/games/rotation",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Научный тест ментального вращения 3D: зрительно-пространственная ориентация и скоростное манипулирование объектами."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Когнитивные игры",
        "item": "https://freeiqexam.com/ru/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "3D-вращение",
        "item": "https://freeiqexam.com/ru/games/rotation"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/games/rotation" idPath="/permainan/rotation" canonicalUrl="https://freeiqexam.com/ru/games/rotation">
  <Header  enPath="/games/rotation" idPath="/permainan/rotation"/>

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Хлебные крошки">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <a href="/ru/games" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Когнитивные игры</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Вращение 3D</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-sky mb-1.5">
          Gv &bull; Визуально-пространственная скорость
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
          3D Ментальное вращение фигур
        </h1>
      </div>

      <!-- Stat HUD + Help Button -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <button
          id="btn-how-to-play"
          type="button"
          aria-label="Как играть — инструкция"
          class="min-h-[44px] px-3 py-1.5 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/90 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-sans font-semibold text-xs sm:text-sm flex items-center gap-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <span class="font-bold font-mono text-indigo-600 dark:text-indigo-400">(?)</span>
          <span>Как играть</span>
        </button>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Попытка</div>
          <div id="hud-trial" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 20</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Счёт</div>
          <div id="hud-score" class="font-bold text-indigo-600 dark:text-indigo-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Ср. время</div>
          <div id="hud-avg-time" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0.0s</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[58px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 uppercase text-[10px] sm:text-xs font-mono font-medium tracking-wider">Рекорд</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-sky flex items-center justify-center mb-5 shadow-lg shadow-indigo-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Скорость ментального вращения 3D
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Два 3D-куба появятся рядом: <strong>Куб А</strong> и <strong>Куб Б</strong>.
          </p>
          <p>
            Мысленно вращайте кубы в трёхмерном пространстве и определите: <strong>Куб Б</strong> — это <strong>ТАКОЙ ЖЕ</strong> куб в другой ориентации или <strong>ДРУГОЙ</strong> куб с изменёнными гранями.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            Скорость решает: &lt;3с = +20 оч., &lt;6с = +10 оч., &lt;8с = +5 оч. Лимит попытки — 8 секунд.
          </p>
        </div>
        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-heading font-bold text-base shadow-md transition-all duration-200 active:scale-[0.97] flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <span>Начать тест (Пробел)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive game arena content -->
      <div id="game-arena-content" class="w-full flex flex-col items-center">
        <!-- Trial Progress Ring & Timer Bar -->
        <div class="w-full max-w-lg mb-6 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono font-semibold text-zinc-500 dark:text-zinc-400">Таймер:</span>
            <span id="timer-text" class="text-sm font-mono font-bold text-indigo-600 dark:text-indigo-400">8.0s</span>
          </div>

          <!-- Mini SVG Timer Ring -->
          <div class="relative w-8 h-8">
            <svg class="w-8 h-8 -rotate-90" viewBox="0 0 36 36">
              <circle cx="18" cy="18" r="14" fill="none" class="stroke-zinc-200 dark:stroke-zinc-800" stroke-width="3" />
              <circle id="timer-ring-arc" cx="18" cy="18" r="14" fill="none" stroke="currentColor" class="text-indigo-600 dark:text-indigo-400 transition-all duration-75" stroke-width="3" stroke-dasharray="88" stroke-dashoffset="0" stroke-linecap="round" />
            </svg>
          </div>
        </div>

        <!-- Cubes Comparison Area -->
        <div class="w-full max-w-lg grid grid-cols-2 gap-4 sm:gap-8 mb-8">
          <!-- Куб А Card -->
          <div class="flex flex-col items-center p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/80 shadow-inner">
            <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 dark:text-zinc-400 uppercase mb-2">Куб А</span>
            <div id="cube-a-container" class="w-36 h-36 sm:w-44 sm:h-44 flex items-center justify-center">
              <!-- Programmatic SVG injected -->
            </div>
          </div>

          <!-- Куб Б Card -->
          <div class="flex flex-col items-center p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/80 shadow-inner">
            <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 dark:text-zinc-400 uppercase mb-2">Куб Б</span>
            <div id="cube-b-container" class="w-36 h-36 sm:w-44 sm:h-44 flex items-center justify-center">
              <!-- Programmatic SVG injected -->
            </div>
          </div>
        </div>

        <!-- Action Response Buttons -->
        <div class="w-full max-w-md grid grid-cols-2 gap-4">
          <button
            id="btn-same"
            type="button"
            class="min-h-[56px] py-4 px-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border-2 border-emerald-500 text-emerald-700 dark:text-emerald-300 font-heading font-bold text-sm sm:text-base transition-all duration-200 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 active:scale-[0.98] flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer"
          >
            <span>ТАКОЙ ЖЕ</span>
            <span class="text-xs font-mono font-normal opacity-75 mt-0.5">Клавиша [ S ]</span>
          </button>

          <button
            id="btn-diff"
            type="button"
            class="min-h-[56px] py-4 px-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border-2 border-rose-500 text-rose-700 dark:text-rose-300 font-heading font-bold text-sm sm:text-base transition-all duration-200 hover:bg-rose-100 dark:hover:bg-rose-900/50 active:scale-[0.98] flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-600 cursor-pointer"
          >
            <span>ДРУГОЙ</span>
            <span class="text-xs font-mono font-normal opacity-75 mt-0.5">Клавиша [ D ]</span>
          </button>
        </div>

        <!-- Feedback Toast -->
        <div id="feedback-toast" role="status" aria-live="polite" class="h-6 mt-4 text-xs font-mono font-semibold transition-opacity opacity-0 text-zinc-500">
          Отзыв о результате
        </div>
      </div>
    </div>

    <!-- Как играть Instructions Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4"
    >
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-left relative max-h-[90vh] overflow-y-auto">
        <button
          id="btn-close-how-modal"
          type="button"
          aria-label="Закрыть окно «Как играть»"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
          </div>
          <div>
            <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
              Как играть: ментальное вращение 3D
            </h2>
            <p class="text-xs text-indigo-600 dark:text-indigo-400 font-medium">Визуально-пространственные задания (Gv)</p>
          </div>
        </div>

        <div class="space-y-4 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Механика игры</h4>
            <p>1. В каждой попытке два изометрических 3D-куба появляются рядом: Куб А и Куб Б.</p>
            <p>2. Мысленно вращайте Куб А в 3D-пространстве и проверьте, могут ли его цветные метки совпасть с Кубом Б.</p>
            <p>3. Если Куб Б — это верный 3D-поворот Куба А, нажмите <strong>ТАКОЙ ЖЕ [S]</strong>.</p>
            <p>4. Если какая-либо грань изменена или её невозможно получить одним вращением, нажмите <strong>ДРУГОЙ [D]</strong>.</p>
            <p>5. Отвечайте как можно быстрее: быстрые верные ответы дают больше бонусных очков в пределах лимита 8,0 с.</p>
          </div>

          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs uppercase tracking-wider font-mono">Управление с клавиатуры</h4>
            <ul class="space-y-1 text-xs font-mono">
              <li>• <span class="font-bold text-zinc-900 dark:text-white">[Пробел]</span> : Начать / перезапустить тренировку</li>
              <li>• <span class="font-bold text-emerald-600 dark:text-emerald-400">[S]</span> : куб ТАКОЙ ЖЕ</li>
              <li>• <span class="font-bold text-rose-600 dark:text-rose-400">[D]</span> : куб ДРУГОЙ</li>
              <li>• <span class="font-bold text-zinc-900 dark:text-white">[Escape]</span> : Закрыть окно</li>
            </ul>
          </div>

          <div class="p-3.5 rounded-2xl bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-900/60 text-xs">
            <span class="font-bold text-indigo-950 dark:text-indigo-200">Научная основа:</span>
            <span class="text-indigo-900 dark:text-indigo-300 ml-1">Парадигма ментального вращения (Шепард и Метцлер, 1971). Пространственные манипуляции, мысленные преобразования координат и скорость визуально-пространственной обработки (Gv).</span>
          </div>
        </div>

        <button
          id="btn-close-how-got-it"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-heading font-bold text-sm shadow-md transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <span>Понятно, начать</span>
        </button>
      </div>
    </div>

    <!-- End of Round Modal -->
    <div id="modal-end-round" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl text-center relative max-h-[90vh] overflow-y-auto">
        <!-- Top Right Dismiss Button -->
        <button
          id="btn-close-end-modal"
          type="button"
          aria-label="Закрыть окно итогов"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="w-14 h-14 rounded-2xl bg-indigo-100 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 flex items-center justify-center mx-auto mb-3">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>

        <h2 id="modal-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Тренировка завершена
        </h2>
        <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-4">
          Итог скорости пространственной визуализации
        </p>

        <!-- Standardized 0-100 Результат -->
        <div class="mb-5 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-800">
          <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            Результат
          </div>
          <div class="flex items-baseline justify-center gap-1.5 my-1">
            <span id="modal-perf-score" class="text-4xl sm:text-5xl font-extrabold font-heading text-zinc-950 dark:text-white">0</span>
            <span class="text-sm font-mono text-zinc-400">/ 100</span>
          </div>
          <div id="modal-tier-badge" class="mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border">
            <span id="modal-tier-name">Базовый уровень</span>
          </div>
          <p id="modal-tier-desc" class="mt-2 text-xs text-zinc-600 dark:text-zinc-400 max-w-sm mx-auto leading-relaxed"></p>
        </div>

        <!-- Paradigm-Specific Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Точность</div>
            <div id="modal-acc" class="font-bold text-base text-emerald-600 dark:text-emerald-400">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Медиана ВР</div>
            <div id="modal-speed" class="font-bold text-base text-indigo-600 dark:text-indigo-400">0 ms</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Верно</div>
            <div id="modal-correct" class="font-bold text-base text-zinc-900 dark:text-white">0 / 20</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-400 text-[10px] uppercase">Ошибки</div>
            <div id="modal-errors" class="font-bold text-base text-rose-500">0</div>
          </div>
        </div>

        <!-- Transparent Scoring Formula Card -->
        <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 text-left mb-4">
          <div class="text-[11px] font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider font-mono mb-1">
            Разбивка очков
          </div>
