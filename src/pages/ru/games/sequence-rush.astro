---
import Layout from '../../../components/ru/LayoutRu.astro';
import Header from '../../../components/ru/HeaderRu.astro';
import Footer from '../../../components/ru/FooterRu.astro';

const title = "Числовые последовательности онлайн: тест логических рядов на скорость | FreeIQExam";
const description = "Тест числовых последовательностей и рядов закономерностей онлайн: найдите скрытое математическое правило за минимальное время. Тренировка индуктивной логики (Gf).";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Гонка последовательностей",
    "url": "https://freeiqexam.com/ru/games/sequence-rush",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Скоростные индуктивные числовые ряды: распознавание алгоритмических паттернов и экстраполяция правил."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Когнитивные игры",
        "item": "https://freeiqexam.com/ru/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Гонка последовательностей",
        "item": "https://freeiqexam.com/ru/games/sequence-rush"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/games/sequence-rush" idPath="/permainan/sequence-rush" canonicalUrl="https://freeiqexam.com/ru/games/sequence-rush">
  <Header  enPath="/games/sequence-rush" idPath="/permainan/sequence-rush"/>

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Хлебные крошки">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <a href="/ru/games" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Когнитивные игры</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Sequence Rush</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-peach mb-1.5">
          Gf &bull; Подвижное мышление
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
          Гонка числовых последовательностей
        </h1>
          <button
            id="btn-how-to-play"
            type="button"
            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center p-2 rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 text-xs font-mono font-medium gap-1.5 cursor-pointer"
            aria-label="Как играть — инструкция"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
            <span>Как играть</span>
          </button>
        </div>
      </div>

      <!-- Stat HUD (4 rounded cards) -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Вопрос</div>
          <div id="hud-item" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 15</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Счёт</div>
          <div id="hud-score" class="font-bold text-indigo-600 dark:text-indigo-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Темп</div>
          <div id="hud-pace" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">-- s</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Рекорд</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center min-h-[440px] justify-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-peach flex items-center justify-center mb-5 shadow-lg shadow-indigo-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Sequence Rush
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Определите скрытое логическое правило ряда и выберите пропущенный элемент вместо маркера <span class="font-bold text-indigo-600 dark:text-indigo-400">[ ? ]</span>.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            15 задач на индуктивное мышление: арифметические, чередующиеся, рекурсивные и буквенные семейства правил.
          </p>
        </div>

        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-heading font-bold text-base shadow-md transition-all duration-200 active:scale-[0.97] flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600 cursor-pointer"
        >
          <span>Начать тренировку (Пробел)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content (inert while overlay active) -->
      <div id="game-arena-content" inert class="w-full flex flex-col items-center">
        <!-- Top Status & Pattern Family Badge -->
        <div class="w-full max-w-md flex items-center justify-between gap-4 mb-4 font-mono text-xs">
          <div id="family-badge" class="px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 font-semibold">
            Категория: Арифметическая прогрессия
          </div>
          <div id="timer-indicator" class="text-zinc-500 dark:text-zinc-400">
            Темп: <span id="item-timer" class="font-bold text-zinc-800 dark:text-zinc-200">0.0с</span>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="w-full max-w-md h-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full mb-6 overflow-hidden">
          <div id="series-progress" class="h-full bg-indigo-500 transition-all duration-200 w-0"></div>
        </div>

        <!-- Sequence Display Box -->
        <div class="w-full max-w-lg min-h-[140px] rounded-3xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80 flex flex-col items-center justify-center p-6 mb-6 shadow-inner">
          <div id="sequence-container" class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap">
            <!-- Rendered sequence pill cards inserted here -->
          </div>
          <div id="feedback-message" class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 mt-4 h-4">
            Определите правило
          </div>
        </div>

        <!-- 2x2 Multiple Choice Options Grid -->
        <div id="options-grid" class="w-full max-w-lg grid grid-cols-2 gap-3 sm:gap-4 mb-3">
          <!-- 4 option buttons dynamically populated -->
        </div>

        <p class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500 mt-2 text-center">
          Горячие клавиши: нажмите 1, 2, 3, 4 или A, B, C, D для ответа.
        </p>
      </div>
    </div>

    <!-- Accessible "Как играть" Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
        <button
          id="btn-close-how-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer"
          aria-label="Закрыть инструкцию"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
          </div>
          <h2 id="modal-how-title" class="text-xl font-heading font-bold text-zinc-950 dark:text-white">
            Как играть: Sequence Rush
          </h2>
        </div>

        <div class="space-y-3 text-sm text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
          <p>
            <strong>1. Выведение правила:</strong> В каждой задаче дан упорядоченный ряд чисел или букв с пропуском <code class="font-mono font-bold text-indigo-600 dark:text-indigo-400">[ ? ]</code>.
          </p>
          <p>
            <strong>2. Семейства рядов:</strong>
            <br />- <em>Арифметика и степени:</em> постоянные разности (+5), множители (*2) или квадраты (n^2).
            <br />- <em>Чередующиеся ряды:</em> два переплетённых паттерна или растущие разности (+1, +2, +3).
            <br />- <em>Рекурсия и Фибоначчи:</em> члены образуются из предыдущих элементов.
            <br />- <em>Буквенные скачки:</em> сдвиги по алфавиту (+2, +3 шага).
          </p>
          <p>
            <strong>3. Ответ:</strong> Нажмите один из 4 вариантов или клавиши <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">1-4</kbd> или <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">A-D</kbd>.
          </p>
          <p>
            <strong>4. Очки:</strong> Всего 15 вопросов. Точность даёт до 75 очков; быстрый темп решения — до 25 бонусных очков за скорость.
          </p>
        </div>

        <button
          id="btn-confirm-how"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-sm transition-all duration-200 cursor-pointer"
        >
          Понятно, начать
        </button>
      </div>
    </div>

    <!-- Accessible End of Round Modal -->
    <div
      id="modal-end-round"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-end-title"
      tabindex="-1"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden"
    >
      <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl text-center max-h-[90vh] overflow-y-auto">
        <!-- Close Button (X) -->
        <button
          id="btn-close-end-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 cursor-pointer"
          aria-label="Закрыть окно итогов"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h2 id="modal-end-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Сессия завершена!
        </h2>
        <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-5">
          Итог: подвижный интеллект и завершение рядов
        </p>

        <!-- Performance Score (0 - 100) -->
        <div class="mb-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
          <div class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
            Результат
          </div>
          <div id="modal-score" class="text-4xl sm:text-5xl font-extrabold text-indigo-600 dark:text-indigo-400 font-heading">
            0
          </div>
          <div class="mt-2.5 flex items-center justify-center gap-2">
            <span id="modal-tier-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700">
              Развивающийся
            </span>
          </div>
          <p id="modal-tier-desc" class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 max-w-sm mx-auto">
            Результат отражает точность выведения правил и беглость дедукции.
          </p>
        </div>

        <!-- Paradigm Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Решено</div>
            <div id="modal-solved" class="font-bold text-base text-indigo-600 dark:text-indigo-400">0 / 15</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Точность</div>
            <div id="modal-acc" class="font-bold text-base text-zinc-900 dark:text-white">0%</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Медианный темп</div>
            <div id="modal-pace" class="font-bold text-base text-zinc-900 dark:text-white">0 мс</div>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <div class="text-zinc-500 dark:text-zinc-400 text-[10px] uppercase">Лучшая серия</div>
            <div id="modal-streak" class="font-bold text-base text-zinc-900 dark:text-white">0</div>
          </div>
        </div>

        <!-- Personal Best Alert -->
        <div id="modal-best-alert" class="hidden mb-5 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-semibold">
          Новый рекорд!
        </div>

        <!-- Scientific Attribution Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-heading">Научная основа:</span>
          Классические парадигмы завершения индуктивных рядов (Спирмен, 1923; Кеттелл, 1971). Оценивает подвижный интеллект (Gf), выведение математических правил и экстраполяцию абстрактных паттернов.
        </div>

        <!-- Scoring Formula Breakdown Card -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-3.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed font-mono">
          <span class="font-bold text-zinc-900 dark:text-white block mb-1 font-sans">Подсчёт очков:</span>
          Счёт = (Индуктивная точность * 75) + Бонус за скорость дедукции (до 25 оч. за медианное время &lt; 2с)
        </div>

        <!-- Практика Effects Disclaimer -->
        <div class="text-left p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-700/60 mb-5 text-[11px] text-zinc-500 dark:text-zinc-400 italic leading-relaxed">
          Очки отражают беглость в конкретной задаче и скорость ответов с учётом эффекта практики, а не врождённый общий интеллект (g). Повторные тренировки развивают когнитивную гибкость.
        </div>

        <div class="flex items-center gap-3">
          <button
            id="btn-modal-restart"
            type="button"
            class="flex-1 min-h-[44px] py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-sm transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
          >
            Играть снова
          </button>
          <a
            href="/ru/games"
            class="px-5 min-h-[44px] flex items-center justify-center rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-sm transition-colors"
          >
            Каталог
          </a>
        </div>
      </div>
    </div>

    <!-- Educational Guide & Cognitive Science Section (Crawler Visible) -->
    <section class="mt-14 pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-peach mb-2">
          CHC: Подвижный интеллект (Gf) и количественная индукция (Gq)
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          Числовые ряды: индуктивная логика и экстраполяция паттернов
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
