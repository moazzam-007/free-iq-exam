</Layout>

<script>
  import { saveGameRecord, getPerformanceTier } from '../../../utils/profileStore';

  interface ColorItem {
    name: string;
    label: string;
    textClass: string;
  }

  interface TrialStimulus {
    word: string;
    inkName: string;
    inkClass: string;
    isCongruent: boolean;
  }

  const COLORS: ColorItem[] = [
    { name: 'red', label: 'КРАСНЫЙ', textClass: 'text-red-600 dark:text-red-400' },
    { name: 'blue', label: 'СИНИЙ', textClass: 'text-blue-600 dark:text-blue-400' },
    { name: 'green', label: 'ЗЕЛЁНЫЙ', textClass: 'text-emerald-600 dark:text-emerald-400' },
    { name: 'yellow', label: 'ЖЁЛТЫЙ', textClass: 'text-amber-500 dark:text-amber-400' },
  ];
  const RU_INK: Record<string, string> = { red: 'КРАСНЫЙ', blue: 'СИНИЙ', green: 'ЗЕЛЁНЫЙ', yellow: 'ЖЁЛТЫЙ' };

  const TOTAL_TRIALS = 25;
  const CONGRUENT_COUNT = 10;
  const INCONGRUENT_COUNT = 15;
  const STORAGE_KEY = 'fiq_game_stroopclash_best';

  let currentTrialIndex = 0;
  let trialDeck: TrialStimulus[] = [];
  let isRunning = false;
  let isAcceptingInput = false;
  let trialStartTime = 0;
  let sessionStartTime = 0;

  let correctCount = 0;
  let errorCount = 0;
  let currentStreak = 0;
  let longestStreak = 0;

  let allRTs: number[] = [];
  let congruentRTs: number[] = [];
  let incongruentRTs: number[] = [];

  // Audio Context (pure Web Audio)
  let audioCtx: AudioContext | null = null;
  function playSound(isCorrect: boolean) {
    try {
      if (!audioCtx) {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) audioCtx = new AudioCtx();
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      if (audioCtx) {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = isCorrect ? 880 : 220;
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + (isCorrect ? 0.08 : 0.15));
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + (isCorrect ? 0.08 : 0.15));
      }
    } catch {
      // Audio fallback
    }
  }

  // DOM Elements
  const hudTrial = document.getElementById('hud-trial') as HTMLElement;
  const hudScore = document.getElementById('hud-score') as HTMLElement;
  const hudSpeed = document.getElementById('hud-speed') as HTMLElement;
  const hudBest = document.getElementById('hud-best') as HTMLElement;

  const startOverlay = document.getElementById('start-overlay') as HTMLElement;
  const btnStartGame = document.getElementById('btn-start-game') as HTMLButtonElement;
  const gameArenaContent = document.getElementById('game-arena-content') as HTMLElement;

  const trialCounterText = document.getElementById('trial-counter-text') as HTMLElement;
  const trialProgressBar = document.getElementById('trial-progress-bar') as HTMLElement;
  const stimulusFixation = document.getElementById('stimulus-fixation') as HTMLElement;
  const stimulusWord = document.getElementById('stimulus-word') as HTMLElement;
  const feedbackToast = document.getElementById('feedback-toast') as HTMLElement;

  const btnHowToPlay = document.getElementById('btn-how-to-play') as HTMLButtonElement;
  const modalHowToPlay = document.getElementById('modal-how-to-play') as HTMLElement;
  const btnCloseHowModal = document.getElementById('btn-close-how-modal') as HTMLButtonElement;
  const btnConfirmHow = document.getElementById('btn-confirm-how') as HTMLButtonElement;

  const modalEndRound = document.getElementById('modal-end-round') as HTMLElement;
  const btnCloseEndModal = document.getElementById('btn-close-end-modal') as HTMLButtonElement;
  const modalScore = document.getElementById('modal-score') as HTMLElement;
  const modalTierBadge = document.getElementById('modal-tier-badge') as HTMLElement;
  const modalTierDesc = document.getElementById('modal-tier-desc') as HTMLElement;
  const modalAcc = document.getElementById('modal-acc') as HTMLElement;
  const modalMedianRt = document.getElementById('modal-median-rt') as HTMLElement;
  const modalInterference = document.getElementById('modal-interference') as HTMLElement;
  const modalStreak = document.getElementById('modal-streak') as HTMLElement;
  const modalCongruentRt = document.getElementById('modal-congruent-rt') as HTMLElement;
  const modalIncongruentRt = document.getElementById('modal-incongruent-rt') as HTMLElement;
  const modalBestAlert = document.getElementById('modal-best-alert') as HTMLElement;
  const btnModalRestart = document.getElementById('btn-modal-restart') as HTMLButtonElement;

  const colorButtons = [
    document.getElementById('btn-color-red') as HTMLButtonElement,
    document.getElementById('btn-color-blue') as HTMLButtonElement,
    document.getElementById('btn-color-green') as HTMLButtonElement,
    document.getElementById('btn-color-yellow') as HTMLButtonElement,
  ];

  function loadBestScore() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && hudBest) {
        hudBest.textContent = saved;
      }
    } catch {
      // Storage fallback
    }
  }
  loadBestScore();

  function calculateMedian(arr: number[]): number {
    if (arr.length === 0) return 0;
    const sorted = [...arr].sort((a, b) => a - b);
    const mid = Math.floor(sorted.length / 2);
    if (sorted.length % 2 !== 0) {
      return sorted[mid];
    }
    return Math.round((sorted[mid - 1] + sorted[mid]) / 2);
  }

  function generateTrials(): TrialStimulus[] {
    const list: TrialStimulus[] = [];

    // 10 Congruent trials
    for (let i = 0; i < CONGRUENT_COUNT; i++) {
      const col = COLORS[Math.floor(Math.random() * COLORS.length)];
      list.push({
        word: col.label,
        inkName: col.name,
        inkClass: col.textClass,
        isCongruent: true,
      });
    }

    // 15 Incongruent trials
    for (let i = 0; i < INCONGRUENT_COUNT; i++) {
      const ink = COLORS[Math.floor(Math.random() * COLORS.length)];
      const otherWords = COLORS.filter((c) => c.name !== ink.name);
      const wordChoice = otherWords[Math.floor(Math.random() * otherWords.length)];
      list.push({
        word: wordChoice.label,
        inkName: ink.name,
        inkClass: ink.textClass,
        isCongruent: false,
      });
    }

    // Fisher-Yates Shuffle
    for (let i = list.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [list[i], list[j]] = [list[j], list[i]];
    }

    return list;
  }

  function updateHud() {
    hudTrial.textContent = `${currentTrialIndex} / ${TOTAL_TRIALS}`;

    if (allRTs.length > 0) {
      const curMed = calculateMedian(allRTs);
      const curScore = Math.round((correctCount / Math.max(1, currentTrialIndex)) * 50) +
        Math.max(0, Math.min(40, Math.round((1400 - curMed) / 20)));
      hudScore.textContent = String(Math.max(0, Math.min(100, curScore)));
      hudSpeed.textContent = `${curMed}ms`;
    } else {
      hudScore.textContent = '0';
      hudSpeed.textContent = '0ms';
    }
  }

  function showToast(text: string, isSuccess: boolean) {
    if (!feedbackToast) return;
    feedbackToast.textContent = text;
    feedbackToast.className = `h-6 mt-1 text-xs font-mono font-semibold transition-opacity opacity-100 ${
      isSuccess ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'
    }`;
    setTimeout(() => {
      if (feedbackToast) feedbackToast.classList.add('opacity-0');
    }, 450);
  }

  function renderStimulus() {
    if (currentTrialIndex >= TOTAL_TRIALS) {
      finishSession();
      return;
    }

    isAcceptingInput = false;
    const progressPercent = ((currentTrialIndex + 1) / TOTAL_TRIALS) * 100;
    trialProgressBar.style.width = `${progressPercent}%`;
    trialCounterText.textContent = `Trial ${currentTrialIndex + 1} из ${TOTAL_TRIALS}`;

    // Inter-trial fixation cross (180ms)
    stimulusWord.classList.add('hidden');
    stimulusFixation.classList.remove('hidden');

    setTimeout(() => {
      if (!isRunning) return;
      stimulusFixation.classList.add('hidden');

      const trial = trialDeck[currentTrialIndex];
      stimulusWord.textContent = trial.word;
      stimulusWord.className = `text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-wider transition-all select-none font-heading ${trial.inkClass}`;
      stimulusWord.classList.remove('hidden');

      trialStartTime = performance.now();
      isAcceptingInput = true;
    }, 180);
  }

  function handleUserChoice(selectedColor: string) {
    if (!isRunning || !isAcceptingInput) return;
    isAcceptingInput = false;

    const rt = Math.round(performance.now() - trialStartTime);
    const trial = trialDeck[currentTrialIndex];
    const isCorrect = selectedColor === trial.inkName;

    allRTs.push(rt);
    if (trial.isCongruent) {
      congruentRTs.push(rt);
    } else {
      incongruentRTs.push(rt);
    }

    if (isCorrect) {
      correctCount++;
      currentStreak++;
      if (currentStreak > longestStreak) longestStreak = currentStreak;
      playSound(true);
      showToast(`Верно (${rt}мс)`, true);
    } else {
      errorCount++;
      currentStreak = 0;
      playSound(false);
      showToast(`Мимо: был ${RU_INK[trial.inkName] ?? trial.inkName}`, false);
    }

    currentTrialIndex++;
    updateHud();
    renderStimulus();
  }

  function startSession() {
    isRunning = true;
    currentTrialIndex = 0;
    correctCount = 0;
    errorCount = 0;
    currentStreak = 0;
    longestStreak = 0;
    allRTs = [];
    congruentRTs = [];
    incongruentRTs = [];
    trialDeck = generateTrials();

    if (gameArenaContent) gameArenaContent.removeAttribute('inert');
    startOverlay.classList.add('hidden');
    modalEndRound.classList.add('hidden');
    modalEndRound.classList.remove('flex');

    sessionStartTime = performance.now();
    updateHud();
    renderStimulus();
  }

  function finishSession() {
    isRunning = false;
    isAcceptingInput = false;
    if (gameArenaContent) gameArenaContent.setAttribute('inert', '');

    const sessionDurationSec = Math.max(1, Math.round((performance.now() - sessionStartTime) / 1000));
    const medianRT = calculateMedian(allRTs);
    const congruentMedianRT = calculateMedian(congruentRTs.length > 0 ? congruentRTs : allRTs);
    const incongruentMedianRT = calculateMedian(incongruentRTs.length > 0 ? incongruentRTs : allRTs);
    const interferenceCostMs = Math.max(0, incongruentMedianRT - congruentMedianRT);
    const accuracy = correctCount / TOTAL_TRIALS;

    // 0 - 100 Performance Score Formula (from specification)
    const accuracyWeight = Math.round((correctCount / 25) * 50);
    const speedFactor = Math.max(0, Math.min(40, Math.round((1400 - medianRT) / 20)));
    const interferenceBonus = Math.max(0, Math.min(10, Math.round((250 - interferenceCostMs) / 25)));
    const performanceScore = Math.min(100, Math.max(0, accuracyWeight + speedFactor + interferenceBonus));

    // Save record to profile store
    saveGameRecord({
      gameId: 'stroop-clash',
      durationSeconds: sessionDurationSec,
      mode: 'standard',
      metrics: {
        performanceScore: performanceScore,
        accuracy: Number((correctCount / 25).toFixed(2)),
        trialsCompleted: 25,
        correctCount: correctCount,
        errorCount: errorCount,
        medianRT: Math.round(medianRT),
        interferenceCostMs: Math.round(interferenceCostMs),
        bestStreak: longestStreak,
      },
    });

    // Check personal best
    let savedBest = 0;
    try {
      savedBest = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
    } catch {
      // Storage fallback
    }

    const isNewBest = performanceScore > savedBest;
    if (isNewBest) {
      try {
        localStorage.setItem(STORAGE_KEY, performanceScore.toString());
        loadBestScore();
      } catch {
        // Storage fallback
      }
      modalBestAlert.classList.remove('hidden');
    } else {
      modalBestAlert.classList.add('hidden');
    }

    // Populate modal
    modalScore.textContent = String(performanceScore);
    modalAcc.textContent = `${Math.round(accuracy * 100)}%`;
    modalMedianRt.textContent = `${medianRT}ms`;
    modalInterference.textContent = `+${interferenceCostMs}ms`;
    modalStreak.textContent = String(longestStreak);
    modalCongruentRt.textContent = `${congruentMedianRT}ms`;
    modalIncongruentRt.textContent = `${incongruentMedianRT}ms`;

    // Tier badge & styling
    const tier = getPerformanceTier(performanceScore);
    modalTierBadge.textContent = tier.tier;
    modalTierBadge.className = `inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ${tier.badgeClass}`;
    modalTierDesc.textContent = tier.description;

    // Show modal & focus
    modalEndRound.classList.remove('hidden');
    modalEndRound.classList.add('flex');
    if (btnCloseEndModal) {
      try {
        btnCloseEndModal.focus();
      } catch {
        // Focus fallback
      }
    }
  }

  // Event Listeners for Color Buttons
  colorButtons.forEach((btn) => {
    if (btn) {
      btn.addEventListener('click', () => {
        const color = btn.getAttribute('data-color');
        if (color) handleUserChoice(color);
      });
    }
  });

  // Start Session
  btnStartGame.addEventListener('click', startSession);
  btnModalRestart.addEventListener('click', () => {
    modalEndRound.classList.add('hidden');
    modalEndRound.classList.remove('flex');
    startSession();
  });

  // How to Play Modal Triggers & Focus Traps
  btnHowToPlay.addEventListener('click', () => {
    modalHowToPlay.classList.remove('hidden');
    modalHowToPlay.classList.add('flex');
    btnCloseHowModal.focus();
  });

  function closeHowModal() {
    modalHowToPlay.classList.add('hidden');
    modalHowToPlay.classList.remove('flex');
    btnHowToPlay.focus();
  }

  btnCloseHowModal.addEventListener('click', closeHowModal);
  btnConfirmHow.addEventListener('click', closeHowModal);

  // Close End Modal
  function closeEndModal() {
    modalEndRound.classList.add('hidden');
    modalEndRound.classList.remove('flex');
    if (startOverlay) {
      startOverlay.classList.remove('hidden');
      btnStartGame.focus();
    }
  }
  btnCloseEndModal.addEventListener('click', closeEndModal);

  // Modal Backdrop Dismiss
  modalHowToPlay.addEventListener('click', (e) => {
    if (e.target === modalHowToPlay) closeHowModal();
  });

  modalEndRound.addEventListener('click', (e) => {
    if (e.target === modalEndRound) closeEndModal();
  });

  // Keyboard Shortcuts (R, B, G, Y, 1, 2, 3, 4, Space, Escape)
  window.addEventListener('keydown', (e) => {
    if (e.repeat) return;
    const key = e.key.toLowerCase();

    // Escape closes modals
    if (e.key === 'Escape') {
      if (!modalHowToPlay.classList.contains('hidden')) {
        closeHowModal();
        return;
      }
      if (!modalEndRound.classList.contains('hidden')) {
        closeEndModal();
        return;
      }
    }

    // If any modal is active, do not trigger game actions
    const isModalActive =
      !modalHowToPlay.classList.contains('hidden') ||
      !modalEndRound.classList.contains('hidden');

    if (isModalActive) return;

    // Space starts game if on overlay
    if (key === ' ' && !isRunning && !startOverlay.classList.contains('hidden')) {
      e.preventDefault();
      startSession();
      return;
    }

    // Response keys during play
    if (isRunning && isAcceptingInput) {
      if (key === 'r' || key === '1') {
        e.preventDefault();
        handleUserChoice('red');
      } else if (key === 'b' || key === '2') {
        e.preventDefault();
        handleUserChoice('blue');
      } else if (key === 'g' || key === '3') {
        e.preventDefault();
        handleUserChoice('green');
      } else if (key === 'y' || key === '4') {
        e.preventDefault();
        handleUserChoice('yellow');
      }
    }
  });
</script>
