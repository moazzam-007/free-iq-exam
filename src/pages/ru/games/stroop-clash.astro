---
import Layout from '../../../components/ru/LayoutRu.astro';
import Header from '../../../components/ru/HeaderRu.astro';
import Footer from '../../../components/ru/FooterRu.astro';

const title = "Тест Струпа: цвет и слово — игра на внимание бесплатно";
const description = "Называйте цвет чернил, игнорируя значение слова. Классическая проба когнитивного контроля.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Струп-тест",
    "url": "https://freeiqexam.com/ru/games/stroop-clash",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Научный тест эффекта Струпа: тормозный контроль, когнитивная интерференция и скорость избирательного внимания."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Когнитивные игры",
        "item": "https://freeiqexam.com/ru/games"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Струп-тест",
        "item": "https://freeiqexam.com/ru/games/stroop-clash"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/games/stroop-clash" idPath="/permainan/stroop-clash" canonicalUrl="https://freeiqexam.com/ru/games/stroop-clash">
  <Header  enPath="/games/stroop-clash" idPath="/permainan/stroop-clash"/>

  <main class="flex-1 game-pastel-wrap game-pastel py-10 md:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <a href="/ru/games" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Когнитивные игры</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Stroop Clash</span>
    </nav>

    <!-- Header / HUD -->
    <section class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium uppercase tracking-wider pastel-tag pastel-tag-coral mb-1.5">
          Gf / Gs &bull; Inhibitory Control
        </div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl sm:text-3xl font-heading font-bold text-zinc-950 dark:text-white">
            Stroop Color Clash
          </h1>
          <button
            id="btn-how-to-play"
            type="button"
            class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center p-2 rounded-xl text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 text-xs font-mono font-medium gap-1.5 cursor-pointer"
            aria-label="Как играть — инструкция"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M12 18h.01" />
            </svg>
            <span>Как играть</span>
          </button>
        </div>
      </div>

      <!-- Stat HUD (4 rounded cards) -->
      <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-3 font-mono text-xs sm:text-sm">
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Попытка</div>
          <div id="hud-trial" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0 / 25</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Счёт</div>
          <div id="hud-score" class="font-bold text-rose-600 dark:text-rose-400 text-sm sm:text-base">0</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[64px] sm:min-w-[76px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Медиана ВР</div>
          <div id="hud-speed" class="font-bold text-zinc-800 dark:text-zinc-200 text-sm sm:text-base">0ms</div>
        </div>
        <div class="px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-xl pastel-hud text-center min-w-[60px] sm:min-w-[70px]">
          <div class="text-zinc-500 dark:text-zinc-400 text-[10px] sm:text-xs font-mono font-medium uppercase tracking-wider">Рекорд</div>
          <div id="hud-best" class="font-bold text-zinc-700 dark:text-zinc-300 text-sm sm:text-base">--</div>
        </div>
      </div>
    </section>

    <!-- Main Game Arena -->
    <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-10 shadow-sm flex flex-col items-center min-h-[440px] justify-center">
      <!-- Start Screen Overlay -->
      <div id="start-overlay" class="absolute inset-0 z-20 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md rounded-3xl flex flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-2xl pastel-start-icon-coral flex items-center justify-center mb-5 shadow-lg shadow-rose-500/20">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
        </div>
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-zinc-950 dark:text-white mb-3">
          Stroop Color Clash
        </h2>
        <div class="max-w-md text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6 space-y-2">
          <p>
            Identify the <strong>INK COLOR</strong> из each printed word as quickly as possible.
          </p>
          <p>
            Suppress the reflex to read the word text. If the word <strong>RED</strong> is printed in <span class="text-blue-600 dark:text-blue-400 font-bold">BLUE INK</span>, press <strong>BLUE</strong>.
          </p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 pt-2 font-mono">
            25 trials (40% congruent, 60% incongruent conflict). Speed throughput и inhibitory resistance dictate your performance score.
          </p>
        </div>
        <button
          id="btn-start-game"
          type="button"
          class="min-h-[44px] px-8 py-3.5 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white font-heading font-bold text-base shadow-md transition-all duration-200 active:scale-[0.97] flex items-center gap-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-600 cursor-pointer"
        >
          <span>Начать тренировку (Пробел)</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>

      <!-- Interactive Game Content (inert while overlay active) -->
      <div id="game-arena-content" inert class="w-full flex flex-col items-center">
        <!-- Trial Progress Bar -->
        <div class="w-full max-w-xl mb-8">
          <div class="flex items-center justify-between text-xs font-mono font-semibold mb-2">
            <span class="text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Прогресс</span>
            <span id="trial-counter-text" class="text-xs font-bold text-rose-600 dark:text-rose-400 font-mono">Попытка 1 из 25</span>
          </div>
          <div class="w-full h-2 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden border border-zinc-200 dark:border-zinc-700/60">
            <div id="trial-progress-bar" class="h-full bg-rose-500 rounded-full transition-all duration-200" style="width: 4%;"></div>
          </div>
        </div>

        <!-- Stimulus Word Card -->
        <div class="w-full max-w-lg mb-8 flex flex-col items-center">
          <div class="w-full py-12 px-6 rounded-3xl bg-zinc-50 dark:bg-zinc-800/50 border-2 border-zinc-200 dark:border-zinc-700 flex flex-col items-center justify-center min-h-[180px] shadow-inner transition-all">
            <span id="stimulus-fixation" class="text-4xl sm:text-5xl font-mono font-bold text-zinc-400 dark:text-zinc-600 hidden select-none">+</span>
            <span id="stimulus-word" class="text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-wider transition-all select-none font-heading">
              ГОТОВ
            </span>
          </div>
        </div>

        <!-- Color Response Controls (4 distinct buttons, min-h-[52px]) -->
        <div class="w-full max-w-lg grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-4">
          <!-- Red -->
          <button
            id="btn-color-red"
            type="button"
            data-color="red"
            class="min-h-[52px] group relative flex flex-col items-center justify-center p-3 rounded-2xl bg-red-50 hover:bg-red-100 dark:bg-red-950/40 dark:hover:bg-red-900/60 border-2 border-red-300 dark:border-red-800 text-red-700 dark:text-red-300 shadow-sm transition-all duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 cursor-pointer"
          >
            <div class="flex items-center gap-1.5 font-heading font-bold text-base sm:text-lg">
              <span class="w-3 h-3 rounded-full bg-red-500"></span>
              <span>Красный</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-red-600/80 dark:text-red-400/80 mt-0.5">[R / 1]</span>
          </button>

          <!-- Blue -->
          <button
            id="btn-color-blue"
            type="button"
            data-color="blue"
            class="min-h-[52px] group relative flex flex-col items-center justify-center p-3 rounded-2xl bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/40 dark:hover:bg-blue-900/60 border-2 border-blue-300 dark:border-blue-800 text-blue-700 dark:text-blue-300 shadow-sm transition-all duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 cursor-pointer"
          >
            <div class="flex items-center gap-1.5 font-heading font-bold text-base sm:text-lg">
              <span class="w-3 h-3 rounded-full bg-blue-500"></span>
              <span>Синий</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-blue-600/80 dark:text-blue-400/80 mt-0.5">[B / 2]</span>
          </button>

          <!-- Green -->
          <button
            id="btn-color-green"
            type="button"
            data-color="green"
            class="min-h-[52px] group relative flex flex-col items-center justify-center p-3 rounded-2xl bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/40 dark:hover:bg-emerald-900/60 border-2 border-emerald-300 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 shadow-sm transition-all duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 cursor-pointer"
          >
            <div class="flex items-center gap-1.5 font-heading font-bold text-base sm:text-lg">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              <span>Зелёный</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-emerald-600/80 dark:text-emerald-400/80 mt-0.5">[G / 3]</span>
          </button>

          <!-- Yellow -->
          <button
            id="btn-color-yellow"
            type="button"
            data-color="yellow"
            class="min-h-[52px] group relative flex flex-col items-center justify-center p-3 rounded-2xl bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/40 dark:hover:bg-amber-900/60 border-2 border-amber-300 dark:border-amber-800 text-amber-700 dark:text-amber-300 shadow-sm transition-all duration-200 active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 cursor-pointer"
          >
            <div class="flex items-center gap-1.5 font-heading font-bold text-base sm:text-lg">
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              <span>Жёлтый</span>
            </div>
            <span class="text-[11px] font-mono font-semibold text-amber-600/80 dark:text-amber-400/80 mt-0.5">[Y / 4]</span>
          </button>
        </div>

        <!-- Feedback Toast / Status -->
        <div id="feedback-toast" role="status" aria-live="polite" class="h-6 mt-1 text-xs font-mono font-semibold transition-opacity opacity-0 text-zinc-500">
          Status
        </div>
      </div>
    </div>

    <!-- Accessible How to Play Modal -->
    <div
      id="modal-how-to-play"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-how-title"
      tabindex="-1"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4"
    >
      <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl">
        <!-- Close Button (X) -->
        <button
          id="btn-close-how-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 cursor-pointer"
          aria-label="Закрыть инструкцию"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <h2 id="modal-how-title" class="text-xl sm:text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1.5">
          Как играть: Струп-тест
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mb-5">
          Тренировка тормозного контроля и скорости обработки
        </p>

        <div class="space-y-3.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed mb-6">
          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <h4 class="font-bold text-zinc-950 dark:text-white mb-1">1. Главное правило</h4>
            <p>
              Определяйте <strong>ЦВЕТ ЧЕРНИЛ</strong>, которым написано слово, а <strong>НЕ</strong> значение самого слова.
            </p>
          </div>

          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <h4 class="font-bold text-zinc-950 dark:text-white mb-1">2. Как устроен конфликт</h4>
            <ul class="space-y-1.5 list-disc list-inside">
              <li>
                <strong>Конгруэнтный (40%):</strong> слово совпадает с цветом (например, «КРАСНЫЙ» красными чернилами). Жмите <strong>Красный</strong>.
              </li>
              <li>
                <strong>Неконгруэнтный (60%):</strong> слово противоречит цвету (например, «КРАСНЫЙ» синими чернилами). Жмите <strong>Синий</strong>.
              </li>
            </ul>
          </div>

          <div class="p-3.5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
            <h4 class="font-bold text-zinc-950 dark:text-white mb-1">3. Горячие клавиши</h4>
            <p>
              Клавиши <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">R</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">1</kbd> — Красный, <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">B</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">2</kbd> — Синий, <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">G</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">3</kbd> — Зелёный, и <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">Y</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-700 font-mono text-xs">4</kbd> — Жёлтый.
            </p>
          </div>

          <div class="p-3.5 rounded-2xl bg-rose-50/60 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/60 text-rose-900 dark:text-rose-200">
            <h4 class="font-bold mb-1">4. Научная основа</h4>
            <p>
              Методика Дж. Р. Струпа (парадигма интерференции, 1935). Автоматическое чтение мешает называть цвет — требуется активное торможение префронтальной коры.
            </p>
          </div>
        </div>

        <button
          id="btn-confirm-how"
          type="button"
          class="w-full min-h-[44px] py-3 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-semibold text-sm shadow-sm transition-all duration-200 hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
        >
          Понятно, начать
        </button>
      </div>
    </div>

    <!-- Accessible End of Round Modal -->
    <div
      id="modal-end-round"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-end-title"
      tabindex="-1"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto"
    >
      <div class="relative game-pastel-arena rounded-3xl p-6 sm:p-8 max-w-lg w-full shadow-2xl my-8 text-center">
        <!-- Close Button (X) -->
        <button
          id="btn-close-end-modal"
          type="button"
          class="absolute top-4 right-4 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 cursor-pointer"
          aria-label="Закрыть итог"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="w-14 h-14 rounded-2xl bg-rose-100 text-rose-600 dark:bg-rose-950/60 dark:text-rose-400 flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
        </div>

        <h2 id="modal-end-title" class="text-2xl font-heading font-bold text-zinc-950 dark:text-white mb-1">
          Сессия завершена!
        </h2>
        <p class="text-xs sm:text-sm font-medium text-zinc-500 dark:text-zinc-400 mb-5">
          Inhibitory Control & Conflict Resolution Summary
        </p>

        <!-- Performance Score (0 - 100) -->
        <div class="mb-4 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
          <div class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
            Task Performance Score
          </div>
          <div id="modal-score" class="text-4xl sm:text-5xl font-extrabold text-rose-600 dark:text-rose-400 font-heading">
            0
          </div>
          <div class="mt-2.5 flex items-center justify-center gap-2">
            <span id="modal-tier-badge" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700">
              Developing
            </span>
          </div>
          <p id="modal-tier-desc" class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 max-w-sm mx-auto">
            Performance reflects task fluency и processing speed.
          </p>
        </div>

        <!-- Paradigm Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-5 font-mono text-center">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60">
