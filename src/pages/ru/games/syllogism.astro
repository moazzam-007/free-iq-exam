      gameArenaContent.setAttribute('inert', '');
    }

    function calculateMedian(arr: number[]): number {
      if (!arr || arr.length === 0) return 0;
      var sorted = arr.slice().sort(function(a, b) { return a - b; });
      var mid = Math.floor(sorted.length / 2);
      return sorted.length % 2 !== 0 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    }

    function loadBestScore() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          hudBest.textContent = saved;
        }
      } catch (e) {}
    }
    loadBestScore();

    function updateHud() {
      hudItem.textContent = currentItemIndex + ' / ' + TOTAL_ITEMS;
      hudScore.textContent = score.toString();
      if (responseTimes.length > 0) {
        var sum = 0;
        for (var i = 0; i < responseTimes.length; i++) sum += responseTimes[i];
        var avg = (sum / responseTimes.length / 1000).toFixed(1);
        hudAvgTime.textContent = avg + 's';
      } else {
        hudAvgTime.textContent = '0.0s';
      }
    }

    function selectSessionItems() {
      var pool = SYLLOGISM_BANK.slice();
      pool.sort(function() { return 0.5 - Math.random(); });
      sessionItems = pool.slice(0, TOTAL_ITEMS);
    }

    function renderCurrentItem() {
      isAnsweringLocked = false;
      var item = sessionItems[currentItemIndex];
      premise1Text.textContent = item.p1;
      premise2Text.textContent = item.p2;
      conclusionText.textContent = item.c;

      btnValid.className = 'min-h-[56px] py-4 px-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border-2 border-emerald-500 hover:border-emerald-600 dark:hover:border-emerald-400 text-emerald-700 dark:text-emerald-300 font-heading font-bold text-sm sm:text-base transition-all duration-100 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 active:scale-95 flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 cursor-pointer';
      btnInvalid.className = 'min-h-[56px] py-4 px-4 rounded-2xl bg-rose-50 dark:bg-rose-950/40 border-2 border-rose-500 hover:border-rose-600 dark:hover:border-rose-400 text-rose-700 dark:text-rose-300 font-heading font-bold text-sm sm:text-base transition-all duration-100 hover:bg-rose-100 dark:hover:bg-rose-900/50 active:scale-95 flex flex-col items-center justify-center shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-600 cursor-pointer';

      startTrialTimer();
    }

    function startTrialTimer() {
      itemStartTime = performance.now();
      lastDisplayedTenth = -1;

      function step() {
        if (!isRunning) return;
        var elapsed = performance.now() - itemStartTime;
        var remaining = Math.max(0, ITEM_TIME_LIMIT_MS - elapsed);
        var fraction = remaining / ITEM_TIME_LIMIT_MS;

        var currentTenth = Math.floor(remaining / 100);
        if (currentTenth !== lastDisplayedTenth) {
          lastDisplayedTenth = currentTenth;
          trialTimerText.textContent = (remaining / 1000).toFixed(1) + 's';
        }
        trialProgressBar.style.width = (fraction * 100).toFixed(1) + '%';

        if (remaining <= 4000) {
          trialTimerText.classList.add('text-rose-600', 'dark:text-rose-400');
          trialProgressBar.classList.remove('bg-amber-500');
          trialProgressBar.classList.add('bg-rose-500');
        } else {
          trialTimerText.classList.remove('text-rose-600', 'dark:text-rose-400');
          trialProgressBar.classList.add('bg-amber-500');
          trialProgressBar.classList.remove('bg-rose-500');
        }

        if (remaining > 0) {
          timerAnimFrame = requestAnimationFrame(step);
        } else {
          handleTimeout();
        }
      }

      timerAnimFrame = requestAnimationFrame(step);
    }

    function handleTimeout() {
      cancelAnimationFrame(timerAnimFrame);
      if (isAnsweringLocked) return;
      isAnsweringLocked = true;

      var elapsed = ITEM_TIME_LIMIT_MS;
      responseTimes.push(elapsed);
      currentStreak = 0;

      var cur = sessionItems[currentItemIndex];
      userLog.push({
        item: cur,
        userAnswer: 'Время вышло',
        isCorrect: false,
        timeMs: elapsed
      });

      nextItem();
    }

    function handleAnswer(userValid: boolean) {
      if (!isRunning || isAnsweringLocked) return;
      isAnsweringLocked = true;
      cancelAnimationFrame(timerAnimFrame);

      var elapsed = performance.now() - itemStartTime;
      responseTimes.push(elapsed);

      var cur = sessionItems[currentItemIndex];
      var isCorrect = userValid === cur.valid;

      if (isCorrect) {
        correctCount++;
        currentStreak++;
        if (currentStreak > longestStreak) longestStreak = currentStreak;

        if (cur.valid) {
          validIdentified++;
        } else {
          fallaciesIdentified++;
        }

        var pts = 0;
        if (elapsed < 5000) {
          pts = 20;
        } else if (elapsed < 10000) {
          pts = 15;
        } else {
          pts = 10;
        }
        score += pts;

        if (userValid) {
          btnValid.classList.add('ring-4', 'ring-emerald-400');
        } else {
          btnInvalid.classList.add('ring-4', 'ring-emerald-400');
        }
      } else {
        currentStreak = 0;
        score = Math.max(0, score - 5);
        if (userValid) {
          btnValid.classList.add('ring-4', 'ring-rose-400');
        } else {
          btnInvalid.classList.add('ring-4', 'ring-rose-400');
        }
      }

      userLog.push({
        item: cur,
        userAnswer: userValid ? 'Верно' : 'Неверно',
        isCorrect: isCorrect,
        timeMs: elapsed
      });

      updateHud();
      setTimeout(nextItem, 300);
    }

    function nextItem() {
      currentItemIndex++;
      updateHud();

      if (currentItemIndex >= TOTAL_ITEMS) {
        finishDrill();
        return;
      }

      renderCurrentItem();
    }

    function startDrill() {
      isRunning = true;
      currentItemIndex = 0;
      score = 0;
      correctCount = 0;
      validIdentified = 0;
      fallaciesIdentified = 0;
      currentStreak = 0;
      longestStreak = 0;
      responseTimes = [];
      userLog = [];
      lastDisplayedTenth = -1;
      sessionStartTime = performance.now();

      if (gameArenaContent) gameArenaContent.removeAttribute('inert');
      startOverlay.classList.add('hidden');
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
      if (modalHowToPlay) {
        modalHowToPlay.classList.add('hidden');
        modalHowToPlay.classList.remove('flex');
      }
      reviewContent.classList.add('hidden');
      reviewChevron.classList.remove('rotate-180');
      btnToggleReview.setAttribute('aria-expanded', 'false');

      selectSessionItems();
      updateHud();
      renderCurrentItem();
    }

    function finishDrill() {
      isRunning = false;
      cancelAnimationFrame(timerAnimFrame);
      if (gameArenaContent) gameArenaContent.setAttribute('inert', '');

      var accuracyDecimal = correctCount / TOTAL_ITEMS;
      var accuracyPct = Math.round(accuracyDecimal * 100);
      var medianRT = calculateMedian(responseTimes);

      // Scoring formula:
      // accuracy = correctCount / 15
      // deductionSpeedBonus = Math.max(0, Math.min(25, Math.round((7000 - medianRT) / 200)))
      // performanceScore = Math.min(100, Math.max(0, Math.round((accuracy * 75) + deductionSpeedBonus)))
      var deductionSpeedBonus = Math.max(0, Math.min(25, Math.round((7000 - medianRT) / 200)));
      var performanceScore = Math.min(100, Math.max(0, Math.round((accuracyDecimal * 75) + deductionSpeedBonus)));
      var durationSec = Math.max(1, Math.round((performance.now() - sessionStartTime) / 1000));

      // Save to client profile storage
      try {
        saveGameRecord({
          gameId: 'syllogism',
          durationSeconds: durationSec,
          mode: 'standard',
          metrics: {
            performanceScore: performanceScore,
            accuracy: parseFloat(accuracyDecimal.toFixed(4)),
            trialsCompleted: TOTAL_ITEMS,
            correctCount: correctCount,
            errorCount: TOTAL_ITEMS - correctCount,
            medianRT: Math.round(medianRT),
            bestStreak: longestStreak,
          },
        });
      } catch (err) {
        console.error('Failed to save game record:', err);
      }

      // Check legacy and HUD best score
      var savedBest = 0;
      try {
        savedBest = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
      } catch (e) {}

      var isNewBest = performanceScore > savedBest;
      if (isNewBest) {
        try {
          localStorage.setItem(STORAGE_KEY, performanceScore.toString());
          loadBestScore();
        } catch (e) {}
      }

      // Render Modal Elements
      modalPerfScore.textContent = performanceScore.toString();

      var tier = getPerformanceTier(performanceScore);
      modalTierBadge.className = 'mt-2 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border ' + tier.badgeClass;
      modalTierName.textContent = tier.tier;
      modalTierDesc.textContent = tier.description;

      modalAcc.textContent = accuracyPct + '%';
      modalSpeed.textContent = (medianRT / 1000).toFixed(1) + 's';
      modalBreakdown.textContent = validIdentified + ' верно / ' + fallaciesIdentified + ' ошибок';
      modalStreak.textContent = longestStreak.toString();

      modalFormulaCalc.textContent = '(' + accuracyPct + '% * 75 = ' + Math.round(accuracyDecimal * 75) + ' pts) + (Speed Bonus = ' + deductionSpeedBonus + ' pts for ' + Math.round(medianRT) + ' ms) = ' + performanceScore + ' pts';

      if (isNewBest && performanceScore > 0) {
        modalBestAlert.classList.remove('hidden');
      } else {
        modalBestAlert.classList.add('hidden');
      }

      // Populate review accordion
      var reviewHtml = '';
      for (var i = 0; i < userLog.length; i++) {
        var entry = userLog[i];
        var badgeColor = entry.isCorrect ? 'text-emerald-600 dark:text-emerald-400 font-bold' : 'text-rose-600 dark:text-rose-400 font-bold';
        reviewHtml += [
          '<div class="pt-3 first:pt-0">',
          '  <div class="flex items-center justify-between mb-1">',
          '    <span class="font-mono font-bold text-zinc-500 dark:text-zinc-400">#' + (i + 1) + '</span>',
          '    <span class="' + badgeColor + '">' + (entry.isCorrect ? 'Верно' : 'Неверно') + ' (' + entry.userAnswer + ')</span>',
          '  </div>',
          '  <p class="text-zinc-700 dark:text-zinc-300"><strong>P1:</strong> ' + entry.item.p1 + '</p>',
          '  <p class="text-zinc-700 dark:text-zinc-300"><strong>P2:</strong> ' + entry.item.p2 + '</p>',
          '  <p class="text-zinc-900 dark:text-white font-semibold"><strong>C:</strong> ' + entry.item.c + '</p>',
          '  <p class="text-zinc-500 dark:text-zinc-400 mt-1 italic">' + entry.item.explanation + '</p>',
          '</div>'
        ].join('');
      }
      reviewContent.innerHTML = reviewHtml;

      modalEndRound.classList.remove('hidden');
      modalEndRound.classList.add('flex');
      try {
        modalEndRound.focus();
      } catch (e) {}
    }

    function openHowModal() {
      modalHowToPlay.classList.remove('hidden');
      modalHowToPlay.classList.add('flex');
      modalHowToPlay.focus();
    }

    function closeHowModal() {
      modalHowToPlay.classList.add('hidden');
      modalHowToPlay.classList.remove('flex');
    }

    function closeEndModal() {
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
      startOverlay.classList.remove('hidden');
      if (gameArenaContent) gameArenaContent.setAttribute('inert', '');
      if (btnStartGame) btnStartGame.focus();
    }

    // Modal event listeners
    btnHowToPlay.addEventListener('click', openHowModal);
    btnCloseHowModal.addEventListener('click', closeHowModal);
    btnCloseHowGotIt.addEventListener('click', function() {
      closeHowModal();
      if (btnStartGame) btnStartGame.focus();
    });

    modalHowToPlay.addEventListener('click', function(e) {
      if (e.target === modalHowToPlay) {
        closeHowModal();
      }
    });

    btnCloseEndModal.addEventListener('click', closeEndModal);
    modalEndRound.addEventListener('click', function(e) {
      if (e.target === modalEndRound) {
        closeEndModal();
      }
    });

    // Event listeners
    btnValid.addEventListener('click', function() { handleAnswer(true); });
    btnInvalid.addEventListener('click', function() { handleAnswer(false); });
    btnStartGame.addEventListener('click', startDrill);
    btnModalRestart.addEventListener('click', function() {
      modalEndRound.classList.add('hidden');
      modalEndRound.classList.remove('flex');
      startDrill();
    });

    btnToggleReview.addEventListener('click', function() {
      var isHidden = reviewContent.classList.toggle('hidden');
      btnToggleReview.setAttribute('aria-expanded', String(!isHidden));
      if (isHidden) {
        reviewChevron.classList.remove('rotate-180');
      } else {
        reviewChevron.classList.add('rotate-180');
      }
    });

    // Keyboard shortcuts V, I, Space, Escape
    window.addEventListener('keydown', function(e) {
      if (e.repeat) return;
      var key = e.key.toLowerCase();

      var isHowOpen = !modalHowToPlay.classList.contains('hidden');
      var isEndOpen = !modalEndRound.classList.contains('hidden');

      if (e.key === 'Escape') {
        if (isHowOpen) {
          closeHowModal();
          return;
        }
        if (isEndOpen) {
          closeEndModal();
          return;
        }
      }

      // Suppress game hotkeys while modal is open
      if (isHowOpen || isEndOpen) {
        return;
      }

      if (key === ' ' && !isRunning) {
        e.preventDefault();
        startDrill();
      } else if (key === 'v') {
        handleAnswer(true);
      } else if (key === 'i') {
        handleAnswer(false);
      }
    });
  })();
</script>
