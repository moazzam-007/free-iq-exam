---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const alternates = {};

const title = "Проверка слуха онлайн: тест слуха и аудиограмма частот | FreeIQExam";
const description = "Проверьте слух онлайн бесплатно: тональная аудиометрия (125–8000 Гц), высокочастотный тест и калькулятор возраста ушей в браузере со стереонаушниками.";
const canonicalUrl = "https://freeiqexam.com/ru/hearing-test";

const faqItems = [
  { name: "Насколько точен онлайн-тест слуха?", acceptedAnswer: { text: "Онлайн-тесты слуха с использованием Web Audio API дают ориентировочную оценку; уровни звука браузера не эквивалентны калиброванной клинической аудиометрии в звукоизолированной кабине. Они помогают выявить асимметрию левого и правого уха или возрастное снижение слышимости высоких частот, требующие консультации сурдолога или ЛОР-врача." } },
  { name: "Нужны ли наушники для этого теста слуха?", acceptedAnswer: { text: "Да, стереонаушники или внутриканальные мониторы необходимы. Обычные динамики акустически смешивают каналы в комнате, делая невозможной независимую проверку левого и правого уха. Кроме того, динамики ноутбуков и телефонов срезают частоты выше 10 000 Гц." } },
  { name: "Что такое возраст ушей и как он рассчитывается?", acceptedAnswer: { text: "Биологический возраст уха основан на самой высокой слышимой частоте звука. Здоровые дети слышат частоты до 20 000 Гц. С возрастом волосковые клетки основания улитки изнашиваются (пресбиакузис): 19 кГц соответствует возрасту до 18 лет, 17 кГц — ~24 годам, 15 кГц — ~34 годам, 14 кГц — ~44 годам, 12 кГц — ~54 годам, 8 кГц — 65+ годам." } },
  { name: "В чём разница между герцами (Гц) и децибелами (дБ)?", acceptedAnswer: { text: "Герцы (Гц) измеряют частоту или высоту тона (низкий бас 250 Гц против ультразвукового писка 17 000 Гц). Децибелы (дБ) измеряют громкость по логарифмической шкале. В аудиологии нормальный разговор лежит в диапазоне 40–60 дБ HL." } },
  { name: "Что такое «речевой банан» на аудиограмме?", acceptedAnswer: { text: "Речевой банан — это область на аудиограмме (от 250 до 6 000 Гц при громкости 20–55 дБ HL), куда попадают все звуки человеческой речи. Снижение слуха в этой зоне приводит к тому, что речь становится неразборчивой («слышу звук, но не разбираю слова»)." } },
  { name: "Что такое правило безопасного прослушивания 60/60 ВОЗ?", acceptedAnswer: { text: "Всемирная организация здравоохранения (ВОЗ) рекомендует слушать наушники на громкости не более 60% от максимума не дольше 60 минут подряд, делая 10-минутный перерыв для предотвращения акустической травмы волосковых клеток." } }
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Онлайн-проверка слуха: тональная аудиометрия и тест возраста ушей",
    "description": "Онлайн-скрининг слуха с тональной аудиометрией по Хьюсону-Вестлейку (125 Гц – 8 000 Гц) и высокочастотным анализом пресбиакузиса (8 000 Гц – 20 000 Гц).",
    "url": canonicalUrl,
    "medicalAudience": "Patient",
    "aspect": "Screening",
    "inLanguage": "ru"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Онлайн-тест слуха и калькулятор возраста ушей FreeIQExam",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Требуется поддержка Web Audio API и стереонаушники",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": [
      "Скрининг тональной аудиометрии (125 Гц – 8 000 Гц) методом лестницы Хьюсона-Вестлейка",
      "Высокочастотная развёртка слуха (8 000 Гц – 20 000 Гц) с картированием пресбиакузиса",
      "Стереоизоляция каналов для независимой оценки левого и правого уха",
      "Интерактивная аудиограмма на canvas с наложением речевого банана",
      "Анти-щелчковые 15-мс экспоненциальные огибающие усиления для защиты акустических преобразователей",
      "Загружаемая сводка скрининга и сгенерированная браузером аудиограмма",
      "Нулевой пейволл, нулевая регистрация по e-mail, синтез Web Audio в браузере"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://freeiqexam.com/ru/" },
      { "@type": "ListItem", "position": 2, "name": "Инструменты", "item": "https://freeiqexam.com/ru/tools" },
      { "@type": "ListItem", "position": 3, "name": "Тест слуха и возраст ушей", "item": canonicalUrl }
    ]
  },];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/hearing-test" idPath="/id/tes-pendengaran" schema={schema}>
  <Header currentPath="/hearing-test" enPath="/hearing-test" idPath="/id/tes-pendengaran" />

  <style>
    .earage-waveform { display: flex; align-items: center; justify-content: center; gap: 5px; height: 64px; margin: 24px 0; }
    .earage-waveform .bar { width: 4px; background: #0066cc; border-radius: 9999px; height: 8px; transition: height 0.1s ease; }
    .dark .earage-waveform .bar { background: #2997ff; }
    .earage-waveform.active .bar { animation: waveBar 0.8s infinite ease-in-out; }
    .earage-waveform.active .bar:nth-child(2) { animation-delay: 0.05s; }
    .earage-waveform.active .bar:nth-child(3) { animation-delay: 0.10s; }
    .earage-waveform.active .bar:nth-child(4) { animation-delay: 0.15s; }
    .earage-waveform.active .bar:nth-child(5) { animation-delay: 0.20s; }
    .earage-waveform.active .bar:nth-child(6) { animation-delay: 0.25s; }
    .earage-waveform.active .bar:nth-child(7) { animation-delay: 0.30s; }
    .earage-waveform.active .bar:nth-child(8) { animation-delay: 0.35s; }
    .earage-waveform.active .bar:nth-child(9) { animation-delay: 0.40s; }
    .earage-waveform.active .bar:nth-child(10) { animation-delay: 0.45s; }
    .earage-waveform.active .bar:nth-child(11) { animation-delay: 0.50s; }
    .earage-waveform.active .bar:nth-child(12) { animation-delay: 0.55s; }
    .earage-waveform.active .bar:nth-child(13) { animation-delay: 0.60s; }
    .earage-waveform.active .bar:nth-child(14) { animation-delay: 0.65s; }
    .earage-waveform.active .bar:nth-child(15) { animation-delay: 0.70s; }
    .earage-waveform.active .bar:nth-child(16) { animation-delay: 0.75s; }
    .earage-waveform.active .bar:nth-child(17) { animation-delay: 0.80s; }
    .earage-waveform.active .bar:nth-child(18) { animation-delay: 0.85s; }
    .earage-waveform.active .bar:nth-child(19) { animation-delay: 0.90s; }
    .earage-waveform.active .bar:nth-child(20) { animation-delay: 0.95s; }
    @keyframes waveBar { 0%, 100% { height: 10px; } 50% { height: 58px; } }
    details summary::-webkit-details-marker { display: none; }
    #test-arena button { min-height: 44px; }
    #test-arena button:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
    #test-arena .hearing-mode-card:hover { transform: translateY(-2px); }
    #test-arena .hearing-mode-card:active { transform: scale(0.97); }
    details[open] summary .faq-chevron { transform: rotate(180deg); }
    @media print {
      header, footer, #calibrationPanel, .no-print { display: none !important; }
      #resultsWrap { display: block !important; }
      body { background: #ffffff !important; color: #000000 !important; }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Хлебные крошки">
      <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Главная</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <a href="/ru/games" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Когнитивные игры</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест слуха и возраст ушей</span>
    </nav>

    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Клиническая тональная аудиометрия · Высокочастотная развёртка</span>
      </div>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4">
        Бесплатный онлайн-тест слуха и калькулятор возраста ушей
      </h1>
      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto">
        Проверьте слуховую остроту с клинической точностью. Выполните высокочастотные развёртки слуха (8–20 кГц) или полную тональную аудиометрию (125–8 000 Гц) с независимой стереоизоляцией левого и правого уха.
      </p>
    </header>

    <div class="max-w-3xl mx-auto mb-10 p-5 rounded-3xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-amber-900 dark:text-amber-200 text-sm shadow-xs transition-all">
      <div class="flex items-start gap-3">
        <svg class="w-6 h-6 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
        <div class="space-y-1">
          <h4 class="font-heading font-bold text-amber-950 dark:text-amber-100 text-base">Акустическая безопасность и требование наушников</h4>
          <p class="text-amber-800 dark:text-amber-300/90 text-[13px] sm:text-sm leading-relaxed">
            <strong>1)</strong> Наденьте качественные стереонаушники. <strong>2)</strong> Никогда не устанавливайте системную громкость на максимум; начните с 50% и используйте наш калибровочный тон 1 000 Гц для подтверждения комфортной слышимости. <strong>3)</strong> Отключите пространственный звук, Dolby Atmos и эквалайзеры для клинической точности. Клинический диапазон воздушной проводимости: 125 Гц – 20 000 Гц. Результаты зависят от наушников и оборудования и не заменяют калиброванную клиническую аудиометрию.
          </p>
        </div>
      </div>
    </div>

    <section id="test-arena" class="relative w-full max-w-4xl mx-auto mb-16 scroll-mt-6">

      <div id="modeSelector" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <button
          type="button"
          data-mode="ear-age"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-blue-500/50 dark:hover:border-blue-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#0066cc]/10 border border-[#0066cc]/20 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center font-mono font-bold text-xl mb-6 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
            </div>
            <div class="text-[13px] font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-1">
              Высокочастотная развёртка (8–20 кГц)
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Высокочастотный тест слуха
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Найдите самую высокую частоту, которую слышат ваши уши. Сопоставляет вашу акустическую отсечку с эпидемиологическими данными пресбиакузиса для расчёта биологического слухового возраста.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400">Длительность: ~60 секунд</span>
            <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Начать тест возраста ушей →
            </span>
          </div>
        </button>

        <button
          type="button"
          data-mode="audiometry"
          class="hearing-mode-card group relative p-8 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 hover:border-blue-500/50 dark:hover:border-blue-400/50 shadow-xl hover:shadow-2xl transition-all duration-300 text-left flex flex-col justify-between cursor-pointer overflow-hidden"
        >
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-all"></div>
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#0066cc]/10 border border-[#0066cc]/20 text-[#0066cc] dark:text-[#2997ff] flex items-center justify-center font-mono font-bold text-xl mb-6 transition-transform">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
            </div>
            <div class="text-[13px] font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-1">
              Клинический протокол Хьюсона-Вестлейка
            </div>
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Тональная аудиометрия
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Стандартный клинический скрининг, оценивающий 125 Гц – 8 000 Гц независимо в левом и правом ухе. Строит официальную аудиограмму относительно порогов нормального слуха.
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between">
            <span class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400">Длительность: ~3 минуты</span>
            <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Начать аудиометрию →
            </span>
          </div>
        </button>
      </div>

      <div id="workspace" class="hidden rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl">
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-8">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
            <h2 id="workspaceTitle" class="font-heading font-bold text-lg sm:text-xl text-zinc-900 dark:text-white">
              Акустическое тестирование
            </h2>
          </div>
          <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400">
            Шаг <span id="stepNum" class="font-bold text-blue-600 dark:text-blue-400">1</span> из 3
          </div>
        </div>

        <div id="calibrationPanel" class="max-w-xl mx-auto text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center text-3xl">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-heading font-bold text-2xl text-zinc-900 dark:text-white">
              Калибровка эталонной громкости
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Мы воспроизводим безопасный эталонный тон 1 000 Гц. Отрегулируйте системную громкость, пока звук не станет чётко слышимым, комфортным и не слишком громким.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800/80 space-y-4">
            <div class="flex items-center justify-between text-[13px] font-mono font-semibold text-zinc-500 dark:text-zinc-400">
              <span>Уровень калибровки</span>
              <span id="calibDbDisplay" class="text-blue-600 dark:text-blue-400 font-bold">40 дБ HL</span>
            </div>
            <input
              id="calibSlider"
              type="range"
              min="20"
              max="80"
              step="5"
              value="40"
              class="w-full h-2 bg-zinc-200 dark:bg-zinc-700 rounded-lg appearance-none cursor-pointer accent-blue-500"
            />
            <div class="flex gap-3 justify-center pt-2">
              <button
                id="calibPlayBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-[#0066cc]/10 hover:bg-[#0066cc]/20 text-[#0066cc] dark:text-[#2997ff] border border-[#0066cc]/30 text-[13px] sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor" /></svg> Тестовый тон (1 кГц)
              </button>
              <button
                id="calibStopBtn"
                type="button"
                class="px-5 py-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 active:scale-[0.97] dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700 text-[13px] sm:text-sm font-semibold transition-all cursor-pointer flex items-center gap-2"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" /></svg> Стоп
              </button>
            </div>
          </div>

          <button
            id="startTestBtn"
            type="button"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] text-white font-heading font-bold text-base shadow-lg hover:shadow-blue-600/25 active:scale-[0.97] min-h-[44px] transition-all cursor-pointer inline-flex items-center justify-center gap-2"
          >
            <span>Громкость настроена · Начать тест</span>
            <span>→</span>
          </button>
        </div>

        <div id="earAgePanel" class="hidden max-w-xl mx-auto text-center space-y-6">
          <div class="space-y-1">
            <div class="text-[13px] font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Текущий частотный тон</div>
