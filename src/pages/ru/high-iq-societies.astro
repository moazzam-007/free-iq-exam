---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Общества высокого IQ: Mensa, Intertel, Triple Nine — требования и пороги | FreeIQExam";
const description = "Справочник обществ высокого IQ: пороги Mensa (98%), Intertel (99%), Triple Nine (99.9%) и Prometheus. Правила отбора, шкалы SD 15 и подтверждённые тесты.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Гид по сообществам высокого IQ: Mensa, Intertel, Triple Nine и пороги вступления",
    "description": "Углублённый психометрический разбор международных сообществ высокого IQ, процентилей вступления, принимаемых ранее сданных тестов и стратегий подготовки.",
    "url": "https://freeiqexam.com/ru/high-iq-societies/",
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam",
      "url": "https://freeiqexam.com/ru/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Сообщества высокого IQ",
        "item": "https://freeiqexam.com/ru/high-iq-societies/"
      }
    ]
  }
];

