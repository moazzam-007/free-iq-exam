    sd24: "148",
    members: "~145 000 по всему миру",
    focus: "Социальный обмен, группы по интересам и сообщество интеллектуальных равных.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Intertel",
    founded: "1966",
    percentile: "99-й процентиль (верхний 1%)",
    rarity: "1 из 100",
    sd15: "135",
    sd16: "137",
    sd24: "156",
    members: "~1 700 по всему миру",
    focus: "Интеллектуальное товарищество, всемирные региональные встречи и журнал Integra.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Colloquy Society",
    founded: "2000",
    percentile: "99,5-й процентиль (верхние 0,5%)",
    rarity: "1 из 200",
    sd15: "140",
    sd16: "143",
    sd24: "164",
    members: "~500 по всему миру",
    focus: "Онлайн-философский диалог, междисциплинарные искусства и научные дебаты.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Triple Nine Society (TNS)",
    founded: "1978",
    percentile: "99,9-й процентиль (верхние 0,1%)",
    rarity: "1 из 1 000",
    sd15: "146",
    sd16: "149",
    sd24: "174",
    members: "~1 900 по всему миру",
    focus: "Глубокий академический обмен, свободное выражение мнений и журнал Vidya.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  },
  {
    name: "Общество Prometheus",
    founded: "1982",
    percentile: "99,997-й процентиль (верхние 0,003%)",
    rarity: "1 из 33 333",
    sd15: "160",
    sd16: "164",
    sd24: "196",
    members: "~120 по всему миру",
    focus: "Потолочная психометрия, теоретическая философия и дискурс одарённости.",
    badgeClass: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 font-mono"
  }
