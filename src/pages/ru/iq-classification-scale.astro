---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Шкала IQ: классификация уровней интеллекта, баллы WAIS-IV и процентили | FreeIQExam";
const description = "Официальная шкала IQ: классификация уровней интеллекта по WAIS-IV и Stanford-Binet V. Диапазоны от нормы до гениальности, процентили и редкие баллы.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Шкала классификации баллов IQ: WAIS-IV, Стэнфорд–Бине и когнитивные диапазоны",
    "description": "Сравнительный анализ стандартных психологических систем классификации IQ, свойств гауссова распределения и долей населения.",
    "url": "https://freeiqexam.com/ru/iq-classification-scale/",
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam",
      "url": "https://freeiqexam.com/ru/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Шкала классификации IQ",
        "item": "https://freeiqexam.com/ru/iq-classification-scale/"
      }
    ]
  }
];

const classificationRows = [
  { range: "145+", wais: "Очень высокий интеллект/Гениальность", sb5: "Очень высокий интеллект/Гениальность", wj: "Очень высокий интеллект/Гениальность", pct: "99,9%", rarity: "1 из 741", desc: "Высший интеллектуальный уровень. Стремительное абстрактное мышление и мгновенное выявление закономерностей." },
  { range: "130–144", wais: "Одарённость/Высокий интеллект", sb5: "Одарённость/Высокий интеллект", wj: "Одарённость/Высокий интеллект", pct: "98–99,8%", rarity: "1 из 44", desc: "Одарённость. Выдающаяся аналитическая дедукция, быстрая абстракция и когнитивная гибкость." },
  { range: "120–129", wais: "Выше среднего", sb5: "Выше среднего", wj: "Выше среднего", pct: "91–97%", rarity: "1 из 11", desc: "Уровень заметно выше среднего. Развитые аналитичность, беглость мышления и пространственное мышление (Gv)." },
  { range: "110–119", wais: "Высокая норма", sb5: "Высокая норма", wj: "Высокая норма", pct: "75–90%", rarity: "1 из 4", desc: "Выше медианы популяции. Уверенная учебная успешность и гибкость мышления." },
  { range: "90–109", wais: "Средний уровень интеллекта", sb5: "Средний уровень интеллекта", wj: "Средний уровень интеллекта", pct: "25–74%", rarity: "1 из 2", desc: "Медиана популяции. Типичные способности по всем основным когнитивным доменам." },
  { range: "80–89", wais: "Низкая норма", sb5: "Низкая норма", wj: "Низкая норма", pct: "9–24%", rarity: "1 из 4", desc: "Несколько ниже медианы. Возможна польза от структурированного и мультисенсорного обучения." },
  { range: "70–79", wais: "Пограничный уровень", sb5: "Пограничный уровень", wj: "Пограничный уровень", pct: "2–8%", rarity: "1 из 11", desc: "Выраженные затруднения со сложными абстракциями и высокой нагрузкой на рабочую память." },
  { range: "<70", wais: "Крайне низкий уровень", sb5: "Крайне низкий уровень", wj: "Крайне низкий уровень", pct: "<2%", rarity: "1 из 44", desc: "Клинический порог для оценки интеллектуального развития наряду с исследованием адаптивного поведения." }
];
---

<Layout title={title} description={description} schema={schema} enPath="/iq-classification-scale" idPath="/skala-klasifikasi-iq" canonicalUrl="https://freeiqexam.com/ru/iq-classification-scale">
  <Header currentPath="/iq-classification-scale"  enPath="/iq-classification-scale" idPath="/skala-klasifikasi-iq"/>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 -mb-6" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-white font-medium">Шкала классификации IQ</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>Стандартизированный диагностический справочник &bull; Нормы SD 15</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Шкала классификации баллов IQ и диапазоны нормального распределения
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Узнайте, как клинические психологи классифицируют уровень когнитивных способностей. Сравните шкалы интеллекта взрослых Векслера (WAIS-IV), Стэнфорд–Бине 5 и систему Вудкока–Джонсона с точными процентилями нормального распределения.
      </p>
    </header>

    <!-- Interactive Score Classifier Widget (Above the Fold) -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs max-w-2xl mx-auto w-full">
      <div class="text-center mb-6">
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 block mb-1">
          Интерактивный инструмент поиска
        </span>
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Классифицировать любой балл IQ (SD 15)
        </h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          Передвиньте ползунок или введите балл, чтобы увидеть клинический уровень, процентильный ранг и редкость в популяции.
        </p>
      </div>

      <div class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="iq-calc-input" class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white">
              Выбранный балл IQ
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Шкала: от 55 до 145+</span>
          </div>
          <div class="flex items-center gap-3">
            <input
              id="iq-calc-range"
              type="range"
              min="70"
              max="145"
              value="118"
              aria-label="IQ Счёт Slider"
              class="flex-1 h-2 bg-zinc-200 dark:bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-blue-600 min-h-[44px]"
            />
            <input
              id="iq-calc-input"
              type="number"
              min="50"
              max="160"
              value="118"
              aria-label="IQ Счёт Input"
              class="w-20 px-3 py-2 rounded-xl text-center font-heading font-bold text-lg bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
          </div>
        </div>

        <!-- Result Box -->
        <div class="p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center" role="status" aria-live="polite">
          <div>
            <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Уровень WAIS-IV</span>
            <p id="widget-tier" class="font-heading font-bold text-sm sm:text-base text-blue-600 dark:text-blue-400 mt-1">
              Высокая норма
            </p>
          </div>
          <div>
            <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Процентиль</span>
            <p id="widget-pct" class="font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white mt-1">
              88.5th
            </p>
          </div>
          <div>
            <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Редкость в популяции</span>
            <p id="widget-rarity" class="font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white mt-1">
              1 in 8.7
            </p>
          </div>
          <div>
            <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 uppercase">Z-оценка (SD)</span>
            <p id="widget-zscore" class="font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white mt-1">
              +1.20 &sigma;
            </p>
          </div>
        </div>

        <div class="flex items-center justify-between text-xs pt-2">
          <a href="/ru/iq-percentile-calculator" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 font-medium">
            <span>Полный двусторонний калькулятор процентилей &rarr;</span>
          </a>
          <a href="/ru/quick-test" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 font-medium">
            <span>Пройти быстрый скрининговый тест &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Master Comparative Classification Table -->
    <section class="space-y-6">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-2">
          Сравнительная психометрическая таблица классификации
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Стандартизированные клинические тесты переводят непрерывные баллы в качественные описательные категории. Ниже представлено прямое сопоставление шкалы интеллекта взрослых Векслера (WAIS-IV), шкал Стэнфорд–Бине (SB-5) и системы Вудкока–Джонсона IV (WJ-IV).
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-xs -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[600px] text-left text-xs sm:text-sm">
          <thead class="sticky top-0 bg-zinc-100/95 dark:bg-zinc-900/95 backdrop-blur-sm z-10 text-zinc-700 dark:text-zinc-300 font-heading font-bold uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
            <tr>
              <th class="py-4 px-4 sm:px-6">Диапазон баллов IQ (SD 15)</th>
              <th class="py-4 px-4">Классификация WAIS-IV</th>
              <th class="py-4 px-4 hidden md:table-cell">Стэнфорд–Бине 5</th>
              <th class="py-4 px-4 hidden lg:table-cell">Вудкок–Джонсон IV</th>
              <th class="py-4 px-4">Процентиль</th>
              <th class="py-4 px-4">Доля в популяции</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 bg-white dark:bg-zinc-950">
            {classificationRows.map((row) => (
              <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-colors">
                <td class="py-4 px-4 sm:px-6 font-mono font-bold text-zinc-950 dark:text-white whitespace-nowrap">
                  {row.range}
                </td>
                <td class="py-4 px-4 font-semibold text-blue-600 dark:text-blue-400">
                  {row.wais}
                </td>
                <td class="py-4 px-4 text-zinc-600 dark:text-zinc-400 hidden md:table-cell">
                  {row.sb5}
                </td>
                <td class="py-4 px-4 text-zinc-600 dark:text-zinc-400 hidden lg:table-cell">
                  {row.wj}
                </td>
                <td class="py-4 px-4 font-mono font-semibold text-zinc-900 dark:text-zinc-200">
                  {row.pct}
                </td>
                <td class="py-4 px-4 font-mono text-zinc-500 dark:text-zinc-400">
                  {row.rarity}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Normal Distribution & Bell Curve Mechanics -->
    <section class="space-y-6">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white">
        Нормальное распределение и механика колоколообразной кривой
      </h2>
      <div class="prose dark:prose-invert max-w-none text-sm sm:text-base text-zinc-600 dark:text-zinc-300 space-y-4 leading-relaxed">
        <p>
          Все современные тесты интеллекта — это <strong>тесты отклоняющегося IQ</strong>. Дэвид Векслер впервые предложил их в 1939 году взамен устаревшей концепции коэффициента Уильяма Штерна (умственный возраст, делённый на хронологический возраст и умноженный на 100); отклоняющийся IQ напрямую привязывает результат к гауссову нормальному распределению.
        </p>
        <p>
          В стандартизированной модели отклоняющегося IQ:
        </p>
        <ul class="space-y-2 list-disc pl-5">
          <li><strong>Среднее (&mu;) зафиксировано на 100:</strong> медианный балл любой репрезентативной возрастной когорты по определению равен 100.</li>
          <li><strong>Стандартное отклонение (&sigma;) установлено на 15:</strong> одно стандартное отклонение составляет 15 баллов IQ по шкалам Векслера и Стэнфорд–Бине 5.</li>
          <li><strong>Правило 68–95–99,7:</strong> ровно 68,26% результатов находятся в пределах &plusmn;1 стандартного отклонения (IQ от 85 до 115). Ровно 95,44% — в пределах &plusmn;2 стандартных отклонений (IQ от 70 до 130). Ровно 99,73% — в пределах &plusmn;3 стандартных отклонений (IQ от 55 до 145).</li>
        </ul>
      </div>

      <!-- Key Процентиль Breakdown Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium uppercase">В пределах &plusmn;1 SD</span>
          <p class="font-heading font-extrabold text-2xl text-zinc-950 dark:text-white my-1">68,26% людей</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">Баллы от 85 до 115. Охватывает низкую норму, средний уровень и высокую норму.</p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium uppercase">В пределах &plusmn;2 SD</span>
          <p class="font-heading font-extrabold text-2xl text-zinc-950 dark:text-white my-1">95,44% людей</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">Баллы от 70 до 130. Лишь 2,28% набирают выше и лишь 2,28% — ниже.</p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium uppercase">В пределах &plusmn;3 SD</span>
          <p class="font-heading font-extrabold text-2xl text-zinc-950 dark:text-white my-1">99,73% людей</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">Баллы от 55 до 145. Результаты выше 145 встречаются примерно у 1 из 740 человек.</p>
        </div>
      </div>
    </section>

    <!-- The Flynn Effect Section -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs space-y-4">
      <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block">
        Лонгитюдная психометрия
      </span>
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
        Эффект Флинна и межпоколенческий пересмотр норм
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Открытый политологом Джеймсом Р. Флинном <strong>эффект Флинна</strong> состоит в том, что сырые баллы тестов интеллекта в индустриальных странах росли в среднем примерно на 3 балла IQ за десятилетие на протяжении XX века.
      </p>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Вследствие этого межпоколенческого сдвига в скорости решения задач и визуальной абстракции человек, набравший 100 баллов по нормам 1950 года, показал бы заметно более низкий результат по нормам, калиброванным на 2026 год.         Чтобы предотвратить искусственное завышение когнитивных классификаций, издатели психометрических методик повторно стандартизируют нормативные выборки каждые 10–15 лет.
      </p>
    </section>

    <!-- Assessment Dual Callout CTA -->
    <section class="p-8 sm:p-12 rounded-3xl bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 text-center shadow-lg relative overflow-hidden border border-zinc-800 dark:border-zinc-200">
      <h2 class="font-heading font-extrabold text-2xl sm:text-4xl mb-3 tracking-tight">
        Узнайте свой классификационный уровень
      </h2>
      <p class="text-zinc-400 dark:text-zinc-600 text-[17px] leading-relaxed max-w-xl mx-auto mb-6">
        Оцените подвижный интеллект (Gf), пространственное мышление (Gv), количественное мышление (Gq) и вербальное понимание (Gc) с помощью наших научно калиброванных тестов. Мгновенный балл, процентильный ранг и доверительный интервал.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
        <a 
          href="/ru/test" 
          class="w-full sm:w-auto px-6 py-3.5 min-h-[44px] inline-flex items-center justify-center rounded-full text-sm font-bold text-white bg-[#0066cc] hover:bg-[#0071e3] dark:bg-[#2997ff] dark:hover:bg-[#3b82f6] transition-all duration-200 active:scale-[0.97] shadow-md text-center"
        >
          Пройти полный тест (20 минут)
        </a>
        <a 
          href="/ru/quick-test" 
          class="w-full sm:w-auto px-6 py-3.5 min-h-[44px] inline-flex items-center justify-center rounded-full text-sm font-bold text-white dark:text-zinc-900 border border-white/40 dark:border-zinc-300 hover:bg-white/10 dark:hover:bg-zinc-100 transition-all duration-200 active:scale-[0.97] text-center"
        >
          Быстрый 10-минутный скрининг
        </a>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="space-y-6">
      <div>
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-2">
          Частые вопросы о классификации IQ
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          Ясные ответы на распространённые вопросы о шкалах интеллекта, диапазонах баллов и клинической интерпретации.
        </p>
      </div>

      <div class="space-y-3">
        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white list-none">
            <span>Считается ли IQ 110 или 120 высоким интеллектом?</span>
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800">
            Да. По стандартной шкале Векслера (стандартное отклонение (SD 15)) IQ от 110 до 119 классифицируется как высокая норма (верхние 25% населения). IQ от 120 до 129 формально классифицируется как уровень выше среднего (верхние 9% — 2,3%), отражающий развитую аналитическую дедукцию, быструю абстракцию и выраженную когнитивную гибкость. Вы можете проверить свой результат в нашем <a href="/ru/test" class="text-blue-600 dark:text-blue-400 hover:underline">бесплатном 20-минутном когнитивном тесте</a>.
