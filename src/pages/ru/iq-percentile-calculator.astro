---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Калькулятор процентилей IQ: балл в процентиль онлайн";
const description = "Переведите балл IQ в процентиль, z-оценку и редкость в популяции. Формула z=(IQ−100)/15, бесплатно.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Калькулятор процентилей IQ",
    "url": "https://freeiqexam.com/ru/iq-percentile-calculator/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Мгновенный двусторонний пересчёт между стандартными баллами IQ (SD 15) и процентильными рангами нормального распределения.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Калькулятор процентилей IQ",
        "item": "https://freeiqexam.com/ru/iq-percentile-calculator/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое процентиль IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Процентиль IQ показывает, какой процент общей популяции набирает балл не выше данного результата по стандартизированному нормальному распределению (среднее 100, стандартное отклонение (SD 15))."
        }
      },
      {
        "@type": "Question",
        "name": "Какому процентилю соответствует IQ 100?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "IQ 100 — это точная медиана популяции, соответствующая 50-му процентилю."
        }
      },
      {
        "@type": "Question",
        "name": "Какой балл IQ нужен для вступления в Mensa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mensa требует результата на уровне 98-го процентиля и выше, что соответствует IQ 130 и выше по шкале Векслера (SD 15) либо 132 по шкале Стэнфорд–Бине (SD 16)."
        }
      },
      {
        "@type": "Question",
        "name": "Как математически вычисляется процентиль IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Процентили IQ выводятся через функцию стандартного нормального кумулятивного распределения (CDF). Сначала вычисляется z-оценка по формуле z = (IQ − 100) / 15, затем она интегрируется через гауссову функцию ошибок."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/iq-percentile-calculator" idPath="/kalkulator-persentil-iq" canonicalUrl="https://freeiqexam.com/ru/iq-percentile-calculator">
  <Header currentPath="/iq-percentile-calculator"  enPath="/iq-percentile-calculator" idPath="/kalkulator-persentil-iq"/>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>Интерактивный инструмент &bull; Модель Векслера SD 15</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Калькулятор процентилей IQ
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Преобразуйте любой балл IQ в теоретический процентильный ранг нормального распределения либо вычислите ориентировочный балл IQ, необходимый для достижения заданного процентильного уровня.
      </p>
    </header>

    <!-- Interactive 2-Way Calculator Component Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs max-w-2xl mx-auto w-full">
      
      <!-- Mode Toggle Buttons -->
      <div class="flex items-center p-1 rounded-2xl bg-zinc-200/70 dark:bg-zinc-800/70 mb-8 max-w-md mx-auto">
        <button
          id="tab-iq-to-pct"
          type="button"
          class="flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white dark:bg-zinc-900 text-zinc-950 dark:text-white shadow-xs"
        >
          Балл в процентиль
        </button>
        <button
          id="tab-pct-to-iq"
          type="button"
          class="flex-1 py-2 px-4 rounded-xl text-xs sm:text-sm font-medium transition-all text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white"
        >
          Процентиль в балл
        </button>
      </div>

      <!-- Mode 1: IQ -> Процентиль Panel -->
      <div id="panel-iq-to-pct" class="space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="iq-input" class="text-sm font-semibold text-zinc-900 dark:text-white">
              Введите балл IQ (SD 15)
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Диапазон: от 55 до 160</span>
          </div>
          <div class="relative">
            <input
              id="iq-input"
              type="number"
              min="55"
              max="160"
              value="120"
              class="w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-2xl font-bold font-mono text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-mono text-zinc-500 dark:text-zinc-400 font-semibold">IQ</span>
          </div>
          <!-- Range Slider -->
          <input
            id="iq-slider"
            type="range"
            min="55"
            max="160"
            value="120"
            aria-label="Ползунок балла IQ"
            class="w-full mt-4 accent-blue-600 cursor-pointer min-h-[44px]"
          />
        </div>

        <!-- Calculated Metrics Output Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4" role="status" aria-live="polite">
          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Процентиль</span>
            <span id="output-percentile" class="text-2xl font-heading font-extrabold text-blue-600 dark:text-blue-400">
              90,9%
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Редкость в популяции</span>
            <span id="output-rarity" class="text-base font-mono font-bold text-zinc-900 dark:text-white">
              Верхние 9,1% (1 из 11)
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Отклонение z-оценки</span>
            <span id="output-zscore" class="text-base font-mono font-semibold text-zinc-900 dark:text-white">
              +1.33 &sigma;
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Классификация</span>
            <span id="output-classification" class="text-xs font-mono font-semibold px-3 py-1 rounded-full bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">
              Выше среднего
            </span>
          </div>
        </div>
      </div>

      <!-- Mode 2: Процентиль -> IQ Panel -->
      <div id="panel-pct-to-iq" class="hidden space-y-6">
        <div>
          <div class="flex items-center justify-between mb-2">
            <label for="pct-input" class="text-sm font-semibold text-zinc-900 dark:text-white">
              Введите желаемый процентиль
            </label>
            <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">Диапазон: от 0,1% до 99,9%</span>
          </div>
          <div class="relative">
            <input
              id="pct-input"
              type="number"
              min="0.1"
              max="99.9"
              step="0.1"
              value="98.0"
              class="w-full px-4 py-3.5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 text-2xl font-bold font-mono text-zinc-950 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-600"
            />
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-mono text-zinc-500 dark:text-zinc-400 font-semibold">%</span>
          </div>
          <input
            id="pct-slider"
            type="range"
            min="0.1"
            max="99.9"
            step="0.1"
            value="98.0"
            aria-label="Ползунок процентиля"
            class="w-full mt-4 accent-blue-600 cursor-pointer min-h-[44px]"
          />
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 space-y-4" role="status" aria-live="polite">
          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Эквивалентный балл IQ</span>
            <span id="output-iq-from-pct" class="text-2xl font-heading font-extrabold text-blue-600 dark:text-blue-400">
              131 IQ
            </span>
          </div>

          <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Уровень стандартного отклонения</span>
            <span id="output-sd-from-pct" class="text-base font-mono font-semibold text-zinc-900 dark:text-white">
              +2.05 &sigma; (Wechsler SD 15)
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="text-xs font-mono uppercase text-zinc-500 dark:text-zinc-400">Статус Mensa</span>
            <span id="output-mensa-status" class="text-xs font-mono font-semibold px-3 py-1 rounded-full bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700">
              Подходит для Mensa (верхние 2%)
            </span>
          </div>
        </div>
      </div>

    </section>

    <!-- Quick Reference Benchmark Table -->
    <section>
      <div class="mb-4 text-center sm:text-left">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          Справочная таблица ориентировочных баллов и процентилей
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Справочные значения для стандартного отклонения 15 и процентили накопленного нормального распределения.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 -mx-4 sm:mx-0 px-4 sm:px-0">
        <table class="w-full min-w-[560px] text-left text-xs sm:text-sm font-mono">
          <thead class="sticky top-0 bg-zinc-100/95 dark:bg-zinc-900/95 backdrop-blur-sm z-10 border-b border-zinc-200 dark:border-zinc-800 uppercase text-[11px] text-zinc-600 dark:text-zinc-400">
            <tr>
              <th class="py-3 px-4">Балл IQ (SD 15)</th>
              <th class="py-3 px-4">Процентиль</th>
              <th class="py-3 px-4">Z-оценка (&sigma;)</th>
              <th class="py-3 px-4">Частота в популяции</th>
              <th class="py-3 px-4">Психометрический уровень</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/80 dark:divide-zinc-800 bg-white dark:bg-black">
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">145</td>
              <td class="py-3 px-4">99,87%</td>
              <td class="py-3 px-4">+3,00 &sigma;</td>
              <td class="py-3 px-4">1 из 741</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Очень высокий интеллект/Гениальность</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">130</td>
              <td class="py-3 px-4">97,72%</td>
              <td class="py-3 px-4">+2,00 &sigma;</td>
              <td class="py-3 px-4">1 из 44</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Одарённость/Высокий интеллект (Mensa)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">120</td>
              <td class="py-3 px-4">90,88%</td>
              <td class="py-3 px-4">+1,33 &sigma;</td>
              <td class="py-3 px-4">1 из 11</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Выше среднего</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">115</td>
              <td class="py-3 px-4">84,13%</td>
              <td class="py-3 px-4">+1,00 &sigma;</td>
              <td class="py-3 px-4">1 из 6</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Высокая норма (+1 SD)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">100</td>
              <td class="py-3 px-4">50,00%</td>
              <td class="py-3 px-4">0,00 &sigma;</td>
              <td class="py-3 px-4">1 из 2</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Среднее популяции</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">85</td>
              <td class="py-3 px-4">15,87%</td>
              <td class="py-3 px-4">-1,00 &sigma;</td>
              <td class="py-3 px-4">1 из 6</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Низкая норма (−1 SD)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-zinc-950 dark:text-white">70</td>
              <td class="py-3 px-4">2,28%</td>
              <td class="py-3 px-4">-2,00 &sigma;</td>
              <td class="py-3 px-4">1 из 44</td>
              <td class="py-3 px-4 font-sans font-semibold text-zinc-900 dark:text-white">Пограничный уровень (−2 SD)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mathematical Formula Breakdown -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-3">
        Математическая формулировка: z-оценки и интегрирование CDF
      </h3>
      <p class="mb-3">
        Переход от стандартного балла к процентилю выполняется через стандартизацию нормального распределения:
      </p>
      <div class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-mono text-xs mb-3">
        z = (IQ - 100) / 15<br />
        Процентиль = &Phi;(z) &times; 100 = 0.5 &times; [1 + erf(z / &radic;2)] &times; 100
      </div>
      <p>
        Где &Phi; — функция кумулятивного распределения стандартного нормального закона, а erf — гауссова функция ошибок.
      </p>
    </section>

    <!-- ================================================================= -->
    <!-- LAYMAN PERCENTILE EXPLAINER: THE 100-PERSON LINE & NORMAL CURVE   -->
    <!-- ================================================================= -->
    <section class="space-y-8 border-t border-zinc-200 dark:border-zinc-800 pt-10" aria-labelledby="heading-layman-guide">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-2">
          Руководство простым языком
        </div>
        <h2 id="heading-layman-guide" class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-950 dark:text-white tracking-tight">
          Как понимать процентили IQ: руководство для каждого
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-3xl">
          Всё, что нужно знать о значении процентилей, об их отличии от тестовых баллов и о том, почему важно колоколообразное распределение.
        </p>
      </div>

      <!-- 1. The 100-Person Line Analogy -->
      <div class="rounded-3xl border border-zinc-200/90 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 p-6 sm:p-8 shadow-xs">
        <div class="flex items-center gap-3.5 mb-4">
          <div class="w-11 h-11 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white">
              Наглядная аналогия «шеренга из 100 человек»
            </h3>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              Визуализация относительного места в популяции
            </p>
          </div>
        </div>

        <blockquote class="text-sm sm:text-base text-zinc-800 dark:text-zinc-200 font-medium leading-relaxed mb-6 pl-4 border-l-4 border-blue-500 dark:border-blue-400 italic">
          «Представьте 100 случайно выбранных людей, выстроенных от наименьшего балла к наибольшему. Если ваш IQ находится на 98-м процентиле, вы стоите впереди 98 человек из этой сотни, и лишь 2 человека — впереди вас».
        </blockquote>

        <!-- 10x10 Cohort Visualization Grid -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-3">
            <span>Нижний 1% (позади)</span>
            <span class="font-bold text-blue-600 dark:text-blue-400">98-й процентиль (порог Mensa)</span>
            <span>Верхние 100%</span>
          </div>
          <!-- Visual Dot Cohort Row -->
          <div class="grid grid-cols-10 gap-1.5 sm:gap-2">
            <!-- 98 People Ahead / Cohort Blocks -->
            <div class="col-span-8 h-8 rounded-lg bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300">
              98 человек позади вас (98%)
            </div>
            <!-- Top 2 Elite -->
            <div class="col-span-2 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-mono font-bold shadow-xs">
              Топ-2 (IQ 130+)
            </div>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2.5">
            По стандартизированной шкале ранг 50-го процентиля помещает вас ровно в медиану (50 позади, 50 впереди), а ранг 99,9-го процентиля означает, что вы впереди 999 человек из 1 000.
          </p>
        </div>
