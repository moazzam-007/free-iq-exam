---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Рейтинг IQ и таблица рекордов: глобальные результаты когорт | FreeIQExam";
const description = "Глобальный рейтинг IQ и таблица рекордов: когортные бенчмарки по стандартизированной шкале SD 15, процентили и античит-валидация результатов онлайн.";

const topScorers = [
  { rank: 1, code: "US", country: "США", name: "Alex_V.", score: 146, percentile: "99.9-й", domain: "Подвижный интеллект (FRI: 148)", hash: "v8f9-2a1c" },
  { rank: 2, code: "JP", country: "Япония", name: "Hana_K.", score: 142, percentile: "99.7-й", domain: "Визуально-пространственное (VSI: 145)", hash: "k4m2-9d3e" },
  { rank: 3, code: "DE", country: "Германия", name: "Marcus_S.", score: 138, percentile: "99.4-й", domain: "Количественное мышление (QRI: 141)", hash: "s7x1-0p8b" },
  { rank: 4, code: "CA", country: "Канада", name: "Elena_R.", score: 135, percentile: "99.0-й", domain: "Вербальная логика (VCI: 137)", hash: "r3c8-5w2y" },
  { rank: 5, code: "GB", country: "Великобритания", name: "David_L.", score: 132, percentile: "98.3-й", domain: "Подвижный интеллект (FRI: 134)", hash: "l9b6-4h7q" },
  { rank: 6, code: "AU", country: "Австралия", name: "Sarah_M.", score: 131, percentile: "98.1-й", domain: "Количественное мышление (QRI: 133)", hash: "m2t5-8n1z" },
  { rank: 7, code: "KR", country: "Южная Корея", name: "Kenji_T.", score: 130, percentile: "97.7-й", domain: "Визуально-пространственное (VSI: 132)", hash: "t6v4-1k9x" },
  { rank: 8, code: "IN", country: "Индия", name: "Priya_N.", score: 129, percentile: "97.3-й", domain: "Подвижный интеллект (FRI: 131)", hash: "n5p7-3m8f" },
  { rank: 9, code: "FR", country: "Франция", name: "Lukas_B.", score: 128, percentile: "96.9-й", domain: "Вербальная логика (VCI: 130)", hash: "b8q3-7r4d" },
  { rank: 10, code: "NL", country: "Нидерланды", name: "Chloe_D.", score: 127, percentile: "96.4-й", domain: "Визуально-пространственное (VSI: 129)", hash: "d1w9-6v5s" }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Рейтинг IQ и глобальная таблица рекордов | FreeIQExam",
    "description": description,
    "url": "https://freeiqexam.com/ru/leaderboard"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Рейтинг IQ",
        "item": "https://freeiqexam.com/ru/leaderboard"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/leaderboard" idPath="/papan-peringkat" canonicalUrl="https://freeiqexam.com/ru/leaderboard">
  <Header currentPath="/leaderboard"  enPath="/leaderboard" idPath="/papan-peringkat"/>

  <main class="flex-1 py-12 md:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto w-full">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Таблица лидеров</span>
    </nav>

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-500" aria-hidden="true"></span>
        <span>ГЛОБАЛЬНЫЕ КОГНИТИВНЫЕ БЕНЧМАРКИ &bull; ИЛЛЮСТРАТИВНЫЕ КОГОРТЫ</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Рейтинг IQ и глобальная таблица рекордов
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Примеры когортных показателей перцентилей, откалиброванные по стандартизированным нормативным распределениям двухпараметрической теории IRT 2PL на основе международных референтных популяций. Эти демонстрационные результаты отражают распределение баллов по когнитивным уровням.
      </p>

      <!-- Stat Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-medium mt-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <svg class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.496m5.007 0a3 3 0 003-3V6.75a3 3 0 00-3-3h-5.007a3 3 0 00-3 3v5.625a3 3 0 003 3z" />
          </svg>
          Примеры когортных перцентилей
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
          <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
          Рейтинг сообщества (в разработке)
        </span>
      </div>
    </header>

    <!-- Main Таблица лидеров Card -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="rounded-3xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 shadow-[0_8px_32px_-8px_rgba(0,0,0,0.08)] bg-white dark:bg-zinc-900">
        <!-- Card Header Banner -->
        <div class="px-6 sm:px-8 py-5 bg-zinc-900 border-b border-zinc-800 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-400 block mb-1">
              Стандартизированная шкала (среднее 100, SD 15)
            </span>
            <h2 class="text-lg sm:text-xl font-heading font-bold text-white">
              Примеры когортных показателей перцентилей
            </h2>
          </div>
          <span class="px-3.5 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 shrink-0">
            Рейтинг сообщества: в разработке
          </span>
        </div>

        <!-- Table container with responsive scroll -->
        <div class="overflow-x-auto">
          <div class="min-w-[500px]">
            <!-- Table Header -->
            <div class="grid grid-cols-[48px_1fr_90px_80px_1fr] gap-3 px-6 py-3.5 border-b border-zinc-200 dark:border-zinc-800 text-xs font-mono font-semibold text-zinc-500 uppercase tracking-wider bg-zinc-50/70 dark:bg-zinc-900/80">
              <span>Ранг</span>
              <span>Референтная когорта</span>
              <span class="text-right">Балл IQ</span>
              <span class="text-right">Перцентиль</span>
              <span class="hidden sm:block">Ведущая область способностей</span>
            </div>

            <!-- Scorer Rows -->
            <div class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
              {topScorers.map((user) => (
                <div class="grid grid-cols-[48px_1fr_90px_80px_1fr] gap-3 items-center px-6 py-4 hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors">
                  <!-- Rank -->
                  <span class={`font-mono font-bold text-sm ${user.rank === 1 ? 'text-amber-500 text-base' : user.rank === 2 ? 'text-zinc-500 dark:text-zinc-400' : user.rank === 3 ? 'text-amber-700' : 'text-zinc-500'}`}>
                    #{user.rank}
                  </span>

                  <!-- Examinee with Flag -->
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="font-mono text-[11px] font-bold px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 select-none shrink-0" title={user.country} aria-label={user.country}>{user.code}</span>
                    <div class="truncate">
                      <span class="font-medium text-sm text-zinc-900 dark:text-white block truncate">{user.name}</span>
                      <span class="font-mono text-[10px] text-zinc-500 dark:text-zinc-400 block">{user.hash}</span>
                    </div>
                  </div>

                  <!-- Score -->
                  <div class="text-right">
                    <span class="font-mono font-bold text-sm text-zinc-900 dark:text-white">{user.score}</span>
                    <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 block">IQ (SD 15)</span>
                  </div>

                  <!-- Процентиль -->
                  <span class="font-mono text-xs font-semibold text-blue-600 dark:text-blue-400 text-right">
                    {user.percentile}
                  </span>

                  <!-- Domain -->
                  <span class="hidden sm:block text-xs text-zinc-500 dark:text-zinc-400 truncate">
                    {user.domain}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Callout Banner -->
        <div class="px-6 sm:px-8 py-5 bg-zinc-50 dark:bg-zinc-900/60 border-t border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <p class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white text-center sm:text-left">
              Оцените свои когнитивные способности
            </p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 text-center sm:text-left">
              Пройдите 20-минутную оценку, чтобы сравнить латентную способность с нормативными популяционными бенчмарками. Синхронизация глобального рейтинга — в разработке.
            </p>
          </div>
          <a
            href="/ru/test"
            class="shrink-0 px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-sm transition-all hover:scale-105 active:scale-[0.97] whitespace-nowrap"
          >
            Пройти тест сейчас
          </a>
        </div>
      </div>
    </section>

    <!-- How Qualification Works -->
    <section class="max-w-4xl mx-auto mb-16">
      <div class="text-center mb-10">
        <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          Как работает сравнение с бенчмарками
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          Алгоритмы 2-параметрической теории IRT оценивают ваш индивидуальный уровень латентной способности (&theta;) в сопоставлении со стандартными популяционными когортами по всем четырём когнитивным доменам CHC.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            1
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Пройти полное тестирование
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Пройдите стандартизированную оценку из 24 заданий, охватывающую подвижный интеллект, пространственное, количественное и вербальное мышление с таймером на 20 минут.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            2
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Оценка латентной способности (&theta;)
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Получите байесовскую оценку способностей EAP и стандартизированный эквивалент IQ, сопоставленный со стандартными нормативными выборками.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-10 h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center font-bold text-base mb-4 font-mono">
            3
          </div>
          <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white mb-2">
            Сравнение с перцентилями когорты
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Изучите оценку латентного уровня и сильные стороны по доменам непосредственно в отчёте с результатами. Публикация результатов в сообществе и верифицированные рейтинги находятся в активной разработке.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto space-y-6">
      <div>
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Часто задаваемые вопросы о рейтинге IQ и когортных рекордах
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          Методология бенчмарков, стандартизация по модели 2PL IRT и валидация результатов.
        </p>
      </div>

      <div class="space-y-3">
        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white list-none">
            <span>Как рассчитываются баллы в таблице рекордов?</span>
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800">
            Показатели референтных когорт калибруются с помощью двухпараметрической теории моделирования заданий (2PL IRT) на основе параметров стандартного нормального распределения (среднее 100, стандартное отклонение SD 15). Они отражают латентную способность (тета) и веса правильных ответов по четырём субдоменам CHC.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white list-none">
            <span>Являются ли результаты теста официальным клиническим диагнозом?</span>
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800">
            Нет. Наша онлайн-оценка — образовательный инструмент для самопознания и тренировки когнитивных способностей. Она не является клиническим диагнозом и не заменяет очное психологическое обследование под руководством сертифицированного специалиста (например, батареи WAIS-IV или Stanford-Binet V).
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white list-none">
            <span>Как работает защита от читерства и скриптов?</span>
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800">
            Платформа отслеживает латентность ответов на каждый вопрос, паттерны кликов и целостность токенов сессии. Попытки автоматического перебора, сверхбыстрых неправдоподобных кликов (&lt;500 мс на сложные матрицы) или модификации клиентского хранилища дисквалифицируются при валидации скоринга.
          </p>
        </details>

        <details class="group p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white list-none">
            <span>Когда появится возможность опубликовать свой результат в живом рейтинге?</span>
            <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400 group-open:rotate-180 transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mt-3 pt-3 border-t border-zinc-200/60 dark:border-zinc-800">
            Функционал отправки верифицированных результатов и сезонных таблиц лидеров сообщества находится в активной разработке. Сейчас вы можете сохранить свой результат локально в <a href="/ru/profile" class="text-blue-600 dark:text-blue-400 hover:underline">личном профиле</a> или сгенерировать официальный сертификат.
          </p>
        </details>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
