---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Тест на матрицы IQ: 9 правил, логика и примеры | FreeIQExam";
const description = "Разбор матриц IQ: прогрессия, ротация, XOR, сложение, вычитание, распределение признаков и другие правила. Бесплатные примеры и стратегия решения.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Тест на матрицы IQ: 9 правил логики и решения",
    "description": "Разбор матриц IQ: прогрессия, ротация, XOR, сложение, вычитание, распределение признаков и другие правила. Бесплатные примеры и стратегия решения.",
    "url": "https://freeiqexam.com/ru/matrix-reasoning-test/",
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam",
      "url": "https://freeiqexam.com/ru/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Матричное мышление",
        "item": "https://freeiqexam.com/ru/matrix-reasoning-test/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Что такое тест на матричное мышление?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Тест на матричное мышление - это невербальное когнитивное задание, в котором нужно найти отсутствующий элемент, определив правило преобразования между фигурами."
        }
      },
      {
        "@type": "Question",
        "name": "Какие основные правила используются в прогрессивных матрицах?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Полезно проверять постоянство признаков, количественную прогрессию, распределение признаков, XOR, вращение, сложение, вычитание и чередование."
        }
      },
      {
        "@type": "Question",
        "name": "Почему матричные задания считаются относительно независимыми от языка?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Матрицы используют абстрактные фигуры вместо длинных словесных заданий. Это снижает зависимость от словарного запаса, хотя полностью исключить культурное влияние тестирования нельзя."
        }
      },
      {
        "@type": "Question",
        "name": "Можно ли подготовиться к тестам на матричное мышление?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Разделяйте форму, количество, ориентацию, заливку и положение, затем проверяйте строки и столбцы отдельно. Такая стратегия помогает уменьшать случайные ошибки и быстрее находить правило."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/matrix-reasoning-test" idPath="/tes-matriks-progresif" canonicalUrl="https://freeiqexam.com/ru/matrix-reasoning-test">
  <Header currentPath="/matrix-reasoning-test"  enPath="/matrix-reasoning-test" idPath="/tes-matriks-progresif"/>

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-12">
    
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>НЕВЕРБАЛЬНАЯ ЛОГИКА • 9 ПРАВИЛ МАТРИЦ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тест на матрицы IQ: 9 правил логики и решения
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Матричные задания проверяют способность находить закономерности в новых визуальных структурах. Ниже собраны девять практических принципов, которые помогают решать задания на IQ с картинками и фигурами.
      </p>
    </header>

    <!-- Why Matrix Reasoning Isolates Gf Section -->
    <section class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
      <div class="max-w-3xl">
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-2">
          Теоретическая основа
        </span>
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-3">
          Почему матричное мышление оценивает подвижный интеллект
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
          В отличие от вербальных заданий или субтестов на словарный запас, на которые сильно влияют образование и культурный опыт, прогрессивные матрицы используют абстрактные геометрические фигуры для оценки способности к индуктивному умозаключению.
        </p>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Задания на матричное мышление широко применяются в оценке интеллекта ($Gf$), поскольку они требуют выявления закономерностей, правил и связей в новой визуальной информации без опоры на язык.
        </p>
      </div>
    </section>

    <!-- The 9 Core Transformation Rules -->
    <section class="space-y-6">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white">
          9 универсальных правил матриц IQ
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
          Почти каждая матричная задача в тестах интеллекта строится на комбинации этих фундаментальных принципов.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Rule 1: Constant Progression -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              1
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              1. Постоянство признака в строке или столбце
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Проверьте, сохраняется ли один признак во всех ячейках строки или столбца, пока другие признаки меняются по отдельному правилу.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Пример: В строке 1 всегда квадраты, в строке 2 — круги, в строке 3 — треугольники.
          </div>
        </div>

        <!-- Rule 2: Quantitative Progression -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              2
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              2. Количественная прогрессия
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Сравните количество элементов и разности между соседними ячейками. Последовательность может расти, уменьшаться или повторять циклический шаг.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Пример: 1 точка &rarr; 2 точки &rarr; 3 точки вдоль строки.
          </div>
        </div>

        <!-- Rule 3: Boolean XOR Logic -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              3
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              3. Логическое XOR и отмена пересечений
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              При XOR совпадающие элементы отменяются, а уникальные остаются. Проверяйте правило на нескольких строках и столбцах, а не только на одной комбинации.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Формула: Ячейка 3 = Ячейка 1 XOR Ячейка 2.
          </div>
        </div>

        <!-- Rule 4: Latin Square Permutation -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              4
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              4. Распределение трёх признаков
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Три состояния признака могут распределяться по строке или столбцу так, чтобы каждое состояние встречалось один раз. Проверяйте отдельно форму, заливку, направление и количество.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Правило: Каждая строка и столбец содержат признаки A, B и C без повторений.
          </div>
        </div>

        <!-- Rule 5: Spatial Rotation & Reflection -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              5
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              5. Пространственное вращение и отражение
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Фигура может поворачиваться на фиксированный угол или отражаться относительно оси. Сначала отслеживайте асимметричные точки, стрелки и выступы.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Пример: Стрелка поворачивается на 90&deg; по часовой стрелке: вверх &rarr; вправо &rarr; вниз.
          </div>
        </div>

        <!-- Rule 6: Element Addition -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              6
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              6. Сложение элементов
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Два набора признаков объединяются в третью ячейку. Сравнивайте форму, количество, направление линий и заливку отдельно, чтобы проверить, действительно ли третья ячейка является объединением первых двух.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Формула: Ячейка 3 = Ячейка 1 + Ячейка 2.
          </div>
        </div>

        <!-- Rule 7: Element Subtraction -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              7
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              7. Вычитание элементов
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Иногда из одного набора признаков удаляется то, что присутствует во втором. Проверьте, исчезают ли общие элементы и сохраняются ли уникальные на других строках или столбцах.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Формула: Ячейка 3 = Ячейка 1 &minus; Ячейка 2.
          </div>
        </div>

        <!-- Rule 8: Feature Alternation -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              8
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              8. Чередование признаков
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Направление, заливка, контур, размер или положение могут чередоваться между двумя состояниями. Ищите цикл по всей строке или столбцу, а не только между двумя соседними ячейками.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Пример: Чёрный &rarr; Белый &rarr; Чёрный или Большой &rarr; Малый &rarr; Большой.
          </div>
        </div>

        <!-- Rule 9: Movement Sequence -->
        <div class="p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs flex flex-col justify-between md:col-span-2">
          <div>
            <div class="w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-200 dark:border-zinc-700 font-mono font-bold text-sm flex items-center justify-center mb-3">
              9
            </div>
            <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
              9. Последовательность движения
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
              Точка или фигура может перемещаться по фиксированной траектории: по часовой стрелке, по углам, по диагонали или через центр. Отслеживайте положение в каждом шаге.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500">
            Пример: Точка движется по часовой стрелке по углам квадрата: верх-лево &rarr; верх-право &rarr; низ-право.
          </div>
        </div>

      </div>
    </section>

    <!-- Interactive Demonstration Puzzle Card -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
      <div class="max-w-2xl mx-auto text-center mb-6">
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-2">
          Практический пример
        </span>
        <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Интерактивная матрица: логика XOR в действии
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          Изучите взаимодействие линий в Строках 1 и 2. Какой вариант завершает Строку 3?
        </p>
      </div>

      <!-- Sample Matrix Vector Stimulus -->
      <div class="max-w-xs mx-auto p-4 rounded-2xl bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 mb-6">
        <svg viewBox="0 0 280 280" class="w-full h-auto select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="280" height="280" rx="8" fill="#f4f4f5" class="dark:fill-zinc-900" stroke="#e4e4e7" class="dark:stroke-zinc-800" stroke-width="2" />
          <line x1="93.3" y1="0" x2="93.3" y2="280" stroke="#d4d4d8" class="dark:stroke-zinc-700" stroke-width="2" />
          <line x1="186.6" y1="0" x2="186.6" y2="280" stroke="#d4d4d8" class="dark:stroke-zinc-700" stroke-width="2" />
          <line x1="0" y1="93.3" x2="280" y2="93.3" stroke="#d4d4d8" class="dark:stroke-zinc-700" stroke-width="2" />
          <line x1="0" y1="186.6" x2="280" y2="186.6" stroke="#d4d4d8" class="dark:stroke-zinc-700" stroke-width="2" />

          <!-- Row 1: Vertical + Horizontal = Cross -->
          <line x1="46.6" y1="20" x2="46.6" y2="73.3" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />
          <line x1="113.3" y1="46.6" x2="166.6" y2="46.6" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />
          <line x1="233.3" y1="20" x2="233.3" y2="73.3" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />
          <line x1="206.6" y1="46.6" x2="260" y2="46.6" stroke="#2563eb" stroke-width="3" stroke-linecap="round" />

          <!-- Row 2: Overlapping horizontal cancels -->
          <line x1="20" y1="140" x2="73.3" y2="140" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
          <line x1="46.6" y1="113.3" x2="46.6" y2="166.6" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
          <line x1="113.3" y1="140" x2="166.6" y2="140" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />
          <!-- Result: horizontal cancelled, only vertical remains -->
          <line x1="233.3" y1="113.3" x2="233.3" y2="166.6" stroke="#6366f1" stroke-width="3" stroke-linecap="round" />

          <!-- Row 3: Diagonal X lines -->
          <line x1="20" y1="206.6" x2="73.3" y2="260" stroke="#a855f7" stroke-width="3" stroke-linecap="round" />
          <line x1="113.3" y1="206.6" x2="166.6" y2="260" stroke="#a855f7" stroke-width="3" stroke-linecap="round" />
          <line x1="166.6" y1="206.6" x2="113.3" y2="260" stroke="#a855f7" stroke-width="3" stroke-linecap="round" />

          <!-- Missing Вопрос Mark Cell -->
          <g transform="translate(186.6, 186.6)">
            <rect width="93.3" height="93.3" fill="#eff6ff" class="dark:fill-blue-950/40" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4 3" />
