---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const alternates = {
  en: '/memento-mori',
  id: '/id/memento-mori'
};

const title = 'Memento Mori: Календарь жизни в 4 000 недель и калькулятор долголетия | FreeIQExam';
const description = 'Наглядный стоический календарь жизни в 4 000 недель и актуарный калькулятор ожидаемой продолжительности жизни. 100% приватно, скачайте постер бесплатно.';
const canonicalUrl = 'https://freeiqexam.com/ru/memento-mori';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'FreeIQExam Календарь Memento Mori Interaktif 4.000 Minggu',
    'url': 'https://freeiqexam.com/ru/memento-mori',
    'applicationCategory': 'LifestyleApplication',
    'operatingSystem': 'All',
    'browserRequirements': 'Membutuhkan dukungan JavaScript',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    },
    'featureList': [
      'Grid 4.000 Minggu Kehidupan Interaktif (visualisasi minggu demi minggu usia 0-90+ tahun)',
      '4 Era Kehidupan: Pembentukan (0-18), Ambisi (18-35), Penguasaan (35-60), dan Warisan (60+)',
      'Kalkulator harapan hidup aktuaria dengan faktor gaya hidup biometrik (olahraga, tidur, pola makan, rokok, stres)',
      'Tooltip inspeksi minggu interaktif menampilkan usia persis, tanggal, dan fase hidup',
      'Koleksi refleksi Stoik harian dari Marcus Aurelius, Seneca, dan Epictetus',
      'Unduh poster cetak personal resolusi tinggi PNG 1200x675',
      '100% pemrosesan lokal di peramban tanpa transmisi data pribadi'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Главная',
        'item': 'https://freeiqexam.com/id/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Инструменты',
        'item': 'https://freeiqexam.com/id/permainan'
      },
      {
        '@type': 'ListItem',
        'position': 3,
        'name': 'Календарь Memento Mori',
        'item': 'https://freeiqexam.com/ru/memento-mori'
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': [
      {
        '@type': 'Question',
        'name': 'Apa itu Memento Mori dan mengapa kaum Stoik mempraktikkannya?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Memento Mori adalah frasa Latin yang bermakna "Ingatlah bahwa engkau akan mati." Bagi kaum Stoik seperti Seneca, Marcus Aurelius, dan Epictetus, merenungkan kefanaan bukanlah keputusasaan, melainkan penjernih pikiran terbaik untuk mengikis kekhawatiran sepele, menghentikan penundaan, dan menumbuhkan rasa syukur mendalam atas saat ini.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Berapa minggu dalam rata-rata rentang hidup manusia?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Rata-rata umur manusia 80 tahun berisi sekitar 4.160 minggu (80 × 52,1775). Pada usia 30 tahun, Anda telah menjalani sekitar 1.560 minggu (37,5%). Pada usia 50 tahun, sekitar 2.600 minggu (62,5%). Memvisualisasikan hidup dalam grid 4.000 minggu mengubah waktu abstrak menjadi aset nyata yang terbatas.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Mengapa waktu terasa berjalan lebih cepat saat kita menua?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Teori Proporsional Janet menjelaskan bahwa pada usia 10 tahun, satu tahun mewakili 10% dari total hidup Anda; namun pada usia 50 tahun, satu tahun hanya mewakili 2%. Rutinitas dewasa yang monoton juga minim pengalaman baru, membuat otak memadatkan memori masa lalu menjadi ringkasan singkat.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Bagaimana gaya hidup memengaruhi harapan hidup dan healthspan?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Penelitian epidemiologis menunjukkan bahwa olahraga teratur (+3,5 hingga +4,5 tahun), tidur 7-8 jam (+2,4 tahun), diet sehat seimbang (+2,8 tahun), dan tidak merokok (+8,5 tahun) dapat memperpanjang masa hidup sehat bebas penyakit kronis hingga lebih dari satu dekade.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Apa perbedaan antara masa hidup (lifespan) dan masa sehat (healthspan)?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Lifespan adalah total tahun seseorang hidup secara biologis. Healthspan adalah rentang waktu hidup yang dihabiskan dalam kondisi sehat prima tanpa penyakit kronis atau keterbatasan fisik. Tujuannya adalah mempersempit masa morbiditas agar masa sehat sama panjangnya dengan masa hidup.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Apa itu Amor Fati dalam filosofi Stoik?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Amor Fati berarti "Cinta pada Takdir." Berakar dari ajaran Marcus Aurelius dan Epictetus, ini adalah praktik tidak hanya menerima apa pun yang terjadi, tetapi merangkul setiap tantangan dan rintangan sebagai bahan bakar pembentuk karakter dan kebajikan.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Bagaimana Memento Mori mengurangi kecemasan dan stres sehari-hari?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Merenungkan kefanaan memberi perspektif kosmis instan ("Pandangan dari Atas"). Dalam skala waktu yang luas, konflik kecil, gosip, dan kecemasan sosial menyusut menjadi tidak berarti, membebaskan energi mental untuk tindakan yang benar-benar bermakna.'
        }
      },
      {
        '@type': 'Question',
        'name': 'Apakah tanggal lahir atau data pribadi saya disimpan di server?',
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': 'Tidak. Semua perhitungan, visualisasi grid kehidupan, dan pembuatan poster dijalankan 100% secara lokal di peramban web Anda. Tidak ada data pribadi yang dikirimkan atau disimpan ke server mana pun.'
        }
      }
    ]
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
  alternates={alternates}
  enPath="/memento-mori"
  idPath="/memento-mori"
>
  <Header currentPath="/ru/memento-mori" enPath="/memento-mori" idPath="/memento-mori" />

  <main class="min-h-screen bg-white dark:bg-[#000000] text-zinc-900 dark:text-zinc-100 font-sans transition-colors duration-200">
    
    <!-- Hero Header -->
    <section class="pt-12 pb-6 px-4 sm:px-6 max-w-5xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 text-[13px] font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
          <span>4.000 MINGGU · PERSPEKTIF STOIK</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-extrabold tracking-[-0.025em] text-zinc-950 dark:text-white mb-4">
          Memento Mori: Hidup Anda dalam Minggu
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          “Bukanlah karena waktu hidup kita singkat, melainkan karena kita banyak membuangnya.” Visualisasikan 4.000 minggu Anda yang terbatas di Bumi, hitung estimasi harapan hidup aktuaria, dan jalani hari dengan kesadaran Stoik yang bermakna.
        </p>
    </section>

    <!-- Main Tool Container -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
      
      <!-- Biometric & Lifestyle Input Deck -->
      <div class="bg-zinc-50 dark:bg-[#090a0f] border border-zinc-200 dark:border-zinc-800/80 rounded-3xl p-5 sm:p-8 mb-8 shadow-sm">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          
          <!-- Date of Birth Input -->
          <div>
            <label for="mementoDob" class="block text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Tanggal Lahir</span>
            </label>
            <input
              type="date"
              id="mementoDob"
              class="w-full min-h-[44px] bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 rounded-xl px-4 py-2 text-zinc-900 dark:text-zinc-100 font-mono text-[14px] focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer"
            />
          </div>

          <!-- Biological Sex Selector -->
          <div>
            <label class="block text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /><path d="M12 4v2" /><path d="M20 12h-2" /><path d="M12 20v-2" /><path d="M4 12h2" /></svg>Биологический пол</span>
            </label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="memento-gender-btn active min-h-[44px] flex-1 py-2 rounded-xl text-[13px] font-semibold border border-blue-600 bg-blue-600/10 text-blue-600 dark:border-blue-400 dark:bg-blue-400/10 dark:text-blue-400 transition-all duration-160 active:scale-[0.97] cursor-pointer"
                data-gender="male"
              >
                ♂ Pria
              </button>
              <button
                type="button"
                class="memento-gender-btn min-h-[44px] flex-1 py-2 rounded-xl text-[13px] font-medium border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-160 active:scale-[0.97] cursor-pointer"
                data-gender="female"
              >
                ♀ Wanita
              </button>
            </div>
          </div>

          <!-- Poster Download Action Button -->
          <div class="flex flex-col justify-end">
            <button
              type="button"
              id="downloadMementoPosterBtn"
              class="w-full min-h-[44px] py-2.5 px-4 rounded-xl bg-[#0066cc] hover:bg-[#0052a3] dark:bg-[#2997ff] dark:hover:bg-[#1a82e6] text-white font-semibold text-[14px] shadow-sm transition-all duration-160 active:scale-[0.97] flex items-center justify-center gap-2 cursor-pointer"
            >
              <span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>Скачать постер жизни (PNG)</span>
            </button>
          </div>

        </div>

        <!-- Longevity & Lifestyle Modifiers Toggle -->
        <div class="pt-6">
          <label class="block text-[13px] font-mono font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-3">
<span class="inline-flex items-center gap-1.5"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18h8" /><path d="M3 22h18" /><path d="M14 22a7 7 0 1 0-7-7h1" /><path d="M9 14h2" /><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z" /><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3" /></svg>Faktor Gaya Hidup & Harapan Hidup Aktuaria</span>
          </label>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            
            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-blue-500/50 transition-colors min-h-[44px]">
              <input type="checkbox" id="modExercise" checked class="w-4 h-4 rounded accent-[#0066cc] dark:accent-[#2997ff] cursor-pointer" />
              <div>
                <span class="font-semibold block text-zinc-900 dark:text-zinc-100 text-[13px]">Olahraga 150m+</span>
                <span class="text-[13px] text-emerald-600 dark:text-emerald-400 font-mono">+3.8 thn</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-blue-500/50 transition-colors min-h-[44px]">
              <input type="checkbox" id="modSleep" checked class="w-4 h-4 rounded accent-[#0066cc] dark:accent-[#2997ff] cursor-pointer" />
              <div>
                <span class="font-semibold block text-zinc-900 dark:text-zinc-100 text-[13px]">Tidur 7-8 Jam</span>
                <span class="text-[13px] text-emerald-600 dark:text-emerald-400 font-mono">+2.4 thn</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-blue-500/50 transition-colors min-h-[44px]">
              <input type="checkbox" id="modDiet" checked class="w-4 h-4 rounded accent-[#0066cc] dark:accent-[#2997ff] cursor-pointer" />
              <div>
                <span class="font-semibold block text-zinc-900 dark:text-zinc-100 text-[13px]">Pola Makan Sehat</span>
                <span class="text-[13px] text-emerald-600 dark:text-emerald-400 font-mono">+2.8 thn</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-blue-500/50 transition-colors min-h-[44px]">
              <input type="checkbox" id="modSmoking" class="w-4 h-4 rounded accent-[#0066cc] dark:accent-[#2997ff] cursor-pointer" />
              <div>
                <span class="font-semibold block text-zinc-900 dark:text-zinc-100 text-[13px]">Merokok / Vape</span>
                <span class="text-[13px] text-rose-600 dark:text-rose-400 font-mono">-8.5 thn</span>
              </div>
            </label>

            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-white dark:bg-zinc-900/70 border border-zinc-200 dark:border-zinc-800 cursor-pointer hover:border-blue-500/50 transition-colors min-h-[44px]">
              <input type="checkbox" id="modStress" class="w-4 h-4 rounded accent-[#0066cc] dark:accent-[#2997ff] cursor-pointer" />
              <div>
                <span class="font-semibold block text-zinc-900 dark:text-zinc-100 text-[13px]">Stres Kronis</span>
                <span class="text-[13px] text-rose-600 dark:text-rose-400 font-mono">-2.5 thn</span>
              </div>
            </label>

          </div>
        </div>

      </div>

      <!-- Life Metrics Scorecard -->
      <div class="bg-zinc-950 text-white border border-zinc-800/80 rounded-3xl p-6 sm:p-8 mb-8 shadow-xl relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
          
          <div class="bg-zinc-900/90 p-4 rounded-2xl border border-zinc-800/80 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">Minggu Terlewati</span>
            <span id="statLivedWeeks" class="text-3xl sm:text-4xl font-extrabold font-mono text-zinc-100">1.460</span>
            <span class="text-[13px] text-zinc-400 block mt-1">Perjalanan Hidup</span>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-2xl border border-zinc-800/80 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">Sisa Minggu</span>
            <span id="statRemainingWeeks" class="text-3xl sm:text-4xl font-extrabold font-mono text-[#0066cc] dark:text-[#2997ff]">2.700</span>
            <span class="text-[13px] text-zinc-400 block mt-1">Potensi Masa Depan</span>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-2xl border border-zinc-800/80 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">Waktu Terpakai</span>
            <span id="statPercentSpent" class="text-3xl sm:text-4xl font-extrabold font-mono text-zinc-300">35.1%</span>
            <span class="text-[13px] text-zinc-400 block mt-1">Persentase Hidup</span>
          </div>

          <div class="bg-zinc-900/90 p-4 rounded-2xl border border-zinc-800/80 text-center">
            <span class="text-[13px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">Estimasi Usia</span>
            <span id="statLifeExpectancy" class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400">87.2 thn</span>
            <span class="text-[13px] text-zinc-400 block mt-1">Rentang Aktuaria</span>
          </div>

        </div>

        <!-- Life Progress Bar -->
        <div class="space-y-1.5 mb-6">
          <div class="flex justify-between text-[13px] font-mono text-zinc-400">
            <span>Usia 0</span>
            <span id="statAgeYears" class="text-[#0066cc] dark:text-[#2997ff] font-bold">28.0 thn</span>
            <span>Target Usia Harapan</span>
          </div>
          <div class="w-full h-3 bg-zinc-900 rounded-full overflow-hidden border border-zinc-800 p-0.5">
            <div id="lifeProgressBar" class="h-full bg-[#0066cc] dark:bg-[#2997ff] rounded-full transition-all duration-500" style="width: 35.1%;"></div>
          </div>
        </div>

        <!-- Deep Time Breakdown -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-zinc-800/80 text-center font-mono text-[13px] text-zinc-400">
          <div>
            <span class="text-[13px] text-zinc-400 uppercase block">Estimasi Осталось дней</span>
            <span id="statRemainingDays" class="font-bold text-white text-[15px]">18.900</span>
          </div>
          <div>
            <span class="text-[13px] text-zinc-400 uppercase block">Estimasi Sisa Jam</span>
            <span id="statRemainingHours" class="font-bold text-white text-[15px]">453.600</span>
          </div>
          <div>
            <span class="text-[13px] text-zinc-400 uppercase block">Estimasi Осталось ударов сердца</span>
            <span id="statRemainingHeartbeats" class="font-bold text-[#0066cc] dark:text-[#2997ff] text-[15px]">1.959.552.000</span>
          </div>
        </div>

      </div>

      <!-- 4,000 Weeks Interactive Grid Arena -->
      <div class="bg-zinc-50 dark:bg-[#090a0f] border border-zinc-200 dark:border-zinc-800/80 rounded-3xl p-4 sm:p-8 shadow-sm">
        
        <!-- Legend & Eras Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800/80">
          <div>
            <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white tracking-[-0.02em]">
              Grid 4.000 Minggu Kehidupan
            </h2>
            <p class="text-[13px] text-zinc-500 dark:text-zinc-400">
              Setiap kotak mewakili 1 minggu (52 minggu per baris horizontal = 1 tahun penuh).
            </p>
          </div>

          <!-- Dot Legend -->
          <div class="flex flex-wrap items-center gap-4 text-[13px] font-mono">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-zinc-900 dark:bg-zinc-100"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Minggu Terlewati</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm bg-[#0066cc] dark:bg-[#2997ff] shadow-[0_0_6px_rgba(41,151,255,0.6)] animate-pulse"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Minggu Saat Ini</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-sm border border-zinc-300 dark:border-zinc-700/80"></span>
              <span class="text-zinc-600 dark:text-zinc-400">Sisa Waktu</span>
            </div>
          </div>
        </div>

        <!-- Life Eras Key -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-6 text-[13px] font-mono">
          <div class="p-3 rounded-xl bg-zinc-100 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200">
            <span class="block font-bold text-[13px]">Usia 0 – 18</span>
            <span class="text-[13px] text-zinc-500 dark:text-zinc-400">Pembentukan & Masa Kanak</span>
          </div>
          <div class="p-3 rounded-xl bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400">
            <span class="block font-bold text-[13px]">Usia 18 – 35</span>
            <span class="text-[13px] text-zinc-500 dark:text-zinc-400">Ambisi & Pendidikan</span>
          </div>
