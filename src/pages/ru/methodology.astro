---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Методология теста IQ: 2PL IRT, EAP и шкала SD 15 | FreeIQExam";
const description = "Как рассчитывается результат теста IQ: модель 2PL IRT, параметры трудности и дискриминативности, байесовская EAP-оценка, преобразование в IQ и процентиль.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": "Психометрические основания и скоринговая методология 2-параметрической логистической IRT",
    "description": "Комплексный психометрический документ: движок теории тестовых заданий с 2-параметрической логистической моделью (2PL), байесовская оценка ожидаемого апостериорного значения (EAP) методом квадратур, конструктная валидность по Кеттеллу–Хорну–Кэрроллу и дорожная карта эмпирической калибровки.",
    "proficiencyLevel": "Expert",
    "inLanguage": "ru",
    "url": "https://freeiqexam.com/ru/methodology/",
    "author": {
      "@type": "Organization",
      "name": "FreeIQExam Psychometrics Committee",
      "url": "https://freeiqexam.com/ru/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "FreeIQExam.com",
      "url": "https://freeiqexam.com/ru/"
    },
    "about": [
      { "@type": "Thing", "name": "Item Response Theory" },
      { "@type": "Thing", "name": "Psychometrics" },
      { "@type": "Thing", "name": "Cattell-Horn-Carroll Theory" },
      { "@type": "Thing", "name": "Bayesian Expected A Posteriori Estimation" }
    ],
    "citation": [
      "https://doi.org/10.1016/j.intell.2014.01.004",
      "https://doi.org/10.7910/DVN/PDI7Y1",
      "https://doi.org/10.1007/BF02293801",
      "https://doi.org/10.3758/BRM.42.2.525"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Психометрическая методология",
        "item": "https://freeiqexam.com/ru/methodology/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Чем 2PL-теория тестовых заданий (IRT) отличается от классической теории тестов (CTT)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "В классической теории тестов (CTT) оценка строится на сырых процентных суммах (подсчёт верных ответов), при этом каждый вопрос считается равным по трудности и диагностическому весу. Напротив, 2-параметрическая логистическая теория тестовых заданий (2PL IRT) математически моделирует каждое задание двумя отдельными параметрами: трудностью задания (b) и дискриминативностью задания (a). Благодаря этому верное решение трудной, высокодискриминативной матричной головоломки даёт куда более веское свидетельство высокого латентного уровня (тета), чем решение базового вводного задания."
        }
      },
      {
        "@type": "Question",
        "name": "Почему FreeIQExam использует байесовскую EAP-оценку, а не метод максимального правдоподобия (MLE)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Метод максимального правдоподобия (MLE) отказывает либо даёт бесконечные оценки, когда испытуемый набирает 0% (все неверно) или 100% (идеальный результат). Байесовская оценка ожидаемого апостериорного значения (EAP) решает эту проблему, интегрируя апостериорное распределение латентной черты со стандартным нормальным априорным распределением (N(0, 1)). Это даёт устойчивые, конечные, несмещённые оценки теты и строгие значения стандартных ошибок по всему спектру распределения — от крайних нижних границ до высших потолков теста."
        }
      },
      {
        "@type": "Question",
        "name": "Как невербальный матричный тест соотносится с клиническими батареями вроде WAIS-IV?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Комплексные клинические батареи вроде WAIS-IV или SB5 оценивают полный IQ (FSIQ) по нескольким широким доменам CHC, включая вербальное понимание (Gc), рабочую память (Gwm) и скорость обработки (Gs). FreeIQExam изолированно измеряет невербальные подвижный интеллект (Gf) и пространственное мышление (Gv) с помощью прогрессивных матриц рассуждения, топологических рядов и головоломок на мысленное складывание. Будучи культурно редуцированным и языково независимым инструментом, он остаётся образовательным когнитивным скринингом, а не диагностической медицинской либо нейропсихологической экспертизой."
        }
      },
      {
        "@type": "Question",
        "name": "Как СДВГ или нейроотличия влияют на результат этого теста?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Такие состояния, как СДВГ, влияют прежде всего на управляющие функции, устойчивый контроль внимания и кратковременную рабочую память, а не на фундаментальный подвижный интеллект (Gf). Поскольку FreeIQExam ограничен по времени, испытуемые с провалами внимания или импульсивностью при выборе дистракторов могут показать нисходящую вариативность баллов, отражающую исполнение теста, а не латентную аналитическую способность. Спокойная обстановка без ограничения времени и отвлекающих факторов помогает убедиться, что баллы отражают подлинное выявление закономерностей."
        }
      },
      {
        "@type": "Question",
        "name": "Почему отклоняющийся IQ стандартизирован со средним 100 и стандартным отклонением (SD 15)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Современная психометрия отказалась от коэффициентов умственного возраста в пользу метрики отклоняющегося IQ Дэвида Векслера. Преобразуя оценки латентной черты (тета) по формуле IQ = 100 + 15 × тета, баллы напрямую соотносятся с процентилями гауссовой популяции. Балл 100 представляет точную медиану популяции (50-й процентиль), а баллы 115 (+1 SD), 130 (+2 SD) и 145 (+3 SD) обозначают соответственно 84,1-й, 97,7-й и 99,87-й процентили."
        }
      },
      {
        "@type": "Question",
        "name": "Что такое 2PL IRT в тесте на IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "2PL IRT - это двухпараметрическая логистическая модель теории тестовых заданий. Параметры a и b описывают дискриминативность и трудность задания, а вероятность правильного ответа зависит от уровня латентной способности."
        }
      },
      {
        "@type": "Question",
        "name": "Как EAP рассчитывает оценку способности?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EAP оценивает латентный параметр по вероятностному распределению после наблюдения ответов. Такой подход позволяет получить устойчивую итоговую оценку и не сводится к простому проценту правильных ответов."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/methodology" idPath="/metodologi" canonicalUrl="https://freeiqexam.com/ru/methodology">
  <Header  enPath="/methodology" idPath="/metodologi"/>

  <main class="flex-1 py-10 md:py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full space-y-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Методология</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4 border-b border-zinc-200 dark:border-zinc-800 pb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-medium tracking-wider uppercase bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
        Технический психометрический документ
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-extrabold text-zinc-950 dark:text-white tracking-tight leading-tight">
        Психометрические основания и скоринговый движок 2PL IRT
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-4xl">
        Рецензированный психометрический обзор 2-параметрической логистической (2PL) модели теории тестовых заданий FreeIQExam, байесовской оценки латентной черты методом ожидаемого апостериорного значения (EAP), конструктной валидности по Кеттеллу–Хорну–Кэрроллу и дорожной карты эмпирической калибровки.
      </p>

      <!-- Meta Pill Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 text-xs font-mono">
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Издание</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Документ v2.4 (2026)</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Конструктная рамка</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">CHC, страта II</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Скоринговый движок</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">2PL IRT + байесовская EAP</span>
        </div>
        <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Стандартизированная метрика</span>
          <span class="font-semibold text-zinc-800 dark:text-zinc-200">Среднее = 100, SD = 15</span>
        </div>
      </div>
    </header>

    <!-- Eysenck Comparison Block -->
    <section class="p-5 sm:p-7 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-3">
      <h2 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
        Какой метод используется для оценки IQ?
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Запрос «тест на интеллект Айзенка онлайн» относится к отдельной традиции тестирования интеллекта. FreeIQExam использует описанную ниже модель 2PL IRT и не должен представляться как официальный тест Айзенка только потому, что оба инструмента оценивают интеллект.
      </p>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        На этой странице показано, как параметры задания участвуют в вероятностной модели, почему применяется EAP-оценка и каким образом латентный параметр переводится в шкалу IQ со средним 100 и SD 15.
      </p>
    </section>

    <!-- Quick Table of Contents -->
    <nav class="p-5 rounded-2xl bg-zinc-50/80 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs sm:text-sm">
      <span class="font-heading font-bold text-zinc-950 dark:text-white uppercase tracking-wider text-xs block mb-3">
        Содержание документа
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-zinc-600 dark:text-zinc-300">
        <a href="#section-1-chc" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">01.</span> Резюме и конструктная рамка CHC
        </a>
        <a href="#section-2-2pl" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">02.</span> Формулировка 2-параметрической логистической модели (2PL) и ICC
        </a>
        <a href="#section-3-eap" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">03.</span> Байесовский движок ожидаемого апостериорного значения (EAP)
        </a>
        <a href="#section-4-standardization" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">04.</span> Стандартизация шкалы и популяционные нормы
        </a>
        <a href="#section-5-subdomains" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">05.</span> Обоснование отчётности по субдоменам
        </a>
        <a href="#section-6-roadmap" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">06.</span> Дорожная карта калибровки и открытой науки (N=500, N=1000)
        </a>
        <a href="#section-7-citations" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1.5 sm:col-span-2">
          <span class="font-mono text-zinc-500 dark:text-zinc-400">07.</span> Рецензированные источники и DOI Dataverse
        </a>
      </div>
    </nav>

    <!-- Section 1: Executive Summary & Theoretical Foundations (CHC) -->
    <section id="section-1-chc" class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xs space-y-6">
      <div>
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider block mb-2">
          Раздел 01
        </span>
        <h2 id="chc-framework" class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white mb-3">
          Резюме и теоретические основания (рамка CHC)
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Современная психометрическая наука опирает оценку когнитивных способностей человека на трёхстратную теорию Кеттелла–Хорна–Кэрролла (CHC). Согласно теории CHC, общая когнитивная способность (страта III, g) складывается из отдельных широких когнитивных доменов (страта II), каждый из которых опирается на специализированные узкие операциональные способности (страта I).
        </p>
      </div>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        FreeIQExam изолированно измеряет четыре ключевых широких домена страты II, демонстрирующих наиболее сильные эмпирические нагрузки на общий интеллект при минимальном культурном и языковом смещении:
      </p>

      <!-- 4 Core Domains Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              1. Подвижный интеллект (Gf)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Способность выделять абстрактные правила, решать новые невербальные задачи и применять логические операции в незнакомой среде. Измеряется индуктивными матрицами 3×3, топологическими преобразованиями «исключающее ИЛИ» (XOR) и завершением фигуральных рядов.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Основной банк: 27 калиброванных заданий
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              2. Пространственное мышление (Gv)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Способность воспринимать, порождать, хранить, извлекать и мысленно вращать зрительные паттерны и трёхмерные объекты в ментальном пространстве. Измеряется жёсткими вращениями 3D-кубов, синтезом развёрток 2D-в-3D и ортографическими проекциями.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Основной банк: 25 калиброванных заданий
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              3. Количественное мышление (Gq)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Способность понимать количественные свойства, выявлять вложенные математические отношения и решать реляционные числовые структуры. Измеряется перемежающимися индуктивными прогрессиями и реляционными алгебраическими задачами на скорости.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Основной банк: 24 калиброванных задания
          </span>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/80">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
            <h3 class="font-heading font-bold text-base text-zinc-950 dark:text-white">
              4. Вербальное понимание (Gc)
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
            Широта и глубина знаний, усвоенных в языковых системах: абстрактные реляционные лексические аналогии, семантические иерархии и формальная аристотелевская категорическая силлогистика.
          </p>
          <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-medium">
            Основной банк: 24 калиброванных задания
          </span>
        </div>
      </div>

      <!-- Master Bank Composition Table -->
      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800">
        <h4 class="font-heading font-bold text-sm text-zinc-950 dark:text-white uppercase tracking-wider mb-3">
          Архитектура основного банка из 100 заданий
        </h4>
