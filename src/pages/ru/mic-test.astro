---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Проверка микрофона онлайн: бесплатный тест микрофона и звука | FreeIQExam';
const description = 'Проверьте микрофон онлайн бесплатно: тест записи звука, спектрограмма частот в реальном времени и устранение неполадок микрофона без сторонних программ.';

const canonicalUrl = 'https://freeiqexam.com/ru/mic-test';

const alternates = {
  // ru: '/ru/proverka-mikrofona',
  // es: '/es/probar-microfono',
  // pt: '/pt/teste-de-microfone-online',
  // de: '/de/mikrofon-testen',
  // fr: '/fr/tester-son-micro',
  // id: '/id/tes-mic-online',
  // pl: '/pl/test-mikrofonu',
  // it: '/it/test-microfono-online',
};

const faqItems = [
  [
    'Почему индикатор микрофона не показывает сигнал при тестировании?',
    'Три наиболее частые причины: 1) Браузеру не выдано разрешение на доступ к микрофону (проверьте иконку замка или перечёркнутого микрофона в адресной строке), 2) В выпадающем списке выбрано не то устройство ввода, или 3) Другая программа использует микрофон в монопольном режиме (Zoom, Teams, Discord, OBS). Закройте фоновые приложения и перезагрузите страницу.'
  ],
  [
    'Какой уровень громкости в dBFS считается оптимальным для речи?',
    'Для речи целевой пиковый уровень (Peak) должен находиться в диапазоне от -12 dBFS до -6 dBFS, со средним значением RMS около -18 dBFS. Этот запас (headroom) предотвращает клиппинг (цифровой перегруз при 0 dBFS) при внезапном смехе или резких согласных звуках.'
  ],
  [
    'Что такое отношение сигнал/шум (SNR) и какое значение считается хорошим?',
    'SNR — это разница в децибелах между уровнем вашего голоса и фоновым шумом помещения. Значение выше 35 дБ оценивается как «Отлично», 25–35 дБ — «Хорошо», 15–25 дБ — «Удовлетворительно», а ниже 15 дБ — «Шумно». Каждые 6 дБ увеличения SNR фактически вдвое повышают разборчивость речи над шумом.'
  ],
  [
    'Почему тест рекомендует отключать шумоподавление при первоначальной проверке?',
    'Встроенные фильтры браузера (шумоподавление, эхоподавление и авторегулировка усиления) искажают исходный аналоговый сигнал. Авторегулировка постоянно меняет уровень, делая шкалу dBFS неинформативной. Сначала измерьте чистые физические характеристики микрофона, а фильтры включайте для рабочих звонков.'
  ],
  [
    'Как понять, что звук микрофона перегружен (клиппинг)?',
    'Клиппинг возникает, когда аналого-цифровой преобразователь (АЦП) достигает потолка 0 dBFS и срезает верхушки звуковой волны. Это проявляется резким неприятным треском на громких звуках. Индикатор фиксирует клиппинг при достижении 99% шкалы. Решение — уменьшить чувствительность микрофона в настройках системы или ручкой Gain на звуковой карте.'
  ],
  [
    'Откуда берётся постоянный низкий гул (50/60 Гц) или высокочастотный писк?',
    'Низкий гул на частоте 50 или 60 Гц — это электромагнитная наводка от электросети или земляная петля. Отодвиньте провод микрофона от блоков питания и сетевых проводов. Высокочастотный свист чаще всего вызван помехами по шине USB: переключите микрофон в другой USB-порт на задней панели материнской платы.'
  ],
  [
    'Почему мой голос в записи звучит непривычно?',
    'При разговоре вы слышите свой голос не только через воздух, но и через костную проводимость черепа, усиливающую низкие частоты. Микрофон записывает только воздушные колебания — именно так ваш голос звучит для всех остальных собеседников. Это абсолютно естественно.'
  ],
  [
    'Может ли сайт записывать микрофон втайне от пользователя?',
    'Нет. Современные браузеры блокируют любой доступ к Web Audio API без явного подтверждения пользователя во всплывающем окне, а во время работы микрофона отображается постоянный индикатор записи. Захваченное аудио обрабатывается исключительно локально в оперативной памяти браузера и никуда не передаётся.'
  ]
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#webapp`,
    name: 'Бесплатная онлайн-проверка микрофона и диагностика звука FreeIQExam',
    url: canonicalUrl,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'All',
    browserRequirements: 'Требуется поддержка Web Audio API, защищённое соединение HTTPS и разрешение на микрофон',
    description: 'Браузерная диагностика микрофона с визуализацией частотного спектра FFT в реальном времени, измерением уровней Peak и RMS dBFS, анализом шума помещения и мгновенным воспроизведением записи.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    featureList: [
      'Спектроанализатор частот FFT 60 FPS в реальном времени',
      'Индикатор пикового и среднеквадратичного уровня от -60 dBFS до 0 dBFS',
      'Замер фонового шума помещения и оценка соотношения сигнал/шум (SNR)',
      'Индикатор цифрового клиппинга и искажений перегрузки',
      '5-секундный буфер мгновенного прослушивания собственного голоса',
      'Определение аппаратных характеристик: частота дискретизации, каналы, задержка',
      'Переключатели эхоподавления, шумоподавления и авторегулировки уровня'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://freeiqexam.com/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Инструменты', item: 'https://freeiqexam.com/ru/tools' },
      { '@type': 'ListItem', position: 3, name: 'Проверка микрофона', item: canonicalUrl }
    ]
  }
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} enPath="/mic-test" idPath="/tes-mikrofon" schema={schemas}>
  <Header currentPath="/mic-test" enPath="/mic-test" idPath="/id/tes-mikrofon" />

  <main id="assessment-page-content" class="flex-1 bg-white text-zinc-950 dark:bg-black dark:text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <nav aria-label="Хлебные крошки" class="mb-8 flex flex-wrap items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-400">
        <a href="/ru/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Главная</a><span aria-hidden="true">/</span>
        <a href="/ru/tools" class="hover:text-[#0066cc] dark:hover:text-[#2997ff]">Инструменты</a><span aria-hidden="true">/</span>
        <span aria-current="page" class="text-zinc-950 dark:text-white">Проверка микрофона</span>
      </nav>

      <header class="mb-12 max-w-3xl">
        <p class="eyebrow relative mb-4 text-[13px] font-mono font-semibold uppercase tracking-[0.18em] text-[#0066cc] dark:text-[#2997ff]">
          Диагностика аудиовхода
        </p>
        <h1 class="text-4xl font-extrabold leading-[1.08] tracking-[-0.025em] sm:text-5xl md:text-6xl">
          Проверка микрофона онлайн и тест качества звука
        </h1>
        <p class="mt-6 text-[17px] leading-[1.62] text-zinc-600 dark:text-zinc-400">
          Оцените реальное качество захвата вашего микрофона: спектрограмма частот в реальном времени,
          калиброванный пиковый и RMS-измеритель, уровень фонового шума комнаты, соотношение сигнал/шум (SNR)
          и мгновенное воспроизведение последних 5 секунд. Работает локально в браузере без передачи звука в сеть.
        </p>
      </header>

      <div id="mic-app" class="mic-shell">
        <!-- Unsupported / insecure context -->
        <div id="mic-unsupported" class="notice notice-bad" hidden>
          <h2 class="notice-title">Этот браузер не поддерживает тестирование микрофона</h2>
          <p id="mic-unsupported-reason" class="notice-body"></p>
        </div>

        <div id="mic-controls">
          <!-- Error panel -->
          <div id="mic-error" class="notice notice-bad" hidden>
            <h2 class="notice-title">Не удалось получить доступ к микрофону</h2>
            <p id="mic-error-message" class="notice-body"></p>
          </div>

          <!-- Transport -->
          <section class="mic-panel" aria-labelledby="mic-transport-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Step 1</p>
                <h2 id="mic-transport-title" class="panel-title">Open your microphone</h2>
              </div>
              <span id="clip-indicator" class="clip-indicator">CLIP</span>
            </div>

            <p class="panel-help">
              Your browser will ask for permission. Audio is analysed in memory on this device and
              is never uploaded.
            </p>

            <div class="transport-row">
              <button id="mic-start" type="button" class="btn btn-primary">Start microphone</button>
              <button id="mic-stop" type="button" class="btn btn-ghost" disabled>Stop</button>
            </div>

            <div class="field-grid">
              <label class="field" for="mic-device">
                <span class="field-label">Input device</span>
                <select id="mic-device" class="field-control">
                  <option value="">Start the microphone to list devices</option>
                </select>
              </label>
            </div>

            <fieldset class="dsp-fieldset">
              <legend class="field-label">Input processing &mdash; off by default for raw measurement</legend>
              <div class="dsp-row">
                <label class="toggle" for="dsp-echoCancellation">
                  <input id="dsp-echoCancellation" type="checkbox" />
                  <span>Echo cancellation</span>
                </label>
                <label class="toggle" for="dsp-noiseSuppression">
                  <input id="dsp-noiseSuppression" type="checkbox" />
                  <span>Noise suppression</span>
                </label>
                <label class="toggle" for="dsp-autoGainControl">
                  <input id="dsp-autoGainControl" type="checkbox" />
                  <span>Auto gain control</span>
                </label>
              </div>
            </fieldset>

            <p id="mic-live" class="sr-only" role="status" aria-live="polite"></p>
          </section>

          <!-- Hardware -->
          <section class="mic-panel" aria-labelledby="mic-hw-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Hardware</p>
                <h2 id="mic-hw-title" class="panel-title">Input capabilities</h2>
              </div>
            </div>
            <dl class="hw-grid">
              <div class="hw-item">
                <dt class="hw-label">Active device</dt>
                <dd id="hw-device" class="hw-value hw-value-text">--</dd>
              </div>
              <div class="hw-item">
                <dt class="hw-label">Sample rate</dt>
                <dd id="hw-rate" class="hw-value">--</dd>
              </div>
              <div class="hw-item">
                <dt class="hw-label">Channels</dt>
                <dd id="hw-channels" class="hw-value">--</dd>
              </div>
              <div class="hw-item">
                <dt class="hw-label">Round-trip latency</dt>
                <dd id="hw-latency" class="hw-value">--</dd>
              </div>
              <div class="hw-item">
                <dt class="hw-label">Capture buffer</dt>
                <dd id="hw-capture" class="hw-value hw-value-text">--</dd>
              </div>
              <div class="hw-item">
                <dt class="hw-label">Processing applied</dt>
                <dd id="hw-dsp" class="hw-value hw-value-text">--</dd>
              </div>
            </dl>
          </section>

          <!-- Level meter -->
          <section class="mic-panel" aria-labelledby="mic-meter-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Step 2</p>
                <h2 id="mic-meter-title" class="panel-title">Volume meter</h2>
              </div>
              <div class="readout-pair">
                <div class="readout">
                  <span class="readout-label">RMS</span>
                  <span class="readout-value"><span id="meter-rms">--</span><span class="readout-unit">dBFS</span></span>
                </div>
                <div class="readout">
                  <span class="readout-label">Peak</span>
                  <span class="readout-value"><span id="meter-peak">--</span><span class="readout-unit">dBFS</span></span>
                </div>
              </div>
            </div>

            <div class="meter-track" role="img" aria-label="Live input level from minus 60 to 0 dBFS">
              <div id="meter-fill" class="meter-fill"></div>
              <div id="meter-peak-marker" class="meter-peak-marker"></div>
            </div>
            <div class="meter-ticks" aria-hidden="true">
              <span>&minus;60</span><span>&minus;48</span><span>&minus;36</span><span>&minus;24</span><span>&minus;12</span><span>0</span>
            </div>

            <p class="panel-help">
              Aim for speech peaks between &minus;12 and &minus;6 dBFS. The white marker is peak-hold,
              which falls back slowly so short transients stay readable.
            </p>
          </section>

          <!-- Spectrum -->
          <section class="mic-panel" aria-labelledby="mic-spectrum-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Step 3</p>
                <h2 id="mic-spectrum-title" class="panel-title">Frequency spectrum</h2>
              </div>
            </div>
            <p class="panel-help">
              Log-spaced from 20&nbsp;Hz to 20&nbsp;kHz. Rumble lives at the left, vocal fundamentals
              and body in the middle, and the consonants that carry intelligibility on the right.
            </p>
            <div class="spectrum-wrap">
              <canvas id="spectrum-canvas" class="spectrum-canvas" role="img" aria-label="Real-time frequency spectrum from 20 hertz to 20 kilohertz"></canvas>
            </div>
            <ul class="band-legend">
              <li><span class="band-swatch" style="background:#8b5cf6"></span>Rumble 20&ndash;150&nbsp;Hz</li>
              <li><span class="band-swatch" style="background:#6366f1"></span>Fundamentals 150&ndash;500&nbsp;Hz</li>
              <li><span class="band-swatch" style="background:#38bdf8"></span>Body 500&nbsp;Hz&ndash;2&nbsp;kHz</li>
              <li><span class="band-swatch" style="background:#10b981"></span>Clarity 2&ndash;6&nbsp;kHz</li>
              <li><span class="band-swatch" style="background:#a78bfa"></span>Air 6&ndash;16&nbsp;kHz</li>
            </ul>
          </section>

          <!-- Diagnostics -->
          <section class="mic-panel" aria-labelledby="mic-diag-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Live diagnosis</p>
                <h2 id="mic-diag-title" class="panel-title">Signal health</h2>
              </div>
            </div>
            <dl class="diag-list">
              <div class="diag-row">
                <dt class="diag-label">Input level</dt>
                <dd id="diag-level" class="diag-value neutral">Silent</dd>
              </div>
              <div class="diag-row">
                <dt class="diag-label">Clipping</dt>
                <dd id="diag-clipping" class="diag-value neutral">Not started</dd>
              </div>
              <div class="diag-row">
                <dt class="diag-label">Ambience</dt>
                <dd id="diag-noise" class="diag-value neutral">Not started</dd>
              </div>
              <div class="diag-row">
                <dt class="diag-label">Voice clarity</dt>
                <dd id="diag-clarity" class="diag-value neutral">Not started</dd>
              </div>
            </dl>
          </section>

          <!-- SNR -->
          <section class="mic-panel" aria-labelledby="mic-snr-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Шаг 4</p>
                <h2 id="mic-snr-title" class="panel-title">Уровень шума помещения и отношение сигнал/шум</h2>
              </div>
              <span id="snr-badge" class="result-badge neutral">Измерение</span>
            </div>

            <p class="panel-help">
              Побудьте в тишине 3 секунды для фиксации фонового шума комнаты, затем говорите в обычном темпе. Соотношение между речью и шумом определяет чистоту звука при звонках.
            </p>

            <dl class="analysis-grid">
              <div class="analysis-item">
                <dt class="analysis-label">Уровень шума</dt>
                <dd id="analysis-floor" class="analysis-value">--</dd>
              </div>
              <div class="analysis-item">
                <dt class="analysis-label">Пик речи</dt>
                <dd id="analysis-speech" class="analysis-value">--</dd>
              </div>
              <div class="analysis-item analysis-item-accent">
                <dt class="analysis-label">Сигнал/шум</dt>
                <dd id="analysis-snr" class="analysis-value">--</dd>
              </div>
            </dl>

            <div class="noise-row">
              <button id="noise-capture" type="button" class="btn btn-ghost">Замерить тишину комнаты</button>
              <button id="noise-reset" type="button" class="btn btn-quiet" hidden>Перекалибровать</button>
              <span id="noise-status" class="noise-status">Ещё не измерено.</span>
            </div>
            <div class="noise-progress-track" aria-hidden="true">
              <div id="noise-progress" class="noise-progress"></div>
            </div>

            <p id="snr-note" class="panel-help">
              Говорите несколько секунд: индикатор рассчитает соотношение сигнал/шум, как только в окне анализа появятся и речь, и пауза.
            </p>
          </section>

          <!-- Loopback -->
          <section class="mic-panel" aria-labelledby="mic-loop-title">
            <div class="panel-head">
              <div>
                <p class="panel-eyebrow">Шаг 5</p>
                <h2 id="mic-loop-title" class="panel-title">Послушайте, как вас слышат другие</h2>
              </div>
            </div>
            <p class="panel-help">
              Движок сохраняет последние 5 секунд исходного аудио в оперативной памяти. Воспроизведение проигрывает звук моментально без сжатия и без отправки на сервер.
            </p>
            <div class="transport-row">
              <button id="mic-playback" type="button" class="btn btn-primary" disabled>Воспроизвести последние 5 секунд</button>
              <button id="mic-clear" type="button" class="btn btn-quiet">Очистить буфер</button>
            </div>
            <p id="playback-status" class="panel-help">Запись пока не начата.</p>
          </section>
        </div>
      </div>

            <!-- ============================ GUIDE ============================ -->
      <article class="guide">
        <header class="guide-head">
          <p class="eyebrow text-[13px] font-semibold uppercase tracking-[0.18em] text-[#0066cc] dark:text-[#2997ff]">Руководство по звукорежиссуре</p>
          <h2 class="guide-title">Физика микрофонов, диаграммы направленности и гейн-стейджинг</h2>
          <p class="guide-standfirst">
            Практическое руководство по физике преобразователей, диаграммам направленности, согласованию уровней громкости (gain staging), устранению помех и настройке параметров для кристально чистого звука при звонках и стриминге.
          </p>
        </header>

        <section class="space-y-4">
          <h3>1. Физика преобразователей: динамические и конденсаторные капсюли</h3>
          <p>
            Любой микрофон является <strong>преобразователем</strong> — устройством, трансформирующим акустические колебания давления воздуха в электрический сигнал. В звукозаписи и коммуникациях доминируют две принципиальные конструкции:
          </p>
          <p>
            <strong>Динамические микрофоны:</strong> Используют тонкую мембрану, соединённую с катушкой индуктивности внутри постоянного магнитного поля. Звуковые волны колеблют мембрану, порождая электрический ток. Относительно большая подвижная масса делает мембрану инертной, что является естественным преимуществом: капсюль сглаживает резкие пики и взрывные согласные без клиппинга. Динамические микрофоны пассивны, долговечны и идеально подходят для шумных необработанных комнат.
          </p>
          <p>
            <strong>Конденсаторные микрофоны:</strong> Состоят из ультратонкой позолоченной мембраны, натянутой параллельно неподвижному электроду (backplate) и образующей конденсатор. Ничтожная масса позволяет мембране мгновенно реагировать на микродинамику и высокочастотные детали до 20 кГц. Однако высокая чувствительность означает, что микрофон зафиксирует любые акустические недостатки комнаты, включая эхо от голых стен.
          </p>
        </section>

        <section class="space-y-4">
          <h3>2. Диаграммы направленности и эффект близости (Proximity Effect)</h3>
          <p>
            Диаграмма направленности определяет чувствительность микрофона к звукам под разными углами:
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Кардиоидная (Cardioid):</strong> Максимальная чувствительность спереди и подавление звука сзади. Золотой стандарт для рабочих созвонов, подкастов и стриминга.</li>
            <li><strong>Круговая (Omnidirectional):</strong> Равномерный захват звука со всех 360 градусов.</li>
            <li><strong>Восьмёрка (Figure-8):</strong> Одинаково чувствительна спереди и сзади, полностью отсекая боковые звуки.</li>
          </ul>
          <p>
            <strong>Эффект близости (Proximity Effect):</strong> Свойство направленных микрофонов увеличивать низкие частоты (бас) по мере приближения источника звука к капсюлю. На расстоянии 5 см голос приобретает бархатный «радийный» тембр, однако при чрезмерном приближении звук становится гулким. Оптимальное расстояние до рта составляет 10–15 см.
          </p>
        </section>

        <section class="space-y-4">
          <h3>3. Согласование уровней (Gain Staging) и предел 0 dBFS</h3>
          <p>
            В цифровом аудио абсолютным потолком амплитуды является <strong>0 dBFS (Decibels relative to Full Scale)</strong>. В отличие от аналоговой техники, создающей мягкий овердрайв, цифровой аналого-цифровой преобразователь (АЦП) при превышении 0 dBFS просто обрезает верхушки волны (Hard Clipping), вызывая неприятный резкий скрежет.
          </p>
          <p>
            Оптимальный диапазон громкости для речи: пиковые значения (Peak) в районе <strong>от -12 до -6 dBFS</strong>, а средняя плотность (RMS) около <strong>-18 dBFS</strong>. Это обеспечивает запас в 6–12 дБ (headroom) для эмоциональных всплесков и смеха без риска искажений.
          </p>
        </section>

        <section class="space-y-4">
          <h3>4. Устранение сетевого гула (Hum), шипения (Hiss) и взрывных звуков (Pops)</h3>
          <p>
            <strong>Сетевой гул (50/60 Гц):</strong> Вызывается электромагнитными наводками от сетевых кабелей или земляной петлей. Отодвиньте аудиокабель от блоков питания и сетевых фильтров.
          </p>
          <p>
            <strong>Шипение (Hiss):</strong> Высокочастотный шум предусилителя или помехи по питанию USB. Используйте качественные экранированные провода и подключайте микрофон напрямую к разъемам на материнской плате, избегая дешевых USB-хабов.
          </p>
          <p>
            <strong>Взрывные звуки (Pops):</strong> Удары воздуха от согласных «П», «Б», «Т». Используйте поп-фильтр или ветрозащиту и располагайте микрофон чуть сбоку от линии дыхания.
          </p>
        </section>

        <section class="space-y-4">
          <h3>5. Настройка параметров в Discord, Zoom и OBS Studio</h3>
          <p>
            В <strong>Discord</strong> выберите микрофон явно в меню «Голос и видео» вместо «По умолчанию». Отключите автоматическую регулировку усиления, если громкость уже настроена в системе. В <strong>Zoom</strong> активируйте функцию «Исходный звук для музыкантов», чтобы отключить агрессивное сжатие речи. В <strong>OBS Studio</strong> настройте цепочку фильтров: подавление шума (RNNoise), трёхполосный эквалайзер и лимитер на -2 dBFS.
          </p>
        </section>

        <section class="space-y-4">
          <h3>6. Показатели Peak, RMS и соотношение сигнал/шум (SNR)</h3>
          <p>
            <strong>Peak vs RMS:</strong> Пиковый уровень отражает мгновенный максимум волны, а RMS — среднюю воспринимаемую громкость. Разница между ними показывает динамический диапазон вашего голоса.
          </p>
          <p>
            <strong>Шумовая полка (Noise Floor):</strong> Уровень звука в комнате при молчании. В тихой жилой комнате он составляет от -60 до -50 dBFS.
          </p>
          <p>
            <strong>Соотношение сигнал/шум (SNR):</strong> Разница между громкостью речи и шумом покоя. Значение выше 35 дБ обеспечивает безупречную чистоту голоса при любых онлайн-конференциях.
          </p>
        </section>
      </article>

      <!-- ============================ FAQ ============================ -->
      <section class="faq" aria-labelledby="faq-title">
