    }
    .readout-unit { font-size: 13px; font-weight: 600; margin-left: 0.25rem; color: rgb(113 113 122); font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, monospace; }

    .meter-track {
      position: relative;
      height: 1.35rem;
      margin-top: 1.25rem;
      border-radius: 999px;
      overflow: hidden;
      /* The gradient is mapped to dB, not to pixel position: green runs to
         -24 dBFS, amber to -12, red for the last 12 dB before the ceiling. */
      background: linear-gradient(
        90deg,
        rgb(16 185 129) 0%,
        rgb(16 185 129) 58%,
        rgb(245 158 11) 62%,
        rgb(245 158 11) 78%,
        rgb(239 68 68) 82%,
        rgb(239 68 68) 100%
      );
      opacity: 0.95;
    }
    /* The gradient lives on the track and is anchored to the full -60..0
       scale, so a lit segment always carries the colour that belongs to its
       own dB position. The fill therefore masks the *unlit* remainder from
       the right edge; the engine sets its width to (100 - level). */
    .meter-fill {
      position: absolute;
      inset: 0 0 0 auto;
      width: 100%;
      background: rgb(228 228 231);
      transition: width 0.06s linear;
    }
    .meter-track::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 12px);
      pointer-events: none;
    }
    .dark .meter-track::after {
      background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px 12px);
    }
    .meter-peak-marker {
      position: absolute;
      top: -2px;
      bottom: -2px;
      left: 0%;
      width: 3px;
      border-radius: 2px;
      background: #ffffff;
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.45);
      transition: left 0.08s linear;
      pointer-events: none;
    }
    .meter-ticks {
      display: flex;
      justify-content: space-between;
      margin-top: 0.45rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      font-weight: 600;
      color: rgb(113 113 122);
    }

    .clip-indicator {
