---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Практический центр: задания на IQ с разборами — бесплатно | FreeIQExam";
const description = "Тренируйте подвижный интеллект, пространственное и количественное мышление, вербальное понимание: задания с пошаговыми разборами, без регистрации.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Cognitive Практический центр",
    "url": "https://freeiqexam.com/ru/practice/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "description": "Интерактивная платформа когнитивных тренировок: практика без времени и пошаговые разборы решений в 4 доменах интеллекта CHC.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Практический центр",
        "item": "https://freeiqexam.com/ru/practice/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Чем отличаются тесты на время от неторопливых тренировочных заданий?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Тесты на время имитируют стандартные условия экзамена с лимитом 15 минут и измеряют скорость работы. Неторопливые тренировочные задания дают разбор решения сразу после каждого вопроса, чтобы вы могли в своём темпе изучить лежащие в основе правила преобразований."
        }
      },
      {
        "@type": "Question",
        "name": "Каковы 5 правил Карпентера для матричного мышления?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Карпентер, Джаст и Шелл (1990) выделили 5 основных алгоритмов преобразований в прогрессивных матрицах: постоянство в строке, количественная прогрессия, распределение трёх значений, распределение двух значений (погашение по XOR) и вращательное движение."
        }
      },
      {
        "@type": "Question",
        "name": "Могут ли когнитивные тренировки повысить мой официальный балл IQ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Тренировки повышают знакомство с тестом, снижают тревожность и формируют схемы распознавания правил преобразований. Хотя врождённые способности подвижного интеллекта во многом наследуются, устранение процедурных ошибок и ловушек-дистракторов часто даёт прирост измеряемого балла на 5–10 пунктов."
        }
      },
      {
        "@type": "Question",
        "name": "Проверяют ли общества высокого IQ те же типы заданий?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Да. Общества высокого IQ, такие как Mensa, Intertel и Triple Nine, используют стандартизированные батареи (например, WAIS-IV, Stanford-Binet, Cattell Culture Fair и Raven APM), где широко представлены индукция матриц, ментальное вращение, числовые ряды и вербальные аналогии."
        }
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/practice" idPath="/latihan" canonicalUrl="https://freeiqexam.com/ru/practice">
  <Header currentPath="/practice"  enPath="/practice" idPath="/latihan"/>

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-14 max-w-6xl">
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-4">
        <span>ЦЕНТР КОГНИТИВНЫХ ТРЕНИРОВОК &bull; ПРАКТИКА БЕЗ ВРЕМЕНИ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тренируйте когнитивные способности — бесплатные задания по доменам
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Развивайте дедуктивную скорость, ментальное вращение и логическое мышление. Выбирайте неторопливые тренировки с мгновенными пошаговыми решениями или полные стандартизированные тесты категорий на 15 минут.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">4 когнитивных домена CHC</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Мгновенные разборы решений</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Без регистрации</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">100% бесплатно и приватно</span>
      </div>
    </header>

    <!-- 4 Interactive Domain Cards -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-heading font-bold text-2xl sm:text-3xl text-zinc-950 dark:text-white">
            Специализированные тренировки по доменам
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Сфокусируйте практику на отдельной когнитивной способности.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- 1. Fluid Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
                Gf &bull; Подвижный интеллект
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 вопросов</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Матрицы и индукция закономерностей
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Освойте правила матриц 2×2 и 3×3, латинские перестановки, топологические ряды и булево погашение признаков по XOR. Полностью невербально и без культурного смещения.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Правила Карпентера</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Топологические ряды</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Логика XOR</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/ru/fluid-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Тренировка без времени</span>
            </a>
            <a
              href="/ru/fluid-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Тест на время (15 мин)
            </a>
          </div>
        </div>

        <!-- 2. Visual-Spatial Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
                Gv &bull; Пространственное мышление
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 вопросов</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Вращение куба 3D и развёртки
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Тренируйте ментальное вращение вокруг трёх осей, мысленно складывайте плоские развёртки в кубы и выводите ортографические проекции. Необходимо для инженерии и пространственного мышления.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Вращение Шепарда — Метцлер</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Развёртки куба</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Правило противоположных граней</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/ru/spatial-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Тренировка без времени</span>
            </a>
            <a
              href="/ru/spatial-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Тест на время (15 мин)
            </a>
          </div>
        </div>

        <!-- 3. Quantitative Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
                Gq &bull; Количественное мышление
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 вопросов</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Числовые ряды и арифметическая логика
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Решайте последовательности со вторыми разностями, чередующиеся переплетённые прогрессии и многошаговые задачи на доли и скорости. Чистая дедуктивная математическая логика без высшей математики.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Высшие разности</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Переплетённые ряды</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Пропорциональная логика</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/ru/quantitative-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Тренировка без времени</span>
            </a>
            <a
              href="/ru/quantitative-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Тест на время (15 мин)
            </a>
          </div>
        </div>

        <!-- 4. Verbal Reasoning Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs flex flex-col justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80">
                Gc &bull; Вербальное понимание
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">16 вопросов</span>
            </div>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white mb-2">
              Аналогии и дедуктивные силлогизмы
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
              Оттачивайте формирование вербальных понятий: реляционные аналогии (A : B :: C : ?), формальные аристотелевские силлогизмы и логику включения в категории.
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Формальные силлогизмы</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Реляционные аналогии</span>
              <span class="px-2 py-0.5 rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Категориальная логика</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-3 pt-4 border-t border-zinc-200/60 dark:border-zinc-800">
            <a
              href="/ru/verbal-reasoning-test?mode=practice"
              class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors text-center flex items-center justify-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
              <span>Тренировка без времени</span>
            </a>
            <a
              href="/ru/verbal-reasoning-test"
              class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 transition-colors text-center"
            >
              Тест на время (15 мин)
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Dual Full Track Callouts -->
    <section class="p-6 sm:p-10 rounded-3xl bg-zinc-900 border border-zinc-800 text-white">
      <div class="max-w-3xl mb-8">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-xs font-mono font-semibold text-zinc-300 uppercase tracking-wider mb-3">
          КОМПЛЕКСНАЯ МУЛЬТИДОМЕННАЯ ОЦЕНКА
        </span>
        <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-white">
          Готовы к сертифицированному композитному баллу?
        </h2>
        <p class="text-sm sm:text-base text-zinc-400 mt-2 leading-relaxed">
          Тренировки по доменам изолируют отдельные способности, а клинический балл IQ требует композитной выборки по всем четырём факторам CHC для точной оценки общего фактора (g).
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- Quick Screener -->
        <div class="p-6 rounded-2xl bg-zinc-800/60 border border-zinc-700/60 backdrop-blur-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-400 font-semibold mb-1 uppercase tracking-wider">Option A</div>
            <h3 class="font-heading font-bold text-xl text-white mb-2">
              Quick 10-Min Screening
            </h3>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-6">
              12 questions (3 from each of the 4 domains). Fast, streamlined assessment providing an immediate provisional IQ score and percentile ranking.
            </p>
          </div>
          <a
            href="/ru/quick-test"
            class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-zinc-950 bg-white hover:bg-zinc-100 transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Start Экспресс-тест (10 мин)</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
