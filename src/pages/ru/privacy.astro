---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Политика конфиденциальности | FreeIQExam";
const description = "Оценка выполняется локально в вашем браузере: мы не собираем ответы и персональные данные. Подробности — в политике конфиденциальности.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Политика конфиденциальности - FreeIQExam",
    "url": "https://freeiqexam.com/ru/privacy/",
    "description": "Ознакомьтесь с нашей политикой конфиденциальности. FreeIQExam обрабатывает ответы локально в вашем браузере без обязательной учётной записи, без сбора почты и с прозрачным хранением данных."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Политика конфиденциальности",
        "item": "https://freeiqexam.com/ru/privacy/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/privacy" idPath="/kebijakan-privasi" canonicalUrl="https://freeiqexam.com/ru/privacy">
  <Header currentPath="/privacy"  enPath="/privacy" idPath="/kebijakan-privasi"/>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Политика конфиденциальности</span>
    </nav>
    
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-3">
        <span>ОБРАБОТКА НА УСТРОЙСТВЕ &bull; КОНФИДЕНЦИАЛЬНОСТЬ ПО УМОЛЧАНИЮ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight">
        Политика конфиденциальности и защита данных
      </h1>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-2">
        Последнее обновление: сентябрь 2026 г. &bull; Вступает в силу немедленно
      </p>
    </header>

    <article class="prose prose-zinc dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-6">
      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          1. Архитектура обработки на устройстве
        </h2>
        <p>
          В FreeIQExam.com мы уважаем ваше фундаментальное право на цифровую приватность. В отличие от обычных платформ тестирования, хранящих ответы на центральных серверах, <strong>все алгоритмы подсчёта когнитивных баллов, латентные оценки способностей по модели 2PL IRT и переводы в нормативные процентили выполняются на 100% локально в вашем браузере</strong>.
        </p>
        <p>
          Ваши ответы на отдельные задания, векторы ответов и рассчитанные психометрические баллы обрабатываются строго на вашем устройстве и никогда не продаются, не передаются в обмен и не отправляются в централизованные базы профилирования.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          2. Использование локального хранилища
        </h2>
        <p>
          Мы используем стандартное локальное хранилище HTML5 (localStorage) исключительно для вашего удобства во время прохождения теста:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>freeiq_active_session / freeiq_quick_session:</strong> временно хранят ваши ответы и оставшиеся секунды таймера, чтобы прогресс сохранялся при случайном обновлении страницы.</li>
          <li><strong>iq_assessment_result / iq_review_data:</strong> локально хранят итоговую сводку баллов и данные разбора вопросов, чтобы страница результатов могла показать психометрический отчёт без повторной загрузки банков заданий.</li>
          <li><strong>theme:</strong> запоминает выбранную светлую или тёмную тему оформления.</li>
        </ul>
        <p class="mt-2">
          Вы можете удалить эти данные в любой момент, просто очистив данные сайта в браузере или нажав «Пройти тест заново».
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          3. Мы не собираем персональные данные
        </h2>
        <p>
          Мы не требуем, не собираем и не храним ваше имя, адрес электронной почты, почтовый адрес, номер телефона, имена в социальных сетях или платёжные данные. Вы можете пройти любой тест и увидеть полный результат без указания личных данных.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          4. Реклама третьих лиц и файлы cookie
        </h2>
        <p>
          Чтобы поддерживать разработку банка психометрических заданий, надёжную хостинговую инфраструктуру и бесплатный доступ без платных экранов и обязательных учётных записей, FreeIQExam.com сотрудничает с рекламными сетями третьих лиц, включая <strong>Google AdSense</strong>.
        </p>
        <p>
          Google и другие сторонние поставщики используют файлы cookie, веб-маяки и уникальные идентификаторы для показа рекламы на этом сайте на основе предыдущих посещений. В частности:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong>Рекламные cookie:</strong> Использование Google рекламных cookie позволяет ей и её партнёрам показывать пользователям релевантную рекламу на основе посещений FreeIQExam.com и/или других сайтов в интернете.
          </li>
          <li>
            <strong>Отказ от персонализированной рекламы:</strong> Вы можете отказаться от персонализированной рекламы, посетив <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 font-semibold underline">настройки рекламы Google (https://adssettings.google.com)</a>. Кроме того, вы можете отказаться от cookie сторонних поставщиков для персонализированной рекламы на странице <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 font-semibold underline">www.aboutads.info (https://www.aboutads.info)</a>.
          </li>
          <li>
            <strong>Управление согласием (GDPR и ePrivacy):</strong> Для пользователей из Европейской экономической зоны (ЕЭЗ), Великобритании или Швейцарии используется платформа управления согласием (CMP) для получения детального согласия на рекламные cookie и измерения в соответствии с GDPR и директивой ePrivacy.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          5. Права на конфиденциальность по CCPA / CPRA и GDPR
        </h2>
        <p>
          В соответствии с Законом Калифорнии о конфиденциальности потребителей (CCPA), Законом Калифорнии о правах на приватность (CPRA) и Общим регламентом ЕС о защите данных (GDPR):
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li><strong>Полный запрет на продажу данных тестирования:</strong> Мы подтверждаем, что FreeIQExam не продаёт, не сдаёт в аренду, не лицензирует и не передаёт в обмен ответы пользователей и когнитивные баллы брокерам данных или сторонним маркетологам.</li>
          <li><strong>Право на отказ:</strong> Жители Калифорнии и юрисдикций с применимым законодательством о конфиденциальности вправе отказаться от продажи или передачи личных данных для кросс-контекстной поведенческой рекламы через ссылки для отказа выше или сигналы Global Privacy Control (GPC) в браузере.</li>
          <li><strong>Право на удаление:</strong> Поскольку ответы на тесты хранятся локально в вашем браузере, вы полностью распоряжаетесь своими данными и можете мгновенно удалить все записи, очистив локальное хранилище или файлы cookie браузера.</li>
        </ul>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          6. Контакты по вопросам конфиденциальности
        </h2>
        <p>
          Если у вас есть вопросы о принципах обработки данных или раскрытии информации о согласии на cookie, свяжитесь с нашим ответственным за конфиденциальность по адресу <a href="mailto:privacy@freeiqexam.com" class="text-blue-600 dark:text-blue-400 font-semibold underline">privacy@freeiqexam.com</a>.
        </p>
      </section>
    </article>

  </main>

  <Footer />
</Layout>
