---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';
import CategoryTestRunner from '../../components/ru/CategoryTestRunnerRu.astro';

const title = "Математический тест на логику и числовой интеллект (Gq) | FreeIQExam";
const description = "Пройдите математический тест на количественное мышление (Gq): 16 числовых заданий на ряды и арифметическую логику. Бесплатная психометрическая оценка.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "name": "Тест количественного мышления (Gq): когнитивные способности",
    "description": "Специализированный тест количественного мышления из 16 заданий: индукция числовых рядов, реляционная арифметическая логика и решение числовых задач.",
    "url": "https://freeiqexam.com/ru/quantitative-reasoning-test",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Тест количественного мышления",
        "item": "https://freeiqexam.com/ru/quantitative-reasoning-test"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/quantitative-reasoning-test" idPath="/tes-kuantitatif" canonicalUrl="https://freeiqexam.com/ru/quantitative-reasoning-test">
  <Header currentPath="/quantitative-reasoning-test"  enPath="/quantitative-reasoning-test" idPath="/tes-kuantitatif"/>

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест количественного мышления</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>КОГНИТИВНЫЙ ФАКТОР CHC: Gq <span aria-hidden="true">&bull;</span> КОЛИЧЕСТВЕННОЕ МЫШЛЕНИЕ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тест количественного мышления (Gq)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Оцените математическую индукцию, расшифровку числовых закономерностей и дедуктивную арифметическую логику. Выберите режим теста на время или тренировку без времени с пошаговыми математическими разборами.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 заданий на числовую логику</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Таймер 15 минут (или без времени)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Нетривиальные алгоритмы рядов</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Калибровка 2PL IRT</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="quantitative"
      domainCode="Gq"
      domainTitle="Количественное мышление (Gq)"
      domainSubtitle="Индукция числовых рядов и реляционная арифметическая логика"
      domainDescription="Количественные знания и мышление (Gq) измеряют способность понимать количественные понятия, выводить числовые зависимости и логично оперировать математическими операторами. Это сильный предиктор аналитических способностей в STEM, количественных финансах и науке о данных."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Психометрика количественных знаний (Gq)
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          В модели Кеттелла — Хорна — Кэрролла Gq — это широкая когнитивная область, отличная и от подвижного интеллекта (Gf), и от кристаллизованного интеллекта (Gc). Хотя в ней используются математические символы, качественные тесты количественного мышления проверяют не высшую математику и не заученные факты, а способность выводить скрытые математические функции и рекуррентные зависимости.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Разности высших порядков
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Ряды, где непостоянны разности между соседними числами, но вторые разности (приросты приростов) образуют узнаваемую арифметическую или геометрическую прогрессию.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Двойные переплетённые последовательности
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Две разные математические последовательности, чередующиеся на нечётных и чётных позициях (например, нечётные члены умножаются на 2, чётные уменьшаются на 3).
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Многошаговая реляционная логика
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Пропорциональные словесные выводы, требующие перевода скоростей, относительных долей и ограничений на переменные без грубого перебора.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Тактика расшифровки числовых рядов
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Считайте первые и вторые разности:</strong> вычислите точную разность между соседними числами. Если первые разности не дают очевидного правила, изучите разность между самими разностями.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Проверяйте экспоненциальный рост и степени:</strong> если числа растут быстро, проверьте квадраты (n²), кубы (n³) или множители (x · 2 + 1, x · 3 − 2).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Проверяйте чередующиеся переплетения:</strong> если числа непредсказуемо скачут вверх-вниз, разделите ряд на две нити (индексы 1, 3, 5 и 2, 4, 6).</span>
          </li>
        </ul>
      </div>

      <!-- User-Facing FAQ Accordion -->
      <div class="space-y-4 pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Частые вопросы о количественном мышлении (Gq)
        </h3>
        <div class="space-y-3 pt-2">
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Чем тест количественного мышления отличается от экзамена по математике?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Экзамен по математике проверяет знание формул, тригонометрии и интегралов. Тест фактора Gq проверяет дедуктивную способность замечать алгоритмические закономерности между числами (арифметические прогрессии, разности второго порядка, геометрические ряды), требуя только базовых операций счета.
            </p>
          </details>
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Что делать, если числовой ряд кажется абсолютно хаотичным?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Вычислите разности между соседними числами. Если разности не образуют постоянный шаг, вычислите разности разностей (второй порядок). Также проверьте чередующиеся ряды (когда нечетные и четные позиции подчиняются двум независимым правилам).
            </p>
          </details>
        </div>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Другие специализированные когнитивные батареи
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/ru/fluid-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Подвижный интеллект (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Индукция матриц &rarr;</div>
          </a>
          <a
            href="/ru/spatial-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Пространственное мышление (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Ментальное вращение 3D &rarr;</div>
          </a>
          <a
            href="/ru/verbal-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Вербальное понимание (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Дедуктивные силлогизмы &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
