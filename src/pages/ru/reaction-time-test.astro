---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = 'Тест времени реакции онлайн - проверьте свои рефлексы (мс) | FreeIQExam';
const description =
  'Измерьте скорость зрительной реакции в миллисекундах с помощью бесплатного теста из пяти проб. Мгновенно получите среднее значение, оценку процентиля, личный рекорд и уровень рефлексов - без регистрации.';
const canonicalUrl = 'https://freeiqexam.com/ru/reaction-time-test';

const faqItems = [
  {
    name: 'Какой результат онлайн-теста времени реакции считается хорошим?',
    answer:
      'В простой зрительной задаче многие здоровые взрослые показывают результат около 250 миллисекунд, хотя точное значение зависит от методики, устройства и выборки. В FreeIQExam результаты ниже примерно 220 мс отображаются как более быстрые, чем эталонное распределение, используемое моделью процентилей, а очень низкие значения следует воспринимать как исключительную результативность, а не как клиническое измерение.'
  },
  {
    name: 'Почему на смартфоне моё время реакции значительно медленнее, чем на ПК?',
    answer:
      'Телефон может добавлять задержку через цикл обновления экрана, сенсорный дигитайзер, обработку в операционной системе, планирование браузера и конвейер от касания до отрисовки. Настольный компьютер с высокочастотным дисплеем и проводной мышью с низкой задержкой обычно имеет более короткий и предсказуемый путь ввода. Размер различия сильно зависит от устройства и браузера, поэтому универсального штрафа в 40–75 мс не существует.'
  },
  {
    name: 'Каков абсолютный биологический предел скорости реакции человека?',
    answer:
      'Единого универсального биологического предела нет, потому что время реакции зависит от сенсорной модальности, стимула, ответа и метода измерения. Простое слуховое время реакции в тренировочных или лабораторных условиях может быть близким к 150 мс или ниже, тогда как простая зрительная реакция обычно медленнее. Чрезвычайно короткие значения могут отражать предугадывание, артефакты измерения или совсем иное определение задачи.'
  },
  {
    name: 'Как время реакции профессиональных геймеров отличается от времени реакции неиграющих?',
    answer:
      'Соревновательные геймеры часто показывают более быстрые средние ответы в простых зрительных задачах, чем люди, которые не играют, но разрыв варьируется между исследованиями и задачами. Тренировка может улучшать внимание, зрительный поиск, выбор ответа и моторную подготовку; она не ускоряет проведение импульса по каждому нерву.'
  },
  {
    name: 'Почему человек реагирует на внезапный звук быстрее, чем на внезапный свет?',
    answer:
      'Слуховые сигналы обычно достигают осознания и запускают моторный ответ быстрее зрительных, потому что слуховая трансдукция и ранний нейронный путь для простых стимулов могут быть быстрее. Зрение добавляет фототрансдукцию в сетчатке и дополнительную корковую обработку до выбора моторного ответа.'
  },
  {
    name: 'Насколько игровой монитор 144 Гц или 240 Гц может улучшить мой результат?',
    answer:
      'Более высокая частота обновления сокращает время между доступными кадрами: около 16,67 мс при 60 Гц, 6,94 мс при 144 Гц и 4,17 мс при 240 Гц. Это уменьшает один компонент неопределённости предъявления, но не вычитает всю эту разницу из результата каждого пользователя, поскольку реальный конвейер включает рендеринг, вывод кадра, ввод и задержку операционной системы.'
  },
  {
    name: 'Какое время реакции считается нормальным в 50 лет?',
    answer:
      'Единого клинического порога нормального времени реакции в 50 лет не существует. Скорость реакции обычно меняется с возрастом постепенно, а результат здорового человека зависит от зрения, сна, лекарств, задержки устройства, практики и методики теста. Сравнивать свои повторные результаты в одинаковых условиях полезнее, чем воспринимать один интернет-ориентир как диагноз.'
  },
  {
    name: 'Можно ли натренировать и улучшить зрительное время реакции навсегда?',
    answer:
      'Да, некоторые компоненты результативности улучшаются с практикой, особенно внимание, обнаружение стимула, подготовка ответа и знакомство с задачей. Улучшения обычно специфичны для задачи и ограничены физиологией. Стабильный сон, физическая активность, хорошие условия освещения и повторная практика по одной и той же методике - более обоснованная стратегия, чем погоня за одним экстремальным результатом.'
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'Бесплатный тест времени зрительной реакции',
    url: canonicalUrl,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    browserRequirements:
      'Требуется поддержка JavaScript, Performance API, Pointer Events и HTML5',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    description:
      'Браузерный тест времени зрительной реакции из пяти проб, который сообщает скорость ответа в миллисекундах и модельную оценку популяционного процентиля.',
    isAccessibleForFree: true,
    inLanguage: 'ru',
    creator: {
      '@type': 'Organization',
      name: 'FreeIQExam',
      url: 'https://freeiqexam.com'
    },
    featureList: [
      'Пять калиброванных проб зрительной реакции',
      'Ввод мышью, касанием и с клавиатуры',
      'Хранение личного рекорда на стороне клиента',
      'Модельная оценка популяционного процентиля',
      'Необязательные синтезированные звуковые сигналы',
      'Отправка результата через буфер обмена'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Главная',
        item: 'https://freeiqexam.com/ru/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Когнитивные игры',
        item: 'https://freeiqexam.com/ru/games'
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Тест времени реакции',
        item: canonicalUrl
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    '@id': `${canonicalUrl}#quiz`,
    name: 'Тест времени зрительной реакции из пяти проб',
    url: canonicalUrl,
    description:
      'Простая задача на время реакции, в которой участник отвечает, когда арена меняет цвет с красного на зелёный.',
    numberOfQuestions: 5,
    isAccessibleForFree: true,
    inLanguage: 'ru',
    educationalAlignment: {
      '@type': 'AlignmentObject',
      alignmentType: 'educationalSubject',
      targetName:
        'Скорость восприятия и сенсомоторная задержка ответа'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.name,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  enPath="/reaction-time-test"
  idPath="/id/tes-waktu-reaksi"
  schema={schema}
>
  <Header currentPath="/reaction-time-test" enPath="/reaction-time-test" idPath="/id/tes-waktu-reaksi" />

  <style>
    .reaction-page {
      --reaction-border: #e4e4e7;
      --reaction-muted: #52525b;
      background: #ffffff;
    }

    .dark .reaction-page {
      --reaction-border: #27272a;
      --reaction-muted: #a1a1aa;
      background: #000000;
    }

    .reaction-arena {
      touch-action: manipulation;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
      transition:
        transform 90ms ease-out,
        background 120ms ease-out;
    }

    .reaction-arena:active {
      transform: scale(0.997);
    }

    .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #2563eb 0%,
          #1d4ed8 62%,
          #1e40af 100%
        );
    }

    .dark .state-start {
      background:
        radial-gradient(
          circle at 50% 25%,
          #1d4ed8 0%,
          #0f172a 70%,
          #09090b 100%
        );
    }

    .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #e11d48 0%,
          #be123c 62%,
          #9f1239 100%
        );
    }

    .dark .state-waiting {
      background:
        radial-gradient(
          circle at 50% 25%,
          #be123c 0%,
          #881337 68%,
          #4c0519 100%
        );
    }

    .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #059669 62%,
          #047857 100%
        );
    }

    .dark .state-active {
      background:
        radial-gradient(
          circle at 50% 25%,
          #10b981 0%,
          #047857 68%,
          #064e3b 100%
        );
    }

    .state-toosoon {
      background:
        radial-gradient(
          circle at 50% 25%,
          #f97316 0%,
          #ea580c 65%,
          #c2410c 100%
        );
    }

    .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #38bdf8 0%,
          #0284c7 65%,
          #0369a1 100%
        );
    }

    .dark .state-result {
      background:
        radial-gradient(
          circle at 50% 25%,
          #0ea5e9 0%,
          #0369a1 68%,
          #082f49 100%
        );
    }

    .state-summary {
      background: #fafafa;
    }

    .dark .state-summary {
      background: #09090b;
    }

    .summary-card {
      background: rgba(255, 255, 255, 0.97);
      border: 1px solid #e4e4e7;
      backdrop-filter: blur(16px);
    }

    .dark .summary-card {
      background: rgba(18, 18, 21, 0.97);
      border-color: #27272a;
    }

    .reaction-copy p {
      max-width: 75ch;
    }

    .reaction-copy table {
      min-width: 760px;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @keyframes reaction-shake {
      10%,
      90% {
        transform: translateX(-2px);
      }

      20%,
      80% {
        transform: translateX(4px);
      }

      30%,
      50%,
      70% {
        transform: translateX(-6px);
      }

      40%,
      60% {
        transform: translateX(6px);
      }
    }

    .animate-reaction-shake {
      animation:
        reaction-shake
        0.4s
        cubic-bezier(.36, .07, .19, .97)
        both;
    }

    .rt-hero-glow { position: absolute; inset-inline: -1rem; top: -2rem; height: 24rem; pointer-events: none; background: radial-gradient(circle at 50% 10%, rgba(0, 102, 204, 0.10) 0%, rgba(0, 102, 204, 0.03) 45%, transparent 70%); mask-image: linear-gradient(to bottom, black 55%, transparent 92%); -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 92%); }
    .dark .rt-hero-glow { background: radial-gradient(circle at 50% 10%, rgba(41, 151, 255, 0.12) 0%, rgba(0, 102, 204, 0.04) 45%, transparent 70%); }

    @media (prefers-reduced-motion: reduce) {
      .animate-reaction-shake {
        animation: none;
      }
      .rt-hero-glow { display: none; }
    }
  </style>

  <main
    id="main-content"
    class="reaction-page min-h-screen flex-1 w-full"
  >
    <div
      class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16"
    >
      <nav
        class="flex items-center gap-2 mb-8 text-[13px] sm:text-sm font-medium text-zinc-500 dark:text-zinc-400"
        aria-label="Хлебные крошки"
      >
        <a
          href="/ru/"
          class="hover:text-zinc-950 dark:hover:text-white transition-colors"
        >
          Главная
        </a>

        <span aria-hidden="true">/</span>

        <a
          href="/ru/games"
          class="hover:text-zinc-950 dark:hover:text-white transition-colors"
        >
          Когнитивные игры
        </a>

        <span aria-hidden="true">/</span>

        <span class="text-zinc-900 dark:text-zinc-100">
          Тест времени реакции
        </span>
      </nav>

      <header
        class="relative text-center max-w-3xl mx-auto mb-10 sm:mb-12"
      >
        <div class="rt-hero-glow" aria-hidden="true"></div>
        <div
          class="relative inline-flex items-center gap-2 rounded-full border border-zinc-300 bg-zinc-100 px-4 py-2 text-[13px] sm:text-sm font-mono font-semibold uppercase tracking-wider text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
        >
          <span
            class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"
            aria-hidden="true"
          ></span>

          <span>
            Скорость восприятия · Хронометрия Gs
          </span>
        </div>

        <h1
          class="mt-5 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-[-0.025em] leading-[1.08] text-zinc-950 dark:text-white"
        >
          Тест времени реакции онлайн
        </h1>

        <p
          class="mt-5 text-[17px] sm:text-lg leading-[1.62] text-zinc-600 dark:text-zinc-300"
        >
          Проверьте скорость зрительных рефлексов в миллисекундах. Дождитесь,
          пока красная арена станет зелёной, а затем кликните, коснитесь,
          нажмите пробел или Enter как можно быстрее. Пять зачётных проб дают
          среднее время реакции, модельную оценку процентиля, уровень рефлексов
          и проверку личного рекорда.
        </p>
      </header>

      <section
        aria-labelledby="arena-heading"
        class="max-w-3xl mx-auto"
      >
        <h2 id="arena-heading" class="sr-only">
          Интерактивный тест времени реакции
        </h2>

        <div
          class="flex items-center justify-between gap-4 px-1 mb-4 text-sm sm:text-base"
        >
          <div class="flex items-center gap-2">
            <span
              class="text-zinc-500 dark:text-zinc-400 font-medium"
            >
              ПРОБА
            </span>

            <strong
              id="hud-round-counter"
              class="text-zinc-950 dark:text-white"
            >
              0 / 5
            </strong>
          </div>

          <div
            class="flex items-center gap-3 sm:gap-5"
          >
            <div class="flex items-center gap-2">
              <span
                class="text-zinc-500 dark:text-zinc-400 font-medium"
              >
                РЕКОРД
              </span>

              <strong
                id="hud-personal-best"
                class="text-emerald-600 dark:text-emerald-400"
              >
                -
              </strong>
            </div>

            <button
              id="btn-sound-toggle"
              type="button"
              aria-pressed="false"
              aria-label="Отключить звуковые эффекты"
              class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 px-4 py-2.5 font-semibold text-zinc-800 dark:text-zinc-200 transition-smooth active:scale-[0.97]"
            >
              <span id="sound-icon" aria-hidden="true" class="inline-flex">
                <svg id="sound-icon-on" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
                <svg id="sound-icon-off" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><line x1="23" y1="9" x2="17" y2="15" /><line x1="17" y1="9" x2="23" y2="15" /></svg>
              </span>

              <span id="sound-label">
                Звук
              </span>
            </button>
          </div>
        </div>

        <div
          class="mb-4 flex items-center gap-2"
          aria-label="Прогресс проб"
        >
          <span
            id="pill-trial-1"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-2"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-3"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-4"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>

          <span
            id="pill-trial-5"
            class="h-2 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800"
          ></span>
        </div>

        <div
          id="reaction-box"
          role="button"
          tabindex="0"
          aria-label="Арена теста времени реакции. Кликните или коснитесь, когда арена станет зелёной."
          aria-busy="false"
          class="reaction-arena state-start relative min-h-[430px] sm:min-h-[500px] rounded-[2rem] overflow-hidden cursor-pointer focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/40 shadow-2xl"
        >
          <div
            class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_18%,rgba(255,255,255,.18),transparent_34%),radial-gradient(circle_at_50%_100%,rgba(0,0,0,.16),transparent_60%)]"
          ></div>

          <div
            id="content-start"
            class="relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg"
            >
              <svg
                class="w-10 h-10 sm:w-12 sm:h-12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                />
              </svg>
            </div>

            <div class="space-y-3 max-w-xl">
              <h3
                class="text-3xl sm:text-5xl font-extrabold tracking-tight"
              >
                Нажмите или коснитесь, чтобы начать
              </h3>

              <p
                class="text-base sm:text-lg leading-relaxed text-white/90"
              >
                Дождитесь зелёного. Затем реагируйте немедленно.
                Преждевременные нажатия не засчитываются в пять зачётных проб.
              </p>
            </div>

            <div
              class="inline-flex flex-wrap items-center justify-center gap-2 rounded-full bg-white/15 border border-white/20 px-5 py-3 text-sm font-semibold"
            >
              <span>Клавиатура:</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                ПРОБЕЛ
              </kbd>

              <span>или</span>

              <kbd
                class="rounded-lg bg-white/20 px-3 py-1 font-mono"
              >
                ENTER
              </kbd>
            </div>
          </div>

          <div
            id="content-waiting"
            class="hidden relative z-10 h-full min-h-[430px] sm:min-h-[500px] flex flex-col items-center justify-center gap-6 px-6 sm:px-10 text-center text-white"
          >
            <div
              class="flex items-center gap-3"
              aria-hidden="true"
            >
              <span
                class="w-4 h-4 rounded-full bg-white animate-ping"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:150ms]"
              ></span>

              <span
                class="w-4 h-4 rounded-full bg-white animate-ping [animation-delay:300ms]"
              ></span>
            </div>

