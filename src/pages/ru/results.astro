      return map[subType] || subType.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    }

    // --- Bell Curve Render ---
    function renderBellCurve(userIq: number) {
      const minIq = 55; const maxIq = 145;
      const baselineY = 190; const peakHeight = 155;
      const mean = 100; const sd = 15;
      const xForIq = (iq: number) => 50 + ((iq - minIq) / (maxIq - minIq)) * 500;
      const yForIq = (iq: number) => baselineY - peakHeight * Math.exp(-0.5 * Math.pow((iq - mean) / sd, 2));
      let outlineD = `M 50 ${baselineY}`;
      for (let iq = minIq; iq <= maxIq; iq++) {
        outlineD += ` L ${xForIq(iq).toFixed(1)} ${yForIq(iq).toFixed(1)}`;
      }
      document.getElementById('curve-outline')?.setAttribute('d', outlineD);
      const clamped = Math.max(55, Math.min(145, userIq));
      let shadedD = `M 50 ${baselineY}`;
      for (let iq = minIq; iq <= clamped; iq++) {
        shadedD += ` L ${xForIq(iq).toFixed(1)} ${yForIq(iq).toFixed(1)}`;
      }
      shadedD += ` L ${xForIq(clamped).toFixed(1)} ${baselineY} Z`;
      document.getElementById('curve-shaded-area')?.setAttribute('d', shadedD);
      const curvePin = document.getElementById('curve-pin');
      if (curvePin) {
        curvePin.setAttribute('transform', `translate(${xForIq(clamped).toFixed(1)}, ${yForIq(clamped).toFixed(1)})`);
        const pinText = document.getElementById('curve-pin-text');
        if (pinText) pinText.textContent = `Вы: ${userIq}`;
      }
    }

