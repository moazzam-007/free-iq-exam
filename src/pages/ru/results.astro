      function drawCertificate(canvas: HTMLCanvasElement, recipientName: string, result: AssessmentResult) {
        const W = 1600, H = 1130;
        // High-DPI retina canvas buffer
        canvas.width = 3200;
        canvas.height = 2260;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.setTransform(2, 0, 0, 2, 0, 0);

        // Helper for rounded rectangle with fallback
        function drawRoundRect(x: number, y: number, w: number, h: number, r: number) {
          if (!ctx) return;
          if (typeof (ctx as any).roundRect === 'function') {
            (ctx as any).roundRect(x, y, w, h, r);
          } else {
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + w - r, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + r);
            ctx.lineTo(x + w, y + h - r);
            ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
            ctx.lineTo(x + r, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
          }
        }

        // Background gradient (cream)
        const bg = ctx.createLinearGradient(0, 0, W, H);
        bg.addColorStop(0, '#ffffff');
        bg.addColorStop(1, '#f8fafc');
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, W, H);

        // Outer double border
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 12;
        ctx.strokeRect(24, 24, W - 48, H - 48);
        ctx.strokeStyle = '#d97706';
        ctx.lineWidth = 4;
        ctx.strokeRect(40, 40, W - 80, H - 80);
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2;
        ctx.strokeRect(52, 52, W - 104, H - 104);

        // Corner ornament dots
        const corners = [[68, 68], [W - 68, 68], [68, H - 68], [W - 68, H - 68]];
        corners.forEach(([cx, cy]) => {
          ctx.beginPath();
          ctx.arc(cx, cy, 10, 0, Math.PI * 2);
          ctx.fillStyle = '#d97706';
          ctx.fill();
        });

        // Header registry line
        ctx.font = 'bold 26px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.textAlign = 'center';
        ctx.fillText('РЕЕСТР ПСИХОМЕТРИЧЕСКИХ ОЦЕНОК FREEIQEXAM', W / 2, 140);

        // Gold separator
        ctx.fillStyle = '#d97706';
        ctx.fillRect(W / 2 - 300, 158, 600, 3);

        // Monumental title
        ctx.font = 'bold 50px "Georgia", serif';
        ctx.fillStyle = '#0f172a';
        ctx.fillText('СЕРТИФИКАТ САМОСТОЯТЕЛЬНОЙ КОГНИТИВНОЙ ОЦЕНКИ', W / 2, 240);

        // Presentation text
        ctx.font = '30px "Georgia", serif';
        ctx.fillStyle = '#6b7280';
        ctx.fillText('Настоящим удостоверяется, что', W / 2, 320);

        // Recipient name (prominent with dynamic font sizing)
        const displayName = recipientName.trim() || 'Участник оценки';
        let nameFontSize = 70;
        ctx.font = `bold ${nameFontSize}px "Georgia", serif`;
        while (ctx.measureText(displayName).width > 1200 && nameFontSize > 26) {
          nameFontSize -= 4;
          ctx.font = `bold ${nameFontSize}px "Georgia", serif`;
        }
        ctx.fillStyle = '#1e40af';
        ctx.fillText(displayName, W / 2, 420);

        // Name underline
        const nameWidth = Math.min(ctx.measureText(displayName).width, 1200);
        ctx.fillStyle = '#1e40af';
        ctx.fillRect(W / 2 - nameWidth / 2, 432, nameWidth, 2);

        // Performance paragraph
        const dateStr = new Date().toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });
        ctx.font = '24px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.fillText('успешно прошёл(ла) стандартизированную оценку когнитивных способностей (4 домена CHC, ' + dateStr + ').', W / 2, 490);
        ctx.fillText('Шкала SD15 (среднее 100) по психометрической модели 2PL IRT.', W / 2, 526);

        // Central score box
        const boxX = W / 2 - 280, boxY = 566, boxW = 560, boxH = 200;
        ctx.fillStyle = '#f0f9ff';
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 3;
        ctx.beginPath();
        drawRoundRect(boxX, boxY, boxW, boxH, 16);
        ctx.fill();
        ctx.stroke();

        // Score + IQ label
        ctx.font = 'bold 80px "Georgia", serif';
        ctx.fillStyle = '#0f172a';
        ctx.textAlign = 'center';
        ctx.fillText(String(result.iqEstimate) + ' IQ', W / 2, boxY + 82);

        ctx.font = '24px "Georgia", serif';
        ctx.fillStyle = '#374151';
        ctx.fillText(
          '95% интервал: [' + result.confidenceInterval[0] + ' - ' + result.confidenceInterval[1] + ']   |   ' +
          result.percentile.toFixed(1) + '-й процентиль',
          W / 2, boxY + 126
        );

        // Classification
        let classification = 'Средние когнитивные способности';
        const iq = result.iqEstimate;
        if (iq >= 145) classification = 'Исключительно высокие когнитивные способности';
        else if (iq >= 130) classification = 'Очень высокие когнитивные способности';
        else if (iq >= 120) classification = 'Высокие когнитивные способности';
        else if (iq >= 110) classification = 'Способности выше среднего';
        else if (iq >= 90)  classification = 'Средние когнитивные способности';
        else if (iq >= 80)  classification = 'Уровень ниже среднего';
        else                classification = 'Пограничный уровень';

        ctx.font = 'bold 26px "Georgia", serif';
        ctx.fillStyle = '#1e40af';
        ctx.fillText(classification, W / 2, boxY + 168);

        // 4 CHC Domain sub-indices
        const domainLabels = [
          { key: 'fluid',        label: 'Подвижный интеллект (Gf)' },
          { key: 'spatial',      label: 'Пространственное мышление (Gv)' },
          { key: 'quantitative', label: 'Количественное мышление (Gq)' },
          { key: 'verbal',       label: 'Вербальное понимание (Gc)' },
        ] as const;

        const colW = (W - 160) / 4;
        const domY = 810;
        ctx.font = '22px "Georgia", serif';
        domainLabels.forEach((d, i) => {
          const cx         = 80 + colW * i + colW / 2;
          const dd         = result.domainBreakdown[d.key];
          const accPct     = dd.total > 0 ? Math.round((dd.rawScore / dd.total) * 100) : 0;
          const tierLabel  = accPct >= 83 ? 'Сильная сторона' : accPct >= 67 ? 'Выше среднего' : accPct >= 50 ? 'Средний уровень' : 'Зона роста';
          ctx.fillStyle = '#374151';
          ctx.textAlign = 'center';
          ctx.fillText(d.label, cx, domY);
          ctx.font = 'bold 36px "Georgia", serif';
          ctx.fillStyle = '#0f172a';
          ctx.fillText(dd.rawScore + '/' + dd.total + ' верно', cx, domY + 46);
          ctx.font = '20px "Georgia", serif';
          ctx.fillStyle = '#374151';
          ctx.fillText('(' + tierLabel + ')', cx, domY + 74);
          ctx.font = '22px "Georgia", serif';
        });

        // Gold separator above footer
        ctx.fillStyle = '#d97706';
        ctx.fillRect(80, 900, W - 160, 2);

        // Footer: Reference ID | Seal text | Date
        const hashInput = `${result.iqEstimate}-${result.theta.toFixed(2)}-${result.rawScore}-${result.totalQuestions}`;
        let hashVal = 5381;
        for (let i = 0; i < hashInput.length; i++) {
          hashVal = ((hashVal << 5) + hashVal) + hashInput.charCodeAt(i);
          hashVal |= 0;
        }
        const hexCode = Math.abs(hashVal).toString(16).padStart(6, '0').slice(-6).toUpperCase();
        const dateYear = new Date().getFullYear().toString();
        const referenceId = `FIQ-${dateYear}-${hexCode}`;
        ctx.font = '20px monospace';
        ctx.fillStyle = '#6b7280';
        ctx.textAlign = 'left';
        ctx.fillText('ID Справки: ' + referenceId, 100, 950);

        ctx.textAlign = 'center';
        ctx.font = 'bold 20px "Georgia", serif';
        ctx.fillStyle = '#d97706';
        ctx.fillText('ОЦЕНКА ПО 2PL IRT | САМООЦЕНКА', W / 2, 950);

        ctx.textAlign = 'right';
        ctx.font = '20px "Georgia", serif';
        ctx.fillStyle = '#6b7280';
        ctx.fillText('Движок психометрии FreeIQExam', W - 100, 950);
        ctx.fillText(dateStr, W - 100, 978);

        // Signature line
        ctx.strokeStyle = '#9ca3af';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(W - 400, 940);
        ctx.lineTo(W - 100, 940);
        ctx.stroke();

        // Mirror canvas to print certificate image
        const printCertImg = document.getElementById('print-cert-img') as HTMLImageElement | null;
        if (printCertImg) {
          printCertImg.src = canvas.toDataURL('image/png');
        }
      }

      // Button wiring (runs after DOM is ready)
      document.addEventListener('DOMContentLoaded', function () {
        const btnGenerate   = document.getElementById('btn-generate-cert');
        const btnDownload   = document.getElementById('btn-download-cert');
        const btnPrintCert  = document.getElementById('btn-print-cert');
        const btnShare      = document.getElementById('btn-share-result');
        const nameInput     = document.getElementById('cert-name-input') as HTMLInputElement | null;
        const previewWrap   = document.getElementById('cert-preview-wrap');
        const canvas        = document.getElementById('cert-canvas') as HTMLCanvasElement | null;

        if (btnGenerate && canvas && previewWrap) {
          btnGenerate.addEventListener('click', () => {
            const r = getCertResult();
            if (!r) return;
            const name = nameInput ? nameInput.value.trim() : '';
            drawCertificate(canvas, name, r);
            previewWrap.classList.remove('hidden');
            previewWrap.classList.add('flex');
            canvas.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
        }

        if (btnDownload && canvas) {
          btnDownload.addEventListener('click', () => {
            const name = (nameInput ? nameInput.value.trim() : '') || 'Verified_Candidate';
            const safeName = name.replace(/[^\p{L}\p{N}\s_-]/gu, '');
            const filename = 'FreeIQExam_Certificate_' + safeName + '.png';

            if (canvas.toBlob) {
              canvas.toBlob((blob) => {
                if (!blob) return;
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
                if (isIOS) {
                  const url = URL.createObjectURL(blob);
                  window.open(url, '_blank');
                  setTimeout(() => URL.revokeObjectURL(url), 30000);
                } else {
                  const url = URL.createObjectURL(blob);
                  const link = document.createElement('a');
                  link.download = filename;
                  link.href = url;
                  document.body.appendChild(link);
                  link.click();
                  document.body.removeChild(link);
                  setTimeout(() => URL.revokeObjectURL(url), 1000);
                }
              }, 'image/png');
            } else {
              const link = document.createElement('a');
              link.download = filename;
              link.href = canvas.toDataURL('image/png');
              link.click();
            }
          });
        }

        if (btnPrintCert) {
          btnPrintCert.addEventListener('click', () => window.print());
        }

        if (btnShare) {
          btnShare.addEventListener('click', () => {
            const r = getCertResult();
            const shareText = r
              ? 'Мой результат: ' + r.iqEstimate + ' IQ (' + r.percentile.toFixed(1) + '-й процентиль) в тесте FreeIQExam. Пройдите бесплатный тест: https://freeiqexam.com/ru'
              : 'Пройдите бесплатный тест на IQ FreeIQExam: https://freeiqexam.com/ru';
            if (navigator.share) {
              navigator.share({ title: 'Мой результат FreeIQExam', text: shareText, url: 'https://freeiqexam.com/ru/results' }).catch(() => {});
            } else {
              navigator.clipboard.writeText(shareText).then(() => {
                if (btnShare) btnShare.textContent = 'Ссылка скопирована!';
                setTimeout(() => { if (btnShare) btnShare.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" /></svg> Поделиться результатом'; }, 2500);
              }).catch(() => { window.prompt('Скопируйте ссылку на результат:', shareText); });
            }
          });
        }
      });
    })();
  </script>
</Layout>
