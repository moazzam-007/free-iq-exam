    // --- SubType label formatter (Bug 3 fix) ---
    function formatSubType(subType: string): string {
      const map: Record<string, string> = {
        matrix_reasoning:                 'Матричные задания',
        topological_series:               'Топологический ряд',
        cube_rotation:                    '3D-вращение',
