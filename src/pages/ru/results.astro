        btnCopy.addEventListener('click', () => {
          const shareText = `Выжимка результата FreeIQExam\nОценка: ${result.iqEstimate} IQ (SD 15)\n95% доверительный интервал: ${result.confidenceInterval[0]} - ${result.confidenceInterval[1]}\nПроцентиль: ${result.percentile.toFixed(1)}th\nTest Type: ${result.testType === 'quick' ? 'Quick Screening (12 items)' : 'Full Assessment (24 items)'}\nFRI: ${result.domainBreakdown.fluid.rawScore}/${result.domainBreakdown.fluid.total} | VSI: ${result.domainBreakdown.spatial.rawScore}/${result.domainBreakdown.spatial.total} | QRI: ${result.domainBreakdown.quantitative.rawScore}/${result.domainBreakdown.quantitative.total} | VCI: ${result.domainBreakdown.verbal.rawScore}/${result.domainBreakdown.verbal.total}\nScored via 2PL Item Response Theory at https://freeiqexam.com`;
          navigator.clipboard.writeText(shareText)
