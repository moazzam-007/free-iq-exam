---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Калькулятор сна | Оптимальное время отхода ко сну, циклы сна и тест на хронотип";
const description = "Рассчитайте оптимальное время отхода ко сну и пробуждения на основе естественных 90-минутных циклов сна. Включает мюнхенскую оценку хронотипа и трекер периода полувыведения кофеина. 100% бесплатно.";
const canonicalUrl = "https://freeiqexam.com/ru/sleep-calculator";
const enPath = "/sleep-calculator";
const idPath = "/id/kalkulator-tidur";

const faqItems = [
  {
    q: "Как работает этот калькулятор сна?",
    a: "Он считает назад от 90-минутного ультрадианного цикла - среднепопуляционной длительности одного пол��ого прохода через лёгкий сон, глубокий сон и REM. Если вы укажете, когда вам нужно проснуться, он вычтет по 90 минут за цикл плюс 14-минутный запас на засыпание и выдаст время отхода ко сну для шести, пяти, четырёх или трёх циклов. Если вы укажете, когда ложитесь в постель, он выполнит ту же арифметику в прямом направлении. Запас в 14 минут важен: время отхода ко сну - это когда вы ложитесь в постель, а не когда вы засыпаете, и отождествление этих двух моментов - самая распространённая ошибка в калькуляторах циклов сна."
  },
  {
    q: "Сколько часов сна действительно нужно взрослым?",
    a: "Консенсус Американской академии медицины сна и Общества исследований сна рекомендует семь и более часов в сутки для взрослых от 18 до 60 лет. То есть семь часов - это нижняя граница, а не цель: большинству взрослых оптимально подходит от семи до девяти. Этот калькулятор использует восемь часов как ориентир для журнала дефицита сна, поскольку это середина диапазона, и помечает пять циклов (7,5 часа в постели) как рекомендуемую базовую норму, а четыре цикла (6 часов) - как функциональный минимум, а не как цель."
  },
  {
    q: "Что такое цикл сна и действительно ли он длится 90 минут?",
    a: "Цикл сна - это одна полная последовательность стадий non-REM N1, N2 и N3 с последующей стадией REM, после чего паттерн повторяется. Девяносто минут - это среднепопуляционное значение, а не константа. Индивидуальные ультрадианные периоды колеблются примерно от 70 до 120 минут, и циклы одной ночи не одинаковы по длине - первый обычно самый короткий, а последний самый длинный. Именно поэтому этот калькулятор представляет длину цикла как эвристику для планирования. Он может подсказать разумное время отхода ко сну; он не может сказать, когда лично вы всплывёте между циклами."
  },
  {
    q: "Считать от момента, когда я ложусь в постель, или когда засыпаю?",
    a: "От момента, когда вы засыпаете. Здоровые взрослые засыпают в среднем примерно за 14 минут, и этот калькулятор закладывает эту латентность в каждый результат - показанное время отхода ко сну на 14 минут раньше расчётного момента засыпания. Если вы знаете, что ваша латентность больше, сдвиньте время отхода ко сну раньше на соответствующую разницу. Если вы регулярно засыпаете дольше 30 минут, несмотря на усталость, об этом стоит сказать врачу независимо от любых вопросов планирования."
  },
  {
    q: "Что такое хронотип и как рассчитывается мой?",
    a: "Хронотип - это биологически предпочтительное для вас время сна и бодрствования, определяемое вашей циркадной фазой. Этот инструмент использует Мюнхенский опросник хронотипа (MCTQ) - стандартный исследовательский инструмент. Вы вводите время сна и пробуждения в рабочие и свободные дни; инструмент вычисляет середину сна в свободные дни (MSF), затем корректирует её с учётом долга сна, возмещённого в эти свободные дни, и получает MSFsc. По MSFsc вас относят к Льву (ранний тип), Медведю (промежуточный) или Волку (поздний). Дельфин предлагается как явное наложение, а не как четвёртая категория MCTQ - он происходит из отдельной популярной системы и выводится здесь только из вашего ответа о фрагментации сна."
  },
  {
    q: "Как долго кофеин остаётся в организме?",
    a: "Период полувыведения кофеина у здоровых взрослых составляет примерно от трёх до семи часов, в среднем около пяти. Этот калькулятор использует 5,7 часа. Это значит, что каждый период полувыведения убирает половину остатка: 200 мг превращаются в 100 мг через 5,7 часа, в 50 мг через 11,4 часа и в 25 мг примерно через 17 часов. Индивидуальная скорость выведения существенно зависит от генетики (активность CYP1A2), приёма оральных контрацептивов, беременности и курения - курильщики выводят кофеин примерно вдвое быстрее, а беременность может замедлить его более чем вдвое."
  },
  {
    q: "Можно ли отоспаться за потерянные часы?",
    a: "Частично, и медленнее, чем предполагает большинство. Дефицит сна реален и накапливается, но восстановительный сон насыщаем - у гомеостатического отскока есть потолок, и дополнительные четыре часа в постели не возвращают четыре часа утраченной функции. Это ещё и снижает эффективность сна, поэтому больше времени вы проводите бодрствуя. Этот калькулятор распределяет погашение на три ночи с ограничением на каждую ночь, а затем честно сообщает, сколько долга осталось, вместо того чтобы делать вид, что одни длинные выходные стирают неделю ограничений."
  },
  {
    q: "Насколько точен этот калькулятор сна?",
    a: "Это точная арифметика, построенная на среднепопуляционных значениях. 90-минутный цикл, 14-минутная латентность и архитектура стадий по циклам - всё это средние значения из исследований сна, и ваша физиология будет отличаться. По-настоящему полезен инструмент тем, что убирает догадки из вопроса планирования и показывает кривую распада кофеина, которая является детерминированной фармакологией, а не оценкой. Это не диагностический инструмент. Если у вас стойкая бессонница, громкий храп с замеченными партнёром паузами в дыхании или непреодолимая дневная сонливость - обратитесь к врачу: в таких случаях нужно исследование сна, а не калькулятор."
  }
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Оптимизатор циклов сна и хронотипа FreeIQExam",
    "url": "https://freeiqexam.com/ru/sleep-calculator",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Три режима планирования сна: пробуждение в заданное время, сон сейчас и запланированное время отхода ко сну",
      "Планирование по 90-минутным ультрадианным циклам с моделированием 14-минутной латентности засыпания",
      "Маркировка уровней циклов от оптимального восстановительного сна до риска депривации сна",
      "Оценка по Мюнхенскому опроснику хронотипа (MCTQ) с расчётом MSFsc",
      "Классификация хронотипов Лев, Медведь и Волк с количественной оценкой социального джетлага",
      "Кривая распада кофеина по периоду полувыведения с кинетикой 5,7 часа",
      "Интерактивная 24-часовая циркадная шкала с маркерами начала выработки мелатонина",
      "Журнал дефицита сна за семь ночей с трёхночным протоколом восстановления",
      "Анимированная гипнограмма по циклам с моделированием архитектуры N1, N2, N3 и REM",
      "100% бесплатно, без регистрации, все вычисления выполняются локально в вашем браузере"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Инструменты",
        "item": "https://freeiqexam.com/tools"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Калькулятор сна",
        "item": "https://freeiqexam.com/ru/sleep-calculator"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  enPath={enPath}
  idPath={idPath}
  schema={schemas}
>
  <Header />

  <main class="sleep-page relative overflow-hidden">
    <div class="sleep-hero-glow" aria-hidden="true"></div>

    <!-- ===================================================== HERO ======= -->
    <section class="hero relative z-10">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <ol>
          <li><a href="/ru/">Главная</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/ru/games">Инструменты</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Калькулятор сна</li>
        </ol>
      </nav>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800/80 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 font-mono text-[13px] sm:text-sm font-semibold uppercase tracking-wider mb-4 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff]"></span>
        <span>ЦИРКАДНАЯ НАУКА · 90-МИНУТНЫЕ УЛЬТРАДИАННЫЕ ЦИКЛЫ</span>
      </div>
      <h1>Калькулятор сна</h1>
      <p class="lede">
        Определите, когда нужно лечь спать, чтобы просыпаться в конце цикла, а
        не в его середине. Три режима планирования, мюнхенская оценка
        хронотипа, кривая полувыведения кофеина и журнал дефицита сна за семь
        ночей - всё вычисляется локально, ничего никуда не отправляется.
      </p>

      <ul class="hero-stats">
        <li><strong>90 мин</strong><span>ультрадианный цикл</span></li>
        <li><strong>14 мин</strong><span>латентность засыпания</span></li>
        <li><strong>5,7 ч</strong><span>полувыведение кофеина</span></li>
        <li><strong>0</strong><span>данных загружено</span></li>
      </ul>
    </section>

    <!-- ================================================ SCHEDULER ======= -->
    <section class="panel" aria-labelledby="scheduler-title">
      <header class="panel-head">
        <h2 id="scheduler-title">Планировщик циклов сна</h2>
        <p>
          Выберите режим. Из каждого результата вычитается 14-минутный запас на
          засыпание, поэтому показанное время - это когда нужно лечь в постель,
          а не когда вы фактически заснёте.
        </p>
      </header>

      <div class="mode-tabs" role="tablist" aria-label="Режим планирования">
        <button
          type="button"
          role="tab"
          class="mode-tab is-active"
          data-sleep-mode="wake"
          aria-selected="true"
        >Мне нужно проснуться в…</button>
        <button
          type="button"
          role="tab"
          class="mode-tab"
          data-sleep-mode="now"
          aria-selected="false"
        >Я ложусь спать сейчас</button>
        <button
          type="button"
          role="tab"
          class="mode-tab"
          data-sleep-mode="bedtime"
          aria-selected="false"
        >Моё время отхода ко сну…</button>
      </div>

      <div class="mode-panel" data-mode-panel="wake">
        <label class="field" for="wake-time">
          <span class="field-label">Время пробуждения</span>
          <input type="time" id="wake-time" value="07:00" step="60" />
        </label>
        <p class="results-summary" id="wake-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="wake-results"></div>
      </div>

      <div class="mode-panel" data-mode-panel="now" hidden>
        <p class="mode-note">
          Используется часовой пояс вашего устройства. Время обновляется каждую
          минуту, пока эта вкладка открыта, и расписание ниже пересчитывается
          от текущей минуты.
        </p>
        <p class="results-summary" id="now-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="now-results"></div>
      </div>

      <div class="mode-panel" data-mode-panel="bedtime" hidden>
        <label class="field" for="bedtime-input">
          <span class="field-label">Время, когда вы ложитесь в постель</span>
          <input type="time" id="bedtime-input" value="23:00" step="60" />
        </label>
        <p class="results-summary" id="bedtime-results-summary" aria-live="polite"></p>
        <div class="cycle-grid" id="bedtime-results"></div>
      </div>

      <div class="tier-legend">
        <span class="tier-chip tone-optimal">Оптимально · 6 циклов</span>
        <span class="tier-chip tone-baseline">Базовая норма · 5 циклов</span>
        <span class="tier-chip tone-minimum">Минимум · 4 цикла</span>
        <span class="tier-chip tone-deficit">Дефицит · 3 цикла или меньше</span>
      </div>
    </section>

    <!-- ============================================ CLOCK + HYPNOGRAM === -->
    <section class="split" aria-labelledby="wheel-title">
      <div class="panel">
        <header class="panel-head">
          <h2 id="wheel-title">24-часовая циркадная шкала</h2>
          <p>
            Полночь сверху, полдень снизу, движение по часовой стрелке.
            Показаны ваше окно сна, расчётное начало выработки мелатонина,
            крайний срок кофеина и пик хронотипа.
          </p>
        </header>

        <svg
          id="clock-wheel"
          class="wheel"
          viewBox="0 0 260 260"
          role="img"
          aria-label="Циркадная шкала с окном сна и маркерами"
        ></svg>

        <ul class="wheel-legend">
          <li><i class="swatch swatch-sleep"></i>Окно сна</li>
          <li><i class="swatch swatch-melatonin"></i>Начало мелатонина</li>
          <li><i class="swatch swatch-caffeine"></i>Крайний срок кофеина</li>
          <li><i class="swatch swatch-peak"></i>Пик хронотипа</li>
        </ul>
      </div>

      <div class="panel">
        <header class="panel-head">
          <h2>Архитектура ночи</h2>
          <p>
            Среднепопуляционная архитектура стадий для шести циклов.
            Медленноволновой сон сосредоточен в ранних циклах; REM преобладает
            в поздних.
          </p>
        </header>

        <svg
          id="hypnogram"
          class="hypnogram"
          viewBox="0 0 720 200"
          role="img"
          aria-label="Гипнограмма с архитектурой стадий сна в течение ночи"
        ></svg>

        <dl class="hypo-totals">
          <div><dt>Общий сон</dt><dd id="hypo-total">-</dd></div>
          <div><dt>Глубокий (N3)</dt><dd id="hypo-sws">-</dd></div>
          <div><dt>REM</dt><dd id="hypo-rem">-</dd></div>
          <div><dt>Лёгкий (N1+N2)</dt><dd id="hypo-light">-</dd></div>
        </dl>

        <p class="caveat">
          Это модель, а не измерение. Ваша собственная архитектура будет
          отличаться, и она меняется с возрастом - медленноволновой сон
          существенно снижается начиная с тридцати лет.
        </p>
      </div>
    </section>

    <!-- ================================================ CHRONOTYPE ====== -->
    <section class="panel" aria-labelledby="chrono-title">
      <header class="panel-head">
        <h2 id="chrono-title">Мюнхенская оценка хронотипа</h2>
        <p>
          MCTQ - стандартный исследовательский инструмент для определения
          хронотипа. Он сравнивает ваш сон в рабочие и свободные дни, чтобы
          найти биологическую середину сна, а затем корректирует её с учётом
          долга, который вы возместили на выходных.
        </p>
      </header>

      <div class="mctq-grid">
        <fieldset class="mctq-group">
          <legend>Рабочие дни</legend>
          <label class="field" for="mctq-workday-sleep">
            <span class="field-label">Время, когда вы ложитесь спать</span>
            <input type="time" id="mctq-workday-sleep" value="23:30" step="60" />
          </label>
          <label class="field" for="mctq-workday-wake">
            <span class="field-label">Время, когда вы просыпаетесь</span>
            <input type="time" id="mctq-workday-wake" value="07:00" step="60" />
          </label>
        </fieldset>

        <fieldset class="mctq-group">
          <legend>Свободные дни</legend>
          <label class="field" for="mctq-freeday-sleep">
            <span class="field-label">Время, когда вы ложитесь спать</span>
            <input type="time" id="mctq-freeday-sleep" value="01:00" step="60" />
          </label>
          <label class="field" for="mctq-freeday-wake">
            <span class="field-label">Время, когда вы просыпаетесь</span>
            <input type="time" id="mctq-freeday-wake" value="09:00" step="60" />
          </label>
        </fieldset>

        <fieldset class="mctq-group">
          <legend>Качество сна</legend>
          <label class="field" for="mctq-fragmentation">
            <span class="field-label">Как часто вы просыпаетесь ночью?</span>
            <select id="mctq-fragmentation">
              <option value="never">Редко или никогда</option>
              <option value="sometimes" selected>Иногда</option>
              <option value="often">Часто - почти каждую ночь</option>
            </select>
          </label>
          <p class="field-hint">
            Используется только для показа наложения «Дельфин». Оно не меняет
            вашу классификацию по MCTQ.
          </p>
        </fieldset>
      </div>

      <p class="field-error" id="chrono-error" hidden></p>

      <article class="chrono-card" id="chrono-result" hidden>
        <header class="chrono-head">
          <div>
            <p class="chrono-kicker">Ваш хронотип</p>
            <h3 id="chrono-name">-</h3>
            <p class="chrono-alias" id="chrono-alias">-</p>
          </div>
          <div class="chrono-msfsc">
            <span class="chrono-msfsc-label">MSFsc</span>
            <strong id="chrono-msfsc">-</strong>
          </div>
        </header>

        <p class="chrono-summary" id="chrono-summary">-</p>

        <p class="chrono-disclosure" id="chrono-overlay-note" hidden></p>

        <div class="chrono-windows">
          <div class="window-card">
            <span class="window-label">Пик бодрости</span>
            <strong id="chrono-peak">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Второй пик</span>
            <strong id="chrono-secondary">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Спад</span>
            <strong id="chrono-trough">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Начало мелатонина</span>
            <strong id="chrono-melatonin-onset">-</strong>
          </div>
          <div class="window-card">
            <span class="window-label">Крайний срок кофеина</span>
            <strong id="chrono-caffeine-cutoff">-</strong>
          </div>
        </div>

        <div class="chrono-notes">
          <p><strong>Как с этим работать.</strong> <span id="chrono-advice">-</span></p>
          <p><strong>Чего это вам стоит.</strong> <span id="chrono-friction">-</span></p>
        </div>

        <details class="chrono-math">
          <summary>Показать расчёты, лежащие в основе этого результата</summary>
          <dl class="math-list">
            <div><dt>Длительность сна в рабочие дни</dt><dd id="chrono-sdweek">-</dd></div>
            <div><dt>Длительность сна в свободные дни</dt><dd id="chrono-sdfree">-</dd></div>
            <div><dt>Середина сна, рабочие дни (MSW)</dt><dd id="chrono-msw">-</dd></div>
            <div><dt>Середина сна, свободные дни (MSF)</dt><dd id="chrono-msf">-</dd></div>
            <div><dt>Коррекция долга</dt><dd id="chrono-correction">-</dd></div>
            <div><dt>Скорректированная середина сна (MSFsc)</dt><dd id="chrono-msfsc-echo">-</dd></div>
            <div><dt>Средняя длительность сна</dt><dd id="chrono-average">-</dd></div>
            <div><dt>Социальный джетлаг</dt><dd id="chrono-social-jetlag">-</dd></div>
          </dl>
          <p class="math-note">
            MSFsc = MSF − (SD<sub>своб</sub> − SD<sub>раб</sub>) ÷ 2, применяется
            только когда сон в свободные дни длиннее, чем в рабочие. Применение
            этой коррекции без условия - распространённая ошибка в калькуляторах
            сна: она ошибочно относит людей с коротким сном, которые отсыпаются
            на выходных, к поздним хронотипам. Социальный джетлаг - это разрыв
            фаз между вашей биологической серединой сна и той, которую навязывает
            социальное расписание.
          </p>
        </details>
      </article>
    </section>

