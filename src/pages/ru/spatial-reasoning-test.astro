---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';
import CategoryTestRunner from '../../components/ru/CategoryTestRunnerRu.astro';

const title = "Тест пространственного мышления (Gv): вращение и развёртки";
const description = "16 заданий: ментальное вращение 3D, развёртки куба, изометрия. Пространственное мышление бесплатно.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Тест пространственного мышления (Gv): когнитивные способности",
    "description": "Специализированный тест пространственного мышления из 16 заданий: изометрическое вращение 3D, складывание развёрток и пространственные преобразования.",
    "url": "https://freeiqexam.com/ru/spatial-reasoning-test/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Тест пространственного мышления",
        "item": "https://freeiqexam.com/ru/spatial-reasoning-test/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/spatial-reasoning-test" idPath="/tes-spasial" canonicalUrl="https://freeiqexam.com/ru/spatial-reasoning-test">
  <Header currentPath="/spatial-reasoning-test"  enPath="/spatial-reasoning-test" idPath="/tes-spasial"/>

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест пространственного мышления</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>КОГНИТИВНЫЙ ФАКТОР CHC: Gv <span aria-hidden="true">&bull;</span> ПРОСТРАНСТВЕННОЕ МЫШЛЕНИЕ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тест пространственного мышления (Gv)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Измерьте способность создавать, удерживать, извлекать и преобразовывать двумерные и трёхмерные зрительные образы. Тренируйте ментальное вращение изометрических фигур и складывание развёрток в стандартных условиях.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 заданий на пространственные преобразования</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Таймер 15 минут (или без времени)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Развёртки куба и вращения 3D</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Калибровка 2PL IRT</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="spatial"
      domainCode="Gv"
      domainTitle="Пространственное мышление (Gv)"
      domainSubtitle="Ментальное вращение, развёртки 3D и ортографическая логика"
      domainDescription="Пространственное мышление (Gv) оценивает способность воспринимать, анализировать, синтезировать и преобразовывать зрительные образы и пространственные конфигурации. Это важнейший предиктор способностей в инженерии, архитектуре, математике и пространственной навигации."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Когнитивная нейронаука пространственного мышления (Gv)
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Основы заложены Роджером Шепардом и Жаклин Метцлер в знаковых экспериментах 1971 года по ментальному вращению: пространственное познание предполагает мысленное моделирование физических преобразований объектов в рабочей памяти. В таксономии Кеттелла — Хорна — Кэрролла Gv включает ментальное вращение, пространственные отношения и визуализацию.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Изометрическое вращение куба 3D
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Мысленно вращайте трёхмерное тело вокруг осей X, Y или Z, чтобы определить, является ли другой ракурс тем же объектом или невозможным зеркальным отражением.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Развёртки поверхностей
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Складывайте плоскую крестообразную или Т-образную развёртку в шестигранный куб 3D. Нужно отслеживать, какие грани с узором окажутся соседними, а какие — противоположными.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Ортографическая перспектива
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Синтез нескольких двумерных видов (сверху, спереди, сбоку) для восстановления верной составной трёхмерной геометрии блоков.
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Тактика решения головоломок с развёртками 3D
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Правило противоположных граней:</strong> в стандартной плоской развёртке куба грани, разделённые ровно одним квадратом по прямой, при складывании всегда окажутся противоположными. Противоположные грани никогда не видны одновременно ни с какого ракурса.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Закрепите одну грань:</strong> выберите самую заметную или асимметричную грань как опорную, затем складывайте соседние грани относительно неё.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Проверяйте тройки углов:</strong> смотрите на 3 грани, сходящиеся в видимой вершине. Обращайте внимание на направленные указатели (стрелки, диагонали), смотрящие к общему углу или от него.</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Другие специализированные когнитивные батареи
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/ru/fluid-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Подвижный интеллект (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Индукция матриц &rarr;</div>
          </a>
          <a
            href="/ru/quantitative-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Количественное мышление (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Арифметические логические задачи &rarr;</div>
          </a>
          <a
            href="/ru/verbal-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Вербальное понимание (Gc)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Дедуктивные силлогизмы &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
