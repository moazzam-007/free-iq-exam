---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Условия использования | FreeIQExam";
const description = "Условия использования FreeIQExam: образовательный скрининг, отказ от медицинской диагностики, интеллектуальная собственность.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Условия использования - FreeIQExam",
    "url": "https://freeiqexam.com/ru/terms/",
    "description": "Условия обслуживания, отказ от медицинской ответственности и условия интеллектуальной собственности FreeIQExam.com."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Условия использования",
        "item": "https://freeiqexam.com/ru/terms/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/terms" idPath="/syarat-dan-ketentuan" canonicalUrl="https://freeiqexam.com/ru/terms">
  <Header currentPath="/terms"  enPath="/terms" idPath="/syarat-dan-ketentuan"/>

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Условия использования</span>
    </nav>
    
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-3">
        <span>ПОЛЬЗОВАТЕЛЬСКОЕ СОГЛАШЕНИЕ &bull; ОТКАЗ ОТ ОТВЕТСТВЕННОСТИ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight">
        Условия использования
      </h1>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-2">
        Последнее обновление: сентябрь 2026 г.
      </p>
    </header>

    <article class="prose prose-zinc dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-6">
      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          1. Принятие условий
        </h2>
        <p>
          Получая доступ к FreeIQExam.com, проходя наши когнитивные тесты или используя интерактивные инструменты, вы соглашаетесь соблюдать настоящие Условия использования. Если вы не согласны с каким-либо положением, вам следует прекратить использование сайта.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800">
        <h2 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          2. Отказ от медицинской и клинической нейропсихологической диагностики
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed mb-3">
          <strong>FreeIQExam — это образовательный инструмент самооценки и скрининга, а не диагностический медицинский прибор.</strong>
        </p>
        <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed">
          Оценки баллов, формируемые нашим алгоритмом 2PL IRT, не являются клинической оценкой, психологическим диагнозом, юридическим заключением либо основанием для зачисления на образовательные программы или установления инвалидности и не должны использоваться в таком качестве. Формальная когнитивная оценка требует комплексной батареи тестов под наблюдением лицензированного клинического нейропсихолога.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          3. Права интеллектуальной собственности
        </h2>
        <p>
          Все фирменные векторные схемы заданий SVG, исходный код алгоритмов, архитектура сайта и редакционные материалы на FreeIQExam.com защищены законодательством об авторском праве, товарных знаках и интеллектуальной собственности.
        </p>
        <p>
          Вам предоставляется личная, неисключительная, отзывная лицензия на доступ к тестам для личной самооценки. Систематическое сканирование, парсинг, коммерческое воспроизведение или повторное размещение наших банков вопросов SVG строго запрещено без письменного разрешения.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          4. Ограничение ответственности
        </h2>
        <p>
          FreeIQExam предоставляется на условиях «как есть» и «по мере доступности» без каких-либо гарантий, явных или подразумеваемых. Ни при каких обстоятельствах FreeIQExam и его операторы не несут ответственности за косвенные, штрафные или последующие убытки, возникшие в результате использования или невозможности использования наших тестов.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          5. Контактная информация
        </h2>
        <p>
          По юридическим вопросам, связанным с настоящими условиями, обращайтесь по адресу <a href="mailto:legal@freeiqexam.com" class="text-blue-600 dark:text-blue-400 font-semibold underline">legal@freeiqexam.com</a>.
        </p>
      </section>
    </article>

  </main>

  <Footer />
</Layout>
