---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';

const title = "Тест скорости печати онлайн: клавиатурный тренажер WPM | FreeIQExam";
const description = "Проверьте скорость печати онлайн на клавиатурном тренажере: тест набора текста за 60 секунд. Расчет WPM, точности и тепловая карта ошибок бесплатно.";
const canonicalUrl = "https://freeiqexam.com/ru/typing-test";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Онлайн-тест скорости печати и бенчмарк WPM | FreeIQExam",
    "url": "https://freeiqexam.com/ru/typing-test",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "browserRequirements": "Требуется поддержка JavaScript и Web Audio API",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Расчёт Gross и Net WPM в реальном времени",
      "Плавная физика каретки уровня Monkeytype и подсветка символов",
      "Синтез звука механических переключателей через Web Audio API (Cherry MX Blue, Brown, Red)",
      "Живой график WPM и ошибок на высокоточном canvas",
      "Интерактивная тепловая карта ошибок клавиатуры ЙЦУКЕН и анализ ловкости пальцев",
      "Режимы: спринт (15 с), стандарт (60 с) и выносливость (120 с)",
      "Сертификат о скорости печати в высоком разрешении (PNG 1200x675)",
      "Без оплаты, без email, всё вычисляется в браузере"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Инструменты",
        "item": "https://freeiqexam.com/ru/tools"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Тест скорости печати",
        "item": "https://freeiqexam.com/ru/typing-test"
      }
    ]
  }
];

const faqItems = [
  {
    name: "Какая скорость печати считается хорошей (WPM)?",
    acceptedAnswer: {
      text: "Средняя мировая скорость печати составляет примерно 40–45 слов в минуту (WPM). Скорость 60–70 WPM считается выше средней и высокопродуктивной для офисной и профессиональной работы. Показатели 80–95 WPM соответствуют топ-10% печатающих, а 100+ WPM выводит вас в элитные топ-2% слепых печатников мира."
    }
  },
  {
    name: "В чём разница между Gross WPM и Net WPM?",
    acceptedAnswer: {
      text: "Gross WPM измеряет вашу чистую скорость печати, деля общее число нажатий на 5 (стандартная длина слова) на затраченные минуты. Net WPM применяет штраф за ошибки: Net WPM = Gross WPM − (неисправленные ошибки / время в минутах). Именно Net WPM является международным стандартом для соревнований и профессионального отбора, поскольку печать с ошибками уничтожает реальную производительность."
    }
  },
  {
    name: "Как определяется «одно слово» в тестах скорости печати?",
    acceptedAnswer: {
      text: "В психометрических и клинических бенчмарках скорости печати одно слово универсально стандартизировано как ровно 5 нажатий (символы, пробелы и знаки препинания). Стандартизация по 5 нажатиям гарантирует, что тесты с длинными словами (например, «достопримечательность») не штрафуют печатающего по сравнению с тестами из коротких слов (например, «дом»)."
    }
  },
  {
    name: "Как поднять скорость печати с 50 до 100+ WPM?",
    acceptedAnswer: {
      text: "Чтобы преодолеть плато скорости печати: 1) Освойте слепую печать десятью пальцами по домашнему ряду (ФЫВА ОЛДЖ) не глядя на клавиатуру; 2) Сначала добейтесь точности 98%+, и только затем работайте над скоростью; 3) Смотрите на 1–2 слова вперёд, чтобы тренировать моторный буфер; 4) Практикуйте короткие 15- и 30-секундные высокоинтенсивные спринты ежедневно; 5) Перейдите на эргономичную механическую клавиатуру с переключателями с коротким ходом."
    }
  },
  {
    name: "Влияет ли тип механических переключателей на скорость печати?",
    acceptedAnswer: {
      text: "Да. Механические переключатели обеспечивают выделенную тактильную или звуковую точку срабатывания до полного нажатия, снижая усталость пальцев. Тактильные переключатели (например, Cherry MX Brown) и линейные (например, Cherry MX Red) широко популярны среди скоростных печатников за плавное срабатывание и минимальное сопротивление хода, что позволяет быстро повторно нажимать клавиши и держать высокий темп."
    }
  },
  {
    name: "Каков мировой рекорд скорости печати?",
    acceptedAnswer: {
      text: "Самая высокая зафиксированная скорость печати на стандартной клавиатуре QWERTY - 216 WPM за одноминутный тест, достигнутая соревновательным печатником Шоном Роной. Рекорд Гиннесса по длительной печати принадлежит Барбаре Блэкбёрн, которая держала 150 WPM на протяжении 50-минутного испытания и достигала пика 212 WPM на раскладке Dvorak Simplified Keyboard."
    }
  },
  {
    name: "Почему точность печати важнее чистой скорости?",
    acceptedAnswer: {
      text: "Каждое нажатие Backspace даёт тройной штраф: время на нажатие Backspace, время на удаление ошибки и когнитивный сбой вашего ритма печати. Печатник со скоростью 80 WPM и точностью 99% создаст больше пригодного текста, чем тот, кто печатает 100 WPM с точностью 90% и тратит половину времени на исправление ошибок."
    }
  },
  {
    name: "ЙЦУКЕН или QWERTY - что быстрее?",
    acceptedAnswer: {
      text: "Раскладки оптимизируются под частотность букв конкретного языка. ЙЦУКЕН исторически оптимизирована под русскую частотность, а QWERTY - под английскую, хотя обе не являются строго эргономическими. Исследования показывают, что скорость печати в первую очередь определяется автоматизацией моторной коры, а не раскладкой: при достаточной практике на любой раскладке достигается высокая скорость, но эргономичная раскладка снижает физическую нагрузку на пальцы."
    }
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  enPath="/typing-test"
  idPath="/id/tes-kecepatan-mengetik"
  schema={schema}
>
  <Header currentPath="/typing-test" enPath="/typing-test" idPath="/id/tes-kecepatan-mengetik" />

  <style>
    /* Caret Pulse and Floating Smooth Movement */
    #caret {
      transition: transform 0.08s cubic-bezier(0.2, 0.9, 0.3, 1);
    }

    @keyframes caretBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .caret-blink {
      animation: caretBlink 1s infinite ease-in-out;
    }

    /* Word Box Line Clamping & Mask */
    .words-box {
      mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, #000 75%, transparent 100%);
    }

    /* FAQ Details Chevron Transition */
    details summary::-webkit-details-marker {
      display: none;
    }

    #typingSettingsBar button { min-height: 44px; }
    #typingSettingsBar button:active { transform: scale(0.97); transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }

    details[open] summary .faq-chevron {
      transform: rotate(180deg);
    }

    @media print {
      header, footer, #typingSettingsBar, #restartBtn, .no-print {
        display: none !important;
      }
      #resultsWrap {
        display: block !important;
      }
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
    }
  </style>

  <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Хлебные крошки">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <a href="/ru/tools" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Инструменты</a>
      <span class="mx-2 text-zinc-400 dark:text-zinc-600">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест скорости печати</span>
    </nav>

    <!-- Header & Hero Section -->
    <header class="text-center max-w-3xl mx-auto mb-10">
      <div class="relative inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[13px] sm:text-sm font-mono font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#0066cc] dark:bg-[#2997ff] animate-pulse"></span>
        <span>Клавиатурный тренажер · Психомоторный тест набора текста</span>
      </div>
      <h1 class="font-heading font-extrabold text-4xl sm:text-5xl md:text-6xl text-zinc-950 dark:text-white tracking-[-0.025em] leading-[1.08] mb-4">
        Тест скорости печати и клавиатурный тренажер (WPM)
      </h1>
      <p class="text-[17px] sm:text-lg text-zinc-600 dark:text-zinc-300 leading-[1.62] max-w-2xl mx-auto">
        Проверьте скорость печати и точность набора текста в реальном времени. Интерактивный клавиатурный тренажер с физикой каретки в стиле Monkeytype, звуком механических переключателей и тепловой картой ошибок — бесплатно и без регистрации.
      </p>
    </header>

    <!-- TOP SETTINGS & MODE TOOLBAR -->
    <section id="typingSettingsBar" class="max-w-4xl mx-auto mb-8 p-3 rounded-2xl bg-zinc-50 dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 flex flex-wrap items-center justify-between gap-4 text-[13px] font-mono shadow-xs">
      <!-- Mode Tabs (Time vs Words) -->
      <div class="flex items-center gap-1 bg-zinc-200/60 dark:bg-zinc-800/60 p-1 rounded-xl">
        <button
          type="button"
          data-mode="time"
          class="mode-btn active px-3.5 py-1.5 rounded-lg font-bold transition-all cursor-pointer bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/40 inline-flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg><span>Время</span>
        </button>
        <button
          type="button"
          data-mode="words"
          class="mode-btn px-3.5 py-1.5 rounded-lg text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all cursor-pointer inline-flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg><span>Слова</span>
        </button>
      </div>

      <!-- Time Options (15, 30, 60, 120s) -->
      <div id="timeOptionsGroup" class="flex items-center gap-2">
        <span class="text-zinc-400 hidden sm:inline">Секунды:</span>
        <button type="button" data-time="15" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">15</button>
        <button type="button" data-time="30" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">30</button>
        <button type="button" data-time="60" class="time-opt-btn active px-2.5 py-1 rounded-md text-blue-500 font-bold transition-colors cursor-pointer">60</button>
        <button type="button" data-time="120" class="time-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">120</button>
      </div>

      <!-- Word Options (25, 50, 100) -->
      <div id="wordOptionsGroup" class="hidden flex items-center gap-2">
        <span class="text-zinc-400 hidden sm:inline">Слова:</span>
        <button type="button" data-words="25" class="word-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">25</button>
        <button type="button" data-words="50" class="word-opt-btn active px-2.5 py-1 rounded-md text-blue-500 font-bold transition-colors cursor-pointer">50</button>
        <button type="button" data-words="100" class="word-opt-btn px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">100</button>
      </div>

      <!-- Punctuation & Numbers Toggles -->
      <div class="flex items-center gap-2">
        <button id="togglePunctuation" type="button" class="px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">
          @ Пунктуация
        </button>
        <button id="toggleNumbers" type="button" class="px-2.5 py-1 rounded-md text-zinc-500 hover:text-blue-500 transition-colors cursor-pointer">
          # Цифры
        </button>
      </div>

      <!-- Mechanical Sound Selector -->
      <div class="flex items-center gap-2">
        <span class="text-zinc-400 inline-flex items-center gap-1"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>Звук:</span>
        <select
          id="soundSelect"
          class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-lg px-2 py-1 text-zinc-800 dark:text-zinc-200 focus:outline-none focus:border-blue-500 cursor-pointer"
        >
          <option value="blue">Cherry MX Blue (кли��)</option>
          <option value="brown">Cherry MX Brown (тактовый)</option>
          <option value="red">Cherry MX Red (линейный)</option>
          <option value="mute">Без звука</option>
        </select>
      </div>
    </section>

    <!-- INTERACTIVE TYPING ARENA -->
    <section class="relative w-full max-w-4xl mx-auto mb-16">

      <!-- ARENA CARD -->
      <div id="typingArena" class="relative w-full rounded-3xl p-6 sm:p-10 md:p-12 bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl transition-all cursor-text select-none">

        <!-- Live HUD Status -->
        <div class="flex items-center justify-between pb-6 border-b border-zinc-100 dark:border-zinc-800/80 mb-6 font-mono">
          <div class="flex items-center gap-6">
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">Осталось</div>
              <div id="hudTimer" class="font-heading font-extrabold text-2xl sm:text-3xl text-[#0066cc] dark:text-[#2997ff]">60с</div>
            </div>
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">Текущий WPM</div>
              <div id="hudWpm" class="font-heading font-extrabold text-2xl sm:text-3xl text-zinc-900 dark:text-white">0</div>
            </div>
            <div>
              <div class="text-[13px] text-zinc-400 uppercase tracking-wider">Точность</div>
              <div id="hudAccuracy" class="font-heading font-extrabold text-2xl sm:text-3xl text-emerald-600 dark:text-emerald-400">100%</div>
            </div>
          </div>

          <!-- Restart Button & Shortcut Hint -->
          <div class="flex items-center gap-3">
            <button
              id="restartBtn"
              type="button"
              class="p-2.5 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-blue-500/10 hover:text-blue-500 text-zinc-500 dark:text-zinc-400 transition-all cursor-pointer shadow-xs"
              aria-label="Перезапустить тест печати"
              title="Перезапустить тест (Esc или Tab)"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M1 4v6h6M23 20v-6h-6M20.49 9A9 9 0 005.64 5.64L1 10M3.51 15a9 9 0 0014.85 3.36L23 14" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Words Stream Display Box -->
        <div class="relative words-box">
          <div
            id="wordsWrapper"
            class="max-h-36 sm:max-h-44 overflow-hidden relative font-mono text-xl sm:text-2xl leading-loose sm:leading-loose text-zinc-400 dark:text-zinc-600 tracking-wide select-none"
          >
            <!-- Dynamically populated word spans -->
          </div>

          <!-- Smooth Caret Bar -->
          <div
            id="caret"
            class="absolute top-0 left-0 w-0.5 sm:w-[3px] h-7 sm:h-8 bg-[#0066cc] dark:bg-[#2997ff] rounded-full caret-blink pointer-events-none shadow-[0_0_8px_rgba(0,102,204,0.6)]"
          ></div>
        </div>

        <!-- Accessible Transparent Input for Desktop & Mobile IME Keyboards -->
        <input
          id="typingInput"
          type="text"
          class="absolute inset-0 opacity-0 w-full h-full cursor-text z-10"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Поле ввода теста скорости печати"
        />

        <!-- Click to focus prompt -->
        <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between text-[13px] font-mono text-zinc-400 dark:text-zinc-500">
          <span>Нажмите на поле или сразу начинайте печатать</span>
          <span class="hidden sm:inline">Нажмите <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">Tab</kbd> или <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">Esc</kbd> для перезапуска</span>
        </div>
      </div>

      <!-- RESULTS REPORT SECTION -->
      <div id="resultsWrap" class="hidden mt-8 space-y-8">

        <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-[#121215] border border-zinc-200 dark:border-zinc-800 shadow-2xl space-y-8">

          <!-- Result Hero Header -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-b border-zinc-100 dark:border-zinc-800/80 pb-8">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-[13px] font-mono font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wider mb-2">
                Результат психомоторного бенчмарка
              </div>
              <h3 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-900 dark:text-white">
                Отчёт о скорости печати
              </h3>
            </div>

            <div class="flex items-center gap-3">
              <span id="resPercentile" class="px-4 py-2 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-600 dark:text-blue-400 font-mono font-bold text-sm">
                Топ 10%
              </span>
              <span id="resTier" class="px-4 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white font-heading font-bold text-sm">
                Продвинутый печатник
              </span>
            </div>
          </div>

          <!-- Hero Metrics Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center col-span-2 sm:col-span-1">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Net WPM</div>
              <div class="font-heading font-black text-4xl sm:text-5xl text-[#0066cc] dark:text-[#2997ff]">
                <span id="resWpm">0</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-center">
              <div class="text-[13px] font-mono text-zinc-500 dark:text-zinc-400 mb-1 uppercase">Точность</div>
              <div class="font-heading font-extrabold text-2xl sm:text-3xl text-emerald-600 dark:text-emerald-400">
                <span id="resAccuracy">0%</span>
              </div>
            </div>

