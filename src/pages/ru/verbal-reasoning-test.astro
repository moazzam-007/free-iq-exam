---
import Layout from '../../components/ru/LayoutRu.astro';
import Header from '../../components/ru/HeaderRu.astro';
import Footer from '../../components/ru/FooterRu.astro';
import CategoryTestRunner from '../../components/ru/CategoryTestRunnerRu.astro';

const title = "Вербальный тест на логику и понимание: аналогии и силлогизмы (Gc) | FreeIQExam";
const description = "Пройдите вербальный тест интеллекта (Gc): 16 заданий на логические аналогии, силлогизмы и семантические связи. Оценка кристаллизованного интеллекта.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "name": "Тест вербального понимания (Gc): когнитивные способности",
    "description": "Специализированный тест вербального понимания из 16 заданий: лексические семантические связи, формальная силлогистическая дедукция и категориальная логика.",
    "url": "https://freeiqexam.com/ru/verbal-reasoning-test",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Главная",
        "item": "https://freeiqexam.com/ru/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Тест вербального понимания",
        "item": "https://freeiqexam.com/ru/verbal-reasoning-test"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema} enPath="/verbal-reasoning-test" idPath="/tes-verbal" canonicalUrl="https://freeiqexam.com/ru/verbal-reasoning-test">
  <Header currentPath="/verbal-reasoning-test"  enPath="/verbal-reasoning-test" idPath="/tes-verbal"/>

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/ru/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Тест вербального понимания</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>КОГНИТИВНЫЙ ФАКТОР CHC: Gc <span aria-hidden="true">&bull;</span> ВЕРБАЛЬНОЕ ПОНИМАНИЕ</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-5xl text-zinc-950 dark:text-white tracking-tight leading-tight mb-4">
        Тест вербального понимания (Gc)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Оцените глубину понимания понятий, дедуктивные вербальные силлогизмы и реляционные аналогии. Выберите стандартный тест на 15 минут или тренировку без времени с пошаговыми логическими доказательствами.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 вербальных и дедуктивных заданий</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Таймер 15 минут (или без времени)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Формальные дедуктивные силлогизмы</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Калибровка 2PL IRT</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="verbal"
      domainCode="Gc"
      domainTitle="Вербальное понимание (Gc)"
      domainSubtitle="Лексические аналогии и формальные дедуктивные силлогизмы"
      domainDescription="Вербальное понимание и кристаллизованный интеллект (Gc) отражают глубину и широту приобретённых знаний, формирование вербальных понятий, языковую абстракцию и формальное дедуктивное мышление. В реальной жизни Gc определяет точность коммуникации, юридический анализ и сложный синтез."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          Основы кристаллизованного интеллекта и вербальной логики
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Хотя кристаллизованный интеллект охватывает язык и культурные знания, стандартные психометрические тесты Gc проверяют реляционное мышление и формальную дедукцию, а не поверхностное знание слов. Человек должен понимать, как абстрактные понятия связаны, противопоставлены и образуют необходимые логические истины.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Реляционные аналогии (A : B :: C : ?)
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Формулировка точной функциональной связи между первой парой слов (часть — целое, степень интенсивности, причина — следствие, инструмент — действие) и перенос её на целевую пару.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Формальные дедуктивные силлогизмы
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Оценка аргументов из двух посылок: какой вывод следует с абсолютной логической необходимостью, без опоры на житейские убеждения.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Категориальная логика включения
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Классификация понятий в таксономические иерархии и поиск термина, нарушающего скрытый общий критерий (выделение лишнего).
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Тактика формальных силлогизмов и вербальной логики
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Не учитывайте житейскую правдоподобность:</strong> силлогизмы решаются строго в мире заявленных посылок. Даже если посылка противоречит реальности (например, «Все яблоки — синие»), для вывода считайте её на 100% истинной.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Формулируйте точное связующее предложение для аналогий:</strong> для аналогии (например, Термометр : Температура :: Барометр : ?) постройте точную фразу: «Термометр — это прибор для измерения температуры; значит, барометр — это прибор для измерения атмосферного давления».</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Остерегайтесь ловушки «Некоторые»:</strong> в формальной логике «Некоторые» означает «Хотя бы один, а возможно и все». Это НЕ означает «Некоторые — не». Мысленно рисуйте пересекающиеся множества или круги Венна, чтобы не делать неверных скачков в кванторах.</span>
          </li>
        </ul>
      </div>

      <!-- User-Facing FAQ Accordion -->
      <div class="space-y-4 pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-xl sm:text-2xl text-zinc-950 dark:text-white">
          Частые вопросы о вербальном понимании (Gc)
        </h3>
        <div class="space-y-3 pt-2">
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Что проверяет вербальный тест интеллекта?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Вербальный тест оценивает кристаллизованный интеллект (Gc): глубину понимания семантических отношений, способность устанавливать точные аналогии (род-вид, причина-следствие, часть-целое) и делать строгие силлогистические выводы.
            </p>
          </details>
          <details class="group rounded-2xl border border-zinc-200 bg-zinc-50/60 p-5 dark:border-zinc-800 dark:bg-zinc-900/60">
            <summary class="flex cursor-pointer items-center justify-between font-heading font-bold text-sm sm:text-base text-zinc-900 dark:text-white select-none">
              <span>Как решать формальные дедуктивные силлогизмы?</span>
              <span class="text-zinc-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed border-t border-zinc-200/80 dark:border-zinc-800/80 pt-3">
              Опирайтесь исключительно на истинность посылок, абстрагируясь от бытовых представлений. Если в условии сказано, что «все кошки летают», а «Барсик — кошка», строго логичный дедуктивный вывод — «Барсик летает».
            </p>
          </details>
        </div>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Другие специализированные когнитивные батареи
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/ru/fluid-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Подвижный интеллект (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Индукция матриц &rarr;</div>
          </a>
          <a
            href="/ru/spatial-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Пространственное мышление (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Ментальное вращение 3D &rarr;</div>
          </a>
          <a
            href="/ru/quantitative-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Количественное мышление (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Арифметические логические задачи &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
