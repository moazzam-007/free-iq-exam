---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Terms of Service & Clinical Disclaimer | FreeIQExam";
const description = "Terms of service, medical liability disclaimer, and intellectual property terms for FreeIQExam.com.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Terms of Service - FreeIQExam",
    "url": "https://freeiqexam.com/terms/",
    "description": "Terms of service, medical liability disclaimer, and intellectual property terms for FreeIQExam.com."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Terms of Service",
        "item": "https://freeiqexam.com/terms/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/terms" />

  <main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Terms of Service</span>
    </nav>
    
    <header class="border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/80 text-xs font-mono font-medium uppercase tracking-wider mb-3">
        <span>USER AGREEMENT &bull; LIABILITY DISCLAIMER</span>
      </div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-zinc-950 dark:text-white tracking-tight">
        Terms of Service &amp; Conditions
      </h1>
      <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-2">
        Last Revised: September 2026
      </p>
    </header>

    <article class="prose prose-zinc dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-6">
      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          1. Acceptance of Terms
        </h2>
        <p>
          By accessing FreeIQExam.com, taking our cognitive assessments, or using our interactive tools, you agree to be bound by these Terms of Service. If you disagree with any provision, your sole remedy is to cease using the website.
        </p>
      </section>

      <section class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800">
        <h2 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-2">
          2. Medical &amp; Clinical Neuropsychological Disclaimer
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed mb-3">
          <strong>FreeIQExam is an educational self-assessment and screening tool, not a diagnostic medical instrument.</strong>
        </p>
        <p class="text-zinc-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed">
          The score estimates generated by our 2PL IRT algorithm do not constitute, and must not be used as, a clinical evaluation, psychological diagnosis, legal certification, or eligibility determination for educational or disability programs. A formal cognitive evaluation requires a comprehensive, proctored battery administered by a licensed clinical neuropsychologist.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          3. Intellectual Property Rights
        </h2>
        <p>
          All proprietary vector SVG item diagrams, algorithmic source code, site architecture, and editorial content on FreeIQExam.com are protected by copyright, trademark, and intellectual property statutes.
        </p>
        <p>
          You are granted a personal, non-exclusive, revocable license to access the assessments for personal self-evaluation. Systematic crawling, scraping, commercial reproduction, or re-hosting of our SVG question banks is strictly prohibited without written authorization.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          4. Limitation of Liability
        </h2>
        <p>
          FreeIQExam is provided on an "as is" and "as available" basis without warranties of any kind, express or implied. Under no circumstances will FreeIQExam or its operators be liable for indirect, punitive, or consequential damages resulting from the use or inability to use our assessments.
        </p>
      </section>

      <section>
        <h2 class="font-heading font-bold text-lg sm:text-xl text-zinc-950 dark:text-white mb-2">
          5. Contact Information
        </h2>
        <p>
          For legal inquiries regarding these terms, reach us at <a href="mailto:legal@freeiqexam.com" class="text-blue-600 dark:text-blue-400 font-semibold underline">legal@freeiqexam.com</a>.
        </p>
      </section>
    </article>

  </main>

  <Footer />
</Layout>
