    <!-- Desktop Keyboard Shortcuts Helper -->
    <div class="w-full max-w-xl mx-auto mt-8 text-center hidden md:block">
      <div class="inline-flex items-center gap-4 px-4 py-2 rounded-full bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800/80 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span><kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">1-6</kbd> Select Option</span>
        <span class="text-zinc-300 dark:text-zinc-700">|</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">&larr;</kbd> <kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">&rarr;</kbd> Navigate</span>
        <span class="text-zinc-300 dark:text-zinc-700">|</span>
        <span><kbd class="px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">Enter</kbd> Finish</span>
      </div>
