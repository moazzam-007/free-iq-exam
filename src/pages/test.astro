      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button
          id="btn-modal-resume"
          type="button"
          class="w-full sm:w-auto flex-1 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 transition-colors"
        >
          Resume Test
        </button>
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-center transition-colors"
        >
