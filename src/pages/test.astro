        Calculating score summary...
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <button
          id="btn-confirm-submit"
          type="button"
          class="w-full sm:w-auto flex-1 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/20 transition-all"
        >
          Calculate My Score
        </button>
        <button
          id="btn-cancel-submit"
          type="button"
          class="w-full sm:w-auto px-5 py-2.5 rounded-full text-sm font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
        >
          Review Questions
        </button>
      </div>
    </div>
  </div>

  <!-- Embedded Client Logic -->
  <script is:inline define:vars={{ questionsJson }}>
    (function () {
      const questions = JSON.parse(questionsJson);
      const TOTAL_QUESTIONS = questions.length;
      const TOTAL_TIME_SECONDS = 20 * 60; // 1200 seconds

      const STORAGE_KEY_SESSION = 'freeiq_active_session';
      const STORAGE_KEY_ANSWERS = 'freeiq_test_answers';

      // Domain display labels
      const DOMAIN_LABELS = {
        matrix_reasoning: { label: 'Matrix Reasoning', cat: 'Fluid Reasoning (Gf)' },
        cube_rotation: { label: '3D Cube Rotation', cat: 'Visual Processing (Gv)' },
        cube_nets: { label: 'Surface Folding (Cube Nets)', cat: 'Visual Processing (Gv)' },
        topological_series: { label: 'Topological Pattern Series', cat: 'Fluid Reasoning (Gf)' }
      };

      const PROMPT_INSTRUCTIONS = {
        matrix_reasoning: 'Select the missing piece that logically completes the 3x3 pattern:',
        cube_rotation: 'Identify which comparison cube is a valid rigid 3D rotation of the target:',
        cube_nets: 'Identify which 3D cube is formed by folding this 2D net:',
        topological_series: 'Select the next logical step that completes this sequential pattern:'
      };

      // State
      let currentIndex = 0;
      let userAnswers = {}; // { [questionId]: optionId }
      let timeRemaining = TOTAL_TIME_SECONDS;
      let timerInterval = null;

      // Restore session from localStorage if present
      try {
        const saved = localStorage.getItem(STORAGE_KEY_SESSION);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed && typeof parsed === 'object') {
            if (parsed.answers && typeof parsed.answers === 'object') userAnswers = parsed.answers;
            if (typeof parsed.timeRemaining === 'number' && parsed.timeRemaining > 0) timeRemaining = parsed.timeRemaining;
            if (typeof parsed.currentQuestionIndex === 'number' && parsed.currentQuestionIndex >= 0 && parsed.currentQuestionIndex < TOTAL_QUESTIONS) {
              currentIndex = parsed.currentQuestionIndex;
            }
          }
        }
      } catch (err) {
        console.warn('Failed to restore test session:', err);
      }

      // DOM Elements
      const timerDisplay = document.getElementById('timer-display');
      const timerContainer = document.getElementById('timer-container');
      const statCurrent = document.getElementById('stat-current');
      const mobileQNum = document.getElementById('mobile-q-num');
      const progressBar = document.getElementById('progress-bar');
      const domainBadge = document.getElementById('domain-badge');
      const domainCategory = document.getElementById('domain-category');
      const promptText = document.getElementById('question-prompt-text');
      const stimulusContainer = document.getElementById('stimulus-container');
      const optionsGrid = document.getElementById('options-grid');
      const answeredCountEl = document.getElementById('answered-count');
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');
      const btnNextText = document.getElementById('btn-next-text');
      const btnNextIcon = document.getElementById('btn-next-icon');
      const navigatorStrip = document.getElementById('navigator-strip');
      const btnTopSubmit = document.getElementById('btn-top-submit');

      // Modals
      const modalExit = document.getElementById('modal-exit');
      const btnExit = document.getElementById('btn-exit');
      const btnModalResume = document.getElementById('btn-modal-resume');

      const modalSubmit = document.getElementById('modal-submit');
      const submitModalSummary = document.getElementById('submit-modal-summary');
      const btnConfirmSubmit = document.getElementById('btn-confirm-submit');
      const btnCancelSubmit = document.getElementById('btn-cancel-submit');

      // Save state helper
      function saveSession() {
        try {
          const payload = {
            answers: userAnswers,
            timeRemaining: timeRemaining,
            currentQuestionIndex: currentIndex
          };
          localStorage.setItem(STORAGE_KEY_SESSION, JSON.stringify(payload));
        } catch (e) {
          // ignore localStorage quotas
        }
      }

      // Timer update
      function updateTimerDisplay() {
        const mins = Math.floor(timeRemaining / 60);
        const secs = timeRemaining % 60;
        const formatted = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
        if (timerDisplay) timerDisplay.textContent = formatted;

        // Visual alert styling
        if (timeRemaining <= 60) {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-300 dark:border-red-800 text-red-600 dark:text-red-400 font-bold animate-pulse';
        } else if (timeRemaining <= 300) {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-300 dark:border-amber-800 text-amber-600 dark:text-amber-400 font-semibold';
        } else {
          timerContainer.className = 'flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 font-medium';
        }
      }

      function startTimer() {
        updateTimerDisplay();
        timerInterval = setInterval(function () {
          if (timeRemaining > 0) {
            timeRemaining -= 1;
            updateTimerDisplay();
            saveSession();
          } else {
            clearInterval(timerInterval);
            // Auto submit on time expired
            submitTestImmediately();
          }
        }, 1000);
      }

      // Submit test handler
      function submitTestImmediately() {
        try {
          localStorage.setItem(STORAGE_KEY_ANSWERS, JSON.stringify(userAnswers));
          localStorage.removeItem(STORAGE_KEY_SESSION);
        } catch (e) {
          console.error(e);
        }
        window.location.href = '/results';
      }

      function openSubmitModal() {
        const answeredKeys = Object.keys(userAnswers);
        const count = answeredKeys.length;
        const unanswered = TOTAL_QUESTIONS - count;

        if (count === TOTAL_QUESTIONS) {
          submitModalSummary.textContent = 'All 24 questions completed! Your response pattern is ready for 2PL IRT scoring and normative standardization.';
        } else {
          submitModalSummary.textContent = 'You have answered ' + count + ' of 24 questions (' + unanswered + ' unanswered). Unanswered questions will be scored as incorrect. Are you sure you want to finish?';
        }
        modalSubmit.classList.remove('hidden');
        modalSubmit.classList.add('flex');
      }

      function closeSubmitModal() {
        modalSubmit.classList.add('hidden');
        modalSubmit.classList.remove('flex');
      }

      function openExitModal() {
        modalExit.classList.remove('hidden');
        modalExit.classList.add('flex');
      }

      function closeExitModal() {
        modalExit.classList.add('hidden');
        modalExit.classList.remove('flex');
      }

      // Render Question
      function renderCurrentQuestion() {
        const q = questions[currentIndex];
        if (!q) return;

        // Progress stats
        const qNum = currentIndex + 1;
        if (statCurrent) statCurrent.textContent = String(qNum);
        if (mobileQNum) mobileQNum.textContent = String(qNum);
        if (progressBar) {
          const pct = (qNum / TOTAL_QUESTIONS) * 100;
          progressBar.style.width = pct + '%';
        }

        const answeredCount = Object.keys(userAnswers).length;
        if (answeredCountEl) answeredCountEl.textContent = String(answeredCount);

        // Domain badge
        const domainInfo = DOMAIN_LABELS[q.domain] || { label: 'Reasoning Assessment', cat: 'Fluid Intelligence (Gf)' };
        if (domainBadge) domainBadge.textContent = domainInfo.label;
        if (domainCategory) domainCategory.textContent = domainInfo.cat;

        // Prompt text
        if (promptText) {
          promptText.textContent = PROMPT_INSTRUCTIONS[q.domain] || 'Select the option that completes the pattern:';
        }

        // Stimulus SVG
        if (stimulusContainer) {
          stimulusContainer.innerHTML = q.promptSvg;
        }

        // Options Grid
        if (optionsGrid) {
          optionsGrid.innerHTML = '';
          const selectedOptionId = userAnswers[q.id];

          q.options.forEach(function (opt) {
            const isSelected = selectedOptionId === opt.id;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-option-id', String(opt.id));
            btn.setAttribute('aria-label', 'Choice ' + opt.id);

            const baseClasses = 'relative p-3 sm:p-4 rounded-2xl flex flex-col items-center justify-center transition-all duration-150 cursor-pointer text-left focus:outline-none min-h-[90px] sm:min-h-[110px] ';
            const selectedClasses = isSelected
              ? 'bg-blue-50/70 dark:bg-blue-950/40 border-2 border-blue-600 dark:border-blue-400 ring-2 ring-blue-600/20 shadow-md scale-[1.02]'
              : 'bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 hover:shadow-xs';

            btn.className = baseClasses + selectedClasses;

            // Option keyboard badge (top-left)
            const badge = document.createElement('span');
            badge.className = isSelected
              ? 'absolute top-2 left-2 w-5 h-5 rounded-full bg-blue-600 text-white font-mono text-[11px] font-bold flex items-center justify-center'
              : 'absolute top-2 left-2 w-5 h-5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-mono text-[11px] font-semibold flex items-center justify-center border border-zinc-200 dark:border-zinc-700';
            badge.textContent = String(opt.id);

            // Inner SVG container
            const svgWrapper = document.createElement('div');
            svgWrapper.className = 'w-full flex items-center justify-center pointer-events-none mt-2';
            svgWrapper.innerHTML = opt.svgContent;

            btn.appendChild(badge);
            btn.appendChild(svgWrapper);

            btn.addEventListener('click', function () {
              selectOption(q.id, opt.id);
            });

            optionsGrid.appendChild(btn);
          });
        }

        // Nav buttons
        if (btnPrev) {
          btnPrev.disabled = currentIndex === 0;
        }

        if (btnNextText && btnNextIcon) {
          if (currentIndex === TOTAL_QUESTIONS - 1) {
            btnNextText.textContent = 'Finish Test';
            btnNextIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4.5 12.75l6 6 9-13.5\" />';
          } else {
            btnNextText.textContent = 'Next';
            btnNextIcon.innerHTML = '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 4.5l7.5 7.5-7.5 7.5\" />';
          }
        }

        // Update Navigator Strip
        renderNavigatorStrip();
        saveSession();
      }

      function renderNavigatorStrip() {
        if (!navigatorStrip) return;
        navigatorStrip.innerHTML = '';

        for (let i = 0; i < TOTAL_QUESTIONS; i++) {
          const qId = questions[i].id;
          const isCurrent = i === currentIndex;
          const isAnswered = typeof userAnswers[qId] === 'number';

          const pill = document.createElement('button');
          pill.type = 'button';
          pill.setAttribute('aria-label', 'Go to question ' + (i + 1));

          let pillClass = 'h-8 sm:h-9 rounded-xl font-mono text-xs font-semibold flex items-center justify-center transition-all duration-150 ';

          if (isCurrent) {
            pillClass += 'bg-blue-600 text-white ring-2 ring-blue-600 ring-offset-2 dark:ring-offset-black shadow-xs font-bold scale-105';
          } else if (isAnswered) {
            pillClass += 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 shadow-2xs hover:scale-102';
          } else {
            pillClass += 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800/80 dark:text-zinc-400 border border-zinc-200/80 dark:border-zinc-700/60 hover:bg-zinc-200 dark:hover:bg-zinc-700';
          }

          pill.className = pillClass;
          pill.textContent = String(i + 1);

          pill.addEventListener('click', function () {
            currentIndex = i;
            renderCurrentQuestion();
          });

          navigatorStrip.appendChild(pill);
        }
      }

      function selectOption(questionId, optionId) {
        userAnswers[questionId] = optionId;
        renderCurrentQuestion();

        // Optional smooth auto-advance after selecting option if not on last item
        setTimeout(function () {
          if (currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
          }
        }, 220);
      }

      // Button Listeners
      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          if (currentIndex > 0) {
            currentIndex -= 1;
            renderCurrentQuestion();
          }
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', function () {
          if (currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
          } else {
            // Last question: trigger submit modal
            openSubmitModal();
          }
        });
      }

      if (btnTopSubmit) {
        btnTopSubmit.addEventListener('click', openSubmitModal);
      }

      if (btnExit) {
        btnExit.addEventListener('click', openExitModal);
      }

      if (btnModalResume) {
        btnModalResume.addEventListener('click', closeExitModal);
      }

      if (btnCancelSubmit) {
        btnCancelSubmit.addEventListener('click', closeSubmitModal);
      }

      if (btnConfirmSubmit) {
        btnConfirmSubmit.addEventListener('click', submitTestImmediately);
      }

      // Keyboard navigation
      window.addEventListener('keydown', function (e) {
        // Prevent shortcuts if modal is open
        if (!modalExit.classList.contains('hidden') || !modalSubmit.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            closeExitModal();
            closeSubmitModal();
          }
          return;
        }

        // Keys 1 to 6
        if (e.key >= '1' && e.key <= '6') {
          const optId = parseInt(e.key, 10);
          const currentQ = questions[currentIndex];
          if (currentQ) {
            selectOption(currentQ.id, optId);
          }
          return;
        }

        // ArrowLeft or p / P
        if (e.key === 'ArrowLeft' || e.key === 'p' || e.key === 'P') {
          if (currentIndex > 0) {
            currentIndex -= 1;
            renderCurrentQuestion();
          }
          return;
        }

        // ArrowRight or n / N
        if (e.key === 'ArrowRight' || e.key === 'n' || e.key === 'N') {
          if (currentIndex < TOTAL_QUESTIONS - 1) {
            currentIndex += 1;
            renderCurrentQuestion();
          }
          return;
        }

        // Enter key
        if (e.key === 'Enter') {
          if (currentIndex === TOTAL_QUESTIONS - 1) {
            openSubmitModal();
          }
        }
      });

      // Initialize
      startTimer();
      renderCurrentQuestion();
    })();
  </script>
</Layout>
