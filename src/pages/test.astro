    <!-- 24-Question Quick Navigation Strip -->
    <div class="w-full max-w-2xl mx-auto mt-8 sm:mt-10">
      <div class="flex items-center justify-between mb-3 text-xs font-mono text-zinc-400">
        <span>Question Navigator</span>
        <span class="hidden sm:inline">Click any number to jump</span>
