            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 text-zinc-700 dark:text-zinc-300">
              <tr>
                <td class="p-4 font-mono font-bold text-rose-600 dark:text-rose-400">&lt; 25 WPM</td>
                <td class="p-4 font-mono">Bottom 15%</td>
