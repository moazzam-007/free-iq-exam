---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryTestRunner from '../components/CategoryTestRunner.astro';

const title = "Verbal Reasoning Test Free: Analogies & Deductive Logic Questions | FreeIQExam";;
const description = "Evaluate your crystallized intelligence and verbal aptitude with 16 standardized questions. Test verbal analogies, conceptual classification, and semantic deduction.";;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Quiz",
    "name": "Verbal Comprehension Cognitive Ability Test (Gc)",
    "description": "Specialized 16-item verbal reasoning assessment measuring lexical semantic relations, formal syllogistic deduction, and categorical logic.",
    "url": "https://freeiqexam.com/verbal-reasoning-test/",
    "educationalLevel": "General Population",
    "typicalAgeRange": "16-",
    "timeRequired": "PT15M",
    "numberOfQuestions": 16
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://freeiqexam.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Verbal Reasoning Test",
        "item": "https://freeiqexam.com/verbal-reasoning-test/"
      }
    ]
  }
];
---

<Layout title={title} description={description} schema={schema}>
  <Header currentPath="/verbal-reasoning-test" />

  <main class="flex-1 w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-zinc-900 dark:text-zinc-100 font-semibold">Verbal Reasoning Test</span>
    </nav>

    <!-- Hero & Construct Introduction -->
    <header class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-4">
        <span>CHC COGNITIVE FACTOR: Gc <span aria-hidden="true">&bull;</span> VERBAL COMPREHENSION</span>
      </div>
        <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-zinc-900 dark:text-white tracking-[-0.025em] leading-tight mb-4">
        Verbal Reasoning Assessment (Gc)
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
        Assess your depth of conceptual understanding, deductive verbal syllogisms, and relational analogies. Choose between a 15-minute standardized test or an untimed practice drill with step-by-step logical proofs.
      </p>

      <!-- Quick Specs Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">16 Verbal &amp; Deductive Items</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">15-Minute Timer (or Untimed)</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">Formal Deductive Syllogisms</span>
        <span class="px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700">2PL IRT Calibration</span>
      </div>
    </header>

    <!-- Category Test Runner Component -->
    <CategoryTestRunner
      domain="verbal"
      domainCode="Gc"
      domainTitle="Verbal Comprehension"
      domainSubtitle="Lexical Analogies & Formal Deductive Syllogisms"
      domainDescription="Verbal Comprehension and Crystallized Intelligence (Gc) reflects the depth and breadth of acquired knowledge, verbal concept formation, language abstraction, and formal deductive reasoning. In real-world environments, Gc governs communication precision, legal analysis, and complex synthesis."
      testDurationMinutes={15}
      itemCount={16}
      gradientClass="from-blue-600 to-indigo-600"
      badgeClass="bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700"
    />

    <!-- Deep Psychometric Guide & Theoretical Background -->
    <section class="max-w-4xl mx-auto w-full pt-10 border-t border-zinc-200 dark:border-zinc-800 space-y-8">
      <div>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-950 dark:text-white mb-3">
          The Foundations of Crystallized Intelligence &amp; Verbal Logic
        </h2>
        <p class="text-zinc-700 dark:text-zinc-300 text-[17px] leading-relaxed">
          While crystallized intelligence encompasses language and cultural knowledge, standardized psychometric tests of Gc focus on relational reasoning and formal deduction rather than superficial vocabulary recall. An individual must understand how abstract concepts connect, contrast, and establish necessary logical truths.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            1. Relational Analogies (A : B :: C : ?)
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Formulating the exact functional relationship between the primary word pair (part-to-whole, degree of intensity, causal agent, tool-to-action) and mapping it onto the target pair.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            2. Formal Deductive Syllogisms
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Evaluating arguments with two premise statements to determine which conclusion follows with absolute logical necessity, resisting the urge to rely on empirical belief bias.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-2">
            3. Categorical Inclusion Logic
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Classifying concepts into taxonomical hierarchies and identifying the unique term that violates a subtle underlying criterion (odd-one-out categorization).
          </p>
        </div>
      </div>

      <!-- Strategy Tips for Test Takers -->
      <div class="p-6 sm:p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-bold text-lg text-zinc-950 dark:text-white mb-3">
          Tactical Strategies for Formal Syllogisms &amp; Verbal Logic
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Disregard Real-World Plausibility:</strong> Syllogisms must be solved strictly within the universe of the stated premises. Even if a premise contradicts empirical reality (e.g., "All apples are blue"), treat it as 100% true for the scope of the deduction.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Formulate an Exact Bridging Sentence for Analogies:</strong> In analogies (e.g., Thermometer : Temperature :: Barometer : ?), build a precise sentence: "A thermometer is an instrument designed to measure temperature; therefore, a barometer is an instrument designed to measure atmospheric pressure."</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" aria-hidden="true">&bull;</span>
            <span><strong>Beware of the "Some" Trap:</strong> In formal logic, "Some" means "At least one, and possibly all." It does NOT imply "Some are not." Diagram overlapping sets or Venn circles mentally to prevent invalid quantifier leaps.</span>
          </li>
        </ul>
      </div>

      <!-- Links to other batteries -->
      <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800">
        <h3 class="font-heading font-semibold text-base text-zinc-900 dark:text-white mb-4">
          Explore Other Specialized Cognitive Batteries
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/fluid-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Fluid Reasoning (Gf)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Matrix Induction &rarr;</div>
          </a>
          <a
            href="/spatial-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Visual-Spatial (Gv)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">3D Mental Rotation &rarr;</div>
          </a>
          <a
            href="/quantitative-reasoning-test"
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group"
          >
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 font-semibold mb-1">Quantitative (Gq)</div>
            <div class="font-heading font-bold text-sm text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Arithmetic Logic Puzzles &rarr;</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
